        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Saga (Arkhan)" id="37dc-257b-3934-08dd" collective="false" hidden="false" import="true" targetId="fca5-e518-855f-2b8b" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="b4e0-9e1b-900b-9ea4" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="No muerto" id="c6b4-ca75-f820-849c" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Terror" id="2031-6cf1-8b7d-7019" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Señor del conocimiento" id="e0a8-a904-1a74-0b7b" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Nigromancia)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Arkham el negro, el rey liche, visir de Nagash" id="d806-9dfb-8245-b890" hidden="false">
          <description>Arkhan es un hechicero de nivel 4 que conoce todos los hechizos del Saber de Nigromancia y puede elegir hechizos adicionales del Saber de la Muerte  y/o Magia Oscura (ver “El Rey Liche”, más abajo).</description>
        </rule>
        <rule name="El Rey Liche" id="bd45-ddee-b8d5-c385" hidden="false">
          <description>Arkhan conoce todos los hechizos del Saber de la Nigromancia. Además, conoce otros 4 hechizos, que puede seleccionar libremente (no ha de tirar ningún dado para determinar sus hechizos) de entre los Saberes de Magia Oscura y/o el Saber de la Muerte. Arkhan puede llevar armadura y seguir lanzando hechizos sin impedimento alguno.</description>
        </rule>
        <rule name="Guerrero de Nehekhara" id="fe5f-6d17-467b-2b3b" hidden="false">
          <description>Si incluyes a Arkhan, puedes incluir una unidad de Carruajes de hueso como opción de Unidad básica. Si Arkhan monta un Corcel esquelético tiene la regla especial Caballería rápida y otorga dicha regla a cualquier unidad de Caballería esquelética a la que se una.</description>
        </rule>
        <rule name="El guarián de la antiguas tradiciones" id="0ed6-9ce2-8169-ac33" hidden="false">
          <description>Al inicio de cada una de tus fases de magia, Arkhan genera dos dados de Energía que se añaden a tu reserva de dados de Energía.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Arkham el negro, el rey liche, visir de Nagash" id="e614-d18e-74e8-8294" collective="false" hidden="false" import="true" type="upgrade">
