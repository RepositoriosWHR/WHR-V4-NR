              </infoLinks>
            </selectionEntry>
            <selectionEntry name="Báculo de condenación" id="61ff-ba12-f349-dc44" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d9f6-09b5-9df9-945d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="c7e1-b311-aca0-90d6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Báculo de condenación" id="81a7-ef98-900c-99d5" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 2D6. Contiene un hechizo de Potenciación que afecta a todas las unidades amigas con la regla especial No muerto a 24” o menos de Arkhan. El efecto del hechizo es igual al efecto de la Danza macabra de Vanhel (Nigromancia). Ten en cuenta que una unidad no puede recibir exitosamente el efecto de este báculo y el del hechizo Danza macabra de Vanhel en una misma fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Liber execrabilis" id="c947-ee16-1507-3452" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="02e1-56cf-1030-c6be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="ae44-b565-35fe-3bf7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Liber execrabilis" id="0866-ea6e-c8b4-3769" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Todos los disparos y ataques dirigidos contra Arkhan tienen un penalizador de -1 en su tirada para impactar. Además, el libro otorga a Arkhan una tirada de salvación especial de 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
