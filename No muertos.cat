  <sharedProfiles>
    <profile name="Arma de mano funeraria" id="f8ec-171f-2b62-634d" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Golpe letal, Arma de mano: Se considera un Arma de mano a todos los efectos y puede utilizarse en combinación con un Escudo para realizar Parada, siguiendo las reglas habituales.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armas emparejadas funerarias" id="b4e3-b1ca-f038-ed81" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1 Ataque, Ataques mágicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
    <profile name="Arma a dos manos funerarias" id="1731-80af-06e2-8f83" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
