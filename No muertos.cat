              </infoLinks>
              <profiles>
                <profile name="Bastón de cráneos llameantes" id="7779-eb49-9751-2971" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 5. Contiene un hechizo de Proyectil mágico con un alcance de 24” que causa 2D6 impactos de Fuerza 4 con la regla especial Ataques sólo flamígeros. Cualquier unidad que sufra al menos una baja a causa de este hechizo debe realizar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pergamino maldito" id="a484-04ac-6864-32dc" collective="false" hidden="false" import="true" type="upgrade">
