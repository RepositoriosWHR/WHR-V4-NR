              </costs>
              <profiles>
                <profile name="Libro de Nagash" id="3ee4-f05e-cdb9-f846" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Nagash canaliza automáticamente; no es necesario tirar el dado.</characteristic>
