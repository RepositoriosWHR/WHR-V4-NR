    <selectionEntry name="Carro de cadáveres" id="ba5f-de31-187d-9e26" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Especiales" id="cbdc-6bb3-02e7-1990" hidden="false" primary="true" targetId="5370656369616c23232344415441232323"/>
      </categoryLinks>
      <constraints>
        <constraint id="6e91-18a1-678d-6c5a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
      </constraints>
