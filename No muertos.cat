    <selectionEntry name="[E] - Arkham el negro, El rey liche, Visir de Nagash" id="0cdc-12b6-8969-5365" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="7cc6-38c4-62be-20e6" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="6db8-149b-2d69-c1e2" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
