          <selectionEntries>
            <selectionEntry name="Mortis, la gran espada de la muerte" id="2f6c-eb63-90ae-5691" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5f91-39ea-f87a-6c7a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="de57-eeb6-75d7-72dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Arma de mano funeraria" id="a101-aefd-148c-a6ee" hidden="false" targetId="f8ec-171f-2b62-634d" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Mortis, la gran espada de la muerte" id="1807-b117-aba8-2276" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano funeraria. Los ataques efectuados con este arma se resuelven con +1 a la Fuerza. Por cada baja causada por la espada, Nagash puede restaurar una de las heridas que hubiese sufrido previamente durante la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Báculo del poder" id="32f0-0868-5d3c-9138" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="faec-61c0-a52a-4aeb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="eb6a-a21f-a906-1632" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Báculo del poder" id="3ad3-534d-ff62-b2b9" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Nagash puede guardar hasta cuatro dados de Energía o Dispersión no utilizados para usarlos en una fase de magia posterior. Comienza la partida con 1D3 dados almacenados.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Los nueve Libros de Nagash" id="838a-e7b6-45d6-2a32" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4181-5896-3bfc-2c34" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="5f85-8638-8646-7b78" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Los nueve Libros de Nagash" id="d986-b71e-6214-4d21" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Nagash Canaliza automáticamente; no es necesario tirar el dado. Además, los libros proporcionan a Nagash un bonificador de +2 a la hora de lanzar y dispersar hechizos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corona de la hechicería" id="0136-aa19-c164-4249" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6dfb-ab1b-e0ee-9c7e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2bfe-442b-fb0a-1afb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Corona de la hechicería" id="cde7-5e5f-0992-f64b" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">La corona proporciona a Nagash dos dados de Energía adicionales cada vez que lanza un hechizo. El poder de esta reliquia es tal que no puede ser anulada, destruida o afectada por reglas especiales, objetos mágicos o hechizos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura negra de Nagash" id="92d4-6f8f-2c3b-43f7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1ddc-e943-d36a-4261" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="cf83-bee7-971c-3b01" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Resistencia mágica (2)" id="f077-7cd2-a353-1c41" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Armadura negra de Nagash" id="8b45-a431-3fef-ab90" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de Gromril (proporciona una tirada de salvación por armadura de 4+ y hace a su portador inmune al efecto de la regla especial Poder de penetración). Proporciona a Nagash una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (2). El poder de esta reliquia es tal que no puede ser anulada, destruida o afectada por reglas especiales, objetos mágicos o hechizos.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Armadura negra de Nagash" id="92f5-163f-f09a-6ad2" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
                  <characteristics>
                    <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Inmune al efecto de la regla especial Poder de penetración</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Nivel de magia 5" id="7388-0e00-aeba-fd08" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ce2b-eb7e-c031-bcf4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
