        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="No Muerto (1D2)" id="f95c-c8c3-6f87-b1b7" hidden="false" targetId="b314-335e-6db5-cb02" type="rule"/>
