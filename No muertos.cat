      <rules>
        <rule name="Magia Van Dammeg, el rey del terror " id="fb36-5d04-60c3-2573" hidden="false">
          <description>Van Damneg es un hechicero de nivel 4 que utiliza hechizos de los Saberes de Nigromancia y de Magia Oscura (ver Grimorium Necris, más abajo).</description>
        </rule>
        <rule name="El guardián de las antiguas tradiciones" id="264e-0918-aa79-108c" hidden="false">
          <description>Al inicio de cada una de tus fases de magia, Van Damneg genera dos dados de Energía que se añaden a tu reserva de dados de Energía.</description>
        </rule>
      </rules>
      <selectionEntries>
