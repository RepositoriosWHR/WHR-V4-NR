      </entryLinks>
      <infoLinks>
        <infoLink name="Miedo" id="f5be-551f-47a0-60c6" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink name="Monstruo" id="441b-7612-920b-f05a" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Regeneración (4+)" id="766e-d9a3-14f7-07ad" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
        <infoLink name="No muerto" id="b054-4e88-5540-da75" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(1)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Dieter Helsnitch, Señor de la muerte" id="ca78-8416-7c43-911f" hidden="false">
          <description>Dieter Helsnicht es un hechicero de nivel 4 que puede elegir sus hechizos de los Saberes de la Muerte y/o Nigromancia y puede mezclar diversos saberes a la hora de generar sus hechizos.</description>
        </rule>
        <rule name="Carne eterna" id="2fed-947d-98a6-7413" hidden="false">
          <description>Dieter tiene la regla especial Regeneración (4+).</description>
        </rule>
        <rule name="Señor vivo de los no muertos" id="3f83-0abf-171b-e8f4" hidden="false">
          <description>Dieter Helsnicht es un ser vivo, por lo que no está sujeto a las reglas para No muertos. Pese a estar vivo, Heinrich Kemmler se considera No muerto (1) a efectos de recibir los efectos de los hechizos de Nigromancia.</description>
        </rule>
        <rule name="Portador del corazón de la noche" id="50c8-0fe3-4c54-178e" hidden="false">
          <description>Al inicio de cada una de tus fases de magia, Dieter genera un dado de Energía que se añade a tu reserva de dados de Energía.</description>
        </rule>
      </rules>
      <selectionEntries>
