                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="5725-5aa8-cbe0-bdbf">Sólo Liches y Maestros nigromantes. Al lanzar un hechizo, el hechicero puede repetir los dados. Si decide repetir, deberá repetir todos los dados.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
