                <profile name="Espada funeraria del caos" id="7672-8faf-f979-671d" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos con este arma se resuelven con +1 a la Fuerza. Porcada herida que se cause con esta espada a un enemigo en combate cuerpo a cuerpo se obtiene un dado de Energía adicional en su próxima fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Báculo del señor de nigromantes" id="5211-84bf-e22a-00b7" collective="false" hidden="false" import="true" type="upgrade">
