        <infoLink name="No Muerto (1D2)" id="3a03-d84c-60c5-b095" hidden="false" targetId="b314-335e-6db5-cb02" type="rule"/>
        <infoLink name="Infantería" id="5c96-26c3-2e23-99e7" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
