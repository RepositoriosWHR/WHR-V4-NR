        <infoLink name="Terror" id="7339-4067-fec5-38cb" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Ataques aleatorios" id="b7d1-4d84-1769-1723" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(2D6)(Sólo horda zombi)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Regeneración (4+)" id="36a2-b61a-53cd-b7d1" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="6e91-18a1-678d-6c5a" type="set" value="3">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="6e91-18a1-678d-6c5a" type="set" value="4">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Potencia de unidad 4" id="0dbe-ece2-c412-ed58" hidden="false"/>
        <rule name="Horda de zombis" id="430e-a8da-579c-7efb" hidden="false">
          <description>El Carro de cadáveres es tirado por una Horda de zombis con las reglas especiales No muerto, Ataques aleatorios (2D6) y Ataques envenenados. Gracias a los zombis, el Carro de cadáveres puede marchar pese a ser un Carro; sin embargo, no tienne la regla especial Veloz.</description>
        </rule>
        <rule name="Aprendiz de nigromante" id="926e-8b0c-4f21-2a6a" hidden="false">
          <description>El Aprendiz de nigromante no cuenta como hechicero, pero puede utilizar como objeto portahechizos de nivel de energía 2 el hechizo Invocación de Nehek (Nigromancia) una vez en cada una de sus fases de magia propia.</description>
        </rule>
        <rule name="Miasma de descomposición" id="565f-4baf-96d2-ba97" hidden="false">
          <description>Todas los ataques cuerpo a cuerpo y de proyectiles que se dirijan contra el Carro de cadáveres tendrán un penalizador de -1 para impactar.</description>
        </rule>
        <rule name="Foco de poder nigromántico" id="c10f-8da6-2650-776e" hidden="false">
          <description>Todas las unidades amigas con la regla especial No muerto a 12” o menos de un carro de cadáveres obtienen la regla especial Regeneración (6+, o +1 a su Regeneración si ya disponían de ella, hasta un máximo de 3+), y podrán marchar como si se encontrasen a 12” o menos del general del ejército.</description>
        </rule>
        <rule name="Salvación por armadura 5+" id="e08a-995a-9509-aaeb" hidden="false"/>
      </rules>
      <selectionEntries>
        <selectionEntry name="Carro de cadáveres" id="0da2-3a58-7633-64bf" collective="false" hidden="false" import="true" type="model">
          <constraints>
