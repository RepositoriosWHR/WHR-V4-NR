      <rules>
        <rule name="El saquador" id="fbf0-3d2f-48cd-bdd6" hidden="false">
          <description>Cada vez que Vrax (o su unidad, si está en una) capture un estandarte, ganará 75 puntos de victoria adicionales en lugar de los 50 habituales. Si captura el Estandarte de batalla, ganará 150 puntos en lugar de los 100 puntos habituales.</description>
        </rule>
      </rules>
