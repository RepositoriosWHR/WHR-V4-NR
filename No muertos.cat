                <profile name="Grimorium Necris" id="4249-0c7a-f7f3-46e6" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Proporciona a Van Damneg cuatro hechizos adicionales (para un total de 8). Debe generar 4 de ellos del Saber de Nigromancia y los otros 4 del Saber de Magia Oscura.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
