                <infoLink name="Ataques solo flamígeros" id="d040-eff2-384d-3cd7" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Bastón de cráneos llameantes" id="4a69-e46e-b502-0ad8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 5. Contiene un hechizo de Proyectil mágico con un alcance de 24” que causa 2D6 impactos de Fuerza 4 con la regla especial Ataques sólo flamígeros. Cualquier unidad que sufra al menos una baja a causa de este hechizo debe realizar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pergamino maldito" id="a53a-c108-73a6-2d8b" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cded-7d7a-6e4a-bf17" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="fbd6-8fd2-a64d-e8ca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
