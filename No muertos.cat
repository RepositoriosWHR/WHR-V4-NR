          </entryLinks>
          <profiles>
            <profile name="Liber Mortis" id="b662-38d7-feee-a30b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador lance un hechizo del Saber de la Nigromancia, puede lanzar un dado de energía adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Libro de Nagash" id="e603-6933-3c21-e8e1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e896-6323-fd7a-f52e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4841-4d7e-6fc1-04dc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="dda1-ad65-cb27-adea" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Libro de Nagash" id="6410-8b6a-aeb7-020f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos, un bonificador de +2 a sus tiradas de Canalizar y un bonificador de +1 a cada dado de invocación de sus hechizos de Nigromancia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. No muertos" id="ff1d-d192-4f60-de81" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f173-f5a4-6d9f-c8a1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="-1"/>
        <constraint id="667d-ca5d-206d-d9e7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Familiar necrótico" id="cb63-349c-770c-3f26" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9225-4e61-1cba-fd26" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="936d-1c9c-1aa3-8067" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Familiar necrótico" id="aeda-2c5c-ee5a-9b96" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El Familiar necrótico permite a su portador repetir las tiradas de los dados de invocación de los hechizos Invocación de Nehek y Animar muertos que lance. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Libro de Arkhan" id="11e2-584e-3bf9-c517" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c2ed-9812-01ff-7b85" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e95c-ece0-f81f-5e42" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Libro de Arkhan" id="31f2-dcd3-55e7-3f57" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 4. Contiene un hechizo de Potenciación que puede lanzarse sobre una unidad amiga con la regla especial No muertos a 6” o menos del portador y Permanece un turno. La unidad tendrá un bonificador de +1 a sus tiradas para herir en combate cuerpo a cuerpo por la duración del conjuro.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo del cráneo" id="7fbe-371e-548b-f063" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d4a7-1ecc-be16-ea38" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2b5b-31db-df3b-fe3e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo del cráneo" id="5f58-00ae-55e2-f4f7" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia del portador, el enemigo debe revelar todos sus objetos mágicos y opciones ocultas en un radio de 12” del portador. Además, podrás repetir la tirada en la tabla de Disfunciones mágicas si el portador sufre una Disfunción mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sombrero de la hechicería" id="6657-c737-151f-930c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b1f7-f386-808b-d132" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="61cb-dcf4-f695-c450" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sombrero de la hechicería" id="8743-b99f-7267-0074" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede elegir sus hechizos de entre los Saberes del Fuego, del Metal, de los Cielos y/o de las Bestias, además de sus Saberes habituales. Además, el portador conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Talismán negro" id="6cc1-1f6c-68af-2830" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6fb1-1e2d-0aa5-9e02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
