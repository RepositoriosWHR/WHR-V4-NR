            <selectionEntry name="Mortis, la gran espada de la muerte" id="848f-afc9-7e4b-eb04" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8eb7-ad15-0bd3-b1c8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="4417-49d6-f7e2-bf64" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Arma de mano funeraria" id="d836-19fc-e522-24fb" hidden="false" targetId="f8ec-171f-2b62-634d" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Mortis, la gran espada de la muerte" id="bdb6-6c1f-ecc6-5ca9" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano funeraria. Los ataques efectuados con este arma se resuelven con +1 a la Fuerza. Por cada baja causada por la espada, Nagash puede restaurar una de las heridas que hubiese sufrido previamente durante la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura negra de Nagash" id="e06a-3761-d2b7-5d39" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2959-651a-684b-28cf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="9bcc-dbbd-e147-b90e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Resistencia mágica (2)" id="45c4-d117-629f-a658" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Armadura negra de Nagash" id="5853-71ea-ff28-cd1b" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de Gromril (proporciona una tirada de salvación por armadura de 4+ y hace a su portador inmune al efecto de la regla especial Poder de penetración). Proporciona a Nagash una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (2). El poder de esta reliquia es tal que no puede ser anulada, destruida o afectada por reglas especiales, objetos mágicos o hechizos.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Armadura negra de Nagash" id="622f-50bd-94a6-17c8" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
                  <characteristics>
                    <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Inmune al efecto de la regla especial Poder de penetración</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Báculo del poder" id="993e-4803-ffb6-7bb8" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8e94-0f9e-e007-f807" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="20e3-dcfe-a5f2-b961" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Báculo del poder" id="4eeb-249b-c004-18db" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Nagash puede guardar hasta cuatro dados de Energía o Dispersión no utilizados para usarlos en una fase de magia posterior. Comienza la partida con un dado almacenado.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Libro de Nagash" id="18e1-89cb-e7fb-5132" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
