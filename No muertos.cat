      <rules>
        <rule name="Magia Dieter Helsnitch, señor de la muerte" id="ef42-f56f-39f2-f4c4" hidden="false">
          <description>Dieter es un hechicero de nivel 4 que puede elegir sus hechizos de los Saberes de la Muerte y/o Nigromancia y puede mezclar diversos saberes a la hora de generar sus hechizos.</description>
        </rule>
        <rule name="Carne eterna" id="6dc0-02f6-baf8-d09e" hidden="false">
          <description>Dieter tiene la regla especial Regeneración (4+).</description>
        </rule>
        <rule name="El Guardián de las Antiguas tradiciones" id="d797-3f50-6b61-cce9" hidden="false">
          <description>Al inicio de cada una de tus fases de magia, Dieter genera dos dados de energía que se añaden a tu reserva de dados de energía.</description>
        </rule>
      </rules>
