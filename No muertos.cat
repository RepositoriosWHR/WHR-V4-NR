        <infoLink name="Flotar (8)" id="6013-e99e-28d4-a7bd" hidden="false" targetId="7465-4e8e-6ec8-2a0f" type="rule"/>
        <infoLink name="Terror" id="094a-2bff-dd49-f51a" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Objetivo grande" id="845c-ea2e-eeef-b91d" hidden="false" targetId="71eb-6467-3a39-bdb6" type="rule"/>
        <infoLink name="Ataques aleatorios" id="df5e-828d-449f-c908" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Horda de espíritus, 2D6+2)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Potencia de unidad 5" id="20f3-a1cb-38af-c871" hidden="false"/>
        <rule name="Aprendiz de nigromante" id="cbe7-5ed1-45aa-5595" hidden="false">
          <description>El Aprendiz de nigromante no cuenta como hechicero, pero puede utilizar como objeto portahechizos de nivel de energía 2 el hechizo Invocación de Nehek (Nigromancia) una vez en cada una de sus fases de magia.</description>
        </rule>
        <rule name="Foco de poder nigromántico" id="09c6-b101-a4fc-6df6" hidden="false">
          <description>Todos los hechiceros (amigos y enemigos) a 6” o menos del Ingenio Mortis obtienen un bonificador de +1 a sus tiradas de lanzamiento de hechizos del Saber de Nigromancia.</description>
        </rule>
        <rule name="Coro espectral" id="7217-ca34-5127-9a6c" hidden="false">
          <description>Se trata de un ataque de disparo con un alcance de 12” y la regla especial Disparo rápido. Tira 2D6+2 y resta el Liderazgo del objetivo: esas son las heridas causadas sin tirada de salvación por armadura. El Ingenio Mortis puede usar su Coro espectral incluso si se encuentra trabado en combate cuerpo a cuerpo, aunque tan sólo contra la unidad con la que se encuentra combatiendo. Ten en cuenta que no puedes dispararlo en la fase de magia con la Danza macabra de Vanhel.</description>
        </rule>
        <rule name="Energía impía" id="382a-4a3f-f012-76b8" hidden="false">
          <description>En cada fase de magia propia, el Ingenio Mortis puede lanzar, como si fuese un objeto portahechizos de nivel de energía 1D6+2 el hechizo Danza macabra de Vanhel, del Saber de Nigromancia, en su versión potenciada.</description>
        </rule>
        <rule name="Salvación por armadura 5+" id="0fbc-7300-1011-5fb5" hidden="false"/>
      </rules>
      <selectionEntries>
        <selectionEntry name="Ingenio Mortis" id="6d57-d22f-d8c8-631a" collective="false" hidden="false" import="true" type="model">
