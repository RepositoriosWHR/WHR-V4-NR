                <profile name="Cetro de perdición" id="ea24-e7c5-6b2f-62a2" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados por el cetro no permiten tirada de salvación por armadura y tienen la regla especial Golpe letal, que surtirá efecto con un resultado de 4+ en lugar del habitual de 6+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Grimorium Necris" id="3c42-d7b0-505c-3bf2" collective="false" hidden="false" import="true" type="upgrade">
