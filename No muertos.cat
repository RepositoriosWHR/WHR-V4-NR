      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="046a-1c36-705e-1c0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Aparición de ultratumba" id="8378-66c7-86d5-986e" hidden="false">
          <description>Todos los chequeos de Terror que provoque un Coro espectral se realizarán tirando 3D6 y descartando el resultado menor. Además, ningún personaje puede unirse a un Coro espectral.</description>
        </rule>
        <rule name="Cacofonía infernal" id="9249-6d2e-9011-03ed" hidden="false">
          <description>Se trata de un ataque de disparo que todas las Doncellas espectrales realizan conjuntamente, con un alcance de 12” y la regla especial Disparo rápido. Tira 2D6 y suma +2 al resultado por cada Doncella en la unidad. Después, resta el Liderazgo del objetivo: esas son las heridas causadas sin tirada de salvación por armadura. El Coro espectral puede usar su lamento incluso si se encuentra trabado en combate cuerpo a cuerpo, aunque tan sólo contra la unidad con la que se encuentre combatiendo. Ten en cuenta que no puede disparar en la fase de magia la Cacofonía infernal con la Danza macabra de Vanhel.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Coro espectral" id="e3e7-a106-0e29-2e69" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f474-80db-b9a7-0624" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
            <constraint id="d3ab-03aa-cf13-d85a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="70"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
