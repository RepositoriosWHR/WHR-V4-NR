                <infoLink name="Inmune a la psicología" id="0fb8-8593-9880-19cd" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Cetro del consejo" id="64de-e6a5-49ff-884c" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, otorga a Kritislik 1D3 dados de Energía que tan sólo él podrá usar. Además, todas las unidades amigas de skaven a 18” o menos de Kritislik obtienen la regla especial Inmune a psicología.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
