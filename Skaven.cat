    <selectionEntry name="[E] - Tretch Colacobarde, Caudillo del clan Rictus" id="b7b5-db87-a429-c648" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="049e-4507-87d8-f395" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
        <categoryLink name="Personajes" id="442b-6421-b3a0-21cd" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="d755-9fc9-7bee-c350" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
