    <selectionEntry id="148b-0ffb-4da0-cd01" name="[E] - Nurglitch, Archiseñor de la plaga del clan Pestilens" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="046a-1c36-705e-1c0e" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c77d-9f06-898e-8a5c" type="max"/>
      </constraints>
      <rules>
        <rule id="36a2-05af-41ab-9157" name="Magia Nurglitch, archiseñor de la plaga del clan Pestilens" hidden="false">
          <description>Nurglitch es un hechicero de nivel 4 que conoce todos los hechizos del Saber de Plaga. </description>
        </rule>
        <rule id="b7cd-77e4-7355-1018" name="Putrefacción suprema" hidden="false">
          <description>Todos los disparos y ataques en combate cuerpo a cuerpo dirigidos contra Nurglitch tendrán un penalizador de -1 para impactar. Además, tiene la regla especial Regeneración (4+).</description>
        </rule>
        <rule id="6710-ea06-1e22-edf1" name="Señor del clan Pestilens" hidden="false">
          <description>Si Nurglitch es el General de tu ejército, puedes incluir unidades de Monjes de plaga como opción de Unidad básica. Mientras Nurglitch siga con vida, las miniaturas amigas con la clave clan Pestilens no podrán perder la regla especial Furia asesina por perder un combate. Del mismo modo, todas las tropas amigas con la clave clan Pestilens pasarán automáticamente sus chequeos de Resistencia provocados por los Incensarios de plaga o el Pebetero de 
plaga. Debido a la devoción que inspira en sus monjes de plaga, Nurglitch puede efectuar una tirada de ¡Cuidado, señor! si se encuentra unido a una unidad del clan Pestilens, aunque no sea del mismo tipo de tropa.</description>
        </rule>
        <rule id="f974-d7a6-8f9c-5f81" name="Potencia de unidad 5" hidden="false"/>
      </rules>
      <infoLinks>
        <infoLink id="0b71-d202-c6aa-eaed" name="La fuerza del número" hidden="false" targetId="2c14-2f77-f8ea-d0b5" type="rule"/>
        <infoLink id="f2b6-80b8-9876-b18c" name="Coraje mezquino" hidden="false" targetId="e7d9-b876-8ed2-648f" type="rule"/>
