                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7310-af52-1e12-dd9d" type="min"/>
              </constraints>
              <profiles>
                <profile id="f890-82c2-6c5d-b46e" name="Coraza férrea" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Armadura bruja. Proporciona a Ikit una tirada de salvación por armadura de 3+ y una tirada de salvación especial de 5+. Además, una vez por batalla, Ikit puede utilizar el proyector de fuego de disformidad como un Arma de aliento con Fuerza 5 y las reglas especiales Ataques mágicos, Ataques sólo flamígeros y Heridas múltiples (1D3). Cualquier unidad que sufra al menos una baja a causa de este Arma de aliento deberá realizar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="98bd-4621-5ac2-39cc" name="Armadura bruja" hidden="false" targetId="925b-2ee3-16fb-d195" type="profile"/>
                <infoLink id="0978-7a9c-65dc-2520" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(F5, Ataques mágicos, Ataques sólo flamígeros y Heridas multiples 1D3)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
