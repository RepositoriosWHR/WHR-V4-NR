          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c6b9-a181-6272-8625" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2aef-dcb4-c92c-4874" type="max"/>
      </constraints>
      <rules>
        <rule id="ccec-c3fd-2355-ac76" name="Magia Husk roehuesos, el vidente negro" hidden="false">
          <description>Huskk Roehuesos es un hechicero de nivel de magia 4 que puede elegir sus hechizos de entre los Saberes de la Muerte y/o Nigromancia. </description>
        </rule>
        <rule id="1a52-a716-b9d6-1b85" name="Señor del clan Roehusos" hidden="false">
          <description>Huskk Roehuesos puede unirse a unidades con la regla especial No muerto y tendrá la regla especial Indesmoralizable mientras quede al menos una miniatura no muerta en la unidad. Si su unidad es destruida en resolución por la regla Inestable, deberá realizar inmediatamente un chequeo de desmoralización aplicando los mismos penalizadores que su unidad en ese combate, y huirá con normalidad si lo falla.</description>
        </rule>
        <rule id="5c86-dabe-cc65-59f4" name="Portador del corazón de la noche" hidden="false">
          <description>Huskk genera un dado de Energía adicional en cada fase de magia propia.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2cf9-2ac1-40b1-a99f" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
