                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 1D6+1. Contiene el hechizo de Plaga (no potenciado) del Saber de Plaga.</characteristic>
