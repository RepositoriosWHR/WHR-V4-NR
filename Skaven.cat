    <selectionEntry name="Rueda de la muerte" id="e044-0f94-edfa-9a6e" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="3cd2-4af5-5da7-b14c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
