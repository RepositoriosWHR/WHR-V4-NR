        <infoLink name="Exploradores" id="d729-11a2-d4f1-4989" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="La fuerza del número (solo en tropas Eshin)" id="3164-b37c-bf05-d600" hidden="false">
          <description>Todas las unidades Skaven con esta regla especial sumarán su bonificador por filas a su atributo de liderazgo, con un máximo de +3 como es habitual.</description>
        </rule>
        <rule name="Asesino, no líder" id="f218-5be0-9df1-079a" hidden="false">
          <description>Tiene la regla especial La fuerza del número mientras permanezca unido a una unidad con la clave clan Eshin. Un personaje con esta regla especial no puede ser el General del ejército.</description>
        </rule>
        <rule name="Despliegue oculto" id="566b-c04c-4844-6c79" hidden="false">
          <description>Tiene la regla especial Asesino y puede elegir empezar la partida oculto en una unidad de Infantería que no tenga la clave clan Moulder, clan Pestilens o clan Skryre. Anota en la lista de ejército en qué unidad va oculto el Asesino Eshin. Adicionalmente, sólo puede aportar su valor de Liderazgo a su unidad si el Asesino Eshin ha sido ya revelado.</description>
        </rule>
      </rules>
