              </infoLinks>
              <profiles>
                <profile name="Tormenta infernal" id="dce3-a2fd-d34e-4587" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Alabarda bruja. Las heridas causadas en combate cuerpo a cuerpo por esta alabarda no permiten tirada de salvación por armadura. Además, se trata de un objeto portahechizos de nivel de energía 1D6+1. Contiene un hechizo de Proyectil mágico con un alcance de 24&quot; que causa 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
