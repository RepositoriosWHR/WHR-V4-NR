    <selectionEntry id="4622-d4db-7fb6-e498" name="[E] - Snikch, Maestro de la muerte del clan Eshin" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="04ea-9593-c1a0-23a6" type="max"/>
      </constraints>
      <rules>
        <rule id="4d76-d120-72cb-8963" name="Asesino, no líder" hidden="false">
          <description>Snikch tiene la regla especial La fuerza del número mientras permanezca unido a una unidad con la clave clan Eshin. Snikch no puede ser el General del ejército.</description>
        </rule>
        <rule id="85c7-a3d0-2836-5925" name="Despliegue oculto" hidden="false">
          <description>Snikch tiene la regla especial Asesino y puede elegir empezar la partida oculto en una unidad de Infantería que no tenga la clave clan Moulder, clan Pestilens o clan Skryre. Anota en la lista de ejército en qué unidad va oculto Snikch. Adicionalmente, sólo puede aportar su valor de Liderazgo a su unidad si Snikch ha sido ya revelado.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="efd4-531f-ea03-074a" name="Esquivar (4+)" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink id="0865-7ec5-708d-0312" name="Coraje mezquino" hidden="false" targetId="e7d9-b876-8ed2-648f" type="rule"/>
        <infoLink id="a671-a3c7-0b1c-4a67" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="6868-0818-c685-a1dd" name="Exploradores" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
        <infoLink id="2345-8aec-84f5-1380" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink id="04f6-79fa-4eea-4a02" name="La fuerza del número" hidden="false" targetId="2c14-2f77-f8ea-d0b5" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Sólo unidades Eshin)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
