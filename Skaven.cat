        <infoLink id="8704-37ad-1d46-96cc" name="Protección por montura (1)" hidden="false" targetId="1f9d-b34a-3d89-add6" type="rule"/>
        <infoLink id="de6b-8539-d7b0-481e" name="Señor del conocimiento" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Ruina y Plaga)"/>
