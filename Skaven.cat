          <profiles>
            <profile name="Estandarte de plaga" id="def0-66b6-b788-3240" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Monjes de plaga. Un solo uso. Puedes activar este estandarte al comienzo de cualquier fase de combate cuerpo a cuerpo. Durante esa fase de combate, la unidad y los personajes que incluya podrán repetir sus tiradas fallidas para impactar y herir,</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la rata podrida" id="516b-c1e2-0a69-f260" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9f06-589e-7c21-440d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="db64-2d6f-e3df-0aa8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la rata podrida" id="89d7-dc92-8a36-47d3" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Monjes de plaga. Los ataques dirigidos contra el portador y su unidad tendrán un penalizador de -1 para impactarles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
