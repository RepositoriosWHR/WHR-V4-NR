              <profiles>
                <profile id="d867-3650-757c-1e6b" name="Degolladora de enanos" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Las heridas causadas por este arma no permiten tirada de salvación por armadura. Además, otorga a Queek un bonificador de +2 a la Fuerza cuando ataca a miniaturas con la clave enanos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="7b69-08f2-7c06-7b0d" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="1aee-51b5-067e-b190" name="Armadura roja de disformidad" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="acb5-de20-6398-3a6e" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2b5e-9cf4-2232-ecdf" type="min"/>
              </constraints>
              <profiles>
                <profile id="1e05-89af-b5f8-e81f" name="Armadura roja de disformidad" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Proporciona a Queek una tirada de salvación por armadura de 2+ en lugar del 5+ habitual y una tirada de salvación especial de 5+. Además, cada vez que Queek realice una tirada de salvación por armadura o especial exitosa en combate cuerpo a cuerpo, la armadura causará un impacto de Fuerza 5 con las reglas especiales Ataque de rayos y Ataques mágicos a la miniatura que le causó la herida.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="f244-9e00-2523-cdb4" name="Armadura pesada" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="deaf-a44b-4cbc-0c3a" name="Arrancaojos" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ffe1-efd1-850b-8ab7" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="70ae-edea-1af5-7caf" type="min"/>
              </constraints>
              <profiles>
                <profile id="df1b-303e-18e6-14d7" name="Arrancaojos" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano (Queek realiza en total seis Ataques; cada vez que ataque, debes anunciar cuántos ataques realiza con cada una de sus armas, con un mínimo de un Ataque con cada una). Los impactos causados con Arrancaojos se resuelven con un bonificador de +1 a la Fuerza y la regla especial Ataques envenenados.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="feda-5c03-43c1-4cac" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
                <infoLink id="b20b-a296-f4e7-c8a8" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
