            <selectionEntry id="9e0d-dc76-d7f4-a7c6" name="Látigo de dominación" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="48fe-57d5-09a0-bcec" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fe5a-5b64-3ddc-ab32" type="min"/>
              </constraints>
              <profiles>
                <profile id="9d8b-5601-77c9-dca8" name="Látigo de dominación" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Látigo. Además de sus cuatro ataques con el Coge-mata-mata, Throt realiza un ataque adicional con este látigo (ten en cuenta que el látigo no tiene la regla especial Lento) que se resuelve con regla especial Poder de penetración. Por cada herida que sufra cualquier miniatura a consecuencia del Látigo de dominación, esta verá su atributo de Liderazgo reducido en 1 punto por el resto de la batalla. Una miniatura cuyo Liderazgo llegue a 0 deberá retirarse 
inmediatamente como baja.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="ccfa-3cc6-b516-024e" name="Látigo" hidden="false" targetId="dff9-aef9-4b67-da78" type="profile"/>
