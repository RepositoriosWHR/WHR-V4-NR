    <selectionEntry id="05c6-7aef-8c1c-d4e6" name="[E] - Snikch, Asesino supremo del clan Eshin" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="046a-1c36-705e-1c0e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="802d-70b9-a3ba-2f36" type="max"/>
      </constraints>
      <rules>
        <rule id="e484-21a9-5b58-0949" name="Asesino, no líder" hidden="false">
          <description>Snikch tiene la regla especial La fuerza del número mientras permanezca unido a una unidad con la clave clan Eshin. Snikch no puede ser el General del ejército.</description>
        </rule>
        <rule id="7106-bdba-707b-0cd4" name="Despliegue oculto" hidden="false">
          <description>Snikch tiene la regla especial Asesino y puede elegir empezar la partida oculto en una unidad de Infantería que no tenga la clave clan Moulder, clan Pestilens o clan Skryre. Anota en la lista de ejército en qué unidad va oculto Snikch. Adicionalmente, sólo puede aportar su valor de Liderazgo a su unidad si Snikch ha sido ya revelado.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="dc09-d79f-e10b-dd77" name="Esquivar (3+)" hidden="false" targetId="3510-e99d-a516-84bb" type="rule"/>
        <infoLink id="2e11-1fd1-9712-c418" name="Coraje mezquino" hidden="false" targetId="e7d9-b876-8ed2-648f" type="rule"/>
        <infoLink id="132d-a58c-2367-e53a" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="b36e-2312-f1cc-1198" name="Exploradores" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
        <infoLink id="bc74-fec1-8a91-148d" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink id="6537-6c65-2edc-89dc" name="Leyenda" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink id="8b9f-c6a6-9f94-8634" name="La fuerza del número" hidden="false" targetId="2c14-2f77-f8ea-d0b5" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Sólo unidades Eshin)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="2e85-a60e-757c-88a4" name="Personajes" hidden="false" targetId="e839-bd6b-7e36-e758" primary="false"/>
        <categoryLink id="0817-e826-4f86-3df3" name="New CategoryLink" hidden="false" targetId="4c6f72647323232344415441232323" primary="true"/>
      </categoryLinks>
      <selectionEntries>
