      <categoryLinks>
        <categoryLink name="Comandantes" id="f169-ad5c-85b7-8312" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="a45a-21ef-fa1a-7a76" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
