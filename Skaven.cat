      <infoLinks>
        <infoLink name="Esquivar (4+)" id="3ee0-4c42-0f03-71e5" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink name="Coraje mezquino" id="94a4-e93f-eff8-e2a9" hidden="false" targetId="e7d9-b876-8ed2-648f" type="rule"/>
