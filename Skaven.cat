      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Lord Skrolk del clan Pestilens" id="611b-1001-70f6-4a01" hidden="false">
          <description>Skrolk es un hechicero de nivel 3 que genera sus hechizos del Saber de Plaga. Tiene como hechizo identificativo el Aliento pestilente.</description>
        </rule>
        <rule name="Heraldo de la pestilencia" id="991a-411f-6728-dd3d" hidden="false">
          <description>Skrolk tiene la regla especial Regeneración (4+) y causa Terror. Si Lord Skrolk es el General de tu ejército, puedes incluir unidades de Monjes de plaga como Unidades básicas.</description>
        </rule>
        <rule name="Aura de pestilencia" id="49c3-1df2-fb64-e2a0" hidden="false">
          <description>Todas las miniaturas en contacto peana con peana con Lord Skrolk tendrán un penalizador de -1 en sus tiradas para impactar (esto no afecta a otras miniaturas con la clave clan Pestilens o miniaturas con la Marca de Nurgle).</description>
        </rule>
      </rules>
