        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Velo de sombras" id="8c72-3828-f6dc-8031" hidden="false">
          <description>Cualquier arma de proyectiles o hechizo que tome como objetivo a la Tríada Eshin verá su alcance reducido a 12”. Todos los impactos con plantilla sobre una Tríada Eshin se consideran impactos parciales.</description>
        </rule>
        <rule name="Bombas de humo" id="bbf0-e2ae-b2c9-e1ea" hidden="false">
          <description>Siempre que la Tríada Eshin falle un chequeo de Desmoralización o declare como reacción a una carga Huir o Disparar y huir, lanzará unas bombas de humo que dificultarán la persecución. Todas las unidades que persiguen a la Tríada Eshin verán su atributo de Movimiento reducido a la mitad (redondeando hacia arriba) durante esa persecución.</description>
        </rule>
        <rule name="Tácticas Eshin" id="1c9a-bbb9-ed4e-6866" hidden="false">
          <description>Ningún personaje puede unirse a una Tríada Eshin.</description>
        </rule>
      </rules>
