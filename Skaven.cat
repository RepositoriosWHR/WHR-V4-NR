      <rules>
        <rule name="Magia Kritislik, señor de la videncia del consejo de los trece" id="0ab4-f848-7719-d5f5" hidden="false">
          <description>Kritislik es un hechicero de nivel 4 que conoce todos los hechizos de los Saberes de Ruina y Plaga.</description>
        </rule>
        <rule name="Gran vidente" id="0ac5-f14c-41c6-c652" hidden="false">
          <description>La regla especial Presencia inspiradora de Kritislik (por ser el General del ejército) tiene un alcance de 18” en lugar de las 12” habituales.</description>
        </rule>
        <rule name="Potencia de unidad 5" id="4e2f-4aca-50ef-dd2b" hidden="false"/>
      </rules>
