        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="875f-740a-2093-9e3c" type="max"/>
      </constraints>
      <rules>
        <rule id="3798-8777-3852-5b78" name="Metabolismo acelerado" hidden="false">
          <description>Throt tiene la regla especial Regeneración (4+) y causa Miedo.</description>
        </rule>
        <rule id="73ae-fba1-aeab-326c" name="Joven promesa" hidden="false">
          <description>Todas las unidades de Ratas gigantes y Ratas ogro a 12” o menos de Throth obtienen la regla especial Odio (¡todos los enemigos!). Esto incluye a las Ratas ogro quebrantahuesos, pero nunca a los Señores de las bestias u otras miniaturas. Un ejército skaven que incluya esta Saga de Throt el Inmundo no podrá incluir Diablos de asalto.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="e457-a6af-4a8e-296c" name="Coraje mezquino" hidden="false" targetId="e7d9-b876-8ed2-648f" type="rule"/>
