      <rules>
        <rule name="Magia Vidente gris Nashrik, el terrorífico" id="ee31-7a1e-1151-4162" hidden="false">
          <description>Nashrik es un hechicero de nivel 3 que toma sus hechizos del Saber de Ruina. Tiene como hechizo identificativo el Rayo de disformidad.</description>
        </rule>
        <rule name="Patrocinado" id="c595-b930-7101-44c6" hidden="false">
          <description>Nashrik comienza la batalla con 1D3 Fragmentos de piedra bruja adicionales a los habituales.</description>
        </rule>
        <rule name="Arrogante" id="f2a0-4dd2-5c4a-dab4" hidden="false">
          <description>Si incluyes a Nashrik en tu ejército, no podrás añadir otros 
Videntes grises.</description>
        </rule>
      </rules>
