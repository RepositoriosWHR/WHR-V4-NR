    <selectionEntry id="f421-03af-ab4a-5b48" name="Diablos de asalto (Especial)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="e323-e7c4-cf9c-a446" value="6.0">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="170b-06ad-215f-f891" type="equalTo"/>
