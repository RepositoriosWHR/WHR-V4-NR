          <profiles>
            <profile id="b24c-195b-919b-5b52" name="Cacharro de atracción de sombras" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Los disparos efectuados contra el portador o su unidad se realizarán con un penalizador de -1 para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="ade1-0b4f-2c46-ab2c" name="Anillo de la oscuridad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="408a-c30f-dffe-e15e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f950-a029-07f3-6ad0" type="max"/>
          </constraints>
          <profiles>
            <profile id="afc5-faf4-6710-b186" name="Anillo de la oscuridad" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador la regla especial Resistencia mágica (1). Además, si un hechizo, objeto mágico o habilidad obliga al jugador skaven a revelar opciones secretas en la unidad en la que se encuentre el portador, el jugador skaven deberá revelar sólo la presencia de este anillo; todo lo demás permanece oculto. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8813-456f-0ee0-61a9" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
