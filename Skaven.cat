    <selectionEntry id="187e-1a9d-f4ef-e7a3" name="Tuneladora de disformidad" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3330-b85c-6dd2-c0a4" type="max"/>
      </constraints>
      <rules>
        <rule id="1b47-2eb9-a5ac-faf4" name="Tuneladora de disformidad" hidden="false">
          <description>En combate, considera que la Tuneladora de disformidad es un arma que causa 1D3 impactos automáticos de Fuerza 5 con las reglas especiales Ataques mágicos, Poder de penetración y Golpe letal (en lugar de realizar los ataques habituales de la dotación). Cualquier unidad que incluya una Tuneladora de disformidad estará sujeta a la regla especial Avance subterráneo (la unidad será la que entre mediante Avance subterráneo y la Tuneladora de disformidad se pondrá a 1” de ella).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4cc0-b1d4-a4e4-377f" name="Grupo de apoyo" hidden="false" targetId="4cf1-7660-8a90-eb6c" type="rule"/>
