      <rules>
        <rule id="4441-ed17-a80e-3118" name="Destripahuesos" hidden="false">
          <description>Si incluyes a Thanquol puedes incluir también una (y solo una) de las Destripahuesos aquí presentadas. Destripahuesos cuenta como Héroe, actúa independientemente, y no puede unirse a unidades.</description>
        </rule>
      </rules>
