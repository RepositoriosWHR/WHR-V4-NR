            <selectionEntry id="dfc8-852d-0481-034f" name="Bomba de realidad" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8e44-895c-0163-5df9" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ea9e-e757-81dd-d3fc" type="min"/>
              </constraints>
              <profiles>
                <profile id="8233-e3aa-ec69-f781" name="Bomba de realidad" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma arrojadiza (especial). Un sólo uso. Una vez por batalla, durante su fase de disparo, Gnawdoom puede usar la Bomba de realidad. Esta se trata como una Catapulta que puede Mover y disparar, sin alcance mínimo y con un alcance máximo de 12&quot;. Efectúa el proceso de dispersión de la forma habitual. La Bomba de realidad utiliza la plantilla redonda grande. Cualquier miniatura bajo la plantilla (utiliza las reglas habituales para impactos parciales) debe superar un chequeo de Fuerza o será arrastrada hacia el reino del Caos, por lo que será retirada como baja. Si obtienes un resultado de Problemas, coloca la plantilla centrada sobre Gnawdoom.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="ea70-2603-4133-f98b" name="Cuchillos/estrellas arrojadizas" hidden="false" targetId="2d13-b3f6-f40b-23fc" type="profile"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="c5f6-800f-655f-0bb0" name="Fetiches de la gran cornuda" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="70f8-4cd3-86a0-0c87" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5f52-0dab-bc7c-eadb" type="min"/>
              </constraints>
              <profiles>
                <profile id="fc64-2e56-8b11-92b9" name="Fetiches de la gran cornuda" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a Gnawdoom una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (1).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="aa6f-b90e-94af-f72e" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
