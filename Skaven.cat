  <sharedProfiles>
    <profile name="Acumulador de piedra bruja" id="5e52-6252-dec3-e729" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El portador realizará sus tiradas para canalizar con un bonificador de +1. Además, causará un impacto adicional cada vez que lance el hechizo Rayo de Disformidad.</characteristic>
      </characteristics>
    </profile>
    <profile name="Alabarda bruja" id="512a-5c1c-116b-c9ad" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1 Ataque, Ataques mágicos</characteristic>
      </characteristics>
    </profile>
    <profile name="Arma de cola" id="5387-4d6a-78aa-6768" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">+1A</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura bruja" id="925b-2ee3-16fb-d195" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">5+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Permite lanzar hechizos.</characteristic>
      </characteristics>
    </profile>
    <profile name="Atrapa-cosas" id="dcc9-dc24-19c4-dd47" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Lenta, Golpe letal, Luchar con filas adicionales (1)</characteristic>
      </characteristics>
    </profile>
    <profile name="Esfera de viento envenenado" id="34ba-516d-3a0d-45df" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Arma arrojadiza. Alcance 8”. Las esferas que impacten causan una herida sin posibilidad de salvación por armadura con un resultado de 4+. Si en la tirada para impactar se obtiene un 1, la esfera habrá estallado antes de tiempo y el lanzador deberá tirar para herirse a si mismo. No afecta a demonios o no muertos.</characteristic>
      </characteristics>
    </profile>
    <profile name="Esfera mortal" id="f783-fb1a-6610-9dcd" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">0-12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">-</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Un solo uso, Catapulta: Dispara como una Catapulta con la excepción de que puede Mover y disparar y desvía la mitad del resultado obtenido en el dado de artillería. Utiliza la plantilla redonda pequeña, siempre hiere con un resultado de 4+ y niega la tirada de salvación por armadura. No tiene impacto central diferenciado. Si obtienes un resultado de Problemas, coloca la plantilla centrada en el lanzador.</characteristic>
      </characteristics>
    </profile>
    <profile name="Estrellas arrojadizas" id="4529-bf87-54fc-0a4a" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">8&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">DIsparo rápido, Disparos múltiples (2), Arrojadiza</characteristic>
      </characteristics>
    </profile>
    <profile name="Fragmento de piedra bruja" id="0f0b-73d7-c673-d4ac" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Un hechicero puede consumir un Fragmento de piedra bruja al lanzar un hechizo, el cual le proporciona un dado de Energía. Puede, si lo desea, consumir varios fragmentos para lanzar un hechizo o incluso lanzar un hechizo utilizando sólo fragmentos. Sin embargo, cualquier resultado de 1 en cualquiera de los dados de Energía proporcionados por los Fragmentos de piedra bruja causarán al usuario una herida sin tirada de salvación por armadura.</characteristic>
      </characteristics>
    </profile>
    <profile name="Incensario de plaga" id="4ce6-9f16-3a5b-f799" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Agotamiento, Ataques mágicos. Al inicio de cada fase de combate cuerpo a cuerpo en la que el portador se encuentre trabado en combate, todas las miniaturas en contacto peana con peana con el portador deberán efectuar un chequeo de Resistencia (incluyendo al propio portador). Si lo fallan, sufrirán una herida sin posibilidad de salvación por armadura. Las miniaturas con la marca de Nurgle o que tengan las claves clan Pestilens, demonio o no muerto tan solo fallarán el chequeo con un resultado de 6, independientemente de su atributo de Resistencia. Cada miniatura sólo chequea una única vez por fase de combate, independientemente de con cuantas miniaturas con Incensario de plaga tenga en contacto peana con peana.</characteristic>
      </characteristics>
    </profile>
    <profile name="Látigo" id="dff9-aef9-4b67-da78" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Comabte</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">El látigo del amo: Permite a su portador realizar todos sus ataques a través de hasta tres filas de Ratas gigantes o una fila de Ratas ogro.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mosquete jezzail" id="e940-c301-3420-41ab" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">36&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">6</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Mover o disparar,
Munición inestable, Cañón estriado: Los disparos realizados con este arma ignoran el penalizador por larga distancia.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mosquete brujo" id="f005-bf44-92de-2177" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Heridas múltiples (1D3), Mover o disparar, Munición inestable (por cada resultado de 1 en la tirada para impactar, tira 1D6: con un resultado de 4-6 el proyectil se encasquilla y el arma no disparará ese turno, de lo contrario resulteve el impacto sobre el usuario con las reglas habituales del arma y un bonificador de +1F).</characteristic>
      </characteristics>
    </profile>
    <profile name="Optometría bruja" id="7368-8d3d-31b7-fb5f" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Todos los disparos realizados por el portador tendrán un bonificador de +1 a sus tiradas para impactar.</characteristic>
      </characteristics>
    </profile>
    <profile name="Palo-shock" id="1221-ff4f-63db-ed1b" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Ataque de rayos, Luchar con filas adicionales (1)</characteristic>
      </characteristics>
    </profile>
    <profile name="Pavés" id="aa41-392c-aebe-c4ee" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Otorga un bonificador de +2 a la tirada de salvación por armadura contra proyectiles y hechizos del tipo Proyectil mágico.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola bruja (combate)" id="ea4d-c4cd-204c-c0e9" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Armas emparejadas, Munición inestable, Descarga</characteristic>
      </characteristics>
    </profile>
    <profile name="Redes" id="377b-6c1c-888d-4cba" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Al comienzo de cada ronda de combate cuerpo a cuerpo, una unidad con Redes puede intentar enredar a una unidad enemiga con la que esté trabada en combate cuerpo a cuerpo. Tira 1D6: con un resultado de 2+, la unidad quedará enredada pero, si obtienes un 1, será tu propia unidad la que quede enredada. Una unidad enredada (una o más veces) tendrá un penalizador de -1 a su Fuerza hasta el final de la fase de combate cuerpo a cuerpo.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas brujas (disparo)" id="221b-4476-c300-a2fd" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Munición inestable</characteristic>
      </characteristics>
    </profile>
    <profile name="Ungüentos Eshin" id="c797-2dd5-dacb-ba4e" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Otorga la regla especial Ataques envenenados.</characteristic>
      </characteristics>
    </profile>
    <profile name="Máscaras antigás" id="5d6f-4c09-99b4-c139" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Los Lanzadores de Viento Envenenado solo se herirán a si mismos con sus esferas de viento envenenado, morteros de viento envenenado o esferas mortales con un resultado de 5+.</characteristic>
      </characteristics>
    </profile>
    <profile name="Esfera de viento corrosivo" id="60d7-3056-1ab4-2137" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">-</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Arrojadiza, Disparo rápido, Ataques mágicos, Ataques 
envenenados, Viento envenenado: Este arma siempre hiere con un resultado de 4+ y no permite tirada de salvación por armadura. Si en la tirada para impactar se obtiene un 1, la esfera habrá estallado antes de tiempo y el lanzador deberá tirar para herirse a si mismo.</characteristic>
      </characteristics>
    </profile>
    <profile name="Veneno secreto de disformidad" id="0b98-98e8-902c-ccab" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Otorga la regla especial Ataques envenenados; además, este veneno sobrepasa la regla especial Inmune a veneno que otorgan las reglas especiales Demonio y No muerto.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola bruja (disparo)" id="2237-5887-654f-d45f" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Ataques mágicos, 
Disparos múltiples (2), Munición inestable</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas brujas (combate)" id="b14a-81aa-0c1d-4e19" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Munición inestable</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura de piedra bruja entrelazada" id="3774-90c8-92c0-4602" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Por cada herida salvada en combate cuerpo a cuerpo, la armadura infligirá un impacto de Fuerza 4 con las reglas especiales Ataque de rayos y Ataques mágicos contra la miniatura que provocó la tirada.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="La fuerza del número" id="2c14-2f77-f8ea-d0b5" hidden="false">
      <description>Todas las unidades con esta regla especial sumarán su bonificador por filas a su atributo de Liderazgo para realizar sus chequeos de desmoralización, para evitar cargar por Furia asesina, Estupidez, Miedo, Terror y Pánico, pudiendo aplicar el Liderazgo base del general por la regla especial Presencia inspiradora (hasta un máximo de Liderazgo 10).</description>
    </rule>
    <rule name="Coraje mezquino" id="e7d9-b876-8ed2-648f" hidden="false">
      <description>Al comienzo de cada ronda de combate, el personaje con esta regla especial y con mayor atributo de Liderazgo dentro de una unidad podrá realizar un movimiento de ¡Dejad paso! para desplazarse a la segunda fila de la unidad que lo acompañe, pese a encontrarse en contacto peana con peana con una o más miniaturas enemigas y sin sufrirningún tipo de efecto adverso: simplemente desplaza al personaje a la segunda fila (del mismo modo que si hubiera rechazado un Desafío). Sin embargo, tras realizar este movimiento no podrá realizar ninguno de sus ataques contra las unidades enemigas en contacto con su unidad. Adicionalmente, dicho personaje podrá dar su Liderazgo a su unidad desde cualquier punto de esta, no sólo desde su fila delantera. Al final de cada ronda de combate deberás devolver el personaje al frontal de la unidad.</description>
    </rule>
    <rule name="Fiable" id="8694-7b63-68c9-066c" hidden="false">
      <description>Si obtienes un resultado de 1 en la tirada para impactar, tira 1D6: si obtienes de nuevo un resultado de 1, el Jazzail estallará y deberá retirarse como baja.</description>
    </rule>
    <rule name="Munición inestable" id="06be-4dce-f7cd-a54c" hidden="false">
      <description>Por cada resultado de 1 en la tirada para impactar con este arma, tira 1D6: con un resultado de 4-6, se encasquilla y el arma no disparará ese turno, de lo contrario resuelve el impacto contra el usuario con las reglas habituales del arma y un bonificador de +1 a su Fuerza.</description>
    </rule>
    <rule name="Unidad conjunta" id="c199-20b3-bc71-b45a" hidden="false">
      <description>Los grupos de apoyo deben desplegarse a 3&quot; de la unidad que lo ha adquirido, conocida como unidad madre. Después de ese momento, se considerará una unidad en todos los aspectos. Mientras se mantenga a 3&quot; o menos de su unidad madre, contará como si tuviera una tirada de salvación especial de 4+ contra disparos y hechizos del tipo Proyectil Mágico.</description>
    </rule>
    <rule name="Grupo de apoyo" id="4cf1-7660-8a90-eb6c" hidden="false">
      <description>Cada grupo de apoyo consiste en dos Skaven de Infantería montados en una única base y se consideran una única miniatura a todos los efectos (salvación por armadura 6+, 5+ con sus armaduras ligeras; potencia de unidad 2). El coste en puntos de los Grupos de Apoyo cuenta para el total de tropas básicas de la lista de ejército. Todos los grupos de apoyo tienen las reglas espciales Unidad Conjunta y La Fuerza del Número. Un grupo de apoyo destruido, huyendo o desmoralizado nunca provocará chequeos de pánico.</description>
    </rule>
    <rule name="Monstruosamente grande" id="8c56-bdd4-06d4-7219" hidden="false">
      <description>Todos los Grandes Demonios Exaltados son Monstruos; sin embargo, su tamaño es tal que se aplican las siguientes reglas adicionales: causan Terror, y los chequeos de Terror provocados por ellos deben efectuarse tirando 3D6 y descartando el resultado más bajo; son Objetivos grandes, y además el oponente podrá aplicar un bonificador de +1 a todas sus tiradas para impactar con proyectiles contra estos seres; son Tozudos en lugar de Impasibles; tienen Impactos por carga (1D6) en lugar de sólo 1; y tienen una Potencia de unidad igual al doble de su valor inicial de Heridas.</description>
    </rule>
    <rule name="Vientos de la magia desatados" id="e9d3-ee12-2273-4b7c" hidden="false">
      <description>El Señor de las alimañas exaltado es un Gran demonio exaltado. Si en una batalla hay presentes uno o más Grandes demonios exaltados, se deberán tirar 3D6 para determinar los Vientos de la magia, siendo el total en dados de energía y el resultado mayor más el menor en dados de dispersión para el oponente. Además, las tiradas de salvación por Aura demoníaca de todos los Demonios a 18” o menos de un Gran demonio exaltado (incluyendo al propio Gran demonio exaltado) podrán efectuarse incluso contra Ataques mágicos (pasando a considerarse una tirada de salvación especial).</description>
    </rule>
    <rule name="Correr con la manada" id="7594-ed6b-b891-5290" hidden="false">
      <description>Las miniaturas con esta regla especial tienen la regla especial Veloz. Los personajes que tengan esta regla especial sólo pueden unirse a unidades que tengan la clave clan Moulder siguiendo las reglas habituales, pudiendo colocarse en la tercera fila en las unidades de Ratas ogro o hasta en una cuarta fila en unidades de Ratas gigantes.</description>
    </rule>
    <rule name="Reputación traicionera" id="7f9e-bc00-b551-af57" hidden="false">
      <description>Las unidades con esta regla especial tan solo podrán incluir personajes con la clave clan Eshin siguiendo las reglas habituales. Los personajes con la clave clan Eshin tan solo pueden unirse a unidades que no tengan las claves clan Moulder, clan Pestilens o clan Skryre. Adicionalmente, un personaje con la clave clan Eshin sólo podrá aportar su atributo de Liderazgo a unidades con la clave clan Eshin.</description>
    </rule>
    <rule name="Hedor apestoso" id="1ea3-d965-f902-d6eb" hidden="false">
      <description>Las unidades con esta regla especial tan solo podrán incluir personajes con la clave clan Pestilens siguiendo las reglas habituales. Los personajes con la clave clan Pestilens tan solo pueden unirse a unidades que tengan la clave clan Pestilens.</description>
    </rule>
    <rule name="Aprendices del gremio" id="fc81-447b-ee37-845b" hidden="false">
      <description>Las unidades con esta regla especial tan solo podrán incluir personajes con la clave skryre siguiendo las reglas habituales. Los personajes con la clave clan Skryre tan solo pueden unirse a unidades que no tengan las claves clan Moulder, clan Pestilens o clan Eshin.</description>
    </rule>
    <rule name="Conocimientos de la ruinosa podredumbre" id="2ec5-25b1-f09d-47ed" hidden="false">
      <description>Los hechiceros skaven tienen especificado cuál es su hechizo identificativo de los Saberes de Ruina o Plaga. En el momento de determinar aleatoriamente sus hechizos, se considerará un resultado doble obtener dicho hechizo en la tirada siempre y cuando tomen sus hechizos de un único saber (ya que conocerán su hechizo identificativo inicialmente).</description>
    </rule>
    <rule name="Munición de Piedra bruja empobrecida" id="8bd5-2980-5aff-efba" hidden="false">
      <description>Los disparos de un Mosquete Jezzail equipado con la Munición de Piedra bruja empobrecida se resuelven con la regla especial Heridas múltiples (1D3).</description>
    </rule>
    <rule name="Acumulador de piedra bruja" id="275b-b7ad-7c93-cfaa" hidden="false">
      <description>El portador realizará sus tiradas para Canalizar con un bonificador de +1. Además, cada vez que lance el hechizo Rayo de disformidad podrá repetir la tirada para determinar el número de impactos que causa.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
