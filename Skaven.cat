        <infoLink name="Odio" id="42df-37ca-0c7e-d8af" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Gotrek y Félix)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
