    <selectionEntry id="221e-f5d5-3d2e-148d" name="[Ex] - Triada Eshin" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a7c9-be80-08a2-aff3" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d0d7-591a-c961-a02f" type="max"/>
      </constraints>
      <rules>
        <rule id="8c72-3828-f6dc-8031" name="Velo de sombras" hidden="false">
          <description>Cualquier arma de proyectiles o hechizo que tome como objetivo a la Tríada Eshin verá su alcance reducido a 12”. Todos los impactos con plantilla sobre una Tríada Eshin se consideran impactos parciales.</description>
        </rule>
        <rule id="bbf0-e2ae-b2c9-e1ea" name="Bombas de humo" hidden="false">
          <description>Siempre que la Tríada Eshin falle un chequeo de Desmoralización o declare como reacción a una carga Huir o Disparar y huir, lanzará unas bombas de humo que dificultarán la persecución. Todas las unidades que persiguen a la Tríada Eshin verán su atributo de Movimiento reducido a la mitad (redondeando hacia arriba) durante esa persecución.</description>
        </rule>
        <rule id="1c9a-bbb9-ed4e-6866" name="Tácticas Eshin" hidden="false">
          <description>Ningún personaje puede unirse a una Tríada Eshin. </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9692-5165-e834-9651" name="Esquivar (4+)" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
