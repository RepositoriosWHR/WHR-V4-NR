        <infoLink name="Inmune a la psicología" id="5e81-45fb-48c3-9ce2" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Impactos por carga (1D6+1)" id="69d8-633a-07ae-5f81" hidden="false" targetId="78cb-a25e-39e5-1f51" type="rule"/>
