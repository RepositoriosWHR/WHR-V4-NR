      <rules>
        <rule id="ba8e-f1bf-0264-283d" name="Magia Vidente gris" hidden="false">
          <description>El Vidente gris es un hechicero de nivel 4. Puede elegir sus hechizos de entre los Saberes de Ruina y/o Plaga. Su hechizo identificativo es Salto fugaz o La maldición de la Rata Cornuda (elige uno).</description>
        </rule>
      </rules>
