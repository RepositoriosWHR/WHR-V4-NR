                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Al inicio de cada turno skaven, si Thanquol está herido, tira 1D6: con un resultado de 4+, restaura una de las heridas que Thanquol hubiese sufrido durante la batalla.</characteristic>
                  </characteristics>
