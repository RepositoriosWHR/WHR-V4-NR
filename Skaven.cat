            <profile name="Colgante de putridez" id="8f30-1c06-27e0-28c8" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo Sacerdote de plaga Pestilens. Otorga a su portador la regla especial Regeneración (5+).</characteristic>
