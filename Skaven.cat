    <selectionEntry id="4a40-9cff-3792-ea2b" name="Ingeniero-Jefe" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0e57-73e2-bfcf-98b1" type="max"/>
