        <selectionEntry id="c448-1c82-d483-e285" name="Talismán de la piel de otro" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2374-dc0d-b10c-fb97" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3c2c-ae4b-0328-de20" type="max"/>
          </constraints>
          <profiles>
            <profile id="8e07-342f-840a-fa3b" name="Talismán de la piel de otro" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un solo uso. El portador puede obligar a una única miniatura enemiga con la que esté en contacto peana con peana a repetir todas sus tiradas para impactar exitosas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="5cd8-9a99-a33c-52e3" name="Talismán de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3161-3356-3c9e-c2da" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="fe32-146a-bddd-d152" type="max"/>
          </constraints>
          <profiles>
            <profile id="ecd4-b419-406b-af0e" name="Talismán de disformidad" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cualquier miniatura que dirija uno o más de sus ataques en cuerpo a cuerpo sobre el portador deberá superar un chequeo de Liderazgo con su atributo básico. Si falla el chequeo, efectuará sus ataques con un penalizador de -2 a su atributo de Fuerza y a sus tiradas para impactar hasta el final de la fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="86c6-fb93-6952-9de6" name="Muy-muy mejorado amuleto de protección" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1642-d396-f369-3872" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5945-3381-f3a4-a6a7" type="max"/>
          </constraints>
          <profiles>
            <profile id="90a1-ca84-7246-d1ca" name="Muy-muy mejorado amuleto de protección" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Este objeto sólo funciona mientras el portador esté unido a una unidad. Proporciona a este una tirada de salvación especial de 4+; cada vez que salve una herida con esta tirada de salvación especial, su unidad sufrirá una herida automática sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="fa37-3492-fe22-bb88" name="Artefactos arcanos. Reliquias. Skaven" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5340-9e54-ca38-c374" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="62ca-eabd-9cdb-e45a" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="b35e-bed3-3211-61b0" name="Glorioso bastón de la ruinosa podredumbre" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5565-cc9f-70b1-5e89" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="24fe-90b3-ad65-b7bd" type="max"/>
          </constraints>
          <profiles>
            <profile id="2374-721e-9d40-eb5f" name="Glorioso bastón de la ruinosa podredumbre" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga al portador la regla especial Señor del conocimiento (Ruina y Plaga). Además, tendrá un bonificador de +1 para lanzar sus hechizos. Sin embargo, si el portador sufre una Disfunción mágica, deberá tirar 3D6 en la tabla de Disfunciones mágicas, descartando el dado que el oponente elija.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="f3f1-54d8-686d-dcf0" name="Señor del conocimiento" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(Ruina y Plaga)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <entryLinks>
            <entryLink id="9c34-bf97-e984-3116" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="65.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="68c1-cbd7-dc4c-b64a" name="Artefactos arcanos. Skaven" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8690-088f-4611-6ab3" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ea78-8d6a-97cb-4387" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="f53f-dedd-c2bd-2682" name="Pergamino de tormenta de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="65a1-fb1e-62bf-8b9c" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7e70-8499-db31-efe7" type="max"/>
          </constraints>
          <profiles>
            <profile id="ced4-2b16-7622-9752" name="Pergamino de tormenta de disformidad" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Objeto portahechizos de nivel de energía 5. Se trata de un hechizo de Tempestad mágica. Todas las unidades con la regla especial Volar o Flotar que estén haciendo uso de dichas reglas sufrirán 1D6 impactos automáticos de Fuerza 5 distribuidos como disparos con la regla especial Ataque de rayos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="5850-51c5-c64a-78ed" name="Ojo de la Gran cornuda" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2e9c-d93a-50d6-8cdb" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d935-dfe7-cce4-6c2f" type="max"/>
          </constraints>
          <profiles>
            <profile id="be5b-97c6-0269-f3d5" name="Ojo de la Gran cornuda" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, tira 1D6: si obtienes un resultado de 2+, generas un dado adicional de Energía esa fase; sin embargo, si obtienes un resultado de 1, perderás uno de los dados que te hayan concedido los Vientos de la Magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="7be8-66c7-7d21-07ad" name="Familiar rátido" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0254-d94b-1376-7e6b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="66ff-63fd-9305-7417" type="max"/>
          </constraints>
          <profiles>
            <profile id="9c25-4573-5e9d-f699" name="Familiar rátido" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. El hechicero podrá aumentar en 1D3 la tirada de lanzamiento de uno de sus hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6dc5-130b-d332-971d" name="Pergamino maldito de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e43a-46a2-22d0-d954" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="34cc-1e8e-a6e1-3013" type="max"/>
          </constraints>
          <profiles>
            <profile id="e723-2279-161a-47e4" name="Pergamino maldito de disformidad" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Objeto portahechizos de nivel de energía 1D6+2. Contiene un hechizo de Maldición que toma como objetivo a una unidad enemiga a 24” o menos del lanzador. Cada miniatura de la unidad objetivo sufre un impacto automático de Fuerza 3 que no permite tiradas de salvación por armadura. Cualquier unidad que sufra al menos una baja a causa de este hechizo deberá efectuar inmediatamente un chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="2bbe-5413-52e0-1f23" name="Objetos hechizados. Skaven" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="908e-f01a-1960-32fa" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d138-c0c6-4407-89e9" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="8982-b65b-0a0e-f416" name="Brazaletes de poder" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8d4b-77d2-d7fe-b61b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="164a-290d-8ca8-a108" type="max"/>
          </constraints>
          <profiles>
            <profile id="81d0-302c-37ee-0d0b" name="Brazaletes de poder" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 4. Contiene un hechizo de Potenciación que puede lanzarse sobre el portador y Permanece un turno. Mientras permanezca en efecto, duplica el atributo de Fuerza del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="7a45-1520-90bb-51db" name="Potaje skaven" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e10c-c9c2-9704-9450" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6976-4efd-ea81-cc45" type="max"/>
          </constraints>
          <profiles>
            <profile id="6825-0026-41bb-c4e9" name="Potaje skaven" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Al principio de la batalla, la unidad de Ratas de clan o Alimañas a la que esté unido se tragará el misterioso engrudo. Los Oficiales recibirán sus efectos pero ningún otro personaje será tan tarugo como para tragarse eso. Tira 1D6 en la tabla de efectos del Potaje skaven y aplica el resultado durante toda la batalla:

1 Indigestión: La unidad sufre 1D6 impactos de Fuerza 3 sin posibilidad de salvación por armadura.
2-3 Inspirar Odio: La unidad obtiene la regla especial Odio (¡todos los enemigos!).
4-5 Furia Asesina: La unidad obtiene la regla especial Furia asesina.
6 Locura Asesina: La unidad se considera durante toda la batalla bajo los efectos del hechizo Locura asesina. Tenen cuenta que no es un hechizo y por tanto no puede dispersarse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0090-05dd-6c64-3843" name="Skalm" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1b36-f617-d01d-0579" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="37f8-281c-d788-fed4" type="max"/>
          </constraints>
          <profiles>
            <profile id="f769-103a-0c50-ba86" name="Skalm" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier fase de magia, disparo o combate cuerpo a cuerpo propia o del enemigo. El portador restablecerá 1D6 heridas que hubiese sufrido previamente en la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4a2b-b46c-b36d-4697" name="Cohete aniquilador" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2a29-c06b-de0b-b5d6" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4df0-72c6-5c19-512b" type="max"/>
          </constraints>
          <profiles>
            <profile id="230b-7d30-fd70-4a6e" name="Cohete aniquilador" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse en cualquier fase de disparo propia si el portador no está trabado en combate ni ha marchado durante ese turno. Estima una distancia de entre 0-8 dados más el dado de artillería (como si se tratase de un Cañón): coloca la plantilla redonda grande al final de la distancia estimada. Cualquier miniatura bajo la plantilla (utiliza las reglas habituales de impactos parciales) sufrirá un impacto de Fuerza 5 con la regla especial Ataques mágicos. Si obtienes un resultado de Problemas en la primera tirada del dado de artillería, tira 1D6 en la tabla de problemas del Cohete Aniquilador:

1 ¡Buuum!: Coloca la plantilla redonda grande centrada sobre el lanzador y resuelve el impacto de manera habitual.
2-5 Pérdida del ala estabilizadora: Tira el dado dedispersión para determinar la dirección que tomará el cohete desde el lanzador.
6 Inutilizado: El cohete no explota. No hay efecto
adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8bf3-be57-a694-9b21" name="Cañerías de Piebald" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7e1d-70c8-95fb-6ddd" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4890-e195-38e1-fac0" type="max"/>
          </constraints>
          <profiles>
            <profile id="60f1-1fdf-218a-8394" name="Cañerías de Piebald" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Siempre que una unidad enemiga quiera cargar contra el portador o su unidad antes deber superar un chequeo de Liderazgo; si lo falla, no podrá cargar ni mover ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="dc53-7cea-3103-98ed" name="Portentos del destino funesto" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="13d9-21c5-aaa3-0c89" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="de1b-8615-0a46-4717" type="max"/>
          </constraints>
          <profiles>
            <profile id="1743-4033-cd44-3e66" name="Portentos del destino funesto" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Cualquier unidad enemiga en contacto peana con peana con el portador tendrá un penalizador de -1 a su Liderazgo. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8941-cb1b-9da7-2daf" name="Amuleto de piedra de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d3fc-41e1-3044-698d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="97c5-da0d-3829-f957" type="max"/>
          </constraints>
          <profiles>
            <profile id="411e-9ac2-58b0-8968" name="Amuleto de piedra de disformidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, un único dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="fafa-d2f6-36f1-58ad" name="Fetiche skaven" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="142e-a3bc-7793-e401" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ee3d-2edc-8a66-4a91" type="max"/>
          </constraints>
          <profiles>
            <profile id="d41a-658d-9a47-3e7c" name="Fetiche skaven" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga la regla especial Resistencia mágica (1D3): tira para determinar el valor de la Resistencia mágica cada vez que vayas a utilizarla para dispersar un hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="3892-e46c-c275-8c1a" name="Resistencia mágica" hidden="false" targetId="2326-75e1-288f-6ccd" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(1D3)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="46ca-4d2e-7aa6-80ef" name="Estandartes mágicos. Reliquias. Skaven" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ae2f-5c0c-8189-3084" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ca22-6ffc-7796-73b8" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="783e-729f-cfbe-f9d7" name="Estandarte sagrado de la Gran Cornuda" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3e51-01a2-02ef-0e32" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="be8e-13ec-b82e-e182" type="max"/>
          </constraints>
          <profiles>
            <profile id="5138-3a41-4116-0f6a" name="Estandarte sagrado de la Gran Cornuda" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Tozudez y causan Miedo. Todas las unidades enemigas a 12&quot; o menos del portador sufrirán un penalizador de -1 a su Liderazgo. Adicionalmente, el jugador puede obligar a todas las unidades en contacto peana con peana con el portador a repetir todos sus chequeos de Liderazgo exitosos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="92d5-8857-54a0-7ea5" name="Tozudez" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
            <infoLink id="59af-ce11-fc1d-2b61" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
          </infoLinks>
          <entryLinks>
            <entryLink id="41d1-3540-7206-d4d5" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="100.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="5821-1a15-ccc0-b49d" name="Estandartes mágicos. Skaven" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c79c-ddc8-716b-e8d4" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="36d3-d0e7-b096-5ef2" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="3f96-35bc-f0a1-916e" name="Estandarte de la tempestad" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c964-089a-0652-ee78" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c9e5-7f2c-71c6-6bc8" type="max"/>
          </constraints>
          <profiles>
            <profile id="34c9-dbd2-8e1b-1acb" name="Estandarte de la tempestad" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un solo uso. Puedes activar el estandarte al comienzo del turno de cualquier jugador. Las miniaturas con la regla especial Volar o Flotar no podrán hacer uso de esa regla y se verán obligadas a utilizar su atributo de movimiento.
Adicionalmente, todos los ataques de disparo tendrán un penalizador de -2 en sus tiradas para impactar. Todos los ataques de disparo que no utilicen la HP deberán sacar un resultado de 4+ en 1D6 para poder disparar. Al comienzo del turno del jugador propietario del estandarte (salvo el turno en que fue activado), tira 1D6; con un resultado de 4-6, el estandarte pierde su poder y deja de tener efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d86e-96a2-8b79-c280" name="Gran estandarte de superioridad de clan" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="bf0f-17f9-9106-6d4e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6169-c452-132b-0b52" type="max"/>
          </constraints>
          <profiles>
            <profile id="1f0b-ccce-b38e-b46b" name="Gran estandarte de superioridad de clan" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Una unidad que porte el Gran estandarte de superioridad de clan y que tenga más filas completas que sus oponentes obtendrá 1D3 puntos adicionales al resultado del combate. Tira al final de cada combate</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f5c9-e423-707d-552f" name="Mortaja de la muerte supurante" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="fdf4-0a0d-2a1e-ed1d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5971-e6c9-2635-af20" type="max"/>
          </constraints>
          <profiles>
            <profile id="98e9-ee58-b325-2fd7" name="Mortaja de la muerte supurante" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas enemigas en contacto peana con peana con el portador de este estandarte sufrirán al principio de cada ronda de combate un impacto de Fuerza 3 sin tirada de salvación por armadura. Además, si la unidad portadora de la Mortaja de la muerte supurante huye, cualquier unidad que la persiga sufrirá 1D6+2 impactos de Fuerza 3 sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="fcc0-e225-8945-24f1" name="Estandarte del imperio subterráneo" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="52dc-684e-695d-9334" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d2b2-08f6-fa8a-8a39" type="max"/>
          </constraints>
          <profiles>
            <profile id="c597-c148-73d5-d0ed" name="Estandarte del imperio subterráneo" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades en contacto peana con peana la unidad sufrirán 2D6 impactos automáticos de Fuerza 2 con la regla especial Poder de penetración al principio de todas las rondas de combate distribuidos como si fueran disparos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d22d-1d81-cea4-6387" name="Estandarte de la huida de rata" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7aff-a959-ad26-aaac" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4350-7346-e2f2-912f" type="max"/>
          </constraints>
          <profiles>
            <profile id="0067-e253-6ea5-c712" name="Estandarte de la huida de rata" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un solo uso. Al inicio de cualquier turno aliado a excepción del primero puedes activar el estandarte. Si la unidad portadora puede realizar un movimiento de marcha, podrá realizarlo al triple de su velocidad. Sin embargo, después de realizar el movimiento la unidad portadora sufrirá 2D6 impactos de Fuerza 3 sin tirada de salvación por armadura distribuidos como si fueran disparos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="ca58-ae7f-c497-2fb1" name="Estandarte de los cuatro vientos negros" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e0a4-ae4b-b0ce-a25e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3fb0-991c-3812-e854" type="max"/>
          </constraints>
          <profiles>
            <profile id="fa4a-23b8-a605-b7e2" name="Estandarte de los vientos negros" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los disparos contra la unidad tendrán un 
penalizador de -1 en su tirada para impactar. Además, ningún enemigo que cargue al portador o su unidad podrá aplicar bonificadores a su Iniciativa por cargar ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="f4cf-1e76-a8f4-0251" name="Armaduras mágicas. Skaven" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="85a3-7204-2d48-9a0d" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c961-252d-81dc-2819" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="35ca-bead-0db5-91c0" name="Armadura del fin del mundo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="afc7-39f3-1d0b-012a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1e2a-1786-6d66-a6e3" type="max"/>
          </constraints>
          <profiles>
            <profile id="d637-5eb5-26d9-7006" name="Armadura del fin del mundo" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Otorga a su portador una tirada de salvación por armadura de 4+ (en lugar de 5+) y será inmune a los efectos de la regla especial Poder de penetración. Además, el portador tendrá una tirada de salvación especial de 5+ y la regla especial Resistencia mágica (1). Sin embargo, todos las miniaturas con la clave enanos podrán repetir todas sus tiradas fallidas para impactar en combate cuerpo a cuerpo contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="ae1f-c763-6213-91e1" name="Armadura pesada" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
            <infoLink id="faae-b39f-2488-0839" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
            <infoLink id="53b5-c10c-c25b-44c0" name="Inmune a Poder de penetración" hidden="false" targetId="1cd7-e229-65a3-05a5" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2972-2bc8-e7e4-be47" name="Armadura roída" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6b81-f0bb-cda4-86fd" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2c30-e11f-b938-04f5" type="max"/>
          </constraints>
          <profiles>
            <profile id="f9c9-1b8c-ea2b-689b" name="Armadura roída" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Resta 1 a la Fuerza de todos los impactos contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7571-5e7f-b75b-3de0" name="Armadura pesada" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0867-5600-1414-0893" name="Armadura de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c8fd-7d08-1aac-f159" type="max"/>
            <constraint field="selections" scope="roster" value="-1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c601-6ab2-f580-7356" type="max"/>
          </constraints>
          <profiles>
            <profile id="0d54-495d-da62-a6af" name="Armadura de disformidad" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Otorga a su portador una tirada de salvación por armadura de 4+ en lugar del habitual 5+. Adicionalmente, por cada tirada de salvación por armadura exitosa, la miniatura inflige un impacto de Fuerza 4 contra la miniatura que provocó la tirada. Cualquier número de Ingenieros brujos de tu ejército pueden equiparse con esta armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="373e-8c2c-0c46-23b1" name="Armadura bruja" hidden="false" targetId="925b-2ee3-16fb-d195" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2827-446e-a02e-f4c8" name="Escudo de distracción" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="dca8-71c3-29a1-4444" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c89a-b6fb-6c04-4357" type="max"/>
          </constraints>
          <profiles>
            <profile id="fa1f-e4e2-2576-2a31" name="Escudo de distracción" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Todas las miniaturas en contacto peana con peana con el portador sufrirán un penalizador de -1 a sus Ataques si le quieren atacar a él, hasta un mínimo de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7d8d-381c-5b14-2f7b" name="Escudo" hidden="false" targetId="c028-354e-9169-7463" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="b5a8-3a75-fbcd-cf44" name="Armas mágicas. Skaven. Alabarda bruja" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="45de-ed11-0bcf-5759" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="01cb-b244-2e6c-2efd" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="46ba-a6f0-e71b-45f1" name="Arma de ingeniero" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0924-d6da-84cd-ca4b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c74c-8419-726a-7271" type="max"/>
          </constraints>
          <profiles>
            <profile id="80de-ab1a-9643-a69f" name="Arma de ingenierio" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Alabarda. Los ataques realizados con este arma se resuelven con un bonificador de +1 a la Fuerza y los Ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1fec-4f55-0cc0-3348" name="Alabarda bruja" hidden="false" targetId="512a-5c1c-116b-c9ad" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="c143-7882-c7f3-a377" name="Armas mágicas. Skaven. Arma de mano" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5d80-3a0f-8a48-48c1" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8835-80e9-5619-8a10" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="b8a9-a422-8da7-f816" name="Espada de la furia negra" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="aade-9aa0-6a28-59e6" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7c06-7f5c-6625-c612" type="max"/>
          </constraints>
          <profiles>
            <profile id="e763-3bff-e14e-7e57" name="Espada de la furia negra" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al utilizar este arma en combate, su portador obtiene +2 Ataques. Además, obtiene la regla especial Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="c346-46e8-dac1-c538" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="151a-875a-04b7-0cbc" name="Estupidez" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d521-9e67-ed67-192d" name="Espada maldita del delirio" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f1ba-ea5a-2fd0-2276" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c7cf-ce37-2741-dc1f" type="max"/>
          </constraints>
          <profiles>
            <profile id="dbae-41fe-6b8e-46b5" name="Espada maldita del delirio" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El portador obtendrá un bonificador de +1 en sus tiradas para impactar en cuerpo a cuerpo con este arma. Además, los enemigos tendrán un penalizador de -1 en sus tiradas para impactar al portador en cuerpo a cuerpo. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="63fc-7bfc-bd9f-8bdc" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
