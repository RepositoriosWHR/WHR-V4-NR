    <selectionEntry id="4432-ed0e-b80f-ec57" name="Diablos de asalto" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="998c-db80-51d7-bf9a" value="4.0">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="170b-06ad-215f-f891" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="998c-db80-51d7-bf9a" value="6.0">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3673-aaa8-d1d9-e6c2" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="998c-db80-51d7-bf9a" type="max"/>
      </constraints>
      <rules>
        <rule id="48c2-d678-8a47-e464" name="Grande y pesado" hidden="false">
          <description>No podrá hacer uso de la regla especial Veloz que le otorga su condición de Bestia monstruosa. Adicionalmente, obtiene la regla especial Impactos por carga (1).</description>
        </rule>
        <rule id="8f0e-7f7e-43f5-c33e" name="Inteligencia sobreroedora" hidden="false">
          <description>Los Diablo de asalto tiene un ángulo de visión de 180º. En contrapartida, todos los ataques en cuerpo a cuerpo realizados contra los Diablos de asalto por la retaguardia obtendrán un bonificador de +1 en sus tiradas para herir.</description>
        </rule>
        <rule id="6948-3114-cc3d-4616" name="Orgullo de Throt e Ikit" hidden="false">
          <description>Si Ikit Claw es el general del ejército, los Diablos de Asalto contarán como Grupo de apoyo a efectos de la regla Ingeniero-Jefe de Ikit. Si Throt el Inmundo es el general del ejército, los Diablos de Asalto contarán como opción de Unidad Especial (podrás incluir hasta 4 Diablos de Asalto, o hasta 6 en un Gran Ejército).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="b68e-7ec5-ccbd-f13c" name="Bestias monstruosas" hidden="false" targetId="2e1e-da3a-8081-991c" type="rule"/>
        <infoLink id="e724-2ba5-216f-6d6b" name="Impasible" hidden="false" targetId="592b-c850-fd09-cce5" type="rule"/>
        <infoLink id="77c8-333d-84d8-3f67" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink id="51bd-7e9f-7aa8-4f28" name="Impactos por carga (1)" hidden="false" targetId="8de0-8a91-edee-076e" type="rule"/>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="319e-c0bb-0424-32c3" name="New CategoryLink" hidden="false" targetId="5261726523232344415441232323" primary="true"/>
      </categoryLinks>
