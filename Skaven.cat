          <selectionEntries>
            <selectionEntry id="d6de-c54c-ffb8-4b47" name="Guanteletes aturdidores" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="50c4-4e1e-2ceb-84b2" type="max"/>
              </constraints>
              <profiles>
                <profile id="4064-7e46-979c-ae6c" name="Guanteletes aturdidores (combate)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Niega salvación por armadura, Cada resultado de 6 para impactar generará un ataque adicional (que no genera nuevos ataques)</characteristic>
                  </characteristics>
                </profile>
                <profile id="3b50-0d8f-d0b7-19b3" name="Guanteletes aturdidores (Disparo)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">10&quot;</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Niega salvación por armadura, Disparo rápido y Disparos múltiples (2).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="fb4c-4414-eff6-cc48" name="Guanteletes aturdidores" hidden="false">
                  <description>Armas emparejadas. Cada resultado de 6 para impactar generará un ataque adicional (que no genera nuevos ataques). Sin embargo, si obtienes dos o más resultados de 1 en las tiradas para impactar, el Diablo de asalto sufrirá un impacto automático de Fuerza 5 con las reglas especiales Ataque de rayos y Ataques mágicos. Los ataques con este arma niegan la tirada de salvación por armadura y tienen la regla especial Ataques mágicos. Además, pueden utilizarse como un arma de disparo de alcance 10”, Fuerza 5 y las reglas especiales Ataques mágicos, Disparo rápido y Disparos múltiples (2); estos disparos no permiten salvación por armadura.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f083-b82f-e3b0-be33" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink id="e6c7-63f3-6440-9581" name="Disparos múltiples (2)" hidden="false" targetId="f150-3b7d-99ed-c809" type="rule"/>
                <infoLink id="f6a0-bc96-1acc-8b94" name="Disparo rápido" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
                <infoLink id="11d4-7a31-2c97-be01" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="ac9a-a48c-0599-9205" name="Ristra de amerratadoras" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f4c4-b170-cd0a-27c0" type="max"/>
              </constraints>
              <profiles>
                <profile id="5f7c-2d61-e710-161f" name="Ristra de amerratadoras (Combate)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">+1 Ataque, requiere ambas manos, </characteristic>
                  </characteristics>
                </profile>
                <profile id="008e-a024-ae46-d314" name="Ristra de amerratadoras (Disparo)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">18&quot;</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos y Poder de penetración</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="8c5e-6ddf-b060-a331" name="Ristra de amerratadoras" hidden="false">
                  <description>Se trata de un arma de Tormenta de proyectiles que puede Mover y disparar. Los disparos tienen un alcance de 18&quot;, Fuerza 4 y las reglas especiales Ataques mágicos y Poder de penetración. Utiliza el dado de artillería para determinar el número de impactos automáticos que causa. Puedes, si lo deseas, tirar otra vez el dado de artillería y sumar el resultado al número de impactos que realiza. En combate, la Ristra de amerratadoras cuenta como Armas emparejadas. Los disparos efectuados por la Ristra de amerratadoras impactan automáticamente y puede Aguantar y disparar como reacción a una carga. Si en cualquiera de las tiradas obtienes un resultado de Problemas, tira 1D6 en la siguiente tabla:

1-2 ¡Blam!: El Diablo de asaltosufre inmediatamente 1D3+1 heridas automáticas que no permiten tirada de salvación por armadura.
3-5 ¡Peonza!: Tira el dado de dispersión. Encara el Diablo de asalto en la dirección indicada y realiza todos los disparos que haya obtenido en las tiradas del dado de artillería más dos. Tira para impactar contra la primera unidad en su trayectoria y que se encuentre dentro de su alcance, sea amiga o enemiga.
6 ¡Bbbbrrrrrttt!: El arma realiza todos sus disparos contra el objetivo previsto con las reglas habituales pero con Fuerza 2.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="4b57-1beb-2148-a022" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink id="db5b-1009-7979-1d6f" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="ddf5-016e-c635-464d" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink id="a06e-8010-ad8e-6c82" name="Disparos múltiples" hidden="false" targetId="fc7e-40e6-a7aa-4530" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(3D6+3)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="60.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="2a50-3eec-8c80-e7b8" name="Proyectores de fuego disforme" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b747-f521-03eb-2c33" type="max"/>
              </constraints>
              <profiles>
                <profile id="7ed1-66ae-48eb-9035" name="Proyectores de fuego disforme (Disparo)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">Est. 0</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques sólo flamígeros, Ataques mágicos y Heridas 
múltiples (1D3)</characteristic>
                  </characteristics>
                </profile>
                <profile id="5f5c-63fd-47b3-0e2c" name="Proyectores de fuego disforme (combate)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">+1 Ataque, requiere ambas manos, Ataques flamígeros y Ataques mágicos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="df60-adeb-2c2d-c044" name="Proyectores de fuego disforme" hidden="false">
                  <description>Son armas de disparo que pueden Mover y disparar y disparan como un Lanzallamas que estima 0 dados (tira sólo el dado de artillería). Puede Aguantar y disparar como reacción a una carga. Estos disparos se resuelven con Fuerza 5 y las reglas especiales Ataques sólo flamígeros, Ataques mágicos y Heridas múltiples (1D3). En combate cuerpo a cuerpo, cuentan como Armas emparejadas con las reglas especiales Ataques flamígeros y Ataques mágicos. El Diablo de asalto puede realizar hasta dos disparos cada fase de disparo -uno con cada brazo- y podrá dividir sus disparos, pero deberá decidirlo en el momento de ser seleccionado para disparar (tira cada dado de artillería por separado). Cualquier unidad que sufra una o más bajas a causa del Lanzallamas deberá realizar un chequeo de Pánico. Si obtienes un resultado de Problemas, tira 1D6 en la siguiente tabla:

1-2 ¡Whompfff!: Coloca la plantilla redonda grande centrada sobre la miniatura y resuelve los impactos de manera habitual. Después retira el Diablo de asalto como baja.
3-5 Fuga de combustible: Tira 2D6 y el dado de dispersión para determinar el movimiento que realizará antes de explotar. Se detendrá si entra en contacto con una unidad o con Terreno impasable (y realizará sus Impactos por carga aun fuera de la secuencia habitual del turno). Después de este movimiento, explotará del mismo modo que en el resultado de ¡Whompfff! pero no retira al Diablo de asalto como baja.
6 ¡Pppphhtt!: El Proyector de fuego disforme no puede disparar este turno.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="55d5-be86-e383-3d02" name="Lanzallamas" hidden="false" targetId="b67f-988d-ab4b-1806" type="rule"/>
                <infoLink id="8899-83f4-3b2b-ddf1" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink id="cb22-5ea0-2001-1e0d" name="Ataques solo flamígeros" hidden="false" targetId="5587-433b-16c0-79d1" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(Disparo)"/>
                  </modifiers>
                </infoLink>
                <infoLink id="8621-dc9f-481b-06ab" name="Heridas múltiples (1D3)" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
                <infoLink id="fa4f-1e21-06c9-44c2" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink id="3166-e04a-d205-467e" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="80.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="185b-68aa-e554-4782" name="Lanzaesferas de repetición" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2223-f2fb-9e69-aa30" type="max"/>
              </constraints>
              <rules>
                <rule id="0a37-879c-7dbf-6b2b" name="Lanzaesferas de repetición" hidden="false">
                  <description>Se tratan de armas que pueden Mover y disparar y disparan como una Catapulta que utiliza la plantilla redonda pequeña, tiene un alcance de 6-24&quot; y la regla especial Ataques mágicos. Cualquier miniatura bajo la plantilla (utiliza las reglas habituales para impactos parciales) sufrirá una herida automática con un resultado de 4+ en 1D6 sin tirada de salvación por armadura. En combate cuerpo a cuerpo cuenta como Armas emparejadas. El Diablo de asalto puede realizar hasta dos disparos cada fase de disparo -uno con cada brazo- y podrá dividir sus disparos, pero deberá decidirlo en el momento de ser seleccionado para disparar (tira los dados de artillería y dispersión por separado en cada disparo). Si en cualquiera de las tiradas obtienes un resultado de Problemas, tira 1D6 en la siguiente tabla:

1-2 ¡Explosión de gas!: Coloca la plantilla redonda grande centrada sobre el Diablo de Asalto. Todas las miniaturas bajo la plantilla (utiliza las reglas habituales para impactos parciales) sufrirán una herida con un resultado de 4+ en 1D6 sin posibilidad de salvación por armadura. Si has obtenido este resultado durante el primer disparo de la fase en curso, no realices ningún otro disparo y aplica este resultado dos veces consecutivas.
3-5 ¿Allá-allí o allí-allá?:El enemigo puede colocar la plantilla en cualquier lugar a 3D6&quot; del objetivo inicial.
6 ¡Antes de tiempo!: El disparo se pierde. No hay efectos adicionales.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="1664-eb67-d70d-fb37" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink id="d038-8392-0d8f-c7cd" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="60.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="9c05-e1e7-f431-358a" name="Brocas perforadoras" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ddfe-3a08-74d8-9e54" type="max"/>
              </constraints>
              <rules>
                <rule id="d1c7-36a8-c1af-f0b6" name="Brocas perforadoras" hidden="false">
                  <description>Otorga la regla especial Avance subterráneo. En combate, en lugar de sus ataques habituales el Diablo de asalto realiza 2D3+2 impactos automáticos de Fuerza 5 con las reglas especiales Ataques mágicos, Poder de penetración y Golpe letal; sin embargo, si al determinar el número de impactos obtienes un resultado doble en los dados, el Diablo de asalto sufrirá un impacto automático de Fuerza 5 con las reglas especiales Ataque de rayos y Ataques mágicos (aunque causará sus impactos de forma habitual).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="a644-b11a-f269-1410" name="Avance subterráneo" hidden="false" targetId="94d7-d5aa-28b3-b617" type="rule"/>
                <infoLink id="6a8a-4da4-5bcd-06ce" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink id="7a05-4680-1bd8-6e5d" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="3943-0627-16af-bd08" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="45.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="7ae4-1243-f29c-35e1" name="Mitones pilones" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f0b5-22eb-e1cc-932d" type="max"/>
              </constraints>
              <rules>
                <rule id="c8e1-b8b5-398d-5e25" name="Mitones pilones" hidden="false">
                  <description>Armas emparejadas. Otorga a su portador un bonificador de +1 a la Fuerza en todos sus ataques en cuerpo a cuerpo e Impactos por carga y la regla especial Carga devastadora. En combate, cuenta con la regla especial Heridas múltiples (2). Sin embargo, si obtienes dos o más resultados de 1 en la tirada para impactar con este arma, el Diablo de asalto sufrirá un impacto automático de Fuerza 5 con las reglas especial Ataque de rayos y Ataques mágicos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="6e0c-af1a-dec6-a830" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink id="439f-f2bc-7872-ab6b" name="Carga devastadora" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
                <infoLink id="d9e5-ebbb-917f-5383" name="Heridas múltiples (2)" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
