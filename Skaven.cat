    <selectionEntry name="Abominación de pozo infernal" id="38d0-687d-6b89-c20d" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="151f-603d-bbf5-0532" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
