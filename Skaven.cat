              <rules>
                <rule name="Magia Gran dragón fuegobrujo" id="b48f-bcd8-b911-ac7d" hidden="false">
                  <description>Un Gran dragón fuegobrujo puede convertirse en hechicero de nivel 1 por +40 puntos o nivel 2 por +70 puntos y elige sus hechizos del Saber de Magia oscura.</description>
                </rule>
