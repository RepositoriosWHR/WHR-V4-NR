          <selectionEntries>
            <selectionEntry id="dbe8-ff8e-aba1-a99e" name="Degolladora de enanos" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="73a6-e7ef-c9d2-e291" type="max"/>
