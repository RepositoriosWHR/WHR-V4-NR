          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6e61-3db5-a866-8a3c" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3525-525c-984b-dbb3" type="min"/>
          </constraints>
          <selectionEntries>
            <selectionEntry id="c666-04bf-4c55-5b0d" name="Torbellino de espadas supurantes" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0c0a-c96e-fe74-adde" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d58c-a6cd-a4c8-3731" type="min"/>
              </constraints>
              <profiles>
                <profile id="3130-ee7c-f158-9d60" name="Torbellino de espadas supurantes" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas (otorgan a Snikch +2 Ataques en lugar de +1, ya que se trata de un trío de armas en lugar de una pareja). Los impactos causados con estas armas tienen las reglas especiales Ataques envenenados, Poder de penetración y Heridas múltiples (1D3).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="7217-5f2f-7f1f-5955" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink id="677f-b8f0-a108-7c6a" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink id="caa8-985e-a6e1-74d7" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="60fe-2c0c-f111-f115" name="Heridas múltiples (1D3)" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
              </infoLinks>
              <costs>
