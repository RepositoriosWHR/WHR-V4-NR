                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a Kritislik y a su unidad una tirada de salvación especial de 5+ y la regla especial Resistencia mágica (1).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
