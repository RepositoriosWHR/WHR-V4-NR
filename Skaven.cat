            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1135-118b-3d4a-28e8" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="4.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="e323-e7c4-cf9c-a446" type="max"/>
      </constraints>
      <rules>
        <rule id="19da-4b16-1a13-767b" name="Grande y pesado" hidden="false">
          <description>No podrá hacer uso de la regla especial Veloz que le otorga su condición de Bestia monstruosa. Adicionalmente, obtiene la regla especial Impactos por carga (1).</description>
        </rule>
        <rule id="b0c3-4c4b-03f5-6730" name="Inteligencia sobreroedora" hidden="false">
          <description>Los Diablo de asalto tiene un ángulo de visión de 180º. En contrapartida, todos los ataques en cuerpo a cuerpo realizados contra los Diablos de asalto por la retaguardia obtendrán un bonificador de +1 en sus tiradas para herir.</description>
        </rule>
        <rule id="758c-00f1-050e-ffb7" name="Orgullo de Throt e Ikit" hidden="false">
          <description>Si Ikit Claw es el general del ejército, los Diablos de Asalto contarán como Grupo de apoyo a efectos de la regla Ingeniero-Jefe de Ikit. Si Throt el Inmundo es el general del ejército, los Diablos de Asalto contarán como opción de Unidad Especial (podrás incluir hasta 4 Diablos de Asalto, o hasta 6 en un Gran Ejército).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d6b7-ed15-71d8-f79d" name="Bestias monstruosas" hidden="false" targetId="2e1e-da3a-8081-991c" type="rule"/>
