      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="99f9-45a1-6969-fee7" type="max"/>
      </constraints>
      <rules>
        <rule id="0ab4-f848-7719-d5f5" name="Magia Kritislik, señor de la videncia del consejo de los trece" hidden="false">
          <description>Kritislik es un hechicero de nivel 4 que conoce todos los hechizos de los Saberes de Ruina y Plaga. </description>
        </rule>
        <rule id="0ac5-f14c-41c6-c652" name="Gran vidente" hidden="false">
          <description>La regla especial Presencia inspiradora de Kritislik (por ser el General del ejército) tiene un alcance de 18” en lugar de las 12” habituales.</description>
        </rule>
        <rule id="4e2f-4aca-50ef-dd2b" name="Potencia de unidad 5" hidden="false"/>
      </rules>
      <infoLinks>
        <infoLink id="7c53-daa0-0508-7a4f" name="La fuerza del número" hidden="false" targetId="2c14-2f77-f8ea-d0b5" type="rule"/>
        <infoLink id="1f98-1afc-77f7-87c0" name="Coraje mezquino" hidden="false" targetId="e7d9-b876-8ed2-648f" type="rule"/>
