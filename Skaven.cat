          <profiles>
            <profile name="Señor de las alimañas exaltado" id="9d26-a460-247f-f351" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">10</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">8</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">4</characteristic>
                <characteristic name="F" typeId="5.323232344415441e+21">8</characteristic>
                <characteristic name="R" typeId="5.423232344415441e+21">7</characteristic>
                <characteristic name="H" typeId="5.723232344415441e+21">7</characteristic>
