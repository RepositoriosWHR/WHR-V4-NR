    <selectionEntryGroup name="Objetos hechizados. Skaven. Ingeniero brujo" id="0173-97a8-0968-8426" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="7476-65a9-916f-8d9a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="a9c7-8860-fc2d-4eca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Orbe de cobre" id="042a-68bd-7710-9293" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c012-2f31-f033-cdcb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="be90-78bc-8a2e-0b0a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Orbe de cobre" id="20e2-d8f8-1efd-37ff" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Ingeniero brujo. Un sólo uso. Puedes declarar que lo utilizas en cualquiera de tus fases de disparo. Para ello, indica una dirección desde el portador y tira 3D6 para determinar la distancia que recorre hasta estallar. Todas las unidades (amigas o enemigas) a 12” o menos del punto en el que aterrice el orbe sufrirán inmediatamente 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos. Si obtienes un resultado de triples al determinar la distancia, algo habrá ido mal y el orbe aterrizará sobre el propio portador (resuélvelo como se ha descrito) y tras ello el portador sufrirá 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Skaven. Ingeniero brujo" id="7d81-7dad-50a8-3224" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="36f6-a2dd-1467-88db" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Coraza mecanizada de disformidad" id="8081-282b-b31a-a88d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="54f6-c446-ba95-5e16" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f774-b13b-32b7-d5d1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="70"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura bruja" id="8722-e352-dc4c-49b0" hidden="false" targetId="925b-2ee3-16fb-d195" type="profile"/>
            <infoLink name="Indesmoralizable" id="e4ad-d812-0bbf-345e" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
            <infoLink name="Heridas múltiples (2)" id="5783-50e7-1cf4-dd23" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule"/>
            <infoLink name="Terror" id="e7e6-65b7-f651-476b" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
            <infoLink name="Impactos por carga (1D3)" id="4ebb-11d5-5de8-bb21" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
            <infoLink name="Movimiento aleatorio (2D6)" id="9a4a-466d-49e1-5705" hidden="false" targetId="351f-72b7-17d0-bebd" type="rule"/>
            <infoLink name="Ataques aleatorios" id="86c1-2e4d-3242-de15" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(1D6)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Coraza mecanizada de disformidad" id="7c83-292f-b605-5f28" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Sólo Ingeniero brujo. Otorga a su portador una tirada de salvación por armadura de 1+. El portador no puede unirse a unidades ni usar una montura pero obtiene un bonificador de +1 a su Fuerza, Resistencia y Heridas así como las reglas especiales Movimiento aleatorio (2D6), Ataques aleatorios (1D6) Impactos por carga (1D3) e Indesmoralizable, además de causar Terror. Además, todos los disparos contra el portador tendrán un penalizador de -1 para impactar. Adicionalmente, podrá hacer uso de su armamento de la forma habitual, aunque contará como si no hubiese movido a efectos de disparar sus armas de proyectiles en caso de tenerlas. Sin embargo, por cada herida que sufra el portador, tira 1D6: con un resultado de 1-3 el portador sufrirá una herida adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
