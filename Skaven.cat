          </constraints>
          <profiles>
            <profile id="89d7-dc92-8a36-47d3" name="Estandarte de la rata podrida" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Monjes de plaga. Los ataques dirigidos contra el portador y su unidad tendrán un penalizador de -1 para impactarles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="6db3-978f-6d53-23cc" name="Objetos hechizados. Skaven. Personajes Eshin" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b621-98d9-69c8-115d" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1a88-5b80-4953-2d53" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="40b4-58e5-84d7-c3a5" name="Capa de la noche" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="537e-9f5a-08fc-89f9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cb3b-a261-13da-1bb7" type="max"/>
          </constraints>
          <profiles>
            <profile id="5e70-f21b-931a-11c0" name="Capa de la noche" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la clave clan Eshin. Aumenta la tirada de Esquivar del portador en +1. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="6e0f-ce25-8419-9cd8" name="Objetos hechizados. Skaven. Sacerdotes de la plaga" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="06c0-bc6d-e992-aebf" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a3b0-94ac-eb13-6871" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="08c1-e1ea-2e75-6190" name="Liber Bubonicus Vol. I" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3e95-a301-dc35-96ca" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="de9b-b956-c4d7-0c97" type="max"/>
          </constraints>
          <profiles>
            <profile id="cc27-6c6e-9c0f-4c1f" name="Liber Bubonicus vol. I" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Sacerdote de plaga Pestilens. El portador conoce un hechizo adicional. Además, una vez por fase de magia propia, tras haber tirado los dados para lanzar un hechizo del Saber de Plaga, el portador puede decidir tirar 1D3 y añadirlo al valor de lanzamiento. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="e0ac-0d63-d0f1-8508" name="Objetos hechizados. Skaven. Asesinos" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bcd5-8ddb-3809-e4be" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4154-ccd7-c663-cd5d" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="c943-7947-dbe0-a71a" name="Bomba infernal" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="86cc-b120-5b7d-a9c5" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="24f7-456b-e4fe-36e1" type="max"/>
          </constraints>
          <profiles>
            <profile id="68db-8417-55f4-2aff" name="Bomba infernal" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Asesino Eshin. Un solo uso. A excepción de los turnos en los que realice una carga, podrá colocar la Bomba infernal en cualquier punto del recorrido que haga durante su fase de movimiento o, si está incluido en una unidad, en cualquier punto del recorrido hecho por la unidad. Anuncia tu intención de soltar la Bomba infernal e indica el lugar con un marcador. La Bomba infernal puede detonarse remotamente en cualquier momento del juego posterior (excepto en el turno en el que fue colocada). Para detonar la bomba, tira 1D6; si obtienes un resultado de 1, esta está defectuosa y no estalla. Con un resultado de 2-6, coloca la plantilla redonda grande centrada en el marcador. Cualquier miniatura bajo el centro de la plantilla sufrirá un impacto de Fuerza 10 con la regla especial Heridas múltiples (1D6). El resto de miniaturas bajo la plantilla (utiliza las reglas habituales de impactos parciales) sufrirá un impacto de Fuerza 4 con la regla especial Poder de penetración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1456-0693-1f0b-afbb" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
            <infoLink id="e24f-feae-b444-940e" name="Heridas múltiples (1D6)" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="ec65-7f09-ce76-4e96" name="Bombas de humo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="fde2-e92f-c29d-bb1d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cb14-e6a5-5b64-b81f" type="max"/>
          </constraints>
          <profiles>
            <profile id="d699-91f0-06c6-e483" name="Bombas de humo" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la clave clan Eshin. Un solo uso. Si el portador se ve obligado a huir, lanzará unas bombas de humo que dificultarán la persecución. Todas las unidades que persiguen al portador o a la unidad en la que este se encuentre verá su Movimiento reducido a la mitad (redondeando hacia arriba) durante esa persecución. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="67a8-0738-410f-ed21" name="Talismanes mágicos. Skaven. Sacerdotes de la plaga" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e4a1-de5f-4a9c-62f4" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ad1b-e31b-5fdb-1e0f" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="fe48-d4c9-8888-b049" name="Colgante de putridez" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4c4d-7ac7-03df-60ea" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4c97-c163-2e52-8178" type="max"/>
          </constraints>
          <profiles>
            <profile id="8f30-1c06-27e0-28c8" name="Colgante de putridez" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo Sacerdote de plaga Pestilens. Otorga a su portador la regla especial Regeneración (5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="6a8f-f597-1927-2023" name="Regeneración (5+)" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="0173-97a8-0968-8426" name="Objetos hechizados. Skaven. Ingeniero brujo" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7476-65a9-916f-8d9a" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a9c7-8860-fc2d-4eca" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="042a-68bd-7710-9293" name="Orbe de cobre" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c012-2f31-f033-cdcb" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="be90-78bc-8a2e-0b0a" type="max"/>
          </constraints>
          <profiles>
            <profile id="20e2-d8f8-1efd-37ff" name="Orbe de cobre" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Ingeniero brujo. Un sólo uso. Puedes declarar que lo utilizas en cualquiera de tus fases de disparo. Para ello, indica una dirección desde el portador y tira 3D6 para determinar la distancia que recorre hasta estallar. Todas las unidades (amigas o enemigas) a 12” o menos del punto en el que aterrice el orbe sufrirán inmediatamente 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos. Si obtienes un resultado de triples al determinar la distancia, algo habrá ido mal y el orbe aterrizará sobre el propio portador (resuélvelo como se ha descrito) y tras ello el portador sufrirá 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="7d81-7dad-50a8-3224" name="Armaduras mágicas. Skaven. Ingeniero brujo" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="36f6-a2dd-1467-88db" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="8081-282b-b31a-a88d" name="Coraza mecanizada de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="54f6-c446-ba95-5e16" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f774-b13b-32b7-d5d1" type="max"/>
          </constraints>
          <profiles>
            <profile id="7c83-292f-b605-5f28" name="Coraza mecanizada de disformidad" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Sólo Ingeniero brujo. Otorga a su portador una tirada de salvación por armadura de 1+. El portador no puede unirse a unidades ni usar una montura pero obtiene un bonificador de +1 a su Fuerza, Resistencia y Heridas así como las reglas especiales Movimiento aleatorio (2D6), Ataques aleatorios (1D6) Impactos por carga (1D3) e Indesmoralizable, además de causar Terror. Además, todos los disparos contra el portador tendrán un penalizador de -1 para impactar. Adicionalmente, podrá hacer uso de su armamento de la forma habitual, aunque contará como si no hubiese movido a efectos de disparar sus armas de proyectiles en caso de tenerlas. Sin embargo, por cada herida que sufra el portador, tira 1D6: con un resultado de 1-3 el portador sufrirá una herida adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8722-e352-dc4c-49b0" name="Armadura bruja" hidden="false" targetId="925b-2ee3-16fb-d195" type="profile"/>
            <infoLink id="e4ad-d812-0bbf-345e" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
            <infoLink id="5783-50e7-1cf4-dd23" name="Heridas múltiples (2)" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule"/>
            <infoLink id="e7e6-65b7-f651-476b" name="Terror" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
            <infoLink id="4ebb-11d5-5de8-bb21" name="Impactos por carga (1D3)" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
            <infoLink id="9a4a-466d-49e1-5705" name="Movimiento aleatorio (2D6)" hidden="false" targetId="351f-72b7-17d0-bebd" type="rule"/>
            <infoLink id="86c1-2e4d-3242-de15" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(1D6)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="70.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
  <sharedRules>
    <rule id="2c14-2f77-f8ea-d0b5" name="La fuerza del número" hidden="false">
      <description>Todas las unidades con esta regla especial sumarán su bonificador por filas a su atributo de Liderazgo para realizar sus chequeos de desmoralización, para evitar cargar por Furia asesina, Estupidez, Miedo, Terror y Pánico, pudiendo aplicar el Liderazgo base del general por la regla especial Presencia inspiradora (hasta un máximo de Liderazgo 10). </description>
    </rule>
    <rule id="e7d9-b876-8ed2-648f" name="Coraje mezquino" hidden="false">
      <description> Al comienzo de cada ronda de combate, el personaje con esta regla especial y con mayor atributo de Liderazgo dentro de una unidad podrá realizar un movimiento de ¡Dejad paso! para desplazarse a la segunda fila de la unidad que lo acompañe, pese a encontrarse en contacto peana con peana con una o más miniaturas enemigas y sin sufrirningún tipo de efecto adverso: simplemente desplaza al personaje a la segunda fila (del mismo modo que si hubiera rechazado un Desafío). Sin embargo, tras realizar este movimiento no podrá realizar ninguno de sus ataques contra las unidades enemigas en contacto con su unidad. Adicionalmente, dicho personaje podrá dar su Liderazgo a su unidad desde cualquier punto de esta, no sólo desde su fila delantera. Al final de cada ronda de combate deberás devolver el personaje al frontal de la unidad.</description>
    </rule>
    <rule id="8694-7b63-68c9-066c" name="Fiable" hidden="false">
      <description>Si obtienes un resultado de 1 en la tirada para impactar, tira 1D6: si obtienes de nuevo un resultado de 1, el Jazzail estallará y deberá retirarse como baja.</description>
    </rule>
    <rule id="06be-4dce-f7cd-a54c" name="Munición inestable" hidden="false">
      <description>Por cada resultado de 1 en la tirada para impactar con este arma, tira 1D6: con un resultado de 4-6, se encasquilla y el arma no disparará ese turno, de lo contrario resuelve el impacto contra el usuario con las reglas habituales del arma y un bonificador de +1 a su Fuerza.</description>
    </rule>
    <rule id="c199-20b3-bc71-b45a" name="Unidad conjunta" hidden="false">
      <description>Los grupos de apoyo deben desplegarse a 3&quot; de la unidad que lo ha adquirido, conocida como unidad madre. Después de ese momento, se considerará una unidad en todos los aspectos. Mientras se mantenga a 3&quot; o menos de su unidad madre, contará como si tuviera una tirada de salvación especial de 4+ contra disparos y hechizos del tipo Proyectil Mágico.</description>
    </rule>
    <rule id="4cf1-7660-8a90-eb6c" name="Grupo de apoyo" hidden="false">
      <description>Cada grupo de apoyo consiste en dos Skaven de Infantería montados en una única base y se consideran una única miniatura a todos los efectos (salvación por armadura 6+, 5+ con sus armaduras ligeras; potencia de unidad 2). El coste en puntos de los Grupos de Apoyo cuenta para el total de tropas básicas de la lista de ejército. Todos los grupos de apoyo tienen las reglas espciales Unidad Conjunta y La Fuerza del Número. Un grupo de apoyo destruido, huyendo o desmoralizado nunca provocará chequeos de pánico.</description>
    </rule>
    <rule id="8c56-bdd4-06d4-7219" name="Monstruosamente grande" hidden="false">
      <description>Todos los Grandes Demonios Exaltados son Monstruos; sin embargo, su tamaño es tal que se aplican las siguientes reglas adicionales: causan Terror, y los chequeos de Terror provocados por ellos deben efectuarse tirando 3D6 y descartando el resultado más bajo; son Objetivos grandes, y además el oponente podrá aplicar un bonificador de +1 a todas sus tiradas para impactar con proyectiles contra estos seres; son Tozudos en lugar de Impasibles; tienen Impactos por carga (1D6) en lugar de sólo 1; y tienen una Potencia de unidad igual al doble de su valor inicial de Heridas.</description>
    </rule>
    <rule id="e9d3-ee12-2273-4b7c" name="Vientos de la magia desatados" hidden="false">
      <description>El Señor de las alimañas exaltado es un Gran demonio exaltado. Si en una batalla hay presentes uno o más Grandes demonios exaltados, se deberán tirar 3D6 para determinar los Vientos de la magia, siendo el total en dados de energía y el resultado mayor más el menor en dados de dispersión para el oponente. Además, las tiradas de salvación por Aura demoníaca de todos los Demonios a 18” o menos de un Gran demonio exaltado (incluyendo al propio Gran demonio exaltado) podrán efectuarse incluso contra Ataques mágicos (pasando a considerarse una tirada de salvación especial).</description>
    </rule>
    <rule id="7594-ed6b-b891-5290" name="Correr con la manada" hidden="false">
      <description>Las miniaturas con esta regla especial tienen la regla especial Veloz. Los personajes que tengan esta regla especial sólo pueden unirse a unidades que tengan la clave clan Moulder siguiendo las reglas habituales, pudiendo colocarse en la tercera fila en las unidades de Ratas ogro o hasta en una cuarta fila en unidades de Ratas gigantes.</description>
    </rule>
    <rule id="7f9e-bc00-b551-af57" name="Reputación traicionera" hidden="false">
      <description>Las unidades con esta regla especial tan solo podrán incluir personajes con la clave clan Eshin siguiendo las reglas habituales. Los personajes con la clave clan Eshin tan solo pueden unirse a unidades que no tengan las claves clan Moulder, clan Pestilens o clan Skryre. Adicionalmente, un personaje con la clave clan Eshin sólo podrá aportar su atributo de Liderazgo a unidades con la clave clan Eshin.</description>
    </rule>
    <rule id="1ea3-d965-f902-d6eb" name="Hedor apestoso" hidden="false">
      <description>Las unidades con esta regla especial tan solo podrán incluir personajes con la clave clan Pestilens siguiendo las reglas habituales. Los personajes con la clave clan Pestilens tan solo pueden unirse a unidades que tengan la clave clan Pestilens.</description>
    </rule>
    <rule id="fc81-447b-ee37-845b" name="Aprendices del gremio" hidden="false">
      <description>Las unidades con esta regla especial tan solo podrán incluir personajes con la clave skryre siguiendo las reglas habituales. Los personajes con la clave clan Skryre tan solo pueden unirse a unidades que no tengan las claves clan Moulder, clan Pestilens o clan Eshin.</description>
    </rule>
    <rule id="2ec5-25b1-f09d-47ed" name="Conocimientos de la ruinosa podredumbre" hidden="false">
      <description>Los hechiceros skaven tienen especificado cuál es su hechizo identificativo de los Saberes de Ruina o Plaga. En el momento de determinar aleatoriamente sus hechizos, se considerará un resultado doble obtener dicho hechizo en la tirada siempre y cuando tomen sus hechizos de un único saber (ya que conocerán su hechizo identificativo inicialmente).</description>
    </rule>
    <rule id="8bd5-2980-5aff-efba" name="Munición de Piedra bruja empobrecida" hidden="false">
      <description>Los disparos de un Mosquete Jezzail equipado con la Munición de Piedra bruja empobrecida se resuelven con la regla especial Heridas múltiples (1D3).</description>
    </rule>
    <rule id="275b-b7ad-7c93-cfaa" name="Acumulador de piedra bruja" hidden="false">
      <description>El portador realizará sus tiradas para Canalizar con un bonificador de +1. Además, cada vez que lance el hechizo Rayo de disformidad podrá repetir la tirada para determinar el número de impactos que causa.</description>
    </rule>
  </sharedRules>
  <sharedProfiles>
    <profile id="5e52-6252-dec3-e729" name="Acumulador de piedra bruja" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El portador realizará sus tiradas para canalizar con un bonificador de +1. Además, causará un impacto adicional cada vez que lance el hechizo Rayo de Disformidad.</characteristic>
      </characteristics>
    </profile>
    <profile id="512a-5c1c-116b-c9ad" name="Alabarda bruja" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1 Ataque, Ataques mágicos</characteristic>
      </characteristics>
    </profile>
    <profile id="5387-4d6a-78aa-6768" name="Arma de cola" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">+1A</characteristic>
      </characteristics>
    </profile>
    <profile id="925b-2ee3-16fb-d195" name="Armadura bruja" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">5+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Permite lanzar hechizos.</characteristic>
      </characteristics>
    </profile>
    <profile id="dcc9-dc24-19c4-dd47" name="Atrapa-cosas" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Lenta, Golpe letal, Luchar con filas adicionales (1)</characteristic>
      </characteristics>
    </profile>
    <profile id="34ba-516d-3a0d-45df" name="Esfera de viento envenenado" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Arma arrojadiza. Alcance 8”. Las esferas que impacten causan una herida sin posibilidad de salvación por armadura con un resultado de 4+. Si en la tirada para impactar se obtiene un 1, la esfera habrá estallado antes de tiempo y el lanzador deberá tirar para herirse a si mismo. No afecta a demonios o no muertos.</characteristic>
      </characteristics>
    </profile>
    <profile id="f783-fb1a-6610-9dcd" name="Esfera mortal" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">0-12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">-</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Un solo uso, Catapulta: Dispara como una Catapulta con la excepción de que puede Mover y disparar y desvía la mitad del resultado obtenido en el dado de artillería. Utiliza la plantilla redonda pequeña, siempre hiere con un resultado de 4+ y niega la tirada de salvación por armadura. No tiene impacto central diferenciado. Si obtienes un resultado de Problemas, coloca la plantilla centrada en el lanzador.</characteristic>
      </characteristics>
    </profile>
    <profile id="4529-bf87-54fc-0a4a" name="Estrellas arrojadizas" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">8&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">DIsparo rápido, Disparos múltiples (2), Arrojadiza</characteristic>
      </characteristics>
    </profile>
    <profile id="0f0b-73d7-c673-d4ac" name="Fragmento de piedra bruja" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Un hechicero puede consumir un Fragmento de piedra bruja al lanzar un hechizo, el cual le proporciona un dado de Energía. Puede, si lo desea, consumir varios fragmentos para lanzar un hechizo o incluso lanzar un hechizo utilizando sólo fragmentos. Sin embargo, cualquier resultado de 1 en cualquiera de los dados de Energía proporcionados por los Fragmentos de piedra bruja causarán al usuario una herida sin tirada de salvación por armadura.</characteristic>
      </characteristics>
    </profile>
    <profile id="4ce6-9f16-3a5b-f799" name="Incensario de plaga" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Agotamiento, Ataques mágicos. Al inicio de cada fase de combate cuerpo a cuerpo en la que el portador se encuentre trabado en combate, todas las miniaturas en contacto peana con peana con el portador deberán efectuar un chequeo de Resistencia (incluyendo al propio portador). Si lo fallan, sufrirán una herida sin posibilidad de salvación por armadura. Las miniaturas con la marca de Nurgle o que tengan las claves clan Pestilens, demonio o no muerto tan solo fallarán el chequeo con un resultado de 6, independientemente de su atributo de Resistencia. Cada miniatura sólo chequea una única vez por fase de combate, independientemente de con cuantas miniaturas con Incensario de plaga tenga en contacto peana con peana.</characteristic>
      </characteristics>
    </profile>
    <profile id="dff9-aef9-4b67-da78" name="Látigo" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Comabte</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">El látigo del amo: Permite a su portador realizar todos sus ataques a través de hasta tres filas de Ratas gigantes o una fila de Ratas ogro.</characteristic>
      </characteristics>
    </profile>
    <profile id="e940-c301-3420-41ab" name="Mosquete jezzail" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">36&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">6</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Mover o disparar,
Munición inestable, Cañón estriado: Los disparos realizados con este arma ignoran el penalizador por larga distancia.</characteristic>
      </characteristics>
    </profile>
    <profile id="f005-bf44-92de-2177" name="Mosquete brujo" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Heridas múltiples (1D3), Mover o disparar, Munición inestable (por cada resultado de 1 en la tirada para impactar, tira 1D6: con un resultado de 4-6 el proyectil se encasquilla y el arma no disparará ese turno, de lo contrario resulteve el impacto sobre el usuario con las reglas habituales del arma y un bonificador de +1F).</characteristic>
      </characteristics>
    </profile>
    <profile id="7368-8d3d-31b7-fb5f" name="Optometría bruja" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Todos los disparos realizados por el portador tendrán un bonificador de +1 a sus tiradas para impactar.</characteristic>
      </characteristics>
    </profile>
    <profile id="1221-ff4f-63db-ed1b" name="Palo-shock" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Ataque de rayos, Luchar con filas adicionales (1)</characteristic>
      </characteristics>
    </profile>
    <profile id="aa41-392c-aebe-c4ee" name="Pavés" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Otorga un bonificador de +2 a la tirada de salvación por armadura contra proyectiles y hechizos del tipo Proyectil mágico.</characteristic>
      </characteristics>
    </profile>
    <profile id="ea4d-c4cd-204c-c0e9" name="Pistola bruja (combate)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Armas emparejadas, Munición inestable, Descarga</characteristic>
      </characteristics>
    </profile>
    <profile id="377b-6c1c-888d-4cba" name="Redes" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Al comienzo de cada ronda de combate cuerpo a cuerpo, una unidad con Redes puede intentar enredar a una unidad enemiga con la que esté trabada en combate cuerpo a cuerpo. Tira 1D6: con un resultado de 2+, la unidad quedará enredada pero, si obtienes un 1, será tu propia unidad la que quede enredada. Una unidad enredada (una o más veces) tendrá un penalizador de -1 a su Fuerza hasta el final de la fase de combate cuerpo a cuerpo.</characteristic>
      </characteristics>
    </profile>
    <profile id="221b-4476-c300-a2fd" name="Ristra de pistolas brujas (disparo)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Munición inestable</characteristic>
      </characteristics>
    </profile>
    <profile id="c797-2dd5-dacb-ba4e" name="Ungüentos Eshin" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Otorga la regla especial Ataques envenenados.</characteristic>
      </characteristics>
    </profile>
    <profile id="5d6f-4c09-99b4-c139" name="Máscaras antigás" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Los Lanzadores de Viento Envenenado solo se herirán a si mismos con sus esferas de viento envenenado, morteros de viento envenenado o esferas mortales con un resultado de 5+.</characteristic>
      </characteristics>
    </profile>
    <profile id="60d7-3056-1ab4-2137" name="Esfera de viento corrosivo" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">-</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Arrojadiza, Disparo rápido, Ataques mágicos, Ataques 
envenenados, Viento envenenado: Este arma siempre hiere con un resultado de 4+ y no permite tirada de salvación por armadura. Si en la tirada para impactar se obtiene un 1, la esfera habrá estallado antes de tiempo y el lanzador deberá tirar para herirse a si mismo.</characteristic>
      </characteristics>
    </profile>
    <profile id="0b98-98e8-902c-ccab" name="Veneno secreto de disformidad" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Otorga la regla especial Ataques envenenados; además, este veneno sobrepasa la regla especial Inmune a veneno que otorgan las reglas especiales Demonio y No muerto.</characteristic>
      </characteristics>
    </profile>
    <profile id="2237-5887-654f-d45f" name="Pistola bruja (disparo)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Ataques mágicos, 
Disparos múltiples (2), Munición inestable</characteristic>
      </characteristics>
    </profile>
    <profile id="b14a-81aa-0c1d-4e19" name="Ristra de pistolas brujas (combate)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Ataques mágicos, Munición inestable</characteristic>
      </characteristics>
    </profile>
    <profile id="3774-90c8-92c0-4602" name="Armadura de piedra bruja entrelazada" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Por cada herida salvada en combate cuerpo a cuerpo, la armadura infligirá un impacto de Fuerza 4 con las reglas especiales Ataque de rayos y Ataques mágicos contra la miniatura que provocó la tirada.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
