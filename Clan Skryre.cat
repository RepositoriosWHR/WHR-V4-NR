                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Armadura bruja" id="0230-b53e-2da9-741b" hidden="false" targetId="adcb-a447-be9c-9407" type="profile"/>
                <infoLink name="Resistencia mágica (1)" id="3858-5334-5ab2-5942" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink name="Impactos por carga (1D3)" id="407c-4d39-77ee-1f6d" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
                <infoLink name="Terror" id="b02d-5c17-28dd-cc2c" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
                <infoLink name="Tozudez" id="6632-ceee-0486-e6c8" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
                <infoLink name="Inmune a rayos" id="b078-6e46-a38d-e8b8" hidden="false" targetId="b0d1-ccdb-5379-f951" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Coraza de batalla de Disformidad Neumática" id="9432-43d1-4f46-638e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Otorga a Morskittar una tirada de salvación por armadura de 1+ (en lugar del habitual 5+). Obtiene +1F, +1R y las reglas especiales Resistencia mágica (1), Impactos por Carga (1D3), causa Terror, es Tozudo e inmune a Ataques de rayos. Además, lleva incorporada una dosis de Skalm y otorga a Morskittar una tirada de salvación especial de 4+. Adicionalmente, la coraza dispone de armamento integrado tanto de disparo como en cuerpo a cuerpo; tan solo puede disparar una de sus armas cada fase de disparo, y deberás elegir al inicio de cada combate qué arma de cuerpo a cuerpo va a utilizar. Se consideran armas mágicas a todos los efectos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Skalm" id="b3cb-4b55-58e9-62a2" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="22bb-605d-05b7-afa0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                    <constraint id="6086-5276-9753-de41" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="30"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Skalm" id="940f-23cb-bef1-5cda" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier fase de magia, disparo o combate cuerpo a cuerpo propia o del enemigo. El portador restablecerá 1D6 heridas que hubiese sufrido previamente en la batalla.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
            <selectionEntry name="Chillaórdenes" id="5164-5c6c-91ca-37b0" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cea2-5758-e1a6-0833" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="75fa-9d5c-7a51-a4ec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Chillaórdenes" id="213b-d825-5a05-6f85" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Mientras Morskittar se encuentre en el campo de batalla, todas las unidades que incluyan un Personaje o un Oficial de cualquier tipo (Jefe de Zarpa, Oficial Skaven, Oficial Tecno-Alimaña, Bombardero, Tirador Experto) podrán utilizar el Liderazgo de Morskittar.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pistola bruja perfeccionada" id="215a-4171-09d8-d58a" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d70b-cbf4-f39e-fc5b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="071e-a93c-58ad-90bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
