                <infoLink name="Arma de aliento" id="fbbd-11d0-160d-7dfc" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(F5, Ataques mágicos, Ataques sólo flamígeros, Heridas multiples (1D3))"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Coraza férrea" id="f467-409e-b4fd-4f30" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Armadura bruja. Proporciona a Ikit una tirada de salvación por armadura de 3+ y una tirada de salvación especial de 5+. Además, una vez por batalla, Ikit puede utilizar el proyector de fuego de disformidad como un Arma de aliento con Fuerza 5 y las reglas especiales Ataques mágicos, Ataques sólo flamígeros y Heridas múltiples (1D3). Cualquier unidad que sufra al menos una baja a 
causa de este Arma de aliento deberá realizar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
