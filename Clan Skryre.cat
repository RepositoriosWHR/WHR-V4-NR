    <selectionEntry name="[E] - Klawmunskast, Maestro Ingeniero del Clan Skryre" id="6c1c-a7c2-b930-2a90" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="d097-82ca-57a6-4ea5" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="5618-bb20-1f26-e1f8" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="be85-1b1a-d959-b111" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="7c7f-f21e-92a4-9389" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="La fuerza del número" id="1833-bf5e-6783-7358" hidden="false" targetId="51f6-0d39-7e49-618a" type="rule"/>
        <infoLink name="Coraje mezquino" id="eeab-1137-e343-d8bc" hidden="false" targetId="fa98-0091-619c-5444" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Klawmunskast" id="439b-d20d-7c00-de36" hidden="false">
          <description>Klawmunkast es un hechicero de nivel 3 que puede elegir sus hechizos del Saber de la Ruina Skaven (del cual tomará el Rayo de Disformidad como hechizo identificativo).</description>
        </rule>
        <rule name="Explotador-minero-explotador" id="9eb1-b9bd-9062-ad36" hidden="false">
          <description>Si Klawmunkast es el general del ejército Skryre, podrás designar una única unidad de Esclavos Skaven para que pueda incluir una Tuneladora de Disformidad (+45 puntos). Además, deberán equiparse con Arma a dos manos (+1 punto por miniatura).</description>
        </rule>
        <rule name="Inventor meticuloso" id="22fa-63fa-e1bd-9510" hidden="false">
          <description>Si Klawmunkast es el general del ejército Skryre, todas las Máquinas de guerra y los Grupos de apoyo del Clan Skryre sumarán +1 en las tiradas de sus respectivas tablas de problemas (un resultado de 7 se considera 6).</description>
        </rule>
        <rule name="Archienemigo (Morbus Sanguis)" id="a406-7f23-63ff-7759" hidden="false">
          <description>Si tu ejército incluye a Klawmunkast y el ejército enemigo incluye a Morbus Sanguis, obtendrás 100 puntos de victoria adicionales si lo eliminas.</description>
        </rule>
      </rules>
