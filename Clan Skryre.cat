            <entryLink name="Reliquia" id="647a-5633-c1f0-71e6" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Muy-eficiente catalogador de información Skryre" id="e813-601f-e6d1-94c4" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad no aplicarán el penalizador por larga distancia de sus armas de proyectiles. Además, podrán sumar 1 en las tiradas provocadas por la regla especial Munición inestable.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
