            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="50c4-62ac-556f-581f" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Muy-eficiente catalogador de información Skryre" id="d9a8-131d-29d0-a77e" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene un hechizo adicional y un bonificador de +1 en sus tiradas de lanzamiento de hechizos del Saber de Ruina. Además, siempre que una miniatura con la clave clan Skryre a 12” o menos del portador se vea obligada a realizar una tirada en una tabla de Problemas, podrá repetir el resultado en dicha tirada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Clan Skryre. Picadora de condenación" id="b313-2dec-2d86-81ff" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ce05-0002-78dc-039b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="773b-0e98-ab4e-1880" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Combustible disforme" id="36d7-52b7-6b9f-b1ad" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="46a4-84e4-4ee5-62e2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="383b-4585-bd1c-5236" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Combustible disforme" id="2561-9f79-5a67-0dfa" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo personajes montados en Picadora de condenación. Al inicio de la batalla, tras el despliegue, el personaje y la unidad Equipo de destrucción de Picadoras de condenación en la que sea desplegado deberán realizar una tirada de 1D6 en la siguiente tabla y aplicar el resultado; ten en cuenta que el combustible es muy preciado y no lo compartirá, por lo que ningún otro personaje podrá unirse a esa unidad.
D6 Combustible disforme
1 Defectuoso: El personaje y cada miembro de la unidad en la que se encuentre sufren un impacto de Fuerza 3. No hay efectos adicionales.
2-4 Lubricante limpiador:  El movimiento de la dotación de las Picadoras de condenación del personaje y su unidad se ve incrementado en 1 por el resto de la batalla.
5-6 Gran octanaje: El movimiento de la dotación de las Picadoras de condenación del personaje y su unidad se ve incrementado en 2 por el resto de la batalla. Sin embargo, siempre que obtengas un resultado doble en las tiradas de carga, huida y persecución del personaje y/o su unidad, cada integrante sufrirá un impacto automático de Fuerza 2 que niega la tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Clan Skryre" id="ab6c-7e6f-8c1d-a5d5" collective="false" hidden="false" import="true">
