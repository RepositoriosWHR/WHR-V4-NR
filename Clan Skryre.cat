    <selectionEntry name="Maestro brujo Skryre" id="cd8a-46ed-cf1b-0b0d" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="e1c7-e7b0-d718-d5cb" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="20e2-34de-dcff-d51b" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
