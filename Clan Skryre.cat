      <rules>
        <rule name="Magia Ratchitt" id="76a4-5544-920b-28e9" hidden="false">
          <description>Ratchitt es un hechicero de nivel 1 que conoce el hechizo Salto fugaz (saber de Ruina skaven). No conoce otros hechizos.</description>
        </rule>
        <rule name="Ingeniero consumado" id="bd8d-ff10-4f42-1b3d" hidden="false">
          <description>Todas las máquinas de guerra y grupos de apoyo del Clan Skryre a 6” o menos de Ratchitt pueden repetir el resultado de su respectiva tabla de problemas.</description>
        </rule>
      </rules>
