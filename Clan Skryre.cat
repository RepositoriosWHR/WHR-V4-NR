    <selectionEntry name="Mortero de viento envenenado" id="1726-bccf-af29-3739" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Grupo de apoyo" id="4c68-9555-dd50-2997" hidden="false" targetId="5a28-1499-a356-e2e5" type="rule"/>
