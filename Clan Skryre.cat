    <selectionEntry name="[E] - Ikit Claw, Ingeniero-jefe del clan Skryre" id="e23d-868c-71ed-fdfd" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="d23a-0634-6e54-0e1e" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
