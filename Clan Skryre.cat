          <modifiers>
            <modifier field="name" type="append" value="(¡¡Zzzzaapp!!)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Ataques mágicos" id="33b2-381e-ce35-f4dc" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(¡¡Zzzzaapp!!)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Ataques de rayos" id="467c-ab74-5b1e-3cf4" hidden="false" targetId="8628-6531-ed1d-f985" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(¡¡Zzzzaapp!!)"/>
