        <infoLink name="Impactos por carga (1D6+1)" id="8d5c-086c-c278-aeea" hidden="false" targetId="78cb-a25e-39e5-1f51" type="rule"/>
        <infoLink name="Terror" id="70af-38bb-64db-c1e9" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Movimiento aleatorio (3D6)" id="4a74-a2ec-cec9-3c48" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
        <infoLink name="Objetivo grande" id="bc1e-1b20-2137-df22" hidden="false" targetId="71eb-6467-3a39-bdb6" type="rule"/>
