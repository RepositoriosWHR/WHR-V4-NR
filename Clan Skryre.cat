            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Portentos del destino funesto" id="3624-07fd-1dd4-4fcb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Cualquier unidad enemiga en contacto peana con peana con el portador obtendrá un penalizador de -1 a su Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Skalm" id="5f32-fdf3-eeff-af82" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5c17-1c9d-1d46-58d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="82b3-a98f-e5ed-3a14" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Skalm" id="553b-3571-c507-88eb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier fase de magia, disparo o combate cuerpo a cuerpo propia o del enemigo. El portador restablecerá 1D6 heridas que hubiese sufrido previamente en la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mega-potenciador fuerte-listo" id="8c16-9433-6067-b215" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5451-3830-cc84-18cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="de35-f22d-afd3-50c1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Estupidez" id="417e-3580-2e7f-290c" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Mega-potenciación fuerte-listo" id="c415-409d-5808-b86d" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene un bonificador de +2 a su atributo de Fuerza y la regla especial Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Localizador de calor" id="39ec-736a-76a3-9cb8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8d38-bb6c-8012-c5cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a5a4-5f03-5466-0328" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Localizador de calor" id="6313-83cc-f331-4d73" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Las miniaturas enemigas que se encuentren ocultas en un Bosque a 18” o menos del portador podrán ser objetivo de disparos por parte del portador y su unidad (aunque seguirán contando con cobertura pesada). Además, el portador no se verá afectado por las penalizaciones impuestas a los disparos si juega bajo las reglas de Combate nocturno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ratas explosivas" id="ea96-67ce-d9c6-dad1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="419c-f7f9-cdf9-c51a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7e89-96aa-79d3-6876" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ratas explosivas" id="3f90-2eb3-7fcb-833b" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo tres usos. El portador puede utilizar una de las Ratas explosivas durante su fase de disparo. La rata explosiva se dispara como un cañón que estima 0 dados (utiliza sólo el dado de artillería). Coloca la plantilla redonda pequeña en cualquier punto del recorrido: el impacto central se resuelve con Fuerza 6 y las reglas especiales Poder de penetración, Ataques flamígeros y Ataques mágicos. Las miniaturas bajo la plantilla sufrirán un impacto de Fuerza 3 con las reglas especiales Ataques sólo flamígeros y Ataques mágicos. Además, cualquier unidad que sufra al menos una baja a consecuencia de este disparo deberá superar un chequeo de Pánico. Sin embargo, si obtienes un resultado de problemas en la primera tirada del dado de artillería para estimar la distancia que recorre, coloca la plantilla centrada sobre el portador y resuelve los impactos de forma normal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Clan Skryre" id="d76e-7882-4353-969b" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="d1cc-f3c3-3a19-ea9d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="507e-40bc-8d01-284a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte de la Huída de Rata" id="2f9c-64ac-8760-f877" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d0fa-f43a-43c0-89fe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3148-7a57-76d5-b171" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la Huída de Rata" id="9b4e-a3b8-fad7-6952" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un solo uso. Al inicio de cualquier turno aliado a excepción del primer puedes activar el estandarte. Si la unidad portadora puede realizar un movimiento de marcha, podrá realizarlo al triple de su velocidad. Sin embargo, después de realizar el movimiento, la unidad portadora sufrirá 2D6 impactos de F3 (sin posibilidad de salvación por armadura) distribuidos como si fueran disparos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Imperio Skyre" id="0913-106d-4fdd-5c3b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bb48-67f0-f012-ef65" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="afab-6173-940c-3a82" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte del Imperio Skyre" id="b17e-5dea-993f-f50f" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los Equipos de destrucción (de cualquier tipo) a 6” o menos de la unidad portadora de este estandarte podrán utilizar su bonificador por filas para efectuar sus chequeos de psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mortaja de la Muerte Supurante" id="fac5-08b4-3523-c839" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="79a6-2dad-7ce8-a980" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cbcb-b157-955d-cd1d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Mortaja de la Muerte Supurante" id="3e37-5d63-cdf1-1028" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas enemigas en contacto peana con peana con el portador de este estandarte sufrirán al principio de cada ronda de combate un único impacto de F3 sin posibilidad de salvación por armadura. Además, si la unidad portadora de la Mortaja de la Muerte Supurante huye, cualquier unidad que la persiga sufrirá 1D6+2 impactos de F3 sin posibilidad de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gran Estandarte de Superioridad del Clan" id="3b44-7dbb-17d1-f218" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1996-cdb8-18c3-0257" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b720-1ae4-d9fe-6154" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gran Estandarte de Superioridad del Clan" id="2f52-fd3f-0051-f43f" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Una unidad que porte el Gran Estandarte de Superioridad de Clan y que tenga más filas (de 5 o más miniaturas) que sus oponentes tirará 1D3 puntos adicionales al resultado del combate. Tira al final de cada combate</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pendones de Precisión" id="7356-2eaf-f85f-9d2f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6087-29e8-1f04-8f8c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="73b0-892b-6cfb-6486" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pendones de Precisión" id="38f1-3432-f82d-5ca9" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador de este estandarte y su unidad obtendrán un bonificador de +1 en sus tiradas para impactar con armas de proyectiles (hasta un máximo de 3+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Clan Skrye. Armas emparejadas. Sin Escudo/Paves/Disparo" id="6d34-b4ce-3505-75e8" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="3073-0d60-e88b-0ab1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="53a9-3e6d-92b2-1c84" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Prótesis mata-mata" id="04b0-633c-70c3-5c7d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7946-963b-27b7-8604" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4d6c-749c-2768-767f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="d42d-2891-1036-65de" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Arma de mano adicional" id="5c2e-f50b-04cd-8cc3" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
            <infoLink name="Poder de penetración" id="afce-4237-d81b-111b" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Prótesis mata-mata" id="2328-bb6d-0abd-c06a" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Otorgan a su portador 1D3 ataques adicionales (en lugar de un único ataque adicional) y sus ataques se resuelven con un bonificador de +1 Fuerza y la regla especial Poder de penetración. Sin embargo, el portador no podrá equiparse con Escudo o Pavés ni armas de disparo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Clan Skryre. Armadura bruja" id="6da0-0c70-c34d-c03a" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="2f74-bfc7-8cce-1d71" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="1460-080d-6b54-045a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Armadura de disformidad" id="b802-87b0-d236-1d86" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c81d-0d76-ca37-dc45" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="23d6-2241-f317-c265" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura bruja" id="0fbb-8d18-e435-ec92" hidden="false" targetId="adcb-a447-be9c-9407" type="profile"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="1679-57fc-3e17-bc2f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="ancestor" shared="true" type="instanceOf" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Armadura de disformidad" id="389f-327b-bcab-2068" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Otorga a su portador una tirada de salvación por armadura de 4+ (en lugar del habitual 5+). Adicionalmente, por cada tirada de salvación por armadura exitosa la miniatura inflige un impacto de F4 contra la miniatura que provocó la tirada. Cualquier número de Ingenieros Brujos del Clan Skryre de tu ejército pueden equiparse con ésta armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Abreplacas" id="ac6b-55c8-6286-c577" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ba90-6214-1245-90d0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dab0-3f39-4c21-dd61" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura Bruja" id="e379-3422-5022-331d" hidden="false" targetId="adcb-a447-be9c-9407" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Abraplacas" id="ca7c-cf3b-b8c4-5164" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Otorga a su portador +1I y +1A.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pechera repelente" id="9a15-2111-d2f5-ec33" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="261a-f387-fe2d-586f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a8a0-6083-9cfd-68a9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (1)" id="be4c-4635-d1f8-5f72" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
            <infoLink name="Armadura Bruja" id="30a6-ec9f-387f-e1d5" hidden="false" targetId="adcb-a447-be9c-9407" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Pechera repelente" id="f1a5-d759-c54b-451a" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura Bruja. Otorga a su portador la regla especial Resistencia mágica (1). Además, los proyectiles dirigidos contra el portador obtendrán un penalizador de -2 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Reliquia. Clan Skryre. General" id="8699-7354-94ec-072d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="0d53-1433-783f-11ed" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="6a09-934e-6992-10b6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Gran cohete-Bomba de Disformidad" id="54c8-d6c7-fe04-7daa" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e818-7cab-3f43-4aa1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e3ef-cb65-2bdc-7aab" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="b0d9-8944-b191-9788" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Gran cohete-Bomba de Disformidad" id="8fb9-2cf9-3942-2c83" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo general del ejército. Un solo uso. Puedes declarar que utilizas el cohete al inicio de cualquiera de tus fases de disparo. Para ello, coloca un marcador en cualquier parte del campo de batalla. El cohete caerá al final de dicha fase de disparo (después de realizar los pertinentes chequeos de Pánico): para ello, tira los dados de artillería y dispersión. Si obtienes un resultado de punto de mira, desvía el marcador la mitad de la distancia indicada en el dado de artillería (utiliza la flecha pequeña), y si obtienes un resultado de flecha, desvía el marcador en la dirección indicada el doble del resultado obtenido en el dado de artillería; si obtienes un resultado de problemas, algo habrá ido mal: retira el marcador y el cohete no hace nada. Tras eso, el cohete estalla: todas las unidades amigas o enemigas a 4D6” o menos del marcador sufren 2D6 impactos (las unidades con Potencia de unidad 20+ sufrirán en su lugar 3D6 impactos; las unidades con Potencia de unidad 40+ sufrirán en su lugar 4D6 impactos) de F5 que no permiten tirada de salvación por armadura y tienen la regla especial Ataques mágicos. Cualquier unidad sobre la que caiga el marcador sufrirá 2D6 impactos adicionales. Coloca una zona redonda de Terreno difícil centrada en la zona donde estalló el cohete (proporcionará cobertura ligera).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Clan Skryre. Ingeniero brujo o Maestro brujo" id="6236-0c73-e7ab-ea04" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="92c0-554c-fd0b-748c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="3953-dbfc-70fe-51f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Sello de garantía muy-muy fiable" id="72a0-6e80-a3ad-df82" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b95c-7863-2fa4-0986" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e34f-dd0f-f23c-193e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sello de garantía muy-muy fiable" id="33ec-9f3d-15e4-21fb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo Ingeniero-Brujo o Maestro Brujo. Al inicio de la batalla, antes del despliegue, selecciona una única Máquina de guerra o Carro de tu ejército: hasta el final de la batalla, dicha máquina de guerra o carro podrá sumar o restar 1 en sus tiradas en la tabla de problemas (cualquier resultado superior a 6 se considerará de 6 y cualquier resultado inferior a 1 se considerará 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Clan Skryre. Ingeniero brujo" id="ff08-09fa-d05e-6995" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="a07d-33e8-5c01-b6ed" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="9577-41fa-9191-3429" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Armadura de disformidad" id="82d6-50f6-8717-af7c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="660a-8bd2-7870-fbc6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1c57-b4c1-f3fc-e9ef" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura bruja" id="ebc6-0c7b-4258-0182" hidden="false" targetId="adcb-a447-be9c-9407" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura de disformidad" id="951e-f22d-9c31-56d6" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Otorga a su portador una tirada de salvación por armadura de 4+ (en lugar del habitual 5+). Adicionalmente, por cada tirada de salvación por armadura exitosa la miniatura inflige un impacto de F4 contra la miniatura que provocó la tirada. Cualquier número de Ingenieros Brujos del Clan Skryre de tu ejército pueden equiparse con ésta armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Clan Skryre. Hechiceros" id="7c9c-12c3-14e2-3388" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="bffb-8edf-a6d2-622d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="5899-c437-f2a6-aa01" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Equipamiento de juego bélico" id="5526-1f73-277b-52b0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0149-3d86-eeb0-8e16" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0897-6750-ee36-1456" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (2)" id="eee7-35f7-ddb7-4ccb" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Equipamiento de juego bélico" id="93fe-1fdb-de10-e197" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo hechiceros. Al inicio de la batalla y de cualquiera de tus turnos, puedes gastar un Fragmento de Piedra Bruja para activar el poder del Equipamiento de juego bélico, el cual permanecerá activo hasta el inicio de tu siguiente turno. El portador obtiene un bonificador de +1 en sus tiradas de lanzamiento y dispersión de hechizos, una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Reliquias. Clan Skryre" id="03a2-a101-fc0f-1d08" collective="false" hidden="false" import="true">
