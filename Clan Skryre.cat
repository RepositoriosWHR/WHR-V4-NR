                <infoLink name="Francotirador" id="9e31-d700-e04d-8fd6" hidden="false" targetId="8fa0-a4f6-e454-dbfe" type="rule"/>
                <infoLink name="Heridas múltiples (1D3)" id="0aa1-10b6-cff6-9cb4" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
