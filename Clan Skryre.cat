                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Yelmo. Otorga a su portador la regla especial Francotirador. El portador podrá lanzar hechizos normalmente a pesar de usar este yelmo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Clan Skryre. Infantería. Brujo o Maestro brujo" id="9d25-bbf5-404d-941a" collective="false" hidden="false" import="true">
      <constraints>
