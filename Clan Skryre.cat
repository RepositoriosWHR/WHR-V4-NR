            <infoLink name="Armadura pesada" id="0915-598e-7ade-8916" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
            <infoLink name="Movimiento aleatorio (2D6)" id="4e82-604c-15c5-1f7f" hidden="false" targetId="351f-72b7-17d0-bebd" type="rule"/>
            <infoLink name="Impactos por carga (1D3)" id="e1ab-b260-44de-1938" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
            <infoLink name="Terror" id="ba98-f310-4c97-e46a" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
            <infoLink name="Indesmoralizable" id="f642-d3e4-8362-b08f" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
            <infoLink name="Heridas múltiples (2)" id="332e-f6fb-a20c-b35f" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule"/>
            <infoLink name="Ataques aleatorios" id="b236-59c7-c7b7-0611" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(1D6)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Coraza mecanizada de disformidad" id="d141-5137-d7af-45b5" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura bruja. Sólo Ingeniero brujo o Maestro brujo. Otorga a su portador una tirada de salvación por armadura de 1+. El portador no puede unirse a unidades ni usar una montura pero obtiene un bonificador de +1 a su Fuerza, Resistencia y Heridas, así como las reglas especiales Movimiento aleatorio (2D6), Ataques aleatorios (1D6) Impactos por carga (1D3), Indesmoralizable y causa Terror. Además, todos los disparos contra el portador tendrán un penalizador de -1 para impactar. Adicionalmente, podrá hacer uso de su armamento de la forma habitual, aunque contará como si no hubiese movido a efectos de disparar sus armas de proyectiles en caso de tenerlas. Sin embargo, por cada herida que sufra el portador, tira 1D6: con un resultado de 1-3 el portador sufrirá una herida adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Reliquias. Clan Skryre" id="5588-2037-f10c-1617" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="81aa-cf95-5622-a8ae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="f724-cdbc-38ed-7764" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Campo de disformidad personal" id="4d8c-dcc1-0722-41ff" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6c1b-8eb6-70ea-871c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c90b-f64a-9ed6-1e43" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="91fe-4ade-5f6b-ec4d" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Campo de disformidad personal" id="57c1-ffc3-2916-82ab" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cada vez que el portador reciba un impacto con un valor de Fuerza, tira 1D6 y resta el resultado al valor de F del ataque para herir al portador. Si la F del ataque se ve reducida a 0 ó inferior, el ataque no tiene efecto alguno. El Campo de Disformidad Personal no protege contra impactos sin un valor de Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Clan Skryre" id="53cb-fb1e-187c-699e" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="bf73-02fb-79b6-babf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7f46-63f2-fddc-2f64" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Enamandor ultrasónico" id="d4d8-dff6-5c0e-c169" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="97f1-69ea-ec70-f755" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0149-9c5e-0034-b41a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Emanador ultrasónico" id="1df0-7bff-a170-776c" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Las miniaturas enemigas en contacto peana con peana con el portador sufrirán un penalizador de -1HA y -1A (hasta un mínimo de 1). Además, las tiradas exitosas para impactar en combate cuerpo a cuerpo contra el portador deberán repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Talismán de disformidad" id="34bf-c0e7-6a6d-c9fa" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eadb-b3cb-7842-5bba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e7ea-f977-9d0b-d130" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Talismán de disformidad" id="b820-9e30-a75d-6f20" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cualquier miniatura que dirija uno o más de sus ataques en cuerpo a cuerpo sobre el portador deberá superar un chequeo de Liderazgo con su atributo básico. Si falla el chequeo, efectuará sus ataques con un penalizador de -2 a su atributo de Fuerza y a sus tiradas para impactar hasta el final de la fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Distractor de lentes focales" id="b07f-1403-9f09-8521" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4a3c-3896-46c1-5e76" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4bdf-8150-975e-8903" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Distractor de lentes focales" id="d365-1dbe-9875-caa7" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El personaje no puede ser objetivo de disparos con la regla especial Francotirador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Talisman de piel de oro" id="fad9-c840-4ab1-39d7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1285-8264-e7c0-a58c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="df91-158c-a92d-0640" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Talismán de piel de oro" id="adb6-af28-7805-c48f" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un solo uso. El portador puede obligar a una única miniatura enemiga con la que esté en contacto peana con peana a repetir todas sus tiradas para impactar exitosas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cacharro de atracción de sombras" id="0ddd-c968-726b-0e34" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3333-ac41-02bb-82f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="30b9-d851-4282-0ff6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cacharro de atracción de sombras" id="58c3-9a60-c68b-2d73" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Los disparos efectuados contra el portador del Cacharro de Atracción de Sombras o la unidad que lo acompañe se realizarán con un penalizador de -1 para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Clan Skryre" id="70bc-2366-aae7-df4f" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="8b24-9a2b-6087-0b3a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="53eb-8c56-efa5-f098" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Acumulador de rayos" id="4810-cc5e-af0a-f7bf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1fd8-34d7-5ceb-0cf7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d761-3afd-5185-f1e6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Acumulador de rayos" id="adfd-cb5a-d322-8c37" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene un bonificador de +1 en sus tiradas de lanzamiento del hechizo Rayo de Disformidad del saber de Ruina Skaven. Además, siempre que lo lance en su versión potenciada añadirá 1D3 impactos adicionales; ten en cuenta que estos impactos adicionales surgen del propio acumulador, por lo que un resultado de 1 no deberá resolverse sobre el propio hechicero.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Catalizador de disformidad " id="b6cb-cf2a-175f-419c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ff41-5442-3d21-7afe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2d77-58b5-e75b-c746" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Catalizador de disformidad " id="b339-539a-9f31-470f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Siempre que un hechizo del Viento de Magia Oscura sea lanzado con éxito a 12” o menos del portador y no sea dispersado, tira 1D6: con un resultado de 4+, el Catalizador de disformidad generará un Fragmento de Piedra bruja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino de Tormenta de Disformidad" id="b867-d89b-6051-451f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a239-941b-e1af-8c5e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="833f-9344-89d9-84a3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques de rayos" id="1ea6-e575-7c85-0b67" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pergamino de Tormenta de Disformidad" id="63e4-b295-b4f6-c738" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Se trata de un Objeto portahechizos de nivel de energía 5 que contiene un hechizo de Tempestad mágica. Todas las unidades con la regla especial Volar o Flotar que estén haciendo uso de dichas reglas sufrirán 1D6 impactos automáticos de Fuerza 5 distribuidos como disparos con la regla especial Ataque de rayos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Clan Skryre" id="0e2a-38b7-13bf-f1e0" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="3216-f999-d5b5-de77" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="ea6c-0d00-5226-1adf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Aceite mineral brujo" id="f871-c6b4-be4e-a282" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="56a3-69b7-0d50-88f1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="747a-1eba-a7a1-b512" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Aceite mineral brujo" id="fcc8-f013-3019-550c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador podrá repetir todas las tiradas originadas a causa regla Munición Inestable de sus armas de proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ratser" id="d308-ff07-4bac-6c11" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b8b8-5982-5e09-3367" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0c1c-ba5d-7647-ad64" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques de rayos" id="f6bd-4675-bc74-6bb8" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Ratser" id="24dd-048d-fddf-5416" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de cada ronda de combate, puedes seleccionar una única miniatura que esté en contacto peana con peana con el portador; ambos jugadores deberán tirar 1D6 y sumar los respectivos valores de Iniciativa. Si el jugador Skaven obtiene un resultado mayor que el del oponente le causará a la miniatura seleccionada un único impacto de F5 con la regla especial Ataque de rayos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cañerías de Piedbal" id="bb22-af72-60ee-c6a7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5c9d-9b7d-02ab-7eab" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="787b-ce93-d81c-a99d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cañerías de Piedbal" id="a7e5-9b85-f94f-8a25" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Siempre que una unidad enemiga quera cargar contra el portador o la unidad en la que éste se encuentre, antes deber superar un chequeo de Liderazgo; si lo falla, no podrá cargar ni mover ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de piedra de disformidad" id="4a40-2da9-4c6f-836f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="84bf-f442-af12-f4f0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dca3-d7b9-fe51-e566" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="c20c-abd4-5627-57ad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, canalizar, un único dado de energía o dispersión, o una tirada en la tabla de disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Chillalejos" id="94b6-0d18-85d3-66c6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="19c7-de6b-9bb6-1ce1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b7f8-8e17-a06a-a17a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Chillalejos" id="ab24-a1e5-f185-fd92" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador podrá utilizar el efecto de la regla especial Presencia inspiradora del general del ejército sin importar la distancia que lo separe del general.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cohete aniquilador" id="ada4-9c46-e74a-f905" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2f92-4023-f8a4-a1ff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4404-d0d9-c373-61b6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cohete aniquilador" id="58bf-6a4d-fe7c-6760" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. El Cohete Aniquilador puede utilizarse en cualquier fase de disparo propia si el portador no está trabado en combate ni ha marchado durante ese turno. Estima una distancia de entre 4 y 10 dados como si se tratase de un cañón, pero no tires el dado de artillería: coloca la plantilla redonda grande al final de la distancia estimada. Cualquier miniatura bajo la plantilla (utiliza las reglas habituales de impactos parciales) sufrirá un impacto de F5. Si obtienes un resultado de Problemas en la primera tirada del dado de artillería, tira 1D6 en la tabla de problemas del Cohete Aniquilador:
D6 Tabla de problemas del Cohete Aniquilador
1 ¡Buuum!: Coloca la plantilla redonda grande centrada sobre el lanzador y resuelve el impacto de manera habitual.
2-5 Pérdida del ala estabilizadora: Tira el dado de dispersión para determinar la dirección que tomará el cohete desde el lanzador.
6 Inutilizado: No hay efecto adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Portentos del destino funesto" id="3606-51be-c9b8-c813" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8f94-8467-feb2-1d39" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="aa42-9006-6ce8-bc9f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
