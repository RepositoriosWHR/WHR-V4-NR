              <infoLinks>
                <infoLink name="Cetro ocular" id="3810-af7a-72a4-2f3c" hidden="false" targetId="f8a2-ecd3-8cdd-5c31" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Vara ocular" id="1c92-7870-4b41-ed2c" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Cetro oracular. Proporciona a Rom&apos;carebn un bonificador de +1 a su Fuerza en los turnos en que realice una carga exitosa, así como un bonificador de +2 a su Iniciativa en lugar del +1 habitual por cargar. Además, Rom&apos;carebn podrá realizar un ataque adicional hasta el final del turno por cada hechizo diferente que haya lanzado exitosamente en su fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
