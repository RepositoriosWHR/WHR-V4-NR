          <profiles>
            <profile name="Estandarte del Sol de Chotek" id="bc7f-99ce-3801-f9a5" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los disparos enemigos dirigidos contra la unidad en la que se encuentre este estandarte deberán aplicar un penalizador de -1 a sus tiradas para impactar. La unidad no podrá ser afectada por hechizos del Saber de las Sombras, ya fuesen lanzados por aliados o por el enemigo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la Bestia Gélida" id="4a35-ba14-c379-d6d6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e9a5-2517-bc86-0985" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4429-9a80-352d-3d6b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la Bestia Gélida" id="3cfd-c1f0-7b04-7679" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Siempre que una unidad enemiga del tipo Bestias, Caballería, Caballería monstruosa o Carro (que tenga bestias que tiren de él) quiera cargar contra el portador o la unidad en la que éste se encuentre, antes deber superar un chequeo de Liderazgo utilizando el liderazgo de las bestias; si lo falla, no podrá cargar ni mover ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la caza en espesura" id="c6da-bb2b-37b4-b50e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="47ef-2dad-7e8c-ee77" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="49a8-7978-7ee7-0a93" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la caza en espesura" id="eaff-d9aa-2e67-36dc" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad portadora de este estandarte ignorará la cobertura ofrecida por la linde de los bosques a la hora de utilizar sus armas de proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pabellón de piel de camaleón" id="fe4e-cfe4-71e7-8ce2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2fc6-36ac-5af8-1d90" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a7fd-7a44-43d7-feb8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pabellón de piel de camaleón" id="a5cb-88c6-52eb-d40a" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los disparos realizados contra la unidad portadora de este estandarte obtienen un penalizador de -1 en sus tiradas para impactar; los disparos que utilicen el dado de dispersión desviarán la mitad del resultado obtenido en el dado de artillería en caso de obtener un resultado de impacto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del pulso firme" id="b360-cc5e-edcb-95d8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b3d9-820d-ee72-fb8e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="99c9-e829-4a7f-e1ac" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
