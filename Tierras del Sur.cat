          </infoLinks>
          <profiles>
            <profile name="Diadema de poder" id="76f9-5a2d-fb9c-5901" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene Resistencia mágica (1). Al final de cada fase de magia puedes guardar hasta 2 de los dados no utilizados, que podrás utilizar en una fase de magia posterior (ya sea como dados de energía o de dispersión).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tablilla bendita de Tlaqua" id="ac6c-96aa-70c8-ede7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5e6a-f756-39e6-5a7d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0c94-d145-75af-e631" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
