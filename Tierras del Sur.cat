            <profile name="Estandarte del Jaguar" id="0f38-6d24-517c-ed31" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad que porte el estandarte aumentará en un punto el valor de su atributo de Movimiento y obtendrá la regla especial Veloz.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Sol de Chotek" id="05e6-1f18-7c69-11d3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6f4f-7a0b-da35-7928" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6213-14a4-5b5b-b241" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
