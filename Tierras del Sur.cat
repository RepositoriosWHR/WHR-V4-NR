            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Alta magia" id="1b00-74f4-d2a7-da35" collective="false" hidden="false" import="true" targetId="6a67-de12-5e4d-657a" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Tablilla bendita de Tlaqua" id="389b-2ee5-7b39-b46d" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador conocerá el hechizo Escudo de Saphery, aunque no dispondrá de la regla del saber correspondiente a la Alta magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Las tierras del sur" id="82c1-d34b-e551-4658" collective="false" hidden="false" import="true">
