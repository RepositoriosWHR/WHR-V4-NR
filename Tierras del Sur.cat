    <selectionEntry name="[E] - Rom´Carebn, Oráculo de guerra" id="840f-1753-5e08-e67e" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="850a-4812-e41c-c8b3" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
        <categoryLink name="New CategoryLink" id="8c1e-720e-f225-b7be" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
      </categoryLinks>
      <constraints>
        <constraint id="9ab3-3967-d740-ce7d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
