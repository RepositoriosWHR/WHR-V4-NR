            <profile name="Espada interdimensional" id="eedb-bc01-d572-95d5" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados por la Espada Interdimensional no permiten tiradas de salvación especiales. Además, tiene la regla especial Heridas múltiples (1D3) contra miniaturas con la clave demonios.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Macana de Palak-Xeq" id="3c29-b921-b765-8f95" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b1fa-680a-6179-2bc9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cce6-8b25-1ebe-8c91" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="5af1-bf56-8272-5c5a" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Poder de penetración" id="7847-42ec-1891-13fc" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Macana de Palak-Xeq" id="7854-4e45-8a9e-660b" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Otorga al portador la regla especial Poder de penetración en los ataques efectuados en sus ataques en combate cuerpo a cuerpo. Tira 1D6 por cada herida causada por esta arma a una unidad afectada por un hechizo de potenciación: con un resultado de 4+ el hechizo es dispersado. No puede dispersarse de este modo un hechizo que fuese lanzado con fuerza irresistible ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
