          <profiles>
            <profile name="Estandarte de piel de Skaven" id="ae77-4918-a47c-6b05" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Las miniaturas de la unidad obtienen la regla especial Odio (skaven) y los skaven obtienen la regla especial Odio sobre las miniaturas que formen parte de la unidad que lo porta. Además, la unidad causará Miedo a las miniaturas con la clave SKAVEN.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Jaguar" id="7d8e-18cf-08dc-baa5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1f41-2c49-ba3d-44cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5f69-eda8-6063-d4ae" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
