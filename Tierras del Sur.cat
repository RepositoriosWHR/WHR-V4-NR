    <selectionEntryGroup name="Generaciones" id="ceac-e39a-46b1-bed6" collective="false" defaultSelectionEntryId="5ec2-8ab1-5e38-969e" hidden="false" import="true">
      <constraints>
        <constraint id="23cd-33e1-c386-1d72" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="e272-46d9-4527-7090" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="5ª generación" id="5ec2-8ab1-5e38-969e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2097-1b29-a2b5-b9db" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <rules>
            <rule name="Quinta generación" id="eaae-b787-a2a2-cb3a" hidden="false">
              <description>Los Magos-sacerdote slann de Quinta generación siempre suman +1 a sus tiradas en la tabla de Disfunciones mágicas (cualquier resultado superior a 12 se considera 12) y tendrán éxito en sus tiradas para Canalizar con un resultado de 4+.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="4ª generación" id="6a4e-aaa6-e91f-c4f4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ebe2-bc6c-8c43-0b1d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="e355-6fc7-8345-eb11" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Alta o 8 básicos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <rules>
            <rule name="Cuarta generación" id="04e5-34c9-17e6-92de" hidden="false">
              <description>Los Magos-sacerdote slann de Cuarta generación siempre suman +2 a sus tiradas en la tabla de Disfunciones mágicas (cualquier resultado superior a 12 se considera 12) y tendrán éxito en sus tiradas para Canalizar con un resultado de 3+. Además, podrán elegir hasta dos Artefactos arcanos en lugar de sólo uno y obtienen la regla especial Señor del conocimiento, a elegir entre Alta Magia o uno de los ocho saberes básicos.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
