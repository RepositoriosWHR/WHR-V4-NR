                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Báculo de jade" id="20a5-ced4-829c-e288" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a Xuaxamut la regla especial Señor del conocimiento (Vida) adicional a su regla Señor del conocimiento (Cielos), obtiene un bonificador de +2 en sus tiradas de lanzamiento de hechizos y podrá sumar 1 a sus resultados en la tirada en la tabla de Disfunciones mágicas. Además, se trata de un objeto portahechizos de nivel de energía 1D6+2 que contiene un hechizo de potenciación que puede usarse una vez por batalla sobre una unidad amiga a 12” o menos del hechicero. La unidad recupera inmediatamente 2D6+2 heridas que hubiera perdido con anterioridad del mismo modo que con el hechizo Resurrección del Saber de la Vida.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corazón verde" id="d143-511b-617a-721f" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="79b0-cbef-42f3-418d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="26c0-a53d-7ccb-bf41" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Corazón verde" id="84e4-2f88-8823-c84b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Proporciona a Xuaxamut una tirada de salvación especial de 4+ y ve aumentado en 6” el alcance de todos sus hechizos. Además, al final de cada fase de magia, Xuaxamut puede tomar hasta dos de sus dados de energía o dispersión no utilizados y guardarlos en el Corazón Verde. Durante cualquier fase de magia posterior, Xuaxamut puede extraer dados del objeto, que pasarán a ser dados de energía (si es una fase de magia propia) o de dispersión (si es una fase de magia enemiga).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
