    <selectionEntry name="Marca sagrada de los ancestrales" id="f0a1-9464-ff6d-c47b" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="e9e9-6808-f63c-802f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Resistencia mágica (1)" id="2bb8-ea1b-bfa0-582c" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="e9e9-6808-f63c-802f" type="set" value="2">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="e9e9-6808-f63c-802f" type="set" value="3">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Marca sagrada de los ancestrales" id="e85a-af2c-b3ee-d151" hidden="false">
          <description>Las miniaturas que portan la Marca sagrada de los ancestrales obtienen una tirada de salvación especial de 5+ y la regla especial Resistencia mágica (1). Al inicio de la batalla, tira 1D3: ese será el número de tiradas que el personaje podrá repetir durante la partida. Esas tiradas puede ser tiradas para impactar, tiradas para herir, tiradas de salvación (armadura y especial), chequeos de atributo, dados de Energía o Dispersión y/o Regeneración. Hasta un personaje que no sea personaje especial puede portar la Marca sagrada de los ancestrales, hasta dos en una Gran batalla y hasta tres en una Batalla gigantesca; esto no limita la inclusión de personajes especiales con esta marca.</description>
        </rule>
      </rules>
    </selectionEntry>
