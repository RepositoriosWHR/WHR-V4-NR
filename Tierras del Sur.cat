        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Marcado por los ancestrales" id="87d4-0ba5-5626-8db7" hidden="false">
          <description>Thoaledapa tiene una tirada de salvación especial de 5+ y Resistencia mágica [1]. Además, una vez por batalla podrá repetir una tirada para impactar, herir, tirada de salvación especial o chequeo de atributo</description>
        </rule>
        <rule name="Diablo verde" id="3fe5-49f4-e739-3949" hidden="false">
          <description>Thoaledapa tiene la regla especial Odio (Pielesverdes). Además, otorgará esta regla especial a los eslizones de cualquier unidad a la que se una mientras permanezca unido a ella; este efecto se hará permanente en la unidad si Thoaledapa es retirado como baja a consecuencia de un ataque, disparo o hechizo efectuado por pielesverdes.</description>
        </rule>
      </rules>
