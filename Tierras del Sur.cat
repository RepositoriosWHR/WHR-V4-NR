          </infoLinks>
          <profiles>
            <profile name="Arco de Caxutuan" id="33a6-4f52-0e4b-2415" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco corto. Sus disparos se resuelven con F5 y tiene la regla especial Francotirador. Además, los disparos realizados con este arco ignoran el penalizador por disparar a miniaturas enemigas tras cobertura (tanto ligera como pesada), por disparar a larga distancia y por la regla especial Hostigadores.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
