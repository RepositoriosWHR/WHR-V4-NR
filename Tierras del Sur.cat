            <profile name="Atumpan encantado" id="25cc-f3d3-bf80-4512" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo eslizones. El portador cuenta como Músico y obtiene la regla especial Presencia inspiradora. Además, las miniaturas de su unidad podrán utilizar su valor de Iniciativa para realizar sus ataques en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
