          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cayado de gélido cornudo" id="b9b4-888b-0a17-ef7a" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Eslizónes. Permite a quien lo empuña obtener un bonificador de +2 al valor total de lanzamiento de los hechizos del Saber de las Bestias que lanzase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Las tierras del sur" id="55a1-4233-6114-a06f" collective="false" hidden="false" import="true">
      <constraints>
