            <selectionEntry name="Orbe de visión ancestral" id="52d1-07d7-6ed7-46ba" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a3d8-4c61-c08a-7857" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0b8b-e864-4cc3-14ae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Orbe de visión ancestral" id="9550-945e-6572-e324" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Puede guardar un dado de energía o dispersión para utilizarlos en una fase de magia posterior. Además le proporciona a Rom&apos;carebn una tirada de salvación especial de 5+, que aumentará a 4+ mientras tenga un dado guardado. Adicionalmente, puede lanzar sus hechizos desde otra miniatura de Oráculo Jinete de Troglodón a 24” o menos de él; simplemente ten en cuenta el alcance y la línea de visión desde la miniatura que elijas, aunque la tirada de lanzamiento la realizará el propio Rom&apos;carebn.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Vara ocular" id="660e-4dd5-7906-e7e0" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ec55-c2f6-f2e2-683b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2603-e002-7681-7f80" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
