          </entryLinks>
          <infoLinks>
            <infoLink name="Arma emparejadas" id="2c98-b6b3-ed18-9484" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espadas del poderoso Tzcatli" id="3a08-3c08-33f3-80ab" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. El portador verá aumentada su Fuerza hasta igualar la Resistencia de la miniatura enemiga a la que ataque en combate cuerpo a cuerpo (siempre que la Fuerza del portador sea inferior a la Resistencia de la miniatura a la que ataca). Además, los impactos causados con estas armas obtienen un bonificador de +1 en sus tiradas para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
