            <entryLink name="Clave: Hechicero" id="efd3-4c06-9050-5f92" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Estupidez" id="f6f2-3461-75cd-dae5" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Ánfora de los ancestrales" id="a5cb-8768-5303-e82a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Jefe Eslizón o Cacique Eslizón. Otorga a su portador un nivel de magia (el cual obtiene la clave hechicero) y conocerá un hechizo de uno de los ocho saberes básicos a tu elección. Sin embargo, obtiene la regla especial Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="5586-f18c-b34d-1248" collective="false" hidden="false" import="true">
              <constraints>
                <constraint id="2df6-b007-b759-3e77" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <entryLinks>
                <entryLink name="Saber de la Vida" id="603c-dabf-2c68-8af9" collective="false" hidden="false" import="true" targetId="db69-4431-08db-6b45" type="selectionEntry"/>
                <entryLink name="Saber del Fuego" id="743a-3614-51e5-13ff" collective="false" hidden="false" import="true" targetId="bff8-8e34-eb37-f67a" type="selectionEntry"/>
                <entryLink name="Saber del Metal" id="046f-5a83-6969-e068" collective="false" hidden="false" import="true" targetId="ddf8-615b-68b4-3fe4" type="selectionEntry"/>
                <entryLink name="Saber de Sombras" id="ad50-4f30-0aa8-0af6" collective="false" hidden="false" import="true" targetId="18bb-6c37-1cfe-8766" type="selectionEntry"/>
                <entryLink name="Saber de la Muerte" id="64ae-ffa0-5ac5-8713" collective="false" hidden="false" import="true" targetId="64a6-d9e9-3822-4168" type="selectionEntry"/>
                <entryLink name="Saber de las Bestias" id="3b84-6449-9aaf-f74e" collective="false" hidden="false" import="true" targetId="d333-4430-fb2b-4f60" type="selectionEntry"/>
                <entryLink name="Saber de los Cielos" id="67d5-8eb3-753a-1e41" collective="false" hidden="false" import="true" targetId="77a4-c5d2-08e5-4388" type="selectionEntry"/>
                <entryLink name="Saber de la Luz" id="84d6-cdb1-2fbf-bc72" collective="false" hidden="false" import="true" targetId="b0ef-3e63-c959-64d1" type="selectionEntry"/>
