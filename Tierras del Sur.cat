                <infoLink name="Poder de penetración" id="0f40-43e3-9b1b-5e21" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Resistencia mágica (2)" id="6276-8572-dba0-1e70" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Nehekhara, Nigromancia y Muerte)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Aguja de serpiente" id="1303-72c1-f193-a59f" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Cetro Oracular. Los impactos causados por la Aguja de la Serpiente hieren automáticamente (no es necesario efectuar la tirada para herir) salvo a miniaturas con la regla Inmune a veneno, y tienen la regla especial Poder de penetración. Además, le permite realizar Parada como si se tratase de un Arma de mano. Adicionalmente, otorga a Ynimirhi la regla especial Resistencia a la magia (2) contra hechizos del Saber de Nehekhara, Nigromancia y Muerte.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
