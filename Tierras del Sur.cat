            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cabeza maldita" id="c1fa-6140-ef10-672f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Sólo eslizones. Puede utilizarse al comienzo de cualquier fase de magia propia. Selecciona un personaje o monstruo enemigo a 18” o menos del portador; hasta el comienzo de tu siguiente fase de magia, todos los impactos que sufra la miniatura seleccionada obtendrán la regla especial Heridas múltiples (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Libélula de Mercurio" id="947c-b541-a624-3cfa" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4248-b338-de8d-50ed" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="fbb2-a293-23c3-c5d7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Vanguardia" id="688b-bfe0-4941-fc86" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Libélula de Mercurio" id="2b29-8e92-e127-a976" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo eslizones. El personaje y cualquier unidad de eslizones a la que se una obtienen la regla especial Vanguardia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cuenco Sagrado de Vinatl" id="7587-e66e-96a0-b96c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="261d-450d-2295-616b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8184-b9fc-13e7-0483" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
