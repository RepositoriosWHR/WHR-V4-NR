    <selectionEntry name="Lagarto atronador" id="dd7d-b6bf-1980-b63f" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="cc17-1881-8855-2be8" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Monstruo" id="9224-9011-9571-8f2c" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Sangre fría" id="1179-af73-93ab-d18d" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink name="Piel escamosa (3+)" id="e662-ebc2-c975-a9c9" hidden="false" targetId="f3fe-4c6e-197e-832f" type="rule"/>
        <infoLink name="Cruzar (elementos acuáticos)" id="a056-a6b2-1989-a8cd" hidden="false" targetId="69a7-ed40-a2f9-bea4" type="rule"/>
        <infoLink name="Estupidez" id="a525-c4a4-0245-74cc" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
        <infoLink name="Odio (todos los enemigos)" id="a744-911b-4e37-5ffc" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
        <infoLink name="Cruzar (bosques)" id="a723-cf59-ca17-5d9b" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
        <infoLink name="Monstruos con castillos" id="958c-b8df-cddc-16cd" hidden="false" targetId="a5eb-98d2-3b7c-18c7" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Cola maza Lagarto atronador" id="e56c-b302-9d98-2741" hidden="false">
          <description>El ataque adicional de la cola se realiza con un bonificador de +2 a la Fuerza y la regla especial Heridas múltiples (1D3).</description>
        </rule>
        <rule name="Mastodóntico" id="dafb-99b3-eabf-2893" hidden="false">
          <description>Siempre que un Lagarto Atronador declare una carga contra una unidad que no sea un Monstruo, Hostigadores o que no estén volando o flotando, la unidad que recibe la carga deberá realizar un chequeo de Liderazgo -tras realizar el chequeo de Terror o Miedo en caso de haberlo. Si lo falla, tan solo podrá declarar Mantener la posición o Huir como reacción a la carga y no podrá hacer uso de la regla especial Muro de acero con sus Lanzas o Picas durante ese turno. Además, tiene la regla especial Impactos por carga; para determinar el número de impactos por carga, tira 2D6 y escoge el mayor resultado.</description>
        </rule>
        <rule name="Aplastajunglas" id="2d56-922d-4328-296b" hidden="false">
          <description>El Lagarto del Trueno tiene la regla especial Cruzar (Bosques). Si el Lagarto del Trueno atraviesa por completo un Bosque al realizar cualquier movimiento, retira dicho bosque del campo de batalla y sustitúyelo por un Terreno difícil. Además, tiene la regla especial Heridas múltiples (1D6) contra Edificios y unidades del tipo Máquina de guerra.</description>
        </rule>
        <rule name="Dotación de Castillo" id="6cda-59fb-59ae-2f05" hidden="false">
          <description>El Lagarto de Trueno está tripulado por una dotación de 8 Eslizones, aunque se consideran una única miniatura. En cuerpo a cuerpo, el Lagarto de Trueno y la dotación pueden atacar con normalidad a cualquier miniatura en contacto peana con peana. Todos los impactos se resuelven utilizando la Resistencia, Heridas y Tirada de salvación del Lagarto de Trueno. Usa la HP de la dotación para resolver los ataques de disparo. Su Potencia de unidad es de 16.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Dotación" id="6e48-060f-1d87-26dd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="63c8-7a0e-33d6-df43" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
