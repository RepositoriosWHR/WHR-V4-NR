              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador de este estandarte y la unidad que lo acompañe obtienen la regla especial Disparo rápido.</characteristic>
              </characteristics>
            </profile>
