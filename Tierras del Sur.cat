    <selectionEntry name="Oráculo jinete de troglodón" id="725e-33cb-74de-c6b1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="95d2-0026-56fc-d89c" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
        <constraint id="3d40-16ca-3f9f-76db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Monstruo" id="d5af-f599-0291-f374" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Sangre fría" id="b77f-1fe4-b426-82b6" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink name="Cruzar (elementos acuáticos)" id="9a0b-838c-0aee-d0ba" hidden="false" targetId="69a7-ed40-a2f9-bea4" type="rule"/>
        <infoLink name="Ataques envenenados" id="e13f-8ff3-7789-b314" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink name="Veloz" id="fa68-6cde-0825-46d1" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
        <infoLink name="Piel escamosa (4+)" id="3c80-8f7a-b943-f9b6" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="3d40-16ca-3f9f-76db" type="set" value="2">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="3d40-16ca-3f9f-76db" type="set" value="3">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Escupir veneno" id="183f-ae27-4132-7080" hidden="false">
          <description>El troglodón puede disparar como una Catapulta con un alcance de 0-24”, Fuerza 3 y la regla especial Ataques Flamígeros. Los impactos de este disparo no permiten 
tirada de salvación por armadura. El impacto central se resolverá del mismo modo pero con Fuerza 5. Si obtienes un resultado de problemas, en lugar de tirar en la 
tabla, simplemente el disparo no tendrá efecto. El Troglodón puede escupir veneno si mueve, pero no si marcha.</description>
        </rule>
        <rule name="Oráculo eslizón" id="ab3b-66a8-dd78-6be6" hidden="false">
          <description>El Troglodón va montado por un Oráculo eslizón, que se considera un Oficial a todos los efectos. Su Potencia de unidad conjunta es de 6. El Oráculo eslizón puede ser usado por un Mago-sacerdote slann con la regla especial Telepatía como si fuese un chamán eslizón. Además, puede Canalizar dados de Energía y Dispersión. Adicionalmente, tiene la regla especial ¡Ni un paso atrás!, que afecta a todos los eslizones (de cualquier tipo) a 18” o menos del Oráculo jinete de troglodón.</description>
        </rule>
        <rule name="Rugido primitivo" id="0741-a0aa-1c52-ee8a" hidden="false">
          <description>Una vez por batalla, al inicio de uno de tus turnos, puedes declarar que el Troglodón ruge. Todos los eslizones (de cualquier tipo) a 18” o menos del Troglodón podrán repetir sus tiradas fallidas para impactar (tanto en combate cuerpo a cuerpo como con disparos) hasta el final de ese turno de jugador.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Troglodón" id="a6e2-245d-223a-537f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4f0b-528e-8e23-6b34" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="f97a-77ad-a7a1-75ec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
