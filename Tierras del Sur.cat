          <entryLinks>
            <entryLink name="Reliquia" id="7ad6-0287-d58c-c58d" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Inmune al veneno" id="1c97-ccbd-f60c-c708" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Placa sagrada de Zlatlan" id="ac0d-455d-abcd-758e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Slann. El portador y todas las unidades aliadas a 12” que formen parte del Desove sagrado de Zlatlan obtendrán una tirada de salvación de 6+, o mejorará en un punto si ya disponían de una (hasta un máximo de 3+). Además, el portador es Inmune a veneno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Las tierras del sur. Eslizones" id="7f1a-f91c-a6c1-4682" collective="false" hidden="false" import="true">
