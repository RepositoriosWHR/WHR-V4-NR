          </entryLinks>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="458f-27f6-e351-d58c" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink name="Tozudez" id="673c-0473-6b96-cff1" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Gran confalón de Zlatlan" id="1bab-54b5-dc4b-182e" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con el Desive sagrado de Zlatlan. El portador obtiene la regla especial Tozudez. Además, todas las unidades aliadas que formen parte del desove sagrado de Zlatlan a 18” o menos del portador del Gran Confalón obtendrán la regla especial Ataques envenenados; si ya disponían de esa regla especial, los resultados naturales de 5 también se considerarán Ataques envenenados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
