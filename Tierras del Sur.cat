        <infoLink name="Resistencia mágica (1)" id="90ed-c025-4b23-9d7a" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
        <infoLink name="Odio" id="37c2-1ffa-394b-371c" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Pielesverdes)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
