            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las competiciones de las cuchipandas" id="34ab-0ac0-270b-d49c" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los impactos que obtienen un resultado natural de 6 en la tirada para herir del portador y su unidad en combate se resolverán con un penalizador de -2 adicional a la tirada de salvación por armadura del oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Bocaenllamas" id="bcfa-62e8-e168-424e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5c68-ede5-1bf8-a2a5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="78a0-eaeb-3a37-1ef3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="4c81-4242-5163-7476" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del Bocaenllamas" id="3865-46f0-037f-4e64" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Ataques flamígeros. Además, al inicio de cada fase de combate cuerpo a cuerpo, elige una unidad enemiga en contacto peana con peana con el portador: dicha unidad sufrirá 1D6 impactos de Fuerza 3 distribuidos como proyectiles con la regla especial Ataques solo flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
