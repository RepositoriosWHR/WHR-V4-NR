          </infoLinks>
          <profiles>
            <profile name="Estandarte de Trapos" id="e01c-9bc6-d8bb-8b19" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Sangre fría.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tótem de los caníbales" id="3b30-cfcf-3233-9068" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c09b-b782-c11d-8c12" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
