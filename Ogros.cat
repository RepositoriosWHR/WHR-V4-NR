      <rules>
        <rule name="La mayor caballería del mundo" id="d3ad-dfe8-be62-a569" hidden="false">
          <description>La Caballería ogra tiene Potencia de unidad 6.</description>
        </rule>
        <rule name="Impactos por carga (1)" id="3008-9bec-0b81-5fbc" hidden="false">
          <description>Sólo las bestias de las montañas</description>
        </rule>
        <rule name="Los Jinetes Pielférrea" id="681b-7961-47df-f906" hidden="false">
          <description>La unidad de Caballería ogra a la que se una Ghark obtiene un bonificador de +1 a su Habilidad de armas (sólo jinetes y ya incluido en el perfil) y las reglas especiales Tozudez e Inmune a psicología (mantienen esas bonificaciones aunque Ghark sea retirado como baja).</description>
        </rule>
      </rules>
