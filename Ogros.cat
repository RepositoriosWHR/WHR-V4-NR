          </infoLinks>
          <profiles>
            <profile name="Fauces Rúnicas" id="21af-8757-1183-2422" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Proporciona al portador y su unidad la regla especial Resistencia mágica (3). Además, cualquier hechizo de Potenciación del Saber de Panzamagia lanzado por un hechicero amigo a 24” o menos del portador afectará también al portador y a su unidad (ten en cuenta que se trata del mismo hechizo por lo que, si es dispersado,
dejará de afectar también a esta unidad).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
