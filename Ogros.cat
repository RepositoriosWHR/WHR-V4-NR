      <rules>
        <rule name="Magia de Matarife" id="b2ac-145e-ba13-4e97" hidden="false">
          <description>Nivel de magia 1, puede aumentarse a 2 por +30 puntos. Puede elegir sus hechizos de uno (y sólo uno) de los Saberes de las Bestias, de la Muerte, de los Cielos o Panzamagia.</description>
        </rule>
      </rules>
