    <selectionEntry name="[E] - Los hechiceros ogros del brezal de Ventrag" id="8ae9-6070-5e4c-f27b" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="6135-f034-54b6-0d01" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
      </categoryLinks>
      <constraints>
        <constraint id="454a-2f6b-b0fc-17c9" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Arremetida" id="d6b4-262c-7623-5692" hidden="false" targetId="bf68-9d87-3db2-0434" type="rule"/>
        <infoLink name="Inmune al veneno" id="6ef1-fdc2-b1f0-c249" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
