          <profiles>
            <profile name="Colmillo de las Grandes Fauces" id="f85d-6e30-9901-115b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Reliquia. Al inicio de la batalla, cuando determines los hechizos de Gorg, tira 1D3: este será el número de hechizos adicionales que conocerá Gorg en la batalla. Además, le otorga a Gorg la regla especial Regeneración (5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
