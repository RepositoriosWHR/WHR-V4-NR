                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Armadura pesada" id="ae78-20a7-7ea7-f6c2" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
              </infoLinks>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Grancráneo" id="9aa1-e86f-6cbe-0bee" collective="false" hidden="false" import="true" type="upgrade">
