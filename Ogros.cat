            <entryLink name="Puño de Hierro" id="192b-555a-3ebd-b5f0" collective="false" hidden="false" import="true" targetId="361c-5c10-231f-a1e0" type="selectionEntry">
              <constraints>
                <constraint id="175b-739d-3956-3aa9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
