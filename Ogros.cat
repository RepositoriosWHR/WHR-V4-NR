                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Yelmo. El portador obtiene las reglas especiales Tozudez y Resistencia mágica (1). Adicionalmente, podrá repetir sus tiradas de salvación por armadura fallidas.</characteristic>
                  </characteristics>
                </profile>
