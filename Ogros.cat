        <infoLink name="Inmune a la psicología" id="3dc2-c73f-a5ba-4c3c" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Terror" id="dd1f-0638-4661-686e" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Infantería monstruosa" id="009f-d0bf-4e22-309f" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
      </infoLinks>
