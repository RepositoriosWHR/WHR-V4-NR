              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Al inicio de cada uno de tus turnos, el personaje recupera una de las heridas que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Armadura pesada" id="c735-d5aa-4b0e-44d7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dc60-b7c1-9779-62cb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="82e3-41c3-1b9c-5da1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
