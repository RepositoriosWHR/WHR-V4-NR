            <infoLink name="Piel escamosa (5+)" id="e9c8-e742-a2f4-0bd8" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pellejo de colmillos de trueno" id="c72b-ebc9-dff1-0893" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Otorga a su portador las reglas especiales Piel escamosa (5+) y Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Armadura ligera" id="0037-0807-e530-7833" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9884-c51a-3100-b2d0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
