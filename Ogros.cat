                <infoLink name="Arma emparejadas" id="8266-430a-76c0-4219" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Puñalez odiozoz" id="9217-d1a5-dc0c-0f58" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. El personaje obtiene la regla especial Odio (¡todos los enemigos!). Además, obtendrá 1D3 ataques adicionales siempre que ataque a una unidad por el flanco o la retaguardia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
