        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia" id="834d-ab75-b31a-b7db" hidden="false">
          <description>Gorg es un hechicero de nivel 2 que siempre utiliza hechizos del Saber de Panzamagia.</description>
        </rule>
        <rule name="Devoción despreocupada" id="4c75-6708-5d38-2a17" hidden="false">
          <description>Gorg tiene las reglas especiales Sangre fría e Inmune a psicología.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Colmillo de las Grandes Fauces (Artefacto arcano-Reliquia)" id="2c35-8536-3354-2a23" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
