      </modifiers>
      <rules>
        <rule name="Empatía felina" id="f8eb-83b2-b8aa-1df1" hidden="false">
          <description>Groznor tan sólo podrá unirse a Manadas de colmillos de sable. Groznor y cualquier unidad de Manada de colmillos de sable a la que se una obtendrán la regla especial Carga devastadora.</description>
        </rule>
        <rule name="Señor de las bestias" id="ee92-7b4d-4244-f757" hidden="false">
          <description>Groznor tiene la regla especial ¡Ni un paso atrás!, que afecta a las unidades amigas de Yetis, Manadas de colmillos de sable, Buitres negros, Caballería ogra, Colmillos de hielo, Cuernos pétreos y personajes ogros montados a 12” o menos de él.</description>
        </rule>
        <rule name="Alfa de la manada (Sobrenombre ogro)" id="4e7b-8a14-6ee7-d4d9" hidden="false">
          <description>Groznor tiene la regla especial Presencia inspiradora, que afecta sólo a las Manadas de colmillos de sable a 18” o menos de Groznor.</description>
        </rule>
      </rules>
