          <profiles>
            <profile name="Parteescudos" id="8217-d4e2-3f41-0d63" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Efectúa la tirada para impactar con este arma usando la Iniciativa del objetivo en lugar de su Habilidad de armas. Las miniaturas sin Iniciativa serán impactadas automáticamente y sufrirán 1D6 heridas por cada impacto en lugar de sólo una. Los impactos con este arma se resuelven con +1 a la Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Arma a dos manos" id="2ebb-284f-f5c6-9c43" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1c37-6c5e-763c-d89a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="75f7-aeda-29c5-7eae" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
