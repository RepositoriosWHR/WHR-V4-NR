              <characteristics>
                <characteristic name="Reglas" typeId="8142-649f-c02b-80ac">El personaje causa Terror; además, las unidades enemigas en contacto peana con peana con el personaje tendrán un penalizador de -1 a su Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
