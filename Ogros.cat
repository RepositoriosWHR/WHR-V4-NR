        <selectionEntryGroup name="Objetos hechizados" id="8aed-2cea-b345-8cfa" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Marmitón mágico" id="2a34-df14-8834-e958" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="798f-9512-5e99-5fa8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="093c-443b-ee0a-9469" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="40"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <entryLinks>
                <entryLink name="Clave: Hechicero" id="8fa0-55ac-4ede-021d" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
              </entryLinks>
              <profiles>
                <profile name="Marmitón mágico" id="c7f6-7b37-92a4-b4fe" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje equipado con el Marmitón mágico deberá elegir un personaje ogro con niveles de magia como Zeñor del gnoblar. Obtiene un nivel de magia y conocerá el hechizo Médula espinal del Saber de Panzamagia.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Médula espinal" id="4b85-0ade-70af-c5de" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
                  <characteristics>
                    <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                    <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">7+/14+</characteristic>
                    <characteristic name="Rango" typeId="544c-fa75-b146-79c4">18&quot;/12&quot;</characteristic>
                    <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">Permanece un turno</characteristic>
                    <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga a 18” o menos del lanzador y Permanece un turno. Mientras dure el hechizo, la unidad tiene la regla especial Tozudez. Puede potenciarse para que afecte a todas las unidades amigas a 12” o menos del lanzador, en cuyo caso la dificultad será de 14+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Traka final" id="e79e-ddf1-adf6-4e81" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6236-54a0-3f36-d057" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="9cf3-30b8-dce4-b0ad" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Heridas múltiples (1D3)" id="bbeb-d3a7-25b0-4b09" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Traka final" id="2614-4ccb-5ad7-505e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Si el portador muere, antes de retirarlo como baja, puedes utilizar la Traka final; todas las miniaturas en contacto peana con peana con el portador sufrirán un impacto de Fuerza 6 con las reglas especiales Poder de penetración y Heridas múltiples (1D3).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dadoz de Grubbi" id="853c-7c99-b59b-c857" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c936-7489-c500-0e13" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="4a18-f41b-9f84-6529" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="10"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Dadoz de Grubbi" id="ade5-780c-4a91-4122" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Pueden usarse al comienzo de cualquier ronda de combate. Las miniaturas que ataquen al portador de los Dadoz de Grubbi deberán repetir todas sus tiradas exitosas para impactar y herir durante esa ronda de combate.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntryGroup>
