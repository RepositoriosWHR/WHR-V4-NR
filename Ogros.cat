              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Otorgan a Braugh nivel de magia 2; sus hechizos siempre son Invocación de Nehek y Danza macabra de Vanhel, ambos del Saber de Nigromancia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
