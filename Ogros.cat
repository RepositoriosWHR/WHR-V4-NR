          <entryLinks>
            <entryLink name="Protegetripas" id="b71f-8278-3b93-cbab" collective="false" hidden="false" import="true" targetId="9808-e8e9-af64-951e" type="selectionEntry">
              <constraints>
                <constraint id="84f8-2b91-6b9a-85ab" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
            </entryLink>
          </entryLinks>
          <profiles>
            <profile name="Grancráneo" id="a3f9-0df4-345d-ac6d" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. Cualquier hechicero que designe como objetivo de uno de sus hechizos a la unidad en la que esté el portador obtendrá una Disfunción mágica con cualquier resultado de dobles en su tirada de lanzamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Protegetripas de las Grandes Fauces" id="14b0-d551-b09b-5f82" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="54d6-6d5d-5007-7eb3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="3f8d-b411-2d25-2640" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Protegetripas" id="7988-0983-cb17-fe06" collective="false" hidden="false" import="true" targetId="9808-e8e9-af64-951e" type="selectionEntry">
              <constraints>
                <constraint id="c981-25d5-2529-3596" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
            </entryLink>
          </entryLinks>
          <infoLinks>
            <infoLink name="Terror" id="657f-0b9e-7957-2f5d" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Protegetripas de las Grandes Fauces" id="479a-d881-4a1c-df9c" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. El portador causa Terror. Cada vez que el portador acabe con un enemigo en un Desafío, puede restaurar una de las heridas perdidas previamente durante la batalla. Si no había sufrido heridas, obtiene permanentemente +1 Herida en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tripa de toro" id="2ea4-025c-fa85-2afa" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d23e-e7c8-3da4-f01a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="eac5-7e22-3d61-4850" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Protegetripas" id="e4ce-a82c-a042-386b" collective="false" hidden="false" import="true" targetId="9808-e8e9-af64-951e" type="selectionEntry">
              <constraints>
                <constraint id="3a1b-6f44-27f6-dd47" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
