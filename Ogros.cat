            <condition childId="2a81-6a0c-edfa-b306" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Golgfag Comehombres" id="5a71-b78e-19d5-e895" hidden="false">
          <description>Golgfag tiene el sobrenombre comehombres que le otorga las reglas especiales Inmune a psicología y Tozudez. Debe unirse a la unidad exclusiva de los comehombres de Golgfag y su portaestandarte deberá ser Skaff.</description>
        </rule>
        <rule name="El Comehombres" id="8532-0de0-c42e-f1be" hidden="false">
          <description>Si Golgfag mata a un personaje enemigo en un Desafío de las categorías Infantería, Caballería o Bestia, todas las unidades enemigas participando en el mismo combate quedarán Apabulladas hasta el final del turno.</description>
        </rule>
      </rules>
      <selectionEntries>
