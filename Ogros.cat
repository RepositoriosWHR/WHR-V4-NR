            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de los Toros" id="243c-707d-03a9-05a1" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad podrán repetir sus tiradas para herir fallidas causadas por los Impactos por carga generados por su regla especial Arremetida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las competiciones de las cuchipandas" id="38a6-a759-c961-639c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1ed5-6712-aaab-3b15" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="66fd-8fd6-fdcc-03a3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
