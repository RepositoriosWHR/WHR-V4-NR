  <sharedProfiles>
    <profile name="Lanza-arpones" id="528a-958f-0036-4eb8" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">36&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Atraviesa filas, Heridas múltiples (1D3), Poder de penetración. Un Lanza-arpones puede dispararse incluso al mover. No puede usarse para Aguantar y disparar.</characteristic>
      </characteristics>
    </profile>
    <profile name="Protegetripas" id="b95d-3850-df14-271f" hidden="false" typeId="82a1-ea3c-b415-8a9a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas" typeId="202e-dc4f-f71a-241e">El Protegetripas proporciona un bonificador de +1 a la tirada de salvación por armadura de su portador o una tirada de salvación por armadura de 6+ si no disponía de ella. Puede combinarse con otras armaduras de la forma habitual.</characteristic>
      </characteristics>
    </profile>
    <profile name="Piel de cuernos pétreos" id="d97f-ed73-6f66-86cc" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">6+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Otorga la regla especial Piel escamosa (6+).</characteristic>
      </characteristics>
    </profile>
    <profile name="Recetario secreto" id="7801-e520-0899-8b11" hidden="false" typeId="82a1-ea3c-b415-8a9a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas" typeId="202e-dc4f-f71a-241e">Al inicio de la batalla, puedes decidir desplegar al portador del Recetario secreto con una unidad de ogros. Si lo haces, efectúa una tirada en la siguiente tabla y aplica el efecto al portador y a la unidad durante toda la batalla (si el portador muere o abandona la unidad, el efecto sobre la unidad cesa inmediatamente):

1-2:  Obtienen la regla especial Regeneración (6+) o +1 si ya disponían de ella.
3-4: El portador y su unidad obtienen la regla especial Furia asesina.
5-6: El portador y su unidad pueden repetir sus tiradas de carga.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rhinox" id="6ebc-c4c0-f4a5-b02a" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
