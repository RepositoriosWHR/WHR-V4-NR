              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Por cada herida causada por Friast en combate cuerpo a cuerpo con este arma, generará un dado de Energía o Dispersión adicional, según corresponda, en la siguiente fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
