            <infoLink name="Ansia de sangre" id="2f3a-5f4f-69be-e80f" hidden="false" targetId="2a68-a009-1a7a-c667" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Tótem de los caníbales" id="b5bc-0bad-873f-dd5c" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen las reglas especiales Ansia de sangre y Furia asesina y no la perderán aunque pierdan un combate (sin embargo, la perderán si pierden este estandarte).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de los Toros" id="25d3-4135-8ad9-50ce" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5277-fde8-c048-e09e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="bc9a-f55d-930c-4936" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
