      <rules>
        <rule name="Bendición del Bocaenllamas" id="6076-1bf0-fe3d-dc48" hidden="false">
          <description>Los Ogros comefuegos tienen una tirada de salvación especial de 6+. No podrán obtener la regla especial Regeneración de ninguna forma. Además, ningún personaje salvo un Panzafuego podrá unirse a una unidad de Ogros comefuegos.</description>
        </rule>
        <rule name="Danza de guerra" id="7220-c503-0fec-fdef" hidden="false">
          <description>Los chequeos de Miedo provocados por una unidad de Ogros comefuegos se efectuarán con 3D6 descartando el resultado más bajo.</description>
        </rule>
      </rules>
