                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Cuchillos arrojadizos. Los impactos realizados con este arma se resuelven con un bonificador de +1 a la Fuerza.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
