                <characteristic name="Reglas" typeId="8142-649f-c02b-80ac">El personaje aumenta en +2 su atributo de Movimiento y obtiene la regla especial Veloz.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vencebestias" id="fa2c-e574-222f-a13f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a6cf-01c3-3326-c428" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="1826-6690-016f-c9d8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
