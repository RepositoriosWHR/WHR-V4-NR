        <infoLink name="Ataques flamígeros" id="21ea-9953-ec5c-8b40" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
        <infoLink name="Arma de aliento" id="1852-f6bb-d604-840a" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(F3, Ataques sólo flamígeros)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Bendición del bocaenllamas" id="465e-c61b-808e-7609" hidden="false">
          <description>El Panzafuego tiene una tirada de salvación especial de 6+. Esta miniatura no podrá verse afectada por la regla especial Regeneración de ninguna forma.</description>
        </rule>
        <rule name="Regurgito volcánico" id="7b26-faed-774e-5eb2" hidden="false">
          <description>Un Panzafuego tiene un Arma de aliento de Fuerza 3 con la regla especial Ataques sólo flamígeros.</description>
        </rule>
        <rule name="Magia de Panzafuego" id="b75c-1112-6091-9f28" hidden="false">
          <description>Nivel de magia 1, puede aumentarse a 2 por +30 puntos. Puede elegir hechizos del Saber del Fuego.</description>
        </rule>
      </rules>
