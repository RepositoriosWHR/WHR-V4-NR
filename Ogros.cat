    <selectionEntryGroup name="Estandartes mágicos. Ogros" id="7631-2252-51c5-c690" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4daa-191b-ea19-8d04" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pellejodragón" id="844e-edc0-e0f3-3680" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6296-8788-7d3a-1790" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4d86-6231-7f72-d89e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pellejodragón" id="1805-8910-be05-cec7" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad pueden repetir todos los resultados de 1 en sus tiradas para impactar, herir y salvaciones en cualquier turno en el que realicen exitosamente una carga. Además, una vez por batalla, durante cada fase de magia el portador puede desatar un vendaval helado sobre una unidad enemiga en contacto peana con peana con este. La unidad sufre inmediatamente 1D6 impactos de Fuerza 2 sin tirada de salvación por armadura y verá su atributo de Iniciativa reducido a la mitad (redondeando hacia arriba) hasta el final del turno en curso. Esto no afecta a unidades con la regla especial Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Trapos" id="359c-06c2-40c6-0ca5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d75c-8492-b72a-1e91" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="bbae-2de0-df09-3e9a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
