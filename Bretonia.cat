    <selectionEntry name="[E] - Asesinos de bestias de Bastonne" id="bc4e-9e13-f632-5b6f" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades especiales" id="7c1d-9da5-a9d4-8943" hidden="false" primary="true" targetId="5370656369616c23232344415441232323"/>
      </categoryLinks>
      <constraints>
        <constraint id="d51a-4ef7-8096-0a2c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="39d6-9eff-bde2-f64f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="3"/>
      </constraints>
