            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la heroicidad" id="b069-78d3-e6cf-d505" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">Los ataques realizados por el personaje y su montura contra miniaturas del tipo Infantería monstruosa, Bestia monstruosa, Caballería monstruosa o Monstruo podrán repetir las tiradas para herir fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del cruzado" id="c1b5-5f47-552f-844a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3247-eabc-bf75-d06f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0559-4a4e-9985-e851" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
