          <profiles>
            <profile name="Virtud del cruzado" id="3abe-5e71-abd4-d325" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje podrá elegir uno de sus objetos mágicos (no Reliquias) de entre los de las listas de ejército de Nehekhara, La Tierra Bendita o Rasetra. Todas las miniaturas del ejército del libro al que pertenezca el objeto ganarán la regla Odio contra este personaje.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del ímpetu" id="890b-68bd-c2cf-b9e5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
