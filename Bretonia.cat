                <infoLink name="Odio" id="26c9-423a-e535-75fe" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Armas de proyectiles y/o lanzar hechizos)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Virtud del noble desdén" id="aadb-2897-c5ae-c65a" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje obtiene la regla especial Odio contra todas las miniaturas enemigas equipadas con armas de proyectiles y/o capaces de lanzar hechizos. Además, la unidad en la que se incluya el caballero con esta Virtud no deberá chequear Pánico por bajas sufridas por proyectiles o magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
    </selectionEntry>
