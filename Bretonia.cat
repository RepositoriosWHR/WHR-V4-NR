                <profile name="Espejo mágico" id="a907-b83a-968f-3f92" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de cada fase de magia enemiga puedes elegir un hechicero enemigo; los intentos de dispersión efectuados por Morgana contra hechizos lanzados por el hechicero elegido obtendrán un bonificador de +2.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
