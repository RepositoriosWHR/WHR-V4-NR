            <profile name="Lanza del roble" id="ab9b-5346-3bce-0422" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza de caballería. Sólo Caballero. Los impactos con este arma siempre hieren con un resultado de 2+.</characteristic>
