      <rules>
        <rule name="Curtidos" id="d66e-886b-d10d-a861" hidden="false">
          <description>Bertrand, Hugo, Gui y los arqueros de Bergerac tienen la regla especial Inmune a Miedo.</description>
        </rule>
        <rule name="Bandidos" id="4af8-d824-bb01-73ce" hidden="false">
          <description>Los Arqueros de Bergerac no pueden utilizar la regla especial Presencia inspiradora ni ¡Ni un paso atrás! de ningún personaje bretoniano.</description>
        </rule>
        <rule name="Héroe de la plebe" id="5345-2efb-33b8-0f56" hidden="false">
          <description>Bertrand tiene la regla especial Presencia inspiradora, aunque sólo afecta a las unidades con la regla especial Deber del vasallo.</description>
        </rule>
      </rules>
