            <profile name="Cetro Serpiente" id="462e-e491-6bb1-f9c3" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo hechiceros o personajes con la regla especial Cánticos de guerra. Arma de mano. Los ataques con este arma 
se resuelven con la regla especial Ataques envenenados. El portador puede repetir sus tiradas fallidas para herir en combate cuerpo a cuerpo. Suma +1 a sus tiradas de Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
