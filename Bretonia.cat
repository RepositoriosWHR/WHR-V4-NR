      <rules>
        <rule name="Trebuchet" id="d51b-f11b-3172-6e1d" hidden="false">
          <description>Dispara como una Catapulta. Si se está disputando una batalla de asedio, un Trebuchet es un Arma de demolición.</description>
        </rule>
        <rule name="Artillería fija" id="9a33-ab2f-f92f-fdee" hidden="false">
          <description>Una vez desplegado, un Trebuchet no puede mover por ninguna razón (salvo huir).</description>
        </rule>
      </rules>
