              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje obtiene la regla especial Resistencia mágica (1), que se incrementa a Resistencia mágica (3) contra todos los hechizos de los Saberes del Viento de Magia Oscura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
