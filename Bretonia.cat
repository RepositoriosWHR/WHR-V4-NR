              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje y la unidad en la que se encuentre obtienen la regla especial Impasible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
