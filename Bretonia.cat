          <infoLinks>
            <infoLink name="Arma de mano" id="4bfe-a5e6-0282-6212" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espada del dolor eterno" id="25cf-0537-0bc8-e1c2" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Por cada baja causada con este arma en una fase de combate cuerpo a cuerpo, el bando del portador obtiene un bonificador adicional de +1 al resultado del combate esa ronda.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espada de Setep" id="fb4c-f54e-6f03-96db" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f85b-cf47-2fdb-cacb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5704-3dea-8bf5-7c6f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="c0d6-6156-815d-ec07" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Poder de penetración" id="4b4c-fcdf-d785-ac1f" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Espada de Setep" id="a660-751c-98b6-d4b8" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El portador tendrá un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo. Además, sus impactos se resuelven con la regla especial Poder de penetración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Khopesh del verdugo" id="41b4-3058-5ab9-8aec" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="adf3-c155-790e-7243" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="66ca-3662-4d82-2750" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
