      <rules>
        <rule name="Halo de santidad" id="7b85-3594-66b4-fba2" hidden="false">
          <description>La tirada de salvación Especial otorgado por el Favor de la Dama se ve mejorada hasta (4+). Además Repanse obtendrá las reglas especiales Resistencia a la Magia (1) e Inmune a Veneno.</description>
        </rule>
        <rule name="Símbolo de esperanza" id="40ef-b46a-3814-3a10" hidden="false">
          <description>Puedes elegir que Repanse sea General del ejercito, incluso a pesar de ser Portaestandarte de Batalla.</description>
        </rule>
      </rules>
