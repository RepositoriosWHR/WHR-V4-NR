      </costs>
      <infoLinks>
        <infoLink name="Caballería" id="391b-0b6d-3f6a-c532" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
        <infoLink name="Caballero" id="6a8b-b79a-77c6-2b6f" hidden="false" targetId="eeb6-9248-cb21-7e47" type="rule"/>
        <infoLink name="Voto del caballero" id="2d5a-83c3-549e-4dca" hidden="false" targetId="64f3-19ba-e76e-0e1c" type="rule"/>
        <infoLink name="Caballería pesada" id="bc98-aa33-d7f4-94d2" hidden="false" targetId="b6eb-e533-d53c-7d5c" type="rule">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="1b46-d4e0-38ec-35ab" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="7f25-e674-7957-a99f" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink name="Purasangre" id="8052-a656-96cc-ae0e" hidden="false" targetId="496d-ebd9-e95a-8eff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Sólo Corcel bretoniano)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Señor de Bordeleaux" id="570d-0669-2828-08bf" hidden="false">
          <description>Si incluyes a Alberic en tu ejército y es el General, las unidades de Caballeros del reino se consideran como 
opción de Unidades especiales, manteniendo la restricción de como mínimo una unidad. Dichas unidades obtienen la regla Sangre fría.</description>
        </rule>
        <rule name="Borrachuzos" id="6dd8-90f4-3b39-587d" hidden="false">
          <description>Todas las unidades con la regla Deber del vasallo del ejército se ven sujetas a esta regla. Tras el despliegue, efectúa una tirada de 1D6 por cada una de ellas en la siguiente tabla:
1D6 	Borrachuzos de Bordeleaux
1-2	Alegres beodos: La unidad tiene un -1 al Liderazgo.
3-4	Frescos como una rosa: No hay efectos adicionales.
5	Envalentonados: La unidad tiene la regla especial Inmune a psicología. Sin embargo, la unidad obtendrá un penalizador de -1 a su Movimiento en todos sus movimientos de huida.
6	Matones de taberna: La unidad obtiene la regla
especial Furia asesina (no afecta a monturas).</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Virtudes" id="2572-db0d-0001-d3f9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="684a-b9f2-b009-b7f8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5a39-1149-4234-7846" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <selectionEntries>
            <selectionEntry name="Virtud de la disciplina" id="2730-1586-548c-81f7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0e02-363a-7243-8852" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="f414-cfcc-615b-1fbf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Virtud de la disciplina" id="facb-0654-d283-1302" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">Un solo uso. Al inicio de cualquier turno bretoniano, si el personaje no está trabado en combate, puede tratar de superar un chequeo de Liderazgo. Si lo supera, él y su unidad podrán realizar una maniobra de reformar de forma gratuita inmediatamente. No puede reorganizar filas ni columnas ni cambiar de formación. Sin embargo, si falla, no podrá mover ese turno.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
