        <rule name="Destinado a la gloria" id="b0b4-9b93-6f00-f3de" hidden="false">
          <description>Armand puede repetir todas las tiradas para impactar, herir y salvaciones por armadura que falle durante la batalla.</description>
        </rule>
        <rule name="Athletla" id="13ec-8878-b17f-8895" hidden="false">
          <description>Armand superará con éxito todos los chequeos de atributo que deba efectuar. Esto no incluye los chequeos de Liderazgo o los chequeos que debiesen efectuarse con más de un dado.</description>
        </rule>
      </rules>
