                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">Por cada herida causada en combate por el personaje, podrá efectuar un ataque adicional en la siguiente fase de combate. No puede generar más ataques de los que posea en su perfil de atributos.</characteristic>
                  </characteristics>
