              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Sólo Caballero. Otorga a su portador la regla especial Regeneración (3+). Si el personaje tiene una Potencia de unidad de 5 o más, en vez de eso otorga la regla especial Regeneración (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
