    <selectionEntry name="[E] - Alberic, duque de Bordeleaux" id="7f25-e674-7957-a99f" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="3248-7306-127d-5eaa" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
