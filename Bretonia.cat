    <selectionEntry name="Bardo" id="49a9-eb71-aff7-9d7a" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="02b2-d862-9ee1-e32c" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
        <categoryLink name="Personajes" id="fa22-7e7e-6469-054e" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
