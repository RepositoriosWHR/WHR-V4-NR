                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="a245-be35-927c-6387" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Munición incendiaria" id="4813-3d34-8762-16c1" hidden="false">
                  <description>Debes declarar que el Trebuchet usará esta munición antes de usarla. Se trata de un disparo de Catapulta de Fuerza 4 con la regla especial Ataques flamígeros cuyo impacto central se resuelve con Fuerza 6 (anula la tirada de salvación por armadura), las reglas especiales Ataques flamígeros y Heridas múltiples (1D3). Obligará al enemigo a efectuar un chequeo de Pánico al causar al menos una baja.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Grandes rocas" id="d387-7698-e54c-4976" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="65cb-e53e-ef30-fa9d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Grandes rocas" id="5cf8-dcb0-8cc8-a95d" hidden="false">
                  <description>Debes declarar que el Trebuchet usará esta munición antes de usarla. Se trata de un disparo de Catapulta de alcance 12-36”. Se resuelve con Fuerza 5 y el impacto central con Fuerza 8 (anula la tirada de salvación por armadura) y la regla Heridas múltiples (1D6, para determinarlas, tira 2D6 y escoge el resultado más alto).</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Cadáveres de ganado" id="e8aa-a609-393e-3f60" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a0b4-7af2-a8bf-57f0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Cadáveres de ganado" id="ce86-645e-f774-198f" hidden="false">
                  <description>Debes declarar que el Trebuchet usará esta munición antes de usarla. Se trata de un disparo de Catapulta de Fuerza 2 que usa la plantilla de área grande. El impacto central tiene Fuerza 5 y la regla Heridas múltiples (1D3). Obligará al enemigo a efectuar un chequeo de Pánico con un -1 al Liderazgo al causar una baja.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
