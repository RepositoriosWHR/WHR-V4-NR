    <selectionEntry name="[E] - Barón Odo de Outremer &quot;El Cruzado&quot; y Sulimán &quot;El Sarraceno&quot;" id="8fc0-c42b-8fb7-2946" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
