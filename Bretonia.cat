          <profiles>
            <profile name="Virtud del ardor caballeresco" id="64f8-2553-c521-8887" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">Por cada herida causada en combate por el personaje, podrá efectuar un ataque adicional en la siguiente fase de combate. No puede generar más ataques de los que posea en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la heroicidad" id="58db-1d00-d6c6-123c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="45c4-5525-e579-f6c7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
