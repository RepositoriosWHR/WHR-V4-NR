      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="f482-9e27-bf29-5196" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Caballero" id="7702-812b-4d42-420f" hidden="false" targetId="eeb6-9248-cb21-7e47" type="rule"/>
