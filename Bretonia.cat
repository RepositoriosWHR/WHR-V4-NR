          <profiles>
            <profile name="Incensario sagrado" id="7af9-2fea-5abd-78ac" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todas las miniaturas con las reglas especiales No Muerto o Demonio que estén en contacto peana con peana con el portador sufrirán un impacto de Fuerza 4 con la regla especial Ataques mágicos al inicio de cada fase de combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Guantelete del desafío" id="75a4-a0ee-7a52-a1e3" collective="false" hidden="false" import="true" type="upgrade">
