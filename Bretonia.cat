            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="f553-5b84-add3-0541" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Golpe letal" id="ae09-f377-486c-cfb4" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Khopesh del verdugo" id="311f-6f1c-f64f-1881" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Sus impactos se resuelven con la regla especial Golpe letal. Cada vez que el portador elimine a un oponente en combate cuerpo a cuerpo con un Golpe letal, el atributo de Heridas de este aumenta permanentemente en +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Daga del escarabajo de la muerte" id="ae27-30fd-6590-99dc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="39af-3173-c130-3aea" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4c4b-63ff-cb3f-a7b9" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="76ba-d66f-79b0-278e" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Daga del escarabajo de la muerte" id="03df-76d8-f3fc-55e8" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. No se pueden efectuar tiradas de salvación especiales contra las heridas causadas con este arma (salvo tiradas de Esquivar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro Serpiente" id="82ff-cde4-1dd6-aab6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5fd2-a09f-f2d1-dc2e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="8053-a570-6aa8-c063" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
