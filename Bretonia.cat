            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="449c-a9a9-50ab-a15f" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Máscara mortuoria de Kharnut" id="912d-832f-28ff-7b84" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Yelmo. El portador causa Terror.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Broche del gran desierto" id="9beb-b649-e830-5911" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b76c-231e-a5c1-e68d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="896b-1c66-6985-b167" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Broche del gran desierto" id="98c7-e0ed-36b8-c01e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puedes declarar que usas el Broche del gran desierto cuando el oponente lance exitosamente un hechizo, pero antes de efectuar la tirada para dispersar. Dispersa automáticamente el hechizo, no es necesario que lances dados. Ten en cuenta que no funciona contra hechizos lanzados con Fuerza irresistible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brazaletes del sol" id="f8dd-5be3-8ceb-abfc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ac21-55f0-f5a4-2cd9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="128f-6888-69d8-548a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brazaletes del sol" id="590c-75e4-3b32-68dd" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Una miniatura en contacto peana con peana con el portador pierde un Ataque (hasta un mínimo de 1) .</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Balanza de Phakth" id="03ba-356e-8bec-54cb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eca1-8794-f537-61b7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="cabb-496a-c526-e2ad" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Balanza de Phakth" id="11c5-e24c-563a-a024" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel 4. Contiene un hechizo de Daño directo con un alcance de 18” que toma como objetivo a una única miniatura enemiga (puede seleccionar a un personaje dentro de la unidad). La miniatura afectada tira 1D6 y suma su valor de Liderazgo y el portador hace lo mismo. Si la miniatura afectada iguala o supera la tirada del portador no pasa nada pero si la tirada es inferior la miniatura afectada sufrirá tantas heridas sin tirada de salvación por armadura por cada punto de diferencia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Nehekhara" id="60c1-20bf-4938-591c" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="345a-e3f4-0378-fcba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="a276-74ea-627d-ab51" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Amuleto de Pha-Stah" id="9e83-32df-9929-1564" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="98c1-9f11-783d-2a36" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4ce3-6fd3-6013-fe8e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de Pha-Stah" id="d8d4-ab22-07e5-449c" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cualquier Talismán, Objeto hechizado o Artefacto arcano que porte cualquier miniatura (amiga o enemiga) en contacto peana con peana con el portador deja de funcionar y se considera un objeto mundano de su mismo tipo (tan sólo mientras permanezcan en contacto peana con peana). El portador no puede llevar ningún Artefacto arcano u Objeto hechizado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pectoral de Shapesh" id="91cf-ebc3-1cd6-8a31" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e2e0-aa30-8ee9-89e3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a01d-0ac6-0a2e-d0a4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pectoral de Shapesh" id="77b5-515a-52a5-7365" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cada vez que el portador fuese a sufrir una herida (tras las tiradas de salvación y Regeneración pertinentes), tira 1D6: con un resultado de 1-3, la herida se asigna al personaje de manera habitual. Con un resultado de 4+, la herida se asigna en su lugar a una miniatura amiga de tu elección a 8” o menos del portador. Ten en cuenta que una herida reasignada no puede salvarse o evitarse de ninguna manera. Si no hay otras miniaturas amigas a 8” o menos del portador, el Pectoral de Shapesh no tiene efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello de invocación de Djedra" id="3bdd-c95f-423b-6a70" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="806e-1de6-05bb-b1cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b366-c7b8-f056-8a5e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sello de invocación de Djedra" id="526f-3649-2109-1da3" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Al inicio de cada una de tus fases de magia, elige una unidad amiga a 12” o menos del portador: dicha unidad restaura inmediatamente tantas heridas como se indica en su regla especial No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes. Voto del Grial" id="e500-6780-f29e-2a28" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="2195-d85b-016e-5f2c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="f54e-5528-4a80-2e91" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Virtud del santuario" id="3233-fc63-54ec-60ad" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d6e7-6e16-a775-2fce" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4b6f-6d53-e2f4-64ee" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia a la magia (2)" id="59b8-c11a-ed90-8bee" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
            <infoLink name="Tozudez" id="4d09-8419-35a2-5b28" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Virtud del santuario" id="fc92-9fe4-bde0-8b6e" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje obtiene las reglas especiales Tozudez y Resistencia mágica (2) y no puede llevar montura de ningún tipo. Debe unirse a una unidad de Guardianes del santuario del Grial y no podrá abandonarla. Una miniatura con esta Virtud no podrá ser ni General ni Portaestandarte de batalla del ejercito.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes. Voto del ermitaño" id="7dc7-e462-f4aa-166e" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e872-cc92-03bb-06bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="5b79-b708-24aa-2449" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e79c-2ede-b2ed-c591" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <selectionEntries>
        <selectionEntry name="Virtud del ermitaño" id="d9c6-b640-a950-af5b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a954-dfae-9aa6-8766" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8065-5552-ccdf-036a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Voto del ermitaño" id="5cc7-2876-e860-fb59" hidden="false" targetId="8dfd-9c9f-f47c-66e7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Virtud del ermitaño" id="dba5-c631-3dde-979f" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">Si incluyes una unidad de Caballeros ermitaños, puedes incluir un único Paladín con la Virtud del ermitaño. Este personaje sustituirá su Voto de caballería por el Voto del ermitaño (definido arriba, en la unidad de Caballeros ermitaños) y no podrá ir montado. Deberá unirse a la unidad de Caballeros ermitaños y no podrá ser el General ni el Portaestandarte de batalla del 
ejército. Además, tanto el personaje como la unidad de Caballeros ermitaños obtienen la regla especial Odio (Ejércitos de la 
Destrucción).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Odio (ejércitos de la destrucción)" id="4e9b-d430-2a97-bacb" hidden="false">
              <description>Una miniatura que Odie podrá repetir los resultados de 1 obtenidos en sus tiradas para impactar en combate cuerpo a cuerpo contra aquellos a quienes odie.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes. Voto de la busqueda" id="7e72-77e4-e4cf-da99" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="1693-b76a-6df8-3146" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="2026-343f-b1f7-f1eb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Virtud de la venganza" id="a060-c395-c2ee-8068" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="634b-ac09-d8e9-9c84" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="89f6-b416-656d-1487" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la venganza" id="8b91-771d-0b09-4efa" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje debe unirse a una unidad de Caballeros errantes y no podrá abandonarla. Al inicio de la batalla, tras el despliegue, selecciona una unidad enemiga: tanto el personaje como la unidad de Caballeros errantes en la que se encuentre podrán repetir sus tiradas para impactar fallidas contra la unidad seleccionada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la audacia" id="0dda-fd8b-d049-024e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a98f-7aef-c196-bd11" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8491-d688-f8ff-af96" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la audacia" id="c678-110e-6d90-764c" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje puede repetir sus tiradas para impactar con Arma a dos manos. Adicionalmente, el turno en el que realice una carga exitosa no aplicará la regla especial Lenta de su Arma a dos manos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Bretonia. Caballeros noveles" id="7df2-75e6-ec07-5a66" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f9a3-3189-9b79-95ef" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="cf53-3035-1812-97e4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte de los caballeros noveles" id="abcf-8cb6-ff6f-ba78" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="8149-9807-cd70-e53d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1c45-7dfa-d9ff-6182" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Carga devastadora" id="909a-060e-1404-a1fc" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de los caballeros noveles" id="bf1d-abfb-5789-a5c6" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Caballeros noveles. Las miniaturas de la unidad obtienen la regla especial Carga devastadora, aunque deberán realizar los chequeos de Liderazgo causados por su regla Impetuosos tirando 3D6 y descartando el resultado más bajo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes. Voto del caballero" id="de13-dadd-4357-1610" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="dc1b-4183-b752-7037" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Virtud del ideal" id="9ebe-d850-af84-cd37" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1b0c-2f8f-c301-1c0b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7f4e-798d-7e35-9153" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud del ideal" id="c304-64ea-f374-6ebe" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje obtiene un bonificador de +1 en sus perfiles de atributos de HA, F, I, A y L. No puede unirse a unidades. Si muere o huye del campo de batalla, el enemigo obtendrá 100 puntos de victoria adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la empatía" id="bfb1-1e0d-d3d8-768a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5487-ed2b-5cfe-79c4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cc0d-9ec8-238d-49bc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la empatía" id="04a6-d5e7-69d1-2607" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje no podrá ser General ni Portaestandarte de batalla del ejercito. El personaje no podrá adquirir ninguna montura, perderá la regla especial Caballero (pero no el Favor de la Dama) y obtendrá un +1 a su atributo de Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Bretonia. Arma de mano" id="b564-eb8e-12eb-dea4" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5590-9686-e6a9-f16c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="dcc6-5f42-4816-4bc0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Filo heróico" id="8b3e-1d97-ac7d-ed3e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dd80-f446-0048-bca0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3037-6dd5-d815-3bb4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="7e94-4ae7-93ea-49c6" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Heridas múltiples (2)" id="ca5a-b685-1031-8804" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Filo heróico" id="e909-9e01-bd63-5d87" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos con este arma se resuelven con +1 a la Fuerza. Además, contra miniaturas de un Ejército de la Destrucción, los impactos con este arma se resuelven con la regla especial Heridas múltiples (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
