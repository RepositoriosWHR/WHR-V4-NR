            <profile name="Virtud del valor" id="69c4-1004-00a7-4e24" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">Cuando el personaje ataque en combate cuerpo a cuerpo a un enemigo con un valor de Fuerza superior al suyo, puede repetir todas sus tiradas fallidas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la disciplina" id="4ebe-2b68-acb8-a671" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b1ff-5adc-cf8d-bc0d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0301-0c0d-3ddc-862e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la disciplina" id="7d4a-61ff-f694-a851" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">Un solo uso. Al inicio de cualquier turno bretoniano, si el personaje no está trabado en combate, puede tratar de superar un chequeo de Liderazgo. Si lo supera, él y su unidad podrán realizar una maniobra de reformar de forma gratuita inmediatamente. No puede reorganizar filas ni columnas ni cambiar de formación. Sin embargo, si falla, no podrá mover ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del estoicismo" id="dbac-2638-3ffd-d34c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9745-3790-a70f-04e8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
