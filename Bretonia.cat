              </infoLinks>
              <profiles>
                <profile name="Armadura del señor del mar" id="ff0f-0251-aafc-bf61" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Otorga a su portador la regla especial Regeneración (5+) e inmunidad a la regla especial Poder de penetración. Además, el portador y su unidad obtendrán la regla especial Cruzar (Elementos acuáticos).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Cruzar (Elementos acuáticos)" id="5895-9710-8bfa-1367" hidden="false"/>
              </rules>
            </selectionEntry>
