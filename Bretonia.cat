    <selectionEntryGroup name="Estandartes mágicos. Nehekhara" id="9564-2d3f-47c1-66bd" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e192-983a-014c-f071" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
        <constraint id="4a25-c228-a1d4-c14d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pabellón del ojo sagrado" id="bdcc-ff26-589a-aaac" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="4734-a1e4-d686-82fa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="583e-1418-edb2-88a2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pabellón del ojo sagrado" id="d266-338b-3699-4f05" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad en la que se encuentra (incluyendo las monturas) obtienen un bonificador de +1 en sus tiradas para impactar en la primera ronda de cada combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de los espejismos" id="e5fc-39b7-77af-5a24" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="453d-a511-eff6-5a19" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8eac-43e6-864b-321b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de los espejismos" id="4115-cacc-4dc3-0a7a" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las tiradas para impactar exitosas contra la unidad durante la fase de disparo enemiga deberán repetirse; los efectos de Tormenta de proyectiles deberán dividir a la mitad el número de impactos causados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Icono de Rakaph" id="2ddb-c8cb-9fc7-792f" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="c1cd-6370-172b-e480" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d416-f18d-17ec-2e12" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Icono de Rakaph" id="0be7-4648-e6b7-2dce" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. La unidad que porte el estandarte podrá, al inicio de cualquiera de tus turnos, reorganizarse de forma gratuita y sin efectuar ningún chequeo para ello. Esta reorganización se realiza antes de declarar cargas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las palabras malditas" id="92d1-9430-0515-ba73" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="5176-22c6-fc37-d4f5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a088-555b-a47b-dae1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las palabras malditas" id="4f3e-81db-7ba5-765e" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los chequeos de Miedo provocados por la unidad se efectuarán con 3D6 y descartando el resultado más bajo (este efecto se anula con la regla especial Sangre fría).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las legiones de Nehekhara" id="6cc3-edf4-b327-d730" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="11eb-aa8d-437b-cab4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cdce-75db-bd47-b021" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las legiones de Nehekhara" id="893c-e4ca-8562-6632" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Cada vez que la unidad que porta el estandarte restaure miniaturas por un efecto de invocación, tira dos veces los dados y elige el resultado mayor.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la legión eterna" id="47e8-c4b8-3996-31da" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2481-b3ff-7ccd-1b18" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6b66-398f-d25b-ed49" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la legión eterna" id="5292-0bc1-3ca9-c9d9" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Cada vez que el portador o su unidad causen una herida como resultado de un Golpe letal exitoso, la unidad recupera una única herida (es un efecto de invocación).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Nehekhara" id="334f-7ad0-d4d7-b5f9" collective="false" hidden="false" import="true">
