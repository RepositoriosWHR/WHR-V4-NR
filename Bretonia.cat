              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Sólo Caballero. El portador obtiene la regla especial Inmune a veneno. Además, será inmune a los efectos de las reglas especiales Golpe letal y Heridas múltiples.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gran yelmo de Gromril" id="c663-39da-066a-b52d" collective="false" hidden="false" import="true" type="upgrade">
