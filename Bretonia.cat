    <selectionEntryGroup name="Artefactos arcanos. Virtud del Cruzado" id="50aa-8a15-d065-8a1e" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="517c-4937-8c15-cb90" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Báculo de la maestría" id="c9fd-aa0a-784c-ce31" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bfae-79b8-16e1-670c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d6b7-8067-09ff-079a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo de la maestría" id="a4e1-975c-75d7-25fe" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador siempre Canaliza dados de Energía o Dispersión con un resultado de 2+, sin tener en cuenta otros modificadores.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El Báculo de Usirian" id="c9e1-9fd0-15b3-b28d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0dd7-271b-d3ec-661c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="f265-547b-5ed6-a26b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El Báculo de Usirian" id="373e-7eb4-09a3-1113" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de Daño directo. Traza una línea recta de 18” desde el lanzador. Cualquier miniatura bajo esa línea sufrirá un impacto de Fuerza 6 con la regla especial Golpe letal. Cualquier unidad que sufra al menos una baja como resultado de este hechizo deberá efectuar de inmediato un chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cánope de Enkhil" id="057f-876a-4c51-1d80" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c3b7-8791-77e3-a061" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="cb05-5a47-fabe-b17e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cánope de Enkhil" id="4254-22bf-f677-697f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de Maldición que afecta a todos los hechizos enemigos que Permanecen en efecto o Permanecen un turno en el campo de batalla. Si el hechizo se resuelve exitosamente, todos esos hechizos quedan inmediatamente dispersados y su efecto cesa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vaso hierático" id="3d1e-db9f-0bb7-0abc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d8e9-f640-4fa0-cce4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="846a-3f56-e579-0955" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vaso hierático" id="fc48-ef3d-d680-19ce" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El personaje puede utilizar el Vaso hierático durante cualquiera de sus fases de magia para lanzar uno de sus hechizos sin invertir ningún dado de Energía. El hechizo será lanzado a su nivel básico de dificultad y podrá ser dispersado normalmente. No es posible lanzar la versión potenciada de un hechizo con este objeto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Placa dorada de la jungla" id="a1a7-6000-a4eb-663f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="faee-d0da-2f77-b540" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="2292-a611-e430-7ceb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Placa dorada de la jungla" id="bdf9-3448-a944-538f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador lance un hechizo, la placa generará un dado de energía adicional para ese hechizo (no cuenta para el límite habitual de dados del hechicero).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tablillas del Conocimiento" id="78e1-b8e9-388c-543c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dd13-60e8-90f7-4230" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="41a2-448e-1eb2-e0cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tablillas del Conocimiento" id="4a2e-a41b-8ff0-49ba" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene la regla especial Señor del Conocimiento (Nehekhara).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes. Voto del caballero No General, No Porta" id="e165-09b7-7863-cbcb" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Virtud del penitente" id="2e05-821c-e5d9-08ca" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d448-2e8b-cd70-182e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
