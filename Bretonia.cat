              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje y la unidad en la que se encuentre podrán añadir 1D3” adicionales a cualquier movimiento de carga que efectúen.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la justa" id="df3a-b80c-cf8b-76e4" collective="false" hidden="false" import="true" type="upgrade">
