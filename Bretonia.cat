              <profiles>
                <profile name="Virtud del penitente" id="143d-e11b-ba90-c28b" hidden="false" typeId="4d8f-04d7-ddc3-0402" typeName="Virtudes">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje no podrá ser General ni Portaestandarte de batalla del ejercito. El personaje obtiene la regla especial Indesmoralizable y su tirada de salvación especial obtenida por la Favor de la Dama mejora hasta 4+ pero no podrá equiparse con objetos mágicos de ningún tipo y sólo podrá montar en Corcel bretoniano.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
