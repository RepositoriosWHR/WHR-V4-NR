          <infoLinks>
            <infoLink name="Apabullar" id="909e-f7bf-5b19-495f" hidden="false" targetId="205f-210b-5422-1e61" type="rule"/>
            <infoLink name="Objeto legendario" id="3991-9731-162a-a2fe" hidden="false" targetId="1eb5-f5b5-0dbe-0f2e" type="profile"/>
            <infoLink name="Carga devastadora" id="1d27-2850-fc99-584b" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="046a-1c36-705e-1c0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Pabellón de guerra de Gilles el Bretón" id="d11a-c7c1-d88a-dcb1" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto legendario. Cualquier unidad enemiga que sufra al menos una baja por el portador o su unidad quedará Apabullada. Además, cualquier miniatura con la regla Caballero a 12” o menos del portador al inicio de tu fase de movimiento que no haya perdido el Favor de la Dama obtendrá la regla Carga devastadora.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pabellón de la dama" id="b78a-61f6-c2f5-b62a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="58a3-67bc-3bc8-340e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5737-c048-5e3f-e4cc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="90"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="9ec2-4c02-1c80-321d" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Resistencia a la magia (3)" id="9274-9c0c-5c9c-a85c" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pabellón de la dama" id="2832-6d45-54aa-5086" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Otorga al portador y su unidad la regla especial Resistencia mágica (3) y mejora la tirada de salvación especial conferida por la regla especial Favor de la Dama a 4+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
