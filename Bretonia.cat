          <modifiers>
            <modifier field="name" type="append" value="(Skavens y No muertos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Plegarias" id="234b-bb07-19b6-b9bf" hidden="false">
          <description>Bagrian conoce todos los Ritos de Taal y puede lanzar dos de ellos por fase de magia propia con nivel de energía 6.</description>
        </rule>
        <rule name="Magia Bagrian, sumo sacerdote de Taal, abad de la Maisontaal" id="813a-8d2e-b821-20e3" hidden="false">
          <description>Bagrian es un hechicero de nivel 2 que deberá elegir sus hechizos del Saber de las Bestias.</description>
        </rule>
        <rule name="Sirviente de la naturaleza" id="5526-c59b-77cc-b8e5" hidden="false">
          <description>Los ataques en combate cuerpo a cuerpo realizados por miniaturas del tipo Bestia, Bestia monstruosa, Monstruo o Enjambre contra una miniatura con esta regla especial deberán aplicar un penalizador de -1 a sus tiradas para impactar. Esta regla especial no causará efecto alguno contra miniaturas con las reglas especiales Demonio o No Muerto.</description>
        </rule>
        <rule name="Bendición de Taal" id="200b-25a4-95ea-5db5" hidden="false">
          <description>Bagrian obtiene un bonificador de +1 a sus atributos de F, R, H y A (incluido ya en su perfil).</description>
        </rule>
        <rule name="Fuerza de la naturaleza" id="b670-8483-bdb4-f43c" hidden="false">
          <description>Bagrian y la unidad en la que se encuentre obtendrán la Regla Especial Regeneración (5+).</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="0bd3-b08b-522c-dc31" collective="false" hidden="false" import="true" type="upgrade">
