              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Caballero. Un solo uso. Las monturas del portador y de la unidad de la que forme parte tendrán un +1 a impactar el turno en el que realizaron una carga exitosa.</characteristic>
              </characteristics>
            </profile>
