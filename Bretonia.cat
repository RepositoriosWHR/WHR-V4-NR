        <infoLink name="Hostigadores" id="7873-3d7e-a911-7bc3" hidden="false" targetId="999c-d422-6c91-46dd" type="rule"/>
        <infoLink name="Vanguardia" id="d7ee-6300-5e83-948d" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
