              </infoLinks>
              <profiles>
                <profile name="Báculo de la lechuza" id="5a03-6130-f7a1-bded" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los Ritos de Taal y los hechizos de los tipos Proyectil mágico, Potenciación y Maldición que lance Bagrian verán aumentado su alcance en 6”. Si el hechizo disponía de radio, este no se verá afectado por este efecto.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Colgante ámbar" id="640e-3d2b-b1b1-be37" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="769d-9230-b517-bbd5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="5500-28fd-3e63-58a2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Colgante ámbar" id="4fed-5f47-e7e8-d1f7" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un sólo uso. Al inicio de cualquier fase podrás elegir utilizar el poder del colgante para hacer que Bagrian recupere todas las heridas sufridas durante la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
