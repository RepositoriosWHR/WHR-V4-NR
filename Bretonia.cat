            <profile name="Coraza de la fortuna" id="6e49-88ba-882e-4389" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Sólo Caballero. El portador podrá repetir todos los resultados de 1 que obtenga en sus tiradas de impactar, herir y salvación por armadura y especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura de la devoción" id="efa2-bcb4-c82f-793d" collective="false" hidden="false" import="true" type="upgrade">
