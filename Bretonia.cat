          <profiles>
            <profile name="Genevieve" id="32ea-b596-b6e3-3847" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">6</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">6</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">6</characteristic>
