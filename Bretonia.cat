      <rules>
        <rule name="Ofrendas" id="ce4e-0d01-32b8-39e7" hidden="false">
          <description>El caballero de Malmont puede usar La Espada de la Virtud y la Sangredragón a pesar de la Virtud del Penintente.</description>
        </rule>
        <rule name="Mítico" id="a167-e101-0731-c599" hidden="false">
          <description>No puedes incluir Caballeros ermitaños y al Caballero ermitaño de Malmont en el mismo ejercito, pues la orden se creó a raíz de su muerte.</description>
        </rule>
      </rules>
