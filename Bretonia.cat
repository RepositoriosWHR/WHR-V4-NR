    <selectionEntry name="[E] - El caballero de la lanza invencible" id="bf27-d2aa-ade3-951d" collective="false" hidden="false" import="true" type="unit">
      <constraints>
        <constraint id="7c3b-9728-c66e-cb5a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
