      </infoLinks>
      <rules>
        <rule name="Sirvienta de la dama" id="005c-45f0-ef15-c957" hidden="false">
          <description>Si un personaje con esta regla especial se incluye dentro de una unidad con la regla Caballero, puede situarse en el centro de la segunda fila pese a ser personaje (mientras haya una segunda fila) y cualquier miniatura con la regla Caballero puede aceptar un Desafío en su lugar como si fuera un personaje, empezando por los personajes Caballeros de la unidad (no tiene efecto contra habilidades que permitan escoger el objetivo de un Desafío).</description>
        </rule>
        <rule name="Magia profetisa de la dama" id="3750-fe33-3b9e-28c4" hidden="false">
          <description>Nivel de magia 3, puede aumentarse a 4 por +55 puntos. Puede elegir sus hechizos de uno y sólo uno de los siguientes Saberes: Cielos, Vida o Bestias.</description>
        </rule>
      </rules>
