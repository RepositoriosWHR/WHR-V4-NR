          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Inseparables" id="2983-b494-9189-e06e" hidden="false">
          <description>En caso de formar parte de una unidad, Odo y Sulimán deberán estar en contacto peana con peana (no pueden estar en unidades diferentes). Si no se encuentran unidos a una unidad, deberán situarse en contacto peana con peana en todo momento formando una unidad.</description>
        </rule>
        <rule name="Maestro espadachín (sólo Sulimán)" id="5cdb-f357-36bd-7320" hidden="false">
          <description>El Arma a dos manos de Sulimán no tiene la regla especial Lenta.</description>
        </rule>
        <rule name="Cruzado" id="bd81-ed9f-66ae-733e" hidden="false">
          <description>Todas las miniaturas del ejército de Nehekhara, La Tierra Bendita y Rasetra ganarán la regla Odio contra Odo.</description>
        </rule>
      </rules>
