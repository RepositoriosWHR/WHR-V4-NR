    <selectionEntry name="[E] - Genevieve Sandrine de Pointe du Lac Diedonné" id="9bf8-0152-007f-c451" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="1dcf-f7e5-d562-d09d" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
