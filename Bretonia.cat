          </infoLinks>
          <profiles>
            <profile name="Estandarte de los valerosos" id="859c-cb52-3526-d831" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Sangre fría.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del crepúsculo" id="e415-88e1-88a7-2d24" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="a290-e2d0-775c-89b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e5ab-bf92-a660-dec5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Cruzar (todos los terrenos)" id="949f-c6df-327a-9b2b" hidden="false" targetId="747f-5236-492e-b132" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="excepto Edificios y Elementos intransitables)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del crepúsculo" id="fc03-a0fd-7b6f-dade" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Cruzar (todo tipo de terreno excepto Edificios y Elementos intransitables). Esto afecta también a las monturas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Chalons" id="10a4-6b3c-850a-a99d" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="16d7-47a1-951a-6c86" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="049f-8f85-1031-10d6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de Chalons" id="e357-3577-55b6-da03" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El enemigo no podrá Aguantar y disparar ni Disparar y huir como reacción a una carga efectuada por una unidad que porte este estandarte.</characteristic>
              </characteristics>
