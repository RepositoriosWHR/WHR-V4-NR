              <characteristics>
                <characteristic name="Reglas especiales" typeId="6a83-733d-472a-7834">El personaje obtiene la regla especial Orgullo marcial y obtiene un bonificador de +1 a sus tiradas para impactar 
durante los Desafíos en los que participe.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
