    <selectionEntry name="[E] - Kaldor el cruel, Heredero oscura de la casa Coriath, Descendiente caído de los paladines de Isha" id="fe5d-2665-9db1-0dbc" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
