          </infoLinks>
          <profiles>
            <profile name="Estandarte de Naggarond" id="077d-91f9-a27e-27e8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">No puede incluirse en unidades que posean la regla especial Khainitas. Solo miniaturas de infantería. El portador y su unidad obtienen una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
