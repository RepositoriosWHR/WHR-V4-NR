            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="e186-2f73-43cb-8020" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Magia Oscura)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Libro de Furion" id="0769-f5a3-db13-772c" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga al portador la regla especial Señor del Conocimiento (Magia Oscura). Además, los hechizos obtenidos gracias a este objeto, no pueden ser olvidados ni destruidos por ningún efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo negro" id="3599-dd3a-120b-505e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5ab0-4208-b84c-0c7c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3412-25dd-848c-0fc7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo negro" id="b53d-50c8-3278-dabf" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador podrá utilizar cualquier número de dados de energía para lanzar sus hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Capa de estrella negra" id="d0b9-052f-09c5-cf42" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ae93-0c84-bc86-7181" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1694-d2bd-e048-e051" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Capa de estrella negra" id="4a3a-e7be-4efb-0304" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">La hechicera obtendrá un dado de energía adicional en cada una de sus Fases de Magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Daga del sacrificio" id="6ff7-7f0c-8638-a4ba" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3899-9b7f-5016-ee56" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bf86-9607-81e3-e39c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Daga del sacrificio" id="b90e-5bea-6595-0c7d" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede utilizarla tras haber realizado la tirada de lanzamiento de cualquier hechizo. Podrá sacrificar a una de las miniaturas de su unidad para tirar un Dado de energía adicional en ese hechizo. La miniatura sacrificada deberá retirarse inmediatamente como baja de forma irremediable. Esto deberá realizarse antes de que tenga lugar cualquier posible intento de dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Piedra del alma" id="a044-b26d-04ab-db2b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b940-a264-98d7-fbc9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4ce2-eae3-caa7-21b4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Piedra del alma" id="285d-59dd-508f-9648" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">La hechicera ignorará los efectos de la primera Disfunción mágica que sufra durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Familiar foco" id="365b-f383-dfd0-2b0e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1259-175d-3031-79ea" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1fef-d65e-f72c-7a4a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Familiar foco" id="3e48-445b-1901-23de" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada una de tus fases de magia puedes elegir colocar un marcador a una distancia de 8” o menos de la hechicera; el marcador permanece hasta el final de esa fase de magia. La hechicera podrá lanzar sus hechizos como si se encontrase en el lugar señalado por el marcador a efectos de visión y alcance, incluso si ella o su unidad se encuentran trabados en combate cuerpo a cuerpo. La hechicera tendrá un ángulo de visión de 360º mientras lance sus hechizos desde el marcador. Si la hechicera sufre una disfunción la sufre desde su propia posición y no desde la del Familiar Foco.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema del rencor" id="21f1-84e9-e15a-49ca" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4890-cc38-8e17-d7a2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1507-0589-44cf-d1cb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema del rencor" id="4ec0-0c1c-a985-b473" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Siempre que el portador sufra una disfunción, los hechiceros enemigos a 12” o menos sufren impacto de F6. Los hechiceros enemigos pueden descartar un dado de dispersión para anular las Heridas provocadas por la Gema.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Elfos oscuros" id="deb2-612b-de4e-dc68" collective="false" hidden="false" import="true">
      <constraints>
