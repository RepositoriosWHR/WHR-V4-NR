                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje tiene la regla especial Golpe letal en sus ataques en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
