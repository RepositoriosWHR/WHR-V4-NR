        <infoLink name="Asesino" id="f08d-9471-cde5-0e59" hidden="false" targetId="3be0-981c-4e35-8739" type="rule"/>
        <infoLink name="Khainitas" id="c86f-67cd-e71a-047a" hidden="false" targetId="57ef-0601-26a7-fdac" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Puede unirse a unidades no Khainitas)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
