                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="Furia asesina" id="b5bc-8885-ada7-fe7a" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
                    <infoLink name="Demonio" id="cb8f-a40a-9c83-8ead" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Comunión demoníaca" id="7d32-7a0c-f343-ec54" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El Vauvalka obtendrá las Reglas Especiales Demonio y Furia Asesina y un bonificador de +1 a su valor de Fuerza.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
