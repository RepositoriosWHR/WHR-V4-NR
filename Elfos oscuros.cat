          <modifiers>
            <modifier field="name" type="append" value="(Altos elfos)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Asesino" id="3470-6679-a935-4bfc" hidden="false" targetId="3be0-981c-4e35-8739" type="rule"/>
        <infoLink name="Khainitas" id="d0d6-0556-5808-311b" hidden="false" targetId="57ef-0601-26a7-fdac" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Asesino, no Líder" id="5367-9af3-a2c1-371b" hidden="false">
          <description>Ninguna unidad de los Elfos oscuros puede beneficiarse del liderazgo de un Asesino.</description>
        </rule>
        <rule name="Arrogancia" id="4769-964d-88c6-3328" hidden="false">
          <description>Caldath tiene la regla especial Orgullo marcial. Aplica un bonificador de +1 a impactar en combate cuerpo a cuerpo durante un Desafío.</description>
        </rule>
        <rule name="Despliegue oculto" id="fb83-a14a-fbfc-3ef5" hidden="false">
          <description>Pese a ser Khainita, Caldath puede unirse a unidades que no sean Khainitas. Puede elegir empezar la partida oculto en una unidad de entre las siguientes: Lanceros druchii, Espadachines druchii, Ballesteros druchii, Guardia de la ciudad, Elfas brujas, Corsarios del Arca Negra, Incursores corsarios, Verdugos, Guardia negra y Sombras. Anota en la lista de ejército en qué unidad va oculto Caldath.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="5650-1f67-92bd-992b" collective="false" hidden="false" import="true" type="upgrade">
