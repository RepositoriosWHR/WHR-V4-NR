              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje (y la unidad en la que se encuentre) pueden repetir sus tiradas fallidas de carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bendición de la sangre" id="27e8-2ac9-6b35-3272" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0c45-48ef-395d-bda1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="9b3c-7721-0fcb-399b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
