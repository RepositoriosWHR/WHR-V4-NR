          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="42f0-95d7-b065-09f5" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Maestro en toxinas" id="2b00-0587-a2de-f568" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">Otorga al personaje la regla especial Ataques envenenados (si ya dispone de esta regla especial, tendrán éxito también con resultados de 5+). Adicionalmente, al elaborar la lista de ejército, una unidad de Lanceros druchii, Ballesteros druchii, Jinetes oscuros o Guardia de la ciudad de tu ejército podrá tener Ataques envenenados (+2 puntos por miniatura); o una unidad de Espadachines druchii que tenga la regla especial Ataques envenenados, estos ataques tendrán éxito también con resultados de 5+.</characteristic>
              </characteristics>
            </profile>
