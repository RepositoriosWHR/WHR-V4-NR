        <selectionEntry name="Espadachin consumado" id="5753-842c-a74a-f7cf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5467-18d2-f080-b502" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="18bf-3543-4c80-d734" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
