                <infoLink name="Inmune a la psicología" id="598b-f44a-c02f-8971" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink name="Resistencia mágica (1)" id="ffec-193a-c3f8-8633" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink name="Odio (todos los enemigos)" id="9758-ea89-6a5d-f2af" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Fanático del Rey Brujo" id="a6cc-2f2c-36d9-141a" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje estará equipado con Armadura oscura de Naggarond y obtiene las reglas especiales Inmune a psicología, Resistencia mágica (1) y Odio (¡todos los enemigos!). Sin embargo, el personaje no puede tener ninguna montura y tan sólo puede unirse a unidades de Guardia Negra.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Equipo" id="9c63-fe71-2a8d-b1f2" collective="false" hidden="false" import="true" type="upgrade">
