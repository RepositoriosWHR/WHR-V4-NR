                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Arma de mano" id="c103-f76a-4aef-033e" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Destructora" id="cfc1-ece8-739a-26d4" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Si Malekith realiza uno o más impactos con esta arma sobre una miniatura, determina al azar uno de los objetos mágicos de la miniatura impactada. Ese objeto quedará destruido y pasará a considerarse un objeto mundano de su mismo tipo (sólo puede anular un único objeto por cada fase de combate aunque impacte a varias miniaturas). Además, por cada herida que sufra un hechicero enemigo a causa de los ataques de Destructora, éste perderá un nivel de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura de medianoche" id="fd93-42a7-b473-8269" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="edbc-f2ce-3967-9573" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="c181-8dc3-37f8-6f22" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Armadura pesada" id="d9da-6e42-7b42-0c86" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Armadura de medianoche" id="be14-ad8e-a478-4a32" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Otorga a Malekith un bonificador de +1 a sus atributos de Fuerza, Resistencia y Heridas (ya incluidas en el perfil como +1), le hace inmune a Golpe letal heroico y le proporciona la regla especial Aura demoníaca (2+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corona de hierro" id="00b2-edc0-4d97-ba1f" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="eeb5-42fe-1a53-de5f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0a2a-bbec-0ee4-58f4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Corona de hierro" id="4d47-ee59-2e5d-c9fb" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">La Corona de Hierro proporciona a Malekith una tirada de salvación especial de 4+. además, otorga a Malekith un dado de energía adicional durante sus fases de magia y un dado adicional de dispersión durante las fases del oponente. Sólo Malekith podrá utilizar estos dados adicionales.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Escudo Antihechizos de Naggaroth" id="de2e-f1dd-68ad-ac7a" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="16ef-e5a1-35c3-91d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="1a5f-3e3f-4829-882f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Escudo" id="304d-4703-b8dc-55b6" hidden="false" targetId="c028-354e-9169-7463" type="profile"/>
                <infoLink name="Resistencia mágica (2)" id="83e0-4f55-6290-cd97" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Escudo antihechizos de Naggaroth" id="ab7d-a774-e4d5-5f5e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Otorga a Malekith la regla especial Resistencia mágica (2). Si un hechizo lanzado contra Malekith es dispersado con éxito, el lanzador del hechizo sufrirá 1D3 impactos de F5 con la regla especial Ataques mágicos. Si el hechizo fue lanzado por un objeto portahechizos y es dispersado con éxito, su portador sufrirá un impacto de F6 con la regla especial Ataques mágicos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
