          <rules>
            <rule name="Masa de tentáculos" id="c03f-24cf-f79e-deb9" hidden="false">
              <description>Todos los disparos dirigidos contra un Caribdis tendrán un penalizador de -1 para impactar. Todos las miniaturas que ataquen en combate cuerpo a un Caribdis sufrirán un penalizador de -1 a su HA al atacarlo.</description>
            </rule>
            <rule name="Agarrón" id="2449-d945-9cf4-7959" hidden="false">
              <description>Un caribdis puede repetir sus tiradas para impactar fallidas contra miniaturas con potencia de unidad 2 o superior.</description>
            </rule>
            <rule name="Cuerpo gomoso" id="1aea-d0a2-0bcb-0b9a" hidden="false">
              <description>Un caribdis es inmune a los efectos de la regla especial Heridas múltiples.</description>
            </rule>
          </rules>
        </selectionEntry>
