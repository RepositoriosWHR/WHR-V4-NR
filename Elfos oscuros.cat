          <profiles>
            <profile name="Bendición de la sangre" id="b069-a9ee-b96b-d947" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje podrá repetir todos sus resultados de 1 en sus tiradas para impactar durante la primera ronda de cada combate cuerpo a cuerpo. Obtiene la regla especial Regeneración (6+) o +1 si ya la tenía.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Maestría bélica" id="023c-1edb-be06-ddb3" collective="false" hidden="false" import="true" type="upgrade">
