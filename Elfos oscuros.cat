              <infoLinks>
                <infoLink name="Arma emparejadas" id="0b5f-5729-ec4b-68fc" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Espadas de hierro negro de Ghrond" id="2488-a4b0-bed8-fce4" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas (Kouran efectúa con ellas un total de 5 Ataques). Kouran puede repetir sus tiradas para impactar fallidas en combate cuerpo a cuerpo. Los impactos con estas espadas se resuelven con un bonificador de +1F.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Muerte carmesí y Espadas de hierro negro de Ghrond" id="f1da-ade7-9213-c808" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7740-1a8f-b66c-75dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Alabarda" id="8687-8307-46c4-a82b" hidden="false" targetId="8dd0-8d9d-2436-cbf1" type="profile"/>
                <infoLink name="Arma emparejadas" id="4d5a-5cd4-edf0-84fd" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Muerte carmesí" id="d059-1cfd-284a-9fab" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Alabarda. Los ataques efectuados con esta alabarda obtendrán un bonificador adicional de +1 a la Fuerza de su usuario. Además, podrá repetir las tiradas para herir efectuadas contra miniaturas pertenecientes a un Ejército del 
Orden.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Espadas de hierro negro de Ghrond" id="2cb5-bab4-42f9-239e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas (Kouran efectúa con ellas un total de 5 Ataques). Kouran puede repetir sus tiradas para impactar fallidas en combate cuerpo a cuerpo. Los impactos con estas espadas se resuelven con un bonificador de +1F.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Muerte carmesí" id="aae2-2e8b-653e-888b" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="efb6-1cc9-0075-93bf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Alabarda" id="9169-a5ca-3bef-5bf8" hidden="false" targetId="8dd0-8d9d-2436-cbf1" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Muerte carmesí" id="5b1d-52e9-dc67-0c4d" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Alabarda. Los ataques efectuados con esta alabarda obtendrán un bonificador adicional de +1 a la Fuerza de su usuario. Además, podrá repetir las tiradas para herir efectuadas contra miniaturas pertenecientes a un Ejército del 
Orden.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="[E] - Malus Darkblade" id="63a5-d7b8-c2bb-ce11" collective="false" hidden="false" import="true" type="unit">
