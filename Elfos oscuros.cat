                <infoLink name="Esquivar (4+)" id="e07e-5ea6-ac91-5af2" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
                <infoLink name="Vanguardia" id="d570-d56d-f4c4-cb31" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Sombra solitaria" id="05f7-0da4-e3a7-9408" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">Korelei tiene las reglas especiales Esquivar (4+) y Veloz. Además, cualquier unidad que persiga a Korelei perderá la regla especial Veloz a efectos de dicha persecución. Adicionalmente, Korelei tiene Vanguardia, aunque su movimiento de Vanguardia debe ser siempre hacia el enemigo visible más cercano. Sin embargo, no puede unirse a unidades y no podrá ser la General del ejército. Esta senda es única y sólo Korelei la puede seguir.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
