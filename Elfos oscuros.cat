          <profiles>
            <profile name="Maquinador de estratagemas" id="c3ee-e54e-1aa7-617c" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">Tras desplegar, pero antes de determinar quién empieza a jugar, puedes redesplegar una de tus unidades. No puede ser elegida por Khainitas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tirano de Hag Graef" id="6a8c-e1d9-fca6-eb61" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3b50-d068-4fa6-35da" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e778-e54e-4b42-9999" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tirano de Hag Graef" id="1459-fa97-b5a5-d289" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje debe escoger como montura un gélido o un carro de gélidos. El carro de gélidos o el gélido que monte el personaje y todos los gélidos de una unidad a la que se haya unido superan automáticamente todos los chequeos de Estupidez que deban efectuar. No puede ser elegida por Khainitas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
