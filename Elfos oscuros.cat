          <constraints>
            <constraint id="be71-ab56-3db7-5232" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="d020-1f41-d65f-1f35" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Khainitas" id="e21d-3018-193d-7fe3" hidden="false" targetId="57ef-0601-26a7-fdac" type="rule"/>
            <infoLink name="Furia asesina" id="4584-962d-1bb2-df1e" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink name="Resistencia mágica (1)" id="18df-82cc-cdf4-9956" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
            <infoLink name="Golpe letal" id="8a3c-e476-d0db-4be3" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Señor de los verdugos" id="09b7-6db5-5216-6a7e" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje obtiene las reglas especiales Khainita, Furia asesina, Resistencia mágica (1) y Golpe letal. Tan sólo puede equiparse con un Arma a dos manos (mundana o mágica); no puede elegir otros tipos de arma. No puede elegir ninguna montura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Equipo" id="40e1-e1f1-5777-f163" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="038c-5de6-d7fb-6a36" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="9281-dce7-edd6-3ce7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
