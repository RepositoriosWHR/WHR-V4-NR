            <profile name="Espadachin consumado" id="8117-6dbf-e1bd-92ff" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje puede repetir todas sus tiradas fallidas para impactar en combate cuerpo a cuerpo, pero no puede elegir ninguna montura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fanático del Rey Brujo" id="30f9-f27e-0686-ba22" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="95c2-66bc-119e-cfea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="e7c9-1b29-a63e-2c6c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="32b8-8774-5569-7593" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Resistencia mágica (1)" id="ac85-727b-6988-838b" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
            <infoLink name="Odio (todos los enemigos)" id="8149-8681-f0ca-3641" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Fanático del Rey Brujo" id="3edc-135a-db29-8432" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje estará equipado con Armadura oscura de Naggarond y obtiene las reglas especiales Inmune a psicología, Resistencia mágica (1) y Odio (¡todos los enemigos!). Sin embargo, el personaje no puede tener ninguna montura y tan sólo puede unirse a unidades de Guardia Negra.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
