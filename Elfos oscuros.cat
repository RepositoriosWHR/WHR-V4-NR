            <profile name="Capa de Hag Graef" id="05cd-b879-22ee-b5fc" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Sólo personajes con la senda Capitán del Arca negra. Capa de dragón marino. Todas las tiradas para herir contra el portador fallarán si se obtiene un resultado de 1, 2 ó 3 en la tirada; esto no afecta a ataques sin valor de Fuerza o que hieran automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Reliquias. Elfos oscuros" id="ee7a-404f-ae6e-4ae2" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="a7f1-2c68-8b1a-b411" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="9148-1a0a-e72a-1323" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="El corazón de Khaine" id="afb0-7ddd-28b2-a270" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e6ac-4f98-1f64-a9f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d842-603c-0aed-ad9e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="c353-11f1-b12f-8ece" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Regeneración (5+)" id="0fa7-4757-7f82-a09f" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="El corazón de Khaine" id="50c9-952f-9d59-2996" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador la regla especial Regeneración (5+). Al final de cada ronda de combate en la que el portador cause al menos una herida, podrá restablecer una de las heridas perdidas con anterioridad durante la batalla. Adicionalmente, podrá realizar un ataque extra inmediatamente al recuperar la herida, justo antes de contar la resolución del combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colgante de Khaeleth" id="481b-a9d8-26e4-5347" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ff73-a94a-9117-14ab" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7c42-bf0f-1fa3-ae5c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="8137-4059-fe60-06a4" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Colgante de Khaeleth" id="60e1-9458-1c1d-bcb6" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador una tirada de salvación especial de 5+, la cual pasa a ser una tirada de salvación especial de 4+ contra los ataques de F5 y una tirada de salvación especial de 3+ contra los ataques de F6 o superior.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Elfos oscuros" id="44ae-5355-fec1-579a" collective="false" hidden="false" import="true">
