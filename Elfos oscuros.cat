    <selectionEntry name="[E] - Rakarth, señor de las bestias de Karond Kar" id="5ff1-7579-5c2e-24d2" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="aee5-fb2f-7635-bc57" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
