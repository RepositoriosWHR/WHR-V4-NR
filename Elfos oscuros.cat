            <profile name="Maestría bélica" id="ee70-c96f-8011-5ddd" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">Si el personaje combate con un arma de mano o dos armas de mano (tanto mundana como mágica) puede repetir sus tiradas fallidas para impactar en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Venenos" id="233d-41ec-0fda-f707" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f597-14f4-31ef-cc97" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Matahombres" id="58dc-8b1e-2645-4457" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6837-c5a9-de59-4c8c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
