              <profiles>
                <profile name="Servidor de Khaine" id="86b2-7902-1a6b-da75" hidden="false" typeId="b55e-8314-c538-d767" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="81af-de2c-e762-8dd1">El personaje obtiene las reglas especiales Khainita, Furia asesina y Resistencia mágica (1). Las hechiceras no pueden elegir esta senda.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sombra solitaria" id="d4b2-f179-3d73-95e4" collective="false" hidden="false" import="true" type="upgrade">
