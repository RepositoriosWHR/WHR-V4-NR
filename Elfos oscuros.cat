              </costs>
              <infoLinks>
                <infoLink name="Armadura oscura de Naggarond" id="1437-5dc6-e330-559f" hidden="false" targetId="5425-a70b-e311-09fc" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Armadura del dolor" id="07a4-bb64-2bae-d4cf" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura oscura de Naggarond. Proporciona a su portador una tirada de salvación por armadura de 1+. Las miniaturas enemigas que quieran atacar en cuerpo a cuerpo a Kouran deben realizar antes de atacar un chequeo de Resistencia; las miniaturas que lo fallen no podrán realizar ningún ataque durante esa fase de combate cuerpo a cuerpo y las que lo superen sufrirán un penalizador de -1 a su HA al atacarlo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
