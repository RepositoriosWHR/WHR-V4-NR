        <infoLink name="Resistencia mágica (2)" id="cfb8-4243-9b89-4864" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Excepto Saber de Slaanesh)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Ataques flamígeros" id="b454-6d4c-3fc2-ca48" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
