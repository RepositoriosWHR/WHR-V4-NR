    <selectionEntry name="Trono de la exsanguinación" id="54ef-2251-0252-4aa9" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="6901-9e3e-a368-1dd5" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
        <constraint id="7ae8-6a31-5503-2e79" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Carro" id="eec7-8366-d5ee-98d8" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink name="Terror" id="ffca-0f05-8f11-93e7" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Resistencia mágica (1)" id="7d49-b90e-2fdb-14f1" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
        <infoLink name="Odio" id="7452-1940-8cb7-3774" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Altos elfos)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Objetivo grande" id="eaf8-4626-86a0-4ece" hidden="false" targetId="71eb-6467-3a39-bdb6" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="7ae8-6a31-5503-2e79" type="set" value="2">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="7ae8-6a31-5503-2e79" type="set" value="3">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Potencia de unidad 5" id="f1e6-f334-18b7-8a33" hidden="false"/>
        <rule name="Tirado por" id="739a-e5f2-99f1-8fad" hidden="false">
          <description>El Trono de la Exsanguinación no tiene bestias que tiren de él, sino que se mueve mediante la magia.</description>
        </rule>
        <rule name="Altar de la desesperación" id="3009-4d9e-b315-29c7" hidden="false">
          <description>Tiene una tirada de salvación especial de 4+. Además, todas las unidades enemigas a 6” o menos del trono tendrán un penalizador de -1 a su Liderazgo.</description>
        </rule>
        <rule name="Trono drenador de sangre" id="02b5-2d93-9a31-d4dc" hidden="false">
          <description>En el Trono está instalado un Gran Espejo de la Exsanguinación. Se trata de un Objeto Portahechizos de Nivel de energía 4. Contiene un hechizo de Daño directo que toma como objetivo a una unidad enemiga a 24” o menos del trono. Cada integrante de la unidad objetivo deberá superar un chequeo de Iniciativa o sufrirá un impacto que siempre hiere a 4+ (independientemente de la resistencia del objetivo), no permite tirada de salvación por armadura y se resuelve con las reglas especiales Golpe letal y Ataques mágicos).</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Medusa drenasangre" id="fdea-f6e6-5f06-2b9b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3838-d76a-747e-1c36" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="ca78-bee2-46ef-7747" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="1ffa-eeed-b1e6-f224" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink name="Odio" id="a9b7-35de-6727-efb5" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Altos elfos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Medusa drenadora" id="e1da-81ce-957c-4c99" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323"/>
                <characteristic name="HA" typeId="5.753232323444154e+23">4</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">4</characteristic>
                <characteristic name="F" typeId="5.323232344415441e+21">4</characteristic>
                <characteristic name="R" typeId="5.423232344415441e+21"/>
                <characteristic name="H" typeId="5.723232344415441e+21"/>
                <characteristic name="I" typeId="4.923232344415441e+21">5</characteristic>
                <characteristic name="A" typeId="4.123232344415441e+21">3</characteristic>
                <characteristic name="L" typeId="4c4423232344415441232323">8</characteristic>
                <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
                <characteristic name="TSE" typeId="5.761726453617665e+35"/>
                <characteristic name="Tipo" typeId="5.479706523232345e+27"/>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Mirada fatal" id="2d0f-ada5-a338-caaf" hidden="false">
              <description>Al inicio de cada fase de combate cuerpo a cuerpo, todas las miniaturas en contacto peana con peana con la Medusa drenasangre deberán realizar un chequeo de I. Si lo fallan, sufrirán un impacto que siempre hiere con un resultado de 4+, sin tener en cuenta la Resistencia del objetivo, no permite tirada de salvación por armadura y tiene las reglas especiales Golpe letal y Ataques mágicos. Además, todos los ataques en combate cuerpo a cuerpo contra una medusa drenasangre tienen un penalizador de -1 en su tirada para impactar.</description>
            </rule>
            <rule name="Visión drenadora" id="6aa1-124d-6d10-64a0" hidden="false">
              <description>Se trata de un ataque de disparo con alcance 12”, Fuerza 4, que utiliza para herir el valor de Iniciativa del objetivo en lugar de su Resistencia y las reglas especiales Disparo rápido, Disparos múltiples (4), Golpe letal y Ataques mágicos.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Equipo medusa" id="8ec1-9196-e988-9f4d" collective="false" hidden="false" import="true" type="upgrade">
