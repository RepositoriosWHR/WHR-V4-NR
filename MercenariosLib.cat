          <modifiers>
            <modifier field="name" type="append" value="(Arqueros, Infantería ligera, Arcabuceros, Piqueros, Ballesteros, Infantería Pesada, Tropas auxiliares, Duelistas o Escolta del Pagador)"/>
          </modifiers>
