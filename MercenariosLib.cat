          <profiles>
            <profile name="Gema del fuego solar" id="fb09-fbdb-a039-2663" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al inicio de cualquier fase de disparo o combate cuerpo a cuerpo. Hasta el final del turno de jugador en curso, el portador y su unidad obtienen la regla especial Ataques flamígeros y un bonificador de +1 en sus tiradas para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema radiante de Hoeth" id="a05b-3c31-fad5-2e87" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6531-a9cd-ab54-9dd0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dcfc-42bf-8c0a-ce6f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema radiante de Hoeth" id="5f35-17c3-159e-bbb5" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 4. Al inicio de cada una de tus fases de magia elige uno de los ocho Saberes básicos de la magia y efectúa una tirada de 1D6, ese será el hechizo contenido en la gema durante ese turno (pudiendo elegir si se da el bis). Recuerda que no podrás elegir el hechizo identificativo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
