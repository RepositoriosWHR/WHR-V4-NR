            <profile name="Armadura de las Fauces" id="8423-6f05-3821-7ea5" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. El portador obtiene la regla especial Regeneración (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño Codicioso" id="48d4-2526-634b-5609" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="444e-f8ca-ed7e-82e6" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Parada" id="84fb-9564-719a-b829" hidden="false" targetId="9d92-3851-6695-cf71" type="rule"/>
            <infoLink name="Puño de hierro" id="3eef-0045-8d41-5c75" hidden="false" targetId="edd9-1eaa-8927-daea" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Puño Codicioso" id="896c-ecbd-b3dd-fb6f" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Puño ogro. El portador obtiene una tirada de salvación especial de 5+. Si el portador salva una o más heridas causadas por un Arma mágica con esta salvación especial, el Arma mágica quedará destruida y pasará a considerarse un arma mundana de su mismo tipo. Un hechicero herido por el Puño codicioso debe tirar 1D6 al final de la fase de combate cuerpo a cuerpo en la que fue herido: si obtiene un resultado superior, perderá inmediatamente un nivel de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Puño de Hierro" id="046e-d775-4c22-55db" hidden="false">
              <description>Al inicio de cada combate la unidad decidirá si los usa como escudo o como una maza ogra como arma de mano adicional. Si se utiliza como escudo puede usarse Parada.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Reliquias. infantería o Infantería monstruosa" id="a361-7f73-cf54-1b6d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="9a98-94c7-94d2-c3da" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
