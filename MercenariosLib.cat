          </infoLinks>
          <profiles>
            <profile name="Garra del dragón" id="633e-b4a0-a967-b058" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador y la unidad en que se encuentre obtienen la regla especial Inmune a fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Obsequio de la damisela" id="888e-74ac-75de-ec39" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a28b-200e-08a7-a085" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ba12-ca16-3178-6845" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Obsequio de la damisela" id="2f2e-1125-b585-40fa" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un solo uso. El portador puede repetir una tirada de 1D6: puede tratarse de una tirada para impactar, para herir, tirada de salvación por armadura o especial, o un chequeo de atributo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Incienso sagrado" id="d474-25a8-a51e-e65b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e850-1dcf-f93f-6cb2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6d8b-c6f9-5aab-66a0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
