          <profiles>
            <profile name="Trozo de hielo encantado" id="5658-a5e9-9866-7d43" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a su portador la regla especial Aura de frío.</characteristic>
              </characteristics>
