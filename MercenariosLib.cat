                <profile name="Cantimplora de Manantial de Vida" id="786f-bec8-e706-43d4" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo dos usos. Puede usarse al inicio de cualquier fase para restaurar una única herida sufrida previamente durante la batalla.</characteristic>
