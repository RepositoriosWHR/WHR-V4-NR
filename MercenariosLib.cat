          <infoLinks>
            <infoLink name="Inmune a la psicología" id="d71f-ea74-d8f8-7e32" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Inflamable" id="49e2-b1b6-1f51-41fe" hidden="false" targetId="93e4-15ce-63a5-ad92" type="rule"/>
