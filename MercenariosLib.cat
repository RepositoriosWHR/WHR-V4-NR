            <profile name="Estatuilla de Bramhir" id="6e74-4752-4f4c-331c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Proporciona a su portador una tirada de salvación especial de 4+ contra todas las heridas causadas por miniaturas del Caos, enanos del Caos o skaven (eso incluye las heridas causadas por hechizos o máquinas de guerra).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño glotón" id="6070-4e12-e37f-f491" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Orgullo marcial" id="b902-a471-bb76-21d0" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Puño glotón" id="6662-40fc-18a8-bf16" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene un bonificador de +1 a su tirada de salvación por armadura y la regla especial Orgullo marcial.
Cuando esté luchando en un Desafío, el portador obtiene un ataque adicional por cada objeto mágico que porte el oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Marca del demonio" id="ecfe-e312-9852-5c6f" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
