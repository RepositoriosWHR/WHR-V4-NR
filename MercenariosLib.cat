          </infoLinks>
          <profiles>
            <profile name="Grancráneo" id="4680-fd75-d407-483f" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. Cualquier hechicero que designe como objetivo de uno de sus hechizos a la unidad en la que esté el portador obtendrá una Disfunción mágica con cualquier resultado de dobles en su tirada de lanzamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Protegetripas de las Grandes Fauces" id="7112-18ac-e95a-3d53" collective="false" hidden="false" import="true" type="upgrade">
