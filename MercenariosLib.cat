    <profile name="Piel de Cuernospetreos" id="f95d-c02a-7375-ba6b" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Estas capas proporcionan la regla especial Piel escamosa (6+).</characteristic>
      </characteristics>
    </profile>
    <profile name="Trabuco" id="f2f4-a14b-47e1-d0f8" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Plantilla</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Arma de aliento: El disparo de un Trabuco se considera a todos los efectos un Arma de aliento.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas ogras" id="08db-2a83-c12b-8fff" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Disparos múltiples (2)
- Descarga devastadora:  la Ristra de pistolas ogras puede utilizarse en combate cuerpo a cuerpo. Cuenta como Arma de mano adicional, y todos los ataques obtienen +1 a la Fuerza del arma y Poder de penetración.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas enanas (Disparo)" id="6c3a-509a-1dd9-96ce" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Disparos múltiples (2), Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas enanas (Combate)" id="98a5-1678-4941-96c9" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Requiere ambas manos, +1 Ataque,Descarga</characteristic>
      </characteristics>
    </profile>
    <profile name="Rebanadoras emparejadas" id="7f95-f368-fc51-55b9" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">-Rebanar: Las armas con esta regla especial tienen un bonificador de +1 a la Fuerza durante el turno en el que realizan una carga exitosa (o durante el siguiente turno si realizaron una persecución o arrasamiento),
Requiere ambas manos, +1A</characteristic>
      </characteristics>
    </profile>
    <profile name="Rebanadora a dos manos" id="e528-812f-e8c7-6ffc" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">-Rebanar: Las armas con esta regla especial tienen un bonificador de +1 a la Fuerza durante el turno en el que realizan una carga exitosa (o durante el siguiente turno si realizaron una persecución o arrasamiento),
Requiere ambas manos, Lenta.</characteristic>
      </characteristics>
    </profile>
    <profile name="Rebanadora" id="3acc-daf6-ae1f-8c63" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">-Rebanar: Las armas con esta regla especial tienen un bonificador de +1 a la Fuerza durante el turno en el que realizan una carga exitosa (o durante el siguiente turno si realizaron una persecución o arrasamiento),
-Arma de mano: Una Rebanadora se considera a todos los efectos un Arma de mano, por lo que puede utilizarse en combinación con un Escudo para efectuar Parada.</characteristic>
      </characteristics>
    </profile>
    <profile name="Puño de hierro" id="edd9-1eaa-8927-daea" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Al inicio de cada combate (no de cada ronda), una unidad de ogros con puño de hierro ha de decidir si los utiliza como si fuesen escudos o como si fuesen armas de mano adicionales.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola ogra" id="dce4-02e1-c57a-2d1b" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido
-Disparo devastador: una Pistola ogra puede usarse como un arma de mano, el cual se resuelve en la primera ronda de cada combate con un bonificador de +1 a la Fuerza del arma y la regla Poder de penetración.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola enana (Disparo)" id="c927-38f8-c747-5e1c" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola enana (Combate)" id="65ea-83cc-515f-3ae4" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración,Descarga*.
-Arma de mano adicional: Una Pistola enana se usa siempre junto a una Arma de mano tratando a la Pistola enana como un Arma de mano adicional. Sólo puede hacerse un ataque con la Pistola enana.</characteristic>
      </characteristics>
    </profile>
    <profile name="Maza ogra" id="a333-607d-ca5a-c228" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Arma de mano.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mazas ogras emparejadas" id="5f89-83db-4c45-206e" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Requiere ambas manos, +1 Ataque</characteristic>
      </characteristics>
    </profile>
    <profile name="Lanzagranadas" id="bb73-8b6d-d7e8-9256" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">18&quot;</characteristic>
