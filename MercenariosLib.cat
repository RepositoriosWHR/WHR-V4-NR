          <profiles>
            <profile name="Amuleto carmesí" id="4bae-3edd-9ef1-0aaa" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Este talismán proporciona a su portador una tirada de salvación especial de 6+. Adicionalmente, su portador superará automáticamente todos los chequeos de atributo que deba realizar, excepto los chequeos de liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello de Sigmar" id="9fe8-2c09-c84b-b2f0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7d64-ee85-b8cc-0e7a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f31f-9ea0-14c7-85c5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia a la magia (1)" id="e91e-082b-c2cf-2d80" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Sello de Sigmar" id="c0bc-d879-e46b-e8f9" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga al portador Resistencia mágica (1), que aumenta a Resistencia mágica (2) al tratar de dispersar un hechizo del Viento de Magia Oscura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema de Merciw " id="9797-3f17-11b3-3ffb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="76ad-8dfd-0355-8254" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="792f-9d84-d01d-e416" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema de Merciw " id="f02c-3031-1498-bcf8" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador no recibe bonificador alguno a la Fuerza de ningún arma. No obstante, cualquier miniatura que quiera golpearle perderá también los bonificadores de Fuerza de las armas con las que le ataque.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Piedra del retoñar " id="4bd2-565d-50dc-00d2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="97b8-a29a-fbce-3f94" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3d55-5b31-ee73-8539" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Piedra del retoñar " id="c74a-0078-e4a8-536d" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo personajes con Potencia de unidad 4 o inferior. Un sólo uso. Cuando el atributo de heridas del portador se reduzca a 0, antes de retirar la miniatura del campo de batalla tira 1D6: si obtienes un resultado de 1, retira al portador como baja con normalidad; con un resultado de 2-5 la miniatura recuperará una herida y, con un resultado de 6, la miniatura recuperará todas sus heridas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Urdimbre de encantamientos " id="c647-0fec-f44f-fb2b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eab4-7d3c-a1e5-d5e0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4d44-3d6c-4c5d-ae0f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Urdimbre de encantamientos " id="7a54-88be-2991-dd6e" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador una tirada de salvación especial de 4+ contra disparos y hechizos del tipo Proyectil mágico. Además, toda unidad que intente atacar a su portador en combate cuerpo a cuerpo tendrá que superar un chequeo de Liderazgo: si lo falla, tan sólo logrará impactar con resultados de 6 durante dicha fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Garra del dragón" id="7101-3ee0-cbc2-b3d3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8cd0-7998-eeb0-f5cf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="78ee-b5c4-1320-2548" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
