          <profiles>
            <profile name="Incienso sagrado" id="339d-e468-8c69-66b9" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Los disparos efectuados contra el portador o su unidad tendrán un penalizador de -1 a su tirada para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
