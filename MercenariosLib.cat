      <rules>
        <rule name="Individualista" id="6357-974c-bf78-a82e" hidden="false">
          <description>Brunner no puede beneficiarse de la regla especial Presencia inspiradora.</description>
        </rule>
        <rule name="Cazarecompensas" id="0f65-2898-9a07-1f2e" hidden="false">
          <description>Elige un personaje enemigo al inicio de la batalla. Si durante la batalla Brunner consigue abatir en combate o a disparos a dicho personaje obtendrás 100 puntos de victoria adicionales.</description>
        </rule>
        <rule name="Combatiente curtido" id="08e6-d0c0-f449-d46f" hidden="false">
          <description>Brunner lucha con dos armas mágicas; Degollador y Malicia de Dragón. Al inicio de cada ronda de combate puedes decidir qué arma utilizar de forma principal y cuál como arma de mano adicional. Recuerda que debes realizar al menos un ataque con cada arma.</description>
        </rule>
      </rules>
