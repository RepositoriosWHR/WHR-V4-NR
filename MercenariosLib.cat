                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Proporciona a Eeza un bonificador de +1 Iniciativa y tiene la regla especial Heridas múltiples (2).</characteristic>
                  </characteristics>
                </profile>
                <profile name="Rebanadora a dos manos" id="801e-8b53-c886-b94d" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
