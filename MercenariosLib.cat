            <profile name="Guantelete del desafío" id="5a19-34f1-49b5-da15" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todo Desafío lanzado por el portador tiene que ser aceptado obligatoriamente. Es el portador quien escoge qué personaje enemigo aceptará el Desafío. Esto tiene preferencia sobre la regla especial Orgullo marcial que pudieran tener los personajes del oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El libro del valor y la gloria" id="baad-37fb-8f74-9ea5" collective="false" hidden="false" import="true" type="upgrade">
