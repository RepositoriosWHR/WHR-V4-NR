      <selectionEntries>
        <selectionEntry name="Estatuilla de Bramhir" id="9266-1f5e-855b-50ce" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
