      <selectionEntries>
        <selectionEntry name="Manto sombrío" id="7c35-30b2-4a4e-1fa6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="616f-f757-d4d9-ad2a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f883-35e7-4a39-185d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Manto sombrío" id="2dc6-50c3-3440-164c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador podrá repetir las tiradas de salvación fallidas que obtuviese por la regla especial Esquiva. El portador no podrá ser elegido como objetivo por disparos provenientes de unidades situadas a 12” o mas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolsa del oro mágico" id="58a5-7037-6755-3aba" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d729-3436-c6db-46aa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3e4e-463b-9aba-d2f1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bolsa del oro mágico" id="e024-847b-1659-0b38" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Pueden usarse para hacer que una unidad situada a 6” o menos del portador supere automáticamente un chequeo de liderazgo fallido.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolsa del oro maldito" id="77e3-a058-4fe4-c9ee" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="73ae-e154-ad56-d84c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="804f-d1dd-8ae7-1c36" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bolsa del oro maldito" id="2eb0-745f-174e-7b3a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede usar bolsa de oro maldito al inicio de un turno del oponente para obligar a una unidad enemiga a 8&quot; a declarar una carga contra el portador de la bolsa: la unidad seleccionada debe declarar carga contra el portador (o la unidad en la que se encuentre) obligatoriamente. No tiene ningún efecto contra miniaturas Inmunes a Psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino del contrato vinculante" id="19e4-0963-8d04-7458" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="48d7-bb70-b7cf-53a0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5d3a-c6e9-3a1e-39a4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="fa55-724e-88e3-fa34" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pergamino del contrato vinculante" id="cb76-03f6-1a0d-6f32" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todas las unidades amigas con la regla especial Mercenario obtienen la regla especial Inmune a la psicología mientras se encuentren a 12” o menos del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos Hechizados ogros" id="fe27-6b32-9539-9d2a" collective="false" hidden="false" import="true">
