                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Lenta, otorga un bonificador de +1F durante el turno de carga, o al siguiente turno tras efectuar una persecución o arrasamiento que termine en carga.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
