      <rules>
        <rule name="Valor familiar" id="81db-e591-4425-be1b" hidden="false">
          <description>Las unidades con esta regla especial que se enfrenten a un ejército con alguna unidad de elfos oscuros obtienen la regla especial Inmune a psicología, aunque las unidades que también tengan las reglas especiales Hostigador y/o Caballería rápida podrán declarar Huir o Disparar y huir como reacción a una carga.</description>
        </rule>
        <rule name="Destreza marcial" id="095b-85b7-c1bf-af84" hidden="false">
          <description>Puede usar parada si está equipado con dos armas de mano.</description>
        </rule>
        <rule name="Desprecio" id="2f5f-f2b9-2c9c-0179" hidden="false">
          <description>No podrá incluirse en el ejército si se incluyen también a los Desolladores de Mengil o miniaturas con la regla especial No muerto o Demonio.</description>
        </rule>
      </rules>
