            <infoLink name="Terror" id="4569-5bc8-dd2f-6f5e" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
            <infoLink name="Protegetripas" id="e90e-9dc3-e70e-7f2b" hidden="false" targetId="4434-af16-e0a0-4485" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Protegetripas de las Grandes Fauces" id="627e-d80a-5653-1e4f" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. El portador causa Terror. Cada vez que el portador acabe con un enemigo en un Desafío, puede restaurar una de las heridas perdidas previamente durante la batalla. Si no había sufrido heridas, obtiene permanentemente +1 Herida en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tripa de toro" id="5be1-d0fb-7690-ba44" collective="false" hidden="false" import="true" type="upgrade">
