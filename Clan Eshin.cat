              </infoLinks>
              <profiles>
                <profile name="Tatuajes catayanos" id="3215-4c3d-54b0-ba11" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a Sneek un hechizo adicional y las reglas especiales Inmune a veneno y Resistencia mágica (2). Además, si dispersas un hechizo que seleccione exclusivamente a Sneek utilizando los dados proporcionados por su Resistencia mágica, el hechicero que lo efectuó sufrirá 1D6 impactos de F4 con la regla especial Ataques mágicos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Capa de jirones y sombras" id="3044-620f-6162-3645" collective="false" hidden="false" import="true" type="upgrade">
