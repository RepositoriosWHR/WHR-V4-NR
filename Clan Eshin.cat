              </infoLinks>
              <profiles>
                <profile name="Koraza sombría" id="e14b-61a5-e78d-a49e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Proporciona a Stabeek una tirada de salvación por armadura de 4+ en lugar de 5+. Además, todos los resultados naturales de 6 para impactar a Stabeek en combate cuerpo a cuerpo deberán repetirse.</characteristic>
