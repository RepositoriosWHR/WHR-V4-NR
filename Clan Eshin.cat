              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador podrá repetir los resultados de 1 en sus tiradas para Esquivar en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
