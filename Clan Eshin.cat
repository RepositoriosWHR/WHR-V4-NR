          </infoLinks>
          <profiles>
            <profile name="Pendones de Tinieblas" id="e46e-ef2a-5854-a302" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Esquivar (6+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Ashura" id="0e8a-7a5e-cd2b-e2a2" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="88b5-6307-159d-6330" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f7fc-d03b-ba71-e10a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="21c8-b7a4-72e7-111d" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de Ashura" id="f4ab-a80c-3d9d-3066" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad en la que se encuentren ganan la regla especial Furia Asesina, y no la perderán en caso de perder un combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Jiangshi" id="22c9-71ff-e3d5-1e67" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="29d4-b8bf-2910-d908" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1557-0435-c891-f99d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de Jiangshi" id="eb1b-537f-e337-c688" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto portahechizos nivel de energía 2. El estandarte contiene el hechizo Asolar el Alma del saber de la Muerte.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Imperio Sombrío" id="b287-0429-fed6-ba42" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="dbfd-a7c1-a3c3-8e34" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="33ed-b6b6-37e5-67a1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte del Imperio Sombrío" id="dd15-cae8-d650-e894" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Las unidades amigas con la regla especial Hostigadores podrán utilizar el bonificador por filas de la unidad portadora de este estandarte a 18” para realizar sus chequeos de desmoralización, efectos psicológicos (Miedo, Terror y Pánico) y de reagrupamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la unidad de clan" id="009e-0cde-f990-a7d7" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="ed52-8a6b-9112-c8bc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2863-d0ce-1738-9ed1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la unidad de clan" id="452d-1c29-fc1e-76a4" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Siempre que la unidad portadora de este estandarte sea declarada como objetivo de una carga, puedes seleccionar una unidad amiga a 6” o menos de la unidad portadora que no sea declarada como objetivo de una carga. Esa unidad podrá Aguantar y disparar sobre el enemigo que declaró la carga (siempre y cuando tenga línea de visión); en este caso caso no se tiene en cuenta la distancia a la que el enemigo inicia la carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la ráfaga disforme" id="d0b9-7abc-076b-6e37" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="c17e-4e08-2347-abae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9668-8c4b-9255-db2c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la ráfaga disforme" id="34e1-69d8-ecb6-5bc7" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Se trata de un Objeto portahechizos de nivel de energía 3. Contiene un hechizo de Potenciación que afecta a todas las unidades amigas a 12” o menos del portador del estandarte y Permanece un turno. Por la duración del hechizo, todos los disparos realizados por las unidades afectadas no aplicarán el penalizador por larga distancia y obtienen la regla especial Disparos múltiples (2), o aumentarán en 1 si ya disponían de Disparos múltiples.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Reliquias. Clan Eshin. Estrellas arrojadizas" id="f2c9-e108-dad4-a9ce" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5ad7-82a0-b254-16bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="b981-873e-f911-66f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Segadoras mortales" id="a83c-cbd0-9bff-3c41" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="83e0-d744-f729-9ab2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="65af-f388-8c36-4e4e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="75"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="5a2c-1626-ecc0-ae09" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Cuchillos/estrellas arrojadizas" id="8af3-72df-80f3-eeb6" hidden="false" targetId="2d13-b3f6-f40b-23fc" type="profile"/>
            <infoLink name="Disparos múltiples" id="d113-eefd-4b36-a677" hidden="false" targetId="fc7e-40e6-a7aa-4530" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(2D6+1)"/>
              </modifiers>
            </infoLink>
            <infoLink name="Poder de penetración" id="e960-06d3-6fd2-a107" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Segadoras mortales" id="e29f-72e1-3235-393f" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Estrellas arrojadizas. Tienen la regla especial Disparos múltiples (2D6+1). Estos impactos se resuelven con un bonificador de +1 a la Fuerza del usuario y la regla especial Poder de penetración. Estos disparos hieren siempre con un resultado de 4+ (a no ser que su tirada para herir fuese mejor).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Clan Eshin. Alabarda" id="65d0-ac86-bc7b-6562" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="305e-060d-e054-9a9b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="902f-7c8b-fbcd-796f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Gundao de la Demencia" id="2cbe-b097-567c-9393" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a662-c8b4-38f5-9e28" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a7d0-b82d-65f4-7841" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Alabarda" id="d9f6-b19a-9b2c-d052" hidden="false" targetId="8dd0-8d9d-2436-cbf1" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Gundao de la Demencia" id="3797-e5b8-6dfa-cf56" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Alabarda. El portador obtendrá un bonificador de +1 en sus tiradas para impactar en cuerpo a cuerpo. Además, los enemigos tendrán un penalizador de -1 en sus tiradas para impactar al portador en cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Clan Eshin. Katana" id="6475-87e4-0e9e-8cbb" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="1019-359f-b41e-5ec0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="28af-f040-168e-88fb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
