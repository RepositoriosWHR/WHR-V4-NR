              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="45"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Lanzallamas" id="c404-2fe9-3059-7a05" hidden="false" targetId="b67f-988d-ab4b-1806" type="rule"/>
                <infoLink name="Heridas múltiples (1D3)" id="b8fc-9dda-2c3d-7979" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Aliento de dragón" id="6781-c138-7613-0733" hidden="false">
                  <description>La máquina de guerra dispara como un Lanzallamas que puede estimar entre 0-3 dados (más el dado de artillería). Sus disparos se resuelven con Fuerza 5 y la regla especial Heridas múltiples (1D3). Si obtiene un resultado de Problemas en el dado de artillería, utiliza la tabla de problemas del Lanzallamas.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
