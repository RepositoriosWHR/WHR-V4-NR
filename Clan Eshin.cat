        <rule name="Más máquina que rata" id="dbbd-f784-1dac-58db" hidden="false">
          <description>Veskit es Indesmoralizable, Inmune a veneno e Inmune a ataques flamígeros.</description>
        </rule>
        <rule name="Cuerpo metálico" id="81ad-f8c7-464d-ed4e" hidden="false">
          <description>Proporciona a Veskit su elevado atributo de Fuerza y Resistencia (ya reflejado en el perfil) y le da una tirada de salvación por armadura de 3+.</description>
        </rule>
      </rules>
