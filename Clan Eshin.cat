              </infoLinks>
            </selectionEntry>
            <selectionEntry name="Capa de sombras" id="1be1-0e7b-d92e-4d9f" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1dba-aa84-27e3-6ed6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="d8b3-029d-180b-fde6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Capa de sombras" id="96b0-a0c7-98f4-7d01" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todos los disparos efectuados contra Snikch tan sólo pueden impactar con resultados naturales de 6. Todos los impactos parciales que reciba Snikch fallarán de manera automática. Cualquier hechicero (amigo o enemigo) que intente lanzar un hechizo que tome como objetivo únicamente a Snikch deberá realizar un chequeo de Liderazgo (no puede utilizar Presencia inspiradora o ¡Ni un paso atrás!) antes de lanzar los dados de Energía; si lo falla, no podrá elegir a Snikch como objetivo. Cualquier unidad que declare una carga contra Snikch perderá la regla especial Veloz y deberá elegir el resultado menor al cargar en lugar del mayor.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Brazaletes de poder" id="9e41-85e0-1703-84a8" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0d5b-35b1-3482-3db9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="91cf-615e-2691-88c8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Brazaletes de poder" id="835c-1c1f-b5a3-0b7d" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo 3 usos. Objeto portahechizos de nivel de energía 3. Contiene un hechizo de Potenciación que toma como objetivo al propio Snikch y Permanece un turno. Por la duración del hechizo, Snikch tendrá un bonificador de +2 a su atributo de Fuerza. Puedes activar los Brazaletes de fuerza aunque Snikch no haya sido revelado (esta es una excepción a las reglas habituales que impiden lanzar hechizos a las miniaturas que no han sido reveladas).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Snikch, asesino supremo del clan Eshin" id="35a4-c58f-bc30-bb90" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="506f-277e-841d-143b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="a05a-7765-2a4c-14f6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="370"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Snikch" id="1bef-bde2-61a5-e9ba" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">6</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">9</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">8</characteristic>
