    <selectionEntry name="[E] - Stabeek &quot;La Puñalada&quot;, primer caudillo del clan Treecherik" id="cf0e-ce91-c75e-4737" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="4f6b-d6ca-1c21-0372" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
        <categoryLink name="Personajes" id="583e-22d7-a3f0-27af" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="d9b3-96cd-bc19-7869" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
