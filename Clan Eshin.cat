          <profiles>
            <profile name="Anillo de la oscuridad" id="abb0-4539-6afd-c95f" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Proporciona a su portador Resistencia mágica (1). Además, si un hechizo, objeto mágico o habilidad obliga al jugador Skaven a revelar objetos mágicos u otra presencia “escondida” en la unidad en la que se encuentre el portador, el jugador Skaven deberá revelar sólo la presencia de este anillo; todo lo demás permanece oculto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Talismán de la piel de otro" id="f8dc-432c-ccc9-ac2f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="57e7-8f11-3fb2-5e06" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3c71-6259-0b3b-ff82" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Talismán de la piel de otro" id="8963-f224-20e9-b8bf" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un solo uso. El portador puede obligar a una única miniatura enemiga con la que esté en contacto peana con peana a repetir todas sus tiradas para impactar exitosas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cacharro de atracción de sombras" id="6c26-530a-7e11-f3b2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fe94-1041-8d90-ff4d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="96f7-8ad1-f62c-9b1d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
