    <selectionEntry name="[Ex] - Emisario oscuro" id="8c21-766f-f2dd-5aaf" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="6521-aae2-cd29-a3f1" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
