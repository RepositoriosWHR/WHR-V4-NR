        <infoLink name="Esquivar (4+)" id="4936-a3de-0021-646c" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="f616-f3b2-923d-3cd0" type="set" value="3">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="f616-f3b2-923d-3cd0" type="set" value="4">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Velo de sombras" id="1a24-39e9-1084-52f5" hidden="false">
          <description>Cualquier arma de proyectiles o hechizo que tome como objetivo a la Tríada Eshin verá su alcance reducido a 12”. Todos los impactos con plantilla sobre una Tríada Eshin se consideran impactos parciales.</description>
        </rule>
        <rule name="Tácticas de la triada" id="d94a-041d-b954-3b2d" hidden="false">
          <description>Ningún personaje puede unirse a ana Tríada Eshin.</description>
        </rule>
        <rule name="Bombas de humo" id="5bf1-adfa-735f-ec16" hidden="false">
          <description>Siempre que la Tríada Eshin falle un chequeo de Desmoralización o declare como reacción a una carga Huir o Disparar y huir, lanzará unas bombas de humo que dificultarán la persecución. Todas las unidades que persiguen a la Tríada Eshin verán su atributo de Movimiento reducido a la mitad (redondeando hacia arriba) durante esa persecución.</description>
        </rule>
      </rules>
