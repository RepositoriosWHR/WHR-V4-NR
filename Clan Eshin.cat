        <infoLink name="Flotar (12)" id="4e25-cc63-3850-a1d0" hidden="false" targetId="7063-d0cc-379d-9f31" type="rule"/>
        <infoLink name="Vanguardia" id="e399-8f1d-7934-e6cd" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
        <infoLink name="Esquivar (6+)" id="526b-3b59-14a1-5d90" hidden="false" targetId="c905-72a4-c706-6a16" type="rule"/>
        <infoLink name="Inmune al miedo" id="d0e0-6181-ba2e-2eea" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="97f1-46ec-596e-1d6d" type="set" value="2">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="97f1-46ec-596e-1d6d" type="set" value="3">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Acróbatas del aire" id="8a8e-9d16-1226-6666" hidden="false">
          <description>Tienen la regla especial Inmune a Miedo. Además, su tirada de salvación por Esquivar aumenta a 4+ contra proyectiles y proyectiles mágicos mientras estén flotando.</description>
        </rule>
        <rule name="Lluvia de abrojos" id="edbb-6e39-0c3b-63dd" hidden="false">
          <description>Los Alas Negras que cuenten con Potencia de unidad 5+ pueden descargar su carga de bolsas de abrojos sobre una unidad que hayan sobrevolado durante tu fase de movimiento. La unidad que recibió la lluvia de abrojos no podrá marchar ni hacer uso de la regla especial Veloz (en caso de tenerla) durante su siguiente fase de movimiento. Además, si la unidad fuese a realizar cualquier otro tipo de movimiento (incluso reformar) durante su siguiente fase de movimiento, sufrirá 1D6 impactos de F1, más 1D3 impactos adicionales por cada cinco puntos de Potencia de unidad o fracción. Las heridas causadas por los abrojos niegan la tirada de salvación por armadura. Sin embargo, no tendrán ningún efecto contra miniaturas con las reglas especiales Volar, Flotar y/o Etéreo.</description>
        </rule>
      </rules>
