            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Miedo" id="21fd-6db4-61a9-c2a7" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Mortaja del acecho" id="d1dc-2a7c-90bd-9fa2" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El personaje causa Miedo. Además, cualquier arma de proyectiles o hechizo que tome como objetivo al portador verá su alcance reducido a 12”. Todos los impactos con plantilla sobre el portador se consideran impactos parciales. Sin embargo, el personaje no podrá unirse a unidades.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El tercer ojo" id="22c9-ac11-acbd-d1d3" collective="false" hidden="false" import="true" type="upgrade">
