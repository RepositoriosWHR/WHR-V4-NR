                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Ataques mágicos, Disparos múltiples (2), Munición inestable: Por cada resultado de 1 en la tirada para impactar con este arma, tira 1D6: con un resultado de 4-6, se encasquilla y el arma no disparará ese turno, de lo contrario resuelve el impacto contra el usuario con las reglas habituales del arma y un bonificador de +1 a su Fuerza.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Ristra de pistolas brujas (combate)" id="5bdd-04e7-83df-a55e" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
