      <rules>
        <rule name="Magia Gran Hechicero Eshin" id="fac0-12dd-ccc2-aa45" hidden="false">
          <description>Un Gran Hechicero del Clan Eshin es un hechicero de nivel 2, que puede aumentarse a nivel 3 (+50 puntos). Puede elegir sus hechizos del Saber del Sigilo. Tiene como hechizo identificativo el hechizo Estrellas de disformidad.</description>
        </rule>
      </rules>
