          <profiles>
            <profile name="Colgante de los Shugengan" id="adc7-fdce-ec13-ef69" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia, tira 1D6: con un resultado de 4+, extrae un Dado de magia de la reserva del oponente y añádelo a tu reserva de dados de energía/dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Libro de Ulgu" id="1857-e4a3-22bc-add1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e34a-8f19-45fb-9bc0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4dc2-7d68-9762-3fea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Libro de Ulgu" id="0c83-b077-fbde-75e2" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador podrá tomar sus hechizos del Saber de las Sombras, aparte del saber que conozca. Además, el portador conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Abazón de Aethyr" id="0ee6-1274-cb2e-a89e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="135e-3bf3-a79b-c0d4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cde6-c797-4d55-807f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Abazón de Aethyr" id="d696-193b-bc34-e757" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede guardar un dado de magia. Además, mientras tenga un dado guardado, obtiene un bonificador de +1 a su Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino de desvinculacion mágica" id="f4b2-6d8e-01fe-35d8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e961-6c46-769e-e5f5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="64e1-3c91-febe-ba0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de desvinculacion mágica" id="56a8-b266-4775-10cd" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Puedes utilizar el pergamino en lugar de realizar un intento de dispersión de hechizo con el portador. Dispersa automáticamente el hechizo. Tras esto, tira 1D6: Si obtienes un resultado de 6, el hechicero que lanzó el hechizo sufrirá una herida sin salvación por armadura. Sin embargo, si obtienes un resultado de 1, el portador sufrirá una herida sin tirada de salvación por armadura. Ten en cuenta que no puede utilizarse contra un hechizo lanzado con Fuerza irresistible ni contra un hechizo que Permanece en efecto y no fue lanzado ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Reliquias. Clan Eshin" id="8bbc-9b85-03c7-b8bc" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="32b5-f240-6731-1f52" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="15c8-12cd-61b9-5603" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Anillo fugaz" id="9e11-7262-f87b-b568" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9788-2c04-2cce-307c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="af24-84e6-43c1-2acb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="90"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="d1f2-eaba-f2dc-4762" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Anillo fugaz" id="7b4a-0b99-4275-bcc7" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El anillo es un objeto portahechizos de nivel 4. Contiene el hechizo Salto Fugaz del Saber de la Ruina Skaven, con la diferencia de que afecta a su portador y a la unidad que lo acompañe (siempre y cuando tenga una Potencia de unidad de 15 o inferior). Además, las miniaturas teleportadas pueden colocarse en contacto peana con peana con cualquier enemigo que no esté huyendo y se considerará que han realizado una carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Clan Eshin" id="5cf4-0414-53cb-e357" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f714-1aa4-eb8e-ba00" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="4201-bfb1-1933-1414" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Amuleto de piedra de disformidad" id="0c50-cd37-c6c9-7dfe" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="63b5-1221-de80-9211" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7e76-fe8c-1888-3fa0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="42cf-da85-c91f-f339" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, canalizar, un único dado de energía o dispersión, o una tirada en la tabla de disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gumbai encantado" id="73f9-1b88-a3b5-9ddc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e109-bc15-6ece-491b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9404-5535-8ee7-f193" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gumbai encantado" id="7f0b-b716-786d-47b5" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y su unidad podrán repetir sus chequeos de Liderazgo fallidos para reagruparse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escama de dragón dorado" id="53e8-0b45-6c63-6a8e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5fc1-459b-ca69-d41c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d971-c1b3-c6ec-58ff" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Escama de dragón dorado" id="6d88-f746-f8f9-8546" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene una Herida adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Capucha de sombras" id="9e17-e63e-3702-a4ee" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9900-fc0a-5f98-be4b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9081-79ac-e3c5-e200" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (1)" id="582d-d402-95ad-820d" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Capucha de sombras" id="bcc8-b113-f305-7015" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene la regla especial Resistencia a la magia (1). Además, los disparos y ataques realizados contra el portador tendrán un penalizador de -1 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lengua de dragón" id="6246-ac60-54b9-b30f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ec77-eb38-b559-9421" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0939-082a-35b3-96ca" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques solo flamígeros" id="9e1a-7eef-7456-6eb5" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Lengua de dragón" id="416e-ebe4-47a8-e62a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. La Lengua de Dragón puede utilizarse en cualquier fase de disparo propia si el portador no está trabado en combate ni ha marchado durante ese turno. Estima una distancia de entre 0-8 dados más el dado de artillería (como si se tratase de un Cañón): coloca la plantilla redonda grande al final de la distancia estimada. Cualquier miniatura bajo la plantilla (utiliza las reglas habituales de impactos parciales) sufrirá un impacto de Fuerza 4 con la regla especial Ataques sólo flamígeros. Si obtienes un resultado de Problemas en la primera tirada del dado de artillería, tira 1D6 en la tabla de problemas de la Lengua de Dragón:
D6 Tabla de problemas de la Lengua de Dragón
1 ¡Buuum!: Coloca la plantilla redonda grande centrada sobre el lanzador y resuelve el impacto de manera habitual.
2-5 Pérdida del ala estabilizadora: Tira el dado dedispersión para determinar la dirección que tomará el cohete desde el lanzador.
6 Inutilizado: No hay efecto adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Potaje skaven" id="7092-0f92-1cec-908b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1777-eb41-2f18-5cdb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="40e0-d270-6737-89f1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Potaje skaven" id="664b-15a7-b8b2-7038" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Al principio de la batalla, la unidad de Ratas de clan Eshin o Alimañas Eshin a la que esté unido se tragará el misterioso engrudo. Los Oficiales recibirán sus efectos pero ningún otro personaje será tan tarugo como para tragarse eso. Tira 1D6 en la tabla de efectos del Potaje skaven y aplica el resultado durante toda la batalla:
D6 Potaje skaven
1 Indigestión: La unidad sufre 1D6 impactos de Fuerza 3 sin posibilidad de salvación por armadura.
2-3 Inspirar Odio: La unidad obtiene la regla especial Odio (¡todos los enemigos!). 
4-5 Furia Asesina: La unidad obtiene la regla especial Furia asesina.
6 Locura Asesina: La unidad la unidad obtendrá la regla especial Furia Asesina, pero obtendrán +2 ataques en lugar del +1 habitual (si la unidad ya tenía Furia asesina, obtendrá un ataque adicional); al final de cada turno Skaven, la unidad sufrirá 1D6 heridas automáticas (distribuidas como si fueran impactos de proyectiles) si conservan su Furia Asesina.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Skalm" id="e4a5-3ceb-8f8f-8791" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="86b9-d92c-a9ad-e250" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c8a2-b4ee-7aec-9fb3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Skalm" id="043c-ec3e-cefc-8c23" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier fase de magia, disparo o combate cuerpo a cuerpo propia o del enemigo. El portador restablecerá 1D6 heridas que hubiese sufrido previamente en la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brazaletes de poder" id="2d55-a413-052c-403d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="149e-17a9-a528-b94e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f542-8182-9bd7-0b14" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brazaletes de poder" id="f20a-eb93-b6d1-5ad2" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos. Nivel de energía (4). Contiene un hechizo de potenciación que puede lanzarse sobre el portador y permanece un turno. Mientras el hechizo permanezca en efecto, duplica el atributo de Fuerza del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino de la multiplicación de cuerpos" id="e3a2-0dac-a2d0-67bb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="56d6-8cca-0b06-9bc8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="14d3-6952-1635-f7fd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de la multiplicación de cuerpos" id="5d17-81be-456b-1ee8" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Se trata de un Objeto portahechizos de nivel de energía 5. Contiene un hechizo de potenciación que puede lanzarse sobre una unidad amiga a 12” o menos del portador y permanece un turno. Por la duración del hechizo, las heridas que sufra la unidad no contarán para la resolución de los combates en los que participen. Además, cuando este hechizo se resuelve con éxito, restaura 1D3 heridas que la unidad hubiera sufrido previamente durante la batalla (ten en cuenta que este hechizo no restaura a los Oficiales de las unidades).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Clan Eshin. Asesinos" id="e700-395f-d0a6-8456" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="d304-352a-016e-5191" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="0d35-2197-5316-0a26" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Bomba infernal" id="ede8-2404-89da-d074" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1350-63da-1241-1e24" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="886c-a1ca-507f-b5f8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Heridas múltiples (1D6)" id="0746-dbe6-fa83-8c25" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Bomba infernal" id="8232-9649-aa38-f145" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo Líder asesino. Un solo uso. A excepción de los turnos en los que realice una carga, un Asesino podrá colocar la Bomba Infernal en cualquier punto del recorrido que haga durante su fase de movimiento o, si está incluido en una unidad, en cualquier punto del recorrido hecho por la unidad. El asesino puede soltar la Bomba Infernal durante un movimiento de marcha. Anuncia tu intención de soltar la Bomba Infernal e indica el lugar con un marcador. La Bomba Infernal puede detonarse remotamente por el asesino en cualquier momento del juego posterior (excepto en el turno en el que fue colocada). Para detonar la bomba tira 1D6; si obtienes un resultado de 1, ésta está defectuosa y no estalla. Con un resultado de 2-6, coloca la plantilla redonda grande centrada en el marcador. Cualquier miniatura bajo el centro de la plantilla sufrirá un impacto de F10 con la regla especial Heridas múltiples (1D6). El resto de miniaturas bajo la plantilla (utiliza las reglas habituales de impactos parciales) sufrirá un impacto de F4 con la regla especial Poder de Penetración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Capa de la noche" id="ee47-8024-cdb9-70c8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="69a9-5633-ab03-cccc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3b44-2542-cac7-c614" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Capa de la noche" id="d8f8-4463-329e-c5f0" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Aumenta en un la tirada de Esquiva del portador en un punto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Informe de asesino" id="3d09-b092-9b3b-4ce3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="937a-5aeb-9cee-47a2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="245f-2024-3ed5-38dc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Informe de asesino" id="7eb4-6d8c-5fc1-1433" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Líder asesino. Al inicio de la batalla, tras el despliegue, selecciona un personaje enemigo y anota su nombre en la lista de ejército. El portador podrá repetir los resultados de 1 en sus tiradas para impactar y para herir contra el personaje. Adicionalmente, puedes obligar al personaje a repetir un ataque que haya impactado contra el portador en cada fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Clan Eshin" id="708b-5406-de9a-bcdd" collective="false" hidden="false" import="true">
      <constraints>
