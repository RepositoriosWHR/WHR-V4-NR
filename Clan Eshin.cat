    <selectionEntry name="Señor de las Alimañas" id="dfc9-85bc-f27c-6644" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="fded-3743-0ad9-ab63" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="471f-a7e3-6713-0de6" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
