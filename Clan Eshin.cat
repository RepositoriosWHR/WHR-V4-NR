              <profiles>
                <profile name="Capa de jirones y sombras" id="185d-9466-cbf1-a2de" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a Lord Sneek un bonificador de +1 en sus tiradas de Esquivar. Además, todas las miniaturas enemigas en contacto peana con peana con Sneek obtienen la regla especial Lenta.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
