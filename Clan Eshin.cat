                <infoLink name="Resistencia mágica (2)" id="69b3-00c3-4afc-af78" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Colgante de la princesa Kaguya" id="17c9-1cb3-02c4-9819" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a Kageratu las reglas especiales Flotar, Etéreo y Resistencia a la magia (2). Sin embargo, Kageratu no puede unirse a unidades, y sufrirá 1D3 Heridas que no podrá salvar con tiradas de Esquivar si el poder de este objeto es anulado por el efecto de algún hechizo, habilidad o regla especial.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
