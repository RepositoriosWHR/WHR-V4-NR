              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Tiene las reglas especiales Poder de penetración y Heridas múltiples (1D3). Cualquier número de Asesinos Eshin o Maestros asesinos Eshin del ejército puede equiparse con estas armas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
