            <entryLink name="Reliquia" id="7b08-d3c8-ecfe-01a0" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Manto de la Noche Tétrica" id="ce86-c6f6-6867-7649" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El radio de la regla especial ¡Ni un paso atrás! del portador se verá aumentado a 24”. Además, las tropas con la clave clan Eshin podrán hacer uso de la regla ¡Ni un paso atrás! del portaestandarte de batalla aunque éste se encuentre huyendo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Clan Eshin" id="15bc-efd0-1dee-9c1d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5c7f-f846-4eb9-f34c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="671e-db76-0057-58b9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pendones de Tinieblas" id="3e7b-60fc-19a8-b18b" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="ccec-3000-a22e-1a4e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0d7d-9a91-f863-3a32" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
