      <entryLinks>
        <entryLink name="General Eshin" id="5fe4-f2d1-cd72-46d9" collective="false" hidden="false" import="true" targetId="54f4-d0f8-0c54-eb70" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Monstruo" id="ecc2-3516-97fe-f6f4" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Demonio" id="bc68-b925-39c7-9c89" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule"/>
        <infoLink name="Veloz" id="335b-7a54-4ee1-4f88" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
        <infoLink name="Aura demoníaca (4+)" id="0fb6-0076-bbe5-6eb6" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule"/>
        <infoLink name="Cruzar (obstáculos)" id="5e53-7a81-dbef-07ff" hidden="false" targetId="5dfd-3f02-cece-1e02" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Magia Señor de las Alimañas" id="6e93-e187-10a1-ef7b" hidden="false">
          <description>El Señor de las Alimañas es un hechicero de nivel 2. Puede convertirse en hechicero de nivel 3 (+50 puntos) o de nivel 4 (+105 puntos, obtiene la regla especial Leyenda). Puede elegir sus hechizos del Saber del Sigilo. Su hechizo identificativo es las Estrellas de disformidad o el Torbellino negro (elige uno). Si tiene una habilidad de Señor del conocimiento, esto sustituirá sus hechizos habituales. Si tiene ambas, tendrá también la Maldición de la Rata Cornuda.</description>
        </rule>
        <rule name="Avatar de la gran cornuda" id="05a3-de52-ebc3-dc97" hidden="false">
          <description>Todas las unidades Skaven amigas a 12” o menos de un Señor de las alimañas podrán utilizar el atributo de Liderazgo de éste para realizar sus chequeos (aunque no sea el General del ejército).</description>
        </rule>
      </rules>
