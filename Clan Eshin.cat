              </infoLinks>
              <profiles>
                <profile name="Torbellino de espadas supurantes" id="5082-dde1-6dcb-3e55" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas (otorgan a Snikch +2 Ataques en lugar de +1, ya que se trata de un trío de armas en lugar de una pareja). Los impactos causados con estas armas tienen las reglas especiales Ataques envenenados, Poder de penetración y Heridas múltiples (1D3).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Estrellas arrojadizas" id="11a2-55df-3f1b-7338" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="251e-4e03-5b13-efe4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
