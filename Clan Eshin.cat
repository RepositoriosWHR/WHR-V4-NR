                <infoLink name="Arma emparejadas" id="79e2-5964-e5ef-0cf0" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink name="Arma de mano" id="934e-f5db-b004-4ca0" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
