        <infoLink name="Ataques mágicos" id="0a27-a662-fa67-c723" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Tuneladora)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Poder de penetración" id="8e97-7ba2-2a9d-50cb" hidden="false" targetId="29d3-6624-40c6-885f" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Tuneladora)"/>
