              <profiles>
                <profile name="Urimi-Naga" id="0a67-e070-8a2b-c356" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Las heridas causadas por este arma niegan la tirada de salvación por armadura y los Ataques envenenados tendrán efecto con un resultado de 5+ en lugar de 6+. Además, tiene la regla especial Heridas múltiples (1D3).</characteristic>
