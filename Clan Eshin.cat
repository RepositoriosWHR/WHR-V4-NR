                <profile name="Par de garras de combate" id="a9b6-ff37-5a2e-8d4c" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los ataques realizados con estas armas se resuelven con la regla especial Golpe letal. Además, le 
proporcionan un bonificador de +1 a su tirada de salvación por armadura en combate cuerpo a cuerpo (para un total de 2+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Ojo sin párpado" id="8bdd-286d-5fd3-9d60" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="e647-0f60-6f8d-5a75" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="9471-0bb8-dc57-bbaa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Ojo sin párpado" id="1942-6087-22b9-b9eb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de cada turno propio, elige una unidad a 12&quot; de Veskit: esa unidad debe revelar todos los objetos mágicos y opciones ocultas de la unidad. Además, Veskit no sufre ninguna penalización al disparar sus pistolas brujas. Adicionalmente, le otorga un bonificador de +1 en sus tiradas para impactar en cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Injertos de soporte vital" id="356c-875a-cbcb-0a04" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c3db-240e-74a4-b527" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="1b2c-9b6f-6aa4-d9ee" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Injertos de soporte vital" id="6fe0-ca6f-4ecb-2cee" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Armadura pesada. Proporciona a Veskit una tirada de alvación por armadura de 3+ (en lugar de 5+ por tratarse de 
una Armadura pesada) y una tirada de salvación especial de 5+. Además, otorga un bonificador de +1 a sus atributos de Fuerza y Resistencia (ya reflejado en el perfil). Adicionalmente, cada vez que Veskit pierda su última herida no retires la miniatura y tira 1D6: con un resultado de 4+, Veskit se levantará de nuevo con una herida restante.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
