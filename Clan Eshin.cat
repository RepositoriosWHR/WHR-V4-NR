        <modifier field="9647-07cd-bc31-f185" type="set" value="3">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Soportes de disparo" id="c6b3-52ef-d85f-f800" hidden="false">
          <description>Los Truenos Eshin no tienen penalizador por disparar a larga distancia.</description>
        </rule>
        <rule name="Truenos Eshin" id="1361-68fa-9dd7-0375" hidden="false">
          <description>Un Trueno Eshin tiene una salvación por armadura de 6+ y potencia de unidad 2.</description>
        </rule>
        <rule name="Técnicas de camuflaje" id="76e1-92d9-ca0a-9d38" hidden="false">
          <description>Todos los disparos realizados contra las unidades de Truenos Eshin obtienen un penalizador de -1 en sus tiradas para impactar.</description>
        </rule>
        <rule name="Acechando en la distancia" id="6be2-2fc2-efd7-62ad" hidden="false">
          <description>Los Truenos Eshin pueden Mover y disparar con sus Kaminaris, aunque no pueden disparar si han realizado un movimiento de marcha.</description>
        </rule>
        <rule name="Disparo atronador" id="9b9b-2afb-3a5d-503f" hidden="false">
          <description>Una vez por batalla, durante la fase de disparo, los disparos de los Truenos Eshin pueden resolverse con Fuerza 6 y la regla especial y Heridas múltiples (2). Sin embargo, durante dicha fase de disparo, el efecto de la regla Inestable del Kaminari aumentará a 1-3.</description>
        </rule>
      </rules>
