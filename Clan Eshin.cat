      <infoLinks>
        <infoLink name="Infantería" id="f54e-8764-5354-cbe9" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="La fuerza del número" id="e38a-8a82-26f7-312c" hidden="false" targetId="0fc2-9bf9-b684-e980" type="rule"/>
        <infoLink name="Coraje mezquino" id="6522-b20c-3e9f-6820" hidden="false" targetId="960b-38ee-0189-d25c" type="rule"/>
        <infoLink name="Esquivar (5+)" id="b00c-6717-c1d1-dadb" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
        <infoLink name="Golpe letal" id="a8f3-66f3-ca9f-d6f5" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Puñalada mortal)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="d9b3-96cd-bc19-7869" type="set" value="0">
          <conditions>
            <condition childId="7207-cbbb-1509-244c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Puñalada mortal" id="1076-f863-b3b4-6235" hidden="false">
          <description>El ataque adicional que realiza Stabeek con su Arma de cola se resuelve con la regla especial Golpe letal.</description>
        </rule>
        <rule name="Ratas de Clan Treecherik" id="f47f-1c1a-000d-dc31" hidden="false">
          <description>Si incluyes a Stabeek en tu lista de ejército, debes convertir una unidad de Ratas de clan Eshin en Ratas de Clan Treecherik (+2 puntos por miniatura). Las Ratas de Clan Treecherik obtienen la regla especial El camino del guerrero y están equipadas con Armadura ligera, Armas emparejadas y Arma de cola. Stabeek debe unirse a esa unidad y no podrá abandonarla.</description>
        </rule>
        <rule name="El camino del guerrero" id="0d33-7930-be29-70e5" hidden="false">
          <description>Al luchar en combate cuerpo a cuerpo, el Stabeek aplica un bonificador de +1 a su tirada de salvación por armadura.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="be52-6aa6-3f70-80ba" collective="false" hidden="false" import="true" type="upgrade">
