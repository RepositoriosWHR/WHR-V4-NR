                <infoLink name="Heridas múltiples (1D6)" id="4150-d5d1-c04a-7e72" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Cañón de Bronce (Bolas de cañón)" id="18d0-8583-fc59-8bec" hidden="false">
                  <description>La máquina de guerra dispara como un Cañón que puede estimar hasta 10D6 dados (más el dado de artillería). Sus disparos se resuelven con Fuerza 10 y la regla especial Heridas múltiples (1D6). Si obtiene un 
resultado de Problemas en el dado de artillería, utiliza la tabla de problemas del Cañón.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Aliento de dragón" id="620f-2790-2b90-ec95" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
