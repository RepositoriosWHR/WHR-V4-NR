        <infoLink name="Armas secretas" id="4842-1d5d-245e-bf18" hidden="false" targetId="54fb-1c42-dba2-b348" type="rule"/>
        <infoLink name="Ataques solo flamígeros" id="4bb5-294b-5253-1f61" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
        <infoLink name="Lanzallamas" id="b152-5959-7241-3fb2" hidden="false" targetId="b67f-988d-ab4b-1806" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Abazón ígneo" id="12f5-6a0f-4da2-1a6b" hidden="false" typeId="1b97-9489-6fc4-8f85" typeName="Arma secreta">
          <characteristics>
            <characteristic name="Tipo" typeId="13f1-6967-4341-f7af">Lanzallamas</characteristic>
            <characteristic name="Fuerza" typeId="2033-ac99-4415-1729">5</characteristic>
            <characteristic name="Reglas especiales" typeId="5f35-de4b-5d02-211f">Un sólo uso. Puede utilizarse durante cualquier fase de disparo propia, o para Aguantar y disparar. Se trata de un arma de proyectiles que dispara como un Lanzallamas, el cual puede estimar 0-1 dados (más el dado de artillería). Sus impactos se resuelven con Fuerza 5 y la regla especial Ataques sólo flamígeros. Cualquier unidad que sufra una o más bajas a consecuencia de este disparo deberá realizar inmediatamente un chequeo de pánico.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Orratsu" id="2ecd-6bdb-ab2c-fe74" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Armas secretas" id="b6aa-04ef-bc13-1c5a" hidden="false" targetId="54fb-1c42-dba2-b348" type="rule"/>
        <infoLink name="Cañón" id="ae48-73a4-2e21-6bf4" hidden="false" targetId="9f6a-5d0b-f0a6-dbab" type="rule"/>
        <infoLink name="Heridas múltiples (1D3)" id="ab74-4abe-2b12-341c" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Orratsu" id="ff31-3480-2414-4ff7" hidden="false" typeId="1b97-9489-6fc4-8f85" typeName="Arma secreta">
          <characteristics>
            <characteristic name="Tipo" typeId="13f1-6967-4341-f7af">Cañón</characteristic>
            <characteristic name="Fuerza" typeId="2033-ac99-4415-1729">7</characteristic>
            <characteristic name="Reglas especiales" typeId="5f35-de4b-5d02-211f">Un sólo uso. Puede utilizarse durante cualquier fase de disparo propia. Este disparo se resuelve como un Cañón que puede estimar entre 0-6 dados (más el dado de artillería). Este disparo se resuelve con Fuerza 7 y la regla especial Heridas múltiples (1D3).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Proyector de shurikens" id="f188-2fb1-418b-ecac" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Armas secretas" id="73ac-4878-9ae3-b4e9" hidden="false" targetId="54fb-1c42-dba2-b348" type="rule"/>
        <infoLink name="Tormenta de proyectiles" id="7db3-3f6c-00bc-6c2e" hidden="false" targetId="78ba-a8c1-e999-847c" type="rule"/>
        <infoLink name="Poder de penetración" id="1f52-0013-c2ce-db01" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Proyector de shurikens:" id="57d9-28be-7247-a715" hidden="false" typeId="1b97-9489-6fc4-8f85" typeName="Arma secreta">
          <characteristics>
            <characteristic name="Tipo" typeId="13f1-6967-4341-f7af">Tormenta de proyectiles</characteristic>
            <characteristic name="Fuerza" typeId="2033-ac99-4415-1729">4</characteristic>
            <characteristic name="Reglas especiales" typeId="5f35-de4b-5d02-211f">Un sólo uso. Puede utilizarse durante cualquier fase de disparo propia, o para Aguantar y disparar. Se trata de un arma de Tormenta de proyectiles que tiene un alcance de 12”. Utiliza el dado de artillería para determinar el número de impactos automáticos que causa. Puedes, si lo deseas, tirar otra vez el dado de artillería y sumar el resultado al número de impactos que realiza. Sus impactos se resuelven con Fuerza 4 y la regla especial Poder de penetración. Si obtienes un resultado de Problemas a la hora de tirar el dado de artillería por segunda vez, cancela el resultado que hubieras obtenido en la primera tirada.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
