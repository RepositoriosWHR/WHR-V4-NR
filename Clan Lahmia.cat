              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Si la vampira (o su unidad) declaran una carga, el enemigo no podrá declarar Aguantar y disparar o Disparar y huir como reacción a la carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Señora de los mortales" id="4459-bfc0-3b62-38d5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="79da-f128-e9b2-d8a6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e850-f70c-3163-6f6e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Señora de los mortales" id="8707-57de-56f4-ea3a" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Tu ejército puede incluir hasta 2 unidades básicas y hasta 1 héroe (indicado entre paréntesis en cada caso) del libro de ejército del Imperio (Capitán o Hechicero), de Bretonia (Paladín, Castellano o Bardo), de Kislev (Boyardo o Atamán), de Estalia (Capitán, Maestro esgrimista o Mago) o de Mercenarios (Capitán o Hechicero). Contarán como opciones de Unidad básica. Obtienen las reglas especiales ¡Están vivos! (esta regla sirve meramente como un recordatorio de que las miniaturas con esta regla especial no están sujetos a la regla especial No muertos. Sin embargo, un personaje no muerto puede unirse a ellas. Mientras suceda esto, la unidad será Inmune a la psicología, pero el personaje perderá su regla Inestable mientras queden miniaturas vivas en la unidad; deberá huir con su unidad si esta huye, pero se reagrupará automáticamente al final de la fase en la que huyó; ten en cuenta que deben chequear Pánico por muerte del General) e Inmunes a Miedo, y elegirán sus objetos mágicos del Reglamento o de este libro de ejército.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Mortales" id="936f-435b-5d14-dda8" collective="false" hidden="false" import="true">
              <constraints>
                <constraint id="d526-53c5-180c-0fb3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <entryLinks>
                <entryLink name="Bretonia" id="2653-0975-f230-49ce" collective="false" hidden="false" import="true" targetId="2412-0ca5-f66a-41d5" type="selectionEntry"/>
                <entryLink name="Imperio" id="9e07-784e-be9e-f4ce" collective="false" hidden="false" import="true" targetId="dc7a-9134-bae7-148f" type="selectionEntry"/>
                <entryLink name="Kislev" id="c722-4cfd-c7e0-864a" collective="false" hidden="false" import="true" targetId="eaab-93e6-3c79-ac10" type="selectionEntry"/>
                <entryLink name="Estalia" id="dcdb-f917-5e8a-d84c" collective="false" hidden="false" import="true" targetId="3a5a-6519-1189-d98d" type="selectionEntry"/>
                <entryLink name="Mercenarios" id="1c46-5cbb-50e1-4728" collective="false" hidden="false" import="true" targetId="4a57-ac21-c941-dc52" type="selectionEntry"/>
