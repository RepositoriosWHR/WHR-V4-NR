          <characteristics>
            <characteristic name="Reglas especiales" typeId="c4cf-8a88-2aaa-0b2b">Causan Miedo. El Senescal de la Orden causa Terror.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
