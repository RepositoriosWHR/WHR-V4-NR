              <profiles>
                <profile name="Festín de sangre" id="af47-cd6e-68c3-011c" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira obtiene un bonificador de +2 a sus tiradas para ver si recupera heridas al causarlas por su regla especial Vampiro (es decir, por cada herida que cause en combate cuerpo a cuerpo, recuperará una herida con un resultado de 3+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Dominación" id="a98e-047d-ddfc-6169" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="03f4-3a5e-9606-314a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="aee7-039e-631e-8701" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
