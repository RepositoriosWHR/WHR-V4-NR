    <selectionEntry name="[E] - Imentet, Señora suprema de las Doncellas de Neferata" id="3423-456a-5a63-57c5" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="ae2f-0dbe-7ee1-6c90" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
