    <selectionEntryGroup name="Artefactos arcanos. Clan Lahmia" id="ec6d-ffe1-d848-bb1f" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5ab6-119a-0c2e-d6e2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="1aed-a311-b570-a536" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Familiar felino" id="0a20-b46f-4d3b-b855" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b582-4f03-8324-5811" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="57a7-4908-3e7f-c93d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Familiar felino" id="8125-bcfd-32d4-1771" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">La portadora obtiene un bonificador de +1 a sus tiradas de canalizar y puede lanzar el hechizo Vuelo de bruja del saber de Magia Oscura como si lo conociese; ten en cuenta que no conoce el hechizo, no puede perderlo, no tiene la regla del saber de Magia Oscura ni tampoco le limita el acceso al hechizo identificativo del saber que conozca. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
            <profile name="[2] - Vuelo de bruja" id="8706-389a-d225-9757" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">8+/13+</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">Lanzador</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo al propio lanzador. El lanzador realiza inmediatamente un movimiento como si tuviera la regla especial Volar (10). El lanzador puede decidir realizar una carga o marcha con este movimiento. Si el lanzador tiene Potencia de unidad de 5+, la dificultad del hechizo será de 13+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Talismán negro" id="a123-a529-bb54-4f51" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5dec-1926-791a-3442" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f189-f777-564f-2a5b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Talismán negro" id="4eb5-dad0-3c57-bdc2" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Permite a su portador guardar un dado de Energía o Dispersión no utilizado al final de cualquier fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El libro de la Serpiente" id="71c9-bda1-54fb-0e08" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="43e8-d7b8-888e-3975" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="644d-1446-a53a-d5ac" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El libro de la Serpiente" id="5c23-c97e-0275-d844" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de daño directo con un alcance de 18” que causa 3D6 impactos de F2; los resultados de 6 en las tiradas para herir no permiten tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Clan Lahmia" id="9a4e-5f41-d757-ebaa" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="88af-2ac7-19e1-0868" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
        <constraint id="25c4-b15d-cb3c-4e13" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pabellón del Áspid" id="917a-723f-25f9-b5b7" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="43da-6331-bf31-7fd9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7b07-738c-c3ec-13b2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pabellón del Áspid" id="889b-b71a-6b1e-d0dd" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas de la unidad que disparen utilizando flechas áspid pueden repetir los resultados de 1 en sus tiradas para impactar con proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de los lamentos" id="36f9-f34c-f69f-cad7" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
