              </constraints>
              <profiles>
                <profile id="3734-d3eb-e222-d372" name="Bastet" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada uno de sus turnos, Neferata puede enviar a Bastet junto a una unidad enemiga en cualquier punto del campo de batalla. Bastet no puede ser herido, cargado u objetivo de disparos o hechizos; se considera un marcador. Mientras Bastet esté junto a una unidad, esta tendrá un penalizador de -1 a su Liderazgo y deberá repetir todas las tiradas de salvación por armadura que realice con éxito.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="af51-2fd0-72a2-a415" name="Daga de jade" hidden="false" collective="false" import="true" type="upgrade">
