            <infoLink name="Arco lahmiano" id="1fd1-8539-3188-3693" hidden="false" targetId="c2af-c6b6-09d2-be2a" type="profile"/>
            <infoLink name="Heridas múltiples (1D3)" id="adb6-7943-7d18-ff2c" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
