            <profile name="Duelista" id="3c93-a640-4ef8-9320" hidden="false" typeId="6ee7-392c-a063-747a" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="234f-f450-4b0e-298b">El guerrero no podrá equiparse con escudo o armaduras que no sean ligeras. Obtendrá las reglas especiales Esquivar (5+) y Orgullo marcial, y podrá repetir sus tiradas para impactar no superadas luchando en un desafío.</characteristic>
              </characteristics>
