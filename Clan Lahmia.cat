      <infoLinks>
        <infoLink name="Odio" id="6a29-2735-9a9e-843b" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(No muertos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <profiles>
        <profile name="Caballeros del Sol Llameante" id="979d-fff0-e539-eeb2" hidden="false" typeId="d770-cf20-fa38-47ec" typeName="Orden de caballería">
          <characteristics>
            <characteristic name="Reglas especiales" typeId="c4cf-8a88-2aaa-0b2b">Odio (No muertos); además, debido a sus escudos bruñidos como espejos, los enemigos tendrán un penalizador de -1 para impactarlos en combate cuerpo a cuerpo durante cualquier turno en el que el Sol Llameante realice una carga exitosa. El Senescal de la Orden y su unidad pueden repetir todas sus tiradas fallidas para impactar contra No muertos.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Caballeros del Sudario de Morr" id="ed0e-4900-d550-32e5" collective="false" hidden="false" import="true" type="upgrade">
