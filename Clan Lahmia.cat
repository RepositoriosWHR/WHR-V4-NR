        <entryLink name="Plegarias del Templo de la Sangre" id="48b9-1514-3078-d264" collective="false" hidden="false" import="true" targetId="ad2a-bb7e-2d87-8651" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="No Muerto (1)" id="3dcc-807d-35ab-8004" hidden="false" targetId="467a-3f64-3c89-09ba" type="rule"/>
