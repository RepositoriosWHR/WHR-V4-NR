        <selectionEntry id="060f-bbc6-3223-183a" name="Virtud del ardor caballeresco" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e557-2c14-f5e9-c683" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f167-0c4b-13d1-4800" type="max"/>
          </constraints>
          <profiles>
            <profile id="015e-436b-9bb4-5d9a" name="Virtud del ardor caballeresco" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Por cada herida causada en combate por el personaje, podrá efectuar un ataque adicional en la siguiente fase de combate. No puede generar más ataques de los que posea en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="c29a-101e-deec-3025" name="Virtud de la heroicidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3a59-8093-71c5-30e4" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f23c-e6ad-95ac-9074" type="max"/>
          </constraints>
          <profiles>
            <profile id="cac4-b361-d727-c9ec" name="Virtud de la heroicidad" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Los ataques realizados por el personaje y su montura contra miniaturas del tipo Infantería monstruosa, Bestia monstruosa, Caballería monstruosa o Monstruo podrán repetir las tiradas para herir fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="3251-b52d-a279-4419" name="Virtud del cruzado" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="20da-ffdd-1ac3-4c53" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2330-f0e2-16e8-81e3" type="max"/>
          </constraints>
          <profiles>
            <profile id="d3db-622e-de21-064a" name="Virtud del cruzado" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje podrá elegir uno de sus objetos mágicos (no Reliquias) de entre los de las listas de ejército de Nehekhara, La Tierra Bendita o Rasetra. Todas las miniaturas del ejército del libro al que pertenezca el objeto ganarán la regla Odio contra este personaje.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="ee84-5fd6-fa1f-8a58" name="Virtud del ímpetu" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3cb6-b0c4-2e31-3a62" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="aac1-732a-a823-0098" type="max"/>
          </constraints>
          <profiles>
            <profile id="111b-9006-b12d-fcb2" name="Virtud del ímpetu" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje y la unidad en la que se encuentre podrán añadir 1D3” adicionales a cualquier movimiento de carga que efectúen.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8cbe-205c-38ca-173c" name="Virtud de la justa" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7737-3100-51f8-6da3" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3864-e92f-4247-ee9d" type="max"/>
          </constraints>
          <profiles>
            <profile id="c7bf-a2d9-c28c-d508" name="Virtud de la justa" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje podrá repetir las tiradas para impactar cuando use una Lanza de caballería.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f493-540d-1091-fe45" name="Virtud del noble desdén" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9aeb-f508-084d-203d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="21ae-b107-9814-276c" type="max"/>
          </constraints>
          <profiles>
            <profile id="cc98-669c-066e-0e6d" name="Virtud del noble desdén" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene la regla especial Odio contra todas las miniaturas enemigas equipadas con armas de proyectiles y/o capaces de lanzar hechizos. Además, la unidad en la que se incluya el caballero con esta Virtud no deberá chequear Pánico por bajas sufridas por proyectiles o magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1570-a9dd-ff70-1ab6" name="Odio" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(Armas de proyectiles y/o lanzar hechizos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="dab5-6505-a3a9-e64e" name="Virtud de la confianza" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="69fd-c59f-993d-0fae" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6099-2b31-b9f9-e8e0" type="max"/>
          </constraints>
          <profiles>
            <profile id="e153-bae0-8c0a-68a6" name="Virtud de la confianza" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene la regla especial Orgullo marcial y obtiene un bonificador de +1 a sus tiradas para impactar 
durante los Desafíos en los que participe.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="790f-67f2-7821-d50c" name="Orgullo marcial" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="3989-2587-3418-c1ef" name="Virtud de la pureza" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="800d-70f7-3e26-b826" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b180-f7ab-7f83-17a2" type="max"/>
          </constraints>
          <profiles>
            <profile id="047f-2dd9-470b-f7af" name="Virtud de la pureza" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene la regla especial Resistencia mágica (1), que se incrementa a Resistencia mágica (3) contra todos los hechizos de los Saberes del Viento de Magia Oscura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="88f7-c722-22dd-2161" name="Resistencia a la magia (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b98e-14fb-a372-f8ed" name="Virtud del tesón" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7a25-eb92-896c-bfcf" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="de46-4a3c-21f7-0b17" type="max"/>
          </constraints>
          <profiles>
            <profile id="0650-3b3d-d186-5ba1" name="Virtud del tesón" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje y la unidad en la que se encuentre podrá repetir sus tiradas de carga fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="e1a2-2dcd-c361-4140" name="Virtud del valor" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="71f4-16d5-facb-628e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0037-6f96-4201-b93d" type="max"/>
          </constraints>
          <profiles>
            <profile id="787d-5f0a-a933-a27c" name="Virtud del valor" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Cuando el personaje ataque en combate cuerpo a cuerpo a un enemigo con un valor de Fuerza superior al suyo, puede repetir todas sus tiradas fallidas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="381c-09fe-04db-652e" name="Virtud de la disciplina" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="12ae-e0a8-8529-1fa7" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="36cf-5d0e-9072-cd64" type="max"/>
          </constraints>
          <profiles>
            <profile id="2626-be75-4e2f-26b9" name="Virtud de la disciplina" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Un solo uso. Al inicio de cualquier turno bretoniano, si el personaje no está trabado en combate, puede tratar de superar un chequeo de Liderazgo. Si lo supera, él y su unidad podrán realizar una maniobra de reformar de forma gratuita inmediatamente. No puede reorganizar filas ni columnas ni cambiar de formación. Sin embargo, si falla, no podrá mover ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d422-0138-2854-68c9" name="Virtud del estoicismo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="97a7-6221-2ac3-c7f3" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4479-cf40-ddb8-1a12" type="max"/>
          </constraints>
          <profiles>
            <profile id="0513-87f0-9d81-9cee" name="Virtud del estoicismo" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje y la unidad en la que se encuentre obtienen la regla especial Impasible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="6bed-0906-b8d0-1856" name="Impasible" hidden="false" targetId="592b-c850-fd09-cce5" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9380-3782-d54e-8c04" name="Virtud del deber" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="692f-8067-5428-f399" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="28f5-192e-e521-54ac" type="max"/>
          </constraints>
          <profiles>
            <profile id="47e0-2386-01eb-5d3b" name="Virtud del deber" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje otorgará un bonificador de +1 en la resolución de aquellos combates en los que participe. Este efecto podrá usarse sólo mientras el General del ejercito siga con vida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b609-57ce-d7db-6cdf" name="Virtud del penitente" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="82a1-cda6-6ca2-890d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="124f-42a6-a4cf-ca3d" type="max"/>
          </constraints>
          <profiles>
            <profile id="2cb1-0848-de1f-eb22" name="Virtud del penitente" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje no podrá ser General ni Portaestandarte de batalla del ejercito. El personaje obtiene la regla especial Indesmoralizable y su tirada de salvación especial obtenida por la Favor de la Dama mejora hasta 4+ pero no podrá equiparse con objetos mágicos de ningún tipo y sólo podrá montar en Corcel bretoniano.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="371b-2e81-6ffb-2c91" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="063e-1895-fb16-8cbe" name="Virtudes. Voto de la busqueda" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4c2f-69cb-3575-d8af" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7e77-8677-7079-b59d" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="a269-1547-968c-5479" name="Virtud de la venganza" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="31f4-2dda-f1a7-e9c2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2f51-7db1-d8fc-4310" type="max"/>
          </constraints>
          <profiles>
            <profile id="e9a5-036f-495f-0f62" name="Virtud de la venganza" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje debe unirse a una unidad de Caballeros errantes y no podrá abandonarla. Al inicio de la batalla, tras el despliegue, selecciona una unidad enemiga: tanto el personaje como la unidad de Caballeros errantes en la que se encuentre podrán repetir sus tiradas para impactar fallidas contra la unidad seleccionada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="bc83-8d66-6f43-9b98" name="Virtud de la audacia" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1ac6-73b6-1ee7-6f39" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d4ef-4442-0bb3-0201" type="max"/>
          </constraints>
          <profiles>
            <profile id="a35f-d6a0-539f-890e" name="Virtud de la audacia" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje puede repetir sus tiradas para impactar con Arma a dos manos. Adicionalmente, el turno en el que realice una carga exitosa no aplicará la regla especial Lenta de su Arma a dos manos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="cf24-6705-02b3-9fc6" name="Virtudes. Voto del caballero" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7517-9905-29d7-b017" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="60f9-ffa4-cfc0-1765" name="Virtud del ideal" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2c6e-ded3-df4e-7ff6" type="max"/>
