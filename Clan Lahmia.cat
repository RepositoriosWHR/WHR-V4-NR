          <profiles>
            <profile name="Bandido" id="4540-b977-3510-fe06" hidden="false" typeId="6ee7-392c-a063-747a" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="234f-f450-4b0e-298b">No puede ser el general. Otorga al personaje y a la unidad junto a la que se incluya la regla especial Explorador. Solamente las unidades de infantería con potencia de unidad 15 o inferior pueden beneficiarse de esta regla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Reservado" id="ea9f-ae44-d65c-def9" collective="false" hidden="false" import="true" type="upgrade">
