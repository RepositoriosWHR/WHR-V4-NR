                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Dominación" id="30d1-28d8-c8c4-ded5" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Al inicio de cada fase de combate, selecciona una miniatura enemiga en contacto peana con peana con la vampira, que deberá efectuar un chequeo de Liderazgo. Si lo falla, no podrá atacar este turno y todos los ataques que se dirijan contra él impactarán automáticamente.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Hipnotismo" id="36b6-e9e4-145a-3a04" collective="false" hidden="false" import="true" type="upgrade">
