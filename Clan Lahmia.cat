            <infoLink name="Tozudez" id="b32f-6a8d-1e61-2e5f" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Virtud del santuario" id="abea-f8e6-f00e-7007" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene las reglas especiales Tozudez y Resistencia mágica (2) y no puede llevar montura de ningún tipo. Debe unirse a una unidad de Guardianes del santuario del Grial y no podrá abandonarla. Una miniatura con esta Virtud no podrá ser ni General ni Portaestandarte de batalla del ejercito.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Tropas condales (Unidad)" id="e055-7c73-613f-5d62" collective="false" hidden="false" import="true">
