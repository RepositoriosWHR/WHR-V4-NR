            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la justa" id="c7bf-a2d9-c28c-d508" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje podrá repetir las tiradas para impactar cuando use una Lanza de caballería.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del noble desdén" id="f493-540d-1091-fe45" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9aeb-f508-084d-203d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="21ae-b107-9814-276c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio" id="1570-a9dd-ff70-1ab6" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Armas de proyectiles y/o lanzar hechizos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Virtud del noble desdén" id="cc98-669c-066e-0e6d" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene la regla especial Odio contra todas las miniaturas enemigas equipadas con armas de proyectiles y/o capaces de lanzar hechizos. Además, la unidad en la que se incluya el caballero con esta Virtud no deberá chequear Pánico por bajas sufridas por proyectiles o magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la confianza" id="dab5-6505-a3a9-e64e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="69fd-c59f-993d-0fae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6099-2b31-b9f9-e8e0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Orgullo marcial" id="790f-67f2-7821-d50c" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Virtud de la confianza" id="e153-bae0-8c0a-68a6" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene la regla especial Orgullo marcial y obtiene un bonificador de +1 a sus tiradas para impactar 
durante los Desafíos en los que participe.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la pureza" id="3989-2587-3418-c1ef" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="800d-70f7-3e26-b826" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b180-f7ab-7f83-17a2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (1)" id="88f7-c722-22dd-2161" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Virtud de la pureza" id="047f-2dd9-470b-f7af" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene la regla especial Resistencia mágica (1), que se incrementa a Resistencia mágica (3) contra todos los hechizos de los Saberes del Viento de Magia Oscura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del tesón" id="b98e-14fb-a372-f8ed" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7a25-eb92-896c-bfcf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="de46-4a3c-21f7-0b17" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud del tesón" id="0650-3b3d-d186-5ba1" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje y la unidad en la que se encuentre podrá repetir sus tiradas de carga fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del valor" id="e1a2-2dcd-c361-4140" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="71f4-16d5-facb-628e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0037-6f96-4201-b93d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud del valor" id="787d-5f0a-a933-a27c" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Cuando el personaje ataque en combate cuerpo a cuerpo a un enemigo con un valor de Fuerza superior al suyo, puede repetir todas sus tiradas fallidas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la disciplina" id="381c-09fe-04db-652e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="12ae-e0a8-8529-1fa7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="36cf-5d0e-9072-cd64" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la disciplina" id="2626-be75-4e2f-26b9" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Un solo uso. Al inicio de cualquier turno bretoniano, si el personaje no está trabado en combate, puede tratar de superar un chequeo de Liderazgo. Si lo supera, él y su unidad podrán realizar una maniobra de reformar de forma gratuita inmediatamente. No puede reorganizar filas ni columnas ni cambiar de formación. Sin embargo, si falla, no podrá mover ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del estoicismo" id="d422-0138-2854-68c9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="97a7-6221-2ac3-c7f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4479-cf40-ddb8-1a12" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Impasible" id="6bed-0906-b8d0-1856" hidden="false" targetId="592b-c850-fd09-cce5" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Virtud del estoicismo" id="0513-87f0-9d81-9cee" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje y la unidad en la que se encuentre obtienen la regla especial Impasible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del deber" id="9380-3782-d54e-8c04" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="692f-8067-5428-f399" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="28f5-192e-e521-54ac" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud del deber" id="47e0-2386-01eb-5d3b" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje otorgará un bonificador de +1 en la resolución de aquellos combates en los que participe. Este efecto podrá usarse sólo mientras el General del ejercito siga con vida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del penitente" id="b609-57ce-d7db-6cdf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="82a1-cda6-6ca2-890d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="124f-42a6-a4cf-ca3d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Indesmoralizable" id="371b-2e81-6ffb-2c91" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Virtud del penitente" id="2cb1-0848-de1f-eb22" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje no podrá ser General ni Portaestandarte de batalla del ejercito. El personaje obtiene la regla especial Indesmoralizable y su tirada de salvación especial obtenida por la Favor de la Dama mejora hasta 4+ pero no podrá equiparse con objetos mágicos de ningún tipo y sólo podrá montar en Corcel bretoniano.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes. Voto de la busqueda" id="063e-1895-fb16-8cbe" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4c2f-69cb-3575-d8af" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7e77-8677-7079-b59d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Virtud de la venganza" id="a269-1547-968c-5479" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="31f4-2dda-f1a7-e9c2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2f51-7db1-d8fc-4310" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la venganza" id="e9a5-036f-495f-0f62" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje debe unirse a una unidad de Caballeros errantes y no podrá abandonarla. Al inicio de la batalla, tras el despliegue, selecciona una unidad enemiga: tanto el personaje como la unidad de Caballeros errantes en la que se encuentre podrán repetir sus tiradas para impactar fallidas contra la unidad seleccionada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la audacia" id="bc83-8d66-6f43-9b98" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1ac6-73b6-1ee7-6f39" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d4ef-4442-0bb3-0201" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la audacia" id="a35f-d6a0-539f-890e" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje puede repetir sus tiradas para impactar con Arma a dos manos. Adicionalmente, el turno en el que realice una carga exitosa no aplicará la regla especial Lenta de su Arma a dos manos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes. Voto del caballero" id="cf24-6705-02b3-9fc6" collective="false" hidden="false" import="true">
      <constraints>
