    <selectionEntry id="6f3a-1786-f654-a908" name="[K] - Lanceros alados" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="eaab-93e6-3c79-ac10" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="3472-f2e3-9039-cc91" name="Jinetes legendarios" hidden="false">
          <description>Los Lanceros alados de Kislev tienen la regla especial Caballería rápida pese a su elevada tirada de salvación por armadura. Un Comandante 
kislevita o un Boyardo que monten un Caballo de guerra sin Barda pueden unirse a esta unidad y no perderán la regla especial Caballería rápida.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8fe4-65d8-2afa-f296" name="Caballería" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
