            <profile name="Capitán veterano" id="0711-e17c-c512-357a" hidden="false" typeId="6ee7-392c-a063-747a" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="234f-f450-4b0e-298b">El personaje será Inmune a pánico. Además, el personaje cuenta como si fuese una unidad de Piqueros o Infantería ligera a la hora de incluir una unidad de Infantería pesada en tu ejército.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
