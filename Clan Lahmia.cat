    <selectionEntry name="Caballeros de la Lanza Justiciera" id="b228-3c42-7fc6-d9fb" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="0dfd-8d2d-c660-471f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
