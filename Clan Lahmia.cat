        <infoLink id="c52e-d23f-d44b-5b09" name="Orgullo marcial" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
        <infoLink id="8092-52ec-d725-f711" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Cuerpo a cuerpo)"/>
