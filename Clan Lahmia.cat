          </costs>
          <profiles>
            <profile name="Don del Áspid" id="93d2-1e9a-ef64-80b2" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira obtiene la regla especial Ataques envenenados; además, sus Ataques envenenados exitosos (tanto en cuerpo a cuerpo como con proyectiles) se resolverán con la regla especial Heridas múltiples (1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampíricos del clan Lahmia. Poder mayor" id="cc11-09c1-cc88-9ae8" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ade5-2219-10ec-b925" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Criatura de la noche" id="e7e4-ef92-4178-2dba" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9c52-40f6-bdd7-08dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e12d-81b4-f542-9ffa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Criatura de la noche" id="6428-6559-a4a9-c8c9" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">No puede elegirse este poder para miniaturas con Potencia de unidad de 5 o superior. En combate cuerpo a cuerpo y con proyectiles, la vampira sólo puede ser impactada con resultados naturales de 6, sin tener en cuenta otros modificadores. No tiene efecto alguno contra ataques que no tiren para impactar o que impacten automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Maestra de la ilusión" id="75eb-2083-accb-3327" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="71a5-6d3a-10ce-ab4b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cbb8-ea65-9638-245d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Maestra de la ilusión" id="93cb-e0a2-7603-1efa" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Cuando la vampira declare un Desafío, éste no puede ser rechazado y puede elegir qué personaje enemigo aceptará su Desafío (esto tiene prioridad sobre la regla especial Orgullo marcial).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Forma espectral" id="809a-56d1-b401-1090" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="172b-e2eb-8b29-86e1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ae64-31d3-c0aa-53d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Forma espectral" id="48d8-cf6b-265c-4e3c" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">No puede elegirse este poder para miniaturas con Potencia de unidad de 5 o superior. La vampira obtiene la regla especial Etéreo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Seducción" id="d27c-0ee1-7388-c693" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="744c-8f91-b09a-9a92" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a9cf-e316-b82d-9d3a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Seducción" id="5a48-afc7-3715-ba32" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Al inicio de cualquier fase de combate cuerpo a cuerpo propia, puedes elegir una miniatura enemiga que no tenga la regla especial Inmune a psicología en contacto peana con peana con la vampira. Esa miniatura deberá efectuar un chequeo de Liderazgo con su valor básico sin modificar (no puede utilizarse ni la Presencia inspiradora). Si lo supera, no pasará nada; pero si lo falla, esa miniatura pasará a estar controlada por el jugador vampiro durante el resto de la partida. Si se encontraba en una unidad, debe separarse inmediatamente de ella. Este poder puede utilizarse una vez por fase de combate cuerpo a cuerpo propia, pero tan sólo se puede controlar una miniatura enemiga durante la batalla (es decir, puede usarse las veces que sean necesarias hasta que tenga éxito, momento en el cual no podrá usarse más).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampíricos del clan Lahmia. Poder menor. General" id="462b-87f4-1326-cf47" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ef91-ed63-b84b-9129" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Alianza impía" id="ecf2-0ee4-02ee-04b7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8ea1-1c65-c1e9-9acb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="19e3-d5fd-7b6e-c02c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Alianza impía" id="5bdd-f95c-dc8a-7dd6" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Sólo general del ejército. El ejército pasa a considerarse un ejército Neutral (deja de ser un ejército de la Destrucción), y su alianza con los ejércitos de Imperio, Bretonia, Kislev, Mercenarios, Norsca, Nippón, Catay, Arabya, Middenland, Halflings de la Asamblea, Tren de Artillería de Nuln, Chevaliers de Lyonesse, Estalia, Marienburgo y cualquier otro ejército con la clave humanos mejora en un paso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Clan Lahmia. Arma de mano" id="3c61-4f51-9cdf-90ba" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c953-86fe-bd42-b063" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
