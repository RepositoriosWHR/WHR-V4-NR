          <profiles>
            <profile id="eca6-e0c5-b7ba-2139" name="Virtud del ideal" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene un bonificador de +1 en sus perfiles de atributos de HA, F, I, A y L. No puede unirse a unidades. Si muere o huye del campo de batalla, el enemigo obtendrá 100 puntos de victoria adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4811-4889-ab4a-5b07" name="Virtud de la empatía" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="99b3-7bd5-da05-7be9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a6ca-d504-1540-8fda" type="max"/>
          </constraints>
          <profiles>
            <profile id="e769-a335-33d2-9dd3" name="Virtud de la empatía" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje no podrá ser General ni Portaestandarte de batalla del ejercito. El personaje no podrá adquirir ninguna montura, perderá la regla especial Caballero (pero no el Favor de la Dama) y obtendrá un +1 a su atributo de Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
