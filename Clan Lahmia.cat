            <profile name="Filo de jade catayano" id="12f1-6e62-5b7b-7ea7" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Pueden repetirse las tiradas fallidas para herir realizadas con este arma. Las heridas causadas por este arma no permiten tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Clan Lahmia. Armas de mano. Hechiceros" id="8385-6709-7b08-c13f" collective="false" hidden="false" import="true">
