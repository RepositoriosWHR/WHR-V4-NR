            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estirpe inmortal" id="321a-6275-efa6-1d3e" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">La vampira es inmune a los efectos de las reglas especiales Golpe letal y Golpe letal heroico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Don del Áspid" id="b9ad-8df1-c999-0231" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5da3-f792-5955-5be1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ff18-317d-26ed-595b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
