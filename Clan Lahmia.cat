            <profile id="a4b3-06c8-aa34-164a" name="Arco de Asaph" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco lahmiano. Tiene la regla especial Disparos múltiples (3).</characteristic>
