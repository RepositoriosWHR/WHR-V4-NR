              <characteristics>
                <characteristic name="Reglas especiales" typeId="234f-f450-4b0e-298b">El personaje equipado con pistola. Cuando el personaje sufre una herida en cuerpo a cuerpo, puede automáticamente realizar un ataque con su pistola (fuerza de la secuenta habitual) contra la miniatura o unidad que el causó la herida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
