    <selectionEntry id="e153-43de-8471-cdd7" name="[Est][H] - Maestro esgrimista" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3a5a-6519-1189-d98d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="f1cf-17b6-005d-a556" name="Técnicas de duelo" hidden="false">
          <description>Al inicio de cada ronda de combate, el Maestro debe seleccionar uno de los siguientes estilos de lucha. No puede repetir estilo de una ronda a la siguiente del mismo combate:
- Presto: El Maestro obtiene un bonificador de +3 a su Iniciativa durante esa ronda de combate.
- Certero: El Maestro puede repetir las tiradas para impactar fallidas durante esa ronda de combate.
- Imbatible: El Maestro puede repetir sus tiradas fallidas de Esquivar durante esa ronda de combate.
- Vivaz: El Maestro obtiene la regla Impactos múltiples (2) durante esa ronda de combate.</description>
        </rule>
        <rule id="c4c1-538d-f3e9-53f9" name="Verdadera destreza" hidden="false">
          <description>El Maestro esgrimista sólo puede equiparse con armaduras mágicas de tipo Armadura ligera.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="40ae-e330-4b9e-2ea0" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="39da-dcf8-3ec3-190b" name="Disciplina estaliana" hidden="false" targetId="1013-dab2-bf74-b3d9" type="rule"/>
