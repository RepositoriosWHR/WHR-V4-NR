                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Resta 1 a la Fuerza de todos los impactos contra la vampira.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Festín de sangre" id="8e62-960d-9e5f-49df" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
