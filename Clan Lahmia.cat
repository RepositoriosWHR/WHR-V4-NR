          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="a32b-fe69-fdc5-d565" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Cetro de Áspid" id="3fe6-dc9d-537a-af43" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo vampiros. La portadora y su unidad obtendrán la regla especial Ataques envenenados. En el caso de la portadora, éstos tendrán efecto también con resultados naturales de 5 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Virtudes" id="1dbf-dec8-6228-a8c4" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="0b6a-4840-fc18-914f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="9dd3-2437-2697-f31c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Virtud del ardor caballeresco" id="060f-bbc6-3223-183a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e557-2c14-f5e9-c683" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f167-0c4b-13d1-4800" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud del ardor caballeresco" id="015e-436b-9bb4-5d9a" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Por cada herida causada en combate por el personaje, podrá efectuar un ataque adicional en la siguiente fase de combate. No puede generar más ataques de los que posea en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la heroicidad" id="c29a-101e-deec-3025" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3a59-8093-71c5-30e4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f23c-e6ad-95ac-9074" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud de la heroicidad" id="cac4-b361-d727-c9ec" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">Los ataques realizados por el personaje y su montura contra miniaturas del tipo Infantería monstruosa, Bestia monstruosa, Caballería monstruosa o Monstruo podrán repetir las tiradas para herir fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del cruzado" id="3251-b52d-a279-4419" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="20da-ffdd-1ac3-4c53" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2330-f0e2-16e8-81e3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud del cruzado" id="d3db-622e-de21-064a" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje podrá elegir uno de sus objetos mágicos (no Reliquias) de entre los de las listas de ejército de Nehekhara, La Tierra Bendita o Rasetra. Todas las miniaturas del ejército del libro al que pertenezca el objeto ganarán la regla Odio contra este personaje.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud del ímpetu" id="ee84-5fd6-fa1f-8a58" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3cb6-b0c4-2e31-3a62" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="aac1-732a-a823-0098" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Virtud del ímpetu" id="111b-9006-b12d-fcb2" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje y la unidad en la que se encuentre podrán añadir 1D3” adicionales a cualquier movimiento de carga que efectúen.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Virtud de la justa" id="8cbe-205c-38ca-173c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7737-3100-51f8-6da3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3864-e92f-4247-ee9d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
