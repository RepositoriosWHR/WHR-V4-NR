          </infoLinks>
          <profiles>
            <profile name="Arco de Djaf" id="659d-7b01-1a42-72c0" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco Lahmiano. Los disparos de este arco se resuelven como si fuese un lanzavirotes (F6, Heridas múltiples [1D3], no permite tiradas de salvación por armadura, Atraviesa filas) pero con un alcance de 24”; puede mover y disparar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampíricos del clan Lahmia. Poder mayor. General" id="cc14-1618-5b88-d0a8" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="adff-26b5-60e4-2136" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Reina de la noche" id="3114-25de-af68-52d3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f8ea-5562-e124-ef5b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
            <constraint id="3317-d311-98c7-58eb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1d5c-df15-6ea4-03b0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Reina de la noche" id="f396-6414-a175-4012" hidden="false" typeId="9680-f788-862f-a30d" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="b0e0-e0cf-2cd1-3ec3">Sólo General del ejército. Al inicio de la batalla, antes del despliegue, elige una unidad enemiga y tira 1D6: si obtienes un resultado de 6, esa unidad ha quedado embaucada (ver más adelante); si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 5+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 4+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 3+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y tira 1D6: si obtienes un resultado de 2+, esa unidad ha quedado embaucada; si no, elige otra unidad enemiga y ésta quedará embaucada. Una unidad embaucada no despliega en el campo de batalla, sino que deberá utilizar la regla de Refuerzos. Tan solo podrá entrar por un segmento de borde dentro de su propia área de despliegue.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Reliquia. Clan Lahmia. Arma de mano" id="c12a-d19d-7038-2113" collective="false" hidden="false" import="true">
