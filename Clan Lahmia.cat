      <rules>
        <rule id="7fce-f536-39e7-59cf" name="Estudioso el Azyr" hidden="false">
          <description>Si el hechicero escoge el Saber de los Cielos tiene un bonificador de +1 a sus tiradas para Canalizar.</description>
        </rule>
        <rule id="babd-326d-f0e1-db68" name="Magia Mago" hidden="false">
          <description>Nivel de magia 1, puede aumentarse a 2 (+30 puntos). Debe elegir sus hechizos de sólo uno de entre los siguientes saberes: Cielos, Luz, Fuego, Vida, Bestias o Sombras.</description>
        </rule>
      </rules>
