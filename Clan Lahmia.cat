          <profiles>
            <profile id="abea-f8e6-f00e-7007" name="Virtud del santuario" hidden="false" typeId="5f3b-0b0e-ccc0-b694" typeName="Virtudes">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a309-853a-03ad-09ca">El personaje obtiene las reglas especiales Tozudez y Resistencia mágica (2) y no puede llevar montura de ningún tipo. Debe unirse a una unidad de Guardianes del santuario del Grial y no podrá abandonarla. Una miniatura con esta Virtud no podrá ser ni General ni Portaestandarte de batalla del ejercito.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8462-f9ab-cd0b-fdc7" name="Resistencia a la magia (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
