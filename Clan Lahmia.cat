            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Reservado" id="177e-dd65-22a6-bf6e" hidden="false" typeId="6ee7-392c-a063-747a" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="234f-f450-4b0e-298b">El personaje no puede otorgar su Liderazgo a ninguna unidad, teniendo que chequear con el L de la propia unidad en caso de que fuera más bajo que el del personaje. El personaje obtiene +1A.</characteristic>
              </characteristics>
            </profile>
          </profiles>
