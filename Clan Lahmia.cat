              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">La portadora obtiene la regla especial Resistencia mágica (2) y será inmune a la regla Heridas múltiples.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
