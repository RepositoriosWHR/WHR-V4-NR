              </infoLinks>
              <profiles>
                <profile name="Espada larga Catayana" id="7a8e-e20b-d8d8-3474" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Se trata de un arma que requiere ambas manos. Al luchar con ella, proporciona a Naaima un bonificador de +1 a su Iniciativa y Ataques, y sus impactos se resuelven con +1 Fuerza y la regla especial Poder de penetración.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Abanico de jade" id="4cfa-1b2f-ba25-854f" collective="false" hidden="false" import="true" type="upgrade">
