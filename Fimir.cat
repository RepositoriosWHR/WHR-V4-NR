              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador (y la unidad en la que se encuentre) obtienen la regla especial Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
