              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Los ataques con este arma tienen un bonificador de +1 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
