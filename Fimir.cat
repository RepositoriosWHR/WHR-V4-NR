    <selectionEntry id="a830-f54b-6df2-4c6b" name="[E] - Fimm Murdaich" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0478-cdd9-d109-5e86" type="max"/>
      </constraints>
      <rules>
        <rule id="78b6-7cdb-4b54-134c" name="Emboscada" hidden="false">
          <description>Al inicio de a batalla, antes del despliegue, puedes seleccionar una de tus unidades de Guerreros Fimir o Fimir Shear de tu ejército para que no despliegue con normalidad y entre como Refuerzos. Cuando la unidad entre al campo de batalla (siguiendo las reglas habituales de Refuerzos), podrá hacerlo  por cualquier borde del tablero (salvo que sea intransitable, como los bordes largos en el escenario “Batalla por el paso”). </description>
        </rule>
        <rule id="5033-9539-b042-04c4" name="Odio (humanos)" hidden="false">
          <description>Murdaich y cualquier unidad a la que se una obtienen la regla especial Odio (humanos). </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="bbc6-8b90-b051-fc26" name="Infantería monstruosa" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink id="8050-6caa-acea-c586" name="La voluntad del Caos" hidden="false" targetId="c6c8-8246-2a57-b2c5" type="rule"/>
        <infoLink id="dcab-b78e-161f-8472" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink id="3d72-232c-3341-d085" name="Piel escamosa (4+)" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink id="1b98-ca14-8667-ce0d" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink id="113b-51cb-672a-aafa" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink id="74a8-5d26-e7fd-b249" name="Odio" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Humanos)"/>
          </modifiers>
        </infoLink>
