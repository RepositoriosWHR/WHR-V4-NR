        <infoLink id="bd6b-12e6-51f3-0f78" name="Cruzar" hidden="false" targetId="7ea4-f7e1-7e21-9266" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Elementos acuáticos)"/>
