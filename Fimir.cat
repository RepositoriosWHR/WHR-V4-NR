        <infoLink id="6eaa-b4f6-de16-3485" name="Piel escamosa (4+)" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink id="4de0-3ee0-49b6-14ea" name="Cruzar (elementos acuáticos)" hidden="false" targetId="54e2-e5df-d64f-2b52" type="rule"/>
