    <selectionEntry id="1479-1569-86e3-e68f" name="[E] - Meris, La Madre Infernal" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="046a-1c36-705e-1c0e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="83e5-4b3b-9c54-0b0f" type="max"/>
      </constraints>
      <rules>
        <rule id="ee52-d312-d86f-c34a" name="Magia Meris, La Madre Infernal" hidden="false">
          <description>Meris es una hechicera de nivel 4 que conoce todos los hechizos del Saber de las Sombras, del Saber de la Muerte y de Magia Oscura.</description>
        </rule>
        <rule id="2644-9cbd-dd41-d0e4" name="Gran Bruja" hidden="false">
          <description>Cada vez que Meris lance o disperse un hechizo, puede repetir la tirada de uno de los dados de energía o dispersión de esa tirada.</description>
        </rule>
        <rule id="67e5-3deb-7005-6d42" name="Protección de Fímul" hidden="false">
          <description>Meris puede efectuar su tirada de salvación por Aura demoníaca incluso ante Ataques mágicos u otros efectos que la nieguen. Además, tiene Resistencia mágica (2), y puede sumar +1 en todas sus tiradas en la tabla de Disfunciones mágicas (los resultados superiores a 12 se consideran 12).</description>
        </rule>
        <rule id="97d3-939d-a454-bf31" name="Cuervos sangrientos de Meris" hidden="false">
          <description>Además de sus ataques, Meris realiza 2D6 ataques adicionales que se resuelven con HA3, F3, I6 y las reglas especiales Poder de penetración y Ataques mágicos.</description>
        </rule>
        <rule id="164f-5d02-168e-4da5" name="Ataque de cola Meris" hidden="false">
          <description>Meris tiene la regla epecial Ataque de cola. Además, el ataque de cola de Meris se resuelve con la regla especial Heridas múltiples (2).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="318a-3fbc-2122-4a6d" name="Leyenda" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink id="c3e5-47c1-ec13-f63a" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="d1ba-7923-5aa6-66e1" name="Señor del conocimiento" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Saber de las Sombras, Muerte y Oscura)"/>
          </modifiers>
        </infoLink>
