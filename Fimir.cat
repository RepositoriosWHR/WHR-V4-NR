            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7489-e1c2-7531-09e6" type="max"/>
          </constraints>
          <profiles>
            <profile id="26ed-da0e-6e04-8ad5" name="Bendición de Fimulneid" hidden="false" typeId="585e-0a14-d225-9f9f" typeName="Don de Fímul">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="99f8-c2c0-3723-0ad0">Al inicio de la batalla, tras el despliegue, efectúa una tirada de 1D6+1: ese será el número de tiradas de dado que el personaje podrá repetir a lo largo de la batalla. Puede tratarse de tiradas para impactar, tiradas para herir, salvaciones (de cualquier tipo), chequeos de atributo o dados de energía o dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
