              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene las reglas especiales Tozudez y Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fetiche Brujo" id="349d-b8bd-9885-d12f" collective="false" hidden="false" import="true" type="upgrade">
