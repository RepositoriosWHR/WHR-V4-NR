    <selectionEntry id="61d4-92ac-ff0f-83c4" name="Jefe Shearl" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="c22e-36d8-469f-a72b" name="Esbirro" hidden="false">
          <description>Los Fimir shearl no provocan chequeos de Pánico en otras unidades con la Marca de Fímul (ni siquiera en otros Fimir shearl). Además, los Fimir shearl pueden usar el Liderazgo de cualquier unidad con la Marca de Fímul a 12” o menos de ellos.</description>
        </rule>
      </rules>
