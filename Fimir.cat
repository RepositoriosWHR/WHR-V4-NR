      <rules>
        <rule name="Magia Rakka Puño de Hierro" id="ebce-1a4d-afdd-57f6" hidden="false">
          <description>Rakka es una hechicera de nivel 4 que puede elegir sus hechizos de entre los saberes de las Sombras, la Muerte y/o Magia Oscura.</description>
        </rule>
        <rule name="Profecía de Zahnarzt (Don de Fímul)" id="6963-4133-0a6d-70c5" hidden="false">
          <description>Rakka conoce el doble de hechizos de lo habitual (para un total de 8). Además, Rakka puede mezclar de entre sus tres saberes disponibles a la hora de elegir sus hechizos.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="General del ejército" id="3865-a788-336d-76ac" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
