              <characteristics>
                <characteristic name="Reglas especiales" typeId="99f8-c2c0-3723-0ad0">Sólo hechiceros. El fimir obtiene la regla especial Señor del conocimiento (Sombras, Muerte o Magia oscura, a su elección).</characteristic>
              </characteristics>
            </profile>
          </profiles>
