          </infoLinks>
          <profiles>
            <profile name="Icono de la Vitalidad de Fímul" id="f31c-dabe-5359-0617" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Regeneración (5+), que aumenta a 4+ si el portador se encuentyra a 6” o menos de algún elemento de terreno acuático.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
