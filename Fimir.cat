            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5a68-2004-ed09-d58e" type="max"/>
          </constraints>
          <profiles>
            <profile id="d6d8-aca4-018e-31e7" name="Mazo de la Ciénaga Negra" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. En cada ronda de combate cuerpo a cuerpo, tras realizar los correspondientes ataques del personaje, cualquier miniatura enemiga que sufra una o más heridas sin salvar del Mazo de la Ciénaga negra y no muera deberá efectuar inmediatamente un chequeo de Resistencia. Si lo falla, deberá ser retirada inmediatamente como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2380-a8ca-6cd9-beab" name="Arma a dos manos" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
