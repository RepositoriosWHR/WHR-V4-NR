              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador y todos los fimir de su unidad ven aumentada su tirada de salvación por piel escamosa en +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
