            <profile name="El Corazón del Fango" id="3cd2-2c09-c649-399d" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene una tirada de salvación especial de 5+; además, será completamente inmune a los efectos de las reglas especiales Golpe letal, Golpe letal heroico y Heridas múltiples.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
