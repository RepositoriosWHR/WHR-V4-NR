            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8d75-ae4f-0ef9-450f" type="max"/>
          </constraints>
          <profiles>
            <profile id="f31c-dabe-5359-0617" name="Icono de la Vitalidad de Fímul" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Regeneración (5+), que aumenta a 4+ si el portador se encuentyra a 6” o menos de algún elemento de terreno acuático.</characteristic>
              </characteristics>
