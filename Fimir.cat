            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la Madre Infernal" id="42be-0b6e-2451-6d68" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades enemigas en contacto peana con peana con el portador y su unidad obtienen la regla especial Lento mientras permanezcan en contacto; si ya disponían de dicha regla especial, su Iniciativa pasará a ser 0 mientras permanezcan en contacto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
