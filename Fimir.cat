          <selectionEntries>
            <selectionEntry id="3e24-45a4-556b-98c5" name="Bastón Demonio de Bronce" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="919d-1475-398c-4ede" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ee10-5f02-4918-f070" type="min"/>
              </constraints>
              <profiles>
                <profile id="2906-3682-493b-50ab" name="Bastón demonio de Bronce" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Rakka puede repetir los resultados de 1 en sus tiradas para impactar y herir. Además, si Rakka mata a un hechicero enemigo en combate cuerpo a cuerpo, obtiene 1D3 dados de energía o dispersión (según corresponda) en la siguiente fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="c37e-a59d-3196-5f5e" name="Arma a dos manos" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="af3e-597d-003e-675a" name="Daga del Sacrificio" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6e15-5dd0-4d38-0fb4" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9561-a39f-8f34-61a2" type="min"/>
              </constraints>
              <profiles>
                <profile id="adfd-4512-10d3-2533" name="Daga del Sacrificio" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de cada fase de magia (propia o del oponente) Rakka puede causarse a sí misma o a otra miniatura de su unidad una o dos heridas (que no podrán salvarse de ninguna forma, aunque podrán regenerarse). Por cada herida causada, Rakka obtiene un dado de energía o dispersión (según corresponda) para esa fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="6301-49fe-4e3d-a4c8" name="Collar de las Almas Ahogadas" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ac98-4c6c-7616-94ef" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="36fa-666a-539f-bce8" type="min"/>
              </constraints>
              <profiles>
                <profile id="82c0-e658-ddef-1869" name="Collar de las Almas Ahogadas" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Rakka y todos los hechiceros amigos a 12” o menos de ella tendrán un bonificador de +1 en sus tiradas de lanzamiento de hechizos. Los hechiceros enemigos a 12” o menos de Rakka tendrán un penalizador de -1 en sus tiradas de lanzamiento de hechizos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="46d4-7bf0-5882-67b1" name="Anillo del Fuego" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="231f-05c9-ae46-5263" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5e67-1d5b-7dc9-3960" type="min"/>
              </constraints>
              <profiles>
                <profile id="901f-4b5f-680c-2e0c" name="Anillo del Fuego" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Rakka es Inmune a fuego. Además, al inicio de cada fase de combate, todas las miniaturas enemigas en contacto peana con peana con Rakka sufrirán un impacto automático de F4 con la regla especial Ataques sólo flamígeros (las heridas causadas por esto cuentan para el resultado del combate).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="3748-7646-fd05-71bb" name="Inmune al fuego" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
          <costs>
            <cost name="pts" typeId="points" value="0.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
