            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4d7b-79da-608b-81b0" type="max"/>
          </constraints>
          <profiles>
            <profile id="0abc-ef46-5c60-dc50" name="Corona del norte" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene las reglas especiales Tozudez y Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
