        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b5b3-d8d7-d642-5479" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="4b00-4ce1-22a3-2bdd" name="Familiar del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4da0-ef79-7e7b-9685" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f9df-2b10-09c6-776a" type="max"/>
          </constraints>
          <profiles>
            <profile id="4b60-4868-2e64-b9d6" name="Familiar del Caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El hechicero genera un dado adicional de Energía y Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a947-e21d-680b-5508" name="Bastón Rúnico del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="058b-7336-3573-96ed" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e1ca-1d5d-d0f9-37e6" type="max"/>
          </constraints>
          <profiles>
            <profile id="abe5-6356-9021-0717" name="Bastón Rúnico del Caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, puedes robar uno de los dados de dispersión de tu oponente y añadirlo a tu reserva de dados de energía.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="36ff-85f7-2324-ef70" name="Collar de cabezas de brujo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="37df-b5d4-a896-ed5b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c0fb-77cf-3149-826f" type="max"/>
          </constraints>
          <profiles>
            <profile id="c891-979a-f639-b344" name="Collar de cabezas de brujo" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, determina al azar un hechizo en la siguiente tabla: el Collar actúa como un objeto portahechizos con nivel de energía 1D3+1, lanzando el hechizo indicado (no puede lanzarse la versión potenciada de ninguno de los hechizos). 
1D6: 
1 Oscura mano de destrucción (Magia Oscura) 
2 Portento de Phar (Saber de los Cielos) 
3 Miasma mística de Melkoth (Saber de las Sombras) 
4 Forma salvaje de Wyssan (Saber de las Bestias) 
5 Furia primitiva (Magia Oscura) 
6 Malicia de Khaine (Magia Oscura)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f3c5-b4d7-2671-5351" name="Placa de Oscuridad Primigenia" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7712-7441-d246-cdf5" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5b82-26e3-417e-64b6" type="max"/>
          </constraints>
          <profiles>
            <profile id="ae0d-9ed1-4582-8698" name="Placa de Oscuridad Primigenia" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador conoce 1D3+1 hechizos adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="f455-4ea9-f99c-82b6" name="Estandartes mágicos. Fimir" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c8ed-f0d6-edbe-c0ca" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="21ad-5fb4-23df-6936" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="9533-b36c-9375-71ad" name="Tótem de la Guerra de Balor" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5fc0-4100-2354-f971" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="32e6-4b87-a9f7-2dfd" type="max"/>
          </constraints>
          <profiles>
            <profile id="2579-f59b-459d-c2ab" name="Tótem de la Guerra de Balor" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador (y la unidad en la que se encuentre) obtienen la regla especial Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="14c4-3a95-e782-96ab" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="055a-74b9-4b4e-7b97" name="Estandarte del Horror Primigenio" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b249-8461-e032-0afd" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0b52-bc17-5176-967b" type="max"/>
          </constraints>
          <profiles>
            <profile id="c7df-9f27-b5df-333a" name="Estandarte del horror primigenio" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad causarán Terror; además, los chequeos de Miedo y Terror que realice el enemigo y sean provocados por el portador y su unidad deberán realizarse tirando 3D6 y descartando el resultado más bajo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
