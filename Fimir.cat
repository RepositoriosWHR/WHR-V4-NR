    <selectionEntry id="f400-0c6f-4b17-1d1b" name="Dirach (Hechicero Fimir)" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="bdd0-1997-0225-a9c9" name="Magia Dirach (Hechicero Fimir)" hidden="false">
          <description>Un Dirach es un hechicero de nivel 1 que puede aumentarse a nivel 2 por +30 puntos. Puede elegir sus hechizos de uno (y sólo uno) de los Saberes de las Sombras, la Muerte o Magia Oscura.</description>
        </rule>
        <rule id="1249-0973-7c22-5cd5" name="Mago guerrero" hidden="false">
          <description>Un Dirach puede llevar armadura y lanzar hechizos con normalidad.</description>
        </rule>
      </rules>
