    <selectionEntry id="bc0e-7500-b01a-f1f9" name="[E] - Kroll, El que Acecha en las Aguas" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="046a-1c36-705e-1c0e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0d49-1c24-e7e2-e50a" type="max"/>
      </constraints>
      <rules>
        <rule id="8b5b-e0cd-6841-af9a" name="Magia Kroll, El que Acecha en las Aguas" hidden="false">
          <description>Kroll es un hechicero de nivel 2 que elige sus hechizos del Saber de la Muerte.</description>
        </rule>
        <rule id="987f-7841-aad7-8c8c" name="Saber de las profundidades infernales" hidden="false">
          <description>Al inicio de cada turno de jugador (propio o del oponente), si Kroll está a 12” o menos de un elemento acuático, puede restaurar una de las heridas que hubiese sufrido previamente durante la batalla. Además, si se encuentra a 12” o menos de un elemento acuático, Kroll tiene un bonificador de +1 a sus tiradas de lanzamiento y dispersión de hechizos, así como a sus tiradas de Canalizar.</description>
        </rule>
        <rule id="d241-e70b-51fa-821a" name="Sober la sangre" hidden="false">
          <description>Las heridas causadas por Kroll en combate cuerpo a cuerpo no pueden ser regeneradas. Al final de cada fase de combate tira 1D6 por cada herida que Kroll haya causado: con cada resultado de 5+ Kroll puede restaurar una de las heridas que hubiese sufrido previamente durante la batalla.</description>
        </rule>
        <rule id="dd5c-abb9-63b3-4669" name="Masa de tentáculos" hidden="false">
          <description>Todos los ataques en combate cuerpo a cuerpo contra Kroll tienen un penalizador de -1 en sus tiradas para impactar. Además, Kroll es inmune a los efectos de las reglas especiales Heridas múltiples, Golpe letal y Golpe letal heroico.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6d95-bef2-d4cd-c741" name="Leyenda" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink id="523d-8a5d-15b3-e365" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="249f-4dc1-9e6b-35ab" name="Gran demonio (Fímul)" hidden="false" targetId="e0d6-794a-4571-a924" type="rule"/>
        <infoLink id="eae2-c364-7d6a-4034" name="Icono glorioso" hidden="false" targetId="a2d5-5666-950a-7062" type="rule"/>
        <infoLink id="8adb-1089-2a6c-af79" name="Piel escamosa (1+)" hidden="false" targetId="5e2e-d24c-0c35-66d9" type="rule"/>
        <infoLink id="edff-ad5b-baa1-f635" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(2D6+2)"/>
          </modifiers>
        </infoLink>
        <infoLink id="6d4f-0d82-5a73-1b62" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
