              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Proporciona al portador una tirada de salvación especial de 5+ y Resistencia mágica (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El Corazón del Fango" id="0d1e-6bba-15b0-5d65" collective="false" hidden="false" import="true" type="upgrade">
