    <selectionEntryGroup name="Objetos hechizados. Fimir" id="5573-5226-4d62-2c47" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="8728-426a-5be9-76f7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="87e4-6fb2-f7b5-2ca4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Ojo Brujo" id="ecce-a2b8-3570-ec20" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e5e8-bd8f-8053-9d29" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cad4-806a-7a3c-43fe" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ojo Brujo" id="15a5-300a-16d3-4a5d" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de Potenciación que puede lanzarse sobre una unidad amiga a 12” o menos del lanzador y permanece un turno. Tira 1D6 para determinar el efecto sobre la unidad: 
1: Atrofia (-1F y R)
2-3: +1F
4-5: +1R
6: +1F y +1R</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de piedra de disformidad" id="c546-3da8-1337-0e83" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="40d8-1a7b-e885-79e9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2c14-d8c3-f420-0c13" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="bdb0-e6a8-49f5-91ad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, canalizar, un único dado de energía o dispersión, o una tirada en la tabla de disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Icono del Horror" id="9ef3-4bad-a42f-e0cd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8f89-0576-7ce8-ebc2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2484-8257-8747-a85d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Icono del Horror" id="6dce-10b5-8221-97d7" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Si el portador causa al menos una baja a una unidad enemiga en combate cuerpo a cuerpo, dicha unidad quedará Apabullada hasta el final de la fase de combate cuerpo a cuerpo en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema de las brumas" id="a187-7fe2-42d4-054c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="78a2-79a1-a061-11e2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1e88-f84d-23e9-a7b3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema de las brumas" id="dc10-f4e6-67a9-eb01" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 1D6. Contiene un hechizo de potenciación que afecta a todas las unidades amigas a 12” o menos del portador y permanece un turno. Por la duración del conjuro, todos los disparos y ataques contra las unidades afectadas tendrán un penalizador de -1 en su tirada para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Relicario del Mar de las Garras" id="a52c-bf31-9316-e59c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cf2e-4187-092f-d2d0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="98dc-4203-e5b3-00bf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune al fuego" id="6d5b-b999-1c10-6639" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Relicario del Mar de las Garras" id="9a24-f670-0c72-9848" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y su unidad obtienen la regla especial Inmune al fuego. Además, todos los Ataques flamígeros contra el portador y su unidad deberán reducir a la mitad (redondeando hacia arriba) su valor de Fuerza (esto no afecta a ataques que hieran automáticamente o que no tengan un valor de F).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La Semilla de Fímul" id="d743-cb70-d478-fd26" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f514-ac9a-e565-367f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="316f-5db6-2d90-3023" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="La Semilla de Fímul" id="ff56-3e80-6df5-5f9a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al final de una fase de movimiento propia (después de que el portador haya movido). Designa un punto dentro de la línea de visión del portador y a 12” o menos de éste, y a continuación coloca un pantano (elemento de los tipos Terreno difícil y Elemento acuático) de hasta 4” de radio centrado en el punto designado (si es necesario, coloca el elemento de terreno debajo de las unidades que estén en el lugar en el que se vaya a colocar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Icono de Fortaleza Inquebrantable" id="7c6b-0e64-9bb8-72b4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4898-71ff-57af-e0d2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3c7b-a1c8-9416-6c2b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Icono de fortaleza inquebrantable" id="e17f-5f40-5921-e802" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todos los Impactos por carga que se asignen contra el portador y su unidad (antes de realizar la tirada para herir) deberán resolverse contra la unidad que causó los impactos por carga en lugar de contra el portador y su unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
