          <profiles>
            <profile name="Familiar del Caos" id="4b60-4868-2e64-b9d6" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El hechicero genera un dado adicional de Energía y Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bastón Rúnico del Caos" id="a947-e21d-680b-5508" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="058b-7336-3573-96ed" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e1ca-1d5d-d0f9-37e6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bastón Rúnico del Caos" id="abe5-6356-9021-0717" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, puedes robar uno de los dados de dispersión de tu oponente y añadirlo a tu reserva de dados de energía.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Collar de cabezas de brujo" id="36ff-85f7-2324-ef70" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="37df-b5d4-a896-ed5b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c0fb-77cf-3149-826f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Collar de cabezas de brujo" id="c891-979a-f639-b344" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, determina al azar un hechizo en la siguiente tabla: el Collar actúa como un objeto portahechizos con nivel de energía 1D3+1, lanzando el hechizo indicado (no puede lanzarse la versión potenciada de ninguno de los hechizos). 
1D6: 
1 Oscura mano de destrucción (Magia Oscura) 
2 Portento de Phar (Saber de los Cielos) 
3 Miasma mística de Melkoth (Saber de las Sombras) 
4 Forma salvaje de Wyssan (Saber de las Bestias) 
5 Furia primitiva (Magia Oscura) 
6 Malicia de Khaine (Magia Oscura)</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Placa de Oscuridad Primigenia" id="f3c5-b4d7-2671-5351" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7712-7441-d246-cdf5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5b82-26e3-417e-64b6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Placa de Oscuridad Primigenia" id="ae0d-9ed1-4582-8698" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador conoce 1D3+1 hechizos adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
