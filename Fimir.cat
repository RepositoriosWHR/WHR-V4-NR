                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. El portador puede repetir todas las tiradas de salvación por armadura fallidas que realice.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="02d2-3c22-1ec5-43a1" name="Armadura del caos" hidden="false" targetId="9901-786b-197c-3c4d" type="profile"/>
