            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Heridas múltiples (1D3)" id="85ab-36cf-1a0a-f0d8" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
            <infoLink name="Arma a dos manos" id="2fff-9283-e657-8f16" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Maza Ablandacarnes" id="cb6d-3c30-11f2-854e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Sus impactos se resuelven con la regla especial Heridas múltiples (1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Parteescudos" id="7845-819c-2844-0992" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c8dc-1e74-4812-1c7f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4d13-5c07-9148-a0d5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma a dos manos" id="15da-8afc-2a4b-52b8" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
            <infoLink name="Arma a dos manos" id="b8d6-78e6-13e5-3730" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Parteescudos" id="bbc5-6819-c5e1-817c" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Efectúa la tirada para impactar con este arma usando la Iniciativa del objetivo en lugar de su Habilidad de armas. Las miniaturas sin Iniciativa serán impactadas automáticamente y sufrirán 1D6 heridas por cada impacto en lugar de sólo una. Los impactos con este arma se resuelven con +1 a la Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Descuajacabezas" id="19a4-c968-349f-d35a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2747-7d5a-56f7-f166" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="cce2-1b12-fad6-8ecf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Golpe letal" id="0252-8deb-31c3-d65e" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
            <infoLink name="Maza ogra" id="d042-05d1-e4f3-2ab9" hidden="false" targetId="8414-1dd1-372a-bc70" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Descuajacabezas" id="4c45-bec3-e598-6c76" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Maza ogra. Los ataques con este arma tienen la regla especial Golpe letal. Además, proporciona un bonificador de +1 a la tirada de salvación por armadura del portador, tal es la la protección que otorga el guantelete.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes Mágicos. Ogros" id="cc93-f014-1820-9262" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="37ff-ba15-dccf-b525" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pellejodragón" id="ad99-1a50-f044-8eac" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pellejodragón" id="5d9f-df06-e031-3afc" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad pueden repetir todos los resultados de 1 en sus tiradas para impactar, herir y salvaciones en cualquier turno en el que realicen exitosamente una carga. Además, una vez por batalla, durante cada fase de magia el portador puede desatar un vendaval helado sobre una unidad enemiga en contacto peana con peana con este. La unidad sufre inmediatamente 1D6 impactos de Fuerza 2 sin tirada de salvación por armadura y verá su atributo de Iniciativa reducido a la mitad (redondeando hacia arriba) hasta el final del turno en curso. Esto no afecta a unidades con la regla especial Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Trapos" id="3500-f648-38f5-ed3f" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Sangre fría" id="ff26-782b-7d80-2b8c" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de Trapos" id="07f9-6780-b2ba-a508" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Sangre fría.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tótem de los caníbales" id="d4da-811f-b114-9a7e" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="e281-a83c-1017-11c8" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink name="Ansia de sangre" id="5c98-747e-b352-2cd5" hidden="false" targetId="2a68-a009-1a7a-c667" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Tótem de los caníbales" id="c5cc-ff36-f7c6-f679" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen las reglas especiales Ansia de sangre y Furia asesina y no la perderán aunque pierdan un combate (sin embargo, la perderán si pierden este estandarte).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de los Toros" id="ce76-238d-0894-c6fc" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de los Toros" id="8b2d-616a-ce44-2833" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad podrán repetir sus tiradas para herir fallidas causadas por los Impactos por carga generados por su regla especial Arremetida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las competiciones de las cuchipandas" id="19c4-44d5-5300-291c" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las competiciones de las cuchipandas" id="d8fd-e9ed-bb1a-26cb" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los impactos que obtienen un resultado natural de 6 en la tirada para herir del portador y su unidad en combate se resolverán con un penalizador de -2 adicional a la tirada de salvación por armadura del oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Bocaenllamas" id="c8f0-c267-b51b-597e" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="c059-7a5f-b808-37c9" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Ataques solo flamígeros" id="f513-b61c-fe13-4322" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del Bocaenllamas" id="e570-3fe1-f6b3-9c5a" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Ataques flamígeros. Además, al inicio de cada fase de combate cuerpo a cuerpo, elige una unidad enemiga en contacto peana con peana con el portador: dicha unidad sufrirá 1D6 impactos de Fuerza 3 distribuidos como proyectiles con la regla especial Ataques solo flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos Hechizados. Ogros" id="0fd8-55e5-399a-7c71" collective="false" hidden="false" import="true">
