          <modifiers>
            <modifier field="name" type="append" value="(Golgfag)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Inmune a la psicología" id="6582-e057-7737-855f" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
