      <rules>
        <rule name="Disciplina marcial" id="73cc-c89d-e3e5-ec97" hidden="false">
          <description>Al realizar un chequeo de Liderazgo para reformar, reagruparse, redirigir una carga, evitar perseguir o arrasar, los Piqueros de Tobaro tiran 3D6 y descartan el resultado más alto.</description>
        </rule>
      </rules>
