            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Escudo" id="9641-80a9-169a-4ab6" hidden="false" targetId="c028-354e-9169-7463" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Escudo rúnico de los nueve mares" id="3684-c3bd-3758-7f9d" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. El portador será inmune a los efectos de la regla especial Poder de penetración. Todos los ataques dirigidos contra el portador en combate cuerpo a cuerpo obtendrán un penalizador de -1 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Mariemburgo" id="42c6-853b-4237-c264" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="21ae-3cb4-4d58-6710" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="774d-3168-fbd2-1c79" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Skwiknibble, Familiar Snotling" id="510e-cc5b-ab48-c133" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ebdf-c427-44be-3f13" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0a17-211f-350f-54fa" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Skwiknibble, familiar snotling" id="126a-6fcb-e8ae-d1b4" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia del oponente, puedes robar uno de sus dados de energía y añadirlo a tu reserva de dados de dispersión. Aunque puedes representarlo con una pequeña miniatura de snotling apropiada, no puede ser atacado, y deberá retirarse si el portador se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Curso de Matheus Yadok" id="9853-83b4-915d-24c7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4343-5bbf-619e-c4ab" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8d6b-3e25-6f44-7655" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Curso de Matheus Yadok" id="f377-0c72-a099-1d7a" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El hechicero conoce el hechizo El oro de los insensatos del Saber del Metal</characteristic>
              </characteristics>
            </profile>
            <profile name="[4b] - Oro de los insensatos" id="d6ae-75fa-820e-bd7f" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Maldición</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">9+</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">24&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">Permanece un turno</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Maldición que toma como objetivo a una unidad enemiga a 24” o menos del lanzador y Permanece un turno. Mientras dure el hechizo, la unidad obtiene la regla especial Estupidez y deberá realizar sus chequeos de Estupidez tirando 3D6 y descartando el resultado menor.</characteristic>
              </characteristics>
            </profile>
            <profile name="[R] - Imbuir el metal" id="c4d7-c3b6-767c-fd60" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">-</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">-</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">-</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Los hechizos del Saber del Metal ven su dificultad de lanzamiento reducida en punto si toma como objetivo una o más unidades con una tirada de salvación por armadura de 4+ o mejor. Del mismo modo, si la unidad objetivo tiene una tirada de salvación por armadura de 2+ o mejor, reduce en 1 adicional la dificultad de lanzamiento del hechizo (es decir,la dificultad se reduce en 2 puntos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sextante de la premonición" id="bf68-366f-6154-65d7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="be84-109c-1434-fbfb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0112-02ea-6459-762c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sextante de la premonición" id="fa0a-8886-9715-e225" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga al hechicero un bonificador de +1 a la hora de lanzar hechizos. Además, una vez por batalla, podrás repetir una tirada a la hora de lanzar o dispersar un hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Mariemburgo. Sólo regla ley y orden" id="86ea-026d-1110-7e14" collective="false" hidden="false" import="true">
