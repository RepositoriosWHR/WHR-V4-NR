                      <repeats>
                        <repeat childId="3d55-4997-0c24-9693" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="b8e4-7a64-d5fc-785c" shared="true" value="1"/>
