      <infoLinks>
        <infoLink name="Terror" id="31b7-fd7f-5070-2ac4" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Indesmoralizable" id="d362-4646-77c1-a329" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink name="Protección por montura (2)" id="95db-b1f8-7181-5530" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
        <infoLink name="Monstruosamente grande" id="4393-4c2e-331d-0cc7" hidden="false" targetId="38d4-1707-be50-7d0f" type="rule"/>
        <infoLink name="Inmune al veneno" id="e6ac-2b19-a57f-9c26" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
