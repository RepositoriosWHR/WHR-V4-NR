              <selectionEntries>
                <selectionEntry name="Atrofia gris (Sombras)" id="8658-e3dc-c8a3-ef05" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="f67f-fcf8-f11b-7d35" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="4"/>
                    <constraint id="12b7-020b-c80b-cde6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
