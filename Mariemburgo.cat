          <profiles>
            <profile name="Estatuilla de Bramhir" id="429a-2448-2cf7-1b71" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Proporciona a su portador una tirada de salvación especial de 4+ contra todas las heridas causadas por miniaturas del Caos, enanos del Caos o skaven (eso incluye las heridas causadas por hechizos o máquinas de guerra).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño glotón" id="4bef-d7f8-20e0-39de" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Orgullo marcial" id="ce91-6775-49e8-f724" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Puño glotón" id="6894-dc75-fe59-b3ef" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene un bonificador de +1 a su tirada de salvación por armadura y la regla especial Orgullo marcial.
Cuando esté luchando en un Desafío, el portador obtiene un ataque adicional por cada objeto mágico que porte el oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Marca del demonio" id="b741-78b9-b9e5-529c" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="ebf6-40fe-25b9-00e3" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Marca del demonio" id="992c-23f4-2380-03d7" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador causa Terror.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Corona de laurel" id="ef59-d7aa-809a-b907" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Corona de laurel" id="e03f-7a07-dd91-9225" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y su unidad podrán repetir sus chequeos fallidos de Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Barril de licor de lagarto del trueno" id="63a4-5d59-c933-6c0f" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="20"/>
