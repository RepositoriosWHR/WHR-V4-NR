        </infoLink>
        <infoLink name="¡Ni por todo el oro del mundo!" id="70c2-fc94-6e2d-b6f8" hidden="false" targetId="1477-98d2-904e-713f" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Caos, No muertos, Demonios)"/>
          </modifiers>
        </infoLink>
