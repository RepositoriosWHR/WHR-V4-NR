          <infoLinks>
            <infoLink name="Veloz" id="f099-b42e-4a9d-bd80" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
            <infoLink name="Vanguardia" id="4a1e-c23b-a1bc-00cf" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pabellón de la Presta represalia" id="55f0-2e2d-30b3-5f19" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Solo unidades con la regla Ley y Orden. Aumenta el movimiento de vanguardia a 10’’. La unidad obtiene la regla Veloz.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Mariemburgo" id="90c2-8e7a-a4c3-59f2" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="a4e3-a64a-79d4-3c49" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9537-875b-5efb-8a34" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de Mariemburgo" id="f587-894d-1bab-6a56" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo unidades con la regla Ley y Orden. Todas las unidades situadas a 12” o menos del estandarte obtendrán un bonificador adicional de +1 al resultado de los combates en los que participen. Si en un combate hay varias unidades bajo el área de efecto del estandarte el bonificador solamente se contará una sola vez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Mariemburgo. Arma de mano" id="1995-f96a-5ea7-956c" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="181b-e902-65b1-50b4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="65ee-58f8-7bed-b2e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Hoja traicionera" id="1228-207b-5027-c8f5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="93e8-12ac-ac2d-8ce0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="297a-a724-7922-3e02" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Poder de penetración" id="e98c-6010-b022-4c84" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
            <infoLink name="Arma de mano" id="b80f-fd89-0641-f8ba" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Heridas múltiples (2)" id="0b2d-23d8-2f3c-708d" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Flanco o Retaguardia)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Hoja traicionera" id="6d08-0260-8ef3-ce8a" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques en combate usando este arma obtienen la regla especial poder de penetración. Si el atacante esta situado al flanco o a la retaguardia del enemigo objetivo del ataque, los ataques efectuados por el atacante se resuelven con un bonificador de +1 a la fuerza y la regla especial heridas múltiples (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espada de la tormenta" id="4da9-5bd1-befb-e88f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="544e-0d97-faaf-465b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2807-5bc1-3dac-a507" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="75a5-e2df-53de-13c6" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Ataques de rayos" id="3a3f-70bc-513c-83ee" hidden="false" targetId="8628-6531-ed1d-f985" type="rule">
              <modifiers>
                <modifier field="name" type="set" value="(Poder contenido, una vez por batalla)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Espada de la tormenta" id="79bf-64de-25e2-0c05" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Otorga a su portador un bonificador de +1 a la Fuerza. Además, una vez por batalla puedes utilizar el poder contenido dentro de la espada. En la fase de disparo, designa una unidad enemiga a 12’’ o menos del portador. La unidad sufre 1D3 impactos de Fuerza 5 con la regla especial Ataque de rayos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Trachinus Draco" id="0b49-775e-9eb8-a208" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a888-a291-2617-0cdf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bc68-7540-ba69-2f7c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="e107-ddf5-aa70-35e6" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Poder de penetración" id="0729-d12b-2619-fd0c" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Trachinus Draco" id="c474-55b1-1714-5d7e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques con este arma obtienen un bonificador de +1 en sus tiradas para impactar y se resuelven con la regla especial Poder de penetración. Las heridas causadas por esta arma no permiten tiradas de Regeneración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Magia marina" id="ff16-7331-4a13-e3a5" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="d659-9207-1954-5eca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Domino de los elementos, parte 2" id="cd69-cc0f-c0b3-75cc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="38af-1183-0809-32ea" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="4"/>
            <constraint id="e1c6-1914-3343-b0fc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="4"/>
          </constraints>
