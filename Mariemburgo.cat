        <infoLink name="Mercenario" id="39b2-4299-cfbb-bd3d" hidden="false" targetId="f693-0c5c-49bd-91e7" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="673b-9dab-2345-955d" type="set" value="2">
