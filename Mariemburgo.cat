              <characteristics>
                <characteristic name="Reglas especiales" typeId="8c79-e536-addc-8a74">Comodoro. El personaje y la unidad en la que se encuentre obtienen la regla especial Tozudez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Respetado" id="e9de-a8a6-4d45-ce73" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1d40-5988-510a-f8a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e512-a900-709c-69d5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
