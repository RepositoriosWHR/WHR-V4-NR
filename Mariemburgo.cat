    <selectionEntry name="[R] - Gigantes de Albión" id="5182-4c25-7cfd-01a1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="2adb-5698-99f5-4053" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
