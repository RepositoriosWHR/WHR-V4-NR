          <profiles>
            <profile name="Talismán de la tormenta" id="b22c-8e54-08eb-1947" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cada miniatura que obtenga un resultado de 1 en el dado en sus tiradas para impactar contra el portador en combate cuerpo a cuerpo sufrirá un impacto de F5.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Moneda de la suerte" id="e0eb-a60e-663f-32ac" collective="false" hidden="false" import="true" type="upgrade">
