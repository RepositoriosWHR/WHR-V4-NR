    <selectionEntry name="Licenciado del Colegio de Von Henryk" id="6c16-bc8c-935d-a081" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="ee44-b54d-8b67-b2a2" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
        <categoryLink name="New CategoryLink" id="8a45-3c67-adc3-1055" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="0b12-a72a-467c-2bfd" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="114b-62ba-d77f-22c8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="6c16-bc8c-935d-a081" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink name="Mercenario" id="1a7b-8162-517f-b279" hidden="false" targetId="f693-0c5c-49bd-91e7" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Ingeniero naval" id="b417-4e75-d2bb-76d4" hidden="false">
          <description>Una vez por fase de disparo, puede seleccionar una máquina de guerra amiga a 6” o menos de él. Esa máquina podrá repetir la tirada de un dado de artillería o un dado de dispersión ese turno). Si el Licenciado se encuentra a menos de 8” del Barco de Tierra clase Marienburgo, este podrá repetir el dado en la tabla de Calamidades.</description>
        </rule>
        <rule name="Magia del Licenciado del Colegio de Von Henryk" id="9404-a214-bdef-07d1" hidden="false">
          <description>Nivel de magia 3, puede aumentarse a 4 por +55 puntos. Debe haber cursado entre 3 y 5 cursos (incluidos los de Hechicería Avanzada) de entre los que ofrece el Colegio Von Henryk de Navegación y Magia Marina.</description>
        </rule>
      </rules>
