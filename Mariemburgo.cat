              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Ballesta. Los impactos de Ensartaenemigos se resuelven con F6 y la regla especial Heridas múltiples (1D3). Además, las heridas causadas por esta arma no permiten tiradas de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Mariemburgo. Armadura ligera" id="f403-d0bd-7c7f-a1ce" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f1a5-7f73-b22e-e53c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="d0cf-19ca-79eb-a689" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Armadura de Dragón Marino" id="fffe-b8cc-c867-827e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6e50-62ca-c4c7-517c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7b0c-b468-e82b-c521" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Piel escamosa (5+)" id="f1a1-5861-112b-9e79" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
            <infoLink name="Armadura ligera" id="9145-6c3c-6e96-ad0d" hidden="false" targetId="44f2-32d5-23eb-62f5" type="profile"/>
            <infoLink name="Cruzar" id="de6b-37a8-f63c-1096" hidden="false" targetId="7ea4-f7e1-7e21-9266" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(todos los tipos de terreno excepto Edificios e Intransitables)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Armadura de Dragón Marino" id="86fb-8b8b-4fba-3cac" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Proporciona a su portador la regla especial Piel escamosa (5+). Además el portador obtendrá la regla Cruzar (todos los tipos de terreno excepto Edificios e Intransitables).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Ogras" id="4d67-b2ec-883e-82d0" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e803-3050-fe11-b70c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Armadura de Mastodonte" id="9b37-af4a-5b33-1374" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura pesada" id="f350-9f89-785d-b986" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura de Mastodonte" id="f132-df77-ee1e-1aba" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Al inicio de cada uno de tus turnos, el personaje recupera una de las heridas que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Grancráneo" id="5a58-6a48-c163-b375" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Protegetripas" id="75d0-cd43-5b1b-271d" hidden="false" targetId="2131-d9ec-edb5-8015" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Grancráneo" id="d594-bb94-37d3-4809" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. Cualquier hechicero que designe como objetivo de uno de sus hechizos a la unidad en la que esté el portador obtendrá una Disfunción mágica con cualquier resultado de dobles en su tirada de lanzamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Protegetripas de las Grandes Fauces" id="5122-1311-6003-63fd" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="5a6b-0d8e-6dd8-3ac4" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
            <infoLink name="Protegetripas" id="9128-4271-2ac7-a80d" hidden="false" targetId="2131-d9ec-edb5-8015" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Protegetripas de las Grandes Fauces" id="e14c-b1ea-8558-9287" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. El portador causa Terror. Cada vez que el portador acabe con un enemigo en un Desafío, puede restaurar una de las heridas perdidas previamente durante la batalla. Si no había sufrido heridas, obtiene permanentemente +1 Herida en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tripa de toro" id="f06a-9d0a-4af5-1056" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Protegetripas" id="1a25-9258-84de-2259" hidden="false" targetId="2131-d9ec-edb5-8015" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Tripa de toro" id="4db4-955c-9cf1-a211" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. El portador y la unidad en la que se encuentre duplican su Potencia de unidad en el turno en el que realizan exitosamente una carga. Además, todos los impactos por carga que cause el portador tendrán la regla especial Poder de penetración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pellejo de colmillos de trueno" id="dba8-5e35-f706-0d0a" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Aura de frio" id="2f4b-59a0-dd84-7820" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
            <infoLink name="Armadura ligera" id="ed7a-7620-3867-9864" hidden="false" targetId="44f2-32d5-23eb-62f5" type="profile"/>
            <infoLink name="Piel escamosa (5+)" id="b811-9c77-d34f-4e62" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pellejo de colmillos de trueno" id="07dc-3813-c45b-3449" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Otorga a su portador las reglas especiales Piel escamosa (5+) y Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Ogras" id="7e3d-44f5-e483-aff3" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="08b0-86ba-1d07-761d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
