      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Mover o disparar, Poder de penetración, Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Hachas de matador" id="f30e-1c60-83f8-bd5c" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Al inicio de cada ronda de combate puedes elegir si utilizarlas como Arma a dos manos o como Armas emparejadas.</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas enanas (Disparo)" id="61b1-8112-1e53-40a9" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Disparos múltiples (2), Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas enanas (Combate)" id="8660-1e16-963b-f5a2" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Armas emparejadas, Descarga</characteristic>
      </characteristics>
    </profile>
    <profile name="Flechas incendiarias" id="4661-a3e8-4827-9ec7" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Los disparos con Arco (de cualquier tipo) efectuados por miniaturas con Flechas incendiarias se resuelven con la regla especial Ataques flamígeros.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mazas ogras emparejadas" id="fe84-062d-97aa-b294" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Requiere ambas manos, +1 Ataque.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola ogra (Combate)" id="8016-2bff-d104-ead1" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Arma de mano adicional, Descarga</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas ogras (Dipsaro)" id="f6ca-7ac2-1960-4a85" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Disparos múltiples (2)</characteristic>
      </characteristics>
    </profile>
    <profile name="Espada catayana (una mano)" id="abed-d5ea-c813-5ee6" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Poder de penetración, +1 Ataque, Arma exótica: Al inicio de cada ronda de combate, elige si se va a utilizar la Espada catayana a una mano (junto con otra espada más pequeña) o a dos manos y usa el perfil correspondiente. Un ogro utilizando una Espada catayana tiene un bonificador de +1 a sus atributos de Habilidad de armas e Iniciativa en combate cuerpo a cuerpo.</characteristic>
      </characteristics>
    </profile>
    <profile name="Espada catayana (dos manos)" id="0cd9-e587-2e75-b466" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Poder de penetración, Arma exótica: Al inicio de cada ronda de combate, elige si se va a utilizar la Espada catayana a una mano (junto con otra espada más pequeña) o a dos manos y usa el perfil correspondiente. Un ogro utilizando una Espada catayana tiene un bonificador de +1 a sus atributos de Habilidad de armas e Iniciativa en combate cuerpo a cuerpo.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cepo de mano" id="4d21-4b23-ec61-f715" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">6</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Heridas múltiples (2), Arma de mano adicional: Un Cepo de mano se usa siempre junto a una Maza ogra tratando al Cepo de mano como un Arma de mano adicional. Sólo puede hacerse un ataque con el Cepo de mano.</characteristic>
      </characteristics>
    </profile>
    <profile name="Piel de Cuernospétreos" id="f7dc-73c1-9a83-df73" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Estas capas proporcionan la regla especial Piel escamosa (6+).</characteristic>
      </characteristics>
    </profile>
    <profile name="Protegetripas" id="2131-d9ec-edb5-8015" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">6+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">El Protegetripas proporciona un bonificador de +1 a la tirada de salvación por armadura de su portador, o una tirada de salvación por armadura de 6+ si no disponía de ella. Puede combinarse con otras armaduras de la forma habitual.</characteristic>
      </characteristics>
    </profile>
    <profile name="Tatuajes talismánicos" id="e8b3-0de8-78c8-b6b3" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Otorga al portador la regla especial Resistencia mágica (1).</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura de gromril" id="67d7-ecd7-e79b-b6a2" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Otorga una tirada de salvación por armadura de 4+. Además, estas armaduras son tan resistentes que su portador será inmune al efecto de la regla especial Poder de penetración.</characteristic>
      </characteristics>
    </profile>
    <profile name="Katana (a dos manos)" id="1a9b-0635-7601-8961" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1 Iniciativa</characteristic>
      </characteristics>
    </profile>
    <profile name="Katana (con Wakizashi)" id="fd0e-4192-b29e-4e59" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1 Iniciativa, +1 Ataque</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura de placas" id="3633-99ef-596d-cb6a" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323"/>
      </characteristics>
    </profile>
    <profile name="Pavés" id="f41b-a8f6-0253-b633" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Otorga un bonificador de +2 a la tirada de salvación por armadura contra proyectiles y hechizos del tipo Proyectil mágico.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Culto a Manann" id="f708-b28f-90d2-b32c" hidden="false">
      <description>Las miniaturas con la Regla Plegarias a Manann son capaces de canalizar el poder de su dios en forma de plegarias.
Las plegarias pueden lanzarse durante la fase de magia. Para lanzar Plegarias sigue el mecanismo descrito para los objetos portahechizos.</description>
    </rule>
    <rule name="Ley y Orden" id="3aea-630f-251e-ca48" hidden="false">
      <description>Una unidad con esta regla especial es Inmune a Pánico y tendrá Vanguardia, aunque únicamente podrá mover como máximo 6’’ con su movimiento de Vanguardia.</description>
    </rule>
    <rule name="Bendición de Manann" id="2976-37cb-1828-985e" hidden="false">
      <description>Una miniatura con esta regla especial obtiene Odio (¡todos los enemigos!) en los turnos en los que haya efectuado una carga. Además, puede repetir uno de los dos dados en sus tiradas para determinar el alcance de una carga.</description>
    </rule>
    <rule name="Plegarias a Manann" id="f282-01aa-39f8-d1e2" hidden="false">
      <description>Desesperación (Maldición): Todas las miniaturas de una unidad enemiga situada a 6” o menos del lanzador verán su atributo de Liderazgo reducido en un punto (hasta un mínimo de 1) y no podrán beneficiarse de la regla especial Presencia inspiradora. Esta plegaria permanece hasta el siguiente turno de magia propio.  

Poderío (Potenciación): Una unidad aliada situada a 6” o menos del lanzador obtendrá la regla especial Carga devastadora. Esta plegaria permanece hasta el siguiente turno de magia propio.

Cólera (Daño directo): Una unidad enemiga situada a 6” o menos del lanzador sufrirá 1D3 impactos de F6 con las reglas. especiales Ataques mágicos y Ataque de rayos.

Égida (Potenciación): Elige unidad aliada situada a 6” o menos del lanzador. Todos los disparos y ataques contra dicha unidad deberán aplicar un penalizador de -1 en sus tiradas para impactar y la unidad afectada obtendrá la regla especial Cruzar (Elementos acuáticos). Esta plegaria permanece un turno.</description>
    </rule>
    <rule name="Animosidad hobgoblin" id="0c56-2e23-df9f-3d47" hidden="false">
      <description>Al inicio de cada uno de tus turnos, cada unidad con esta regla especial deberá realizar un chequeo de Animosidad a no ser que se cumpla una de las siguientes circunstancias:
-Se encuentra huyendo o en combate.
-La unidad tiene una Potencia de unidad inferior a 5.
-Hay una miniatura con la regla Desprecio a 6” o menos de la unidad al inicio del turno.
Para realizar un chequeo de Animosidad, tira 1D6. Si obtienes un resultado de 2 o más, todo habrá ido bien y la unidad puede actuar con normalidad este turno. Pero si obtienes un resultado de 1, deberás tirar 1D6 en la siguiente tabla y aplicar el resultado inmediatamente:

D6 Animosidad hobgoblin
1-2 ¡Tendremos una mejor vista desde atrás!: La unidad deberá realizar un chequeo de Pánico inmediatamente.
3-5 Inseguridad: La unidad deberá realizar un chequeo de Liderazgo. En caso de fallarlo, no podrá declarar una carga ni realizar ningún tipo de movimiento de marcha durante ese turno.
6 Asesinato sangriento: La unidad sufre inmediatamente 1D6 impactos de Fuerza 3 distribuidos como si fueran proyectiles (esto no provoca chequeos de Pánico) pero la unidad se entusiasma tanto que podrá actuar con normalidad este turno y hasta el final de tu turno obtendrán un bonificador de +1 para impactar.</description>
    </rule>
    <rule name="Loz mejorez" id="f888-b83e-26de-4fc5" hidden="false">
      <description>Ninguna unidad o miniatura de orcos debe realizar chequeos de pánico cuando una unidad amiga huye o es destruida en su cercanía, o cuando una unidad amiga atraviesa una unidad de orcos en su huída, a no ser que la unidad causante del chequeo fuese también de orcos.</description>
    </rule>
    <rule name="Miedo a loz orejotaz" id="7659-6b24-cce0-ddc2" hidden="false">
      <description>Los goblins tendrán Miedo de cualquier unidad de elfos a la que no superen en una proporción de al menos 2 a 1 en Potencia de unidad.</description>
    </rule>
    <rule name="Regimiento de renombre" id="f099-a8ee-ead6-ab35" hidden="false">
      <description>Los Regimientos de Renombre incluidos en este libro de ejército (así como los que vayan apareciendo posteriormente en los ExtraReforged) son unidades únicas, que en cierto modo se tratan como si fuesen personajes especiales: eso quiere decir que los Regimientos de Renombre son únicos, por lo que cada uno de ellos sólo puede incluirse una vez. Puede darse el caso de que dos ejércitos enfrentados incluyan el mismo Regimiento de Renombre, pero en ese caso consideraremos que uno de ellos es el auténtico regimiento, y el otro unos hábiles impostores (¿Ycuál es el auténtico? ¡La victoria lo decidirá!).
En cada Regimiento de Renombre se detalla cuál es el tamaño mínimo de la unidad que debes adquirir, así como el tamaño máximo. Los Regimientos de Renombre incluyen sus propios oficiales, a veces con perfiles muy superiores a los de un guerrero normal; nos referimos a ellos como Capitanes, aunque siguen todas las reglas habituales para oficiales. Muchos regimientos de renombre incluyen también Portaestandartes y/o Músicos, lo cual se incluye en su descripción. Un Regimiento de Renombre nunca puede equiparse con objetos mágicos (¡tampoco estandartes mágicos!), salvo los que se detallan en su descripción. Ningún personaje puede unirse a un Regimiento de Renombre: se bastan y se sobran con sus Capitanes.
Los Regimientos de Renombre se consideran opciones de Unidad Especial en un ejército de Marienburgo, a menos que se especifique lo contrario. Los Regimientos de Renombre incluidos en libro de ejército de Marienburgo carecen del listado de Patrones propio del libro de ejército de Mercenarios (ya que se trata de un libro de ejército alternativo). Consulta el libro de ejército de Mercenarios si quieres saber qué Regimientos de Renombre pueden adquirirse en otros libros de ejército principales.</description>
    </rule>
    <rule name="Lealtad" id="82f8-7857-d2a2-c2e1" hidden="false">
      <description>Los Regimientos de Renombre perderán la regla especial Mercenario al incluirlos en los ejércitos señalados en esta regla especial; ten en cuenta que muchos de ellos ya aparecen descritos en sus respectivos libros de ejército.</description>
    </rule>
    <rule name="Subalternos de renombre" id="a236-1e6f-0780-66b1" hidden="false">
      <description>Algunos Regimientos de Renombre tienen Portaestandartes y/o Músicos con nombre propio. Al contrario que los Portaestandartes y Músicos del resto de unidades, éstos pueden ser seleccionados como objetivo de ataques en combate cuerpo a cuerpo, disparos con la regla especial Francotirador y ataques con plantillas. Disponen de la regla especial ¡Cuidado, señor! como si fuesen personajes, aunque no pueden lanzar ni aceptar desafíos.</description>
    </rule>
    <rule name="Los mejor pagados" id="9360-743b-4cbb-d91e" hidden="false">
      <description>Los Regimientos de Renombre son inmunes al Pánico provocado por unidades que no sean Regimientos de Renombre (aunque seguirán realizando el chequeo Pánico por muerte del General).</description>
    </rule>
    <rule name="¡Ni por todo el oro del mundo!" id="1477-98d2-904e-713f" hidden="false">
      <description>Esta regla especial se acompaña de una descripción entre paréntesis, la cual puede hacer referencia a una clave o a otro Regimiento de Renombre. Las unidades con esta regla especial no podrán incluirse en tu lista de ejército si incluyes el unidades señaladas en el paréntesis.</description>
    </rule>
    <rule name="Es el que paga" id="335d-4284-9114-2056" hidden="false">
      <description>Los personajes con esta regla especial tienen la regla especial ¡Ni un paso atrás!, que afecta a todas las unidades con la regla especial Mercenario a 12” o menos (como si fuese un Portaestandarte de batalla). Además, proporciona un bonificador extraordinario de +1 al resultado del combate a su bando en cualquier combate en el que participe. Los personajes con esta regla especial en una unidad mercenaria siempre pueden rechazar un desafío (¡incluso aunque una regla o efecto lo obligase a aceptar!), y pueden aportar su Liderazgo y los demás efectos de esta regla especial aún habiendo rechazado un desafío. Si es retirado del campo de batalla como baja, todas las unidades de tu ejército (salvo las monturas) obtendrán la regla especial Odio (¡todos los enemigos!). Si se incluye en una unidad con la regla especial Escoltas, puede colocarse en la segunda fila de la unidad (pese a ser Personaje); la unidad podrá seguir beneficiándose de su Liderazgo y demás habilidades (¡Ni un paso atrás!, +1 al resultado del combate, etc.) pese a estar en segunda fila. Tan sólo tendrá que moverse a la primera fila si quedan menos de 6 miniaturas en su unidad. Ten en cuenta un personaje con esta regla especial se considera un Portaestandarte de Batalla a efectos de Puntos de victoria y Puntos de Fortaleza (en el escenario “Sangre y gloria”).</description>
    </rule>
    <rule name="Destreza marcial" id="1c73-51ce-0dbc-23dc" hidden="false">
      <description>Las miniaturas de Infantería con esta regla especial equipadas con Lanza mejoran su regla especial Luchar con filas adicionales en +1. Además, pueden realizar Parada con las siguientes combinaciones de armas: Arma de mano y Escudo, Lanza y Escudo, Lanza o Armas emparejadas.</description>
    </rule>
    <rule name="Arremetida" id="db87-2511-bc82-2fdd" hidden="false">
      <description>Si una unidad con esta regla especial obtiene algún resultado de 5 ó de 6 en su tirada de carga, cada uno de sus componentes obtendrá hasta el final del turno la regla especial Impactos por carga (1); además, si la unidad de ogros tiene al menos una fila con tres o más miniaturas detrás de su primera fila, resuelve dichos impactos por carga con un bonificador de +1 a su Fuerza.</description>
    </rule>
    <rule name="Diseño superior" id="fc8d-87a5-74c9-2a7d" hidden="false">
      <description>Las armas de proyectiles con esta regla especial no tienen el penalizador de -1 por disparar a larga distancia.</description>
    </rule>
    <rule name="Escoltas" id="0727-ad06-5669-acad" hidden="false">
      <description>Si incluyes un Tesorero o Pagador en tu lista de ejército, puedes seleccionar una de las unidades propias de las Grandes Casas mercantiles; esto proporciona modificadores a la hora de realizar la lista de ejército, así como la posibilidad de acceder a las escoltas privadas. Además, las unidades con esta regla especial obtienen la regla especial Tozudez mientras el Pagador se encuentre unido a ellas.</description>
    </rule>
    <rule name="Avance imparable" id="4ad9-52ef-113c-6891" hidden="false">
      <description>Las miniaturas con esta regla especial no tendrán que efectuar chequeos de Liderazgo para marchar si hay enemigos a 8” o menos del inicio de su movimiento: se considera que superan automáticamente el chequeo.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
    <selectionEntry name="El brillo de oro" id="0c8f-c1c7-23ca-60b6" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="9f3c-71b3-8aaf-7ce7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="0"/>
        <constraint id="7f10-34c3-4093-c643" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="69c6-d98c-c1cc-9fda" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <modifiers>
