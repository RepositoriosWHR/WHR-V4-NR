            <infoLink name="Arma de mano adicional" id="bb79-49e0-004a-de62" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
            <infoLink name="Heridas múltiples (1D3)" id="383b-d309-ed0c-621c" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
