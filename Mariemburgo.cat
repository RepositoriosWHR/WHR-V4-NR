          </infoLinks>
          <profiles>
            <profile name="Cuchillas de la matanza" id="ddea-9c7a-b3b7-d6e9" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Mazas ogras emparejadas. Triplica el valor de Iniciativa del portador en combate cuerpo a cuerpo. Los ataques con este arma se resuelven con la regla especial Ataques envenenados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Maza Ablandacarnes" id="13e0-d6d2-587c-0c8a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="901d-d3b2-35d4-6ce9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c78f-1e50-2330-f842" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
