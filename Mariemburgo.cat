            <selectionEntryGroup name="Hechizos" id="c0bf-50f3-49d4-6879" collective="false" hidden="false" import="true">
              <selectionEntryGroups>
                <selectionEntryGroup name="Dominio de los elementos, parte 1" id="5176-aa6d-4964-a377" collective="false" hidden="false" import="true">
                  <constraints>
                    <constraint id="5081-a800-2abf-591c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
                    <constraint id="8619-aeeb-d1cf-9233" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="0"/>
                  </constraints>
