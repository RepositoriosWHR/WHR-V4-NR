          <infoLinks>
            <infoLink name="Esquivar (5+)" id="3ad4-1598-3f8b-7437" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
            <infoLink name="Orgullo marcial" id="405e-835a-6e07-9da9" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Duelista" id="c978-1882-5a5d-066a" hidden="false" typeId="98cd-bd8b-f52a-6fd7" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="8c79-e536-addc-8a74">El guerrero no podrá equiparse con Escudo o armaduras que no sean Armadura ligera. Obtendrá las reglas especiales Esquivar (5+) y Orgullo marcial, y podrá repetir sus tiradas para impactar no superadas luchando en un desafío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
