            <profile name="Escamas de sirena" id="0882-72d2-7eb5-a4cc" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Otorga al portador las reglas especiales Piel escamosa (5+) y Esquivar (4+). Adicionalmente, los enemigos en contacto con el portador verán reducido en 1 su atributo de Ataques (hasta un mínimo de 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Mariemburgo" id="c6b5-5772-a9b0-c0e9" collective="false" hidden="false" import="true">
