      <infoLinks>
        <infoLink name="Carro" id="7336-7f97-a45b-c4f8" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink name="Indesmoralizable" id="73e0-c153-37d8-3924" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink name="Inmune al veneno" id="5892-5f98-9e00-f1a2" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
        <infoLink name="Cruzar" id="4bc1-9b41-80e2-af84" hidden="false" targetId="7ea4-f7e1-7e21-9266" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Elementos acuáticos)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Terror" id="9288-d534-a5bd-c104" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
