          <profiles>
            <profile name="Reservado" id="1a96-b1ac-e1f9-ded5" hidden="false" typeId="98cd-bd8b-f52a-6fd7" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="8c79-e536-addc-8a74">El personaje no puede otorgar su Liderazgo a ninguna unidad, teniendo que chequear con el L de la propia unidad en caso de que fuera más bajo que el del personaje. El personaje obtiene +1 Ataque.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Devoto de Manann" id="3e47-6a0b-867e-67cc" collective="false" hidden="false" import="true" type="upgrade">
