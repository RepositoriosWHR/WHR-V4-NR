            <entryLink name="Reliquia" id="0578-e1f1-0e9a-a179" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Joya de suerte infundada" id="94b3-f6d5-f15d-67b0" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas de Potencia de Unidad 4 o inferior. Otorga una tirada de salvación especial de 2+ a su portador. Si fallas una tirada de salvación especial, la joya se romperá en mil pedazos, por lo que no podrás volver a utilizar su propiedad en la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Reliquias. Mariemburgo. Pagador o Tesorero" id="eb32-804c-e7ed-cb2c" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="7b52-2894-ec08-f404" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="de46-9a03-c86d-2564" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Corneta del pagador" id="3adf-85ba-b109-8180" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7576-9bff-ca38-314e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c215-f185-bf1e-e01a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="ada2-77f0-11d8-b339" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Corneta del pagador" id="32e0-8163-5c71-48ea" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Pagador o Tesorero. En la fase de movimientos, al inicio de la subfase resto de movimientos, selecciona una única unidad de infantería a 6” o menos del portador y que no se encuentre en combate cuerpo a cuerpo ni haya cargado ese turno. Esta unidad, podrá reformarse superando automáticamente el chequeo incluso si no tuviese músico. Después, podrá mover, marchar o disparar como si no se hubiera Reformado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Mariemburgo. Pagador o Tesorero" id="79e0-d745-4c5b-fba9" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="90eb-894f-6eea-979d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="1854-5c73-0a74-12f8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Cofre del soborno" id="2c8f-834f-63d9-56df" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="78ae-d0b9-ced6-233b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9ab6-8289-94c4-c40e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cofre del soborno" id="108f-5593-df21-d7c1" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo pagador o Tesorero. Un solo uso. Al principio del turno del oponente, elige una unidad enemiga a 12’’ o menos del portador. La unidad no podrá declarar una carga a la unidad del portador del cofre. No tiene ningún efecto contra miniaturas Inmunes a Psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
