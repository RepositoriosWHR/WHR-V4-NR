      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Plegarias Hilaria Om Klimt" id="adc6-400d-4372-a11c" hidden="false">
          <description>Hilaria conoce todas las Plegarias de Manann y puede lanzar dos de ellas por fase de magia con nivel de energía 1D6+1.</description>
        </rule>
        <rule name="Favor divino" id="721d-aef1-7d33-0724" hidden="false">
          <description>Tiene las reglas especiales Esquivar (5+) y Resistencia mágica (2).</description>
        </rule>
        <rule name="Agitadora fanática" id="0195-3f42-d8fd-cd35" hidden="false">
          <description>Hilaria no puede incluirse en una unidad con la regla especial Ley y orden. Si se incluye en una unidad de tropa básica Hilaria y la unidad obtendrán la regla especial Sangre fría.</description>
        </rule>
      </rules>
