                      <repeats>
                        <repeat childId="77af-a23b-d61b-1345" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="6c16-bc8c-935d-a081" shared="true" value="1"/>
                      </repeats>
