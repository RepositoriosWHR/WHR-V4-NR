    <selectionEntry name="Barco de tierra de clase &quot;Mariemburgo&quot;" id="1d5b-6abd-2ccb-2f04" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="7db0-4b54-e370-9e19" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
        <constraint id="673b-9dab-2345-955d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
