          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="4bc9-dae3-6a27-5126" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Inflamable" id="678b-1530-80b4-d081" hidden="false" targetId="93e4-15ce-63a5-ad92" type="rule"/>
            <infoLink name="Regeneración (6+)" id="8c50-caa1-6ec2-3fb3" hidden="false" targetId="4aee-7485-a141-cd20" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Barril de licor de lagarto del trueno" id="3ca6-086e-4ff2-d740" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y la unidad en la que se encuentre obtienen las reglas especiales Regeneración (6+), Inmune a psicología e Inflamable.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Trozo de hielo encantado" id="c11e-bd92-9eb4-6c79" collective="false" hidden="false" import="true" type="upgrade">
