          </costs>
          <infoLinks>
            <infoLink name="Aura de frio" id="9bbd-798b-a2bf-0553" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Trozo de hielo encantado" id="9a99-6101-1cf8-2367" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a su portador la regla especial Aura de frío.</characteristic>
              </characteristics>
