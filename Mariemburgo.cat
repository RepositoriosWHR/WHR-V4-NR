          <profiles>
            <profile name="Jugador sucio" id="5eff-e11f-5267-8916" hidden="false" typeId="98cd-bd8b-f52a-6fd7" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="8c79-e536-addc-8a74">Sólo personaje equipado con Pistola. Cuando el personaje sufre una herida en cuerpo a cuerpo, puede automáticamente realizar un ataque con su pistola (fuera de la secuencia habitual) contra la miniatura o unidad que le causó la herida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Renombres. Infantería" id="5b93-ee6b-5abd-b288" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Duelista" id="50cf-cb2f-449f-2ef8" collective="false" hidden="false" import="true" type="upgrade">
