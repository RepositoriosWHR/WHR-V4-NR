          <infoLinks>
            <infoLink name="Esquivar (6+)" id="f416-c66c-c995-2f76" hidden="false" targetId="c905-72a4-c706-6a16" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Colgante del buen porvenir" id="acd8-6994-178e-fa69" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga al portador la regla especial Esquivar (6+). Además, podrá repetir todas las tiradas de chequeos de atributo (excepto Liderazgo) que debiese efectuar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Manto de opulencia desmedida" id="4145-785e-973e-62c4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bac3-7d26-92f2-1260" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3f6b-388f-0ac4-98de" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Tozudez" id="a237-e943-0242-1ed7" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Con unidad de Mercenarios)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Manto de opulencia desmedida" id="f0d4-6199-ddbc-1426" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Las miniaturas con la regla mercenario que quieran atacar al portador en combate cuerpo a cuerpo deberán superar primero un chequeo de liderazgo usando 3D6 y sumando los tres resultados. Si el chequeo falla no podrán atacarle durante esa fase de combate. Si el portador se ha unido a una unidad con la regla especial Mercenario, la unidad obtendrá la regla especial Tozudez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino del Contrato vinculante" id="a480-12eb-dc3e-490a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1ad3-8277-6997-ac24" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="db9b-05e9-572a-8c93" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="6e7a-fc33-715b-c85c" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pergamino del contrato vinculante" id="fc37-8d64-ec06-2925" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todas las unidades amigas mercenarias a 12” o menos del portador serán Inmunes a la psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolsa de oro mágico" id="3426-4afd-fc33-506e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e28e-188b-ea4f-636e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c860-c5ef-9719-cc17" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
