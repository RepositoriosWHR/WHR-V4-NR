            <profile name="Coraza de Monte Castello" id="683f-a21a-003f-5623" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Proporciona a su portador la regla especial Piel escamosa (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escudo rúnico de los nueve mares" id="1322-893d-a8eb-63be" collective="false" hidden="false" import="true" type="upgrade">
