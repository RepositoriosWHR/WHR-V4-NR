          <profiles>
            <profile name="Armadura de las Fauces" id="eb8e-4983-16d6-b0a7" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. El portador obtiene la regla especial Regeneración (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño Codicioso" id="02c1-bf30-51df-f5e9" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="f523-e542-9d2d-8427" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Parada" id="2489-5139-f920-b0c8" hidden="false" targetId="9d92-3851-6695-cf71" type="rule"/>
            <infoLink name="Puño de hierro" id="309b-eabb-5726-f3c8" hidden="false" targetId="de57-9e6a-9339-f60f" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Puño Codicioso" id="ec00-856e-ec96-a6a7" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Puño ogro. El portador obtiene una tirada de salvación especial de 5+. Si el portador salva una o más heridas causadas por un Arma mágica con esta salvación especial, el Arma mágica quedará destruida y pasará a considerarse un arma mundana de su mismo tipo. Un hechicero herido por el Puño codicioso debe tirar 1D6 al final de la fase de combate cuerpo a cuerpo en la que fue herido: si obtiene un resultado superior, perderá inmediatamente un nivel de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Puño de Hierro" id="85fd-bd2d-b008-da16" hidden="false">
              <description>Al inicio de cada combate la unidad decidirá si los usa como escudo o como una maza ogra como arma de mano adicional. Si se utiliza como escudo puede usarse Parada.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Ogras. Reliquias" id="87b4-616f-e4dd-aee6" collective="false" hidden="false" import="true">
      <constraints>
