            <profile name="Casa van Scheldt" id="8ddc-723c-1353-f199" hidden="false" typeId="4c2e-af32-6247-c264" typeName="Casa de Mariemburgo">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a25c-0ed4-3f72-955b">Puedes incluir una unidad de Guardianes de Van Sclhedt como Unidad Especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Casa van Raemerswijk" id="ea91-9f2c-ec71-5858" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="54a9-28d2-b0b4-77cb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="22a2-0398-fbae-dc22" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Casa van Raemerswijk" id="ac5c-283b-60f0-c52a" hidden="false" typeId="4c2e-af32-6247-c264" typeName="Casa de Mariemburgo">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a25c-0ed4-3f72-955b">Puedes incluir una única Batería ligera de pólvora como Unidad Singular. Si incluyes un tesorero puedes añadir una batería ligera de pólvora adicional como Unidad Especial (aparte de la singular).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Casa Fooger" id="eaa3-e3b0-f537-df36" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4b24-fb7e-4fab-4286" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d9a6-4f20-7db2-2932" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Casa Fooger" id="c79a-a37f-07c1-0aba" hidden="false" typeId="4c2e-af32-6247-c264" typeName="Casa de Mariemburgo">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a25c-0ed4-3f72-955b">Puedes incluir la Milicia enana como Unidad Singular. Además, el Tesorero o Pagador que permitió su inclusión podrá sustituir su Armadura pesada o Armadura ligera por Armadura de gromril (+5 puntos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Casa van den Nijmenk" id="b461-97c2-6478-3f2c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c86c-ec23-01e2-bdfd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c68b-2110-16e7-3d2c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Casa van den Nijmenk" id="1747-7836-7163-d79f" hidden="false" typeId="4c2e-af32-6247-c264" typeName="Casa de Mariemburgo">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a25c-0ed4-3f72-955b">Puedes incluir la milicia privada de Van Den Nijmenk como Unidad Básica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Casa den Euwe" id="9425-cf15-6bbd-5cdc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="72e9-fcee-a008-9b96" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3cd4-0166-127b-eb87" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Casa den Euwe" id="bab8-a724-b1e7-348d" hidden="false" typeId="4c2e-af32-6247-c264" typeName="Casa de Mariemburgo">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a25c-0ed4-3f72-955b">Puedes incluir una Milicia privada Samurai como Unidad Singular. El Tesorero o Pagador que permitió su inclusión puede equiparse con Katana (+2 puntos) y obtiene las reglas especiales Honor ancestral y Samurai exiliado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Honor ancestral" id="8d41-7c93-9c9c-ddde" hidden="false">
              <description>Las miniaturas con esta regla tendrán las reglas especiales Inmune a Miedo y Sangre fría. Un personaje con esta regla especial no puede unirse a unidades que no la tengan.</description>
            </rule>
            <rule name="Samurái exiliado" id="ad35-3cac-1d2d-7c2e" hidden="false">
              <description>Las miniaturas con esta regla especial no podrán equiparse con Escudo. Los personajes y oficiales con esta regla
especial tienen la regla Orgullo marcial. Además, las miniaturas con esta regla especial obtienen siempre un bonificador de +1 a su tirada de salvación por armadura en combate cuerpo a cuerpo y superan automáticamente los chequeos de pánico provocados por unidades amigas sin esta regla especial.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Mariemburgo. Armas emparejadas" id="a274-4a40-1df8-6ba9" collective="false" hidden="false" import="true">
