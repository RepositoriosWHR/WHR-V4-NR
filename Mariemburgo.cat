      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="b002-4b5e-8d28-bf6d" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Mercenario" id="a87d-665e-7617-614f" hidden="false" targetId="f693-0c5c-49bd-91e7" type="rule"/>
        <infoLink name="Vanguardia" id="8b42-6f7b-78e8-226c" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
        <infoLink name="Cruzar (obstáculos)" id="a192-867f-d9eb-ed3e" hidden="false" targetId="5dfd-3f02-cece-1e02" type="rule"/>
        <infoLink name="Regimientos de renombre" id="436d-2ca0-1ee2-cdb7" hidden="false" targetId="a07a-2bc2-efde-20d3" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Bucaneros de por vida" id="8fa8-1aae-d850-5af2" hidden="false">
          <description>Los Bucaneros tienen la regla Cruzar (Obstáculos) y pueden repetir sus tiradas fallidas para impactar en el turno en el que realizaron la carga. Además, durante el turno en que cargan con éxito a una unidad que se encuentra tras cobertura, no sufren penalizadores al atacar.</description>
        </rule>
        <rule name="Combate en mar" id="6d85-4749-5114-8fbb" hidden="false">
          <description>Si los Bucaneros se encuentran en un elemento de escenografía acuático, los oponentes tendrán un penalizador de -1 al impactarles en cuerpo a cuerpo y los bucaneros obtendrán un bonificador de +1 a impactar en cuerpo a cuerpo. Este bono no puede usarse contra unidades con Cruzar (Elementos acuáticos).</description>
        </rule>
      </rules>
