          </modifiers>
        </infoLink>
        <infoLink name="Ni un paso atrás" id="1c99-4402-c260-a392" hidden="false" targetId="f76e-5a01-1c6b-ef76" type="rule"/>
        <infoLink name="Mercenario" id="a497-7d47-c719-6e77" hidden="false" targetId="f693-0c5c-49bd-91e7" type="rule"/>
        <infoLink name="Es el que paga" id="7a24-ecaf-1fc3-ee23" hidden="false" targetId="335d-4284-9114-2056" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="84b7-e46a-4df8-dcfd" type="set" value="0">
          <conditions>
            <condition childId="4a3c-f592-31e5-6b5f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Pagador de la casa" id="d20b-426b-7528-2a46" hidden="false">
          <description>La regla especial ¡Ni un paso atrás! afecta tanto a las miniaturas con la regla especial Mercenario como las miniaturas sin ella de un ejército de Marienburgo.</description>
        </rule>
        <rule name="Heraldo de la Familia" id="441e-7485-95f3-e3e5" hidden="false">
          <description>El Tesorero se considera un Pagador a todos los efectos, y mantiene todas sus reglas especiales. Por lo tanto, no podrá incluirse en el mismo ejército que un Héroe Pagador. Además, podrá incluir una única Escolta de las Grandes Casas Mercantiles como Unidad Básica en caso de ser Unidad Especial, o como Unidad Especial en caso de ser Unidad Singular. El Tesorero del Patriarca puede ser General del ejército a pesar de tener la regla especial Es el que paga.</description>
        </rule>
      </rules>
      <selectionEntries>
