            <infoLink name="Resistencia mágica (1)" id="1673-93ed-6bd4-17d9" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Colgante de tripas de troll" id="367b-eb30-d9f8-b43f" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtendrá las reglas especiales Regeneración (5+) y Resistencia mágica (1)</characteristic>
              </characteristics>
