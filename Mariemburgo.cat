      <infoLinks>
        <infoLink name="Infantería monstruosa" id="c62c-456e-a8b7-32e3" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink name="Miedo" id="232a-03a9-9fc1-ce3f" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
