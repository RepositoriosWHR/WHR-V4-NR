          <profiles>
            <profile name="Contrabandista" id="be36-eec1-d3fc-1b30" hidden="false" typeId="98cd-bd8b-f52a-6fd7" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="8c79-e536-addc-8a74">Otorga al personaje y a la unidad junto a la que sen incluya la regla especial Explorador. Solamente las unidades de tipo Infantería con potencia de unidad 15 o inferior pueden beneficiarse de esta regla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Reservado" id="8dcb-98f8-57a3-f8a8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d9cd-c0e9-de9f-7347" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="347a-4429-048a-bdaa" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
