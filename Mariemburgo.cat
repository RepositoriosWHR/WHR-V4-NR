        <infoLink name="Odio" id="e15d-985b-1bd1-2cd5" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(No muertos, Demonios)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Esquivar (5+)" id="a4e0-d2d6-a568-1507" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
        <infoLink name="Resistencia mágica (2)" id="42ad-5eac-7bc6-f0e4" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
