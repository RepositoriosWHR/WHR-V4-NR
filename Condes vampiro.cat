      <rules>
        <rule name="Señor de Vampiros Von Carstein" id="e434-3182-8362-54cd" hidden="false">
          <description>Puede lanzar hechizos pese a llevar armadura.</description>
        </rule>
        <rule name="Magia Señor de vampiros Von Carstein" id="b58d-af06-8fac-cf0f" hidden="false">
          <description>Es un hechicero de nivel 2 que puede convertirse en 
hechicero de nivel 3 por +50 puntos. Puede elegir sus hechizos de uno (y solo uno) de los Saberes de la Muerte, las Sombras, Magia Oscura o Nigromancia.</description>
        </rule>
