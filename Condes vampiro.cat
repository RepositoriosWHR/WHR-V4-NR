      <rules>
        <rule name="Magia del Duque rojo" id="6d01-4692-7d35-c9a6" hidden="false">
          <description>El Duque Rojo es un hechicero de nivel 3 que siempre utiliza hechizos del Saber de Nigromancia.</description>
        </rule>
        <rule name="Azote de Bretonia" id="214c-03ba-5e2d-1901" hidden="false">
          <description>El Duque Rojo causa Terror a todas las miniaturas del ejército de Bretonia; además, todos los bretonianos obtienen la regla especial Odio (Duque Rojo).</description>
        </rule>
      </rules>
