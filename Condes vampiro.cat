        <infoLink name="Regeneración (4+)" id="aa79-4de1-2509-ad5e" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
        <infoLink name="Ataques aleatorios" id="5bb1-3674-cd93-6b2c" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule"/>
        <infoLink name="Ataques envenenados" id="bd5b-c186-4971-1d53" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink name="Protección por montura (1)" id="eb56-04fa-c6ff-e4b7" hidden="false" targetId="1f9d-b34a-3d89-add6" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Potencia de unidad 4" id="531d-59ef-67de-94d0" hidden="false"/>
        <rule name="Horda de zombis" id="1a3b-7466-40b7-535c" hidden="false">
          <description>La Horda de zombis tiene las reglas especiales Ataques aleatorios (2D6) y Ataques envenenados; gracias a los zombis, el Carro de cadáveres puede marchar pese a ser un carro; sin embargo, no tiene la regla especial Veloz.</description>
        </rule>
        <rule name="Miasma de descomposición" id="79e0-7abe-c9e4-19e9" hidden="false">
          <description>Todos los ataques cuerpo a cuerpo y de proyectiles que se dirijan contra un personaje montado en Carro de cadáveres tendrán un penalizador de -1 para impactar.</description>
        </rule>
        <rule name="Foco de poder nigromántico" id="fa28-f4b9-c6c9-90a5" hidden="false">
          <description>Todas las unidades amigas con la regla especial No muerto a 12” o menos de un Carro de cadáveres obtienen la regla especial Regeneración (6+ o +1 a su Regeneración si ya disponían de ella) y podrán marchar como si se encontrasen a 12” o menos del General del ejército.</description>
        </rule>
      </rules>
      <selectionEntries>
