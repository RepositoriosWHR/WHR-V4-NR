            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Señor de la no muerte" id="11b3-aca3-29d2-5cec" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Esqueletos, Zombis o Leva sylvana, suma +1 por dado de invocación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Invocar a las criaturas de la noche" id="e757-2717-cdf9-23d3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1ac5-c7fc-da1a-78af" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="375a-5347-e3a4-b31e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
