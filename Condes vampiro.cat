              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Todas las tiradas para impactar exitosas en cuerpo a cuerpo contra el portador deberán repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brazales de oro negro" id="c187-13d8-03f7-27ad" collective="false" hidden="false" import="true" type="upgrade">
