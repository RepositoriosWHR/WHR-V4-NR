                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Sólo Infantería. El vampiro obtiene la regla especial Volar (10).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Forma espectral" id="7919-8fc0-cb87-4517" collective="false" hidden="false" import="true" type="upgrade">
