            <profile name="Familiar necrótico" id="ed18-de90-c0bb-a940" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Permite repetir las tiradas de los dados de invocación de los hechizos Invocación de Nehek y Animar muertos que lance el portador. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
