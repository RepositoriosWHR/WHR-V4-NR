                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">El vampiro obtiene la regla especial Orgullo marcial. Puede repetir todas sus tiradas para impactar no superadas en los Desafíos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
