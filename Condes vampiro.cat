      <rules>
        <rule name="¡Están vivos!" id="4fa0-1efc-b90b-fc55" hidden="false">
          <description>Los murciélagos son seres vivos, por lo que no están sujetos a las reglas para no muertos.</description>
        </rule>
        <rule name="Nube de horror" id="93f7-b85c-b495-3c3d" hidden="false">
          <description>Las unidades enemigas en contacto peana con peana con una o más Bandadas de murciélagos tienen un penalizador de -1 a su Habilidad de Armas e Iniciativa (hasta un mínimo de 1).</description>
        </rule>
      </rules>
