          <profiles>
            <profile name="Ojo de W&apos;soran" id="27b9-8148-e925-e91c" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, tras tirar los Vientos de la Magia, puedes decidir repetir la tirada. Si lo haces, el portador sufre una herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
