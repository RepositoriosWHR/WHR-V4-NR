              </costs>
              <infoLinks>
                <infoLink name="Arma de mano" id="b2b7-d837-82ce-63b6" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Báculo de Kaph-Amon" id="52fc-f7f8-1c95-56a6" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Permite a Zakarías almacenar en él hasta 3 dados de Energía o Dispersión no utilizados para usarlos posteriormente en otra fase de magia. Mientras el báculo tenga guardado un dado, proporciona un bonificador de +2 a la Fuerza de Zakarías en combate cuerpo a cuerpo; si tiene dos, también le proporciona +1 Ataque y, si tiene 3, además, la regla especial Golpe letal en sus ataques en combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Libro de Nagash" id="04ad-d4a8-d280-3b19" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4b2b-f23e-b604-7983" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0d37-e68e-53e5-83c2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Libro de Nagash" id="c9de-2274-ca57-6a72" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Zakarías conoce tres hechizos adicionales (para un total de 7); además, tendrá un bonificador de +1 a sus tiradas de lanzamiento de hechizos para los tres hechizos adicionales proporcionados por el libro (selecciona cuáles son al inicio de la batalla).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pergamino de Semtep" id="82eb-4edd-7816-8ec1" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="deed-6e4e-735c-76f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0fe0-12e6-ca85-b5b9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Pergamino de Semtep" id="e9d2-73a6-6515-c455" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Puede utilizarse hasta tres veces durante la batalla: una de las veces puede utilizarse como un Pergamino de dispersión de magia (ver reglamento), otra como un objeto portahechizos con nivel de energía 5 que contiene la Danza macabra de Vanhel (Nigromancia) y otra  como un objeto portahechizos con nivel de energía 5 que contiene la Invocación de Nehek en su versión potenciada (Nigromancia).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corona de Rathek" id="7ebd-c6ca-2373-e79e" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5bb0-3fc7-a86c-9eff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="4340-7ece-5acd-4075" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
