      <rules>
        <rule name="Magia Señor de vampiros Strigoi" id="891e-f068-8155-b055" hidden="false">
          <description>Es un hechicero de nivel 2 que puede convertirse en hechicero de nivel 3 por +50 puntos. Puede elegir sus hechizos de uno (y solo uno) de los Saberes de la Muerte, las Sombras, Magia Oscura o Nigromancia.</description>
        </rule>
      </rules>
