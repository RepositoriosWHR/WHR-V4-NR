                    <characteristic name="TSE" typeId="5.761726453617665e+35"/>
                    <characteristic name="Tipo" typeId="5.479706523232345e+27">Monstruo</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="El devorador" id="4ed8-a7a8-583c-0f5a" hidden="false">
                  <description>Cada vez que Nagadron cause una herida en combate cuerpo a cuerpo a un enemigo, tira 1D6: si obtienes un resultado de 4+, Nagadron puede recuperar una herida que hubiese sufrido previamente durante la batalla.</description>
                </rule>
              </rules>
