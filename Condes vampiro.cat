            <profile name="Estirpe noble de Nehekhara" id="e19a-2348-3518-009f" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cada vez que el vampiro lance un hechizo, puede repetir los dados de Energía si lo desea. Debe repetirlos todos o ninguno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Astrología impía" id="0d80-1199-46f6-17e5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5db5-d55a-e1bd-cf39" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6d99-213b-ce6b-b4f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Astrología impía" id="0abc-2965-6ea8-408c" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Una vez por turno de juego, el vampiro puede repetir una tirada, que puede ser una tirada para impactar o herir, una tirada de salvación (por armadura o especial), un chequeo de atributo, una tirada de ¡Cuidado, señor!, un dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Condes vampiro. Arma de mano" id="0195-9dd2-ee77-cb3e" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="d3a1-50a4-1207-9724" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="96bc-5d46-f6ac-1a91" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Drenadora de sangre" id="152d-113a-d579-4f4e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="15e8-e098-ed62-683f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="928d-7e61-648a-fce3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="235c-09cf-5b72-213f" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Drenadora de sangre" id="0fee-7789-209e-9992" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos con este arma se resuelven con un bonificador de +1 a la Fuerza. Por cada herida causada en cuerpo a cuerpo con este arma, el portador podrá restablecer una de las heridas que hubiese sufrido con anterioridad durante la batalla. Esto sustituye a la regla habitual de recuperar heridas por la regla especial Vampiro.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espada de energía maldita" id="a26c-1e53-0aba-2f55" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="32f6-12c6-caca-ebff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3898-1671-6460-3e60" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="2445-1277-867a-712d" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espada de energía maldita" id="23c9-3c00-f2c1-d4fd" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Por cada herida causada con este arma en combate cuerpo a cuerpo a un enemigo (que no tenga la regla especial No muerto o Demonio), el portador genera un dado de Energía o Dispersión adicional (según corresponda) en la próxima fase de magia. Tan sólo el portador podrá utilizar esos dados adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bastón de poder" id="b99c-2430-cba6-1818" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4727-dd48-692d-df6c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bb6d-c309-8e9b-f8de" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="228d-2b4a-5c24-f0c7" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Bastón de poder" id="ed13-96d8-69e8-cf67" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Puede guardar un dado de Energía o Dispersión para usarlo en la siguiente fase de magia. Mientras tenga un dado guardado, el portador suma +2 a su Fuerza en cuerpo a cuerpo al atacar con este arma.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
