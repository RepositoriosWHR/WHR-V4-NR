          <profiles>
            <profile name="Forma de murciélago" id="ab8d-753d-4fb5-268c" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Sólo Infantería. El vampiro obtiene la regla especial Volar (10).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estirpe de Sylvania" id="6cae-0006-b994-4b6f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="85a0-1e0d-f2b5-b69a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="caf6-826c-139e-dfd9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
