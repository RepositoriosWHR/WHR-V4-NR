      <rules>
        <rule name="Magia Rametep" id="69b5-78c4-1236-ed9f" hidden="false">
          <description>Rametep es un hechicero de nivel 1. Puede elegir sus hechizos del Saber de las Sombras o Nigromancia.</description>
        </rule>
        <rule name="El Terror subterráneo" id="8cab-75c7-b35e-c268" hidden="false">
          <description>Rametep y 
la unidad de Striganos que comande tienen la regla especial Avance subterráneo.</description>
        </rule>
        <rule name="Detesta a los skavens" id="b98d-dcb7-c92d-9375" hidden="false">
          <description>Rametep puede repetir todas sus tiradas para impactar fallidas en combate cuerpo a cuerpo cuando lucha 
contra unidades con la clave SKAVEN.</description>
        </rule>
      </rules>
