      <rules>
        <rule name="Magia Zakarías el eterno, del clan Necrarca" id="1281-10e4-3a51-d111" hidden="false">
          <description>Zakarías es un hechicero de nivel 4 que puede elegir sus hechizos de entre los Saberes de la Muerte y/o Nigromancia y puede mezclar diversos saberes a la hora de generar sus hechizos.</description>
        </rule>
        <rule name="Guardián de las tradiciones del clan Necrarca" id="b84d-1ded-5d30-ddd1" hidden="false">
          <description>Una vez por batalla, al inicio de cualquier fase de magia propia, Zakarías puede acudir a las reservas de poder distantes que posee en los refugios del clan. Zakarías genera inmediatamente 1D6 dados de Energía, que sólo él podrá usar.</description>
        </rule>
        <rule name="Nube de moscas" id="c53d-03bb-fd88-8519" hidden="false">
          <description>Los enemigos tienen un penalizador de -1 para impactar en disparo y en combate cuerpo a cuerpo a Zakarías con esta regla especial.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Poderes vampíricos" id="d244-5f91-9d3a-c727" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="58de-8576-6a5f-f45c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
