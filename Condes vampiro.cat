          <infoLinks>
            <infoLink name="Orgullo marcial" id="042a-dd56-72d6-b804" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Honor o muerte" id="5b6e-bef4-0677-9f9e" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">El vampiro obtiene la regla especial Orgullo marcial. Puede repetir todas sus tiradas para impactar no superadas en los Desafíos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Férrea voluntad" id="e239-d1a8-265f-02c2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f2d5-4eaf-c248-a5c9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ff17-f4bb-6edc-5c4e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Férrea voluntad" id="ec4c-c5bd-49fd-3e76" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Todas las miniaturas no muertas amigas a 12&quot; o menos del vampiro sufren una herida menos como resultado de perder un combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Forma de murciélago" id="779d-22c1-96df-19ec" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bc70-0225-4989-ee84" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0fbf-ba90-22a7-4a89" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
