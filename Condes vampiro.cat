          <entryLinks>
            <entryLink name="Reliquia" id="668b-e2ce-df8b-4e36" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="El Anillo de los Carstein" id="c434-1f38-2812-7d33" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo Clan Von Carstein. No puede ser utilizado por personajes con Potencia de unidad 5 o superior. Proporciona a su portador la regla especial Regeneración (5+). Además, una vez por batalla, si el portador muere, tira 1D6: con un resultado de 2+, volverá a la vida con 1D3 heridas restantes, en cualquier punto a 12” o menos del lugar donde murió (puedes unirlo a una unidad) a más de 1” de cualquier unidad enemiga. No puede unirse a unidades trabadas en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
