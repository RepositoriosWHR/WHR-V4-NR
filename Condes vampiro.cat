          <modifiers>
            <modifier field="name" type="append" value="(1)(Nigromante de Drakenhof)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Helman Ghorst" id="7058-57e5-6907-ecdb" hidden="false">
          <description>Helman Ghorst es un hechicero de nivel 2 que siempre utiliza hechizos del Saber de Nigromancia.</description>
        </rule>
        <rule name="Talento para la hechicería" id="b21a-65ec-1d9e-b586" hidden="false">
          <description>Helman Ghorst tiene un bonificador de +1 a todas sus tiradas de lanzamiento de hechizos.</description>
        </rule>
        <rule name="Nigromante de Drakenhof" id="3ed3-709d-3e05-a9e8" hidden="false">
          <description>Helman está vivo. Sin embargo, al ir montado en un carro con la regla especial No muerto, estará sujeto a las reglas de estos. Pese a estar vivo, Helman se considera No muerto (1) a efectos de recibir los efectos de los hechizos de Nigromancia.</description>
        </rule>
      </rules>
      <selectionEntries>
