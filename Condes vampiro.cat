            <profile name="El despertar de los muertos" id="e030-00ed-306d-c119" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cada vez que el vampiro utilice exitosamente los hechizos Invocación de Nehek o Animar muertos, tira un dado de invocación adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
