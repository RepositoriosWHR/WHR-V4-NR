      <rules>
        <rule name="Magia Señor de vampiros Necrarca" id="21e6-9a3b-4fc8-1438" hidden="false">
          <description>Es un mago de nivel 3 que puede convertirse en mago de nivel 4 por +55 puntos. Puede elegir sus hechizos de los Saberes de la Muerte, las Sombras, Magia Oscura y/o Nigromancia y puede mezclar diversos saberes a la hora de generar sus hechizos.</description>
        </rule>
      </rules>
