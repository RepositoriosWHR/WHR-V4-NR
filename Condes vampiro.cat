        <rule name="¡La muerte en llamas!" id="d871-7fa5-699d-ed16" hidden="false">
          <description>Los Jinetes espectrales tienen la regla especial Impactos por carga (1); esos impactos siempre se resuelven con Fuerza 5 y las reglas especiales Ataques mágicos y Ataques flamígeros.</description>
        </rule>
        <rule name="Fantasmas" id="94d6-cd7c-7d3c-a814" hidden="false">
