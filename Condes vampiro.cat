      <rules>
        <rule name="Magia Wallach Harkon" id="47e1-8fc6-ae8a-05e0" hidden="false">
          <description>Walach es un hechicero de nivel 2 que genera sus hechizos del Saber de Nigromancia.</description>
        </rule>
        <rule name="Estandarte de batalla" id="f641-291e-4e77-45ed" hidden="false">
          <description>Walach Harkon porta el Estandarte del Dragón Sangriento y debe ser el Portaestandarte de batalla del ejército. Si lo deseas, Walach puede ser también el General del ejército.</description>
        </rule>
        <rule name="Furia sangrienta" id="d279-499c-e1ae-c1a2" hidden="false">
          <description>Walach y su unidad podrán repetir sus tiradas de carga fallidas.</description>
        </rule>
      </rules>
