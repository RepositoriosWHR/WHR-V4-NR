            <profile name="Seducción" id="861d-80c3-f4d0-aa51" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Al inicio de cualquier fase de combate cuerpo a cuerpo propia, puedes elegir una miniatura enemiga que no tenga la regla especial Inmune a psicología en contacto peana con peana con la vampira. Esa miniatura deberá efectuar un chequeo de Liderazgo con su valor básico sin modificar (no puede utilizarse ni la Presencia inspiradora ni ¡Ni un paso atrás!). Si lo supera, no pasará nada; pero si lo falla, esa miniatura pasará a estar controlada por el jugador vampiro durante el resto de la partida. Si se encontraba en una unidad, debe separarse inmediatamente de ella. Este poder puede utilizarse una vez por fase de combate cuerpo a cuerpo propia, pero tan sólo se puede controlar una miniatura enemiga durante la batalla (es decir, puede usarse las veces que sean necesarias hasta que tenga éxito, momento en el cual no podrá usarse más).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Criatura de la noche" id="5a9a-e973-0aea-c8c0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d8e6-0263-2bd3-bb4a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6c0f-fc79-7e26-85cb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Criatura de la noche" id="1596-f84f-7701-32df" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">No puede elegirse este poder para miniaturas con Potencia de unidad de 5 o superior. En combate cuerpo a cuerpo y con proyectiles, la vampira sólo puede ser impactada con resultados naturales de 6, sin tener en cuenta otros modificadores. No tiene efecto alguno contra ataques que no tiren para impactar o que impacten automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Maestra de la ilusión" id="4cf4-27a9-b35f-c397" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3a10-7a67-21ab-fe76" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="65e7-24d1-d427-7bc2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Maestra de la ilusión" id="a281-497a-6244-aa6a" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cuando la vampira declare un Desafío, este no puede ser rechazado y puede elegir qué personaje enemigo aceptará su Desafío (esto tiene prioridad sobre la regla especial Orgullo marcial).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Forma espectral" id="b168-e7de-4c2c-4c37" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9d7e-bcbe-1c5d-1d78" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="62c5-193b-7af0-d24f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Etéreo" id="36dd-332c-d968-a964" hidden="false" targetId="34c4-9e60-1a62-eda5" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Forma espectral" id="ac4d-4c6b-6f75-3a2c" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">No puede elegirse este poder para miniaturas con Potencia de unidad de 5 o superior. La vampira obtiene la regla especial Etéreo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampíricos Von Carstein. Poderes menores" id="828d-d116-5ed8-6df1" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Señor de la no muerte" id="f7be-73c1-3aa1-9c28" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5044-9132-6a05-2539" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2e71-b7e2-3b89-2125" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
