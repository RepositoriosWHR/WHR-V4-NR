              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">El vampiro obtiene la regla especial Señor del conocimiento (Nigromancia).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El despertar de los muertos" id="b94e-4f12-f198-9483" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="92fb-2730-b712-7ec7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b16c-4d0b-f0b9-d655" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
