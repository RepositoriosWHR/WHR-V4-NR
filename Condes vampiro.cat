              </costs>
              <profiles>
                <profile name="Férrea voluntad" id="3e42-943b-1cfa-798e" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Todas las unidades con la regla especial No muerto a 12&quot; o menos de Vlad sufren una herida menos como resultado de perder un combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Honor o muerte" id="a076-d93f-dd0f-a543" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8619-28b3-0d9a-7e3d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="1463-b445-9e3d-fb9e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Orgullo marcial" id="9310-04ec-cd39-544b" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Honor o muerte" id="fb8a-a3bb-f97e-32e8" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Obtiene la regla especial Orgullo marcial. Puede repetir todas sus tiradas para impactar no superadas en los Desafíos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Invocar a las criaturas de la noche" id="4cec-f5dc-6dbf-3cf7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2da8-e5dc-e436-33d6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="5c52-3c05-5ea3-067f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Invocar a las criaturas de la noche" id="aabf-ea16-783c-8ff0" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cada vez que utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Murciélagos vampiro, Lobos siniestros, Lobos espectrales y Vargheist, suma +1 por dado de invocación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Señor de la no muerte" id="8edc-06eb-5b5f-3d51" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4b14-c273-1c00-17c6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="5735-78a7-7be7-b5b0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Señor de la no muerte" id="9dc7-aabe-8934-a9ad" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cada vez que utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Esqueletos, Zombis o Leva sylvana, suma +1 por dado de invocación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Aura negra de majestuosidad" id="c0b3-1610-edc9-8c29" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="da16-79f1-8b41-3f0f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="07c8-a4e8-48aa-6777" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Aura negra de majestuosidad" id="9761-5635-9818-29ac" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Todas las unidades enemigas a 6” o menos de Vlad tendrán un penalizador de -1 a su atributo de Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Despertar la tempestad" id="b66a-8cae-1bc0-2eb9" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="db59-ac0f-5026-f593" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="1ca0-dc00-0501-2a99" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Despertar la tempestad" id="a116-ee35-810b-a51d" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Al inicio de tu fase de movimiento, si Vlad no está trabado en combate cuerpo a cuerpo, puede invocar una tormenta. La tormenta tiene un radio de 12&quot; centrada en Vlad. Cualquier unidad que dispare hacia, desde o a través el interior de la tormenta sufrirá un penalizador de -2 para impactar; los efectos de Tormenta de proyectiles que disparen hacia, desde o a través reducirán sus impactos a la mitad; las catapultas o efectos que se dispersen de forma similar se dispersarán el doble dentro de la tormenta; los cañones sólo podrán disparar hacia, desde y a través si antes obtienen un resultado de 4+ en 1D6 y no se puede hacer uso de las reglas especiales Volar o Flotar hacia, a través y desde el interior. Si Vlad se traba en combate o muere, la tormenta cesará inmediatamente.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Señor de las legiones" id="b086-a0ef-ff16-8324" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="befe-1f51-afaf-32de" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="4996-77a9-2ba8-fd39" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Señor de las legiones" id="1ff9-788c-a02f-9e34" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Puede, con los hechizos Invocación de Nehek y Animar muertos, aumentar el número de las unidades de Leva sylvana por encima de su tamaño inicial.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Honor inmortal" id="5743-3388-b4dc-7d7f" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9771-bc19-9571-e926" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="6f88-fffd-c317-6df5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Honor inmortal" id="4dc5-93e3-2997-f803" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Si acaba con un personaje enemigo en un Desafío, podrá restaurar inmediatamente una herida que hubiese sufrido previamente durante la batalla y la unidad en la que estuviese incluido dicho personaje quedará Apabullada hasta el final de la fase de combate en curso.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Mirada hipnótica" id="6a0d-ebdf-4214-926c" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="945b-69cc-85c4-1991" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                <constraint id="ed43-e8b0-2f14-88cb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Mirada hipnótica" id="8c79-6982-3b00-e2dd" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Los enemigos tendrán un penalizador de -1 en sus tiradas para impactar en combate cuerpo a cuerpo contra el vampiro. No afecta a miniaturas con la regla especial No muerto o Demonio.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
