                <profile name="Férrea voluntad" id="2f74-0380-4516-9517" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Todas las miniaturas no muertas amigas a 12&quot; o menos del vampiro sufren una herida menos como resultado de perder un combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Señor de la no muerte" id="fef0-8d3f-3416-77ce" collective="false" hidden="false" import="true" type="upgrade">
