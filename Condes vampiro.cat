              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia del portador, el enemigo debe revelar todos sus objetos mágicos en un radio de 12” del portador. Además, podrás repetir la tirada en la tabla de Disfunciones 
mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Talismán negro" id="ab55-6083-2749-c4f9" collective="false" hidden="false" import="true" type="upgrade">
