        <rule name="Nube de moscas" id="3256-2e2d-f6f1-c7e4" hidden="false">
          <description>Todos los disparos y los ataques cuerpo a cuerpo contra un personaje montado en un Dragón zombi anciano tendrán un penalizador de -1 a su tirada para impactar.</description>
        </rule>
        <rule name="Monstruosidad ancestral" id="1dde-1fe0-f7af-d211" hidden="false">
          <description>El alcance del Terror que causa un Dragón zombi anciano es de 12” en lugar de las 8” habituales.</description>
        </rule>
        <rule name="Enorme" id="f83a-f5ca-ba88-0f2d" hidden="false">
          <description>Al repartir impactos de proyectiles y similares, el jinete de un dragón zombi anciano sólo será alcanzado con resultados de 6 (en lugar de 5-6 como es habitual).</description>
        </rule>
      </rules>
