                <profile name="Señor de la no muerte" id="834b-de20-677c-dc74" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Esqueletos, Zombis o Leva sylvana, suma +1 por dado de invocación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Invocar a las criaturas de la noche" id="323e-3614-b04a-e627" collective="false" hidden="false" import="true" type="upgrade">
