              </infoLinks>
              <rules>
                <rule name="Mandíbulas de acero" id="1757-1258-a9ce-3ca5" hidden="false">
                  <description>Obtiene la regla especial Golpe letal; no afecta a los ataques adicionales si está Infestado</description>
