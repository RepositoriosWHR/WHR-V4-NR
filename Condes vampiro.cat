          </costs>
          <infoLinks>
            <infoLink name="Aura demoníaca (3+)" id="67b3-686f-1f69-5c1f" hidden="false" targetId="df2b-0ff4-bf34-28b8" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estirpe de Sylvania" id="8d8c-a941-c020-c2e2" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">El vampiro obtiene la regla especial Aura demoníaca (3+); si el personaje tiene Potencia de unidad de 5 o superior, en lugar de eso otorga Aura demoníaca (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampíricos Von Carstein. Poderes mayores" id="b015-8f47-1b70-b860" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Aura negra de majestuosidad" id="fc09-5a48-f001-8de1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="01c1-cbe0-7023-b2eb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0e74-68e0-7e97-8cc7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Aura negra de majestuosidad" id="8b98-063e-0882-f702" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Todas las miniaturas a 6” o menos del vampiro tendrán un penalizador de -1 a su atributo de Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Despertar la tempestad" id="f5c9-951a-84ec-fdef" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bd06-47a0-b214-535a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b372-7ee6-9fa2-e1ab" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Despertar la tempestad" id="7bc9-a3f8-e1e5-1cbe" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Al inicio de tu fase de movimiento, si el personaje no está trabado en combate cuerpo a cuerpo, el vampiro puede invocar una tormenta. La tormenta tiene un radio de 12&quot; centrada en el vampiro. Cualquier unidad que dispare hacia, desde o a través el interior de la tormenta sufrirá un penalizador de -2 para impactar; los efectos de Tormenta de proyectiles que disparen hacia, desde o a través reducirán sus impactos a la mitad; las catapultas o efectos que se dispersen de forma similar se dispersarán el doble dentro de la tormenta; los cañones sólo podrán disparar hacia, desde y a través si antes obtienen un resultado de 4+ en 1D6; las armas de aliento o efectos que usen la plantilla de lágrima solamente causarán impactos parciales a las miniaturas en el interior de la tormenta (en combate actuarán normalmente) y no se puede hacer uso de las reglas especiales Volar o Flotar hacia, a través y desde el interior. Si el vampiro se traba en combate o muere, la tormenta cesará inmediatamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pureza de sangre" id="622a-469e-389c-1144" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2ea6-88b8-11fd-9511" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="023b-79ab-f26d-9f58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Tozudez" id="9d16-856e-491a-5e42" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pureza de sangre" id="2ae4-9d48-f31d-9966" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">El vampiro obtiene la regla especial Tozudez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Forma espectral" id="4de9-b146-c066-3c34" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="92b0-3827-fcf9-3a33" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5875-bba9-d8ab-c41b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Etéreo" id="c2a8-9ff3-dca7-e293" hidden="false" targetId="34c4-9e60-1a62-eda5" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Forma espectral" id="2579-5235-2d85-5da7" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">No puede elegirse este poder para miniaturas con Potencia de unidad de 5 o superior. El vampiro obtiene la regla especial Etéreo.</characteristic>
              </characteristics>
            </profile>
