    <selectionEntry name="Ingenio mortis (Necrarca)" id="760e-19fe-5ed6-50e0" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
