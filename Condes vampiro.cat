                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Vlad y todas las unidades amigas dentro de su radio de Presencia inspiradora obtienen la regla especial Tozudez.</characteristic>
