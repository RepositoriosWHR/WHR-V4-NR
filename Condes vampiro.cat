      <rules>
        <rule name="Magia Melkhior el anciano" id="f5e3-eeb5-b332-66b6" hidden="false">
          <description>Melkhior es un hechicero de nivel 4 que conoce todos los hechizos de Nigromancia.</description>
        </rule>
        <rule name="Mente enajenada" id="aec3-40c5-224e-b938" hidden="false">
          <description>Melkhior está sujeto a las reglas especiales Tozudez y Estupidez; debe realizar sus chequeos de Estupidez tirando 3D6 y descartando el resultado menor.</description>
        </rule>
        <rule name="Aguijón venenoso" id="958f-68e7-8054-0328" hidden="false">
          <description>El Horror abisal tiene un ataque adicional que se resuelve con +1 a su Fuerza y la regla especial Ataques envenenados.</description>
        </rule>
        <rule name="Aliento pestilente" id="d215-1b29-c956-fb81" hidden="false">
          <description>El Horror abisal posee un Arma de aliento de Fuerza 1 que no 
permite tirada de salvación por armadura.</description>
        </rule>
      </rules>
