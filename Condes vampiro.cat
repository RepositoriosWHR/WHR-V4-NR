          </costs>
          <profiles>
            <profile name="Invocar a las criaturas de la noche" id="372e-e90b-f0fc-8d31" hidden="false" typeId="6daf-483a-4d59-83db" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fd8d-dbea-6f9b-4f42">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Murciélagos vampiro, Lobos siniestros (o Lobos espectrales) o Vargheist, suma +1 por dado de invocación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Honor o muerte" id="c985-f765-2002-d57b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1d9e-a7ee-9d62-83c0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ec56-59a2-955a-a7fe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
