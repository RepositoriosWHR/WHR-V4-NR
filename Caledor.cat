                                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Otorga a su portador las reglas especiales Piel escamosa (6+) e Inmune a fuego</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                      </selectionEntries>
