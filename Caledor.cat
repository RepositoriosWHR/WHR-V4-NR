              <infoLinks>
                <infoLink name="Armadura dragón" id="3383-ee33-f45c-d892" hidden="false" targetId="397b-36ee-f4da-e8ba" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Armadura del dragón de Caledor" id="0c2f-82c8-c19b-3f2c" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de dragón. Otorga a Imrik una tirada de salvación por armadura de 4+ y una tirada de salvación especial de 4+. Además, Imrik no puede ser herido por Armas de aliento.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Cuerno del dragón" id="545f-163f-a3c2-b4ab" collective="false" hidden="false" import="true" type="upgrade">
