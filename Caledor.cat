            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="ce33-11da-1fec-0948" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Escama refulgente de Draugnir" id="b8d9-5a3c-4278-b947" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Si el portador de la escama fuera a ser retirado como baja, antes de ello tira 1D6: si obtienes un resultado de 1- 3, retíralo como baja con normalidad; con un resultado de 4-5-6 la miniatura permanece en el campo de batalla recuperando 1 herida, aunque sólo la primera vez que obtengas un resultado de 6 la miniatura recupera 1D3 heridas en lugar de una. Si el portador fuese a salir del campo de batalla por un movimiento de huida, retira la miniatura (se considera un resultado de 1-3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Corazón de Caledor" id="f1d2-6eb6-9469-685e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bd98-0089-67cf-2252" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7a8f-55dc-ddd2-1b27" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
