                              <characteristics>
                                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador, su unidad y sus monturas obtienen la regla especial Cruzar (todo terreno).</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="Estandarte de Saphery" id="c872-25ce-9dff-f7ce" collective="false" hidden="false" import="true" page="0" type="upgrade">
