              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a su portador la regla especial Impasible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Capa de las barbas" id="beb9-6d6f-dac8-a50a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d61f-f037-c916-6388" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e27f-3a6a-50bf-3d70" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Capa de las barbas" id="128b-82f8-b84f-3d78" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas fallidas para impactar en combate cuerpo a cuerpo contra enanos (de cualquier tipo). Además, al inicio de cada fase de combate, elige una miniatura de enano que esté en contacto peana con peana con el portador; esta debe tirar 1D6 por cada uno de sus objetos rúnicos. Con un resultado de 4+, el objeto rúnico no se ve afectado pero, con un resultado inferior, el objeto no podrá aplicar el efecto de ninguna de sus runas hasta el final de la fase de combate cuerpo a cuerpo. Sin embargo, todos los enanos obtienen la regla especial Odio contra el portador de esta capa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El libro del valor y la gloria" id="a61d-8aad-8b0d-395d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5c6b-ebb1-fb61-63d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bb9f-9a07-d9bc-6f9f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El libro del valor y la gloria" id="721c-b90e-fe70-21cb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a su portador un bonificador de +1 a su atributo de Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema del fuego solar" id="d9b7-08f0-1208-84e5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d21b-45cf-841a-9f81" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="71f3-ed8f-b235-393c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
