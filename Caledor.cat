                          <profiles>
                            <profile name="Gema radiante de Hoeth" id="c189-d3af-f5ec-5a30" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                              <characteristics>
                                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 4. Al inicio de cada una de tus fases de magia elige uno de los ocho Saberes básicos de la magia y efectúa una tirada de 1D6, ese será el hechizo contenido en la gema durante ese turno (pudiendo elegir si se da el bis). Recuerda que no podrás elegir el hechizo identificativo.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="Anillo de la ira" id="7bb0-7ecf-24ba-8b8d" collective="false" hidden="false" import="true" type="upgrade">
                          <constraints>
                            <constraint id="b2e9-3e67-9b28-2bfb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                            <constraint id="8a3d-5ac2-1de5-bed5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                          </constraints>
                          <costs>
                            <cost name="pts" typeId="points" value="40"/>
                            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                          </costs>
                          <profiles>
                            <profile name="Anillo de la ira" id="a95c-7f57-c475-3014" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                              <characteristics>
                                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 2. Contiene el hechizo Furia de Khaine en su versión no potenciada del Saber de Alta magia.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="El libro del valor y la gloria" id="23a1-5db3-b4bc-c7b9" collective="false" hidden="false" import="true" type="upgrade">
                          <constraints>
                            <constraint id="1c84-c68d-684a-f293" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                            <constraint id="bd17-a431-2d60-bd7c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                          </constraints>
