          </infoLinks>
          <profiles>
            <profile name="Escudo de escamas de dragón" id="b184-0bf4-64a8-3c8d" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Sólo miniaturas con Armadura de Dragón. Escudo. Otorga a su portador las reglas especiales Piel escamosa (6+) y mejora la salvación especial que proporciona la Armadura de Dragón a 5+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismas mágicos. Reliquias. Caledor" id="0748-1666-11e6-531e" collective="false" hidden="false" import="true">
      <constraints>
