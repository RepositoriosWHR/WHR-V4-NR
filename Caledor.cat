  <sharedProfiles>
    <profile name="Arco largo élfico" id="a79c-216f-e950-89cb" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">36&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Lluvia de flechas, Poder de penetración</characteristic>
      </characteristics>
    </profile>
    <profile name="Arco élfico" id="4d40-cfee-8abe-0c35" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">30&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Lluvia de flechas, Poder de penetración</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura dragón" id="397b-36ee-f4da-e8ba" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">5+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Armadura pesada. Ofrece una tirada de salvación especial de 6+. Su portador obtiene la regla especial Inmune a fuego.</characteristic>
      </characteristics>
    </profile>
    <profile name="Filo de Caledor" id="6b5c-97cb-193f-3263" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario +1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos</characteristic>
      </characteristics>
    </profile>
    <profile name="Barda de Ithilmar" id="3419-530d-38e8-8868" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Los corceles equipados con una barda de Ithilmar no verán reducido su movimiento por el peso de la barda; por lo demás se consideran bardas normales.</characteristic>
      </characteristics>
    </profile>
    <profile name="Capa de dragón" id="3a3f-2a03-0319-538e" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">6+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Otorgan al portador una tirada de salvación por armadura de 6+ que puede combinarse con otras armaduras, y la regla especial Inmune al fuego.</characteristic>
      </characteristics>
    </profile>
    <profile name="Vial de Fuego alquímico" id="64fe-f23d-ce94-aaa3" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">10&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Disparo rápido, Arrojadiza, Ataques solo flamígeros, Fórmula mejorada: Este arma siempre hiere con un resultado de 4+ y no permite tirada de salvación por armadura.</characteristic>
      </characteristics>
    </profile>
    <profile name="Garra de dragón" id="f8d8-e8a0-43b8-5949" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario +1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Atacar con fila adicional (1), Poder de penetración, Requiere ambas manos</characteristic>
      </characteristics>
    </profile>
    <profile name="Gran vasija de fuego alquímico" id="9fcd-c199-7667-486e" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">0-10&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Un solo uso. Ataques sólo flamígeros, Catapulta: Dispara como una Catapulta con la excepción de que puede Mover y disparar. Tienen un alcance de 0-10”: coloca la plantilla redonda pequeña dentro del alcance y tira los dados de dispersión y artillería (reduce las distancias del dado de artillería a la mitad). Si obtienes un resultado de Problemas, coloca la plantilla centrada en el lanzador. Fórmula mejorada: Este arma siempre hiere con un resultado de 4+ y no permite tirada de salvación por armadura.</characteristic>
      </characteristics>
    </profile>
    <profile name="Caledorian" id="5c57-3bd4-8db7-ba5c" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">Obtienen la regla especial Impasibles.</characteristic>
      </characteristics>
    </profile>
    <profile name="Emberfell" id="8632-9587-5f46-eaae" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">La salvación especial proporcionada por su Armadura de Dragón obtiene un bonificador de +1 frente ataques no mágicos.</characteristic>
      </characteristics>
    </profile>
    <profile name="Goldcrest" id="f215-a101-68da-4a35" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">Las monturas de la unidad pueden repetir los resultados de 1 al herir en sus Impactos por carga. Además, la unidad puede sumar 1” a las distancias de carga que efectúe.</characteristic>
      </characteristics>
    </profile>
    <profile name="Morvean" id="c127-10ef-2aa5-bc06" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">Los jinetes obtienen la regla especial Carga devastadora.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Destreza marcial" id="819b-edec-3e97-1ca6" hidden="false">
      <description>Las miniaturas de Infantería con esta regla especial equipadas con Lanza mejoran su regla especial Luchar con filas adicionales en +1. Además, pueden realizar Parada con las siguientes combinaciones de armas: Arma de mano y Escudo, Lanza y Escudo, Lanza, Armas emparejadas y Filo de Caledor y Escudo.</description>
    </rule>
    <rule name="Valor familiar" id="2882-fac9-f267-b8e7" hidden="false">
      <description>Las unidades de un ejército de Caledor con esta regla especial que se enfrenten a un ejército con alguna unidad con la clave ELFOS OSCUROS obtienen la regla especial Inmune a psicología, aunque las unidades que también tengan las reglas especiales Hostigador y/o Caballería rápida podrán declarar Huir o Disparar y huir como reacción a una carga.elfos.</description>
    </rule>
    <rule name="Orgullo ancestral" id="76e4-de12-8e30-50cb" hidden="false">
      <description>Todas las unidades con esta regla serán inmunes al pánico si se encuentran a 12” o menos de un Dragón aliado. Solamente se podrán unir personajes a unidades con esta regla si también disponen de ella..</description>
    </rule>
    <rule name="Opulencia desmesurada" id="09ba-21d0-b58b-8b12" hidden="false">
      <description>Todos los personajes que incluyas en el ejercito que pudiesen equiparse con objetos mágicos deberán equiparse con el numero máximo que les estuviese permitido. Esta regla también es aplicable a los portaestandartes de las unidades y a los oficiales si tienen la posibilidad de equiparse con objetos mágicos. El portaestandarte de batalla no está obligado a llevar un estandarte mágico siempre que esté equipado con su máximo de objetos mágicos permitidos. Un ejército de Caledor debe incluir al menos una Reliquia, dos en una Gran batalla o tres en una Batalla gigantesca.</description>
    </rule>
    <rule name="Golpe certero" id="566e-91a0-3d38-2154" hidden="false">
      <description>Los ataques de las miniaturas con esta regla especial que obtengan resultados de 6 para herir con Lanza no permiten tirada de salvación por armadura.</description>
    </rule>
    <rule name="Nobleza de Caledor" id="b6e5-f266-20b0-0afd" hidden="false">
      <description>El personaje obtiene las reglas especiales Inmune a psicología y Orgullo marcial.</description>
    </rule>
  </sharedRules>
