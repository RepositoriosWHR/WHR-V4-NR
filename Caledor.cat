          <infoLinks>
            <infoLink name="Inmune a rayos" id="a6bf-7584-06f8-493f" hidden="false" targetId="b0d1-ccdb-5379-f951" type="rule"/>
            <infoLink name="Arma de aliento" id="51a2-5ac0-d688-11bb" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(F3, Ataque de rayos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Zafiro de la tormenta" id="c261-18a3-3dda-60b8" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene la regla especial Inmune a rayos. Una vez por batalla el portador puede liberar la magia encerrada en la gema. Se trata como un Ataque de aliento con F3 y la regla especial Ataque de rayos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Corona de plata" id="122e-51c2-ba66-1bf9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7b9a-1ce3-5a81-9a49" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d924-5e96-209e-28a3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Aura de frio" id="d7d7-4cda-3372-fb71" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Corona de plata" id="3f95-e3cc-58b2-948c" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Proporciona al portador una tirada de salvación especial de 5+ y la regla especial Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de clarivirencia" id="628e-ead3-4a75-2909" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c462-6b27-0d11-56ba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="55e4-f454-2cb7-2705" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Esquivar (6+)" id="7ef5-08c5-4ac2-673c" hidden="false" targetId="c905-72a4-c706-6a16" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Amuleto de clarivirencia" id="ced5-bf0d-5f76-0b3f" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Puede repetir una tirada de dado una vez por batalla. Ha de ser una tirada concerniente al portador del amuleto: una tirada para impactar, herir, salvaciones, chequeo de atributo, dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas. Además, el amuleto otorga al portador la regla especial Esquivar (6+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de fuego purificador" id="6eaf-dccc-2fa5-24da" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d3e1-8b54-1c38-6533" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8fa5-9334-1f6b-ffc2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (2)" id="9a4c-e122-cca7-2ed7" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Amuleto de fuego purificador" id="7bde-7018-2dce-a243" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador la regla especial Resistencia mágica (2), que se verá aumentada a 3 contra hechizos del Saber del Fuego y el Saber de Tzeentch.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
