                            <infoLink name="Sangre fría" id="9863-edcc-89fb-5d7b" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                          </infoLinks>
                          <profiles>
                            <profile name="Estandarte de la serenidad" id="cbb5-889e-3fc0-d300" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
                              <characteristics>
                                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades enemigas en contacto con el portador o su unidad pierden las reglas especiales Furia asesina y/u Odio mientras continúen en contacto con ellos. El portador y su unidad obtienen la regla especial Sangre fría.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="Estandarte de la Reina Eterna" id="e4f7-4584-3298-99e8" collective="false" hidden="false" import="true" page="0" type="upgrade">
                          <constraints>
                            <constraint id="a25b-898a-7ff9-e495" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                            <constraint id="3b57-b78f-d936-def2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                          </constraints>
                          <costs>
