            <profile name="Estandarte de la estirpe de Draugnir" id="4d7a-9d62-882d-0fd6" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad unidad en la que se encuentre obtienen las reglas especiales Piel escamosa (6+), Ataques flamígeros, Inmune a rayos y Cruzar (Bosques).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte Real de Caledor" id="2b76-c9ef-8c18-8716" collective="false" hidden="false" import="true" type="upgrade">
