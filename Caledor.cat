          </entryLinks>
          <infoLinks>
            <infoLink name="Inmune a rayos" id="47c7-2b10-75bb-fc0a" hidden="false" targetId="b0d1-ccdb-5379-f951" type="rule"/>
            <infoLink name="Impactos múltiples (1D3)" id="7024-61c2-085d-733f" hidden="false" targetId="91a2-dd39-211c-fbdd" type="rule"/>
            <infoLink name="Ataques mágicos" id="0fee-0308-1b4f-5044" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Ataques de rayos" id="0aa7-0dd2-3f5b-4eab" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Martillo de rayos" id="e65a-b5b4-e280-f394" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Sacerdotes de Vaul. Otorga a su portador una tirada de salvación especial de 4+ contra proyectiles y la regla especial Inmune a rayos. En la fase de disparo, puede realizar un ataque a distancia con alcance 30”, impactará siempre con un resultado igual a la tirada de salvación por armadura del objetivo, se resolverá con F5 y las reglas especiales Impactos múltiples (1D3), Ataques de rayos y Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
