              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de dragón. Otorga a su portador una tirada de salvación por armadura de 1+ y la regla especial Regeneración (5+).</characteristic>
              </characteristics>
            </profile>
