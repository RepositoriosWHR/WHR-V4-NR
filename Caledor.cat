        <rule name="Magia Mago dragón" id="1064-1414-88b2-8900" hidden="false">
          <description>Nivel de magia 1. Puede aumentarse a nivel 2 por +30 puntos. Puede elegir hechizos del Saber del Fuego.</description>
        </rule>
        <rule name="Vínculo del dragón" id="c049-8fac-8831-8239" hidden="false">
          <description>Utiliza el valor más alto del atributo entre jinete y montura para realizar cualquier chequeo de atributo (incluido el de Iniciativa).</description>
        </rule>
      </rules>
