            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <modifiers>
            <modifier field="d1ae-660f-1a72-c5aa" type="set" value="2">
              <conditions>
                <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
            <modifier field="d1ae-660f-1a72-c5aa" type="set" value="3">
              <conditions>
                <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Adalid de la Casa" id="5594-672e-1731-ffbb" hidden="false" typeId="d5f3-8d72-7f36-e06c" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e7e8-8fe9-e257-d69b">Debes escoger una de las Casas Nobles de la siguiente lista; el personaje tiene que elegir como opción de montura un Corcel élfico con barda de Ithilmar o un Carro de guerra de Caledor. El personaje pertenecerá a esa Casa y obtendrá la habilidad indicada pero solo podrá unirse a unidades de Iniciados, Príncipes Dragoneros de Caledor o Igneonatos que pertenezcan a su misma casa, (o ir solo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Casas Nobles de Caledor" id="1631-c27a-8028-6c68" collective="false" hidden="false" import="true">
              <constraints>
                <constraint id="96cf-9157-04ed-1b18" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="27cf-c4f6-5234-f7ea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <selectionEntries>
                <selectionEntry name="Caledorian" id="6527-201d-9ddf-d77e" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="a36a-2333-f3e2-de80" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="Impasible" id="c385-13b4-eab1-a064" hidden="false" targetId="592b-c850-fd09-cce5" type="rule">
                      <modifiers>
                        <modifier field="name" type="append" value="(-1)"/>
                      </modifiers>
                    </infoLink>
                    <infoLink name="Ni un paso atrás" id="6cb9-a0e5-4527-a978" hidden="false" targetId="f76e-5a01-1c6b-ef76" type="rule">
                      <modifiers>
                        <modifier field="name" type="append" value="(8&quot;)"/>
                      </modifiers>
                    </infoLink>
                  </infoLinks>
                  <profiles>
                    <profile name="Caledorian" id="ad1f-f5db-d5a9-01f5" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">El personaje obtiene la Regla especial Impasible y tanto él como su unidad considerarán que han sufrido una herida menos al realizar sus chequeos de desmoralización. También obtiene la regla especial ¡Ni un paso atrás!, que afecta a todas las tropas amigas a 8” o menos de él. Además mientras se encuentre unido a una unidad de Igneonatos obtendrá la regla especial Ataques flamígeros.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Emberfell" id="1749-a534-9e3a-c3bc" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="44ce-3272-9f9e-554c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="Resistencia mágica (1)" id="d8b8-df31-626f-1dc3" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Emberfell" id="9a39-691d-64aa-711c" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">La salvación especial proporcionada por la Armadura de Dragón del personaje obtiene un bonificador de +1. La salvación especial proporcionada por las Armaduras de Dragón de la unidad a la que se encuentre unido pasa a tener un bonificador de +1 en lugar de un bonificador de +1 frente ataques no mágicos. El personaje obtiene la regla especial Resistencia mágica (1).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Goldcrest" id="f342-3559-1996-32e7" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="7dbe-d945-2b9a-45d7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Goldcrest" id="1f1d-839f-b11a-2eda" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">Si el personaje monta en un corcel élfico, los Impactos por carga (1) de la montura por la regla especial Caballería pesada aumentan en +1 impacto por carga y puede repetir los resultados de 1 al herir en sus impactos por carga. Si el personaje monta en un Carro de guerra de Caledor este obtiene +1 a sus impactos por carga. En ambos casos el personaje puede sumar +1 a las distancias de carga que efectúe y tanto el cómo su unidad puede repetir las tiradas fallidas para cargar.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Morvean" id="d839-3737-fdac-c5b3" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="e13e-8a30-ab31-94c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="Carga devastadora" id="867d-9627-9b2c-1f18" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
                    <infoLink name="Ataques flamígeros" id="74cf-c2fc-6017-226c" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Morvean" id="88ad-6b99-6e08-8b30" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">El personaje obtiene las reglas especiales Carga devastadora y Ataques flamígeros y puede repetir los resultados de 1 al herir en la ronda que realiza una carga.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
