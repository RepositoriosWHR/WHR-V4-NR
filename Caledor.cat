          <entryLinks>
            <entryLink name="Reliquia" id="0085-43dc-3f9c-d3cc" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Objeto legendario" id="b8f9-de30-168b-3266" hidden="false" targetId="1eb5-f5b5-0dbe-0f2e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del Dragón" id="b65d-d55e-29eb-49b4" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto Legendario. La unidad será completamente inmune a los efectos de cualquier Hechizo. El hechizo no será dispersado, simplemente la unidad no se verá afectada por él (esto afecta incluso a los efectos de Vórtice Mágico).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Tethlis" id="4fec-08c7-eef3-ece7" collective="false" hidden="false" import="true" type="upgrade">
