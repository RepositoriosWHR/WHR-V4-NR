          </costs>
          <profiles>
            <profile name="Cristal de los Annulii" id="2738-2998-1084-8461" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">En cada fase de magia enemiga puedes reducir en 1 sus dados 
de energía y aumentar en 1 tus dados de dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
