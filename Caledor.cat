              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Archimagos de Caledor. Un solo uso. El portador puede usarlo al inicio de la fase de magia enemiga. Aplica inmediatamente el resultado 9 (Drenaje de poder) de la tabla de disfunción mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
