              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador del estandarte y su unidad serán inmunes al efecto de la regla especial Poder de penetración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la serenidad" id="1217-4318-898b-b390" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="acf9-a2d0-49c0-dfd2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e705-0a91-bfcd-a7dd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Sangre fría" id="a540-45b3-eefd-cde1" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de la serenidad" id="7a26-3d24-b794-01ab" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades enemigas en contacto con el portador o su unidad pierden las reglas especiales Furia asesina y/u Odio mientras continúen en contacto con ellos. El portador y su unidad obtienen la regla especial Sangre fría.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Guardia del dragón" id="9643-c176-cf68-2c7d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4543-d826-3a73-9e02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="35dd-62b7-354a-1d99" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Guardia del dragón" id="242e-71b9-8dd5-e8d3" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Este estandarte funciona como un ataque a distancia que solo puede usarse para realizar reacciones a la carga de aguantar y disparar o disparar y huir. El ataque causa 1D6 impactos de F5 (distribuidos como proyectiles) con las reglas especiales ataques mágicos y ataques sólo flamígeros. Necesitas ver al enemigo que carga con el portador del estandarte para poder reaccionar a la carga de esta manera.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Senda del guerrero" id="1616-35cb-2f50-9dd5" collective="false" hidden="false" import="true">
