              <profiles>
                <profile name="Adalid de la Casa" id="067a-8297-2100-2a25" hidden="false" typeId="d5f3-8d72-7f36-e06c" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e7e8-8fe9-e257-d69b">Debes escoger una de las Casas Nobles de la siguiente lista; el personaje tiene que elegir como opción de montura un Corcel élfico con barda de Ithilmar o un Carro de guerra de Caledor. El personaje pertenecerá a esa Casa y obtendrá la habilidad indicada pero solo podrá unirse a unidades de Iniciados, Príncipes Dragoneros de Caledor o Igneonatos que pertenezcan a su misma casa, (o ir solo).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntryGroups>
                <selectionEntryGroup name="Casas Nobles de Caledor" id="dd9d-06e0-24b2-9831" collective="false" hidden="false" import="true">
                  <constraints>
                    <constraint id="35c5-9bf2-2140-b0bf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
