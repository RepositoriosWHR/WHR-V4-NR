          </infoLinks>
          <profiles>
            <profile name="Pabellón del Rey Fenix" id="c4d0-e499-4e09-a36a" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Las miniaturas de una unidad que incluya este estandarte podrán repetir las tiradas de salvación por armadura que fallen. Adicionalmente, obtendrán la regla especial Tozudez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Dragón" id="d080-948c-248c-2932" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
