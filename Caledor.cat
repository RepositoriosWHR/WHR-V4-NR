          </infoLinks>
          <profiles>
            <profile name="Corazón de dragón" id="1be4-4096-83bb-0a3e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo personajes montados en dragón (cualquier tipo). El dragón obtiene la regla especial Odio (¡todos los enemigos!). Además, una sola vez por batalla, al inicio de cualquiera de tus turnos, puede utilizarse para que el portador recupere una herida que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Esfera dracónica del conocimiento" id="6f57-4d59-5694-22a0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="baec-5005-10f9-17c9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ed8d-c34f-23a1-dfc2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Nivel 1" id="61f9-3fc7-f7d6-8037" collective="false" hidden="false" import="true" targetId="6930-ec9b-4df6-24c5" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Esfera dracónica del conocimiento" id="e43d-51c3-defe-c5c4" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo personajes montados en un algún tipo de dragón. La montura del portador obtiene nivel de magia 1 y la clave hechicero. Elige sus hechizos del Saber del Fuego (sólo Dragón Rojo, Dragón Solar, Dragón Lunar y Dragón Estelar), del Saber de los Cielos (sólo Dragón Celestial), Saber de la Muerte (sólo Dragón Negro), Saber de Hielo (sólo Dragón Blanco) o del Saber de la Vida (sólo Dragón Forestal).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Caledor" id="f229-ba4b-ad93-5c09" collective="false" hidden="false" import="true">
