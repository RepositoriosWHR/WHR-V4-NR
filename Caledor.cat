            <profile name="Cetro de la solided" id="527b-9928-2f68-bff9" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Puedes ignorar los efectos de la primera de las Disfunciones que sufra el portador durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello de Asuryan" id="d8de-3311-d29b-d978" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f435-7234-dc20-33f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1e82-8717-8dac-ff16" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
