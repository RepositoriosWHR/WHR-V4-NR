                          <modifiers>
                            <modifier field="name" type="append" value="(-1)"/>
                          </modifiers>
                        </infoLink>
                        <infoLink name="Ni un paso atrás" id="e1c7-1ddd-9e59-5480" hidden="false" targetId="f76e-5a01-1c6b-ef76" type="rule">
                          <modifiers>
                            <modifier field="name" type="append" value="(8&quot;)"/>
                          </modifiers>
                        </infoLink>
                      </infoLinks>
                      <profiles>
                        <profile name="Caledorian" id="dbff-9b04-e575-c039" hidden="false" typeId="e7f6-233d-a38d-775e" typeName="Casa Noble">
                          <characteristics>
                            <characteristic name="Reglas especiales" typeId="b085-7e2f-aab7-6ba0">El personaje obtiene la Regla especial Impasible y tanto él como su unidad considerarán que han sufrido una herida menos al realizar sus chequeos de desmoralización. Si se encuentra unido a una unidad de igneonatos estos gana Ataques flamígeros.También obtiene la regla especial ¡Ni un paso atrás!, que afecta a todas las tropas amigas a 8” o menos de él.</characteristic>
                          </characteristics>
                        </profile>
                      </profiles>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntryGroup>
              </selectionEntryGroups>
            </selectionEntry>
          </selectionEntries>
