    <selectionEntry name="Señor de los cielos" id="7022-d754-9538-8e6e" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="530e-ee09-5508-1d7e" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="6926-9ae5-fe0d-7f44" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Monstruo" id="350e-1632-d028-b57d" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Valor familiar" id="3d9f-0dd3-528f-fadd" hidden="false" targetId="2882-fac9-f267-b8e7" type="rule"/>
        <infoLink name="Orgullo ancestral" id="a35a-c270-37ef-2f0a" hidden="false" targetId="76e4-de12-8e30-50cb" type="rule"/>
        <infoLink name="Destreza marcial" id="b900-3c7c-7614-e5c4" hidden="false" targetId="819b-edec-3e97-1ca6" type="rule"/>
        <infoLink name="Opulencia desmesurada" id="1625-3a26-dc43-5ffe" hidden="false" targetId="09ba-21d0-b58b-8b12" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Magia Señor de los cielos" id="a87f-450b-e3d9-fdc8" hidden="false">
          <description>Nivel de magia 2. Puede aumentarse a nivel 3 por +50 puntos. Toma sus hechizos del Saber de los Cielos.</description>
        </rule>
        <rule name="Dominio celeste" id="dfb3-8b81-9901-0a0b" hidden="false">
          <description>El Señor de los Cielos conoce el hechizo Sendero Celeste, este hechizo es adicional a los que puede generar y se considera a todos los efectos un hechizo del Saber de los Cielos.</description>
        </rule>
        <rule name="Sendero Celeste (dificultad 10+)" id="a348-8742-1cf8-56f8" hidden="false">
          <description>Se trata de un hechizo de potenciación que toma como objetivo una unidad amiga a 12” o menos del lanzador. La unidad realiza inmediatamente un movimiento en línea recta hacia delante de 2D6” con la regla especial Volar. Si este movimiento lleva a la unidad a contacto peana con peana con una unidad enemiga, se considera que han cargado.</description>
        </rule>
      </rules>
