            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="5f0d-dd82-2e35-3535" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Gema del fuego solar" id="518c-df56-b02e-c01a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al inicio de cualquier fase de disparo o combate cuerpo a cuerpo. Hasta el final del turno de jugador en curso, el portador y su unidad obtienen la regla especial Ataques flamígeros y un bonificador de +1 en sus tiradas para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Caledor. Montado en dragón" id="0966-269a-b11a-3f2b" collective="false" hidden="false" import="true">
