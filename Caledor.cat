                            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                          </costs>
                          <profiles>
                            <profile name="Estandarte de la Reina Eterna" id="781e-c4ba-7e15-1644" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
                              <characteristics>
                                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto portahechizos de nivel de energía 3. Contiene el hechizo Escudo de Saphery del Saber de Alta magia. El hechizo solamente podrá lanzarse sobre la propia unidad y no potenciado.</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="Estandarte del león" id="d151-9c53-92eb-e341" collective="false" hidden="false" import="true" page="0" type="upgrade">
                          <constraints>
