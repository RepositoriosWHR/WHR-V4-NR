            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="b5ba-ea9c-da39-e6a2" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Arqueta de mercuriales" id="76a3-74d5-f26b-1c47" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo Infantería. Al inicio de cada turno (propio y del oponente), tira 1D3. Este será el número de marcadores que deberás colocar junto a la miniatura que lleva la arqueta. En cualquier momento puedes retirar un marcador para anular un impacto contra el portador (antes de tirar para herir). No se puede retirar marcadores para prevenir impactos generados por disfunciones.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismas mágicos. Caledor" id="13f9-db62-911a-077e" collective="false" hidden="false" import="true">
