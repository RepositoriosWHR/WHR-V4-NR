            <profile name="Lathrain, portadora de ira" id="d604-f132-4bcc-e363" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Filo de Caledor. Los impactos causados por esta arma tienen la regla especial Ataques flamígeros y Heridas múltiples (1D6). Los impactos causados por este arma contra miniaturas con Resistencia 5 o superior tendrán un bonificador de +2 a la Fuerza. Además, una vez por batalla, puede utilizarse como un Arma de aliento con Fuerza 4 y la regla especial Ataques sólo flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
