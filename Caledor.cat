              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y su unidad (de Potencia de unidad máxima de 20) obtienen la regla especial Flotar (8).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
