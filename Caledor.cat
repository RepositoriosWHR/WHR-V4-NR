              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Yelmo. Una vez por batalla el portador puede usar el poder del Yelmo para repetir una tirada para impactar, para herir, una tirada de salvación por armadura o especial o un chequeo de atributo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
