              <characteristics>
                <characteristic name="Reglas especiales" typeId="e7e8-8fe9-e257-d69b">El personaje está equipado con Viales de Fuego Alquímico y Capa de Dragón. Puede equiparse con una Gran vasija de 
fuego alquímico (+20 puntos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Viales de Fuego alquímico" id="9094-ad91-1314-5a56" collective="false" hidden="false" import="true" type="upgrade">
