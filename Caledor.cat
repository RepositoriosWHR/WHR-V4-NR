            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="1f9a-c251-9e48-263d" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Estandarte Real de Caledor" id="61f6-8c53-4e7d-ba32" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con Potencia de unidad 4 o inferior. Duplica la Potencia de unidad del portador de este estandarte y de la unidad que lo acompañe. Además, la unidad que porta este estandarte obtendrá un bonificador extraordinario de +1D6 al resultado de los combates en los que participe.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pabellón del Rey Fenix" id="0a32-64c7-6796-5f62" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="083a-ef38-83d1-8811" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="82e7-bd74-b63d-2131" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
