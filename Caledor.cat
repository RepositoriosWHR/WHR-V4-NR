                              <characteristics>
                                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen las reglas especiales Veloz e Inmune a Miedo (o Inmune a psicología en caso de que ya tuvieran la regla especial Inmune a Miedo).</characteristic>
                              </characteristics>
                            </profile>
                          </profiles>
                        </selectionEntry>
                        <selectionEntry name="Estandarte de Ellyrion" id="332b-22f4-dfdf-e7ef" collective="false" hidden="false" import="true" page="0" type="upgrade">
