                  </constraints>
                  <selectionEntries>
                    <selectionEntry name="Caledorian" id="f2e4-9e63-e38c-fc50" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="a547-760d-93cc-9850" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
