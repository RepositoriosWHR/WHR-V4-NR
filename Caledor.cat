                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e7e8-8fe9-e257-d69b">Sólo personajes montados en dragón (cualquier tipo). El dragón obtiene la regla especial Odio (¡todos los enemigos!).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
