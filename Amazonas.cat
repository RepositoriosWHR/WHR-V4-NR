  <rules>
    <rule name="Lucha en la selva" id="2131-cedb-1ffb-de98" hidden="false">
      <description>Cada vez que se utiliza la tabla de generación aleatoria de terreno, las Amazonas pueden sustituir cualquier resultado de dobles por un Bosque a menos que se especifique lo contrario en el escenario o que el escenario tenga una determinada escenografía fija.</description>
    </rule>
  </rules>
