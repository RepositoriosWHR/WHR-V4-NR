            <profile name="Hoja del viento" id="cbf6-9d8b-46dc-ecb7" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza Ancestral. Proporciona a su portadora 1D3 Ataques adicionales (tira al inicio de cada ronda de combate).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
