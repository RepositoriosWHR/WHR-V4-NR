              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Garrote. Los ataques realizados con este arma se resuelven con un bonificador de +1 en sus tiradas para impactar y para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
