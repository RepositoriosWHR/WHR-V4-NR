                <infoLink name="Catapulta" id="d101-97b7-f512-d796" hidden="false" targetId="7168-c1ae-bc9c-15df" type="rule"/>
                <infoLink name="Poder de penetración" id="e04f-131d-79d9-afa4" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Heridas múltiples (1D6)" id="5537-c1db-6f74-7984" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="+1) (Central)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Bombas divinas" id="a9d5-0bac-b226-7524" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">La máquina de guerra dispara como una catapulta tal y como se describe en el reglamento de Warhammer Reforged que realiza sus disparos con alcance de 18-96&quot;, los cuales se resuelven con Fuerza 5 utilizando la plantilla redonda grande y las regla especiale Poder de penetración. El impacto central se resuelve con Fuerza 10 y la regla especial Heridas múltiples (1D6+1).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
