      </constraints>
      <selectionEntries>
        <selectionEntry name="Ágape de reserva" id="349a-f41f-73c4-dcd2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="88e4-ab8d-5c99-0247" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1e4b-e562-f996-372f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ágape de reserva" id="a7bf-bdd5-d356-e750" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo Curandero Pigmeo con la regla especial Bendito de Beesbok. Proporciona a su portador un hechizo adicional y un bonificador de +1 en sus tiradas de lanzamiento de hechizos del Saber de la Vida. Además, le proporciona un bonificador de +1 en sus tiradas de Regeneración (hasta un máximo de 3+).</characteristic>
              </characteristics>
