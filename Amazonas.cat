        <infoLink name="Inmune al miedo" id="3265-dafd-e3a5-c783" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
        <infoLink name="Resistencia mágica (1)" id="8bd5-bb08-33b8-f3da" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="1fcf-7bc5-f4b9-ba51" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Ensamblaje" id="b6fa-c085-4309-2415" hidden="false">
          <description>El Catalizador de Ira Ancestral es una máquina de guerra cuyo funcionamiento dependerá del tipo de munición que haya elegido. Además, una vez desplegado no podrá moverse durante la batalla.</description>
        </rule>
        <rule name="Tecnología ancestral" id="70af-9396-1db3-e673" hidden="false">
          <description>Si al efectuar los disparos del Catalizador de Ira Ancestral obtienes un resultado de problemas en el dado de artillería, el disparo no se efectuará. En lugar de tirar en la tabla de problemas del cañón, la máquina de guerra no podrá volver a disparar hasta que obtenga un resultado de 4+ en una tirada de 1D6 al inicio de cada fase de disparo propia.</description>
        </rule>
      </rules>
