              <infoLinks>
                <infoLink name="Ataques de rayos" id="0266-80e4-b337-4af2" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
                <infoLink name="Pistola (Combate)" id="4337-67f6-3395-d46d" hidden="false" targetId="85e6-12f1-81f5-f299" type="profile"/>
