                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Obtiene un nivel de magia adicional y conocerá un hechizo adicional del saber del cual toma sus hechizos. Además, obtiene la regla especial ¡Ni un paso atrás!.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
