          <entryLinks>
            <entryLink name="Reliquia" id="8db0-7319-fb5d-79ee" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Placa sagrada de Rigg" id="bd80-1edc-16d8-c70f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo Gran Matriarca de Rigg. La portadora obtiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos del Saber de la Vida. Además, siempre que la portadora lance el hechizo Resurrección del Saber de la vida, puede potenciarlo para que restaure 2D6+1 heridas, en cuyo caso la dificultad aumenta a 19+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Atavío estelar" id="fe29-9e0d-031c-faf7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="431a-556f-3484-6d6b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="25b3-a0bd-0009-bfdf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="dae2-b438-3094-8e41" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Atavío estelar" id="c95b-1fb2-128b-5406" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia, el Atavío estelar genera un dado de magia que sólo puede ser utilizado por la portadora. Además, podrá tomar sus hechizos de entre uno de los ocho saberes básicos o Alta Magia, y conocerá un hechizo adicional del saber que haya elegido.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="f412-2926-ba1f-9fac" collective="false" hidden="false" import="true">
              <constraints>
                <constraint id="73d6-43ed-6324-b5d1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <entryLinks>
