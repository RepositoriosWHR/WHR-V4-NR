              <profiles>
                <profile name="Canalizador de la Ira Divina" id="9bbc-63a1-cdae-7f61" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Se trata de una Pistola cuyos disparos se resuelven con F6 y la regla especial Ataque de rayos. Además, le permite a Karra guardar un Dado de magia, el cual podrá liberar en la siguiente fase de magia. Si el canalizador tiene un dado guardado, sus disparos se resolverán con F8 y las reglas especiales Ataque de rayos y Heridas múltiples (2).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
