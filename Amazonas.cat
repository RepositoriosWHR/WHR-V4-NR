        <constraint id="9ecd-07c1-d556-249d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Fetiches de sanación" id="dd2b-c01f-6a47-3180" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ff52-21ba-5dd3-f433" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="28b0-e9df-5921-f24b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Fetiches de sanación" id="ab4f-f805-461b-26d6" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Curandero Pigmeo con la regla especial Bendito de Beesbok. Al comienzo de la batalla, tras el despliegue, designa un personaje de Infantería de tu lista de ejército a 24” o menos del curandero y que no sea el propio curandero. La miniatura elegida no será retirada del campo de batalla cuando su atributo de Heridas quede reducido a cero, sino que permanecerá en el campo de batalla con una única Herida y el poder de los fetiches se consumirá.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fetiches de posesión" id="baff-6ec5-a889-1ce7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5ebd-117e-309a-49b6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b962-6eeb-0f1f-ac55" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Fetiches de posesión" id="7658-27d2-bb9b-e12c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Curandero Pigmeo con la regla especial Consagrado de Brobat. Al comienzo de la batalla, tras el despliegue, designa un personaje enemigo en el campo de batalla. Al inicio de cada fase de magia propia, el curandero podrá realizar un impacto automático de su Fuerza básica sobre el fetiche fuera de la secuencia de turno, siendo la miniatura designada quien reciba la herida (tira para herir contra la Resistencia de la miniatura designada); estos impactos se resuelven con la regla especial Poder de penetración. Cualquier miniatura que sufra una herida a consecuencia de estos impactos obtendrá un penalizador de -1 a su HA hasta el final del turno. Si la miniatura elegida es retirada del campo de batalla por cualquier motivo el poder de los fetiches se agotará.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
