                  <modifiers>
                    <modifier field="name" type="append" value="(+1)(Dado de magia guardado)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Canalizador de la Ira Divina" id="c211-93c3-3168-5d51" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Se trata de una Pistola cuyos disparos se resuelven con F6 y la regla especial Ataque de rayos. Además, le permite a Karra guardar un Dado de magia, el cual podrá liberar en la siguiente fase de magia. Si el catalizador tiene un dado guardado no dispondrá de la regla Descarga, sus disparos se resolverán con F8 y las reglas especiales Ataque de rayos y Heridas múltiples (1D3+1).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
