              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede escoger sus hechizos del saber que conozca (sin determinarlos de forma aleatoria) siguiendo el resto de restricciones habituales.</characteristic>
              </characteristics>
