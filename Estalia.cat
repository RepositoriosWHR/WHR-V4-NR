    <selectionEntry name="Maestro esgrimista" id="84d8-5d65-1638-7017" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="b45e-b839-d219-0a35" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
