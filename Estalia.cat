              <selectionEntries>
                <selectionEntry name="6&quot; adicional Presencia Inspiradora" id="a41a-c58b-153a-cf83" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="4464-d6cb-598c-7a7f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <rules>
                    <rule name="6&quot; adicional Presencia Inspiradora" id="9d2a-3547-93df-aff4" hidden="false">
                      <description>6” de alcance adicional para la regla Presencia Inspiradora.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Tercio como Unidad Básica" id="ba83-9656-dc75-e42a" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="58dd-f8ae-e039-0518" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Tercio como Unidad Básica" id="cd47-891f-949b-1573" hidden="false">
                      <description>Incluir una unidad de Tercios como opción de Unidad Básica sustituyendo la obligatoria de piqueros. Esta unidad cuenta para desbloquear una unidad de jinetes (tal y como si se tratase de una unidad de piqueros). Además, ningún personaje con la regla Lealtad puede unirse a ella, y no puede obtener la regla Lealtad de ninguna forma.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
