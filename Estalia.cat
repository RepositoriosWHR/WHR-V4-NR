            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estatuilla del águila" id="6b12-3f66-b885-bd7c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos. Nivel de energía 3. Selecciona una unidad enemiga a 24” o menos del portador. El portador y su unidad ignorarán los penalizadores a impactar por cobertura a esa unidad hasta la siguiente fase de magia propia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cuerno del gran toro" id="22fa-fbd8-dc4d-2bf5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="25be-a04e-6015-d88d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cd32-202c-3700-b717" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cuerno del gran toro" id="dfa1-b80a-41b8-f6d3" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puedes declarar que vas a gastar el cuerno al principio del turno, antes de la declaración de cargas. Las unidades de Toros de Guerra a 12’’ o menos del lanzador moverán 1D6+2’’ hacia la unidad enemiga visible más cercana.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Anillo del rayo" id="dd49-5484-eca1-5fa5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6b7f-8508-beb2-ca31" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="71d5-315d-e04a-5ccc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques de rayos" id="9fa7-dc75-2edb-d67f" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Anillo del rayo" id="c00a-9dd5-f775-646d" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto Portahechizos. Nivel de energía 2. Se trata de un proyectil mágico con un alcance de 18”. Causa 1D6+1 impactos de F5 con la regla Ataque de rayos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Máscara del carnicero" id="7168-099b-aa31-d24a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="76cc-a9af-7878-61c1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a97d-62c9-ed86-b613" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
