              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador genera un dado de magia adicional en cada fase de magia que solamente podrá utilizar él.</characteristic>
              </characteristics>
            </profile>
