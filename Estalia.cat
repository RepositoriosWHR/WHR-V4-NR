            <entryLink name="Reliquia" id="f29a-9bd3-5972-d18b" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="La vara blanca" id="fa62-ff10-70be-50bf" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el mago lance un hechizo, puedes lanzar un dado adicional generado por la vara. Esto permite superar el límite de dados por nivel. Marca el dado de diferente color. Si obtienes una disfunción mágica y el dado marcado es uno de los que la causó, deberás tirar dos veces en la tabla de Disfunciones mágicas y aplicar ambos resultados, aunque el hechicero haya muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
