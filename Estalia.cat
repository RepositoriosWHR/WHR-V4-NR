              </infoLinks>
              <profiles>
                <profile name="Sacerdotisa del Águila" id="9699-805c-861f-dbf0" hidden="false" typeId="dc87-eeda-78cb-c4f7" typeName="Culto de Myrmidia">
                  <characteristics>
                    <characteristic name="Reglas Especiales" typeId="de5d-7054-4099-c1bc">Las Sacerdotisas guerreras y Sumas sacerdotisas obtienen un +1 a su atributo de Liderazgo y la regla Inmune a Psicología. Pueden escoger las armas libremente de entre las listadas en su entrada por el coste correspondiente.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sacerdotisa de Doncella oscura" id="4f06-0911-1424-4015" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6641-beba-5e7f-f25b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
