        <profile name="Caballeros del sudario de Morr" id="b0de-298d-4b89-e940" hidden="false" typeId="f56e-da6a-d244-d8f9" typeName="Orden de caballería">
          <characteristics>
            <characteristic name="Reglas especiales" typeId="ec05-88f3-ddfc-9513">Causan Miedo. El Senescal de la Orden causa Terror.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
