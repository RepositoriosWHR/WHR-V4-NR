                  <characteristics>
                    <characteristic name="Reglas Especiales" typeId="de5d-7054-4099-c1bc">Las Sacerdotisas guerreras y Sumas sacerdotisas obtienen un +1 a su atributo de Liderazgo y la regla Inmune a Psicología. Pueden escoger las armas libremente de entre las listadas en su entrada por el coste correspondiente.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sacerdotisa de Doncella oscura" id="d690-764b-ff1e-78e6" collective="false" hidden="false" import="true" type="upgrade">
