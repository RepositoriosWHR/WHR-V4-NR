    <selectionEntry name="Andanti" id="97e4-3116-a03a-4970" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="1937-9849-38b2-81f4" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
        <categoryLink name="New CategoryLink" id="343c-368a-bfcf-cdbd" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
      </categoryLinks>
      <costs>
