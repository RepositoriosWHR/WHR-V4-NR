              <profiles>
                <profile name="Corazón de la guerrera" id="63be-6067-eef8-ff2e" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portadora Resistencia Mágica (2). Cualquier ataque de proyectiles sobre la portadora y su unidad deberá aplicar un -1 a la tirada para impactar.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Libro sagrado" id="c523-f40a-aebb-40e4" collective="false" hidden="false" import="true" type="upgrade">
