        </infoLink>
        <infoLink name="Carga devastadora" id="6632-2273-8e2b-ef1f" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
        <infoLink name="Impactos por carga (2)" id="1bbf-12e4-3186-1f7e" hidden="false" targetId="9db2-68f9-b884-e961" type="rule"/>
        <infoLink name="Miedo" id="7d0a-753f-99ca-31f0" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Temibles" id="e36a-9cd0-114c-402b" hidden="false">
          <description>Cuando cargan, los Jinetes Taurinos tienen la regla Apabullar del mismo modo que un Carro.</description>
        </rule>
        <rule name="Tropas reales" id="4862-820b-565c-8204" hidden="false">
          <description>Solamente puedes incluir una unidad de Lanceros Taurinos Estalianos si el General del ejército tiene la regla Lealtad (X). La unidad obtendrá la misma regla Lealtad del General, pero con algunos efectos distintos: 
-Lealtad (Magritta): Los Jinetes Lanceros obtienen Poder de Penetración en combate.
-Lealtad (Bilbali): La unidad puede repetir las tiradas de carga fallidas.
-Lealtad (Zaragoz): La unidad es Impasible.
-Lealtad (Irrana): La unidad tiene la regla Cruzar (Terreno difícil y Muy difícil no acuático).</description>
        </rule>
      </rules>
      <selectionEntries>
