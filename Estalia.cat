              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Permite al portador repetir un dado de una tirada de dispersión una vez por fase de magia del enemigo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
