          <infoLinks>
            <infoLink name="Ataques mágicos" id="3b72-aa44-84af-0776" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Ataques flamígeros" id="320c-901a-3b02-a7bd" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Munición hechizada" id="2e0e-1be5-8b65-c43f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo si el personaje lleva Pistola, Ristra de Pistolas, Mosquete Estaliano y/o Arcabuz. El arma obtiene la regla Ataques Mágicos y Ataques Flamígeros, y puede repetir sus tiradas para herir. Esto se aplica en disparo y en combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Estalia" id="2ca8-4a1c-b86d-528e" collective="false" hidden="false" import="true">
