      <selectionEntries>
        <selectionEntry name="Estatuilla milagrosa" id="5dc3-5ae5-601f-dd42" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cdb0-b39a-78af-b32f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3ebe-46f6-4c04-f40a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
