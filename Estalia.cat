          </infoLinks>
          <profiles>
            <profile name="Pabellón de Myrmidia" id="0019-2a26-bf17-b20e" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador obtiene la regla Resistencia mágica (2) y Tozudez. La unidad en la que se incluya superará automáticamente cualquier chequeo de Reorganización, para no Perseguir o para no Arrasar que efectúe.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Imagen de la Doncella Oscura" id="23dc-f5e3-e392-6322" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b50b-daff-5a62-990a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a03e-4a56-518e-c9ac" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="bae0-5366-abe1-e61f" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Resistencia mágica (1)" id="439e-3f05-d46c-6710" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Imagen de la doncella oscura" id="5ba4-4040-abfd-a1e5" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador de este estandarte y la unidad que lo acompañe obtiene la regla especial Resistencia mágica (1). Además, podrá repetir las salvaciones por armaduras fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Estalia" id="98a5-9c32-d5cb-fa0d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="143d-4ecc-b619-606b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="b519-4d9f-6b6a-1263" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte de la Conquista" id="450d-49e4-721a-e088" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="14ac-2c87-3ffc-5653" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bc84-2dde-dadf-2b25" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la conquista" id="4a4c-19b6-e6ce-a8a3" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad equipada con este estandarte puede marchar siempre sin importar si hay enemigos cerca. Además, el enemigo no podrá declarar la reacción a la carga Aguantar y disparar contra esta unidad (ni tampoco Disparar y huir ya que se considera la misma reacción).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la guía" id="e645-2533-7add-4e92" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="97b8-d9fa-ae62-734b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1f49-a33c-48d3-0436" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la guía" id="bc79-8d05-0b8e-2b4a" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad no sufre penalizador por disparar a larga distancia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la Ciudad" id="82bf-3c8b-a0e1-f725" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c0c1-df1f-62c0-a028" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a86d-75d6-c7c2-9f7c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Impasible" id="aa6f-26b3-7326-9741" hidden="false" targetId="592b-c850-fd09-cce5" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de la ciudad" id="616d-56f8-ed95-9594" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad es Impasible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Emblema de Furia" id="f69b-6fd6-3929-14bc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="686c-eaba-61d4-40b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8b3c-64d2-7bd8-e1c5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="9064-f3ab-b38e-7477" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Emblema de furia" id="9cc2-d640-4f7b-c642" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad obtiene la regla Furia asesina, y no la perderá a causa de perder un combate. Por cada 6 que la unidad obtenga al realizar una tirada de salvación por armadura exitosa en combate, la unidad podrá efectuar un ataque adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Emblema de la Águila" id="8d53-5902-7663-e525" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="311b-0b94-1abd-e28c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6d9f-596b-3107-4db3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Emblema de la águila" id="7da7-deb8-5377-4858" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad puede efectuar un movimiento gratuito de reorganización al finalizar la fase de movimiento, siempre que no se encuentre trabado o huyendo. La unidad no podrá disparar en su siguiente fase de disparo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del tirador" id="24e8-982f-0bd5-7d92" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1d57-24e5-2dc7-dfa2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7dfd-d36b-0804-587c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte del tirador" id="ffa7-737b-5d6a-720a" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Puede utilizarse después de que la unidad haya disparado (eso incluye tras Aguantar y disparar). La unidad podrá diparar inmediatamente de nuevo con sus armas de proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
