      <rules>
        <rule name="Dominar el Azyr" id="2f3c-9801-dee4-1ac2" hidden="false">
          <description>Si el hechicero escoge el Saber de los Cielos tiene un bonificador de +2 a sus tiradas para Canalizar.</description>
        </rule>
        <rule name="Magia Gran mago" id="2521-9381-0e06-053b" hidden="false">
          <description>Nivel de magia 3, puede aumentarse a 4 por +55 puntos. Debe elegir sus hechizos de sólo uno de entre los siguientes saberes: Cielos, Luz, Fuego, Vida, Bestias o Sombras.</description>
        </rule>
      </rules>
