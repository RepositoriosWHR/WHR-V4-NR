        <infoLink name="Disciplina estaliana" id="f409-ba5a-810d-1c5b" hidden="false" targetId="5be7-34b2-d428-c003" type="rule"/>
        <infoLink name="Tácticas de apoyo" id="b75e-da64-5591-9561" hidden="false" targetId="4718-f99d-fff5-4469" type="rule"/>
