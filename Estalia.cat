        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="636f-64a7-1e43-300e" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Disciplina estaliana" id="763f-68e6-8ef3-bfa5" hidden="false" targetId="5be7-34b2-d428-c003" type="rule"/>
        <infoLink name="Esquivar (4+)" id="75ed-8ab2-09ad-0792" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink name="Orgullo marcial" id="b844-54c7-5623-6f81" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
        <infoLink name="Golpe letal" id="d516-7292-8efd-0a85" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Cuerpo a cuerpo)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Técnicas de duelo" id="9f61-290b-f69e-8c20" hidden="false">
          <description>Al inicio de cada ronda de combate, el Maestro debe seleccionar uno de los siguientes estilos de lucha. No puede repetir estilo de una ronda a la siguiente del mismo combate:
- Presto: El Maestro obtiene un bonificador de +3 a su Iniciativa durante esa ronda de combate.
- Certero: El Maestro puede repetir las tiradas para impactar fallidas durante esa ronda de combate.
- Imbatible: El Maestro puede repetir sus tiradas fallidas de Esquivar durante esa ronda de combate.
- Vivaz: El Maestro obtiene la regla Impactos múltiples (2) durante esa ronda de combate.</description>
        </rule>
        <rule name="Verdadera destreza" id="e445-7da4-b158-7658" hidden="false">
          <description>El Maestro esgrimista sólo puede equiparse con armaduras mágicas de tipo Armadura ligera.</description>
        </rule>
      </rules>
