            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="a4c9-c842-fc68-f187" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Máscara del carnicero" id="a1a1-3665-f23a-d395" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador causa Terror. El enemigo debe aplicar un -1 al impactarle en combate. Las miniaturas Inmunes a Psicología no se ven afectadas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Catalejo mágico" id="5245-811e-140a-ad75" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="83a4-5f3b-6de8-6e14" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5fdf-e1d2-d883-e3a1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Catalejo mágico" id="f70a-0fbc-ae22-16d0" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Ninguna miniatura enemiga con la regla Explorador o Vanguardia puede hacer uso de ella a menos de 18” del portador. Cualquier unidad enemiga que desee entrar en la batalla mediante la regla Refuerzos a 18” o menos del portador deberá repetir la tirada para determinar si llega ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Libro de la Leyenda Negra" id="1fac-f812-c900-1421" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="11eb-8502-ea54-0a1a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="31bc-9ca0-e6a5-152b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="9e84-8004-83b7-e4e2" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink name="Odio (todos los enemigos)" id="089f-8048-b70e-168d" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Libro de la Leyenda Negra" id="111e-21df-b89e-98fd" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al inicio de uno de tus turnos. Hasta el inicio de tu siguiente turno, todas las unidades amigas a 12” o menos del portador obtienen las reglas especiales Furia asesina y Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Estalia. Sólo con ballesta" id="fe00-a491-f287-aa19" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c414-d889-832b-67b3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
