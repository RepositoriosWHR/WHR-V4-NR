                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Sacerdotisa de Doncella oscura" id="0c22-0bea-f62b-92d4" hidden="false" typeId="dc87-eeda-78cb-c4f7" typeName="Culto de Myrmidia">
                  <characteristics>
                    <characteristic name="Reglas Especiales" typeId="de5d-7054-4099-c1bc">Las Sacerdotisas guerreras y Sumas sacerdotisas obtienen una Tirada de salvación especial de 5+, Armadura de Placas y sustituyen su Arma de mano por Arma a dos manos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sacerdotisa de Furia" id="1616-1c17-1e3c-d16d" collective="false" hidden="false" import="true" type="upgrade">
