    <selectionEntry name="[E] - Jahiro el Navajero y los afilados, bandoleros de Zaragoz" id="bdbf-dca9-979d-de6c" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="c9c2-6ff2-2994-8930" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
