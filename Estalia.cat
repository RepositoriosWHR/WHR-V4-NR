          <profiles>
            <profile name="Cubo de obsidiana" id="ad1b-f232-c857-7cc2" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene Resistencia Mágica (2). Adicionalmente, cuando un hechizo es dispersado exitosamente usando los dados adicionales obtenidos por este objeto, tira 1D6: con un 4+, finaliza la fase de magia y se vacían todas las reservas de dados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
