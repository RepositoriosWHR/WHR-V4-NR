            <profile name="Filo de Azyr" id="92ec-2d3a-6556-d742" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al atacar con este arma el portador obtiene un bonificador de +1 en sus tiradas para impactar impactar. Además, cada herida infligida con este arma en combate cuerpo a cuerpo causa a la unidad a la que se atacó con ella un impacto adicional de F5 con la regla especial Ataque de Rayos. Las bajas causadas de este modo contarán para la resolución del combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Estalia. Maestro esgrimista. Arma de mano" id="4d53-f53c-7191-c9f8" collective="false" hidden="false" import="true">
