                <cost name="pts" typeId="points" value="10"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Munición explosiva" id="4d6c-9b54-dd12-4445" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Realiza la tirada de estimación normal. En el punto final del impacto, coloca la plantilla redonda pequeña. Calcula los impactos normalmente. La miniatura debajo del centro de la plantilla recibe un impacto de Fuerza 6 con la regla Heridas múltiples (1D3) y Poder de penetración. El resto de miniaturas cubiertas por la plantilla reciben un impacto de Fuerza 3 con la regla Poder de Penetración. Este disparo no causa rebote. Si usando esta munición obtienes un resultado de Problemas, resta 1 al resultado de la Tabla de problemas del Cañón.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Cañón móvil de montaña (munición explosiva)" id="7a48-818b-05e0-afed" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">Estimar 0-6</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3 (6)</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Plantilla redonda pequeña, Poder de Penetración, (el agujero central tiene las reglas especiales Heridas múltiples (1D3) y Poder de penetración)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
