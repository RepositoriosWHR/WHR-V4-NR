              <profiles>
                <profile name="Sacerdotisa de Doncella oscura" id="4667-8e6d-2566-a334" hidden="false" typeId="dc87-eeda-78cb-c4f7" typeName="Culto de Myrmidia">
                  <characteristics>
                    <characteristic name="Reglas Especiales" typeId="de5d-7054-4099-c1bc">Las Sacerdotisas guerreras y Sumas sacerdotisas obtienen una Tirada de salvación especial de 5+, Armadura de Placas y sustituyen su Arma de mano por Arma a dos manos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sacerdotisa de Furia" id="1959-de36-0c41-44fa" collective="false" hidden="false" import="true" type="upgrade">
