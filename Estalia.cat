              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El amuleto proporciona Resistencia Mágica (1). Contra hechizos de los saberes del viento de Magia Oscura proporciona en su lugar Resistencia Mágica (3).</characteristic>
              </characteristics>
