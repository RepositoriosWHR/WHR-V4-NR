    <selectionEntry name="[Ex] - La Tarasca" id="9e8c-f988-20eb-27c8" collective="false" hidden="false" import="true" type="upgrade">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="4a9d-4d5e-a028-fcff" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
        <constraint id="90a6-47a0-72ab-d9b4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Monstruosamente grande" id="61e7-ed22-a574-17ed" hidden="false" targetId="38d4-1707-be50-7d0f" type="rule"/>
        <infoLink name="Monstruo" id="3a8d-268c-72ee-ead3" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Unidad legendaria" id="c8a1-588b-045b-7854" hidden="false" targetId="729e-2ed5-79eb-8288" type="rule"/>
        <infoLink name="Golpe letal" id="6b55-fddb-d6fa-8627" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
        <infoLink name="Piel escamosa (1+)" id="fa73-a112-4749-ad65" hidden="false" targetId="5e2e-d24c-0c35-66d9" type="rule"/>
        <infoLink name="Golpe letal heróico" id="7453-7b48-75f8-bc3c" hidden="false" targetId="95ce-f21a-29e1-42a2" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Impactos por carga)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Resistencia mágica (3)" id="f032-fea8-0817-e918" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
        <infoLink name="Regeneración (5+)" id="0aac-1951-b7a5-34f6" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="90a6-47a0-72ab-d9b4" type="increment" value="1">
          <conditions>
            <condition childId="31a8-efd1-5746-654b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="046a-1c36-705e-1c0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Embestida poderosa" id="9848-704e-cc06-48ec" hidden="false">
          <description>Para determinar los Impactos por carga de la Tarasca, tira 2D6 y elige el resultado mayor. Sus impactos por carga se resuelven con la regla especial Golpe letal heroico.</description>
        </rule>
        <rule name="Impermeable a la magia" id="543c-137b-ddbf-d673" hidden="false">
          <description>La Tarasca tiene la regla especial Resistencia mágica (3). En una excepción a las reglas habituales, esta regla especial puede ser utilizada también por el oponente si la Tarasca recibe un hechizo de Potenciación. Además, cualquier hechicero (amigo o enemigo) que tome como objetivo a la Tarasca con uno de sus hechizos debe obtener un resultado igual o inferior a su nivel de magia en una tirada de 1D6 o sufrirá una herida sin tirada de salvación por armadura (esto se realiza antes de la tirada de lanzamiento del hechizo).</description>
        </rule>
        <rule name="Metabolismo monstruoso" id="3e06-05c2-c8c5-bac2" hidden="false">
          <description>La Tarasca tiene la regla especial Regeneración (5+). Además, al inicio de cada uno de tus turnos, la Tarasca recupera una herida que hubiese sufrido con anterioridad durante la batalla.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="La Tarasca" id="575c-d362-bfa0-2fb1" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="073a-8ddf-fd87-a787" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
            <constraint id="9e9d-f430-7f54-7f1d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="450"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="La Tarasca" id="e80d-ba47-ab64-d196" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
