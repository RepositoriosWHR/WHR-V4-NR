              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y su unidad obtienen la regla Cruzar (bosques y elementos acuáticos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estatuilla del águila" id="047a-429e-2237-4ad0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="374b-694a-41d9-3957" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c2cb-6413-cf96-dc0f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
