              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga la regla Orgullo Marcial. El portador es Inmune a Miedo, y otorga la regla ¡Ni un paso atrás! a 8” de él.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
