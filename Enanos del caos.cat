        <infoLink name="Odio (todos los enemigos)" id="975e-5d4f-5cc8-0743" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
        <infoLink name="Ingeniero infernal" id="f838-a2ac-5aeb-59ba" hidden="false" targetId="6ab8-b711-c75d-c444" type="rule"/>
