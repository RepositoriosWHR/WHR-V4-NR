        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Ghorth el cruel" id="2aae-4051-d10c-752d" hidden="false">
          <description>Ghorth es un hechicero de nivel 4 que conoce todos los hechizos del Saber de Hashut.</description>
        </rule>
        <rule name="Señor del conocimiento (Saber de Hashut)" id="3c4f-26e7-eef4-b65e" hidden="false"/>
        <rule name="El cruel" id="c67d-f21b-b7dc-b934" hidden="false">
          <description>Ghorth y cualquier unidad a la que se una obtienen la regla especial Odio (¡todos los enemigos!). Si Ghorth y su unidad se ven afectados por el hechizo Aliento de odio, podrán repetir todas sus tiradas fallidas para impactar en combate cuerpo a cuerpo.</description>
        </rule>
        <rule name="Reservorio de poder" id="b869-250a-1c9e-fb9c" hidden="false">
          <description>Una vez por batalla, durante una de tus fases de magia, puedes hacer que Ghorth acuda a su reservorio de poder: para ello, debes
realizar un chequeo de Liderazgo con Gorth. Si lo fallas, no ocurre nada y Ghorth sufre una herida automática sin tirada de salvación de ningún tipo. Sin embargo, si lo superas, Ghorth genera inmediatamente 1D3 dados de Energía para utilizar durante esa fase de magia: esos dados adicionales sólo podrán ser utilizados por Ghorth.</description>
        </rule>
        <rule name="Claves : ENANOS DEL CAOS, Enanos, Enanos del Caos, Caos,Hechicero." id="4467-55dd-f03e-c41e" hidden="false"/>
      </rules>
      <selectionEntries>
        <selectionEntry name="General del ejército" id="892b-8e65-2994-25c4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e05d-8fd4-98b6-d168" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
