      <rules>
        <rule name="Magia Drazhoath el ceniciento" id="94a4-8e35-c4b1-e649" hidden="false">
          <description>Drazhoath es un hechicero de nivel 4 que puede elegir sus hechizos del Saber de Hashut.</description>
        </rule>
        <rule name="Alimentado con fuego" id="9b08-6e15-f045-6312" hidden="false">
          <description>Siempre que un hechizo del Saber del Fuego se resuelva de manera exitosa sobre Drazhoath, podrá restablecer una herida que haya sufrido previamente durante la batalla.</description>
        </rule>
        <rule name="Renombre oscuro" id="bfca-6be6-3c96-658f" hidden="false">
          <description>Todas las unidades con la regla especial Desprecio a 12” o menos de Drazhoath suman +1 al resultado del combate.</description>
        </rule>
        <rule name="Claves : ENANOS DEL CAOS, Enanos, Enanos del Caos, Caos,Hechicero." id="1f4e-2c52-1fd5-359b" hidden="false"/>
      </rules>
