            <profile name="Manto de piedra" id="12f0-9714-8721-c6f8" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniatuas con la regla especial Desprecio. Incrementa la Resistencia del portador en +1, pero reduce a 1 su Iniciativa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Emblema desafiante" id="1745-b812-4b76-596a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b6f0-60e6-87eb-5832" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="bc81-1e87-1bbc-c2e7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Orgullo marcial" id="53d3-9920-8032-2c70" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Emblema desafiante" id="9dc8-1ffd-99ca-6703" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con Desprecio. El portador obtiene la regla especial Orgullo marcial. Todas las tiradas exitosas paraimpactar contra el portador deberán repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Diamante negro" id="52a1-5ad4-0aa8-06b9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d129-c697-b35f-1518" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="25c1-b8a9-1bfa-70dc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="eee7-0d72-1d9d-47b0" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Miedo" id="c514-9607-359d-595c" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
            <infoLink name="Aura demoníaca (5+)" id="1ec9-5f13-92cc-da41" hidden="false" targetId="e5ed-5149-3d72-6aa4" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Diamante negro" id="8947-e8c2-1cb1-8116" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con Desprecio. Otorga al portador la reglas especiales Aura demoníaca (5+) e Inmune a psicología y causará Miedo. Sin embargo, se verá afectado por los hechizos y habilidades que afecten a Demonios o que lo hagan de forma aumentada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello sagrado del horno" id="61b2-895b-4769-d8bc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1a1c-c97b-5968-b6cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7cd7-ae5f-3b9a-bcbd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
