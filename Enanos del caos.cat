              <infoLinks>
                <infoLink name="Alabarda" id="2c05-e66d-879a-f9e7" hidden="false" targetId="8dd0-8d9d-2436-cbf1" type="profile"/>
                <infoLink name="Golpe letal" id="4eec-e251-4e88-1761" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
                <infoLink name="Ataques flamígeros" id="c6cd-03dc-6c3b-af8e" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
