            <profile name="La máscara del horno" id="287b-04dc-daad-ed79" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Yelmo (proporciona un +1 adicional a la tirada de salvación por armadura del portador). Sólo miniaturas con la regla especial Desprecio. El portador causará Miedo y obtendrá una tirada de salvación especial de 5+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gran yelmo de Zharr-Naggrund" id="638b-3d8f-07c2-1099" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ff90-27a8-4422-ba65" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a560-a5e4-1d1e-0396" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gran yelmo de Zharr-Naggrund" id="2712-708e-fd35-cdfb" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Sólo miniaturas con Desprecio. Yelmo. El portador verá su atributo de Liderazgo incrementado en un punto. Sin embargo, fallará las tiradas de “¡Cuidado, señor!” con un resultado de 1-3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escudo sagrado de Hashut" id="a016-6d72-11ac-7823" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fcfa-3ea3-0866-f96b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9343-53c7-788a-9500" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
