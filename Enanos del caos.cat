              <profiles>
                <profile name="Filo de Hashut" id="285b-ebe0-7281-e177" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Alabarda. Ghorth puede repetir todas sus tiradas fallidas para herir al atacar con este arma; además, sus impactos se resuelven con las reglas especiales Golpe letal y Ataques flamígeros. Por último, proporciona a Ghorth un bonificador de +2 a todas sus tiradas para Canalizar.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
