            <profile name="Runa del dolor" id="880b-09bb-8632-8a24" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con Desprecio. Al inicio de cada fase de combate, las miniaturas enemigas en contacto peana con peana con el portador deberán superar un chequeo de Liderazgo o sufrirán una herida sin posibilidad de tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
