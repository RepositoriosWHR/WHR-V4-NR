      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="b346-2cd1-b854-a3da" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Avance imparable" id="88a8-d58d-37a3-7fc1" hidden="false" targetId="a396-1f2c-9829-f368" type="rule"/>
        <infoLink name="Desprecio" id="353a-9872-4554-0932" hidden="false" targetId="60f2-832e-5017-9414" type="rule"/>
        <infoLink name="Inmune a la psicología" id="c079-3bca-1175-039b" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Ingeniero infernal" id="997a-635e-f187-ce4d" hidden="false" targetId="6ab8-b711-c75d-c444" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="La Maldición del Brujo" id="d17e-0754-3f33-0147" hidden="false">
          <description>El personaje obtiene la regla especial Piel escamosa (6+). Cada vez que un Brujo-sacerdote o un Herrero demoníaco sufra una Disfunción mágica, después de resolver los efectos de esta deberá realizar un chequeo de Resistencia. Si lo falla sufrirá una herida que no podrá evitar con tiradas de salvación de ningún tipo (ni siquiera especiales). Sin embargo, la primera vez que sufra una herida de esta manera obtendrá permanentemente +1 a su Resistencia, ya que su cuerpo se habrá vuelto parcialmente de piedra. Posteriores heridas no volverán a incrementar el atributo de Resistencia del brujo.</description>
        </rule>
        <rule name="Magia Herrero demoníaco" id="c0bb-0917-e059-b513" hidden="false">
          <description>Nivel de magia 1, puede aumentarse a nivel 2 por +35 puntos. Puede elegir sus hechizos de entre los saberes de Hashut, el Metal, el Fuego y la Muerte.</description>
        </rule>
        <rule name="Claves : ENANOS DEL CAOS, Enanos, Enanos del Caos, Caos,Hechicero." id="f8eb-9081-93b7-2fd9" hidden="false"/>
      </rules>
