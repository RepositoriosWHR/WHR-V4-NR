              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia, tras determinar los vientos de la magia y las tiradas de Canalización, el portador puede, reducir en 1D3 la reserva de dados de energía/dispersión de ambos jugadores.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
