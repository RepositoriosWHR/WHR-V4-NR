      <rules>
        <rule name="Miasma mágico" id="2dfa-8b17-238d-c891" hidden="false">
          <description>Las armas mágicas que porten las miniaturas en contacto peana con peana con un Lammasu se considerarán armas mundanas de su mismo tipo mientras se  encuentren en contacto peana con peana con el Lammasu. Esto no afecta a su jinete.</description>
        </rule>
        <rule name="Magia lammasu" id="5dc9-d0ed-3d93-4ee0" hidden="false">
          <description>Los Lammasu son hechiceros de nivel 1 que pueden aumentar su nivel hasta 2 (+35 puntos). Un Lammasu puede generar sus hechizos de entre el Saber del Fuego, el Saber de la Muerte o el Saber de las Sombras.</description>
        </rule>
        <rule name="Hechicero" id="1ab1-8a1e-8163-1775" hidden="false">
          <description>Los Lammasu son hechiceros de nivel 1 que pueden aumentar su nivel de magia hasta 2 (+35 puntos). Un Lammasu puede generar sus hechizos de entre el Saber del Fuego, el Saber de la Muerte o el Saber de las Sombras.</description>
        </rule>
      </rules>
