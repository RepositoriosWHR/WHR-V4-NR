          <profiles>
            <profile name="Sello sagrado del horno" id="efc2-48c0-189c-852a" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con Desprecio. El portador obtiene la regla especial Inmune a fuego. Los Ataques flamígeros contra el portador deberán reducir a la mitad su valor de Fuerza (redondeando hacia arriba). Además, proporciona a su portador una tirada de salvación especial de 5+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa del dolor" id="d8ad-bcea-df90-45f2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
