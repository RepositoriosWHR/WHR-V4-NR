      </constraints>
      <selectionEntries>
        <selectionEntry name="Ojo de Hashut" id="f4fd-50e6-c3fe-959d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6efa-6b4f-d223-4cba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="97ae-6ae7-6c8c-8cb8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques solo flamígeros" id="3a17-58e6-48ad-611f" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Ojo de Hashut" id="73e0-2f01-e9d6-1281" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. Objeto portahechizos de nivel de energía 3. Contiene un hechizo de Daño directo con un alcance de 18”. Coloca la plantilla redonda pequeña dentro del alcance. Cualquier miniatura bajo de la plantilla sufrirá un impacto de Fuerza 4 con la regla especial Ataques sólo flamígeros. Cualquier unidad que sufra al menos una baja a causa de este hechizo deberá realizar un chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Guanteletes de Zharr" id="e4c3-c7c3-3ae1-7b7e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c31c-dbe8-ae60-453e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3e6a-70b4-eb3f-a7d3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Guanteletes de Zharr" id="9ce2-1d4b-09e0-a69c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. Aumenta en +1 el atributo de Fuerza del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cuerno de tauro" id="6ac9-e2d4-85a5-6909" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9a5e-2245-3dca-863f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1b67-dfab-a992-776c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio (todos los enemigos)" id="5823-ca7b-16a8-29b3" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Cuerno de tauro" id="2832-cbb9-1c97-8652" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. Objeto portahechizos de nivel de energía 1D6. Un sólo uso. Las unidades del ejército situadas a 24” o menos con la regla especial Desprecio obtendrán la regla especial Odio (¡todos los enemigos!) hasta el final del turno de jugador. Las miniaturas del ejercito a 24” o menos sin la regla especial Desprecio se reagruparán automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Frasco demoníaco de Ashack" id="9366-1acc-4d7f-f1b0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8e67-731c-b98e-8e87" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d653-17c6-90fa-5846" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Frasco demoníaco de Ashack" id="5d32-9554-389d-d295" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. Un sólo uso. Puede utilizarse al inicio de cualquiera de las fases de movimiento del portador antes de declarar las cargas. Todas las unidades enemigas a 18” o menos del portador deberán realizar inmediatamente un chequeo de Pánico. Los Edificios, Carros y Máquinas de guerra (tanto amigas como enemigas) dentro del alcance sufrirán 1D6 heridas automáticas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Manto del toro condenado" id="b58d-4639-1250-769d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8550-5af2-999c-1e42" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="490a-469d-c445-13b3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Piel escamosa (6+)" id="9c74-3cde-d499-8f46" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
            <infoLink name="Impactos por carga (1)" id="8a3a-d2ae-a012-0dfa" hidden="false" targetId="8de0-8a91-edee-076e" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Manto del toro condenado" id="9f27-7f9c-4c50-4deb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. Otorga a su portador las reglas especiales Impactos por carga (1) o +1 si ya disponía de dicha regla y Piel escamosa (6+) o +1 si ya disponía de dicha regla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Guanteletes de Bhazrak el cruel" id="3c2a-0111-bf8e-2316" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c05f-9995-31e0-e11b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="28e4-816b-901e-298d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
