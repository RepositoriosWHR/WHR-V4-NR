          <profiles>
            <profile name="Elegido de Hashut" id="129c-9abd-a05e-02e6" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El personaje obtiene las reglas especiales Orgullo marcial, Furia asesina y Odio (¡todos los enemigos!) y no perderá su Furia asesina tras ser derrotado en combate. Además, podrá repetir todas sus tiradas fallidas para impactar en combate cuerpo a cuerpo mientras esté combatiendo en un Desafío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
