            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Guanteletes de Bhazrak el cruel" id="5bda-d00b-7beb-4a58" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. El portador obtiene un bonificador de +1 en su tirada para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Orbe del marchitamiento" id="216f-d1a3-526a-6430" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4166-b361-97d9-0e76" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cfc7-02c9-6c61-9edb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Orbe del marchitamiento" id="4495-a314-e191-9cef" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. Las unidades a 12” o menos del portador de este orbe no podrán realizar tiradas de Regeneración. Los hechizos del Saber de la Vida dentro del radio verán su dificultad de lanzamiento incrementada en un punto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colgante de Gorgoth" id="4300-4a9f-1146-967d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9c8b-8e42-3ee6-f225" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="84c2-8e19-f39d-3b83" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Colgante de Gorgoth" id="bbad-4e95-d77d-dadc" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con Desprecio. El portador aumentará su atributo de Fuerza en +1 por cada herida que sufra durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
