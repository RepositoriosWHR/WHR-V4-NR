    <selectionEntry name="[E] - Gorduz el traizionero, caudillo hobgoblin" id="b67f-dc13-9aab-d008" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="a7c0-3c60-7bc6-296c" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
