        </rule>
        <rule name="Claves : ENANOS DEL CAOS, Enanos,Centauros, Enanos del Caos, Caos." id="518c-13eb-bced-35c4" hidden="false"/>
        <rule name="Servidores de Hashut" id="0060-2820-fda6-634d" hidden="false">
          <description>Los Centauros despedazadores solamente podrán beneficiarse de la regla especial Presencia inspiradora del general del ejército si se trata de un Comandante con las claves enano del Caos y hechicero.</description>
        </rule>
      </rules>
