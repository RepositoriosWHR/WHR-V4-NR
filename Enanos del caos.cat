          <profiles>
            <profile name="Familiar del caos" id="2b82-4b2c-35a4-e745" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede repetir una tirada una vez por turno de juego. Puede ser una tirada para impactar, herir, salvaciones, chequeos de característica o dados de Energía o Dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro de Hashut" id="e721-06fa-e9f7-3252" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c1f2-449f-68b2-4475" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ce24-419d-79de-2ecf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro de Hashut" id="5835-f55e-6549-0b87" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El hechicero conoce un hechizo adicional y puede guardar un dado de Energía o Dispersión para utilizarlo en la siguiente fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro incandescente" id="d24c-1c39-9bf6-7754" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d9e0-4df3-efd4-8328" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a2d7-b90c-6d24-f8b0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro incandescente" id="2f5e-f725-ad02-feae" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Todos los hechizos de los Saberes del Fuego, Metal, Tzeentch o Hashut lanzados por hechiceros (aliados o enemigos) situados a 18” o menos del lanzador podrán añadir +1 al total obtenido en la tirada de lanzamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Icono del gran tauro" id="4e8f-5193-04ec-e2bb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3ef8-3367-806c-1fe2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0900-9c7e-7c37-406d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Icono del gran tauro" id="6fcb-8b49-13ba-e539" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El hechicero suma +1 a sus intentos de dispersión de hechizos. Adicionalmente, una vez por batalla podrá dispersar automáticamente un hechizo enemigo cuando sea lanzado; no puede dispersar hechizos lanzados con Fuerza irresistibl</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Orbe de magma infernal" id="2241-3036-1982-6153" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="63c7-b1c4-49a4-7ce9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5238-68bc-b0c9-b7cb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Orbe de magma infernal" id="138b-d563-0673-1add" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El hechicero obtiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos del Saber de Hashut. Además, se trata de un objeto portahechizos de nivel de energía 3. Contiene un hechizo de Potenciación que toma como objetivo al propio hechicero. Retira la miniatura del campo de batalla y vuelve a colocarla en cualquier punto a 24” o menos de su posición original (no puedes recolocar la miniatura a menos de 1” de una miniatura enemiga o Edificio).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Enanos del caos" id="914e-e886-df20-7742" collective="false" hidden="false" import="true">
