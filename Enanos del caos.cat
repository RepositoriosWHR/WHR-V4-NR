              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades con la regla especial Animosidad hobgoblin a 12” o menos de este estandarte obtienen la regla especial Inmune a psicología</characteristic>
