                <infoLink name="Heridas múltiples (1D6)" id="8a87-87b8-82ab-46ff" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Cañón ligero" id="f78e-f6ee-ac52-0528" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Dispara como un Cañón que puede estimar hasta 6 dados. Sus impactos se resuelven con F8 y la regla especial Heridas múltiples (1D6).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
