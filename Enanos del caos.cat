          <infoLinks>
            <infoLink name="Armadura Negra" id="803e-c434-1d87-546f" hidden="false" targetId="aa51-ac39-bd8c-beed" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Coraza del tauro" id="34b9-988f-d673-41d1" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura Negra. Sólo miniaturas con la regla especial Desprecio. Los impactos no mágicos dirigidos contra el portador deberán aplicar un penalizador de -1 a su tirada para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Coraza de la embestida" id="de00-f0c7-15ff-e6a6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0859-ba64-c9cc-7bec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dc13-7fee-2071-2611" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura Negra" id="1f16-1368-7594-b550" hidden="false" targetId="aa51-ac39-bd8c-beed" type="profile"/>
            <infoLink name="Impactos por carga (1)" id="fd60-a0b3-866e-58b2" hidden="false" targetId="8de0-8a91-edee-076e" type="rule"/>
            <infoLink name="Resistencia a la magia (1)" id="b1ce-eb00-cac3-be04" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Coraza de la embestida" id="de4c-899d-50d4-7762" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura Negra. Sólo miniaturas con la regla especial Desprecio. Otorga a su portador la regla especial Resistencia mágica (1). Adicionalmente, otorga al portador la regla especial Impactos por carga (1), o aumenta en +1 los Impactos por carga si ya contaba con la regla especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura de la repesalia" id="251f-44d4-dd26-d345" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9499-a764-4781-5fb4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c751-84cc-b9a7-94da" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura Negra" id="aeda-585e-3100-6e2e" hidden="false" targetId="aa51-ac39-bd8c-beed" type="profile"/>
            <infoLink name="Inmune al veneno" id="679a-ba1a-2d92-eefe" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura de la repesalia" id="029f-4421-a2e8-255e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Sólo miniaturas con Desprecio. Armadura negra. El personaje obtiene la regla especial Inmune a veneno y es inmune a las reglas especiales Golpe letal y Golpe letal heroico. Los ataques envenenados y los golpes letales (y heroicos) contra el portador en combate cuerpo a cuerpo deberán resolverse contra la miniatura atacante (es decir, cada vez que el enemigo obtenga un 6 para impactar con Ataques envenenados o un 6 para herir con Golpe letal o Golpe letal heroico, se considerará que se habrá impactado/herido a sí mismo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura de Gazrakh" id="dfca-38e4-3c39-d05e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5dc0-463d-6d8d-573a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c970-ecc2-cb10-4713" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
