          </costs>
          <profiles>
            <profile name="Kráneo de troll" id="2d19-ee7b-a1d9-a08f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene la regla especial Presencia inspiradora, que afecta a todas las unidades de trolls a 12” o menos de él.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Zako de ezporaz venenozaz" id="07fc-7fad-d829-35ec" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="48c7-888b-e7b8-2ca3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e92c-0f92-5760-dce2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
