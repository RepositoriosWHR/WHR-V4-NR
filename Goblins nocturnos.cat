              <infoLinks>
                <infoLink name="Arma de mano" id="15e8-1cf0-10a7-23f1" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Thagi Az" id="f459-e42a-7500-cca7" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Por cada impacto que cause el Goblin Negro con Thagi Az, tira 1D6. Con cada resultado de 4+, uno de los objetos mágicos del oponente (seleccionado aleatoriamente) pierde su poder y pasa a considerarse un objeto mundano del mismo tipo. Además, esta fantástica hacha proporciona +1 Ataque y +1 a la Fuerza de su portador.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura de gromril" id="34dc-6932-d776-af6c" collective="false" hidden="false" import="true" type="upgrade">
