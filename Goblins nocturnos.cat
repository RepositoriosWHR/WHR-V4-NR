              <profiles>
                <profile name="Armadura de laz barbaz" id="bfc0-2055-8315-54db" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Proporciona a Skarsnik una tirada de salvación por armadura de 3+ (en lugar del habitual 5+ por ser armadura pesada, con lo que totaliza una tirada de salvación por armadura de 1+), una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (1).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
