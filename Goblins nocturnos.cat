            <infoLink name="Movimiento aleatorio (3D6)" id="935e-93f3-b535-7495" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
            <infoLink name="Ataque rápido" id="4cab-0725-9a06-3ee9" hidden="false" targetId="0107-ab2b-9c74-dade" type="rule">
              <modifiers>
