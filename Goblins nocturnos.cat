            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Eztandarte de Borko" id="2cc0-88ae-eb54-3a42" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Si la unidad falla un chequeo de animosidad, podrá activarse el estandarte para superar automáticamente el chequeo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Eztandarte de piel de garrapto" id="645e-8e75-de64-52de" collective="false" hidden="false" import="true" type="upgrade">
