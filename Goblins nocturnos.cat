    <selectionEntry name="Garrapato escupidor" id="c024-1a51-5d11-b1e5" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="1ed4-e6a3-20d9-059e" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
