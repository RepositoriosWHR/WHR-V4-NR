          <infoLinks>
            <infoLink name="Tozudez" id="ae7b-af01-fc55-5f89" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Eztandarte de la Luna Malvada" id="cc3b-7562-b873-1036" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y todos los goblins nocturnos en su misma unidad obtienen la regla especial Tozudez. Cualquier enemigo que dispare contra la unidad tendrá un penalizador de -1 para impactar. Adicionalmente, cualquier unidad que cargue contra el portador o su unidad verá reducido a la mitad su atributo de Iniciativa hasta el final del turno en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
