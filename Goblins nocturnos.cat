      <rules>
        <rule name="Lanzapinchoz goblin nocturno" id="bc63-fb1b-ae2d-07f7" hidden="false">
          <description>El Lanzapinchoz dispara como un Lanzavirotes: sus impactos se resuelven con F6, no permiten tirada de salvación por armadura y tienen la regla especial Heridas 
múltiples (1D3), además de atravesar filas.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Dotación" id="3b5e-155f-b5e5-e00a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6a62-b5c7-a092-3a63" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="9aa6-c14b-5b00-e92b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Goblin nocturno (2)" id="c37d-bd36-ce9a-50dc" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">4</characteristic>
