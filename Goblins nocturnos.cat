            <infoLink name="Tozudez" id="597d-afa3-6f9d-daf1" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Eztandarte valerozo" id="8e87-4846-538a-cda5" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Puedes utilizarlo en una fase de combate de cuerpo a cuerpo (propia o del oponente), tras calcular el resultado del combate pero antes de chequear desmoralización. La unidad gana Tozudez hasta el final del turno de jugador en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Eztandarte Beztia de Nogg" id="a500-7f02-bdee-7c26" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e823-d95c-3e35-3453" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="75c7-20d2-6681-e3e9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
