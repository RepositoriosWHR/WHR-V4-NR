            <profile name="Zebo para garrapatoz" id="84ce-f90a-82f6-d604" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Kriador goblin nocturno. Un sólo uso. Puede utilizarse al inicio de cualquier fase de combate cuerpo a cuerpo. Todos los garrapatos (incluyendo los que sirven de monturas) a 10” o menos del portador obtienen la regla especial Furia asesina hasta el final de esa fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
