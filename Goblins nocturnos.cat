              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Todas las miniaturas de la unidad obtienen +1 ataque durante el turno en el que se activa el estandarte.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Eztandarte de la Luna Malvada" id="fb13-28bf-c209-82e5" collective="false" hidden="false" import="true" type="upgrade">
