    <selectionEntry name="Garrapatos encadenados" id="c657-d213-3fba-6eab" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="32b1-4b82-4d9c-5912" hidden="false" primary="true" targetId="5370656369616c23232344415441232323"/>
      </categoryLinks>
