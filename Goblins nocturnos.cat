          <modifiers>
            <modifier field="name" type="append" value="(Gobba)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Impactos por carga (1D3)" id="6479-d6d8-11ef-a906" hidden="false" targetId="97de-652c-df54-f43b" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Gobba)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Ataque rápido" id="88a6-ebee-4b60-f341" hidden="false" targetId="0107-ab2b-9c74-dade" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Gobba)"/>
          </modifiers>
        </infoLink>
