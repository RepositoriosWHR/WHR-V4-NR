      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Bichoz chungoz" id="775b-a051-27e5-df9a" hidden="false">
          <description>Ningún personaje puede unirse a una unidad de Jinetez de murciélago.</description>
        </rule>
        <rule name="Chillido espeluznante" id="45de-08d7-56b7-2e7c" hidden="false">
          <description>Cuando los murciélagos gigantes realizan una carga exitosa, la unidad que recibe la carga debe superar un chequeo de Liderazgo o quedar Apabullada hasta el final del turno de jugador en curso.</description>
        </rule>
        <rule name="Arrojar traztoz" id="c00e-5124-c3fa-e009" hidden="false">
          <description>Si una unidad de Jinetez de murciélago se mueve durante la sub-fase de Resto de movimientos por encima de una o más unidades enemigas no trabadas en combate, elige una de ellas. La unidad elegida sufrirá un impacto automático de Fuerza 5 por cada Jinete de murciélago que forme parte de la unidad que efectuó el ataque de Arrojarv traztoz. Una unidad que sufra una o más bajas por este efecto deberá efectuar inmediatamente un chequeo de Pánico.</description>
        </rule>
        <rule name="Gran envergadura" id="eaab-1782-e270-b2a4" hidden="false">
          <description>Un Murciélago gigante tiene una Potencia de unidad de 2, que sumada a la potencia 1 de su jinete totaliza Potencia de unidad 3 por miniatura.</description>
        </rule>
      </rules>
