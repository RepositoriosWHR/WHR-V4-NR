      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Realmente odia a los enanos" id="4566-7f19-faf5-67d9" hidden="false">
          <description>El Goblin Negro y cualquier unidad de goblins nocturnos a la que se una obtendrán la regla especial Odio (¡todos los enemigos!) y podrán repetir todas sus tiradas para impactar fallidas en combate cuerpo a cuerpo contra los Enanos.</description>
        </rule>
        <rule name="Archienemigo (Grombrindal)" id="ef2b-d661-2864-0f72" hidden="false">
          <description>Si tu ejército incluye a Skiggit, el Goblin Negro, y el ejército enemigo incluye a Grombrindal, el Enano Blanco, obtendrás 100 puntos de victoria adicionales si lo eliminas.</description>
        </rule>
      </rules>
