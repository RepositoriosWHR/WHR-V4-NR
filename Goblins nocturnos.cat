            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Eztandarte de guerra de Skarsnik" id="1497-d4d7-e3f2-f463" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los chequeos de animosidad fallidos a 24” o menos del estandarte se considerará que obtienen automáticamente un resultado de 6 (¡A por elloz!). Además, la unidad obtiene la regla especial Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
