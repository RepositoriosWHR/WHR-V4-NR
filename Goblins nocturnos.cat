              </costs>
              <profiles>
                <profile name="Hebilla de Durzik Al Drazh" id="ad76-ffae-5d04-5d0a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Gracias a las runas de suerte que tiene, su portador puede repetir hasta tres tiradas de dado durante la batalla (tiradas para impactar, herir, salvaciones o chequeos de atributo).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
