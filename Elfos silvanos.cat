        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Lady Ywain, custodia del estanque dorado" id="0b5a-683d-f81b-70ff" hidden="false">
          <description>Ywain es una hechicera de nivel de magia 2 que toma sus hechizos del Saber de la Vida y del Saber de las Sombras.</description>
        </rule>
        <rule name="Pasión oculta" id="8b7c-1ae1-5e10-4e9d" hidden="false">
          <description>Ywain tiene un bonificador de +1 en sus intentos de dispersión de hechizos, que aumentará a +2 siempre que realice un intento de dispersión sobre un hechizo que afecte a Thalos, espada de la tormenta.</description>
        </rule>
        <rule name="Aprendiz de guardián" id="48e5-b966-1fb7-c2ef" hidden="false">
          <description>Ywain tiene la regla especial Señor del conocimiento (Vida). Además, conocerá dos hechizos adicionales del Saber de las Sombras.</description>
        </rule>
        <rule name="Representante del bosque" id="498c-ba9b-7083-b9d0" hidden="false">
          <description>Ywain tiene la regla especial ¡Ni un paso atrás!, que afecta a todas las unidades amigas a 6” o menos de ella.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="General del ejército" id="6d03-31ce-a751-8c74" collective="false" hidden="false" import="true" type="upgrade">
