                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques efectuados con este arma se resuelven con las reglas especiales Poder de penetración e Impactos múltiples (1D3).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
