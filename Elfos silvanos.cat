              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco élfico. Sus disparos se resuelven con las reglas especiales Disparo rápido y Disparos múltiples (3).</characteristic>
              </characteristics>
