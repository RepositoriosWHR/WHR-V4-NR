          <entryLinks>
            <entryLink name="Reliquia" id="61c1-bdda-2283-3c5c" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Inmune al fuego" id="a717-1c67-f58a-207f" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
            <infoLink name="Estupidez" id="93bc-0435-270e-e01b" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Fragmento de Fimbulinvierno" id="8452-defc-a805-fc49" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Todas las unidades amigas a 12” o menos del portador obtienen la regla especial Inmune a fuego; además, todos los ataques con la regla especial Ataques flamígeros contra dichas unidades tendrán un penalizador de -1 en sus tiradas para herir. Sin embargo, todas las miniaturas con la regla especial Espíritu del bosque a 12” o menos del portador obtienen la regla especial Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Elfos silvanos" id="7111-ee4e-6249-0fad" collective="false" hidden="false" import="true">
