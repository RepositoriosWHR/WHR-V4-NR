            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Maldición de la bruja " id="fe23-ea89-f032-2138" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Flechas mágicas. Toda miniatura que pierda una o más heridas a causa de estas flechas, deberá efectuar un chequeo de Resistencia al final de dicha fase. En caso de fallar el chequeo, la miniatura morirá automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Lluvia de muerte " id="258c-bb57-5da0-5d0d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5d8f-1e29-e0b1-e988" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="138d-7b7d-3047-86c6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques mágicos" id="af8e-6f58-2c99-3f34" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Lluvia de muerte " id="7314-0b6c-dcae-7e90" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Flecha mágica. Un sólo uso. Esta flecha se divide en 3D6 flechas mágicas de Fuerza 4. Haz una tirada para impactar por cada una de las flechas resultante. Si esta flecha se dispara con un arco mágico, ignora los beneficios del arco mágico durante este disparo. El portador de esta flecha no podrá beneficiarse de ninguna regla especial o habilidad durante la misma fase en la que utiliza esta flecha.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Flechas del fallecimiento agónico " id="3143-44bb-e874-42a9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f2b8-de61-40eb-449c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="57db-726a-5e8b-836a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Flechas del fallecimiento agónico " id="170d-1943-3c65-5263" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Flechas mágicas. Una unidad que sufra al menos una herida a causa del impacto de una de estas flechas deberá efectuar inmediatamente un chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
