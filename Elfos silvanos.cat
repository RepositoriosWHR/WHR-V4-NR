        </selectionEntry>
        <selectionEntry name="Sehenlu, estirpe de Equos" id="a9c0-3840-e704-11ba" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c000-17a1-71e0-ec73" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sehenlu, estirpe de Equos" id="8a48-82a1-d85b-e6de" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje está equipado con Lanza de caballería y Armadura pesada, no puede beneficiarse de la regla especial Presencia inspiradora de un personaje con la regla especial Espíritu del bosque, exceptuando a Orión y a Ariel, y debe elegir como montura un Corcel élfico o un Carro de guerra. Tanto el personaje como su unidad realizarán los chequeos de Iniciativa con el valor más alto entre jinete y montura. Sólo puede unirse a unidades de Jinetes de Equos o Carros de guerra. Si el personaje está montado en Corcel élfico, obtiene la regla Caballería pesada y, mientras esté unido a ella, su unidad de Jinetes de Equos también obtendrá esta regla especial. En el caso de montar en Carro de guerra, obtiene un +1 a sus Impactos por carga con su Carro de guerra y, mientras esté unido a una unidad de Carros de guerra, esta unidad también obtendrá este bonificador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Lanza de caballería" id="ebab-7f1b-7313-74f0" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7304-1657-ee7e-c9d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
