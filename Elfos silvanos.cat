            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Sangre fría" id="e699-1d75-2cd6-4aef" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de la serenidad" id="84b1-0fa7-b45c-cc7c" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades enemigas en contacto con el portador o su unidad pierden las reglas especiales Furia asesina y/u Odio mientras continúen en contacto con ellos. El portador y su unidad obtienen la regla especial Sangre fría.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la Reina Eterna" id="f7bd-ecb9-acf0-f486" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="9efd-25cc-2848-a154" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="405c-2a1a-013c-2777" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de la Reina Eterna" id="f23a-280b-e284-62e0" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto portahechizos de nivel de energía 3. Contiene el hechizo Escudo de Saphery del Saber de Alta magia. El hechizo solamente podrá lanzarse sobre la propia unidad y no potenciado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del león" id="5881-e2c8-6f19-f7ae" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="cfc1-5379-0923-e72f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9f25-a519-397f-f74c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Veloz" id="5ed0-5d53-3cc9-7c0e" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del león" id="3539-0efa-4130-bd75" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen las reglas especiales Veloz e Inmune a Miedo (o Inmune a psicología en caso de que ya tuvieran la regla especial Inmune a Miedo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Ellyrion" id="f38c-00ae-6bc4-833d" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="8665-cd32-935f-3730" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4cb8-079f-c9b9-7d55" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Cruzar (todos los terrenos)" id="c24c-9eb3-de2f-1db0" hidden="false" targetId="747f-5236-492e-b132" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de Ellyrion" id="11d8-67ec-f344-1376" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador, su unidad y sus monturas obtienen la regla especial Cruzar (todo terreno).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Saphery" id="d6db-0393-ad6a-26ca" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="c6bc-0d62-73d4-7048" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="27cd-51e7-bfdc-0816" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de Saphery" id="65e0-1fe1-f520-e050" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Este estandarte genera un Dado de magia en cada fase de magia. Además, el portador y su unidad obtienen una tirada de salvación especial de 5+ que sólo pude efectuarse contra ataques con la regla especial Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte protector de las Annulii" id="0553-7bfd-bc08-8548" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6347-ddc4-5bf3-e631" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (2)" id="bf44-db53-5955-f631" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte protector de las Annulii" id="6582-8d4d-5ac1-88a6" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Resistencia mágica (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Altos elfos" id="6d72-9403-77cf-f7e3" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="0dcf-4efc-fa32-76b9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="58a6-7dad-d714-7a8d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Gema de la arrogancia" id="8ca0-09b5-fa5e-9c97" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2fa6-c0a3-85a0-60de" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7026-ce2e-2b43-cab3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Impasible" id="713b-4821-cfec-7a14" hidden="false" targetId="592b-c850-fd09-cce5" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Gema de la arrogancia" id="5da9-d3bc-e143-56f2" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a su portador la regla especial Impasible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema radiante de Hoeth" id="ab3c-4f31-5177-2bf4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3fba-1230-9467-be2d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="223d-52c7-84a2-b7c9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema radiante de Hoeth" id="2053-ce0e-d2a7-30d0" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 4. Al inicio de cada una de tus fases de magia elige uno de los ocho Saberes básicos de la magia y efectúa una tirada de 1D6, ese será el hechizo contenido en la gema durante ese turno (pudiendo elegir si se da el bis). Recuerda que no podrás elegir el hechizo identificativo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Anillo de la ira" id="e595-7695-9514-d53c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a643-4fe8-2b60-7039" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1585-1d03-d14d-79cc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Anillo de la ira" id="2bd5-4356-1587-6111" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 2. Contiene el hechizo Furia de Khaine en su versión no potenciada del Saber de Alta magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El libro del valor y la gloria" id="6f83-75df-0356-2f7e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="66c9-7d3a-eb71-1568" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="76e1-e39f-fb4d-9871" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El libro del valor y la gloria" id="3801-6355-28b5-90ef" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a su portador un bonificador de +1 a su atributo de Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Capa de las barbas" id="99cc-bd2a-d167-2f02" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a01e-6f8d-005a-a1ff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f45e-97bf-cc02-28cb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Capa de las barbas" id="94e8-da11-2ee7-ae3d" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas fallidas para impactar en combate cuerpo a cuerpo contra enanos (de cualquier tipo). Además, al inicio de cada fase de combate, elige una miniatura de enano que esté en contacto peana con peana con el portador; esta debe tirar 1D6 por cada uno de sus objetos rúnicos. Con un resultado de 4+, el objeto rúnico no se ve afectado pero, con un resultado inferior, el objeto no podrá aplicar el efecto de ninguna de sus runas hasta el final de la fase de combate cuerpo a cuerpo. Sin embargo, todos los enanos obtienen la regla especial Odio contra el portador de esta capa</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema del fuego solar" id="09c9-5ddd-16a0-3dca" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4daa-e2e4-f05f-a0d6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="09d2-793c-7eca-1867" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema del fuego solar" id="7ed7-087e-4e4b-1fac" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al inicio de cualquier fase de disparo o combate cuerpo a cuerpo. Hasta el final del turno de jugador en curso, el portador y su unidad obtienen la regla especial Ataques flamígeros y un bonificador de +1 en sus tiradas para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cuerno del dragón" id="ff33-3f36-3c3f-5e4b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e7ac-b685-8e4d-cbf3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="918f-a03b-61f9-9518" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cuerno del dragón" id="869f-9cd3-65eb-9a16" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse en la sub-fase de Reagrupar tropas que huyen de tu fase de movimiento. Todas las unidades de tu ejercito que estén huyendo se reagrupan automáticamente y pueden mover ese turno (aunque ten en cuenta que no podrán cargar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Diadema de Yvresse" id="dc0c-d42a-f5d6-a191" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c3d0-ec41-bc85-3bd6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="37c6-5ea0-d507-42b7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="70"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Clave: Hechicero" id="bfaf-4fa4-7b7f-b5dc" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Diadema de Yvresse" id="e2c6-2bf7-30a1-2f0b" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador la clave hechicero y nivel de magia 2, el cual elige sus hechizos de entre los ocho Saberes Básicos de la magia y Alta magia, pudiendo mezclar diversos saberes al generar sus hechizos. Además, la diadema permite al portador lanzar hechizos con normalidad en el caso de llevar armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Altos elfos. Infantería" id="1736-373d-4a0f-4279" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c187-1647-7d0d-a3d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="aa9b-38fa-3e84-498a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Fragmento de monolito de Moranion" id="4606-9407-fedc-92ae" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bad5-2765-72ab-4703" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5867-611f-c880-5a76" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Fragmento de monolito de Moranion" id="3c29-57a9-6ddd-8dea" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo Infantería. El personaje y la unidad de Infantería de Potencia de unidad máxima de 25 a la que se una obtienen la regla especial Emboscada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Toga de Folariath" id="bbe1-5b13-93d1-874e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1341-3e61-cae8-3734" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4bcb-a812-1b31-2591" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Volar (10)" id="5971-5314-0609-30c0" hidden="false" targetId="be56-917b-a9d5-2c76" type="rule"/>
            <infoLink name="Etéreo" id="bcdd-7b24-a142-637e" hidden="false" targetId="34c4-9e60-1a62-eda5" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Toga de Folariath" id="4e16-5737-cca5-d203" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo Infantería. El portador obtiene las reglas especiales Volar (10) y Etéreo, aunque no puede unirse a unidades. Su atributo de Ataques pasa a ser 0.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
