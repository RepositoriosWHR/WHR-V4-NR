            <infoLink name="Inmune a la psicología" id="40c5-adec-df4c-f027" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Selathoi, estirpe eterna" id="1513-05d7-f508-bf31" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje está equipado con Armadura pesada, obtiene las reglas especiales Tozudez e Inmune a psicología y sólo podrá unirse a unidades de Guardia eterna. Pueden elegir uno de sus objetos mágicos (que no sea una Reliquia) de la lista de objetos mágicos de los Altos elfos. Solo pueden elegir como montura una Águila gigante o un Dragón forestal. Si se equipan con Arco de Ellyrion o Arco de navegante, no pueden utilizar flechas mágicas ni especiales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Armadura pesada" id="9dfa-53d7-de95-9363" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
