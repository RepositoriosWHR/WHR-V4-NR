              <infoLinks>
                <infoLink name="Regeneración (4+)" id="0109-c5cc-cdcb-fc51" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
                <infoLink name="Resistencia mágica (2)" id="155e-37d0-15c0-08aa" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Orbe del vigor" id="74c1-97d1-589b-5c8d" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Cuando el portador pierda su última herida, tira 1D6: con un resultado de 1, no ocurrirá nada especial. Con un resultado de 2-5, el Taumaturgo zoat se levantará con una Herida restante y con un resultado de 6 se levantará con 1D3 Heridas restablecidas; en todo, caso el poder del orbe se consumirá. Mientras tanto, otorgará a su portador las reglas especiales Regeneración (+4) y Resistencia mágica (2).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Taumaturgo zoat anciano" id="e002-0850-01fe-1e93" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0769-f564-aff5-107d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="45"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Taumaturgo zoat anciano" id="2c22-ae91-fc72-36e8" hidden="false">
                  <description>Un Taumaturgo zoat anciano cuenta con una Herida adicional en su perfil de atributos y tiene la regla especial Señor del conocimiento (Vida).</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
