          <infoLinks>
            <infoLink name="Arco largo élfico" id="4501-28e9-45e2-9f92" hidden="false" targetId="02fd-0c5b-1417-d6f2" type="profile"/>
            <infoLink name="Francotirador" id="3313-a2ca-82e1-4224" hidden="false" targetId="8fa0-a4f6-e454-dbfe" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Tiro certero" id="62cf-b29f-f542-8895" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco largo élfico. Sus disparos se resuelven con la regla especial Francotirador. Si ya disponía de esta regla especial, obtendrá la regla especial Golpe letal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
