            <profile name="Armadura de la zarza" id="1241-6c29-8d64-c532" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Sólo Infantería. Los enemigos que quieran disparar o atacar en combate cuerpo a cuerpo al portador de esta armadura deberán aplicar un penalizador de -1 a sus tiradas para impactar. En el caso que el portador se encuentre a una distancia de 6” o menos de un Bosque, el penalizador pasa a ser de -2.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
