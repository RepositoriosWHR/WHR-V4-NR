          <profiles>
            <profile name="La garra de Callach" id="b8ca-e989-2166-ebc4" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Espadón de cacería. Las unidades enemigas obtendrán un penalizador de -1 a su valor de Liderazgo hasta el final del turno de jugador en curso por cada herida sufrida con este arma.</characteristic>
              </characteristics>
            </profile>
