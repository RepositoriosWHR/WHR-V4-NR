            <profile name="Ladrona de esencia arcana" id="4200-6339-08bf-09e7" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Sólo hechiceros. Los ataques efectuados con estas armas se resuelven con un bonificador de +1 a la Fuerza. Además, si causan una o más heridas, el portador obtendrá un Dado de magia adicional en la siguiente fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
