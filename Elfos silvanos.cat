            <constraint id="7774-aeef-866e-bd01" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio (todos los enemigos)" id="b7f3-058a-2cf4-7b7d" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
            <infoLink name="Veloz" id="4174-8cc3-8704-d27a" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Cuerno de Gwytherc " id="6f10-994d-cab8-a26e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede hacerse soplar al inicio de cualquier turno propio. Todas las unidades aliadas situadas a 12” o menos del portador obtendrán las reglas especiales Veloz y Odio (¡todos los enemigos!) hasta el final de ese turno de jugador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
