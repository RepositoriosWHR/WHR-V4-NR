              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Otorga a su portador un bonificador adicional de +1 a la tirada de salvación por armadura. Además, las tiradas para impactar exitosas efectuadas contra el portador deben repetirse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura sombría" id="0ea5-1135-fdc5-3fb6" collective="false" hidden="false" import="true" type="upgrade">
