          <infoLinks>
            <infoLink name="Etéreo" id="3f52-383f-2de3-adfd" hidden="false" targetId="34c4-9e60-1a62-eda5" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Desconexión con el plano material" id="eec3-b60c-9cc3-c1f6" hidden="false" typeId="65f7-dbac-1c36-4370" typeName="Rasgos, Duendes y Hadas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2fbf-7988-6346-79de">El personaje obtiene la regla especial Etéreo. No puede beneficiarse de ningún tipo de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
