                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Cuerno de la cacería salvaje" id="9dac-24d7-5c36-6566" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Al inicio de uno de tus turnos, puedes hacer sonar el cuerno. Si lo haces, todas las unidades aliadas a 24” o menos de Orión obtienen las reglas especiales Carga devastadora y Odio (¡todos los enemigos!), además de poder repetir las tiradas de carga fallidas. Las unidades que ya tengan la regla especial Odio (¡todos los enemigos!) podrán repetir todas las tiradas fallidas para impactar en combate cuerpo a cuerpo. Los efectos permanecen hasta el inicio de tu siguiente turno.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
