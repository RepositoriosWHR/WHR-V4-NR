          <infoLinks>
            <infoLink name="Exploradores" id="d50e-7292-7a73-ff46" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Arahain, estirpe de los exploradores" id="846a-4926-4cc1-78da" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje obtiene un bonificador de +1 a su Habilidad de proyectiles y la regla especial Explorador. El personaje y cualquier unidad de Exploradores a la que se una podrán repetir los resultados naturales de 1 para herir con sus armas de proyectiles cuando disparen a corto alcance. El personaje no puede elegir ninguna montura ni equiparse con armaduras que no sea armaduras ligeras.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Auryaur, estirpe de los jinetes salvajes de Kurnous" id="f460-5823-54ca-fbbf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9556-fe6d-ae5c-5ae2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Rasgos, Duendes y Hadas. Especiales" id="afb8-204c-c40f-fed6" collective="false" hidden="false" import="true" targetId="31c4-b66d-5717-2e72" type="selectionEntryGroup">
              <constraints>
                <constraint id="b648-0158-d171-352a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
            </entryLink>
          </entryLinks>
          <infoLinks>
            <infoLink name="Espírirtu del bosque" id="294e-41e8-a3ea-f281" hidden="false" targetId="2cd9-4f7f-12b2-77a7" type="rule"/>
            <infoLink name="Protección del bosque" id="a6e7-3d3a-ebfe-802f" hidden="false" targetId="79b3-ed9e-26e7-20be" type="rule"/>
            <infoLink name="Odio (todos los enemigos)" id="3c39-3f62-651b-7651" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Auryaur, estirpe de los jinetes salvajes de Kurnous" id="6bf5-6caa-56f7-3770" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje obtiene las reglas especiales Espíritu del bosque, Protección del bosque y Odio (¡todos los enemigos!) y puede escoger una opción de Rasgos, duendes y hadas especiales. El personaje debe elegir como montura un Corcel de Kurnous o un Gran venado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Caidath, estirpe de los bailarines guerreros" id="58da-a8bb-8578-3da2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4c41-8de2-34e6-ee57" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Esquivar (4+)" id="0994-6427-3bb9-ccc1" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
            <infoLink name="Inmune a la psicología" id="c6fe-d662-8d41-0d63" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Danzas de guerra de Loec" id="34ff-2cb3-f344-bd84" hidden="false" targetId="16b9-417f-7a99-52b2" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Caidath, estirpe de los bailarines guerreros" id="3d01-9086-e5ba-dd37" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje está equipado con Tatuajes talismánicos, no podrá equiparse con armaduras o armas de proyectiles de ningún tipo, obtiene las reglas especiales Esquivar (4+), Inmune a psicología y Danzas de guerra de Loec y sus atributos de Movimiento y Habilidad de armas se ven incrementados en un punto. No puede elegir ninguna montura, solamente podrá unirse a unidades de Bailarines guerreros y no podrá ser el Portaestandarte de batalla del ejercito.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Tatuaje talismánico" id="8f7b-c5aa-dd3d-5d18" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cdd4-bd84-28a2-5236" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0053-9ae4-1571-fdb8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
