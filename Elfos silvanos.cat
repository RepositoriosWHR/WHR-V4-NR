              <profiles>
                <profile name="Arco garra de halcón" id="9e21-8d96-1389-7b71" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco largo élfico. Sus disparos se resuelven con alcance 48”, Fuerza 7, la regla especial Heridas múltiples (1D3), niegan la tirada de salvación por armadura y Atraviesan filas como un Lanzavirotes. Si usa la regla especial Lluvia de flechas, no Atraviesa filas.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Capa de Isha" id="59aa-3f8e-851b-22c4" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
