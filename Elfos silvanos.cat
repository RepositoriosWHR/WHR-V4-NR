        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Destreza marcial" id="f215-e59f-a0a6-b3b9" hidden="false" targetId="2cac-4aca-2f4d-9916" type="rule"/>
        <infoLink name="Exploradores" id="ce28-6558-999c-9687" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
        <infoLink name="Cruzar (bosques)" id="0e42-5968-cd8c-b290" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
        <infoLink name="Infantería" id="7799-f18a-ecd4-a197" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Tiradores avezados" id="d599-b9b4-c727-8d78" hidden="false">
          <description>Siempre que Skarloc y su unidad no hayan realizado ningún movimiento durante el turno de jugador en curso, pueden realizar sus disparos utilizando la regla especial Disparos múltiples (2).</description>
        </rule>
        <rule name="Trotamundos" id="1274-8421-b5e0-a977" hidden="false">
          <description>Al inicio de la partida elige un tipo de terreno, Skarloc y su unidad obtendrán la regla especial Cruzar para el tipo de terreno elegido.</description>
        </rule>
        <rule name="Magia Kaia, bruja de la tormenta" id="6b39-741f-4e60-04b4" hidden="false">
          <description>Kaia es una hechicera de nivel 1. Usa el Saber de los Cielos y conoce los hechizos Portento de Phar y Rayo Atronador de Urannon (puede lanzar este hechizo pese a que normalmente no podría debido a su nivel de magia; además, suma +4 a sus tiradas de lanzamiento de hechizos si se encuentra a 12” o menos de un bosque).</description>
        </rule>
      </rules>
      <selectionEntries>
