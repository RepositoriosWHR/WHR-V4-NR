            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="d018-7d97-db85-9daf" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Cythral, estirpe de los centinelas" id="47ac-8249-1563-f791" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje está equipado con Espadón de cacería, obtiene la regla especial Inmune a psicología y resolverá sus ataques en combate cuerpo a cuerpo la regla especial Heridas múltiples (1D3) contra miniaturas que causen Miedo o Terror. El personaje no puede elegir ninguna montura, solamente podrá unirse a unidades de Centinelas del Bosque Salvaje y, si se une a una unidad de Centinelas del Bosque Salvaje, tanto el personaje como la unidad obtendrán la regla especial Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Espadón de cacería" id="d3f3-78b5-6ff2-ccd8" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="089f-1383-4265-faba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
