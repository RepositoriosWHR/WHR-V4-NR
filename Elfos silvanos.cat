              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">En cada fase de magia enemiga, el portador puede reducir en uno los Dados de energía del oponente y aumentar en uno sus Dados de dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vara de plata" id="b2b3-a286-1136-ce25" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="79c2-320d-f4f5-9d89" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b034-eae3-4e81-2ef5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="3a8a-6b11-da89-793a" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Vara de plata" id="b05a-4a2a-1473-9d46" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a su portador la regla especial Señor del conocimiento de uno de los ocho Saberes Básicos de la magia. Además, los hechizos del portador no puede ser olvidados ni destruidos por ningún efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo del árbol estelar" id="0986-2e41-b767-e30f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d11d-44b4-6ccc-72e3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6014-ade2-89c4-ea8d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo del árbol estelar" id="952c-350c-1078-eb32" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a su portador un +1 a sus tiradas de lanzamiento y dispersión de hechizos y podrá repetir sus tiradas para Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello de Asuryan" id="6620-3015-64b3-76cc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0122-c8b2-f8d6-99f4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9bf9-1839-e4fb-1f75" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sello de Asuryan" id="79a2-5422-a3fd-04e1" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Puedes declarar que lo usas cuando el oponente lance exitosamente un hechizo pero antes de efectuar la tirada para dispersar. Dispersa automáticamente el hechizo. Ten en cuenta que no funciona contra hechizos lanzados con Fuerza irresistible. Además, el lanzador del hechizo sufrirá 1D3 impactos de Fuerza 5 con la regla especial Ataques flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro de la solidez" id="1e67-c6ac-f40a-a0b4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="452c-b955-e876-0f07" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8554-4715-b959-c43c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro de la solidez" id="7171-0fe9-aed1-c530" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El portador puede ignorar los efectos de la primera de las Disfunciones mágicas que sufra durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
