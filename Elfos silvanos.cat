            <profile name="Espadas de Loec" id="ec5a-b0ce-3cee-c910" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los ataques con estas armas pueden repetir las tiradas para herir fallidas. Además, si su portador participa en un Desafío, el oponente deberá repetir las tiradas de salvación por armadura exitosas frente a los ataques realizados con estas armas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
