          <profiles>
            <profile name="Sethayla, estirpe de los jinetes del viento" id="7036-e1c8-e33d-04a7" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje obtiene las reglas especiales Ataque relámpago y Esquivar (5+), debe elegir como montura un Halcón de guerra y puede equiparse con Flechas veloces. Además, la unidad de Jinetes de halcón a la que se una obtiene la regla especial Esquivar (5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cythral, estirpe de los centinelas" id="f294-f85f-0d07-2bc4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="51e8-e4bd-bff9-10f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
