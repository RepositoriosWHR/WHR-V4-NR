          <constraints>
            <constraint id="cf70-187d-9ece-f415" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2152-56b2-3fa9-c544" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="80"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="21c3-8256-fa36-8e0b" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Arma de mano" id="df03-3271-f85e-4048" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espada de los espíritus" id="0642-b369-7e74-cb8d" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques efectuados con este arma niegan las tiradas de salvación por armadura del enemigo. Al tirar a herir, utiliza el valor de Liderazgo del portador en vez de su Fuerza. Además, si una miniatura enemiga sufre una o más heridas por este arma, tanto el portador como la miniatura objetivo deberán tirar 2D6 y sumar sus respectivos atributos de Liderazgo: si el portador obtiene un resultado mayor, la miniatura enemiga sufrirá una herida adicional sin ningún tipo de salvación posible ni de Regeneración; estas heridas no generan nuevos chequeos de Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Reliquias. Elfos silvanos. Armadura pesada" id="279e-83a6-5cd4-828a" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="29f7-1a35-178c-6a79" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="cc1b-a490-9db1-4a9e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
