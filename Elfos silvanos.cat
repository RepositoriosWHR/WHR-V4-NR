          </entryLinks>
          <profiles>
            <profile name="Arpa del bardo " id="6856-4997-463c-584d" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador una tirada de salvación especial de 4+. El portador se considerará Músico y duplica su Potencia de unidad, incluida su montura. Las miniaturas de la unidad de la que forme parte el portador obtendrán una tirada de salvación especial de 5+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Broche de amarantos " id="8c39-fa51-d535-9a19" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d478-bf3b-aec0-7001" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ee09-3f14-2f9b-9fb1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="17cf-e6e3-926d-150f" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Broche de amarantos " id="e27d-6a3d-6ed3-f0bc" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga al portador la regla especial Aura demoníaca (3+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Aura demoníaca (3+)" id="3e08-b40f-09da-4884" hidden="false">
              <description>Confiere una tirada de salvación especial (normalmente de 5+, aunque pueden especificarse otros valores), que no puede realizarse frente a ataques mágicos.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Fragmento de Fimbulinvierno" id="db0b-e856-9825-739a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="46d1-1c7c-6fe0-8d3c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7d32-3c21-48ba-19b4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
