            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Laith-kurnous, estirpe de los señores de las bestias" id="1c22-a339-57a1-e219" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje gana la regla especial Veloz, además obtiene un bonificador de +3 a su atributo de Movimiento y +1 a su atributo de Ataques, no puede elegir ninguna montura y no puede ser ni el General ni el Portaestandarte de batalla del ejército.Puede entrar en batalla acompañado por uno de los siguientes tipos de Bestias: 1-8 Jabalíes salvajes (+8 puntos por miniatura), 1-5 Lobos gigantes (+14 puntos por miniatura), 1-2 Tigres (+35 puntos por miniatura) o 1 Oso cavernario (+95 puntos). En dicho caso, formará una unidad junto a las bestias con las reglas especiales Hostigadores y Unidad mixta. No puede unirse a otras unidades.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Bestias" id="caf0-7254-dc23-478c" collective="false" hidden="false" import="true">
