    <selectionEntry name="[E] - Kaia, Glam, Araflane y los arqueros de Skarloc" id="b689-afab-8f2a-22e1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink id="32b5-5f56-9608-9c2e" hidden="false" primary="true" targetId="5370656369616c23232344415441232323"/>
      </categoryLinks>
