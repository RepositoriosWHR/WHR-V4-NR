        <entryLink name="Saga (Thalandor)" id="5165-7015-0d3e-aaa7" collective="false" hidden="false" import="true" targetId="ec5b-a1fc-601c-4801" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="New InfoLink" id="c38c-49f1-1674-b28d" hidden="false" targetId="2cac-4aca-2f4d-9916" type="rule"/>
        <infoLink name="Cruzar (bosques)" id="f426-1ebd-d5c1-6346" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
