              <profiles>
                <profile name="Báculo de olmo" id="3fd9-e7dc-fce6-ad3e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Lanza. Las heridas causadas con este arma no permiten tiradas de salvación por armadura. Además, permite a Ariel generar 1D3 Dados de magia adicionales en cada fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Venablos del espino negro" id="b0be-16a7-2e1d-856a" collective="false" hidden="false" import="true" type="upgrade">
