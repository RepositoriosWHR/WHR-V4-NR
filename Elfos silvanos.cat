              <infoLinks>
                <infoLink name="Tatuajes talismánicos" id="8437-7194-ebc1-d34c" hidden="false" targetId="5df0-8511-c6f8-cc9a" type="profile"/>
              </infoLinks>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Haroith, estirpe de los jóvenes" id="bd2c-0768-0842-a244" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4cf8-7a99-43ef-f20b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ira de Kurnous" id="20bf-e278-8fc8-5d26" hidden="false" targetId="ce02-7e68-d3a6-7adf" type="rule"/>
            <infoLink name="Protección del bosque" id="a361-7daa-cc47-8fb1" hidden="false" targetId="79b3-ed9e-26e7-20be" type="rule"/>
            <infoLink name="Inmune al pánico" id="b2d7-f332-97ad-ca7b" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Haroith, estirpe de los jóvenes" id="05b9-90f4-c21f-ff32" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje obtiene las reglas especiales Ira de Kurnous, Protección del bosque e Inmune a Pánico. Solo podrá unirse a unidades de Jinetes aspirantes de Kurnous y tanto él su unidad podrán realizar el chequeo de Liderazgo para evitar cargar debido a la regla especial Ira de Kurnous con 3D6 escogiendo los dos resultados más bajos. El 
personaje debe elegir como montura un Corcel élfico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Nymraif, estirpe de los forestales" id="e105-d7c2-4ca3-5115" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6c32-f2ee-1169-624a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Guerrilleros" id="701b-b150-1aba-07c4" hidden="false" targetId="d709-dd45-f006-7113" type="rule"/>
            <infoLink name="Tirador experto" id="5685-d140-d1d7-4381" hidden="false" targetId="e70d-21c1-d0d9-54a7" type="rule"/>
            <infoLink name="Exploradores" id="db66-37a9-11df-9259" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Nymraif, estirpe de los forestales" id="ce66-895f-4f95-2c6a" hidden="false" typeId="a638-f7fc-e4ce-1819" typeName="Estirpe">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6fbb-f5ca-148f-3e4f">El personaje está equipado con Capa de forestal, obtiene un bonificador de +1 a su Habilidad de proyectiles y a su Movimiento y las reglas especiales Guerrillero, Tirador experto y Explorador. Sus disparos se resuelven con la regla especial Golpe letal. El personaje no puede elegir ninguna montura, equiparse con armaduras que no sean armaduras ligeras ni ser el Portaestandarte de batalla del ejercito.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Capa de forestal" id="baea-075e-a50e-d0e7" collective="false" hidden="false" import="true" type="upgrade">
