            <profile name="Armadura sombría" id="5261-c1eb-27a7-fe51" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Otorga a su portador una tirada de salvación especial de 5+, que se incrementa a 4+ contra heridas con la regla especial Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
