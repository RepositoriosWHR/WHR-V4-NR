            <infoLink name="Regeneración (4+)" id="06d1-eabf-0af4-7672" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
            <infoLink name="Armadura pesada" id="9219-4e1f-9153-5c44" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura del  roble eterno " id="ca99-dc64-7eb4-aca9" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Otorga a su portador las reglas especiales Regeneración (4+) e Inmune a veneno, además de inmunidad a las reglas especiales Golpe letal y Golpe letal heroico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Elfos silvanos" id="430c-1d7f-2bcd-4c72" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="be9d-912b-45ec-804f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="d3c4-4bda-a228-9a96" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Urdimbre de encantamientos " id="dafe-e998-4e1d-98a6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="93d9-2319-0baf-e3be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2325-c764-223c-cce3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Urdimbre de encantamientos " id="5026-e64f-5ef4-9c19" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador una tirada de salvación especial de 4+ contra disparos y hechizos del tipo Proyectil mágico. Además, toda unidad que intente atacar a su portador en combate cuerpo a cuerpo tendrá que superar un chequeo de Liderazgo: si lo falla, tan sólo logrará impactar con resultados de 6 durante dicha fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Piedra de la muerte invernal " id="2d05-0b37-c0c2-dc54" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1128-30d6-cd87-779c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4e8e-d3e9-8522-98a4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune al fuego" id="8b0e-4f80-affe-0ecb" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
            <infoLink name="Estupidez" id="5887-ceb4-bdeb-34e4" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Piedra de la muerte invernal " id="f97b-6bcd-dd2a-b3d1" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga al portador la regla especial Inmune a fuego. Los ataques dirigidos contra el portador sufrirán un penalizador de -1 a las tiradas para herirle. Todas las miniaturas con la regla especial Espíritu del bosque situadas a 6” o menos del portador se verán afectadas por la regla especial Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Piedra del retoñar " id="a99e-1a32-775c-137d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7be9-564a-ea92-6e94" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4901-f20a-bbe8-9a5a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Piedra del retoñar " id="1972-cd34-6ebc-87fa" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo personajes con Potencia de unidad 4 o inferior. Un sólo uso. Cuando el atributo de heridas del portador se reduzca a 0, antes de retirar la miniatura del campo de batalla tira 1D6: si obtienes un resultado de 1, retira al portador como baja con normalidad; con un resultado de 2-5 la miniatura recuperará una herida y, con un resultado de 6, la miniatura recuperará todas sus heridas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema de Merciw " id="7d19-60e6-1234-0608" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="23f0-ac63-9e02-ecae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c9b7-9444-fdf8-53eb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema de Merciw " id="bb29-9197-14be-238f" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador no recibe bonificador alguno a la Fuerza de ningún arma. No obstante, cualquier miniatura que quiera golpearle perderá también los bonificadores de Fuerza de las armas con las que le ataque.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Reliquias. Elfos silvanos" id="5fa8-98c5-8e4a-5d41" collective="false" hidden="false" import="true">
