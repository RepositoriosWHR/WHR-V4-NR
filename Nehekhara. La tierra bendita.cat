    <selectionEntry id="dbc9-1503-1389-9d82" name="Carro del Trueno Rasetrano" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="8589-69f9-8ebe-8b5a" name="Potencia de unidad 4" hidden="false"/>
        <rule id="5def-7d53-cf06-4480" name="Carga aterradora" hidden="false">
          <description>Un Carro del trueno causa 1D6+2 impactos por carga (1D6+3 si va equipado con cuchillas).</description>
