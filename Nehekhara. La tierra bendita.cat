            <entryLink name="Reliquia" id="1d33-e090-a197-d273" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Estandarte de las Arenas" id="905b-592f-4bea-c26c" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los disparos contra el portador (y la unidad en la que se encuentre) tendrán un penalizador adicional de -2 para impactar, y todos los impactos causados por plantillas de área de efecto sobre la unidad y el portador se consideran impactos parciales. Mientras el portador del estandarte siga con vida, todas las unidades enemigas en el campo de batalla tendrán un penalizador de -1 a su Liderazgo en todos sus intentos de reagruparse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
