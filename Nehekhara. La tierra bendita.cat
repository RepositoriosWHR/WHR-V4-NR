    <selectionEntry id="105d-1e25-f8c9-618f" name="Sacerdote de Nehekhara" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="2bf3-aa34-e6c1-680b" name="Cánticos de guerra Sacerdote de Nehekhara" hidden="false">
          <description>Un Sacerdote conoce todos los Cánticos de guerra, y puede lanzar uno ellos por fase de magia con nivel de energía 3; además, puede dispersar hechizos como si fuese un hechicero de nivel 1.</description>
        </rule>
      </rules>
