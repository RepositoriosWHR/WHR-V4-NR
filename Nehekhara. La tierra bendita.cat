        <infoLink name="Bendición de los dioses" id="9480-07ff-9148-2f3f" hidden="false" targetId="2539-f674-9ee1-5e4d" type="rule"/>
        <infoLink name="Recuerdo de Nagash" id="bbbc-c8eb-739a-b826" hidden="false" targetId="fd9f-2f65-41b2-3e46" type="rule"/>
        <infoLink name="Odio (todos los enemigos)" id="5dfa-1122-eec9-7592" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Ira del creador" id="989b-a6c0-7aa7-aa9c" hidden="false">
          <description>Todas las unidades con la regla especial Constructo amigas a 12” o menos del Necrotecto obtienen la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
        <rule name="Forjador arcano" id="193b-2f9b-9156-77e1" hidden="false">
          <description>Al inicio de cada uno de tus turnos, elige una unidad amiga con la regla especial Constructo a 12” o menos del Necrotecto: esta recupera inmediatamente las heridas indicadas en su regla especial Constructo.</description>
        </rule>
      </rules>
