          <profiles>
            <profile name="Manto de las dunas" id="aa94-5fb0-0322-b128" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo hechiceros. El portador obtiene la regla especial Volar (10).</characteristic>
