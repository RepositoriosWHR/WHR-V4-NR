      </constraints>
      <rules>
        <rule id="ca5d-4ae6-5b50-e8e6" name="Unión espiritual" hidden="false">
          <description>La tirada de salvación total de los Caballeros de la necrópolis es de 3+, lo cual incluye el 5+ por la regla Constructo, su Armadura ligera y el bonificador de +1 por ser Caballería monstruosa.</description>
        </rule>
        <rule id="bd59-2f08-fc97-a2a1" name="Armas encantadas" hidden="false">
          <description>El proceso mágico que vincula el guardián con la necrosierpe también imbuye su arma con un gran poder. La Lanza de los caballeros y del Gran adalid tienen las reglas especiales Ataques mágicos y Golpe letal. </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="772f-20c0-b9df-7c9e" name="Caballería monstruosa" hidden="false" targetId="a7be-2cd9-f3c6-b091" type="rule"/>
        <infoLink id="604c-30de-9295-5d3a" name="Constructo" hidden="false" targetId="3ace-7252-bafe-b12c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1D2)"/>
          </modifiers>
        </infoLink>
        <infoLink id="5fd4-0e2b-162a-b6d8" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Jinetes)"/>
          </modifiers>
        </infoLink>
