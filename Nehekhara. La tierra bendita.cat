                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2f6e-db20-85d0-77ad" type="min"/>
              </constraints>
              <profiles>
                <profile id="502b-1b7c-4ac6-fdf6" name="Bastón del Liche" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que lance un hechizo, Khatep puede, si lo desea, repetir todos los dados de la tirada de lanzamiento.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
