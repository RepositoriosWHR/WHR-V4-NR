    <selectionEntry id="4722-df83-c60a-475b" name="[Ex] - Caballeros de la necrópolis" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="2e35-b42f-7e95-c548" value="3.0">
          <conditions>
