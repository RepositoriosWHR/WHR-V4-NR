    <selectionEntry id="59e4-4b8e-6fac-6929" name="Arqueros de Zandri" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="d714-4c47-c195-3cd3" value="3.0">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="170b-06ad-215f-f891" type="equalTo"/>
