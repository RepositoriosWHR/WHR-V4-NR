    <selectionEntry id="2ae9-ab7c-c37f-4dae" name="[E] - Alcadizaar el Conquistador, Rey de Khemri y de todo Nehekhara" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="046a-1c36-705e-1c0e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d452-4e92-6449-1b70" type="max"/>
      </constraints>
      <rules>
        <rule id="79e1-6fc5-b516-f7ec" name="Elegido del Panteón" hidden="false">
          <description>El efecto de la bendición de los Dioses en Alcadizaar aumenta hasta una tirada de salvación especial de 4+ y Resistencia mágica (2).</description>
        </rule>
        <rule id="c0cb-b66c-3b5d-b69d" name="Rey de Nehekhara" hidden="false">
          <description>El alcance de la regla especial Presencia inspiradora de Alcadizaar (por ser el general del ejército) aumenta a 18”. Además, todas las unidades amigas dentro de ese radio serán Inmunes a la psicología.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9a07-0fd0-eb82-3c2a" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="2ae9-ab7c-c37f-4dae" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="f6fd-28f6-c33b-b1b1" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink id="c42b-d143-3202-6ea7" name="Bendición de los dioses" hidden="false" targetId="2539-f674-9ee1-5e4d" type="rule"/>
        <infoLink id="ae13-5670-8a96-b89e" name="Recuerdo de Nagash" hidden="false" targetId="fd9f-2f65-41b2-3e46" type="rule"/>
        <infoLink id="52be-1fb9-b8e7-6d93" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink id="e520-5441-814b-670f" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
      </infoLinks>
