      <infoLinks>
        <infoLink name="Infantería" id="c4f9-16b4-bd6f-9a85" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="¡Están muertos!" id="2f6a-8806-c0e4-5f57" hidden="false" targetId="46c1-3e40-469b-6e15" type="rule"/>
        <infoLink name="Señor del conocimiento" id="eefb-d9f6-4416-60b5" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Saber de la Antigua Nehekhara)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Regeneración (4+)" id="a267-0269-e78b-4bb4" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Khatep el Eterno" id="dc8f-f425-59ea-73cf" hidden="false">
          <description>Khatep el Eterno es un hechicero de nivel 4 que conoce todos los hechizos del Saber de la Antigua Nehekhara.</description>
        </rule>
        <rule name="Sumo hierofante" id="f088-cbef-fe20-58d7" hidden="false">
          <description>Khatep posee la regla especial Regeneración (4+). Cualquier unidad a la que se una obtendrá la regla
especial Regeneración (5+).</description>
        </rule>
        <rule name="Magia ritual" id="e865-d149-0518-b6cd" hidden="false">
          <description>Cada vezque Khatep realice una tirada en la tabla de disfunciones mágicas, tira 1D3 adicional y añádelo al resultado de la tirada. Si obtienes un resultado superior a 12, la disfunción no tendrá efecto.</description>
        </rule>
      </rules>
