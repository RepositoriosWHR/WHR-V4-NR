    <selectionEntry id="cc78-1bf2-4b13-d11c" name="[E] - Rahotep el Aventurero" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3e81-e093-6683-33b6" type="max"/>
      </constraints>
      <rules>
        <rule id="6f08-eba6-2263-cf48" name="El aventurero" hidden="false">
          <description>Puedes unir a Rahotep a una unidad de infantería básica antes de comenzar la batalla: esa unidad obtiene la regla especial Vanguardia.</description>
        </rule>
        <rule id="9fcc-9cd2-cc4f-5c1e" name="Valor inquebrantable" hidden="false">
          <description>Rahotep (y la unidad en la que se encuentre) puede repetir todos sus chequeos de Liderazgo fallidos; además, es Inmune a Miedo.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0abf-27f5-9c97-328c" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="51e5-c530-8892-1f86" name="Bendición de los dioses" hidden="false" targetId="2539-f674-9ee1-5e4d" type="rule"/>
        <infoLink id="f9d5-13bb-341e-3ab6" name="Recuerdo de Nagash" hidden="false" targetId="fd9f-2f65-41b2-3e46" type="rule"/>
        <infoLink id="1fd9-4a62-d0c4-e88d" name="Inmune al miedo" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
        <infoLink id="1e6b-5d78-c094-9c33" name="Vanguardia" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
      </infoLinks>
