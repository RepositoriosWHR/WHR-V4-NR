    <selectionEntry id="ad20-cd94-8c60-e2eb" name="Necroesfinge" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="eb47-38e6-bd57-ff4e" type="max"/>
      </constraints>
      <rules>
        <rule id="28bf-19cf-ef6f-470e" name="Piel de piedra" hidden="false">
          <description>Esta regla especial proporciona a la Necroesfinge una tirada de salvación por armadura de 4+ que,
combinada con la regla especial Constructo, totaliza una tirada de salvación por armadura de 2+.</description>
        </rule>
        <rule id="21c6-154e-48d7-a2a5" name="Golpe decapitador" hidden="false">
          <description>El ataque adicional de la Necroesfinge se resuelve con Fuerza 10 y la regla especial Golpe letal heroico.</description>
        </rule>
        <rule id="3227-1e44-fba9-696d" name="Avatar de Usirian" hidden="false">
          <description>Siempre que una Necroesfinge ataque en combate cuerpo a cuerpo a tropas que no sean de las categorías Infantería o Enjambres podrá repetir los resultados de 1 en sus tiradas para impactar.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="358e-2fad-fc8b-b7a3" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="8bc6-94af-1172-609f" name="Constructo" hidden="false" targetId="3ace-7252-bafe-b12c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
