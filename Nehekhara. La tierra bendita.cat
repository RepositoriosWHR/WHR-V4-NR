          <modifiers>
            <modifier field="name" type="append" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Resistencia mágica (1)" id="b329-6e09-4839-ad16" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Magia Hierotitán" id="166c-cc11-faf6-177d" hidden="false">
          <description>Un Hierotitán es un hechicero de nivel 2 que siempre usa el Saber de la Antigua Nehekhara.</description>
        </rule>
        <rule name="Conducto espiritual" id="351b-57d7-bce2-b803" hidden="false">
          <description>Cada vez que un efecto de invocación fuera a restaurar heridas a una unidad amiga con la regla especial Constructo a 12” o menos de un Hierotitán, tira dos veces por cada dado y elige el resultado mayor.</description>
        </rule>
        <rule name="Resistencia excepcional" id="fa73-3484-ebef-f48d" hidden="false">
          <description>Cada vez que el Hierotitán fuese a recibir heridas por efecto de la regla especial Heridas múltiples, divide el número de heridas a la mitad (redondeando hacia arriba).</description>
        </rule>
      </rules>
