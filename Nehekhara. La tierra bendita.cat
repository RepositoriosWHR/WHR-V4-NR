          <infoLinks>
            <infoLink name="Ataques flamígeros" id="5c2c-56f6-bdbc-422f" hidden="false" targetId="6985-722e-1ce4-b838" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Impactos por carga adicionales)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Carro de fuego" id="4c9e-d96d-eb98-da49" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo personajes montados en carro de guerra o Carro del trueno rasetrano. El carro de guerra del personaje causa 1D6 impactos por carga adicionales, que se consideran Ataques flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Icono del héroe" id="d4b1-a168-de9f-95e6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e3d4-cd4d-4e19-de67" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0878-1993-cd80-072a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Icono del héroe" id="3cd6-5443-f927-b128" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo personajes montados en carro de guerra o Carro del trueno rasetrano. Puede elegirse aunque ya se haya escogido otro Objeto Hechizado. La potencia de unidad del carro de guerra que monta el personaje aumenta en +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Reliquias. Nehekhara. La tierra bendita" id="7943-f398-93e8-9446" collective="false" hidden="false" import="true">
      <constraints>
