      <rules>
        <rule id="8faa-2f2d-80df-cbfc" name="Sumo celador" hidden="false">
          <description>El Paladín y su unidad obtienen la regla especial Tozudez durante cualquier fase de combate en la que el Paladín haya participado en un desafío (incluso aunque muera en ese desafío).</description>
