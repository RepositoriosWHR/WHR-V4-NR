    <selectionEntry id="22f3-7411-cf54-426e" name="Hurusanni" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="457e-40ec-97ad-3a7e" value="3.0">
          <conditions>
