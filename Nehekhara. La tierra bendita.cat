            <profile name="Sello de protección de Neru" id="e02b-3403-9917-cc45" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador y su unidad obtienen la regla especial Regeneración (6+, o +1 si ya disponían de ella, hasta un máximo de 3+)</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pectoral de Shapesh" id="7e02-8532-93f7-fca1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="af24-4787-0d84-5eec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1f8d-824d-2cde-88d1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pectoral de Shapesh" id="eb6d-66ac-2ba4-4d97" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cada vez que el portador fuese a sufrir una herida (tras las tiradas de salvación y regeneración pertinentes), tira 1D6: con un resultado de 1-3, la herida se asigna al personaje de manera habitual. Con un resultado de 4+, la herida se asigna en su lugar a una miniatura amiga de tu elección a 8” o menos del portador. Ten en cuenta que una herida reasignada no puede salvarse o evitarse de ninguna manera. Si no hay otras miniaturas amigas a 8” o menos del portador, el Pectoral de Shapesh no tiene efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colgante de Djaf" id="d4d2-50a9-dbd3-52b1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="66a7-de62-1093-8afc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2167-0335-2ce5-2f64" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Colgante de Djaf" id="7402-0223-1caa-37cf" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Si el personaje muere, antes de retirarlo como baja coloca la plantilla redonda grande centrada sobre él: las miniaturas enemigas bajo la plantilla sufrirán inmediatamente un impacto de F4 con las reglas especiales Ataques mágicos y Golpe letal; contra este efecto no puede utilizarse la regla ¡Cuidado, señor!</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello de invocación de Djedra" id="ffa1-a2f9-16e9-a70a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cdb6-398d-9f2a-42f2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2334-7afe-b3fd-6497" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sello de invocación de Djedra" id="34e7-9f23-535f-ca23" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Al inicio de cada una de tus fases de magia, elige una unidad amiga con la regla especial Constructo a 12” o menos del portador: dicha unidad restaura inmediatamente tantas heridas como se indica en su regla especial Constructo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
