      <rules>
        <rule name="Unión espiritual" id="ca5d-4ae6-5b50-e8e6" hidden="false">
          <description>La tirada de salvación total de los Caballeros de la necrópolis es de 3+, lo cual incluye el 5+ por la regla Constructo, su Armadura ligera y el bonificador de +1 por ser Caballería monstruosa.</description>
        </rule>
        <rule name="Armas encantadas" id="bd59-2f08-fc97-a2a1" hidden="false">
          <description>El proceso mágico que vincula el guardián con la necrosierpe también imbuye su arma con un gran poder. La Lanza de los caballeros y del Gran adalid tienen las reglas especiales Ataques mágicos y Golpe letal.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Caballeros de la necrópolis" id="69e6-4425-1b7a-3c89" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="c5b7-594e-89d9-cca8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="5"/>
