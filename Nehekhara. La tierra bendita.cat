                <profile id="7d53-cf20-20e7-fc10" name="Bastón de Tahoth" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia enemiga, tu oponente debe entregarte uno de sus dados de energía, que se convertirá en un dado de dispersión para ti durante esa fase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
