        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <rules>
        <rule name="Cacique de las arenas" id="348d-cdcb-9a1a-b627" hidden="false">
          <description>Obtiene la regla especial Don de Khsar, y obtiene un Arco, y un Corcel de Khsar como montura. No puede unirse a unidades que no sean de Jinetes de las Arenas</description>
        </rule>
        <rule name="Don de Ksar" id="9e03-2ca8-52fa-1869" hidden="false">
          <description>Los Jinetes de las arenas pueden repetir sus tiradas de huida y persecución. Además, obtienen las reglas especiales Disparo rápido y Carga devastadora (sólo jinetes). Ten en cuenta que no pueden tener Flechas áspid (sólo reciben bendiciones de Kshar). Ningún personaje puede unirse a una unidad de Jinetes de las Arenas a menos que posea la regla especial Don de Khsar.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Montura" id="1337-10c1-eacb-46e2" collective="false" hidden="false" import="true" type="upgrade">
