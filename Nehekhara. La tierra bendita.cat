    <selectionEntry id="0fde-de06-30db-ed95" name="Necrotecto nehekhariano" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="989b-a6c0-7aa7-aa9c" name="Ira del creador" hidden="false">
          <description>Todas las unidades con la regla especial Constructo amigas a 12” o menos del Necrotecto obtienen la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
        <rule id="193b-2f9b-9156-77e1" name="Forjador arcano" hidden="false">
          <description>Al inicio de cada uno de tus turnos, elige una unidad amiga con la regla especial Constructo a 12” o menos del Necrotecto: esta recupera inmediatamente las heridas indicadas en su regla especial Constructo.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="75f8-e2cc-5b23-5b30" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
