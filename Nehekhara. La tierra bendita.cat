    <selectionEntry id="1bdb-5a50-7427-db5b" name="Hierotitán" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="963c-2274-befd-9b5b" type="max"/>
      </constraints>
      <rules>
        <rule id="166c-cc11-faf6-177d" name="Magia Hierotitán" hidden="false">
          <description>Un Hierotitán es un hechicero de nivel 2 que siempre usa el Saber de la Antigua Nehekhara.</description>
        </rule>
        <rule id="351b-57d7-bce2-b803" name="Conducto espiritual" hidden="false">
          <description>Cada vez que un efecto de invocación fuera a restaurar heridas a una unidad amiga con la regla especial Constructo a 12” o menos de un Hierotitán, tira dos veces por cada dado y elige el resultado mayor.</description>
        </rule>
        <rule id="fa73-3484-ebef-f48d" name="Resistencia excepcional" hidden="false">
          <description>Cada vez que el Hierotitán fuese a recibir heridas por efecto de la regla especial Heridas múltiples, divide el número de heridas a la mitad (redondeando hacia arriba).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="5216-943d-6ffb-c0a3" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="d1b2-4ad4-ae8b-c4ad" name="Constructo" hidden="false" targetId="3ace-7252-bafe-b12c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="b329-6e09-4839-ad16" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
      </infoLinks>
      <categoryLinks>
