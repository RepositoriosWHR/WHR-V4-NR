    <selectionEntry id="c17c-f5ec-8d9c-8c60" name="Sumo sacerdote de Nehekhara" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="077c-357f-8e4f-478b" name="Cánticos de guerra Sumo sacerdote de Nehekhara" hidden="false">
          <description>Un Sumo Sacerdote conoce todos los Cánticos de guerra, y puede lanzar hasta dos de ellos por fase de magia con nivel de energía 5; además, puede dispersar hechizos como si fuese un hechicero de nivel 3.</description>
        </rule>
      </rules>
