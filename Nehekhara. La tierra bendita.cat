    <selectionEntry id="b215-a960-a0e6-5293" name="[E] - Sulaimán, Hechicero Real de Nehekhara" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f6f1-6a8e-106a-caf2" type="max"/>
      </constraints>
      <rules>
        <rule id="c4b8-205b-2636-791e" name="Magia Sulaimán, hechicero real de Nehekhara" hidden="false">
          <description>Sulaimán es una hechicero de nivel 4 que puede utilizar hechizos de los saberes del Fuego y/o de la Vida, y puede mezclar sus hechizos de entre ambos saberes.</description>
        </rule>
        <rule id="bf2c-1ce7-8435-4f7e" name="Respetado" hidden="false">
          <description>Todas las unidades amigas a 12” o menos de Sulaimán podrán repetir sus chequeos de pánico fallidos.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0cd2-95f2-5b43-3ec8" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule">
