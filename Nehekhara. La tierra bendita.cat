      </constraints>
      <rules>
        <rule id="912d-0034-08f4-368b" name="La guardia de Khsar" hidden="false">
          <description>La unidad de Jinetes de las Arenas que incluya a Ophiria sustituye su Oficial habitual por el Elegido de Khsar; se trata como un oficial en todos los aspectos (su coste ya está incluido en el coste de Ophiria).</description>
        </rule>
      </rules>
