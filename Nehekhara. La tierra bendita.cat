      </constraints>
      <selectionEntries>
        <selectionEntry id="31cf-55aa-6e68-146b" name="Ankhra Dorada" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d0f0-df2b-cd11-56fc" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2150-52a4-6c75-5a80" type="max"/>
          </constraints>
          <profiles>
            <profile id="1bb0-6a44-f19a-81bc" name="Ankhra Dorada" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene las reglas especiales Regeneración (4+) e Inmune al fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="b3cd-6d0d-c9a0-d4c6" name="Regeneración (4+)" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
