            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="7e02-8532-93f7-fca1" name="Pectoral de Shapesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="af24-4787-0d84-5eec" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1f8d-824d-2cde-88d1" type="max"/>
          </constraints>
          <profiles>
            <profile id="eb6d-66ac-2ba4-4d97" name="Pectoral de Shapesh" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cada vez que el portador fuese a sufrir una herida (tras las tiradas de salvación y regeneración pertinentes), tira 1D6: con un resultado de 1-3, la herida se asigna al personaje de manera habitual. Con un resultado de 4+, la herida se asigna en su lugar a una miniatura amiga de tu elección a 8” o menos del portador. Ten en cuenta que una herida reasignada no puede salvarse o evitarse de ninguna manera. Si no hay otras miniaturas amigas a 8” o menos del portador, el Pectoral de Shapesh no tiene efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d4d2-50a9-dbd3-52b1" name="Colgante de Djaf" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="66a7-de62-1093-8afc" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2167-0335-2ce5-2f64" type="max"/>
          </constraints>
          <profiles>
            <profile id="7402-0223-1caa-37cf" name="Colgante de Djaf" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Si el personaje muere, antes de retirarlo como baja coloca la plantilla redonda grande centrada sobre él: las miniaturas enemigas bajo la plantilla sufrirán inmediatamente un impacto de F4 con las reglas especiales Ataques mágicos y Golpe letal; contra este efecto no puede utilizarse la regla ¡Cuidado, señor! </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="ffa1-a2f9-16e9-a70a" name="Sello de invocación de Djedra" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cdb6-398d-9f2a-42f2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2334-7afe-b3fd-6497" type="max"/>
          </constraints>
          <profiles>
            <profile id="34e7-9f23-535f-ca23" name="Sello de invocación de Djedra" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Al inicio de cada una de tus fases de magia, elige una unidad amiga con la regla especial Constructo a 12” o menos del portador: dicha unidad restaura inmediatamente tantas heridas como se indica en su regla especial Constructo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="0838-70a4-088e-def1" name="Talismanes mágicos. Reliquias. Nehekhara. La tierra bendita. Rey sacerdote" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="db4f-ec32-f886-6bcb" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7885-0814-65bf-e222" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="e4bc-0094-8960-827a" name="Corona de los Reyes" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cc1c-b370-5571-96e2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5434-f113-92e6-732f" type="max"/>
          </constraints>
          <profiles>
            <profile id="88c7-7565-1dd6-786d" name="Corona de los Reyes" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo Rey Sacerdote. Proporciona a su portador Resistencia mágica (2). Además, al inicio de cada fase de combate cuerpo a cuerpo (propia o del oponente), puedes seleccionar una unidad amiga a 12” o menos del portador: todos los miembros de la unidad obtendrán un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo durante esa fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8d1f-3c28-21eb-2cd8" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
          <entryLinks>
            <entryLink id="31a8-6956-4b7e-44b9" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="4f30-1dfb-9270-0af7" name="Talismanes mágicos. Reliquias. Nehekhara. La tierra bendita" hidden="false" collective="false" import="true">
      <constraints>
