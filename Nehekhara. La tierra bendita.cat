        <constraint id="1b69-ef3e-8bc9-f5be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Tablilla de los Poderosos Cánticos de Neferra" id="a0a6-3adb-9dfd-ee33" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a80e-79ee-8b62-e9a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="28fa-af2b-fdf7-7485" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="5932-3105-2329-f5b1" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Tablilla de los Poderosos Cánticos de Neferra" id="3646-fdd2-70f0-9bcb" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador intente lanzar o dispersar un hechizo, puede repetir la tirada de uno de sus dados de energía o dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo de las Plagas" id="a31b-237d-b71e-f84d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="206a-e43d-c659-b177" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="86da-f4d7-9e0f-2a16" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="70"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="d4e8-5a1b-69f7-90df" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Báculo de las Plagas" id="8ebe-d198-4af7-97f6" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, Nivel de energía 5. Contiene un hechizo de daño directo que toma como objetivo a una única unidad enemiga a 18” o menos del portador. El hechizo causa 7D6 impactos de F1 que no permiten tirada de salvación por armadura. Cualquier unidad que sufra al menos una baja por efecto de este hechizo deberá realizar inmediatamente un chequeo de pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Nehekhara. La tierra bendita" id="d6ad-6acb-90be-07f4" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ab02-0bae-7808-ba11" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="94dd-fa40-b1d8-1221" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Vaso Hierático" id="e06e-8aa8-f96d-e2e8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2ea3-33c8-f409-3528" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2cee-3205-ac5b-431e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vaso Hierático" id="b588-281b-c765-5013" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El sacerdote puede utilizar el Vaso Hierático durante cualquiera de sus fases de magia, para lanzar uno de sus hechizos sin invertir ningún dado de energía. El hechizo será lanzado a su nivel básico de dificultad, y podrá ser dispersado normalmente. No es posible lanzar la versión potenciada de un hechizo con este objeto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cánope de Enkhil" id="af89-c293-0ccb-c158" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fdfd-31ae-ee33-bf93" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f0c6-4065-4de1-4e5f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cánope de Enkhil" id="185d-460a-c407-97bf" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de maldición que afecta a todos los hechizos enemigos que permanecen en efecto o permanecen un turno en el campo de batalla. Si el hechizo se resuelve exitosamente, todos esos hechizos quedan inmediatamente dispersados y su efecto cesa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo de la Maestría" id="4bd4-6ae1-ad12-70f7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2ad6-a5ad-9c1c-e12d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1cc0-87ab-5d9b-290f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo de la Maestría" id="e8e7-ad4e-57b5-36ed" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador siempre canaliza dados de energía o dispersión con un resultado de 2+, sin tener en cuenta otros modificadores.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El Báculo de Usirian" id="26e7-1593-4ed6-72b9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4d05-78c5-7bad-1d29" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7035-0d2f-8e5d-16a3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El Báculo de Usirian" id="7ee4-482f-6061-cae7" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de Daño directo. Traza una línea recta de 18” desde el lanzador. Cualquier miniatura bajo esa línea sufrirá un impacto de Fuerza 6 con la regla especial Golpe letal. Cualquier unidad que sufra al menos una baja como resultado de este hechizo deberá efectuar de inmediato un chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Nehekhara. La tierra bendita. Sacerdotes" id="d847-6165-3935-78bd" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="41e0-9ffd-8a6a-b750" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
