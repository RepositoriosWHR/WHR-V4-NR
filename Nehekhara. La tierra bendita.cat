    <selectionEntry id="f7cf-4d1f-4a34-589c" name="Sacerdote del culto funerario" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="f146-5c12-9fa7-4650" name="Magia Sacerdote del culto funerario" hidden="false">
          <description>Nivel de magia 1. Puede aumentarse a nivel de magia 2 por +30 puntos. Puede elegir hechizos del Saber de la Antigua Nehekhara, del Saber de la Muerte y/o del Saber de la Luz.</description>
        </rule>
      </rules>
