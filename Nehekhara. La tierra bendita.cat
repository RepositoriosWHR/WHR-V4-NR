              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo Rey Sacerdote. Armas emparejadas. El portador tendrá un bonificador de +1 a su Fuerza en combate cuerpo a cuerpo, y luchará con Iniciativa 10.</characteristic>
              </characteristics>
            </profile>
