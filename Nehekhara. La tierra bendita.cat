    <profile id="dd14-df5f-e853-d282" name="Látigo de necrotecto" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Arma adicional (+1A), Combate desde atrás: Pese a ser un personaje, el Necrotecto puede situarse en la segunda fila de una unidad y atacar desde allí como si su peana fuese la peana de la miniatura situada inmediatamente delante de la suya.</characteristic>
