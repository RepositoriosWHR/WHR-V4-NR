          <profiles>
            <profile name="Corona de los Reyes" id="88c7-7565-1dd6-786d" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo Rey Sacerdote. Proporciona a su portador Resistencia mágica (2). Además, al inicio de cada fase de combate cuerpo a cuerpo (propia o del oponente), puedes seleccionar una unidad amiga a 12” o menos del portador: todos los miembros de la unidad obtendrán un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo durante esa fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
