                <rule name="Potencia de unidad 4" id="8e0e-5a7a-8d96-8635" hidden="false"/>
                <rule name="Khalida" id="d10e-3b60-6553-136d" hidden="false">
                  <description>Khalida forma parte del Carro Real, y no se considera un personaje. Además, al inicio de cada uno de tus turnos, el Carro Real recupera una herida que hubiese sufrido previamente durante la batalla.</description>
                </rule>
                <rule name="El carro del Rey" id="6dbd-1158-4e55-7113" hidden="false">
                  <description>Todas las unidades con la clave TIERRA BENDITA a 12” o menos del Carro Real (incluyendo el propio Carro Real) obtienen un bonificador extraordinario de +1 al resultado del combate.</description>
                </rule>
              </rules>
