    <selectionEntry name="[Ex] - Titán de Khemri" id="304c-f2e7-8f73-485d" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="d54e-c0ed-cabc-5c04" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
