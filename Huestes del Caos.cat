          <rules>
            <rule id="82ea-d491-c2d4-1112" name="Marca de caos absoluto. Kholek" hidden="false">
              <description>Al inicio de la batalla efectúe una tirada en la tabla de Ojo de los dioses, el cual puedes repetir, y aplica el resultado a Kholek durante la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
        </entryLink>
