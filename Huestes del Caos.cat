            <profile id="15b3-244e-0c0d-6190" name="Tatuajes impíos" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene la regla especial Aura demoníaca (4+). Sin embargo, se verá afectado por aquellos objetos mágicos, hechizos o reglas especiales que afecten especialmente a demonios o lo hagan de forma aumentada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="255e-da87-51ed-7398" name="Aura demoníaca (4+)" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule"/>
