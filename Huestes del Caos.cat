      <selectionEntries>
        <selectionEntry id="c58c-4ca7-5858-01da" name="Pabellón de la ira" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="dd4c-c414-361a-2bb7" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="11cb-98d3-92f5-b89a" type="max"/>
          </constraints>
          <profiles>
            <profile id="755b-5a23-8206-7cf7" name="Pabellón de la ira" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con la Marca de Khorne. El portador y su unidad no perderán la regla especial Furia asesina como resultado de perder un combate cuerpo a cuerpo. Todos los hechiceros en contacto con el portador o su unidad tirarán 1D6 adicional cada vez que sufran una Disfunción mágica y tú eliges qué dado descartan.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
