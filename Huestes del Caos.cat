            <profile id="4316-b3be-eb87-8ff5" name="Gran foco de Khorne" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Sólo Heraldos de Khorne. Si el Heraldo dispone de un Foco demoníaco, su efecto se aplicará a todas las unidades con la regla especial Demonio (Khorne) a 12” o menos del Heraldo de Khorne.</characteristic>
              </characteristics>
            </profile>
