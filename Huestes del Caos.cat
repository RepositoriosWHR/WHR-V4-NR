            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6c56-fd7e-8ced-09b0" type="max"/>
          </constraints>
          <profiles>
            <profile id="2039-a128-9063-050a" name="Símbolo blasfemo" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas amigas situadas a 12” del portador tendrán un bonificador de +1 en sus tiradas para Canalizar.</characteristic>
              </characteristics>
