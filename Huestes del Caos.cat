                <characteristic name="H" typeId="5723232344415441232323">6</characteristic>
                <characteristic name="I" typeId="4923232344415441232323">2</characteristic>
                <characteristic name="A" typeId="4123232344415441232323">5</characteristic>
                <characteristic name="L" typeId="4c4423232344415441232323">7</characteristic>
                <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
                <characteristic name="TSE" typeId="576172645361766523232344415441232323"/>
                <characteristic name="Tipo" typeId="5479706523232344415441232323">Monstruo</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="0700-58de-b780-ab0c" name="Múltiples lenguas" hidden="false">
              <description>Cuenta con un ataque de disparo con sus múltiples lenguas, con un alcance de 12”, Fuerza 5 y las reglas especiales Disparo rápido y Disparos múltiples (3). Por último, al inicio de cada uno de tus turnos, el Gran gusano de plaga restablece una de las heridas que hubiese sufrido con anterioridad durante la batalla.</description>
            </rule>
            <rule id="c66e-7434-df9b-4789" name="Gran gusano de plaga" hidden="false">
              <description>Orghotts monta sobre un Gran gusano de plaga, que es un monstruo que tiene las reglas especiales Ataques envenenados, Protección por montura (1) y Regeneración (5+). Por último, al inicio de cada uno de tus turnos, el Gran gusano de plaga restablece una de las heridas que hubiese sufrido con anterioridad durante la batalla.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="d0c0-d2a7-e66a-358b" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
            <infoLink id="70f0-f200-630b-b87b" name="Protección por montura (1)" hidden="false" targetId="1f9d-b34a-3d89-add6" type="rule"/>
            <infoLink id="2fb7-bf15-1f8b-a092" name="Regeneración (5+)" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
            <infoLink id="8b8c-dd17-3b4a-40f4" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink id="679c-dfa8-576b-c30f" name="Disparo rápido" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(Múltiples lenguas)"/>
              </modifiers>
            </infoLink>
            <infoLink id="b8bf-d7bd-9751-227a" name="Disparos múltiples (3)" hidden="false" targetId="37f9-b9ff-09a3-3dba" type="rule">
