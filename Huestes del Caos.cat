                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule id="ae37-b6d1-d120-2080" name="Marca del caos absoluto. Caballeros del Caos" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="6adc-f96b-2c62-086a" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="4a5f-743b-0e07-0698" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
