      </constraints>
      <rules>
        <rule id="ae9d-a55b-efd7-152d" name="Campeón de los poderes ruinosos" hidden="false">
          <description>Enrinsorga tiene la regla especial Ojo de los dioses, aunque deberás considerar los resultados de 2 como si fuesen 3.</description>
        </rule>
        <rule id="9b7e-d037-6a56-27bb" name="Fortaleza inquebrantable" hidden="false">
          <description>Los resultados naturales de 1, 2 y 3 en las tiradas para herir contra Enrinsorga siempre se consideran un fallo.</description>
        </rule>
      </rules>
