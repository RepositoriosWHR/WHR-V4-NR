    <selectionEntryGroup id="f12a-a146-8864-b2c8" name="[BC] - Recompensas menores - Hechiceros - Bestias del Caos" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="f749-625b-9d86-37ef" name="Hemónculo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="75da-c7c3-5737-11b2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="86df-1fc0-96f7-1adc" type="max"/>
          </constraints>
          <profiles>
            <profile id="b9db-7fd3-1f59-d637" name="Hemónculo" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo hechiceros. Una vez por fase de magia, tras haber lanzado los dados para lanzar un hechizo, el hechicero puede declarar que utiliza al hemónculo para aumentar el valor de su tirada de lanzamiento en +1D3. Si lo hace, sufrirá Estupidez durante su siguiente turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="6c10-25e7-f92a-1576" name="Estupidez" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
          </infoLinks>
