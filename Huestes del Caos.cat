        <selectionEntryGroup id="dd57-23e3-3918-d747" name="Marcas del Caos" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1cbb-b648-cabf-2b89" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5709-5cfd-a245-9a71" type="min"/>
          </constraints>
          <entryLinks>
            <entryLink id="0888-3b04-7ae9-458b" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <rules>
                <rule id="ecda-8370-5f96-bbe3" name="Marca del Caos absoluto. Chamán del rebaño" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (6+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="1650-f4bb-a3eb-4011" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="4b85-aef9-4be0-4320" name="Piel escamosa (6+)" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="30e9-c7d0-c1e8-5927" name="[BC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="824e-e35c-ef47-ee81" type="selectionEntry">
              <rules>
                <rule id="5c66-0089-6982-2f74" name="Marca de Tzeentch. Chamán del rebaño" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f0d8-782f-a9dc-af8e" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="e475-0bb2-f660-b1e0" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <rules>
                <rule id="1537-27e6-9ebb-b5ff" name="Marca de Nurgle. Chamán del rebaño" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d27c-29c6-b0b0-a4a5" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
