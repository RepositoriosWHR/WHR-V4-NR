    <selectionEntry id="be6f-840d-3cb6-7cbe" name="[H][BC] - Escuerzo Alado" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="74e6-b415-e85b-d78e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="e017-8f2a-fcc2-d49c" type="max"/>
      </constraints>
      <rules>
        <rule id="7035-c30c-abce-4dcd" name="Lengua prensil" hidden="false">
          <description>Se considera un ataque de disparo (puede disparar incluso aunque haya marchado) de alcance 12” con las reglas especiales Francotirador, Disparo rápido y Golpe letal y se resuelve con Fuerza 5.</description>
        </rule>
        <rule id="4ffd-ed28-6b1e-55bb" name="Aura de locura" hidden="false">
          <description>Todas las miniaturas enemigas a 8” o menos de un Escuerzo alado realizarán sus chequeos de Liderazgo tirando 3D6 y descartando el resultado menor  (este efecto se anula mutuamente con la regla especial Sangre fría).</description>
        </rule>
        <rule id="a3c4-0f43-a447-1eeb" name="Sangre ácida" hidden="false">
          <description>Cada vez que un Escuerzo alado sufra una herida en cuerpo a cuerpo, el causante de esa herida sufre un impacto automático de Fuerza 5 que no permite tirada de salvación por armadura.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0762-d24e-24c6-3a31" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink id="f89f-52a1-d858-1485" name="Volar (9)" hidden="false" targetId="8bfa-11eb-3e8e-c083" type="rule"/>
