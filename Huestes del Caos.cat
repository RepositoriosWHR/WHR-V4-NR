          <entryLinks>
            <entryLink id="5868-4fd3-96d0-209f" name="[K] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="c752-a5a1-2916-2861" type="selectionEntry">
              <rules>
                <rule id="ac8d-1478-3fcd-80b9" name="Marca de Caos absoluto catapulta de asedio kurgan" hidden="false">
                  <description>Se trata de un disparo normal de catapulta con la regla especial Ataques mágicos; los chequeos de pánico provocados por la catapulta deberán efectuarse con 3D6 y descartando el resultado menor.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="d05e-8f86-654e-7da5" name="[K] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="efd6-29ad-5411-f88d" type="selectionEntry">
              <rules>
                <rule id="7f1d-381d-6ddd-410a" name="Marca de Nurgle catapulta de asedio kurgan" hidden="false">
                  <description>Utiliza la plantilla redonda grande, y se resuelve con F2 y no permite tirada de salvación por armadura (no tiene impacto central diferenciado).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="a4ae-de42-1168-c640" name="[K] - Marca de Slaanesh. Unidades" hidden="false" collective="false" import="true" targetId="03a4-f8dd-240e-db15" type="selectionEntry">
              <rules>
                <rule id="7d5e-b6d3-aae5-d0a2" name="Marca de Slaanesh catapulta de asedio kurgan" hidden="false">
                  <description>Utiliza la plantilla redonda pequeña, y se resuelve con F4 y la regla especial Golpe letal (F6, Golpe letal y Heridas múltiples 1D3 el impacto central).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="602e-6ee5-9781-e2cb" name="[K] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="1ece-3ae2-4827-ca23" type="selectionEntry">
              <rules>
                <rule id="0fb6-f221-a919-29c4" name="Marca de Tzeentch catapulta de asedio kurgan" hidden="false">
                  <description>Utiliza la plantilla redonda grande, y se resuelve con F1D6, Ataques flamígeros y Poder de penetración (no tiene impacto central diferenciado).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="938c-ed7d-60fb-36e2" name="[K] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="5194-ed02-bc34-8b2c" type="selectionEntry">
              <rules>
                <rule id="9201-e371-5c60-6501" name="Marca de Khorne catapulta de asedio kurgan" hidden="false">
                  <description>Utiliza la plantilla redonda pequeña, y se resuelve con F5 (F10 y Heridas múltiples [1D6] el impacto central).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
          </entryLinks>
