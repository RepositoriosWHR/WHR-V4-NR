          <selectionEntries>
            <selectionEntry id="2868-ba7c-9047-b55c" name="Matareyes" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="802f-e070-16db-fe57" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1afa-d453-e3a4-e960" type="min"/>
              </constraints>
              <profiles>
                <profile id="bf70-630e-9351-2fac" name="Matareyes" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados por Matarreyes no permiten tirada de salvación por armadura. Al inicio de cualquier fase de combate cuerpo a cuerpo, Archaón puede liberar el poder del demonio en el interior de la espada: a partir de entonces, duplica el número de Ataques que realiza, pero todos los resultados de 1 en sus tiradas para impactar se resolverán contra el propio Archaón o uno de sus Espadas del Caos (a tu elección).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="afe0-6d43-18fd-62c7" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
