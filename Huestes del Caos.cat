      </constraints>
      <rules>
        <rule id="61bd-f90e-e25a-1ef7" name="Marcado por los dioses" hidden="false">
          <description>Mordrek no puede unirse a unidades ni ser el General del ejército.</description>
        </rule>
        <rule id="8a18-7093-3a91-d569" name="Marca del caos absoluto" hidden="false">
          <description>Permite repetir sus tiradas de salvación por armadura fallidas.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6acb-c660-a96a-d8e1" name="Caballería" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
        <infoLink id="1cc2-1279-a6ba-5f79" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
