    <selectionEntry id="4c1a-ed0b-979f-6dfa" name="[H][GC] - Malditos del Caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="52d8-61ba-944c-e771" type="max"/>
      </constraints>
      <rules>
        <rule id="6dc2-61fc-a05a-6565" name="Mutaciones del caos" hidden="false">
          <description>Al inicio de la batalla, tira 1D6 en la siguiente tabla y aplica el resultado a la unidad de Malditos del Caos durante toda la batalla.
1D6 Mutaciones del Caos
1 Veneno demoníaco: Obtienen la regla especial Ataques envenenados.
2 Piel de acero: Obtienen la regla especial Piel escamosa (6+).
3 Esencia demoníaca: Obtienen la regla especial Aura demoníaca (5+).
4 Ímpetu feroz: Obtienen la regla especial Carga devastadora.
5 Furia salvaje: Obtienen la regla especial Tozudez y no perderán su Furia asesina aunque sean derrotados en combate. 
6 Garras cercenadoras: Obtienen la regla especial Golpe letal.</description>
        </rule>
      </rules>
      <infoLinks>
