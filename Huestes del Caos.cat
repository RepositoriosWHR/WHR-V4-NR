      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cbe4-0e8f-4506-9f34" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="61c5-e6f9-58ae-9129" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="639e-9dae-1956-48a3" name="Machete infeccioso" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9354-ee37-3b31-b092" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="fa0f-c247-e76c-4545" type="max"/>
          </constraints>
          <profiles>
            <profile id="8953-0e6f-25c6-716f" name="Machete infeccioso" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la Marca de Nurgle. Arma de mano. Los ataques realizados con este arma se resuelven con las reglas especiales Ataques envenenados y Poder de penetración. Además, el portador podrá repetir las tiradas fallidas para herir al atacar con este arma.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="b8c3-3715-a6b7-fa70" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink id="bcfc-12b5-b0eb-ec6f" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="eaee-981a-b1a4-b0b7" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="4ebb-770d-5a21-f5b7" name="[K] - Armas mágicas. Kurgan. Slaanesh. Arma de mano" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d494-0f63-91f8-0560" type="max"/>
