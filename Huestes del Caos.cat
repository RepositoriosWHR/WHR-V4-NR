      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9078-e093-5a38-d663" type="max"/>
      </constraints>
      <rules>
        <rule id="ff08-36da-5842-c408" name="Estilo de lucha de los Kul" hidden="false">
          <description>Al inicio de cada ronda de combate cuerpo a cuerpo, Crom puede elegir luchar con Armas emparejadas o con Arma de mano y Escudo (puede cambiar de armamento una vez el combate se ha iniciado; esta es una excepción a las reglas habituales): 
- Si lucha con Armas emparejadas, obtiene +1 Ataque por luchar con Armas emparejadas, así como un bonificador de +1 para impactar en cuerpo a cuerpo y la regla especial Golpe letal. 
- Si lucha con Arma de mano y Escudo, obtiene un bonificador a su tirada de salvación por Parada de +2 en lugar del +1 habitual. Además, anula los efectos de cualquier Arma mágica que tuviesen los enemigos que lo ataquen (pasarán a considerarse armas mundanas de su mismo tipo durante esa ronda de combate cuerpo a cuerpo).</description>
        </rule>
        <rule id="29a1-3d30-e542-183d" name="Guerreros kul" hidden="false">
          <description>La unidad de Guerreros del Caos que acompañe a Crom puede repetir sus tiradas para impactar fallidas en cuerpo a cuerpo.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="fb9d-5bbc-8096-daef" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
        <infoLink id="1b6d-fd68-e292-1ff1" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
