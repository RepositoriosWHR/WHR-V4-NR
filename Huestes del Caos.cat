    <selectionEntryGroup id="4725-27a9-a9f5-77da" name="[BC] - Recompensas menores - Slaanesh" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="2694-def1-220e-5019" name="Almizcle soporífero" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a519-8c54-ea35-a96b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="21e6-ef40-6d05-bf27" type="max"/>
          </constraints>
          <profiles>
            <profile id="6b0b-77cc-9100-ed8e" name="Almizcle soporífero" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Todas las miniaturas enemigas en contacto peana con peana con el personaje verán su Habilidad de armas e Iniciativa reducidas a la mitad (redondeando fracciones hacia arriba).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="daed-d486-e640-1879" name="Don de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3921-f052-a88b-1a32" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="066e-1b76-fe7c-0788" type="max"/>
          </constraints>
          <profiles>
            <profile id="a054-9e82-16f7-8a67" name="Don de Slaanesh" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje puede realizar dos ataques adicionales en combate cuerpo a cuerpo, que se resolverán con su valor de Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
