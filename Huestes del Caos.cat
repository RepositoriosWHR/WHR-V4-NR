              </modifiers>
              <rules>
                <rule id="48d5-7100-dc2a-6181" name="Marca de Caos absoluto. Bersekers Kurgan" hidden="false">
                  <description>Al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
