                <profile id="71ac-91cd-4c24-839a" name="Armadura carmesí" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. Todos los impactos contra Valkia deberán resolverse con un penalizador de -1 a su Fuerza (esto no afecta a impactos sin un valor de Fuerza). Además, otorga a Valkia una tirada de salvación especial de 5+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="0245-0cb3-6749-c705" name="Armadura del Caos" hidden="false" targetId="120a-7fef-0a46-77f1" type="profile"/>
