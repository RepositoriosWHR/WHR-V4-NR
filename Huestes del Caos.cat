            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ddee-f7d2-c3ed-13cb" type="max"/>
          </constraints>
          <profiles>
            <profile id="f120-14d1-2161-cd5e" name="Látigo del tormento" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la marca de Slaanesh. Arma de mano. Los impactos causados por este arma se resuelven con la regla especial Poder de Penetración. Además, el portador lucha siempre en combate cuerpo a cuerpo como si tuviese una Iniciativa no modificable de 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4bcb-5a31-394e-5c44" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
            <infoLink id="a947-b5c7-8f22-5526" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
