    <selectionEntry id="6d61-9408-9081-e2b7" name="[H][BC] - Gran Chamán del rebaño" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="74e6-b415-e85b-d78e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="6a7b-a9fd-3a3f-75a5" name="Magia Gran chamán del rebaño" hidden="false">
          <description>Es un hechicero de nivel 3. Puede convertirse en hechicero de nivel 4 por +55 puntos. Puede elegir sus hechizos de entre los Saberes de la Muerte, de las Bestias, de las Sombras, de Magia Oscura y/o del Saber de su Dios del Caos y puede elegir sus hechizos de dos o más de los saberes listados.</description>
        </rule>
      </rules>
