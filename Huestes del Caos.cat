              </modifiers>
              <rules>
                <rule id="2bf7-fb28-2e5f-068a" name="Marca de Caos absoluto. Jinetes Kurgan" hidden="false">
                  <description>Al inicio de la batalla, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a la unidad toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
