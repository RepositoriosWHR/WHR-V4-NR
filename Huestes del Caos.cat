        <selectionEntry id="fb31-6277-5139-8c67" name="Viento del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e965-00a9-896f-0367" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="19dd-14bf-9df3-15b9" type="max"/>
          </constraints>
          <profiles>
            <profile id="5a6c-f53d-07b4-ed79" name="Viento del Caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Los Vientos del Caos disparan como un Lanzallamas (puede disparar aunque el personaje mueva o marche) que puede estimar hasta 3 dados. Se resuelve con Fuerza 8, tira para herir contra el Liderazgo del objetivo en lugar de contra su Resistencia y no permite tirada de salvación por armadura; cualquier unidad que sufra al menos una baja por esto deberá realizar inmediatamente un chequeo de Pánico. Si obtienes un resultado de Problemas, el disparo simplemente no se realiza (no tires en la tabla de Problemas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
