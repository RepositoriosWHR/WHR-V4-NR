    </selectionEntry>
    <selectionEntry id="3c75-b3a9-a3fd-43c7" name="[K] - Los merodeadores" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b297-6f31-c6cc-3fc5" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ee33-62ad-1e2a-359a" type="max"/>
      </constraints>
      <rules>
        <rule id="55b9-dc44-9045-13f6" name="Los merodeadores" hidden="false">
          <description>Los Merodeadores son Inmunes a fuego. Al inicio de la batalla, tras el despliegue, tira 1D6 en la siguiente tabla y aplica el resultado a Volrik y a su unidad durante la batalla.
1D6 	Bendición de los Merodeadores
1 	Causan Miedo.
2 	Obtienen la regla especial Resistencia mágica (2).
3 	Obtienen las reglas especiales Inmunes a la psicología e Impasibles.
4 	Obtienen la regla especial Piel escamosa (6+).
5 	Obtienen un bonificador de +1 a su atributo de Fuerza.
6 	Obtienen una tirada de salvación especial de 5+.</description>
        </rule>
      </rules>
      <costs>
        <cost name="pts" typeId="points" value="0.0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="d915-4e8a-5eec-86f3" name="[K] - Mamut del Caos" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="b63d-301d-5a74-66c0" value="2">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="170b-06ad-215f-f891" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
