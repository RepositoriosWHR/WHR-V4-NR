    <selectionEntry id="b469-5ae7-e872-6b74" name="[H][GC] - Engendro monstruoso del Caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="5c1d-13b3-e97a-e4d3" type="max"/>
      </constraints>
      <rules>
        <rule id="2e1b-badb-9e18-4394" name="Vástago del caos" hidden="false">
          <description>Determina al inicio de la batalla (antes del despliegue) los atributos de HA, F, R, H e I del Engendro monstruoso del Caos. Además, tira una vez en la siguiente tabla para determinar los efectos adicionales de las mutaciones del Engendro monstruoso del Caos:
1D6 Vástago del Caos
1 Ataques envenenados
2 Piel escamosa (4+)
3 Arma de aliento de Fuerza 1D6 
4 Resistencia mágica (3)
5 Golpe letal
6 Regeneración (4+)</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="7f82-61a2-18d0-85b4" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink id="8fdf-d9a9-8f2b-c966" name="Aura demoníaca (5+)" hidden="false" targetId="e5ed-5149-3d72-6aa4" type="rule"/>
        <infoLink id="dfa1-0b01-67e9-0023" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="739d-e2dd-42e4-e7ca" name="Movimiento aleatorio (3D6)" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
        <infoLink id="ecec-cdc7-f97c-ed3f" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(2D6+2)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
