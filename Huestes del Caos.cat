          <entryLinks>
            <entryLink id="2fb7-2d2f-d25b-5b5d" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="2">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="1684-e96a-98fd-e4a6" name="Marca de Tzeentch. Guerreros del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="3828-d7c8-3421-2e63" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
