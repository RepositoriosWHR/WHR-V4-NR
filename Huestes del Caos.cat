        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0fdd-f156-e42b-ef93" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5033-e041-e1d8-5c14" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="eb8f-e1e6-9d4c-a90b" name="Mandoble berserker" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b6a1-352c-91d0-969e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1597-b12f-bcb7-720a" type="max"/>
          </constraints>
          <profiles>
            <profile id="1b2d-f947-3846-560d" name="Mandoble berserker" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Cada vez que el portador ataque en combate cuerpo a cuerpo, puede efectuar 1D6 ataques adicionales (tira cada vez que el portador vaya a atacar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="3ce0-11c1-b40c-0c0b" name="Arma a dos manos" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="65.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="c75a-9989-4902-630f" name="Hacha de la destrucción" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9b9b-e5a8-bc73-219b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f00e-5dc3-1449-6275" type="max"/>
          </constraints>
          <profiles>
            <profile id="961c-2f2c-cc28-29a6" name="Hacha de la destrucción" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Las heridas causadas por este arma no permiten tirada de salvación por armadura. Además, contra miniaturas de los ejércitos de las Fuerzas del Orden sus impactos se resuelven con la regla especial Heridas múltiples 
(1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="91e9-e843-c833-0cf8" name="Heridas múltiples (1D3)" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
            <infoLink id="5bdd-2ceb-37ae-7502" name="Arma a dos manos" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="f3ad-40e6-7946-c17a" name="[K] - Artefactos arcanos. Kurgan" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1955-9f0b-20e0-41c1" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2f0c-a64a-4842-a01a" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="e648-0b7f-d8a5-afb7" name="Familiar del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2e8d-b0b0-f8e9-efa3" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d7fc-11fa-fb82-80b6" type="max"/>
          </constraints>
          <profiles>
            <profile id="b7ac-de74-2b4c-ffdb" name="Familiar del Caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="dcc2-10a0-832e-5a8b" name="Cetro de la gran bestia del norte" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="77fb-9229-9ea1-86ef" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d2a7-b21e-8cac-0a57" type="max"/>
          </constraints>
          <profiles>
            <profile id="a97e-3c10-2433-2741" name="Cetro de la gran bestia del norte" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene el hechizo Forma salvaje de Wyssan, del Saber de las Bestias.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f5c8-4522-8b55-70ba" name="Vara demoníaca" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8c2a-e49e-d88c-8339" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="bc63-ef38-2d2a-dbb5" type="max"/>
          </constraints>
          <profiles>
            <profile id="304b-939a-71b8-42b9" name="Vara demoníaca" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador conoce un hechizo adicional; además, le proporciona un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1487-70c0-2b60-fb2c" name="Orbe de piedra divina" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5158-2ae5-5af3-ed69" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8448-0bd5-73f5-5bc5" type="max"/>
          </constraints>
          <profiles>
            <profile id="06bb-0696-fb73-7d6d" name="Orbe de piedra divina" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador vaya a lanzar un hechizo, puede elegir generar un dado de energía adicional (usa un dado de color diferente) y tirarlo junto a los dados que desee para lanzar ese hechizo (debe gastar por lo menos un dado). Sin embargo, si en el dado adicional obtiene un resultado de 1, el portador sufre una herida automática sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="e5cd-a201-71f6-b08d" name="[K] - Estandartes mágicos. Kurgan" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b313-2ee9-22ac-1c19" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a360-eaae-a0ec-9f22" type="min"/>
