            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="75a8-497b-f44b-0508" type="max"/>
      </constraints>
      <rules>
        <rule id="3538-5475-2796-15a6" name="Marca del elegido" hidden="false">
          <description>La Marca del Elegido cuenta como las Marcas de los cuatro Dioses del Caos y otorga a Archaón los siguientes beneficios: Resistencia mágica (3), Indesmoralizable, -1 para impactarle en disparo, -1 HA a los enemigos en contacto, Ataques envenenados, Inmune a veneno, Ataques flamígeros, Ataques mágicos, +1 a lanzar hechizos y nivel de magia 2 (Saber de Tzeentch).</description>
        </rule>
        <rule id="89ee-cf54-2742-2fb1" name="Magia Archaón" hidden="false">
          <description>Saber de Tzeentch</description>
        </rule>
        <rule id="9571-c03e-85f0-904e" name="Señor del fin de los tiempos" hidden="false">
          <description>La regla especial Presencia inspiradora de Archaón tiene un alcance de 18” en lugar de las 12” habituales.</description>
        </rule>
      </rules>
      <infoLinks>
