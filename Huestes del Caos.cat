              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Proporciona a su portador la regla especial Piel escamosa (6+, +1 si ya disponía de ella), que puede combinarse con armaduras de la forma habitual. Además, otorga a su portador Resistencia mágica (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
