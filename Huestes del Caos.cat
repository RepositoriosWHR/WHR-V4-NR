      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6a1c-efcd-b650-a152" type="max"/>
      </constraints>
      <rules>
        <rule id="3a3d-a647-a7fe-6a0c" name="Ansia de sangre" hidden="false">
          <description>Los Cosechadores de Khorne nunca pueden perseguir ni arrasar (pese a tener Furia asesina), sólo Reorganizarse.</description>
        </rule>
        <rule id="7279-e25e-4600-7a5f" name="Golpe descuartizador" hidden="false">
          <description>Los ataques en combate cuerpo a cuerpo de los Cosechadores de Khorne se resuelven con la regla especial Heridas múltiples (1D3).</description>
        </rule>
        <rule id="9a8b-1116-fa91-9838" name="Mole inmensa" hidden="false">
          <description>Los Cosechadores tienen Potencia de unidad 4 y tamaño Muy 
grande.</description>
        </rule>
        <rule id="43ee-25b2-1f66-5476" name="Furia infinita" hidden="false">
          <description>Los Cosechadores de Khorne no perderán su Furia asesina aunque sean derrotados en combate.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="670c-aeff-b367-3410" name="Piel escamosa (3+)" hidden="false" targetId="f3fe-4c6e-197e-832f" type="rule"/>
