          <entryLinks>
            <entryLink id="30b1-6997-1853-6721" name="[K] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="c752-a5a1-2916-2861" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="5">
                  <repeats>
                    <repeat field="selections" scope="004c-1eea-8110-adba" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3f94-e01c-0388-8348" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="ab13-7dce-8d45-1f35" name="Marca de Caos absoluto. Carros de guerra Kurgan" hidden="false">
                  <description>Obtiene la regla especial Inmune a psicología. Además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado al carro toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="4518-0d6f-7ea4-4fe2" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="ef21-a2a0-9951-6372" name="[K] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="efd6-29ad-5411-f88d" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="10">
                  <repeats>
                    <repeat field="selections" scope="004c-1eea-8110-adba" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3f94-e01c-0388-8348" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="ea25-9272-3416-2a4d" name="Marca de Nurgle. Carros de guerra Kurgan" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
