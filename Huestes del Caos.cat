        <entryLink id="3ead-c3a8-8f37-5f53" name="[K] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="cd4c-32a7-97a6-4d64" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="09d6-f852-c7a5-e63a" type="min"/>
          </constraints>
          <rules>
            <rule id="03e9-cee8-ad07-6bc8" name="Marca de Caos absoluto. Wulfrik" hidden="false">
              <description>Le otorga la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto a Wulfrik toda la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink id="9df3-cc02-0a87-84db" name="Saga (Wulfrik)" hidden="false" collective="false" import="true" targetId="2de4-b288-60a9-b386" type="selectionEntry"/>
