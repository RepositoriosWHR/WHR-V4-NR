    <selectionEntry id="b3f7-5f43-049b-1077" name="[H][GC][E] - Archaón, el aspirante oscuro" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="1d2b-e4b3-8d51-fe39" value="1">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1484-43ef-3519-d4dc" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1d2b-e4b3-8d51-fe39" type="max"/>
      </constraints>
      <rules>
        <rule id="e199-ccb7-60fe-f39b" name="Marca del elegido" hidden="false">
          <description>La Marca del Elegido cuenta como las Marcas de los cuatro Dioses del Caos y otorga a Archaón los siguientes beneficios: Furia asesina, Resistencia mágica (2), Inmune a psicología, Sangre fría, -1 a ser impactado en disparo, -1 HA a todos los enemigos en contacto, Ataques flamígeros, Ataques mágicos y una tirada de salvación especial de 5+ o +2 si ya disponía de una.</description>
        </rule>
        <rule id="2f82-3303-70a9-c518" name="Los Espadas del Caos" hidden="false">
          <description>La unidad de los Espadas del Caos debe llevar las cuatro Marcas de los Dioses del Caos y obtienen la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="227a-3bfc-23ab-b91d" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
