            <entryLink id="1135-f1af-9612-b8b8" name="[GC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="fb11-4524-18fc-0692" type="selectionEntry">
              <rules>
                <rule id="ac68-70f6-5860-7357" name="Marca de Nurgle. Bruto despedazador" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
