          <profiles>
            <profile id="d703-0808-3ea2-ffc9" name="Archaón" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">4</characteristic>
                <characteristic name="HA" typeId="575323232344415441232323">9</characteristic>
                <characteristic name="HP" typeId="425323232344415441232323">3</characteristic>
                <characteristic name="F" typeId="5323232344415441232323">5</characteristic>
                <characteristic name="R" typeId="5423232344415441232323">5</characteristic>
                <characteristic name="H" typeId="5723232344415441232323">4</characteristic>
