      </constraints>
      <rules>
        <rule id="68d6-fcf1-682a-e404" name="Magia Festus, apotecario siniestro de Nurgle" hidden="false">
          <description>Festus es un hechicero de nivel 2 que siempre utiliza el Saber de Nurgle.</description>
        </rule>
        <rule id="469f-fb60-33c0-b888" name="Doctor de Nurgle" hidden="false">
          <description>Festus tiene las reglas especiales Ataques envenenados y Regeneración (4+). Cualquier unidad a la que se una Festus obtendrá las reglas especiales Ataques envenenados y Regeneración (5+).</description>
        </rule>
      </rules>
      <infoLinks>
