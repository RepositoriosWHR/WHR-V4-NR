                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="813e-ea08-eed6-3ea8" name="Marca de Tzeentch.  Bestgors" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="8964-a9ec-095f-30e8" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
