    <selectionEntry id="1928-c855-6063-82d0" name="[H][GC][E] - Hirdra Netshycih, hechicero de Tzeentch" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="87d4-c103-41e7-b814" type="max"/>
      </constraints>
      <rules>
        <rule id="3a79-4c2b-44d4-5671" name="Magia Hirdra Netshycih, hechicero de Tzeentch" hidden="false">
          <description>Hirdra es un hechicero de nivel 2. Sin embargo, no elige sus hechizos con normalidad.</description>
        </rule>
        <rule id="c677-a245-3a22-1747" name="Visión bruja" hidden="false">
          <description>Hirdra tiene un bonificador de +2 en todas sus tiradas para Canalizar.</description>
        </rule>
        <rule id="518e-999d-cee4-dc6e" name="Señor del conocimiento del Elíseo" hidden="false">
          <description>Hirdra no elige sus hechizos con normalidad: en lugar de eso, siempre conoce los siguientes hechizos: Fuego ardiente de Tzeentch (Saber de Tzeentch), Oscura mano de destrucción (Magia Oscura), Miasma mística de Melkoth (Saber de las Sombras), Sorber el espíritu (Saber de la Muerte), Portento de Phar (Saber de los Cielos) y Bola de fuego (Saber del Fuego).</description>
        </rule>
      </rules>
      <infoLinks>
