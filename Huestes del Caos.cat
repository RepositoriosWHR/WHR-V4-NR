        <entryLink id="afbf-8082-a3e1-279a" name="[GC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="fea9-b5e3-cb0b-441d" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5388-19be-6626-d0c0" type="min"/>
          </constraints>
          <rules>
            <rule id="9d1b-9b1e-af5b-61b3" name="Marca de Tzeentch. Egrimm van Horstmann" hidden="false">
              <description>Egrimm van Horstman y Baudross portan la Marca de Tzeentch, que les otorga la regla especial Ataques flamígeros, un bonificador de +1 a su tirada de salvación especial y un +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink id="5d37-1a82-4624-7d0d" name="[GC] - Comandantes de la Hueste de apoyo" hidden="false" collective="false" import="true" targetId="a594-34b5-2c2b-9d65" type="selectionEntry"/>
        <entryLink id="31e6-c793-8a7a-7dea" name="Señor de la hueste" hidden="false" collective="false" import="true" targetId="47c4-7cfb-f0c2-63a5" type="selectionEntry"/>
      </entryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0.0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
      </costs>
    </selectionEntry>
    <selectionEntry id="d15d-cc41-0358-5823" name="[H][GC][E] - El Glottkin; los hermanos Glott: Otto, Ethrac y Ghurk" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="046a-1c36-705e-1c0e" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ee8b-c5ae-3de9-2ddc" type="max"/>
      </constraints>
      <rules>
        <rule id="baf0-b317-7b3a-f1e5" name="Magia Ethrac" hidden="false">
          <description>Ethrac es un hechicero de nivel 4 que siempre utiliza hechizos del Saber de Nurgle.</description>
        </rule>
        <rule id="49d7-b7b6-d996-9c83" name="Los hermanos Glott" hidden="false">
          <description>Todos los impactos deberán resolverse contra la Habilidad de Armas y Resistencia de Ghurk. Todos los chequeos de atributo se realizarán utilizando el perfil de Ghurk. Cada uno de los tres hermanos atacará utilizando su propio perfil de atributos.</description>
        </rule>
        <rule id="fe76-f45b-0d2e-d949" name="Torrente de pestilencia" hidden="false">
          <description>Ghurk posee un Arma de aliento de Fuerza 3 con la regla especial Ataques mágicos que no permite tirada de salvación por armadura.</description>
        </rule>
        <rule id="4b49-48eb-7c45-2686" name="Alimentarse" hidden="false">
          <description>El ataque adicional de Ghurk (indicado en su perfil de atributos) se resuelve con Fuerza 10 y la regla especial Heridas múltiples (1D6). Por cada baja causada por este ataque, el Glottkin puede restaurar una de las heridas sufridas con anterioridad en la batalla.</description>
        </rule>
        <rule id="3c8f-692c-6545-e83f" name="Icono de Nurgle" hidden="false">
          <description>El Glottkin y todas las unidades amigas a 18” o menos de él con la Marca de Nurgle o la regla especial Demonio (Nurgle) obtienen la regla especial Tozudez.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="654d-2d77-3cc9-b7b5" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="1484-c7c8-73d2-8cbc" name="Leyenda" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink id="5dda-264b-2024-8624" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(las tiradas en la tabla afectan a los tres hermanos; considera los resultados de 2 como 3)"/>
          </modifiers>
        </infoLink>
        <infoLink id="76d1-60b0-b21b-3ccb" name="Regeneración (4+)" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
        <infoLink id="3f2b-4a6e-5e33-a275" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink id="6a41-80e1-374f-35d3" name="Impactos por carga" hidden="false" targetId="a89f-5611-61e4-f924" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(2D6 y elige el resultado mayor)"/>
          </modifiers>
        </infoLink>
        <infoLink id="6291-496b-9e11-19f7" name="Piel escamosa (4+)" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink id="dbbd-d6a6-09b4-50d2" name="Monstruosamente grande" hidden="false" targetId="38d4-1707-be50-7d0f" type="rule"/>
        <infoLink id="b0b9-6ec5-9ae5-67a5" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink id="569a-d5c8-5a77-ba49" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(F3, Ataques mágicos, sin salvación por armadura)(Ghurk)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
