          <entryLinks>
            <entryLink id="ce83-6d90-d40d-4825" name="[GI] - Marca de Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="718b-c2a0-a578-4f9b" type="selectionEntry">
              <infoLinks>
                <infoLink id="371a-b6a1-915a-5af7" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink id="97db-5c35-9888-e4a3" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
