            <entryLink id="4630-bc0b-ff87-9c9f" name="[BC] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="5a59-366d-b4b0-6581" type="selectionEntry">
              <modifiers>
                <modifier type="set" field="hidden" value="true">
                  <conditions>
                    <condition field="selections" scope="cdf4-1b35-58eb-e3f8" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="614d-bf3c-8921-4b1d" type="equalTo"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule id="ff36-9948-e976-9aba" name="Marca de Khorne. Gran bestia ungida" hidden="false">
                  <description>Obtiene las reglas especiales Furia asesina, Odio (¡Todos los enemigos!) y Resistencia mágica (2). No pierde su Furia asesina si es derrotado en combate.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="4dd1-408a-aae2-3a9a" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="0bb7-17a2-a806-84b7" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
                <infoLink id="92bf-e0e8-2e56-c87b" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="25.0"/>
              </costs>
            </entryLink>
            <entryLink id="9e2b-4c09-b2c4-8fcc" name="[BC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="824e-e35c-ef47-ee81" type="selectionEntry">
              <rules>
                <rule id="093d-9d8e-cc31-b5d2" name="Marca de Tzeentch. Gran bestia ungida" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros e Inmune a fuego y una tirada de salvación especial de 5+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="75b4-511d-0d80-3cb2" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="f8de-09ec-0840-e9a9" name="Inmune al fuego" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="9c16-2bd9-2de5-6335" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <rules>
                <rule id="e8ff-2246-e294-da4a" name="Marca de Nurgle. Gran bestia ungida" hidden="false">
                  <description>Obtiene la regla especial Ataques envenenados. Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1HA.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="0010-ae76-78ed-6fa4" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
