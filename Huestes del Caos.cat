        <selectionEntry id="3514-8a67-dfcf-bfd1" name="Bruja troll del caos" hidden="false" collective="false" import="true" type="upgrade">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="8788-728a-b5b2-1e04" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="74c0-c9bf-274d-f979" type="equalTo"/>
