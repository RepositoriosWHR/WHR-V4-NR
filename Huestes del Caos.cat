              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los impactos con estas armas se resuelven con las reglas especiales Heridas múltiples (2) y Ataques flamígeros.</characteristic>
              </characteristics>
