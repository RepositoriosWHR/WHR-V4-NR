    <selectionEntry id="379f-108f-23ad-163f" name="[H][GC] - Príncipe demonio" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="2405-ebab-33d9-bc55" name="Magia Príncipe demonio" hidden="false">
          <description>Si no porta la Marca de Khorne, puede elegir una de las siguientes opciones:
-Convertirse en hechicero de nivel 1: +40 puntos. 
-Convertirse en hechicero de nivel 2: +70 puntos. 
-Convertirse en hechicero de nivel 3: +105 puntos. 
-Convertirse en hechicero de nivel 4: +160 puntos.
Puede elegir sus hechizos de entre los Saberes de la Muerte, de los Cielos, del Fuego, de las Sombras, de Magia Oscura y/o del Saber de su Dios del Caos y puede elegir sus hechizos de dos o más de los saberes listados.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f46b-8944-4824-aa7f" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="5bc7-0a28-9453-6456" name="Demonio" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule"/>
        <infoLink id="5bc3-f317-d257-c938" name="Tozudez" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink id="d220-efbb-4ef2-612e" name="Aura demoníaca (4+)" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule"/>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="6887-d50e-2c8d-ed2f" name="Comandantes" hidden="false" targetId="4c6f72647323232344415441232323" primary="true"/>
