        <infoLink id="ffcd-aeba-837d-7fdd" name="Inmune al veneno" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
        <infoLink id="27db-6dfa-da7f-0263" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
        <infoLink id="957e-f314-c901-dd98" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
