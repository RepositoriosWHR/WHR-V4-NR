        <selectionEntryGroup id="915e-0426-e146-aed0" name="Marcas del Caos" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0369-415c-d950-ba6a" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="64dd-f331-0692-e534" type="min"/>
          </constraints>
          <entryLinks>
            <entryLink id="0683-a9a5-66b2-3d19" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <rules>
                <rule id="e9ba-7287-e326-def7" name="Marca del Caos absoluto. Semental centigor" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (5+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="55c2-65db-ba79-e97b" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="4192-d2be-a004-c020" name="Piel escamosa (5+)" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="b644-e606-095a-467c" name="[BC] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="5a59-366d-b4b0-6581" type="selectionEntry">
              <infoLinks>
                <infoLink id="b405-1a0a-db1d-a8ff" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="781a-2879-c28d-2e28" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
                <infoLink id="8cb4-4331-0fbd-c71c" name="Carga devastadora" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="237d-44ca-86f7-528a" name="[BC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="824e-e35c-ef47-ee81" type="selectionEntry">
              <rules>
                <rule id="c94d-35f6-e312-0e99" name="Marca de Tzeentch. Semental centigor" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="79cb-a89f-8df9-49bb" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="5bd1-339c-8576-669b" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="4526-8a34-d400-6b3a" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <rules>
                <rule id="65bd-f465-7ca4-e300" name="Marca de Nurgle. Semental centigor" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="6bce-8620-8776-d6d0" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="2e63-0103-6896-20d7" name="[BC] - Marca de Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="96ac-1bc9-7f02-12c6" type="selectionEntry">
              <infoLinks>
                <infoLink id="239f-f86f-a496-babe" name="Inmune al miedo" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
                <infoLink id="dc10-ad35-4c10-4669" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="56fa-03e4-3f23-8c6c" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
