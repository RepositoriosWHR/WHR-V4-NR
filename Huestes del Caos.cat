    <selectionEntry id="b9c4-97a8-fcbb-cb6a" name="[DC] - Carruaje flamígero de Tzeentch" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="8b53-6f98-4b15-4bad" name="Potencia de unidad 4" hidden="false"/>
        <rule id="6b53-9900-cab6-ee15" name="Ataque rasante" hidden="false">
          <description>Si el Carruaje flamígero de Tzeentch se mueve durante la sub-fase Resto de movimientos por encima de una o más unidades enemigas no trabadas en combate, elige una de ellas. La unidad elegida sufrirá dos impactos de la Fuerza de los Aulladores de Tzeentch que tiran del carruaje.</description>
        </rule>
        <rule id="d8a8-b17d-c8a3-0d78" name="Descarga ígnea" hidden="false">
          <description>Los Horrores azules de Tzeentch pueden proyectar llamas; se trata como un arma de disparo con alcance de 12”, Fuerza 3 y las reglas especiales Disparo rápido, Arrojadiza y Ataques sólo flamígeros.</description>
        </rule>
        <rule id="538d-445b-4184-ee9b" name="Nodo de poder demoníaco" hidden="false">
          <description>Si el Heraldo montado en el Carruaje posee en Foco Mayor o el Foco Menor de Tzeentch, aplicará sus efectos a todas las unidades de Demonios (Tzeentch) a 8” o menos de él.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0a60-a080-906f-b0a1" name="Carro" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink id="1e9e-5397-6e37-7c75" name="Flotar (11)" hidden="false" targetId="29c1-6661-2b69-36e7" type="rule"/>
        <infoLink id="ec60-8c42-f5b6-24f8" name="Demonio" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Tzeentch)"/>
          </modifiers>
        </infoLink>
        <infoLink id="6453-9e7c-c08c-1e60" name="Inmune al fuego" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
        <infoLink id="1816-fd05-196a-1442" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
        <infoLink id="30b3-b329-89f6-0c53" name="Protección por montura (1)" hidden="false" targetId="1f9d-b34a-3d89-add6" type="rule"/>
