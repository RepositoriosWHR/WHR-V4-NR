    <selectionEntry id="e754-2247-7d4e-ef29" name="[K] - Angkor, Padre de los Mamuts" hidden="false" collective="false" import="true" type="upgrade">
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="93ee-9522-8350-a75f" type="max"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="378d-d0b5-e999-0a95" type="max"/>
      </constraints>
      <profiles>
        <profile id="66cf-24b6-0292-09f9" name="Angkor" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
          <characteristics>
            <characteristic name="M" typeId="4d23232344415441232323">6</characteristic>
            <characteristic name="HA" typeId="575323232344415441232323">4</characteristic>
            <characteristic name="HP" typeId="425323232344415441232323">0</characteristic>
            <characteristic name="F" typeId="5323232344415441232323">10</characteristic>
            <characteristic name="R" typeId="5423232344415441232323">8</characteristic>
            <characteristic name="H" typeId="5723232344415441232323">12</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">1</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">7</characteristic>
            <characteristic name="L" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
            <characteristic name="TSE" typeId="576172645361766523232344415441232323"/>
            <characteristic name="Tipo" typeId="5479706523232344415441232323">Monstruo</characteristic>
          </characteristics>
        </profile>
        <profile id="fe59-1eb7-292e-dfe1" name="Dotación de Khazags (12)" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
          <characteristics>
            <characteristic name="M" typeId="4d23232344415441232323">-</characteristic>
            <characteristic name="HA" typeId="575323232344415441232323">4</characteristic>
            <characteristic name="HP" typeId="425323232344415441232323">4</characteristic>
            <characteristic name="F" typeId="5323232344415441232323">3</characteristic>
            <characteristic name="R" typeId="5423232344415441232323">-</characteristic>
            <characteristic name="H" typeId="5723232344415441232323">-</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">4</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">1(12)</characteristic>
            <characteristic name="L" typeId="4c4423232344415441232323">8</characteristic>
            <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
            <characteristic name="TSE" typeId="576172645361766523232344415441232323"/>
            <characteristic name="Tipo" typeId="5479706523232344415441232323"/>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="b7f1-f850-8f41-6d34" name="Castillo de Tarok" hidden="false">
          <description>Angkor está tripulado por una dotación de doce Khazags, aunque se consideran una única miniatura. En cuerpo a cuerpo, Angkor y la dotación de Khazags pueden atacar con normalidad a cualquier miniatura en contacto con la peana de Angkor. Los ataques se resuelven contra la HA más alta. Todos los impactos se resuelven utilizando la Resistencia, Heridas y Tirada de salvación de Angkor. Usa la HP de la dotación para resolver los ataques de disparo. Los chequeos de atributo (salvo los de Liderazgo) se resuelven utilizando el perfil de Angkor. Su potencia de unidad es de 36 (eso incluye el efecto de la regla especial Monstruosamente grande). Se trata como un monstruo en todos los demás aspectos.</description>
        </rule>
        <rule id="e690-dff0-3f69-5511" name="Temblor de tierra" hidden="false">
          <description>Cualquier unidad con la regla especial Avance subterráneo que entre al campo de batalla a 12” o menos de Angkor será retirada automáticamente como baja, debido al derrumbamiento de los túneles (como si hubiesen obtenido un resultado de ¡Colapso! en la tabla de problemas). Recuerda que puedes elegir que no entren al campo de batalla y esperen al turno siguiente.</description>
        </rule>
        <rule id="f74b-5f20-87cd-5d12" name="Aplastar los obstáculos" hidden="false">
          <description>Angkor tiene la regla especial Cruzar (todos los tipos de terreno salvo Elementos acuáticos, Intransitables y Edificios). Deberás retirar del campo de batalla los elementos de escenografía (salvo Elementos acuáticos, Intransitables, Colinas y Edificios) sobre los que mueva Angkor. Además, tiene la regla especial Heridas múltiples (2D6) si ataca a Edificios, Carros o Máquinas de guerra (tan sólo Angkor, no los Khazags que lo montan).</description>
        </rule>
        <rule id="f5a5-10e1-37b0-de0e" name="Pisotear al enemigo" hidden="false">
          <description>Angkor realiza este ataque especial (adicionalmente a todos sus demás ataques) a Iniciativa cero. Todas las unidades enemigas en contacto peana con peana con Angkor que no tengan la regla especial Monstruosamente grande sufren 1D6 impactos automáticos, que se resuelven con la Fuerza de Angkor. Ten en cuenta que este ataque no se ve beneficiado por la regla especial Heridas múltiples de Angkor.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d5ba-6425-9f12-dd8c" name="Protección por montura (3)" hidden="false" targetId="fd9c-d1aa-8ce2-51b6" type="rule"/>
        <infoLink id="5842-1529-a525-3ddc" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
        <infoLink id="59da-2a40-a793-51ec" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="1e12-cf87-0d02-b812" name="Cruzar (obstáculos)" hidden="false" targetId="5dfd-3f02-cece-1e02" type="rule"/>
        <infoLink id="f492-153d-97ed-e9e5" name="Monstruosamente grande" hidden="false" targetId="38d4-1707-be50-7d0f" type="rule"/>
        <infoLink id="a8e3-e426-4374-005c" name="Leyenda" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink id="9652-5a14-7911-f16e" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink id="824f-a663-74a9-ff39" name="Aura demoníaca (4+)" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule"/>
        <infoLink id="5af4-202d-d1a9-2cf3" name="Heridas múltiples (1D6)" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Angkor)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <selectionEntries>
        <selectionEntry id="0add-8500-a289-a668" name="Equipo dotación" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="80df-9494-279d-5274" type="min"/>
