    </selectionEntryGroup>
    <selectionEntryGroup id="31ab-19bf-b4a6-7bd3" name="[BC] - Artefactos Arcanos - Bestias del Caos - Nurgle" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="389c-5380-de0b-1463" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="b2c6-4d4b-56a0-0996" name="Cáliz de Plaga" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="dc86-ac15-f48b-9435" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5c1b-1f7f-434b-f480" type="max"/>
          </constraints>
          <profiles>
            <profile id="29b2-d113-859b-2360" name="Cáliz de Plaga" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Nurgle. Al inicio de cada fase de magia, el personaje puede beber del cáliz. Si lo hace, deberá realizar un chequeo de Resistencia. Si supera el chequeo, obtiene inmediatamente 1D3 dados de Energía o Dispersión, según corresponda, que tan sólo podrá usar el chamán. Si falla, sufrirá una herida automática sin tirada de salvación de ningún tipo salvo Regeneración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
