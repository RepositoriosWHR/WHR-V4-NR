    <selectionEntry id="ff28-3426-0420-ac49" name="[H][K] - Gran brujo Kurgan" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a2dc-4181-2326-51c9" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="b997-b9a5-0a1a-0d28" name="Magia Gran brujo Kurgan" hidden="false">
          <description>Es un hechicero de nivel 3. Puede convertirse en hechicero de nivel 4 por +55 puntos. Puede elegir sus hechizos de entre los Saberes de la Muerte, de los Cielos, de las Bestias, del Fuego, de las Sombras, de Magia Oscura y/o del Saber de su Dios del Caos y puede elegir sus hechizos de dos o más de los saberes listados.</description>
        </rule>
      </rules>
