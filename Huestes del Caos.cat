          <entryLinks>
            <entryLink id="cf28-dfc6-71a4-4a19" name="[BC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="dff6-7215-247b-8ac7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="3">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="8395-e007-b778-0ca6" name="Marca del Caos absoluto. Minotauros" hidden="false">
                  <description>Obtienen laregla especial Inmune a pánico; además, pueden realizar una tirada enla tabla de Destruir la civilización antes del despliegue y pueden repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="2175-5308-3697-3f44" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="6325-d406-a0d5-8ee8" name="[BC] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="afa8-b6fb-a158-27a4" type="selectionEntry">
