            <entryLink id="9edd-0737-d9f4-9fdd" name="[GC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="fea9-b5e3-cb0b-441d" type="selectionEntry">
              <rules>
                <rule id="db13-9a53-b360-dd46" name="Marca de Tzeentch. Gran hechicero del Caos" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial (6+, o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="a376-e4e7-9493-5af5" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="2c8d-7fec-d237-5823" name="[GC] - Marca del Caos absoluto. Pesonajes" hidden="false" collective="false" import="true" targetId="82f2-d2ab-17e8-72cb" type="selectionEntry">
              <rules>
                <rule id="85f4-c33e-e9cd-6279" name="Marca del Caos absoluto. Gran hechicero del Caos" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="ef87-2580-8905-0165" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="632c-523f-9fba-6414" name="[GC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="e93a-ca85-8a5f-63c2" type="selectionEntry">
              <rules>
                <rule id="da7b-3a79-0558-a22c" name="Marca de Nurgle. Gran hechicero del Caos" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="9259-15f7-4a1b-83af" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
          </entryLinks>
