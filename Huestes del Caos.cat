                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="b419-b551-c7f5-d349" name="[K] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="cd4c-32a7-97a6-4d64" type="selectionEntry">
              <rules>
                <rule id="7804-dff5-608e-8e66" name="Marca de Caos absoluto. Señor de la guerra Kurgan" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="03a1-7969-3e8b-732c" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
