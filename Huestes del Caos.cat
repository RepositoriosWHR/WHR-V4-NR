      <selectionEntryGroups>
        <selectionEntryGroup id="b823-f008-dd3e-18e9" name="Opciones" hidden="false" collective="false" import="true">
          <selectionEntries>
            <selectionEntry id="d9af-7770-31e1-5863" name="Mutaciones del caos" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="df4e-f0b5-bfe1-9ee5" type="max"/>
              </constraints>
              <rules>
                <rule id="413a-e873-d8de-e3a0" name="Mutaciones del caos" hidden="false">
                  <description>Puede tener Mutaciones del Caos (+10 puntos): Al inicio de la batalla, antes del despliegue, efectúa una tirada de 1D6 en la siguiente tabla: el resultado indica el beneficio que obtiene el Gigante del Caos.
1	Locura del Caos: Estupidez y Tozudez.
2	Aura del Caos: Ataques mágicos y Resistencia mágica 2.
3	Pinchos : Impactos por carga (1D3).
4	Pellejo pétreo: Piel escamosa (5+).
5	Corpulencia del Caos: +1 Herida.
6	Carne mutada: Regeneración (5+).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="9ff6-0239-c993-8ba8" name="Marcas del caos" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6bd0-43c9-73b3-f131" type="min"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="28d5-b23a-9d59-7314" type="max"/>
          </constraints>
          <entryLinks>
            <entryLink id="93a4-0723-ef2c-3c42" name="[GC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="fb11-4524-18fc-0692" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="30">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="cb23-1330-6438-7c6e" name="Marca de Nurgle. Gigante del Caos" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y en cuerpo a cuerpo.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink id="0f20-d5a1-f9bd-d1db" name="[GC] - Marca de Slaanesh. Unidades" hidden="false" collective="false" import="true" targetId="aa84-8b93-55b7-3497" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="15">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="3d53-db7b-44e9-c4c6" name="Marca de Slaanesh. Gigante del Caos" hidden="false">
                  <description>Obtiene la regla especial Poder de penetración en todos sus ataques y +1 Iniciativa.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="ac61-cbd4-dd14-69b9" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="9c8e-4866-4caa-8c5d" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="15">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="7bb0-a6e1-d50d-8a66" name="Marca de Tzeentch. Gigante del Caos" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="aad6-86eb-ea8d-98c5" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="c876-9d8c-8e6c-f6df" name="[GC] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="2f15-75f1-7256-e091" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="20">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="deb3-ee83-0187-7d25" name="Marca de Khorne. Gigante del Caos" hidden="false">
                  <description>Obtiene la regla especial Resistencia mágica (1); además, suma +1 a todas las tiradas en la tablas de ataques especiales del gigante (los resultados superiores a 6 se consideran 6)</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="236e-fee0-69f1-6df7" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="8ed6-df2a-1320-a534" name="[GC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="08d1-684e-f1be-fa4e" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="10">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
