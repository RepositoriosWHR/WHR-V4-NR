      </constraints>
      <selectionEntries>
        <selectionEntry id="39b4-eee4-942e-b4ea" name="Pluma del gran águila" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="bb19-da07-6d5e-2f6d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9d46-dd3e-9fa7-6741" type="max"/>
          </constraints>
          <profiles>
            <profile id="a724-1d74-4d5e-2a5e" name="Pluma del gran águila" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la marca de Tzeentch. Al inicio de la batalla, tras el despliegue, tira 1D6 para determinar el efecto de la Pluma durante la batalla. Con un resultado de 1, la Pluma no tiene ningún efecto; con un resultado de 2-3, proporciona una tirada de salvación especial de 6+; con un resultado de 4-5, proporciona una tirada de salvación especial de 5+; y con un resultado de 6, proporciona una tirada de salvación especial de 4+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
