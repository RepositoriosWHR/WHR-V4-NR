      <selectionEntryGroups>
        <selectionEntryGroup id="fa2b-deab-84fa-cc0c" name="Marcas del caos" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8f0d-0bf0-2c62-b585" type="max"/>
          </constraints>
          <entryLinks>
            <entryLink id="82f1-2753-57ee-55cb" name="[GI] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="0d4d-b934-56dd-d521" type="selectionEntry">
              <rules>
                <rule id="cddc-5557-22d3-c942" name="Marca de Nurgle. Dragón del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Ataques envenenados e Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="2c5b-fc8b-d32a-b4f4" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink id="bedf-4caa-66a1-097b" name="Inmune al veneno" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="30.0"/>
              </costs>
            </entryLink>
            <entryLink id="9c68-3179-aa4b-9e55" name="[GI] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="be24-e143-bbb6-e28c" type="selectionEntry">
              <rules>
                <rule id="93bd-da9e-f0a0-86bc" name="Marca de Khorne. Dragón del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Furia asesina (no la pierde aunque sea derrotado en combate) y Resistencia mágica (2).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f24c-27e6-20e0-bad8" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
                <infoLink id="61c0-83fe-88cd-a299" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="30.0"/>
              </costs>
            </entryLink>
            <entryLink id="87bc-f2e9-7796-d308" name="[GI] - Marca de Slaanesh. Unidades" hidden="false" collective="false" import="true" targetId="2d07-75d8-1827-6aa9" type="selectionEntry">
              <infoLinks>
                <infoLink id="eb95-eac1-1485-b461" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="6bec-bb81-112c-6d13" name="Tozudez" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="1f29-54e3-a074-595d" name="[GI] - Marca del caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="0b36-c6c0-1cb3-02d0" type="selectionEntry">
              <rules>
                <rule id="4a0c-eb8e-bafd-8fb6" name="Marca de caos absoluto. Dragón del Caos" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado al Dragón del Caos; considera los resultados de 2 como 3.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="8403-c512-db15-864b" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="6e92-3cc2-eb43-7ed3" name="[GI] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="5b87-e012-051a-fc0b" type="selectionEntry">
              <rules>
                <rule id="171b-9f4d-d745-4316" name="Marca de Tzeentch. Dragón del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros e Inmune a fuego y una tirada de salvación especial de 5+ (o +2 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="e00c-3e88-6291-fa70" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="aa6f-21c1-91ff-6496" name="Inmune al fuego" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="40.0"/>
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup id="4679-f164-3f40-47bf" name="Recompensa del Caos" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6429-3866-c707-e861" type="max"/>
