      <entryLinks>
        <entryLink id="f411-8176-62b6-c5f2" name="[GC] - Marca del Caos absoluto. Pesonajes" hidden="false" collective="false" import="true" targetId="82f2-d2ab-17e8-72cb" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="addc-52e0-5392-386e" type="min"/>
          </constraints>
          <rules>
            <rule id="16bf-0ec7-79a1-1b63" name="Marca del Caos absoluto. Vardek Crom" hidden="false">
              <description>Crom porta la Marca del Caos absoluto, que le otorga la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto a Crom toda la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="fefe-199c-456a-d9ad" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
        </entryLink>
        <entryLink id="8e4c-89ea-e4d4-791b" name="Señor de la hueste" hidden="false" collective="false" import="true" targetId="47c4-7cfb-f0c2-63a5" type="selectionEntry"/>
