        <selectionEntryGroup id="e57f-fe01-89e3-b05c" name="Marcas del Caos" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f99c-d7c5-d733-4cc3" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fcbc-2e36-490a-b966" type="min"/>
          </constraints>
          <entryLinks>
            <entryLink id="3da9-4703-ecb1-b8d1" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <rules>
                <rule id="400d-838d-1198-a06c" name="Marca del Caos absoluto. Ungor Oscuro" hidden="false">
                  <description>Obtiene la regla especial Inmune a pánico, puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="6500-bcb7-d3a4-7a87" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="bacb-d99b-7db5-2cf1" name="[BC] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="5a59-366d-b4b0-6581" type="selectionEntry">
              <infoLinks>
                <infoLink id="7fbf-adec-fbc5-2639" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="b321-0d4e-696f-7b9f" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink id="53df-f3f7-7ea8-6203" name="Carga devastadora" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="1bb2-a0ae-3a7f-2758" name="[BC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="824e-e35c-ef47-ee81" type="selectionEntry">
              <rules>
                <rule id="7181-ef40-a9bc-57e5" name="Marca de Tzeentch. Ungor Oscuro" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="ef87-84ef-b544-e2c3" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="deb2-8294-8f63-46a0" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <rules>
                <rule id="2ca6-b4fb-fc76-f02b" name="Marca de Nurgle. Ungor Oscuro" hidden="false">
                  <description>Obtiene las reglas especiales Ataques envenenados. Además, los enemigos tienen un penalizador de -1 para
impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="cd5e-bd5c-34a6-138d" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="e60d-8d6d-27f0-a4a3" name="[BC] - Marca de Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="96ac-1bc9-7f02-12c6" type="selectionEntry">
              <rules>
                <rule id="8cac-bf9b-fc14-8ed1" name="Marca de Slaanesh. Ungor Oscuro" hidden="false">
                  <description>Obtiene +1 a sus atributos de Movimiento e Iniciativa y las reglas especiales Sangre fría y Poder de penetración.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d452-4a88-003d-c045" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink id="de9e-f3b7-09f4-340f" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
