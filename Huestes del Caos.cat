                <profile id="3cd1-c169-8eba-26f8" name="Las Coronas robadas" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Al inicio de cada uno de tus turnos, deberás decidir si Ungrol usa el poder del caudillo o los conocimientos del chamán. El efecto dura hasta el inicio de tu siguiente turno.
-Si elige el poder del caudillo, Ungrol obtendrá un bonificador de +1 a sus atributos de Habilidad de Armas y Fuerza. 
-Si elige los conocimientos del chamán, Ungrol generará un dado adicional de Energía o Dispersión al inicio de cada fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
