    <selectionEntry id="8ad7-7366-ef4f-0872" name="[H][GI] - Dragón del caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1854-2abc-c938-d165" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2a0a-ec7a-4dc3-6fa2" type="max"/>
      </constraints>
      <rules>
        <rule id="f48f-8300-d51e-90c6" name="Aliento del dragón del caos" hidden="false">
          <description>Un Dragón del Caos posee dos Armas de aliento: una de Fuerza 4 con la regla especial Ataques sólo flamígeros y otra de Fuerza 2 sin tirada de salvación por armadura y es capaz de usar ambas a la vez.</description>
        </rule>
        <rule id="cb1d-79d9-4393-5fd9" name="Criatura legendaria" hidden="false">
          <description>Un Dragón del Caos tiene la regla especial ¡Ni un paso atrás!, que afecta a todas las unidades de Grey infernal a 18” o menos del Dragón del Caos (esto ya tiene en cuenta que el Dragón del Caos es un Objetivo grande).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="7bb9-9920-8e86-c662" name="Piel escamosa (3+)" hidden="false" targetId="f3fe-4c6e-197e-832f" type="rule"/>
        <infoLink id="096e-108c-f38d-240a" name="Volar (8)" hidden="false" targetId="4976-4d2f-fd36-1a17" type="rule"/>
        <infoLink id="6192-1d2c-03b2-fbdf" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="0fc7-0cef-0cf6-ab25" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink id="65b3-c0db-3d93-01a3" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(F4, Ataque sólo flamígeros)"/>
          </modifiers>
        </infoLink>
        <infoLink id="601d-5fbf-beb9-7359" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(F2, sin salavación por armadura)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
