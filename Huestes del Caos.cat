            <entryLink id="4af6-89b3-8dd7-e38e" name="[BC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="824e-e35c-ef47-ee81" type="selectionEntry">
              <rules>
                <rule id="ed96-8876-764b-3ad1" name="Marca de Tzeentch.  Bestia maldita" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f2a3-f49c-1ee1-ad3f" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
