      </constraints>
      <rules>
        <rule id="d39a-33a2-e9ed-01f5" name="Magia Brujo ogro del Caos" hidden="false">
          <description>Es un hechicero de nivel 1. Puede convertirse en hechicero de nivel 2 por +30 puntos. Puede elegir sus hechizos de entre los saberes de las Bestias, los Cielos, la Muerte, Magia Oscura y/o el Saber de su Dios del Caos y puede mezclar sus hechizos entre varios de estos saberes.</description>
        </rule>
      </rules>
