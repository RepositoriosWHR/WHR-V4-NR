          </constraints>
          <profiles>
            <profile id="5106-8fd8-0f70-b1d1" name="Mangual de bronce" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Mangual. Al inicio de cada ronda de combate cuerpo a cuerpo, elige una única miniatura enemiga en contacto peana con peana con el portador. Este arma causa a esa miniatura un impacto automático de Fuerza 5.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="e7f2-70f6-33a7-05e1" name="[BC] - Mangual" hidden="false" collective="false" import="true" targetId="7091-4786-922f-7671" type="selectionEntry">
