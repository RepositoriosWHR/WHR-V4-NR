              <rules>
                <rule id="22ee-b27b-ade5-f2df" name="Marca de Tzeentch. Jinetes soldados del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros (sólo los jinetes) y Aura demoníaca de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="66d4-10e8-50f4-c8c2" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule">
