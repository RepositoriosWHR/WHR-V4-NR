          <entryLinks>
            <entryLink id="2d80-4f6a-56af-ff36" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1b40-0aff-aa4e-27b3" type="min"/>
              </constraints>
              <rules>
                <rule id="cb61-40a0-f82e-b2e8" name="Marca de Nurgle. Molokh" hidden="false">
                  <description>Molokh porta la Marca de Nurgle, que hace que cause Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="0d91-50b3-7b34-5791" name="Terror" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
