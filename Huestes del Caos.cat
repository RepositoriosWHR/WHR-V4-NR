            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1f2b-6b4e-ca23-2596" name="Conocimientos prohibidos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ff8a-849c-bbe7-eccf" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="c813-b7e8-d1b3-1fc3" type="max"/>
          </constraints>
          <profiles>
            <profile id="002a-52a4-a890-cb5a" name="Conocimientos prohibidos" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9bf4-d999-0a62-496b" name="Aureloa ígnea" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="02c7-e8dc-3bb8-5911" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="9a04-d5e7-55c8-3b3c" type="max"/>
          </constraints>
          <profiles>
            <profile id="fb8f-bbf1-7c25-3974" name="Aureloa ígnea" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Todas las miniaturas enemigas en contacto con el demonio sufrirán un impacto de Fuerza 4 con la regla especial Ataques solo flamígeros al inicio de cada fase de combate. Además, obtiene un +1 a su Aura demoníaca.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="fe8a-6796-5c6c-8780" name="Ataques solo flamígeros" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4f52-3825-5d5f-0b4e" name="Bastón de la calcinación" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c7eb-f910-9795-a23f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="cf31-ebea-0a9f-f310" type="max"/>
          </constraints>
          <profiles>
            <profile id="f3ed-9aca-52e2-9962" name="Bastón de la calcinación" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene un Arma de aliento de Fuerza 4 con la regla especial Ataques sólo flamígeros. Por cada herida causada por el demonio en combate cuerpo a cuerpo o por el Arma de aliento, haz una tirada de 1D6. Con un resultado de 5 o más, obtendrás un dado adicional de Energía o Dispersión (según corresponda) durante la</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="4e17-fdbd-14a4-a131" name="[DC] - Arma demonio" hidden="false" collective="false" import="true" targetId="020b-fcbd-54b9-7c54" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4963-cef7-2aae-8124" name="Maestría de lo arcano" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="aa88-07df-a3cf-b89c" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="5dca-676b-456d-5150" type="max"/>
          </constraints>
          <profiles>
            <profile id="4fb7-6343-d5cb-ad68" name="Maestría de lo arcano" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio puede repetir sus tiradas en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0a65-555e-22e4-befa" name="Maestro de la mutación" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="568c-f235-276e-b017" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="4f42-0c94-f582-b0b7" type="max"/>
          </constraints>
          <profiles>
            <profile id="b204-03bb-334b-a9f6" name="Maestro de la mutación" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Cada vez que el demonio cause una baja mediante disparos, en combate cuerpo a cuerpo o con el hechizo identificativo del Saber de Tzeentch, puedes añadir una miniatura de Horror rosa o de Horror azul a una unidad de Horrores rosas o de Horrores azules (según corresponda) a 9” o menos del demonio.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="c850-de18-9b39-181b" name="Foco de energía" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b862-d65b-7222-e522" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="3c07-34bb-92f0-a3e4" type="max"/>
          </constraints>
          <profiles>
            <profile id="5f67-dc78-70ef-0bb5" name="Foco de energía" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene un bonificador de +2 en sus tiradas para Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f774-4e68-aefd-59a5" name="Llamas de Tzeench" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="11da-7ffd-0572-f50e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="b87b-d6ba-b02b-beaf" type="max"/>
          </constraints>
          <profiles>
            <profile id="9081-8eb3-d40a-f898" name="Llamas de Tzeench" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio puede realizar un ataque a distancia de alcance 18”, Fuerza 5 y las reglas especiales Disparos múltiples (1D6+1), Disparo rápido, Arrojadiza y Ataques flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="cc96-b0f8-4860-b6b2" name="Disparos múltiples" hidden="false" targetId="fc7e-40e6-a7aa-4530" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(1D6+1)"/>
              </modifiers>
            </infoLink>
            <infoLink id="3f6f-47f5-5a2d-4581" name="Disparo rápido" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
            <infoLink id="ba79-3e1b-be83-9ded" name="Arrojadiza" hidden="false" targetId="f4e8-fb62-1495-6c04" type="rule"/>
            <infoLink id="ee8b-e31d-2cc1-f56c" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="735b-d9ee-d246-36c2" name="Fortuna de Tzeentch" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1b9b-5816-5772-af63" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="393c-fdcd-7cd9-0512" type="max"/>
          </constraints>
          <profiles>
            <profile id="a577-c824-1a1e-b06f" name="Fortuna de Tzeench" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">La miniatura podrá repetir una tirada de dado de 1D6 en cada fase de magia, disparo y combate cuerpo a cuerpo; puede ser una tirada para impactar, para herir, una tirada de salvación, un dado de Energía o Dispersión o un chequeo de atributo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1b01-f321-e9d7-773b" name="Sabiduría milenaria" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ae01-f481-8ea0-ae11" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="ab40-e157-2dad-8b12" type="max"/>
          </constraints>
          <profiles>
            <profile id="1d06-3d12-7e01-9c00" name="Sabiduría milenaria" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene la regla especial Señor del conocimiento (Tzeentch, Magia Oscura o Fuego, a su elección). Ten en cuenta que esto sustituye a sus hechizos normales aunque, si ya tenía la regla especial Señor del conocimiento, tendrá acceso completo a dos saberes de entre los indicados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bf1d-aa4a-4e15-c910" name="Señor del conocimiento" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier type="set" field="name" value="(Tzeentch, Magia Oscura o Fuego)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="deb1-2b07-362d-65ea" name="Esencia inmortal" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6ebe-bc35-d39f-3cb4" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="900f-3e51-6377-1969" type="max"/>
          </constraints>
          <profiles>
            <profile id="5ceb-e8e6-6d4c-e54f" name="Esencia inmortal" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El Aura demoníaca del demonio podrá utilizarse incluso contra Ataques mágicos (convirtiéndose, efectivamente, en una tirada de salvación especial).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
