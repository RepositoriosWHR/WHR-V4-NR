        <selectionEntry id="6090-32b7-ac89-771e" name="Campana de la condenación" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0f08-c689-d09a-576f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2629-ac96-eb5b-31be" type="max"/>
          </constraints>
          <profiles>
            <profile id="6739-94d0-fb19-6874" name="Campana de la condenación" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Solo Infantería. Por cada enemigo eliminado por el portador o la unidad en la que se encuentre debido a una herida causada por la regla Ataques de plaga, efectúa una tirada de 1D6. Con un resultado de 6, podrás incluir una miniatura adicional de Portador de plaga de Nurgle en la unidad en la que se encontrase. Resuelve este efecto tras realizar los ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
