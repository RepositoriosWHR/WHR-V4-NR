            <profile id="70b8-b2bd-98e3-b26a" name="Sangre emponzoñada" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Por cada herida sin salvar recibida por el demonio en combate, causará un impacto de Fuerza igual a la Resistencia del demonio a la unidad enemiga que la causó.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
