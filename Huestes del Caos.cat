          <entryLinks>
            <entryLink id="92f1-7e08-7849-e0c3" name="[K] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="c752-a5a1-2916-2861" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="2">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="6eb3-f263-afef-0ec2" name="Marca de Caos absoluto. Guerreros consagrador Kurgan" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d210-1924-7260-cd3b" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="abdf-d3fc-c77d-77cb" name="[K] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="efd6-29ad-5411-f88d" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="3">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="d8d0-88ff-eb00-eb06" name="Marca de Nurgle. Guerreros consagrador Kurgan" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink id="f64d-12dd-bc41-69c6" name="[K] - Marca de Slaanesh. Unidades" hidden="false" collective="false" import="true" targetId="03a4-f8dd-240e-db15" type="selectionEntry">
              <modifiers>
