            <entryLink id="0cef-fbe6-c1e1-ee2f" name="[GC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="e93a-ca85-8a5f-63c2" type="selectionEntry">
              <rules>
                <rule id="e88e-54ab-a6b4-4440" name="Marca de Nurgle. Señor de las bestias del Caos" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarlos con proyectiles, los enemigos en contacto peana con peana tendrán -1HA. Además, causará Miedo.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="da07-91a0-74bd-3674" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="d58a-9ecd-de00-420a" name="[GC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="fea9-b5e3-cb0b-441d" type="selectionEntry">
              <rules>
                <rule id="a46b-cfba-ad19-e0de" name="Marca de Tzeentch. Señor de las bestias del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="8472-339e-9fbb-4773" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="3253-997a-2cb1-7fc0" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="9120-3dbc-757f-94e5" name="[GC] - Marca del Caos absoluto. Pesonajes" hidden="false" collective="false" import="true" targetId="82f2-d2ab-17e8-72cb" type="selectionEntry">
              <rules>
                <rule id="de04-de31-46ee-4c13" name="Marca del Caos absoluto. Señor de las bestias del Caos" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="1ab1-9b1e-e646-5a65" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
