          <entryLinks>
            <entryLink id="4a32-096b-20b0-1333" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <rules>
                <rule id="6a82-21e3-ad6b-8662" name="Marca del Caos absoluto. Minotauro destripador" hidden="false">
                  <description>Obtiene la regla especial Inmune a Pánico y mejora su regla especial Piel escamosa a 5+. Puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="836f-8c5e-2532-67f2" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="044a-b138-5f8d-01f4" name="Piel escamosa (5+)" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="3dca-52e8-d97b-43bf" name="[BC] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="5a59-366d-b4b0-6581" type="selectionEntry">
              <infoLinks>
                <infoLink id="ebcb-8abe-7d12-8a50" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="5474-88cc-e648-e62a" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
