              </constraints>
              <rules>
                <rule id="38a7-b0c2-1c6e-8299" name="Marca de Khorne. Taurox" hidden="false">
                  <description>Taurox porta la Marca de Khorne, que le otorga las reglas especiales Odio (¡todos los enemigos!), Resistencia mágica (2) y Carga devastadora. Taurox no perderá nunca su Furia asesina.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="b7ff-9acb-058e-d87a" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
