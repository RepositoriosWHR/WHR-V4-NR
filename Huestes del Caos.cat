    <selectionEntry id="6c2f-7072-10c0-d2fe" name="[H][GI] - Fauces del terror" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1854-2abc-c938-d165" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7d27-1523-12ad-9bb1" type="max"/>
      </constraints>
      <rules>
        <rule id="6c9a-a61e-278a-6687" name="Devorar" hidden="false">
          <description>Los ataques en combate cuerpo a cuerpo de unas Fauces del terror tienen la regla especial Heridas múltiples (1D6). Ten en cuenta que esto no se aplica a sus Impactos por carga.</description>
        </rule>
        <rule id="6638-3fc4-8244-b5a7" name="Bestia subterránea" hidden="false">
          <description>Los Fauces del terror tienen la regla especial Avance subterráneo. Puede repetir la tirada del dado de dispersión si hay alguna unidad trabada en combate a 12” o menos del punto designado para que entre al campo de batalla. Además, al final de cualquier fase de combate cuerpo a cuerpo en la que el Fauces del terror no se encuentren trabadas en combate cuerpo a cuerpo, puedes retirarla del campo de batalla: en tu siguiente turno, podrá volver a entrar al campo de batalla usando la regla especial Avance subterráneo (con un bonificador de +1 a su tirada de Refuerzos). Sin embargo, un Fauces del terror que deba huir (por la razón que sea) se enterrará de nuevo: devuélvelas a Refuerzos y todas las tiradas de Refuerzos para determinar si vuelven a entrar al campo de batalla a partir de ese momento tienen un penalizador de -1 (acumulativo por cada vez que esto suceda).</description>
        </rule>
        <rule id="55c6-0f3e-7385-7459" name="Vómito de cieno" hidden="false">
          <description>Se trata de un Arma de aliento que se resuelve con Fuerza 3. Cualquier unidad que sufra al menos una herida a consecuencia de este Arma de aliento verá su Iniciativa reducida a la mitad hasta el final del turno de jugador.</description>
        </rule>
        <rule id="d76a-494e-15be-fffb" name="Límite por ejército" hidden="false">
          <description>Tan sólo puede incluirse unas Fauces del Terror, o hasta dos en un gran ejército (es decir, un
ejército de, al menos, 3000 puntos).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="85c0-3f8d-ff9e-bc8f" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="c72a-ea90-e290-304b" name="Impactos por carga (1D6)" hidden="false" targetId="bdc4-4c8b-a303-ec51" type="rule"/>
        <infoLink id="1d63-80f8-1770-221e" name="Piel escamosa (4+)" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink id="e702-93b7-af47-9f60" name="Veloz" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
        <infoLink id="cf93-444c-760d-b960" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
        <infoLink id="e9ce-ae32-8f58-d9f9" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1D3+1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="1bce-1150-8bb0-e33b" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(F3, Vómito de cieno)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
