              <conditions>
                <condition field="selections" scope="b7fc-e980-a1bc-0ffe" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="bb82-0916-94fc-563b" type="equalTo"/>
