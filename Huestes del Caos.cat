      <constraints>
        <constraint field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="61a0-622a-6e13-c3cd" type="max"/>
      </constraints>
      <rules>
        <rule id="d0e7-5978-b4e4-54c2" name="Regeneración mutante" hidden="false">
          <description>Regeneración (4+). Si regeneran 2 o más heridas en una misma fase, tira en la tabla de Ojo de los Dioses y aplica el resultado a toda la unidad. Considera los resultados de 11 a 14 como “El Ojo está cerrado”.</description>
        </rule>
        <rule id="96db-3416-5304-d0d3" name="Vómito copioso" hidden="false">
          <description>En lugar de realizar sus ataques normales en combate cuerpo a cuerpo, Throgg puede optar por causar 1D6 impactos automáticos de Fuerza 5 que no permiten tirada de salvación por armadura. Además, una vez por batalla, Throgg puede utilizar su vómito como un Arma de aliento con Fuerza 5 que no permite tirada de salvación por armadura.</description>
        </rule>
        <rule id="25a2-7938-b53f-8a07" name="La horda monstruosa" hidden="false">
          <description>La unidad de Trolls del Caos a la que se una Throgg perderá la regla especial Estupidez mientras Throgg continúe con vida.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="98ba-da18-2990-1388" name="Infantería monstruosa" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink id="bbc5-60a5-e83f-d8fb" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink id="55b3-275e-8591-6ce1" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink id="40bf-4d36-1798-0667" name="Regeneración mutante" hidden="false" targetId="bfae-ee37-b288-b716" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(4+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
