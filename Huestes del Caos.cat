        <selectionEntry id="0457-f28e-c945-6889" name="Garras afiladas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3c8f-7009-398d-517a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="2847-7a15-7ed0-7196" type="max"/>
          </constraints>
          <profiles>
            <profile id="27d5-0ea1-5648-10d6" name="Garras afiladas" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene +1 a su Fuerza y la regla especial Poder de penetración en sus ataques en combate cuerpo a cuerpo; las garras cuentan como Armas emparejadas (lo que le proporciona también +1 Ataque) pero el personaje no puede llevar armas ni escudos de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="ff78-15a6-7795-28e4" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
