    <selectionEntry id="92f2-9092-de86-3484" name="[H][GC][E] - Morbidex Dos Veces Nacido" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="04a7-6f95-957f-1f4e" type="max"/>
      </constraints>
      <rules>
        <rule id="fd85-084b-2c29-d017" name="Infestado de nurgletes" hidden="false">
          <description>Además de sus ataques normales en combate cuerpo a cuerpo, Morbidex realiza 2D6 ataques adicionales que se resuelven con HA3, F3, I3 y las reglas especiales Ataques envenenados y Ataques mágicos.</description>
        </rule>
        <rule id="9832-0733-3215-f84e" name="La hueste chillona" hidden="false">
          <description>Si tu ejército incluye a Morbidex, debes incluir una unidad de Seguidores nurgletes. Morbidex posee la regla especial Presencia inspiradora, que sólo afecta a la unidad de Seguidores nurgletes a 18”o menos de él.</description>
        </rule>
      </rules>
