    <selectionEntry id="59d5-dc86-cd57-272f" name="[H][GI] - Bestia espinosa del caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1854-2abc-c938-d165" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="bdc9-533e-b568-9ee5" type="max"/>
      </constraints>
      <rules>
        <rule id="be00-9497-541f-d732" name="Cuerpo espinoso" hidden="false">
          <description>Los enemigos que carguen a una Bestia espinosa del Caos pierden todos los bonificadores por carga que pudiesen tener (incluyendo el +1 a la Iniciativa por cargar) y todos los Impactos por carga que se le fueses a causar a una Bestia espinosa del Caos los sufrirá en su lugar la unidad que los causó. Además, la Bestia Espinosa del Caos tiene la regla especial Impactos por carga (1D6).</description>
        </rule>
        <rule id="983a-cc88-ff2f-0bd7" name="Enguillir" hidden="false">
          <description>Una Bestia espinosa del Caos realiza 5 Ataques (6 con Furia asesina) y un ataque adicional con sus monstruosas fauces. El ataque con las fauces de la Bestia espinosa del Caos se resuelve con las reglas especiales Heridas múltiples (1D6) y Golpe letal; además, la Bestia espinosa del Caos podrá recuperar una de las heridas sufridas previamente durante la batalla si causa una baja con su ataque especial de Engullir.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="64a3-7022-50c5-be5d" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="c7c6-80fd-4fc5-5276" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
        <infoLink id="ff39-3d66-c11c-9615" name="Piel escamosa (3+)" hidden="false" targetId="f3fe-4c6e-197e-832f" type="rule"/>
        <infoLink id="9512-15f0-b775-a469" name="Tozudez" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink id="f91f-92ea-5d2e-6f88" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
        <infoLink id="0899-70d2-e94d-08ac" name="Impactos por carga (1D6)" hidden="false" targetId="bdc4-4c8b-a303-ec51" type="rule"/>
      </infoLinks>
