                </modifier>
              </modifiers>
              <rules>
                <rule id="8a75-f926-5cb8-aee5" name="Marca de caos absoluto. Gigante del Caos" hidden="false">
                  <description>Obtiene una tirada de salvación por armadura de 5+.</description>
                </rule>
