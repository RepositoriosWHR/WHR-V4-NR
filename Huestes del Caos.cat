                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="70b8-8091-c7a4-c6bd" type="min"/>
              </constraints>
              <rules>
                <rule id="ae62-e67f-fbd6-4887" name="Marca de Slaanesh. Malagor" hidden="false">
                  <description>Inmune a Miedo, Inmune a Pánico, Poder de penetración y Sangre fría</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="9472-2ae6-9dce-2d4f" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink id="68da-8bf2-b566-8a9f" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
