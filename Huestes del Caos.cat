              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Al inicio del turno de cada jugador tira 1D3-1: durante todo ese turno, el resultado será el bonificador a su Resistencia que obtenga el portador.</characteristic>
              </characteristics>
            </profile>
