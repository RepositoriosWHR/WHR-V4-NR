            <entryLink id="64ac-e35f-b03a-68d2" name="[GI] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="db84-b5c7-fe44-c8b4" type="selectionEntry">
              <rules>
                <rule id="bfc1-6dfd-f929-e44e" name="Marca de Tzeentch. Tirano ogro del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="97d9-0784-cdf9-def6" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="fbbb-0a01-05ca-2778" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="7793-0fce-2f72-2fa2" name="[GI] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="924a-4560-4a74-e2be" type="selectionEntry">
              <rules>
                <rule id="084d-8b90-5651-5965" name="Marca de Nurgle. Ogro tirano del Caos" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="e1e7-45d7-3df6-a687" name="Terror" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="bb30-750e-ac2b-8021" name="[GI] - Marca del caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="38c4-0f99-1e14-3cd5" type="selectionEntry">
              <rules>
                <rule id="b9a8-becd-068e-6479" name="Marca de caos absoluto. Tirano ogro del Caos" hidden="false">
                  <description>Obtiene la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="40f6-236d-c60d-c454" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="4b11-e7c1-cb12-b215" name="[GI] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="ff62-9412-73a7-b3d9" type="selectionEntry">
