                </modifier>
              </modifiers>
              <rules>
                <rule id="1ad1-2307-7f24-776b" name="Marca de Khorne. Engendro del Caos" hidden="false">
                  <description>Obtienen las reglas especiales Odio (¡todos los enemigos!) y Resistencia mágica (1); además, sus Ataques aleatorios aumentan a 1D6+2.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d1b9-a70d-4bf8-ab59" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="dd1d-316f-81cc-74d3" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
