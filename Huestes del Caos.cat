      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="0f2a-c87b-b5cb-c677" name="[BC] - Armas Mágicas - Hechiceros - Bestias del Caos - Arma a dos manos" hidden="false" collective="false" import="true">
