          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b0ec-64ed-2fb4-178a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="7897-0e19-c8bd-b732" type="max"/>
          </constraints>
          <profiles>
            <profile id="c895-91ab-1839-abce" name="Tamaño colosal" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene +1 Herida y -1 a su Iniciativa. Si es un Monstruo, obtendrá +2 Heridas en lugar de +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
