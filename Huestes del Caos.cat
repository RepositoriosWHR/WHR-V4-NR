              <profiles>
                <profile id="ac37-be75-2e61-289f" name="Desmembradora y Decapitador" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas (Asavar realiza un total de 6 Ataques con estas armas). Cada vez que Asavar vaya a atacar debe repartir sus seis ataques como desee entre ambas armas, aunque debe realizar al menos un ataque con cada una de ellas. Los impactos con Desmembradora se resuelven con +1F y no permiten tirada de salvación por armadura, y los impactos con Decapitador se resuelven con +1F y la regla especial Golpe letal.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="34a3-b88c-17a7-a080" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
                <infoLink id="515b-d32e-e084-bf8b" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink id="f249-f882-f0b1-83cd" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
              </infoLinks>
