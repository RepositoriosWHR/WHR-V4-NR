          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="46dc-3cd7-f685-a3bc" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e009-75af-ba29-7ac5" type="max"/>
          </constraints>
          <profiles>
            <profile id="286d-6f28-35e9-177b" name="Martillo Rompehuesos" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Los impactos de este arma se resuelven con Fuerza 10 (esto sustituye el habitual +2F por ser Arma a dos manos) y la regla especial Heridas múltiples (1D3). Además, los resultados naturales de 6 para herir tendrán la regla especial Heridas múltiples (1D6) en vez de 1D3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="ccef-1065-2c71-b991" name="Heridas múltiples (1D3)" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
          </infoLinks>
          <entryLinks>
            <entryLink id="0126-f239-09f1-0798" name="[BC] - Arma a dos manos" hidden="false" collective="false" import="true" targetId="bb47-48b8-65a3-26d3" type="selectionEntry">
