      <rules>
        <rule id="d64a-f74d-db3c-7093" name="Magia Egrimm Van Horstmann" hidden="false">
          <description>Egrimm van Horstmann es un hechicero de nivel 4 que conoce todos los hechizos de los Saberes de Tzeentch y de la Luz.</description>
        </rule>
      </rules>
