          <selectionEntries>
            <selectionEntry id="e3c0-dc40-c2cc-6ff4" name="Matareyes" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6fcf-c667-5cf7-7d99" type="max"/>
