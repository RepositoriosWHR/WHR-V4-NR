          <entryLinks>
            <entryLink id="f054-2d23-117d-9430" name="[GI] - Recompensas del Caos. Caos absoluto" hidden="false" collective="false" import="true" targetId="d139-f7f2-4af0-acb3" type="selectionEntryGroup">
              <modifiers>
