            <profile id="9e9d-545b-f5bd-b5c9" name="Mortaja ulcerosa" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con la Marca de Nurgle. El portador y su unidad obtendrán la regla especial Ataques envenenados, que tendrán éxito con 5+ en lugar del habitual 6+.</characteristic>
              </characteristics>
