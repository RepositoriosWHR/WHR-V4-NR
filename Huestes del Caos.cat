          <selectionEntries>
            <selectionEntry id="3355-8281-d266-3552" name="Espada del olvido" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="94cf-7bb8-ae47-1a37" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c208-8360-6cd1-0875" type="min"/>
              </constraints>
              <profiles>
                <profile id="0dd2-caf5-a210-17a0" name="Espada del olvido" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Cualquier miniatura que sufra heridas a causa de la Espada del olvido deberá realizar inmediatamente un chequeo de Resistencia por cada herida sufrida (si sobrevive a las heridas). Si falla un chequeo, se transformará en un Engendro del Caos con la Marca del Caos absoluto(retira la miniatura como baja y reemplázala por el Engendro del Caos bajo tu control. Si la miniatura estaba unida a una unidad, abandonará la unidad inmediatamente y pasará a estar trabado en combate cuerpo a cuerpo con su antigua unidad por el lado más cercano al Conde Mordrek).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="346d-0473-d5d9-532a" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
