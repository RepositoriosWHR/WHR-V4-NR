        <infoLink id="1f85-4b56-31d1-98e6" name="Tozudez" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink id="53ce-a7e3-f71d-6784" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule"/>
        <infoLink id="dd60-51b3-24a1-6b17" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(No a Demonio o No muertos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
