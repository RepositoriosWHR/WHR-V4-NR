          <profiles>
            <profile id="425f-f216-1d18-3b23" name="Pabellón del cambio" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Al inicio de cada ronda de combate, todas las miniaturas enemigas en contacto con la unidad que incluya este estandarte sufrirá un impacto de Fuerza 3 con las reglas especiales Ataques sólo flamígeros y Ataques Mágicos.</characteristic>
              </characteristics>
