      <rules>
        <rule id="d352-e7ba-acb2-2112" name="Paria" hidden="false">
          <description>Ungrol no puede ser el General de ejercito ni beneficiarse de la Presencia inspiradora del General.</description>
        </rule>
        <rule id="2b0c-be5e-f256-9537" name="Los Bandidos Ungor" hidden="false">
          <description>La unidad de Ungors a la que se una Ungrol obtiene las reglas especiales Destruir la civilización, Disparo rápido y Emboscada (aunque Ungrol muera).</description>
        </rule>
        <rule id="01b9-cbbe-00ce-8ecc" name="Magia Ungrol Cuatrocuernos" hidden="false">
          <description>Ungrol es un hechicero de nivel 1 que siempre utiliza el Saber de Tzeentch.</description>
        </rule>
      </rules>
