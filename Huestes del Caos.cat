                <profile id="f7d2-9023-4550-1d7f" name="Coraza de bronce de Khorne" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Otorga a Kazakital la regla especial Piel escamosa (4+). Además, Kazakital podrá realizar su tirada de salvación por Aura demoníaca incluso contra Ataques mágicos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="4823-f833-3a28-dae0" name="Piel escamosa (4+)" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
