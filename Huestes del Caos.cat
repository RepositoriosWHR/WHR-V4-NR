            <entryLink id="0261-e8aa-40f8-1f3d" name="[GC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="fb11-4524-18fc-0692" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="4">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="6213-d5b6-b6c3-819b" name="Marca de Nurgle. Ogros del Caos" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink id="f173-1300-bfb0-e21d" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="4">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="ee7f-195d-a367-fa67" name="Marca de Tzeentch. Ogros del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="86fa-a2f2-d8b8-2a2f" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="f9af-d8e8-664b-fb9b" name="[GC] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="2f15-75f1-7256-e091" type="selectionEntry">
