    <selectionEntry id="8788-728a-b5b2-1e04" name="[H][GI] - Troll del caos anciano" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="increment" field="18b9-ef6f-2ff8-166a" value="1">
          <repeats>
            <repeat field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="36bb-0bce-b025-93fa" repeats="1" roundUp="false"/>
          </repeats>
