    <selectionEntry id="08ab-e05f-bf1b-7e6c" name="[H][GC][E] - Los Espadas del Caos (El Adversario)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
