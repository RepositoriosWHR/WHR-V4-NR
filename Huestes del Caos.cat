            <entryLink id="92d7-7a54-e64a-ce1b" name="[K] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="4756-cda3-950a-00a7" type="selectionEntry">
              <rules>
                <rule id="b55b-da01-01db-eb4c" name="Marca de Tzeentch. Señor de la guerra Kurgan" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial (6+, o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="7f7b-855b-d4f0-c61a" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="2608-c6f0-389f-2166" name="[K] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="cd4c-32a7-97a6-4d64" type="selectionEntry">
              <rules>
                <rule id="db3e-c482-8f02-5be9" name="Marca de Caos absoluto. Señor de la guerra Kurgan" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d7d1-6188-0460-d778" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
