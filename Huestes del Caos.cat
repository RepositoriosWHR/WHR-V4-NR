          <entryLinks>
            <entryLink id="0469-0a70-4fe8-5213" name="[GC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="08d1-684e-f1be-fa4e" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="2">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="04e8-7b78-78be-0499" name="Marca del caos absoluto. Caballeros del Caos" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="5bca-cc83-d94f-c04b" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="3038-7e03-b275-9540" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="2">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="ad74-79fc-5501-323c" name="Marca de Tzeentch. Caballeros del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros (sólo los jinetes) y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="99bf-d106-6f77-aaba" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(Sólo los jinetes)"/>
                  </modifiers>
                </infoLink>
