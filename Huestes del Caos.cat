        <infoLink id="0070-80ef-d42e-1af0" name="Impactos por carga (1D3)" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
        <infoLink id="4fe1-423f-2096-239d" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
