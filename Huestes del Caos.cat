    <selectionEntryGroup id="b005-75c8-bef3-1484" name="[GC] - Objetos hechizados. Guerreros del Caos" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b08a-c8e1-af7b-466e" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="34c4-95b6-63fd-263f" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="52e0-4642-909b-6553" name="Yelmo de incontables ojos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="758f-727d-19a7-bbdb" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f77e-db73-7d83-6863" type="max"/>
          </constraints>
          <profiles>
            <profile id="3ace-1974-058f-6f65" name="Yelmo de incontables ojos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador verá su tirada de salvación por armadura incrementada en un +1. Además, aumenta su Iniciativa a 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="3102-7035-d112-6d24" name="Poción del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f877-6e47-d8b9-7ecf" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9634-dd36-61bc-0c00" type="max"/>
          </constraints>
          <profiles>
            <profile id="e2ee-6d62-b8d7-e49a" name="Poción del caos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje puede beberla al inicio de la batalla, tras el despliegue. Tira 1D6 en la siguiente tabla: 
D6 Poción del Caos
1 Engendro del Caos: El personaje se transforma en un Engendro del Caos con la Marca del Caos apropiada. Si tu ejército incluye una unidad de Engendros del Caos con la misma Marca del Caos, puedes unirlo a ella. 
2 Fuerza demencial: Obtiene +1 a su Fuerza y la regla especial Estupidez. 
3 Llamas del Caos: Obtiene la regla especial Ataques flamígeros y un Arma de aliento de Fuerza 4 con la regla especial Ataques sólo flamígeros. 
4 Metabolismo acelerado: Obtiene la regla especial Regeneración (4+). 
5 Furia homicida: Obtiene +1 a su Fuerza, Resistencia y Ataques. 
6 Poder del Caos: Suma +1 a todos sus atributos (excepto Movimiento y Liderazgo). Al inicio de cada uno de sus turnos, debe superar un chequeo de Resistencia o sufrirá 1 herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b557-9da5-8c21-0cd7" name="Amuleto de piedra de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="dc45-9e7b-7a75-31c8" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="df5c-707b-67d9-c0f5" type="max"/>
          </constraints>
          <profiles>
            <profile id="a28d-b916-2d1b-9240" name="Amuleto de piedra de disformidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, un único dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="c59a-1505-db48-15cf" name="Favor de los dioses" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6714-9a5f-066f-485e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="86d0-3941-c60c-a648" type="max"/>
          </constraints>
          <profiles>
            <profile id="b7f6-ba12-d590-ddf7" name="Favor de los dioses" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla del Ojo de los dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
