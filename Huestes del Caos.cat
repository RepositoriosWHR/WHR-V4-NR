    <selectionEntryGroup id="63e7-a480-51b1-4df0" name="[DC] - Regalos demoníacos menores de Nurgle" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2f0e-a99c-d3f5-0b13" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9f8e-ee81-78cf-7bb7" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="f5f8-e8b9-fb04-5f8e" name="Putrefacción de Nurgle" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5b36-4c68-0bcc-fc04" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="ffa3-8c33-1e74-202c" type="max"/>
          </constraints>
          <profiles>
            <profile id="189c-275e-4a2e-96c7" name="Putrefacción de Nurgle" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Al inicio de cada fase de combate (propia y del oponente), todas las miniaturas enemigas en contacto con el demonio deberán realizar un chequeo de Resistencia: si lo fallan, sufrirán una herida que no podrá evitarse con tiradas de salvación por armadura. Si el portador es un Heraldo de Nurgle en una unidad de Portadores de Plaga de Nurgle, por cada baja causada por este regalo puedes restaurar inmediatamente una miniatura de tropa de su unidad que hubiera sido retirada previamente como baja. Las miniaturas con la Marca de Nurgle son inmunes a este efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="dace-44cf-c74c-14a9" name="Vitalidad necrótica" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="100e-cbcb-cc0f-c266" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="e557-c0e5-0905-eca5" type="max"/>
          </constraints>
          <profiles>
            <profile id="290a-f568-ddf2-ac64" name="Vitalidad necrótica" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Al inicio de cada uno de tus turnos, el demonio recupera hasta 1D3 heridas que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="183e-ebaa-47ff-0b40" name="Bendición del padre de las plagas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7c95-e028-7166-b448" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="6193-bd2f-2602-13d7" type="max"/>
          </constraints>
          <profiles>
            <profile id="8dc9-0b47-2f94-767c" name="Bendición del padre de las plagas" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Los Ataques de plaga exitosos efectuados por el portador obtendrán la regla especial Heridas Múltiples (1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="92c1-4c48-dbb6-652c" name="Gran espada de plaga" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ff4b-4b34-acb0-fcab" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="8197-9f36-4526-c795" type="max"/>
          </constraints>
          <profiles>
            <profile id="68bf-35c2-080f-f46d" name="Gran espada de plaga" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Los ataques efectuados por el demonio en cuerpo a cuerpo herirán siempre con un resultado de 2+, sin importar la Resistencia. Por cada herida causada a un enemigo en cuerpo a cuerpo por el demonio, tira 1D6: con un resultado de 5+ (o 6+ si es un Objetivo grande) la miniatura herida deberá ser retirada como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="3b82-cc54-bad4-b38d" name="[DC] - Arma demonio" hidden="false" collective="false" import="true" targetId="020b-fcbd-54b9-7c54" type="selectionEntry"/>
          </entryLinks>
          <costs>
