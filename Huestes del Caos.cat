        <selectionEntry id="26a2-8b17-a228-3ff6" name="Superioridad marcial" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="18b5-a1c3-027b-11c6" type="max"/>
