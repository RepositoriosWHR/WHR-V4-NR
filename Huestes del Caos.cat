                <cost name="pts" typeId="points" value="35.0"/>
              </costs>
            </entryLink>
            <entryLink id="9d46-8aa9-c3d8-353f" name="[GI] - Marca del caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="38c4-0f99-1e14-3cd5" type="selectionEntry">
              <rules>
                <rule id="a0ba-21b3-a959-4eb8" name="Marca de caos absoluto. Gran Shaggot" hidden="false">
                  <description>Al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses, la cual podrá repetir, y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="dd44-7a58-2d94-ea86" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="25.0"/>
              </costs>
            </entryLink>
            <entryLink id="8ff3-48ce-1d99-a875" name="[GI] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="db84-b5c7-fe44-c8b4" type="selectionEntry">
              <rules>
                <rule id="0013-9541-de6b-6775" name="Marca de Tzeentch. Ogro dragón Shaggot" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
