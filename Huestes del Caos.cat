          <selectionEntries>
            <selectionEntry id="78de-5500-9645-053d" name="Segunda tirada en la tabla de mutaciones" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ebc-6654-1ccb-b757" type="max"/>
              </constraints>
              <rules>
                <rule id="1cb4-48dc-c026-f86b" name="Segunda tirada" hidden="false">
                  <description>Puedes pagar una segunda tirada en la tabla de mutaciones al inicio de la batalla por +20 puntos.</description>
                </rule>
              </rules>
