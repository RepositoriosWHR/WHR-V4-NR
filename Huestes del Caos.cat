    <selectionEntry id="641e-4030-530d-ebaa" name="[H][DC] - Horrores azules de Tzeentch" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="7ad0-32b8-a975-a687" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="f4fe-a680-7de6-7562" name="Toque del caos" hidden="false">
          <description>Por cada miniatura retirada como baja a causa de los ataques realizados en combate por una miniatura con esta regla tira 1D6. Con un resultado de 6, puedes poner una miniatura de Horror azul de Tzeentch en la unidad que causó la herida.</description>
        </rule>
        <rule id="7988-8204-1f62-6a48" name="Insignificantes" hidden="false">
          <description>Ningún personaje puede unirse a una unidad de Horrores azules de Tzeentch.</description>
        </rule>
        <rule id="1968-06e2-e1ec-f837" name="Proyectar llamas" hidden="false">
          <description>Los Horrores azules de Tzeentch pueden proyectar llamas; se trata como un arma de disparo con alcance de 12”, Fuerza 3 y las reglas especiales Disparo rápido, Arrojadiza y  Ataques sólo flamígeros.</description>
        </rule>
      </rules>
