            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="43a5-0901-cf33-8cd9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="387d-e97b-3510-26f5" type="max"/>
          </constraints>
          <profiles>
            <profile id="e6d5-c168-0b92-9374" name="Vientos del Caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Los Vientos del Caos disparan como un Lanzallamas (puede disparar aunque el personaje mueva o marche) que puede estimar hasta 3 dados. Se resuelve con Fuerza 8, tira para herir contra el Liderazgo del objetivo en lugar de contra su Resistencia y no permite tirada de salvación por armadura; cualquier unidad que sufra al menos una baja por esto deberá realizar inmediatamente un chequeo de Pánico. Si obtienes un resultado de Problemas, el disparo simplemente no se realiza (no tires en la tabla de Problemas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5924-d38f-67c7-ef0b" name="Lanzallamas" hidden="false" targetId="b67f-988d-ab4b-1806" type="rule"/>
          </infoLinks>
