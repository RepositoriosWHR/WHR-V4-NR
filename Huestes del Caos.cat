    <selectionEntry id="37bd-b65f-02e4-8735" name="[H][DC][E] - Amon´Chakai" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="046a-1c36-705e-1c0e" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="7ad0-32b8-a975-a687" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f0b5-991d-1875-a6a2" type="max"/>
      </constraints>
      <rules>
        <rule id="8a78-5907-d99f-32aa" name="Descarga ígnea" hidden="false">
          <description>Se trata de un ataque a distancia de alcance 18” que se resuelve con Fuerza 5 y las reglas especiales Disparo rápido, Disparos múltiples (1D3+1) y Ataques sólo flamígeros.</description>
        </rule>
        <rule id="3cfa-2436-19a0-594c" name="Magia Amon´Chakai" hidden="false">
          <description>Amon&apos;Chakai es un hechicero de nivel 5 que conoce todos los hechizos de los Saberes del Fuego, Tzeentch y Magia Oscura.</description>
        </rule>
        <rule id="ec04-d8d7-6205-ec22" name="Maestro de la hechicería" hidden="false">
          <description>Amon&apos;Chakai puede repetir las tiradas de lanzamiento de hechizo. Deberás repetir todos los dados o ninguno. Amon&apos;Chakai ignora las Disfunciones mágicas y no ve interrumpida su concentración por fallar un intento de lanzamiento de hechizo o dispersión.</description>
        </rule>
        <rule id="068e-1181-d987-4a54" name="Señor de la magia" hidden="false">
          <description>Amon&apos;Chakai tiene un bonificador de +1 a todas sus tiradas de lanzamiento de hechizos.</description>
        </rule>
        <rule id="ea1e-e440-bc60-1e02" name="Odio a Nurgle" hidden="false">
          <description>Amon&apos;Chakai tiene la regla especial Odio a miniaturas con la regla especial Demonio (Nurgle) o la Marca de Nurgle, así como a todas las tropas skaven del Clan Pestilens. Ninguna miniatura con la regla Demonio (Nurgle) o la Marca de Nurgle podrá beneficiarse de la Presencia inspiradora de Amon&apos;Chakai.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="96d0-706c-edc8-2575" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="fe5b-ddb1-fa33-43c8" name="Gran demonio" hidden="false" targetId="4c7f-1ee2-8c86-3f3a" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Tzeentch)"/>
          </modifiers>
        </infoLink>
        <infoLink id="4cec-aedb-1b5a-94eb" name="Demonio" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule"/>
        <infoLink id="e990-82bd-7a67-f03c" name="Leyenda" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink id="04e5-a9bc-07cc-27ed" name="Volar (9)" hidden="false" targetId="8bfa-11eb-3e8e-c083" type="rule"/>
        <infoLink id="75f7-8b0c-846d-3927" name="Señor del conocimiento" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Fuego, Tzeentch y Magia Oscura)"/>
          </modifiers>
        </infoLink>
        <infoLink id="fc82-4d1d-6202-74e2" name="Odio" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Nurgle y Clan Pestilens)"/>
          </modifiers>
        </infoLink>
