          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="99b5-78d8-112a-202d" type="max"/>
      </constraints>
      <rules>
        <rule id="4e53-7020-1abd-12ed" name="Arremetida" hidden="false">
          <description>Si en su tirada decarga (o de arrasamiento exitoso) obtienen al menos un resultado de 5 o 6, las miniaturas con esta regla especial obtienen la regla especial Impactos por carga (1) para la próxima fase de combate cuerpo a cuerpo en la que participen.</description>
        </rule>
        <rule id="c0c8-dbfe-a69b-6a5a" name="Paladines de Nurgle" hidden="false">
          <description>Al inicio de cada combate, los Caballeros de la plaga pútrida podrán elegir si combaten con Armas emparejadas, Arma a dos manos o Arma de mano y Escudo.</description>
        </rule>
        <rule id="f945-58e7-b535-ebe7" name="Cábala de guerreros abotargados" hidden="false">
          <description>Ningún personaje puede unirse a una unidad de Caballeros de la plaga pútrida salvo un Rey de la plaga pútrida.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="aa70-e108-4e97-7877" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink id="4314-7b3a-eba0-69a2" name="Infantería monstruosa" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink id="e344-d0d5-ed35-ca71" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
      </infoLinks>
