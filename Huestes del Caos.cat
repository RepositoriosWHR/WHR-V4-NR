    <selectionEntry id="0f5d-b736-6900-f6f5" name="[H][DC] - Heraldo del caos absoluto" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="7ad0-32b8-a975-a687" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="46ee-2ebd-e689-bd1d" name="Focos del caos absoluto" hidden="false">
          <description>Los Demonios a 12&quot; o menos de un Heraldo del Caos Absoluto no sufren animosidad; además, si un Heraldo del Caos Absoluto se une a una unidad de Furias del Caos, ambos podrán repetir sus tiradas fallidas para impactar durante el turno en que carguen.</description>
        </rule>
        <rule id="eaab-ee92-fb06-b8ae" name="Heraldo del caos absoluto" hidden="false">
          <description>No puede unirse a una unidad de Demonios que sirva a uno sólo de los Dioses del Caos.</description>
        </rule>
        <rule id="720e-9371-ba67-4fde" name="Magia heraldo del caos absoluto" hidden="false">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="0f5d-b736-6900-f6f5" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="fb9d-b268-3c21-b831" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
          <description>Puede convertirse en hechicero de nivel 1 por un coste de +35 puntos; o en un hechicero de nivel 2 por +70 puntos. Elegirá sus hechizos del saber de Magia Oscura</description>
        </rule>
      </rules>
      <infoLinks>
