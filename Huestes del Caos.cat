          </constraints>
          <entryLinks>
            <entryLink id="9579-e134-8032-be31" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="55c6-aa28-50a7-bc61" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="dacd-36f0-3ae4-097a" type="min"/>
              </constraints>
              <rules>
                <rule id="9d5f-a30a-e53d-0e07" name="Marca del Caos absoluto. Morghur" hidden="false">
                  <description>Morghur porta la Marca del Caos absoluto, que le proporciona un bonificador de +1 a su Piel escamosa; puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la Civilización.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
