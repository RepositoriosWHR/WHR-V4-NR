            <entryLink id="0b85-d189-d440-f334" name="[DC] - Demonio Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="6a9f-ae0a-4372-e422" type="selectionEntry">
              <rules>
                <rule id="abb6-d985-9cbc-c68d" name="Almizcle Soporífero" hidden="false">
                  <description>Las miniaturas enemigas en contacto con al menos una miniatura con esta regla verán sus atributos de M, HA e I reducidos en un punto. Las miniaturas con la regla especial Demonio, No muerto o que posean la marca de Slaanesh son inmunes a esta regla especial.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="c51b-0c74-9a24-7cb0" name="[DC] - Demonio Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="2992-a073-722a-f984" type="selectionEntry">
              <rules>
                <rule id="3725-ee10-c2b9-8a8d" name="Descarga ígnea" hidden="false">
                  <description>ataque de disparo con alcance 18”, Fuerza 4 y las reglas especiales Disparos múltiples 1D3, Ataques sólo flamígeros y Disparo rápido</description>
                </rule>
                <rule id="7984-1078-e63e-bae7" name="Demonio Tzeentch. Demonio mayor" hidden="false">
                  <description>Obtiene las reglas especiales Demonio (Tzeentch) y Descarga ígnea. Debe elegir al menos 1 nivel de magia.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
          </entryLinks>
