            <entryLink id="6e80-9b8b-db74-e332" name="[BC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="824e-e35c-ef47-ee81" type="selectionEntry">
              <rules>
                <rule id="c682-f910-8c1e-0116" name="Marca de Tzeentch. Minotauro destripador" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="ca9a-a1d9-411d-4171" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
