    <selectionEntry id="c228-f5a5-c188-8745" name="[H][BC][E] - Garralunar, hijo de Morrslieb" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2a81-6a0c-edfa-b306" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="74e6-b415-e85b-d78e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b0b5-d6ce-b916-bf39" type="max"/>
      </constraints>
      <rules>
        <rule id="bf20-5b9c-4dd4-9c92" name="Aura de Demencia" hidden="false">
          <description>Todas las unidades (amigas o enemigas) situadas a 12” o menos de Garralunar se verán afectadas por la regla especial Estupidez. Esta regla no afectará ni a Garralunar ni a Umbralok.</description>
        </rule>
        <rule id="4f13-52e5-022c-751c" name="Resistencia del Caos" hidden="false">
          <description>Garralunar es  inmune a la regla especial Heridas múltiples y todos los impactos contra él tendrán un penalizador de -1 en su tirada para herir. Además, cada vez que Garralunar sea objetivo de un hechizo, el hechicero que lo lance sufrirá una Disfunción mágica con cualquier tirada de dobles en su tirada de lanzamiento.</description>
        </rule>
        <rule id="3dc4-639a-7388-b1c5" name="Magia de Garralunar" hidden="false">
          <description>Garralunar es un hechicero de nivel 1. Siempre utiliza el Saber de los Cielos. </description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d744-7673-c1f6-9b86" name="Astados" hidden="false" targetId="1f1e-14b7-0ad7-466d" type="rule"/>
        <infoLink id="3616-67ed-c187-d0fe" name="Destruir la civilización" hidden="false" targetId="ed28-cb7d-82d1-73d5" type="rule"/>
        <infoLink id="3eda-e1bc-2b59-e2d4" name="Cruzar (bosques)" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
