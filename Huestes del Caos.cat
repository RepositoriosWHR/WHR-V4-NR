              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo unidades o personajes con la Marca de Tzeentch. La unidad obtiene una tirada de salvación especial de 6+, o +1 si ya disponían de ella.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="7d81-aeb5-bc31-87b6" name="[K] - Estandartes mágicos. Reliquias. Kurgan" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f480-7810-4cb6-923c" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="86ec-6f2f-2348-8759" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="2784-8b64-1041-8fdc" name="Estandarte de la Gran Bestia del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4cfc-d2d2-aad8-762a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e0b6-c16f-daf0-e1ed" type="max"/>
          </constraints>
          <profiles>
            <profile id="6fc5-ea90-ba89-c1fb" name="Estandarte de la Gran Bestia del Caos" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los miembros de la unidad verán aumentado en 1 su atributo de Ataques (no afecta a las monturas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="7833-d067-d088-8e60" name="[K] - Objetos hechizados. Kurgan" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="adfb-2336-486c-7abf" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fa76-628f-bf4f-36b3" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="8daa-b13a-3c12-ddf6" name="Brebaje berserker" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="962d-0011-5a05-1f59" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6262-527f-fa44-b836" type="max"/>
          </constraints>
          <profiles>
            <profile id="c42c-c940-c50f-abc9" name="Brebaje berserker" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al comienzo de cualquier fase de combate cuerpo a cuerpo. Hasta el final de la fase, el portador obtiene 1D6 Ataques adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="150e-60ba-b90e-0f4a" name="Poción del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b25f-cd2c-e1c6-1af7" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8cfc-f728-2677-d988" type="max"/>
          </constraints>
          <profiles>
            <profile id="5412-9b51-f2b6-2b87" name="Poción del Caos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje puede beberla al inicio de la batalla, tras el despliegue. Tira 1D6 en la siguiente tabla: 
D6 Poción del Caos
1 Engendro del Caos: El personaje se transforma en un engendro del Caos con la marca apropiada. Si tu ejército incluye una unidad de engendros con la misma marca, puedes unirlo a ella.
2 Fuerza demencial: obtiene +1 F y Estupidez.
3 Llamas del Caos: Ataques flamígeros y Arma de aliento (F4, Ataques flamígeros)
4 Metabolismo acelerado: Regeneración (4+).
5 Furia homicida: el portador obtiene +1 F, R y A.
6 Poder del Caos: El portador suma +1 a todos sus atributos (excepto M y L). Al inicio de cada uno de sus turnos debe superar un chequeo de Resistencia o sufrirá 1 herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bcc9-6405-40a1-4931" name="Estupidez" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
            <infoLink id="45bb-3b07-2d01-3349" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink id="38c6-ecc1-4787-3347" name="Regeneración (4+)" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
            <infoLink id="83b8-ff08-0fdb-14ed" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(F4, Ataques flamígeros)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="eb03-29bf-8d83-4531" name="Brazaletes de la brutalidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1a6f-5572-bf50-1d8f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2b38-4365-3bcc-9bbb" type="max"/>
          </constraints>
          <profiles>
            <profile id="cea6-6a50-853f-eae7" name="Brazaletes de la brutalidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 1D6. Contiene un hechizo de potenciación que puede lanzarse sobre una unidad amiga a 12” o menos del portador, y permanece un turno. Por la duración del conjuro, la unidad tendrá un bonificador de +1F</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="890f-6bd4-7da1-8b0f" name="Amuleto de piedra de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a01e-0242-f5ce-3979" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="21c8-0ca9-3254-87e6" type="max"/>
          </constraints>
          <profiles>
            <profile id="000d-59df-d5e5-4b5d" name="Amuleto de piedra de disformidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, canalizar, un único dado de energía o dispersión, o una tirada en la tabla de disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d09a-75bf-3f56-593f" name="Favor de los Dioses" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5383-9033-2a1a-1b49" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e79f-6f6b-09ab-4565" type="max"/>
          </constraints>
          <profiles>
            <profile id="758c-7c49-032c-50fa" name="Favor de los Dioses" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla de El Ojo de los Dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="5c3f-dfe4-9466-c6c1" name="[K] - Objetos hechizados. Kurgan. Caudillo o Señor de la guerra" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7c9a-3f50-e22f-250e" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d40a-da37-f5c7-e2d3" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="c976-685a-f91f-d779" name="Juramento de guerra" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="02a0-fdbc-7785-e8f7" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9e28-e6a6-5de3-ec55" type="max"/>
          </constraints>
          <profiles>
            <profile id="2828-6d3c-b483-0173" name="Juramento de guerra" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Caudillo o Señor de la Guerra. El personaje y su unidad obtienen las reglas especiales Odio (¡todos los enemigos!) y Furia asesina, y no perderán su Furia asesina aunque sean derrotados en combate. Sin embargo, siempre se considera que su valor de Liderazgo es la mitad (redondeando hacia arriba) para los chequeos de Liderazgo para evitar cargar debido a su Furia asesina.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="82f9-7ee0-6267-db6f" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
            <infoLink id="1412-b964-b30f-14ba" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="cd90-0aea-1761-1ffd" name="[K] - Objetos hechizados. Kurgan. Khorne" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a6f0-307a-778a-4811" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8381-d5e4-c873-0519" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="77ee-cbfe-250f-44a7" name="Cuenco sangriento de Chron" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cc0d-47d0-57ac-d054" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="76e4-204c-c20f-5b05" type="max"/>
          </constraints>
          <profiles>
            <profile id="1b00-4b67-368d-c32e" name="Cuenco de Chron" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Khorne. Si el portador se une a una unidad de Guerreros Kurgan o Jinetes Kurgan con la Marca de Khorne, éstos obtendrán la regla especial Furia asesina mientras el personaje esté unido a ellos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="992c-9b00-37e9-1dcc" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="86e7-fda9-6ff7-e4ef" name="[K] - Objetos hechizados. Kurgan. Nurgle" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dbf4-67c1-309e-2183" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="eeac-b8cd-52e3-caaa" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="cbf7-2d97-c227-19af" name="Cráneos de muerte" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="24f2-7958-dfe3-45a4" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3f1d-ca42-d71f-89ba" type="max"/>
          </constraints>
          <profiles>
            <profile id="886c-c4fa-dd48-c8ac" name="Cráneos de muerte" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Nurgle. El portador puede utilizar los cráneos en cada fase de disparo si no está trabado en combate, aunque no para aguantar y disparar. Tiene un alcance máximo de 8”, y utiliza la plantilla redonda pequeña. Coloca la plantilla redonda pequeña a 8” o menos del portador, y tira los dados de artillería y dispersión como si estuvieses disparando una catapulta, aunque si se dispersa, lo hará la mitad de la distancia indicada en el dado de artillería. Cualquier miniatura bajo la plantilla deberá efectuar un chequeo de Resistencia o sufrir una herida sin tirada de salvación por armadura. Si obtienes un resultado de problemas, retira la plantilla sin causar ningún efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1606-08da-ebf8-42a6" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="8f14-226a-5824-2506" name="[K] - Objetos hechizados. Kurgan. Slaanesh" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1d77-763f-486a-6032" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="144f-abcb-e5fa-a5a8" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="dbc0-6c21-5985-9b52" name="Colgante de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a5d2-f38b-f7f2-2f72" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b9b0-aa00-151c-cd58" type="max"/>
          </constraints>
          <profiles>
            <profile id="0744-7b6d-ef35-f733" name="Colgante de Slaanesh" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Slaanesh. Por cada herida que sufra el portador, su atributo de ataques aumenta permanentemente en un punto (hasta un máximo de 10).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="f000-d8c4-8834-2f87" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="fb8d-f4bf-dc52-539a" name="[K] - Objetos hechizados. Kurgan. Tzeentch" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c61f-627b-b0b7-5979" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8bd3-302a-0c05-ed5a" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="f31c-91b5-f4ee-8c05" name="Máscara de la tribu del águila" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4ddf-d140-3bf2-91b9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ab40-c45d-fd42-8a8c" type="max"/>
          </constraints>
          <profiles>
            <profile id="bea4-8afc-6660-6815" name="Máscara de la tribu del águila" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la marca de Tzeentch. El portador causa Terror. Además, la máscara es un Objeto portahechizos con nivel de energía 1D6+1; contiene un hechizo de maldición que puede lanzarse sobre una unidad enemiga a 18” o menos del lanzador y permanece un turno. Por la duración del conjuro, el valor de Liderazgo de todos los miembros de la unidad se verá reducido a la mitad (redondeando hacia arriba), y no pueden hacer uso de Presencia inspiradora.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="c7ce-89f6-9e26-6949" name="[K] - Recompensas del Caos menores. No hechicero/Khorne" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="93e1-e454-4146-7049" name="Hechicería del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9b14-35cb-1409-3ba0" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4464-4b54-afde-4bca" type="max"/>
          </constraints>
          <profiles>
            <profile id="b191-3808-9238-4df3" name="Hechicería del Caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="7460-94d9-cbcf-2fcf" name="Clave: Hechicero" hidden="false" collective="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
