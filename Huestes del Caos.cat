      <constraints>
        <constraint field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ff86-caaa-3bf1-ad26" type="max"/>
      </constraints>
      <rules>
        <rule id="b36d-44ed-dfe5-26d8" name="Magia Troll bilioso anciano" hidden="false">
          <description>Puede convertirse en hechicero de nivel 1 por +40 puntos o en hechicero de nivel 2 por +70 puntos. Siempre utiliza el Saber de Nurgle.</description>
        </rule>
        <rule id="d5e2-aaa5-30d5-25f2" name="Vómito bilioso del troll anciado bilioso" hidden="false">
          <description>En lugar de atacar en combate cuerpo a cuerpo, un Troll bilioso anciano puede elegir causar 1D3+1 impactos automáticos de Fuerza 5 a una unidad enemiga en contacto peana con peana. Estos impactos no permiten tirada de salvación por armadura y tienen la regla especial Ataques mágicos.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="ed68-c476-e2a8-7f7c" name="Infantería monstruosa" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
