            <entryLink id="c122-00dc-5980-d4a6" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
              <rules>
                <rule id="49e6-55e8-cd9c-f6f4" name="Marca de Tzeentch. Bruto despedazador" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="77e7-d64c-2426-d596" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
