            <entryLink id="ac36-d4db-dd8a-172a" name="[BC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="1915-0c28-504c-dc89" type="selectionEntry">
              <rules>
                <rule id="7b5d-5bc7-4c7c-48ed" name="Marca de Tzeentch. Gigante del Caos" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="95fc-d1f9-e1e3-6d52" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
