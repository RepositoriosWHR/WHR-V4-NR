            <entryLink id="e417-04a6-38b7-4440" name="[GC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="fea9-b5e3-cb0b-441d" type="selectionEntry">
              <rules>
                <rule id="ebe5-e8a7-eb51-b380" name="Marca de Tzeentch. Paladín del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="4728-383d-b2bd-dff6" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
