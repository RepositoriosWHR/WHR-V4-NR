        <rule id="be3a-ba44-8560-34fb" name="Bandada de muerte" hidden="false">
          <description>La unidad de Arpías a la que se une Shyishet obtiene la regla especial Esquivar (5+).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d401-7f68-41db-341c" name="Esquivar (5+)" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
