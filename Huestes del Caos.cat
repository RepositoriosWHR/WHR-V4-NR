          <description>Cada vez que una unidad con la regla especial Demonio (Khorne) a 12” de un Carruaje de guerra de Khorne pierda un combate y falle su chequeo de Inestabilidad, sufrirá una herida menos de las indicadas por la tirada. El efecto de varios Carruajes de guerra de Khorne es acumulativo.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="4fd6-c6eb-ffd2-61b6" name="Carro" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink id="a2c8-598f-956f-00a7" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
        <infoLink id="8abe-d4ff-2f9f-827d" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Sólo desangrador)"/>
          </modifiers>
        </infoLink>
        <infoLink id="d406-376c-b684-b7df" name="Protección por montura (2)" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
        <infoLink id="333f-13ab-27b6-3218" name="Impactos por carga" hidden="false" targetId="a89f-5611-61e4-f924" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Sólo Juggernatur; en total 1D6+2)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
