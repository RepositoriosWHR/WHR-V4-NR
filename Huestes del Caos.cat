            <entryLink id="4b83-1a99-7a59-a550" name="[GC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="08d1-684e-f1be-fa4e" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="4">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="1e6e-fad5-b38c-bcb1" name="Marca del Caos absoluto. Ogros del Caos" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología. Además, al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad durante la batalla; considera los resultados de 2 como 3.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="27eb-e450-38bc-efa6" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
