    <selectionEntry id="5968-6a66-83e0-018f" name="[H][K] - Catapulta de asedio Kurgan" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a2dc-4181-2326-51c9" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="5714-3b88-a930-4398" type="max"/>
      </constraints>
      <rules>
        <rule id="243c-8020-d09f-4c9a" name="Catapulta de asedio kurgan" hidden="false">
          <description>La catapulta de asedio Kurgan dispara como una catapulta con un alcance de 12-60”; al disparar puedes elegir realizar un disparo normal de catapulta (tal y como se describe en el reglamento, con la plantilla redonda pequeña y F4, y el impacto central con F8 y Heridas múltiples 1D6) o utilizar el efecto de disparo especial descrito en su Marca del Caos. Cualquier unidad que sufra al menos una baja a causa del disparo de una Catapulta de asedio Kurgan deberá efectuar inmediatamente un chequeo de pánico.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="8cf7-3749-c0b4-5425" name="Máquina de guerra" hidden="false" targetId="48ca-c3bc-f385-15fc" type="rule"/>
        <infoLink id="e9f6-f4b3-e940-5374" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
        <infoLink id="c59f-f7b3-42b2-4268" name="Catapulta" hidden="false" targetId="7168-c1ae-bc9c-15df" type="rule"/>
      </infoLinks>
      <categoryLinks>
