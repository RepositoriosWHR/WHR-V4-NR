                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="bdf3-8c95-d835-62c1" name="[GI] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="ff62-9412-73a7-b3d9" type="selectionEntry">
              <infoLinks>
                <infoLink id="baa9-b00e-051a-63f2" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="5cdb-c7e2-0e99-de45" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
