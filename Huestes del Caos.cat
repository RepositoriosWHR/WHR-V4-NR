            <entryLink id="4e40-e368-05a9-9940" name="[K] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="4756-cda3-950a-00a7" type="selectionEntry">
              <rules>
                <rule id="f56c-e79b-6cb6-ec87" name="Marca de Tzeentch. Señor de la guerra Kurgan" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="13c3-b973-4b6e-6685" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
