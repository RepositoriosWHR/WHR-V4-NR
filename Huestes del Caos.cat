          </constraints>
          <rules>
            <rule id="0209-0591-347c-2704" name="Marca de Nurgle. Valnir" hidden="false">
              <description>Le otorga la regla especial Inmune a veneno, los enemigos 
tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su 
Habilidad de armas.</description>
            </rule>
          </rules>
          <infoLinks>
