              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene un Arma de aliento de Fuerza 3 con la regla especial Ataques sólo flamígeros.</characteristic>
              </characteristics>
