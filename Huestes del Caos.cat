              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="2115-d83d-681d-050b" name="[GC] - Marca del Caos absoluto. Pesonajes" hidden="false" collective="false" import="true" targetId="82f2-d2ab-17e8-72cb" type="selectionEntry">
              <rules>
                <rule id="1a80-b4bd-bfb3-c2b7" name="Marca del Caos absoluto. Paladín del Caos" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="8289-7344-6cbf-2b4d" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
