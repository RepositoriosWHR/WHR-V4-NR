              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="801f-92b8-f6c1-2c6b" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <rules>
                <rule id="abe4-107a-ab31-354b" name="Marca de Nurgle.  Bestia maldita" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
