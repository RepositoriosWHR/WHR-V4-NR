      </constraints>
      <rules>
        <rule id="4385-1aa0-c3b3-cf8a" name="Parias" hidden="false">
          <description>Los mutantes no provocan chequeos de Pánico en otras unidades amigas. Ningún personaje puede unirse a una unidad de Mutantes del Caos.</description>
        </rule>
        <rule id="c55b-8bc8-e274-d8d5" name="Sabotaje" hidden="false">
          <description>Tras el despliegue, por cada unidad de Mutantes del Caos de tu ejército puedes elegir una unidad enemiga: dicha unidad se considerará que ha movido a efectos de disparar y no podrá marchar; ambos efectos se aplican únicamente durante el primer turno de juego.</description>
        </rule>
      </rules>
