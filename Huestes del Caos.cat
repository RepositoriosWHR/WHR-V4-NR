        </selectionEntry>
        <selectionEntry id="8bec-22f7-f6c3-2509" name="Rapidez de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="15fb-03cd-9cb0-58ad" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="cb77-917b-8dbc-2440" type="max"/>
          </constraints>
          <profiles>
            <profile id="2e3f-ae20-7055-08da" name="Rapidez de Slaanesh" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje duplica su atributo de Iniciativa, hasta un máximo de 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
