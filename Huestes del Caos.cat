    <selectionEntry id="42d1-55b2-e546-263c" name="[H][GC][E] - Aekold Helbrass, señor de Elíseo" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="cfdb-4c42-1553-dbc4" value="1">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="edf5-330a-1cd6-725f" type="equalTo"/>
