          </constraints>
          <entryLinks>
            <entryLink id="d822-4a8a-cec0-19ea" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <rules>
                <rule id="952d-e911-cdf5-ec67" name="Marca del Caos absoluto. Minotauro de condenación" hidden="false">
                  <description>Obtiene la regla especial Inmune a Pánico y mejora su regla especial Piel escamosa a 5+. Puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="83a2-435f-61f7-6add" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="bf33-a5cb-d706-b89c" name="Piel escamosa (5+)" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="1362-2457-9aa9-e281" name="[BC] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="5a59-366d-b4b0-6581" type="selectionEntry">
