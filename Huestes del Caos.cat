            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6d0c-5b3a-337c-28ce" name="Estandarte de la perdición humana" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ea7b-6ca1-1152-c584" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="03ee-0787-ae44-40a4" type="max"/>
          </constraints>
          <profiles>
            <profile id="2ecf-1dc4-e7c7-08c2" name="Estandarte de la Perdición Humana" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades con la clave humanos en contacto peana con peana con el portador del estandarte o su unidad tendrán un penalizador de -1 a su Liderazgo. Además, el portador y su unidad podrán repetir los resultados de 1 en sus tiradas para herir contra miniaturas con la clave humanos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="33ad-4fb0-142b-18e8" name="Estandarte de los Cuernos" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5057-aac9-30f8-ee53" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9d38-5aff-1720-fa16" type="max"/>
          </constraints>
          <profiles>
            <profile id="d325-5d64-dff6-b1f0" name="Estandarte de los Cuernos" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad en la que se encuentre aumentan en 1 sus Impactos por carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="3bb7-0e25-acab-9210" name="Impactos por carga (1)" hidden="false" targetId="8de0-8a91-edee-076e" type="rule"/>
          </infoLinks>
