      <rules>
        <rule id="e06e-c142-6afa-a459" name="Bandada de engendros" hidden="false">
          <description>La unidad de Engendros del Caos de obligatoria inclusión por Ngaaranh obtiene la regla especial Poder de penetración.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6d14-1323-e93c-ac1a" name="Bestia monstruosa" hidden="false" targetId="2e1e-da3a-8081-991c" type="rule"/>
        <infoLink id="b79e-bed2-0ca0-b254" name="Movimiento aleatorio (3D6)" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
        <infoLink id="e42a-58e2-d516-bb23" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(2D6+1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="a1ff-0e21-76b1-e406" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
