          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="cb18-b77b-b813-91f2" name="Magia Gran hechicero del caos" hidden="false">
          <description>Es un hechicero de nivel 3. Puede convertirse en hechicero de nivel 4 por +55 puntos. Puede elegir sus hechizos de entre los Saberes de la Muerte, de los Cielos, del Fuego, de las Sombras, de Magia Oscura y/o del Saber de su Dios del Caos y puede elegir sus hechizos de dos o más de los saberes listados.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d5ca-8efe-7263-0ea3" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
