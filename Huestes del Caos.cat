        <infoLink id="a45e-7843-4715-9bf7" name="Movimiento aleatorio (3D6)" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
        <infoLink id="60c4-522a-af26-83b2" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(2D6+2)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
