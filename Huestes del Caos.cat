            <entryLink id="a6cd-0b78-7eaf-f34d" name="[GI] - Marca del caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="38c4-0f99-1e14-3cd5" type="selectionEntry">
              <rules>
                <rule id="c620-cdfa-8c0f-e5e6" name="Marca de caos absoluto. Ogro dragón Shaggot" hidden="false">
                  <description>Al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses, la cual podrá repetir, y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="eb97-8ec0-621d-0ee7" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="37cf-4cdd-14d8-86ae" name="[GI] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="db84-b5c7-fe44-c8b4" type="selectionEntry">
              <rules>
                <rule id="e8a0-5fb9-8fd2-3b96" name="Marca de Tzeentch. Ogro dragón Shaggot" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="794a-34d2-c52e-220c" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="6b42-34ac-875a-bccb" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
          </entryLinks>
