    <selectionEntry id="5fdb-fd79-8b60-51ad" name="[H][GC] - Engendros del Caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="9be6-d6d8-4abb-42c7" type="max"/>
      </constraints>
      <rules>
        <rule id="a283-3246-2e78-22cd" name="Bestia sin mente" hidden="false">
          <description>Los Engendros del Caos no pueden tomar objetivos ni cuentan nunca como unidades que puntúan en determinados escenarios, como Romper la línea o Defensa a ultranza (no puntúan ni para el jugador que los controla ni para el oponente).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="0232-754d-e20d-029e" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1D6+1)"/>
