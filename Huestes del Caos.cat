            <repeat field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="04d1-3fd6-ad8b-1059" repeats="1" roundUp="false"/>
          </repeats>
        </modifier>
