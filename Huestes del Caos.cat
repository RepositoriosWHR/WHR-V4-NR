          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="bf65-1c9f-84fb-4631" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f587-8390-3703-ffa7" type="max"/>
          </constraints>
          <profiles>
            <profile id="112d-0b25-1b68-bc4e" name="Estandarte de las legiones del Caos" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo unidades de Infantería. Al final de cada fase de disparo, magia y combate cuerpo a cuerpo, tira 1D6 por cada baja que haya sufrido la unidad en esa fase. Con cada resultado de 6, puedes volver a colocar uno de los demonios retirados como baja esa fase. Este efecto puede traer de vuelta a un oficial muerto, pero no a un personaje dentro de la unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
