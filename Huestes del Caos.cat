        <rule id="4cb4-b0f3-130c-74d1" name="Vanidad suprema" hidden="false">
          <description>Sigvald tiene las reglas especiales Estupidez y Tozudez.</description>
        </rule>
        <rule id="1c6b-b59f-2abb-fb92" name="Hijo predilecto" hidden="false">
          <description>Sigvald y cualquier unidad a la que se una obtienen la regla especial Cruzar (todo tipo de terreno excepto Edificios y Terreno intransitable).</description>
        </rule>
      </rules>
