                <infoLink id="93fc-1429-52b0-278e" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
                <infoLink id="3e51-c5e4-ad26-398e" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
