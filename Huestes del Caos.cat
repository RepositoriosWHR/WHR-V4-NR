                  </modifiers>
                </infoLink>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="5.0"/>
              </costs>
            </entryLink>
            <entryLink id="a5ad-3925-4d87-8f28" name="[BC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="e5c2-8b13-3efc-3585" type="selectionEntry">
              <rules>
                <rule id="73cd-2c79-8485-3b66" name="Marca de Nurgle. Carro de garragor" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="5.0"/>
              </costs>
            </entryLink>
