            <entryLink id="8cc6-a6c0-9d3d-5092" name="[GC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="08d1-684e-f1be-fa4e" type="selectionEntry">
              <rules>
                <rule id="4694-f64a-9c8f-f6dc" name="Marca del Caos absoluto. Carruaje del Caos" hidden="false">
                  <description>Obtiene la regla especial Inmune a psicología. Además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado al carro toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f7ef-c6d7-3298-9a70" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
