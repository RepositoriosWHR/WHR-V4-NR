            <entryLink id="077e-b785-4750-315e" name="[BC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="1915-0c28-504c-dc89" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="3">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="a1eb-2a21-939c-e22a" name="Marca de Tzeentch. Minotauros" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="6eca-01a2-a571-27b3" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="a2ad-8627-0856-beda" name="[BC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="e5c2-8b13-3efc-3585" type="selectionEntry">
