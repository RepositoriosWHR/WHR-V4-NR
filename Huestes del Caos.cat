                <cost name="pts" typeId="points" value="30.0"/>
              </costs>
            </entryLink>
            <entryLink id="87ce-1285-cc77-06fe" name="[GI] - Marca de Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="718b-c2a0-a578-4f9b" type="selectionEntry">
              <infoLinks>
                <infoLink id="616b-7b4a-5b91-7a08" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="f810-8a70-ddd0-0932" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink id="5b30-729d-3397-a45a" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
              </infoLinks>
