            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8e6a-bfd1-8974-d1f8" type="max"/>
          </constraints>
          <profiles>
            <profile id="59bb-8797-6691-8520" name="Hechicería del Caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="b9c4-65b4-1648-fc7f" name="Clave: Hechicero" hidden="false" collective="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="8707-7689-2f9f-359c" name="[GI] - Recompensas del Caos menores. No hechicero/Khorne" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="0f4a-f337-8ac1-4a38" name="Hechicería del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="01fc-ce1f-6984-89a4" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8c9a-f6ac-5890-5657" type="max"/>
          </constraints>
          <profiles>
            <profile id="457a-b80e-e4b5-7d9c" name="Hechicería del Caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="7a4c-9db4-781e-7361" name="Clave: Hechicero" hidden="false" collective="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="0000-c367-bd97-0b70" name="[GC] - Recompensas del Caos menores. No hechicero/Khorne" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="82db-0cfe-1ea2-fdde" name="Hechicería del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="139a-dd2b-a90c-3ea5" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b2ea-4a64-0958-1405" type="max"/>
          </constraints>
          <profiles>
            <profile id="b659-f002-2214-9958" name="Hechicería del Caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="e3a6-948a-0251-2a57" name="Clave: Hechicero" hidden="false" collective="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="c234-b7b5-cdc0-5b63" name="[K] - Recompensas del Caos. Infantería" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="roster" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="09d4-f6ec-3ea6-6dc3" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="194e-c81c-dbcc-9487" name="Alas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5b9f-1092-0137-65df" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="2334-501f-aeaa-945c" type="max"/>
          </constraints>
          <profiles>
            <profile id="e513-2e5b-6a03-1750" name="Alas" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo miniaturas de infantería. La miniatura gana la regla especial volar. La miniatura no puede unirse a ninguna unidad ni elegir ninguna montura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d362-eaaf-7553-6e69" name="Volar (9)" hidden="false" targetId="8bfa-11eb-3e8e-c083" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
  <sharedRules>
    <rule id="8321-bc37-6c71-e166" name="Ansia de sangre" hidden="false">
      <description>Las unidades con esta regla especial se quedan a alimentarse de los cadáveres recientes de sus enemigos tras derrotarlos, por lo que no podrán perseguir ni arrasar tras hacer huir a un enemigo en combate, ni aunque tengan también la regla especial Furia asesina. Tan sólo podrán Reorganizarse.</description>
    </rule>
    <rule id="ceac-0740-b86f-b0bd" name="Arremetida" hidden="false">
      <description>Si una unidad con esta regla especial obtiene algún resultado de 5 o 6 en su tirada de carga, cada uno de sus componentes obtendrá hasta el final del turno la regla especial Impactos por carga (1); además, si la unidad tiene al menos una fila con tres o más miniaturas detrás de su primera fila, resuelve dichos impactos por carga con un bonificador de +1 a su Fuerza.</description>
    </rule>
    <rule id="c612-b3eb-4898-9446" name="Ataque de cola" hidden="false">
      <description>Las miniaturas con esta regla especial tienen un ataque adicional (indicado en el perfil de atributos), llamado Ataque de cola. El Ataque de cola se resuelve siempre con la Fuerza básica de la miniatura y nunca se ve beneficiado por el efecto de armas mundanas o mágicas con las que la miniatura esté equipada.</description>
    </rule>
    <rule id="b4b6-941d-4db5-6c4f" name="Cólera de la tormenta" hidden="false">
      <description>Las miniaturas con esta regla especial tienen la regla especial Inmune a rayos. Si una unidad con esta regla especial es impactada por un Ataque de rayos, todos los miembros de la unidad (y los personajes que tenga dentro) obtienen la regla especial Furia asesina.</description>
    </rule>
    <rule id="84f5-b62e-6d8e-bb22" name="Envueltos en niebla" hidden="false">
      <description>Todos los disparos de proyectiles contra una unidad con esta regla especial tendrán un penalizador de -1 para impactar.</description>
    </rule>
    <rule id="eb79-6001-6960-22e0" name="General de la horda" hidden="false">
      <description>Del mismo modo que con los demás ejércitos del Caos, el personaje que elijas como General de tu ejército obtendrá un bonificador de +1 a su Liderazgo (hasta un máximo de 10), además de la regla especial Presencia inspiradora (como todos los Generales). Sin embargo, en el caso de la Grey infernal, el General del ejército y todas las unidades que puedan beneficiarse de su Presencia inspiradora obtendrán también la regla especial Impasible.</description>
    </rule>
    <rule id="ca6a-98e7-b1fd-7945" name="La vida es sueño" hidden="false">
      <description>Las miniaturas con esta regla especial tienen la regla especial Impasible. Sin embargo, ninguna miniatura con esta regla especial podrá beneficiarse de la Presencia inspiradora de un personaje con la regla especial Demonio.</description>
    </rule>
    <rule id="3639-2a5d-1be2-bcd2" name="La voluntad del Caos" hidden="false">
      <description>Las unidades con esta regla especial pueden repetir los chequeos de Pánico fallidos.</description>
    </rule>
    <rule id="d775-2334-395b-688e" name="Ojo de los dioses" hidden="false">
      <description>Los personajes con esta regla especial y la clave Paladín del Caos tienen la regla especial Orgullo marcial. Si una miniatura con esta regla especial mata a un personaje enemigo (pero no un oficial) en un Desafío o a un Objetivo grande (ya sea en combate, magia, etc) deberá tirar 2D6 en la tabla del Ojo de los dioses y aplicar inmediatamente el resultado (los efectos, a menos que se especifique, permanecen el resto de la batalla. Los resultados repetidos se consideran resultados de 3). Algunos oficiales también tienen la regla especial “Ojo de los dioses”, en cuyo caso también tienen Orgullo marcial y podrán tirar en la tabla del Ojo de los dioses si eliminan en Desafío a un oficial o personaje enemigo o si acaban con un Objetivo grande.

2D6 Ojo de los dioses
2 Engendro del Caos: El personaje se transforma en un Engendro del Caos (con la Marca del Caos apropiada). Retira al personaje y coloca al Engendro del Caos en su lugar (sácalo de su unidad si fuera necesario). 
3 El ojo está cerrado: Ninguna recompensa.
4 Reflejos sobrehumanos: El personaje obtiene +1 a su atributo de Iniciativa.
5 Aura del Caos: El personaje obtiene la regla especial Resistencia mágica (1), o +1 a su Resistencia mágica si ya disponía de ella, hasta un máximo de 3.
6 Músculos de acero: El personaje obtiene +1 a su atributo de Fuerza.
7 Poder del Caos: El personaje obtiene +1 a su atributo de Ataques. 
8 Vigor impío: El personaje obtiene +1 a su atributo de Resistencia. 
9 Vitalidad sobrenatural: El personaje obtiene la regla especial Regeneración (5+), o +1 a su Regeneración si ya disponía de ella.
10 Marcado para la gloria: El personaje puede repetir los resultados de 1 en sus tiradas para impactar y salvaciones por armadura.
11 Poder de la disformidad: El personaje obtiene +1 a sus atributos de Fuerza y Resistencia.
12 Recompensa de la demonicidad: El paladín obtiene las reglas especiales Tozudez y Aura demoníaca (4+).</description>
    </rule>
    <rule id="bfae-ee37-b288-b716" name="Regeneración mutante" hidden="false">
      <description>Las miniaturas con esta regla especial tienen la regla especial Regeneración (el valor se indica en la regla). Si regeneran 2 o más heridas en una misma fase, al final de esa fase tira en la tabla de Ojo de los dioses y aplica el resultado a toda la unidad. Considera los resultados de 2 como 3 (El ojo está cerrado).</description>
    </rule>
    <rule id="564f-ce58-9ba9-5224" name="Vómito de troll" hidden="false">
      <description>En vez de atacar, cada miniatura con esta regla especial puede causar un impacto automático de Fuerza 5 sin tirada de salvación por armadura a una miniatura enemiga en contacto peana con peana.</description>
    </rule>
    <rule id="f2a5-943e-2276-1325" name="Jinetes expertos" hidden="false">
      <description>Las unidades con esta regla especial pueden repetir sus tiradas de persecución.</description>
    </rule>
    <rule id="38e9-972d-9930-3210" name="Montura demoníaca" hidden="false">
      <description>Una miniatura montada sobre una montura con esta regla especial no es un Demonio, aunque se considera demonio a efectos de ser afectado por reglas especiales, objetos mágicos y hechizos. La miniatura causa Miedo y la montura tiene Ataques mágicos.</description>
    </rule>
    <rule id="fef4-4209-9b8a-bebc" name="Almizcle soporífero" hidden="false">
      <description>Las miniaturas enemigas en contacto con al menos una miniatura con esta regla verán sus atributos de Movimiento, Habilida de Armas e Iniciativa reducidos en un punto. Las miniaturas con la regla especial Demonio, No muerto o que posean la Marca de Slaanesh son inmunes a esta regla especial.</description>
    </rule>
    <rule id="b78b-a970-a586-e637" name="Animosidad demoníaca" hidden="false">
      <description>Al inicio de cada uno de tus turnos, deberás comprobar si hay Demonios del Caos de otro Dios del Caos a 6” o menos de cada una de tus unidades de demonios que no se encuentre trabada en combate. Si los hay, deberás tirar 1D6 en la siguiente tabla por la unidad. Si alguna de esas unidades es del Dios rival, resta 1 al resultado de la tabla (los Dioses rivales son los siguientes: Khorne es rival de Slaanesh y viceversa; Nurgle es rival de Tzeentch y viceversa). Las unidades que incluyan un personaje que no sea un oficial o los personajes 
independientes suman un +1 al resultado de esta tabla. 
1	La unidad sufre 1D3 heridas sin tirada de salvación de ningún tipo. La unidad no podrá realizar ninguna acción hasta el inicio de tu siguiente turno, salvo combatir en cuerpo a cuerpo si son atacados. 
2-3	La unidad no podrá realizar ninguna acción hasta el inicio de tu siguiente turno, salvo combatir en cuerpo a cuerpo si son atacados. 
4-6	Pueden actuar de manera normal.</description>
    </rule>
    <rule id="5021-a885-be14-93b0" name="Ataque de plaga" hidden="false">
      <description>Los resultados naturales de 6 en las tiradas para impactar herirán automáticamente (ten en cuenta que es la misma mecánica que Ataques envenenados, aunque la inmunidad a veneno no te hace inmune a Ataques de plaga)</description>
    </rule>
    <rule id="501e-dffd-8657-1591" name="Aura de fascinación" hidden="false">
      <description>Las unidades enemigas en contacto con una o más unidades con esta regla especial obtendrán un penalizador de -1 a su Liderazgo.</description>
    </rule>
    <rule id="7ae4-a9f9-c799-df27" name="Coraza infernal" hidden="false">
      <description>Tirada de salvación por armadura 3+.</description>
    </rule>
    <rule id="56e9-3708-f264-cfd6" name="Foco mortal" hidden="false">
      <description>Un Demonio mayor puede elegir un único Foco mortal (el mismo del Dios al que esté encomendado) al coste en puntos indicado. Un Foco mortal funciona del mismo modo que un Foco demoníaco normal, afectando a todos los demonios en la misma unidad que el Demonio mayor (incluyendo al propio Demonio mayor). Además, al inicio de cada uno de tus turnos, selecciona una unidad amiga de demonios a 12” o menos del Demonio mayor y que tengan la misma lealtad a un Dios del Caos que este: hasta el inicio de tu siguiente turno, dicha unidad también se beneficiará del efecto del Foco mortal.</description>
    </rule>
    <rule id="4c7f-1ee2-8c86-3f3a" name="Gran demonio" hidden="false">
      <description>Esta regla especial funciona exactamente igual que la regla especial Demonio, con las siguientes salvedades: una miniatura con esta regla especial tiene la regla especial Presencia inspiradora, que afecta a las unidades con su misma Marca del Caos. Además, su tirada de salvación por Aura demoníaca se incrementa a 4+. Ten en cuenta que la regla especial Gran demonio también tiene una lealtad, indicada entre paréntesis (ver la regla especial Siervos de los dioses).</description>
    </rule>
    <rule id="9998-c0b2-abba-545e" name="Gran demonio exaltado" hidden="false">
      <description>Una miniatura con esta regla especial tiene la regla especial Presencia inspiradora, que afecta a las unidades con su misma Marca del Caos a 24”. Además, su tirada de salvación por Aura demoníaca se incrementa a 4+. Ten en cuenta que la regla especial Gran demonio exaltado también tiene una lealtad, indicada entre paréntesis (ver la regla especial Siervos de los dioses).</description>
    </rule>
    <rule id="2b90-ec66-d245-506a" name="Ladinas" hidden="false">
      <description>Las unidades con esta regla especial pueden declarar Huir a pesar de tener la regla especial Inmune a psicología, reagruparán automáticamente y podrán actuar normalmente en la sub-fase de Resto de movimientos de ese turno.</description>
    </rule>
    <rule id="769d-78e3-eb1c-21f7" name="Nube de moscas" hidden="false">
      <description>Los enemigos tienen un penalizador de -1 para impactar en disparo y en combate cuerpo a cuerpo a unidades con esta regla especial.</description>
    </rule>
    <rule id="7783-7eb5-8091-79f9" name="Rastro legamoso" hidden="false">
      <description>Al comienzo de cada fase de combate, todas las miniaturas enemigas en contacto peana con peana con el flanco o la retaguardia de una miniatura con esta regla especial sufrirán un impacto de Fuerza 3 sin posibilidad de tirada de salvación por armadura. Las miniaturas con la Marca de Nurgle son inmunes a esta regla especial.</description>
    </rule>
    <rule id="d9a1-ee95-9ce2-945e" name="Sed de sangre" hidden="false">
      <description>Deberán declarar carga si al inicio de su turno hay alguna unidad enemiga dentro de la línea de visión y a distancia de carga a no ser que superen un chequeo de Liderazgo. Siempre deberán elegir perseguir o arrasar si tienen la posibilidad de hacerlo</description>
    </rule>
    <rule id="6134-8069-39fa-1fa5" name="Vientos de la magia desatados" hidden="false">
      <description>Si en una batalla hay presentes uno o más Grandes demonios exaltados, se deberán tirar un mínimo de 3D6 para determinar los Vientos de la magia, siendo el total en dados de Energía y el resultado mayor más el menor en dados de dispersión para el oponente. Además, las tiradas de salvación por Aura demoníaca de todos los Demonios a 18” o menos de un Gran demonio exaltado (incluyendo al propio Gran demonio exaltado) podrán efectuarse contra Ataques mágicos.</description>
    </rule>
    <rule id="0cd7-c8a1-4eaa-ef93" name="Cábala  de guerreros" hidden="false">
      <description>Ningún personaje puede unirse a una unidad con esta regla especial salvo que posea la Recompensa del Caos Elegido del Caos. El Paladín elegido tiene la regla especial Ojo de los dioses. Si muere, selecciona un Elegido de la unidad, que ganará la regla especial Ojo de los dioses y pasará a considerarse el oficial (ten en cuenta que no gana +1 Ataque).</description>
    </rule>
    <rule id="3b83-8ffb-65c5-ba5a" name="Odio (Humanos)" hidden="false">
      <description>Las miniaturas con esta regla ganan la regla Especial Odio contra todas las miniaturas con la clave HUMANOS.</description>
    </rule>
    <rule id="9c25-63b7-b20c-d228" name="Marcas del Caos" hidden="false">
      <description>La mayoría de los regimientos y personajes pueden portar una Marca del Caos. Para incluir una unidad con una Marca, debe incluirse al menos un personaje con dicha Marca; y para incluir un personaje con una Marca, debe incluirse al menos una unidad con dicha Marca. Esto representa que los ejércitos del Caos se conforman como Huestes, con un poderoso señor del Caos y sus tropas, que se unen a otros señores del Caos para conformar grandes ejércitos. Además, un personaje sólo puede unirse a unidades con su misma Marca. El efecto de las Marcas del Caos puede variar y se describe en cada unidad y personaje el efecto concreto que produce cada Marca del Caos. (Nota: los efectos de -1HA de algunas Marcas de Nurgle no son apilables).</description>
    </rule>
    <rule id="f12c-aa7a-88e6-b6f2" name="Indisciplina" hidden="false">
      <description>Las unidades con Indisciplina deben realizar un chequeo de Liderazgo al inicio de cada uno de sus turnos si no están huyendo. Si lo superan, puedes controlar la unidad con normalidad pero si lo fallas debes realizar una tirada en la tabla de Indisciplina:
1- Trifulca: La unidad sufre inmediatamente 1D6 impactos que siempre hieren a 4+ (sin importar la Resistencia) y no permiten tirada de salvación por armadura. Además, si hay algún enemigo a distancia de carga y en línea de visión, la unidad deberá declarar obligatoriamente una carga durante la sub-fase de declaración de cargas. Si no hay enemigos al alcance, la unidad no podrá marchar ni reformar durante esa fase de movimiento (ni aunque tengan la regla especial Hostigadores o Caballería rápida).
2-4 Bravata bestial: La unidad obtiene la regla especial Furia asesina hasta el inicio de tu siguiente turno y fallará automáticamente todos los chequeos de Liderazgo para evitar declarar una carga ese turno.
5-6 Furia bestial: Si hay algún enemigo a distancia de carga y en línea de visión, la unidad se encarará hacia la más cercana de esas unidades enemigas y moverá inmediatamente 1D6” hacia esa unidad enemiga; si llegan a contacto peana con peana se considera carga (ten en cuenta que en este caso no podrá reaccionarse a dicha “carga”). La unidad obtiene la regla especial Furia asesina hasta el inicio de tu siguiente turno y fallará automáticamente todos los chequeos de Liderazgo para evitar declarar una carga ese turno.</description>
    </rule>
    <rule id="ed28-cb7d-82d1-73d5" name="Destruir la civilización" hidden="false">
      <description>Cada vez que una unidad enemiga con Potencia de unidad 5 o superior es destruida por una unidad con esta regla especial (ya sea en la fase de disparo, de magia o de combate, incluyendo alcanzarla en una persecución o que la causa de la destrucción sea un personaje unido a la unidad, como un chamán lanzando un hechizo; cuenta la potencia al inicio de la fase en la que
ha sido destruida), tira en la tabla de &quot;Destruir la civilización&quot; y aplica el resultado a la unidad (los personajes unidos a una unidad obtienen el mismo beneficio que su unidad) durante el resto de la batalla. Una unidad no puede obtener dos veces el mismo beneficio: si esto ocurre, considera el resultado como “Sin señales de los Dioses”.
Resultado en 2d6/ Destruir la civilización:
2 / Visiones del caos: La unidad obtiene Estupidez.
3 / Sin señales de los dioses: No ocurre nada.
4 / Velocidad impía: La unidad obtiene +1 Iniciativa y +1 Movimiento.
5 / Aura del Caos: La unidad obtiene Resistencia Mágica (1), o +1 a su Resistencia Mágica si ya disponía.
6 / Horrores del Caos: La unidad causa miedo. Si ya causaba miedo causa Terror.
7 / Furia ciega: La unidad obtiene Carga Devastadora. Si ya tenía esta regla obtiene +1 de Fuerza.
8 / Grandes Cuernos: La unidad obtiene Impactos por carga (1). Si ya tenía la regla obtiene +1 impactos. Si tenía la regla Astados y se activa aplica ambas (un impacto automático y uno astado si procede).
9 / Protección del Caos: Obtiene Piel Escamosa (5+) o +1 a su Piel Escamosa si ya disponía de ella.
10 / Apéndices adicionales: La unidad obtiene +1 Ataque.
11 / Músculos de Acero: La unidad obtiene +1 de Fuerza y +1 Ataque.
12 / Recompensa de la demonicidad: La unidad obtiene la regla especial Tozudez y Aura demoníaca (4+)</description>
    </rule>
    <rule id="784a-9251-e40d-5077" name="Corpulentos" hidden="false">
      <description>Las miniaturas con esta regla especial tienen Potencia de unidad 2 y son de tamaño Grande.</description>
    </rule>
    <rule id="acce-ae59-3dfe-b5f5" name="Canibalismo frenético" hidden="false">
      <description>Cuando una unidad con esta regla especial gane una fase de combate cuerpo a cuerpo obtendrá la regla especial Furia asesina y no la perderá aunque pierda un combate cuerpo a cuerpo.</description>
    </rule>
    <rule id="5f10-0c41-6b1e-b97f" name="Borrachos" hidden="false">
      <description>Al inicio de la batalla, tras el despliegue, tira 1D6 por cada unidad con esta regla especial (en el caso de un personaje con esta regla especial dentro de una unidad con esta regla especial, tira solo una vez por ambos): con un resultado de 1, obtienen la regla especial Estupidez; con un resultado de 2-5, obtienen la regla especial Indisciplina y con un resultado de 6 obtienen la regla especial Furia asesina.</description>
    </rule>
    <rule id="1f1e-14b7-0ad7-466d" name="Astados" hidden="false">
      <description>Si una miniatura del tipo Infantería con esta regla especial obtiene algún resultado de 5 y/o 6 en su tirada de carga, cada uno de sus componentes obtendrá hasta el final del turno la regla especial Impactos por carga (1). Ten en cuenta que se resuelven con la Fuerza básica de la miniatura. También obtendrán Impactos por carga (1) si obtienen un resultado de 5 o 6 al mover con los hechizos Furia primitiva (Magia Oscura) e Impulso predatorio (Saber de las Bestias) o al efectuar un movimiento aleatorio.</description>
    </rule>
  </sharedRules>
  <sharedProfiles>
    <profile id="120a-7fef-0a46-77f1" name="Armadura del Caos" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Proporciona una tirada de salvación por armadura de 4+. Un hechicero puede llevar una Armadura del Caos y seguir lanzando hechizos.</characteristic>
      </characteristics>
    </profile>
    <profile id="a61d-4111-0ad4-024f" name="Azotes infernales" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Se consideran Arma de mano a todos los efectos, y sus impactos tienen la regla especial Poder de penetración. Además, al inicio de cada ronda de combate, una unidad equipada con azotes infernales puede elegir entre luchar de forma ofensiva o luchar de forma defensiva: si luchan de forma ofensiva, obtienen un bonificador de +1 a sus tiradas para impactar. Si luchan de forma defensiva, el enemigo tendrá un penalizador de -1 a sus tiradas para impactar a los jinetes infernales.</characteristic>
      </characteristics>
    </profile>
    <profile id="df30-dc1d-236b-15c5" name="Látigo de púas" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Un Látigo de púas se considera un Arma de mano a todos los efectos y sus impactos se resuelven con la regla especial Poder de penetración. Además, un Señor de las bestias del Caos con Látigo de púas podrá atacar con este a través de una fila de Mastines del Caos o de Engendros del Caos como si se encontrase en primera fila, realizando todos sus Ataques en vez de sólo uno como es habitual en los ataques desde la segunda fila.</characteristic>
      </characteristics>
    </profile>
    <profile id="e577-6733-531e-bfd7" name="Cuerno de la matanza" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">La primera vez en la batalla en la que la unidad que porte un Cuerno de la matanza vaya a realizar un movimiento de carga, añade 1D3” a dicho movimiento de carga.</characteristic>
      </characteristics>
    </profile>
    <profile id="b9c0-58cd-d263-5e4d" name="Flauta de sirena" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Las unidades enemigas no podrán reaccionar a una carga con Aguantar y disparar o Disparar y huir si son cargados por una unidad con una Flauta de sirena.</characteristic>
      </characteristics>
    </profile>
    <profile id="064d-1b8e-34b5-fc36" name="Gong de la desesperación" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Las unidades enemigas en contacto con una unidad equipada con Gong de la desesperación deberán repetir los chequeos de desmoralización que realizasen con éxito.</characteristic>
      </characteristics>
    </profile>
    <profile id="db4a-65c4-9afb-f484" name="Instrumentos de fuego" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Al inicio de cada fase de combate cuerpo a cuerpo, el Instrumento del fuego causa un impacto de Fuerza 3 con la regla especial Ataques sólo flamígeros a todas las miniaturas enemigas en contacto peana con peana con el Músico que lo porta.</characteristic>
      </characteristics>
    </profile>
    <profile id="ab8f-d77b-4410-f602" name="Espada de plaga" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Se trata de un Arma de mano cuyos Ataques de plaga exitosos que hieran automáticamente (es decir, los ataques que obtengan un resultado de 6 en la tirada para impactar) no permitirán tiradas de salvación por armadura.</characteristic>
      </characteristics>
    </profile>
    <profile id="6933-62ee-c883-3f86" name="Tambor de la transformación" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El Tambor de transformación permite guardar uno de los dados de Energía o Dispersión no utilizados durante una fase de magia para una fase de magia posterior</characteristic>
      </characteristics>
    </profile>
    <profile id="98a1-df37-2105-4e7f" name="Armas brujas emparejadas" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Requiere ambas manos, +1 Ataque.</characteristic>
      </characteristics>
    </profile>
    <profile id="6497-ea89-cfe5-8284" name="Arma bruja" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Arma de mano: Un Arma bruja se considera un Arma de mano en todos los aspectos (y puede realizarse Parada con ella si se dispone también de Escudo).</characteristic>
      </characteristics>
    </profile>
    <profile id="cbf0-5167-c17e-18ae" name="Cuerno de guerra" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una unidad en Emboscada equipada con un Cuerno de guerra puede sumar +1 a la tirada de Refuerzos para determinar si entra al campo de batalla.</characteristic>
      </characteristics>
    </profile>
    <profile id="8b07-b39e-8273-0488" name="Garras y colmillos (arma de mano)" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ninguna</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
</catalogue>