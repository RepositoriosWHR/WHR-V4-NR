              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6690-05f4-98b0-a79d" type="min"/>
              </constraints>
              <rules>
                <rule id="ad86-10a1-53bd-50c4" name="Marca de Nurgle. Elegidos de Nurgle en zángano de plaga" hidden="false">
                  <description>Tanto los Elegidos de Nurgle como los Zánganos de plaga portan la Marca de Nurgle, por la que obtienen las reglas especiales Ataques envenenados e Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d525-06ea-9140-609d" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink id="65c2-56d2-d7d0-e9f7" name="Inmune al veneno" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
