      <rules>
        <rule id="d3a3-414e-6795-c4db" name="Descarga ígnea Señor de la transformación exaltado" hidden="false">
          <description>Se trata de un ataque de disparo con alcance 24”, Fuerza 5 y las reglas especiales Disparos múltiples (1D6+1), Disparo rápido y Ataques sólo flamígeros.</description>
        </rule>
        <rule id="2e07-adb1-df5e-4b44" name="Magia Señor de la transformación exaltado" hidden="false">
          <description>Un Señor de la transformación exaltado es un hechicero de nivel 5 que utiliza el Saber de Tzeentch y Magia Oscura.</description>
        </rule>
        <rule id="3129-e908-e84c-0bdd" name="Señor de la magia" hidden="false">
          <description>El demonio tiene un bonificador de +1 a todas sus tiradas de lanzamiento y dispersión de hechizos.</description>
        </rule>
      </rules>
