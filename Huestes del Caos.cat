            <entryLink id="75de-788a-9b53-a57e" name="[GI] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="924a-4560-4a74-e2be" type="selectionEntry">
              <rules>
                <rule id="3f91-22e1-247f-be6c" name="Marca de Nurgle. Gran arpía" hidden="false">
                  <description>Obtiene la regla especial Ataques envenenados. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="2d01-7265-fd28-2c5c" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="260d-9383-c8cd-77d3" name="[GI] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="db84-b5c7-fe44-c8b4" type="selectionEntry">
              <rules>
                <rule id="2904-0474-60be-1739" name="Marca de Tzeentch. Gran arpía" hidden="false">
                  <description>Obtiene las reglas especiales Ataques mágicos y Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f6b8-c123-9577-3091" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="dcfa-0e03-fd69-d8f8" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="273d-8450-e485-4519" name="[GI] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="ff62-9412-73a7-b3d9" type="selectionEntry">
              <infoLinks>
                <infoLink id="a459-5569-8411-683d" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="d5ce-b4c8-064e-a800" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
