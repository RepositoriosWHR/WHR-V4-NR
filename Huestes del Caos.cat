          <entryLinks>
            <entryLink id="4870-6c9a-4eaa-d2b6" name="[BC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="dff6-7215-247b-8ac7" type="selectionEntry">
              <rules>
                <rule id="8ecd-c173-5985-f22a" name="Marca del Caos absoluto. Carro de garragor" hidden="false">
                  <description>Obtienen laregla especial Inmune a pánico; además, pueden realizar una tirada enla tabla de Destruir la civilización antes del despliegue y pueden repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="eba2-a14f-a665-eef8" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="845e-0e18-14b1-0c15" name="Destruir la civilización" hidden="false" targetId="ed28-cb7d-82d1-73d5" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="5.0"/>
              </costs>
            </entryLink>
