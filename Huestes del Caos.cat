    <selectionEntry id="37f1-0fcf-f762-f0fa" name="[H][GI] - Basilisco" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1854-2abc-c938-d165" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="70d5-df75-2028-5623" type="max"/>
      </constraints>
      <rules>
        <rule id="0eb0-1e83-81b7-c9c6" name="Aura vitriólica" hidden="false">
          <description>Las unidades en contacto pena con peana con un Basilisco no podrán efectuar tiradas de Regeneración. Además, al inicio de cada ronda de combate, tira 1D6 por cada miniatura en contacto peana con peana con un Basilisco: si obtienes un resultado de 6, esa miniatura sufrirá una herida sin tirada de salvación; suma +1 a esta tirada por cada fase de combate cuerpo a cuerpo que la unidad de la miniatura haya estado trabada en combate con el Basilisco.</description>
        </rule>
        <rule id="456d-7f4c-efd7-581f" name="Mirada maléfica" hidden="false">
          <description>Se trata de un ataque de disparo con un alcance de 18” y las reglas 
especiales Disparo rápido y Francotirador que puede utilizarse aunque el Basilisco haya marchado. Este disparo siempre hiere con un resultado de 4+, sin importar la Resistencia del objetivo, no permite tiradas de salvación por armadura y tiene la regla especial Golpe letal heroico. El Basilisco puede utilizar su mirada aunque se encuentre trabado en combate, aunque sólo contra las unidades con las que esté trabado.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="13f9-affb-ccdd-0763" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="fb06-eaf6-6ec2-bacb" name="Veloz" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
        <infoLink id="6ef2-a26d-a4d7-f76a" name="Piel escamosa (4+)" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink id="4650-f8b6-b38f-5e2d" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink id="3c96-2d2a-fbe4-f303" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink id="7d6e-87cf-298d-66db" name="Cruzar (bosques)" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
        <infoLink id="365a-affb-d0cd-2f60" name="Cruzar (obstáculos)" hidden="false" targetId="5dfd-3f02-cece-1e02" type="rule"/>
        <infoLink id="e942-1b99-c3ff-2b48" name="Cruzar" hidden="false" targetId="7ea4-f7e1-7e21-9266" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Elementos acuáticos)"/>
