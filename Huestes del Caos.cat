              </modifiers>
              <rules>
                <rule id="d440-ec2e-5c12-f5c7" name="Marca de Caos absoluto. Guerreros consagrador Kurgan" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="57d3-0c40-555e-ff4f" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
