    <selectionEntryGroup id="5cfc-9700-8522-9e6e" name="[GC] - Objetos hechizados. Guerreros del Caos. No Khorne ni hechiceros" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f703-6d6e-3d57-e9d3" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="86ca-d466-0864-a792" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="cfa0-d89b-6cd8-747b" name="Libro de los secretos del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d341-414f-20d0-80ba" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0927-d191-8828-6900" type="max"/>
          </constraints>
          <profiles>
            <profile id="5505-e8a5-02ba-bbd5" name="Libro de los secretos del caos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador pasa a considerarse hechicero de nivel 1 que puede utilizar el Saber de las Sombras, el Fuego o la Muerte. No puede ser utilizado por miniaturas con la Marca de Khorne o por personajes que ya tuviesen uno o más niveles de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="17d7-31bc-0098-7fca" name="[GC] - Objetos hechizados. Guerreros del Caos. Nurgle" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d997-4ed9-c148-4c0a" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5e9f-d9ce-ce8f-b396" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="4e38-561f-2132-b127" name="Cráneos de muerte" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f151-a8ca-de14-d380" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="dec1-ba54-8cec-608b" type="max"/>
          </constraints>
          <profiles>
            <profile id="5f67-1a10-c652-4775" name="Cráneos de muerte" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Nurgle. El portador puede utilizar los cráneos en cada fase de disparo si no está trabado en combate, aunque no para aguantar y disparar. Coloca la plantilla redonda pequeña a 12” o menos del portador y tira los dados de artillería y dispersión como si estuvieses disparando una Catapulta aunque, si se dispersa, lo hará la mitad de la distancia indicada en el dado de artillería. Cualquier miniatura bajo la plantilla deberá efectuar un chequeo de Resistencia o sufrir una herida sin tirada de salvación por armadura. Si obtienes un resultado de Problemas, retira la plantilla sin causar ningún efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="fa52-f6d5-bce7-81ce" name="[GC] - Objetos hechizados. Guerreros del Caos. Slaanesh" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7545-ce9b-59b6-716b" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a1c2-2fb6-67dd-5eb3" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="c995-a4a2-8b43-dfc2" name="Colgante de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4437-e562-bcba-ed4d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="12ad-bbb3-6046-f7f3" type="max"/>
          </constraints>
          <profiles>
            <profile id="8a26-bc9f-2b40-e8ab" name="Colgante de Slaanesh" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Slaanesh. Por cada herida que sufra el portador, su atributo de Ataques aumenta en un punto (hasta un máximo de 10).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
