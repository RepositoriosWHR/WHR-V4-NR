      <selectionEntries>
        <selectionEntry id="63ad-f877-7b02-49fd" name="Relicario de la sangre hirviente" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="644f-1e42-0189-bcff" type="max"/>
