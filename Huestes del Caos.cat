            <entryLink id="60ca-0ee1-89bb-76b1" name="[GI] - Marca del caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="38c4-0f99-1e14-3cd5" type="selectionEntry">
              <rules>
                <rule id="491b-13bb-d552-34f0" name="Marca de caos absoluto. Gran arpía" hidden="false">
                  <description>Obtiene la regla especial Inmune a Pánico. Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses, la cual podrá repetir, y aplica el resultado al personaje durante la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="a739-29b5-e7d4-d39a" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
          </entryLinks>
