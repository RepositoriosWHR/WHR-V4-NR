      <selectionEntries>
        <selectionEntry id="47c5-d695-b477-679d" name="Mazo Negro" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="8e7c-9997-04ab-9528" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="adb6-425f-1c49-0782" type="max"/>
          </constraints>
          <profiles>
            <profile id="9be4-cafe-33d9-38f6" name="Mazo Negro" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Este arma otorga a su portador la regla especial Furia asesina. Además, no perderá su Furia asesina por perder en combate cuerpo a cuerpo. Los impactos con este arma se resuelven con +2 a la Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="db17-2405-5fa5-5477" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <entryLinks>
            <entryLink id="67eb-9a36-0e82-80c9" name="[BC] - Arma de mano" hidden="false" collective="false" import="true" targetId="785b-1be2-c35d-0032" type="selectionEntry">
