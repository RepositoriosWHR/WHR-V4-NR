            </profile>
          </profiles>
          <rules>
            <rule id="8df1-ea9f-3136-14c2" name="Múltiples lenguas" hidden="false">
              <description>Cuenta con un ataque de disparo con sus múltiples lenguas, con un alcance de 12”, Fuerza 5 y las reglas especiales Disparo rápido y Disparos múltiples (3). Por último, al inicio de cada uno de tus turnos, el Gran gusano de plaga restablece una de las heridas que hubiese sufrido con anterioridad durante la batalla.</description>
            </rule>
            <rule id="fcf4-8e5d-d972-c5e0" name="Gran gusano de plaga" hidden="false">
              <description>Orghotts monta sobre un Gran gusano de plaga, que es un monstruo que tiene las reglas especiales Ataques envenenados, Protección por montura (1) y Regeneración (5+). Por último, al inicio de cada uno de tus turnos, el Gran gusano de plaga restablece una de las heridas que hubiese sufrido con anterioridad durante la batalla.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="be4e-c81f-6737-8e72" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
            <infoLink id="e2ca-4cc5-62ca-b407" name="Protección por montura (1)" hidden="false" targetId="1f9d-b34a-3d89-add6" type="rule"/>
            <infoLink id="fb4e-7265-bad7-f8f3" name="Regeneración (5+)" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
            <infoLink id="2709-d257-4177-6b3f" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink id="57a0-ad6f-3209-5de4" name="Disparo rápido" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(Múltiples lenguas)"/>
              </modifiers>
            </infoLink>
            <infoLink id="63a4-6d74-391b-1ade" name="Disparos múltiples (3)" hidden="false" targetId="37f9-b9ff-09a3-3dba" type="rule">
              <modifiers>
