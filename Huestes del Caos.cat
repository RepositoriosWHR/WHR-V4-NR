            <profile id="4ad6-b9de-c6ff-c068" name="Segadora de almas" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Objeto legendario. Sólo miniaturas con la Marca de Nurgle. Arma a dos manos. Mata si causa una herida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="cdc0-b9b7-71ce-1472" name="Arma a dos manos" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
            <infoLink id="dd59-ccef-6ded-316f" name="Objeto legendario" hidden="false" targetId="1eb5-f5b5-0dbe-0f2e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="75.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="4e2e-ca7b-8d63-f231" name="[GC] - Armas mágicas. Reliquias. Guerreros del Caos. Slaanesh. Arma de mano" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d4fa-97f4-b7ae-383b" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1675-317a-0f7a-9c93" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="d33c-2fae-f83a-2bf5" name="Alfiler del éxtasis" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a0a4-9842-a831-8f43" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3e30-0d18-f2f1-cc6b" type="max"/>
          </constraints>
          <profiles>
            <profile id="e50e-39a1-e08b-649d" name="Alfiler del éxtasis" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la Marca de Slaanesh. Arma de mano. Los impactos con este arma no permiten tiradas de salvación por armadura. Si causa una herida a una unidad enemiga, la unidad quedará Apabullada ese turno y tendrá un penalizador de -1 en sus tiradas para impactar durante esa fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5f2c-415c-8428-0b40" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="746a-aa53-e4a7-5296" name="Apabullar" hidden="false" targetId="205f-210b-5422-1e61" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="60.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="a8fe-a6ad-642e-37be" name="[GC] - Armas mágicas. Reliquias. Guerreros del Caos. Tzeentch. Arma de mano" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4e19-b8ed-57c4-7bdc" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5307-73a7-23d5-6156" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="3eaa-b78a-73e7-1dc8" name="Espada de la transformación" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a1fa-7ba4-8222-d01f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d3aa-df5d-62c0-9b5e" type="max"/>
          </constraints>
          <profiles>
            <profile id="f6f7-a271-ab3c-75f3" name="Espada de la transformación" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la Marca de Tzeentch. Arma bruja. Si este arma causa al menos una herida a un oponente y no la mata, tira 1D6 y súmale uno por cada herida causada después de la primera. Con un resultado de 5+, se transformará en un Engendro del Caos con la Marca de Tzeentch bajo tu control (colócalo a 6” o menos de su posición inicial sin trabarlo en combate).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="301e-a007-35f0-cabb" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="9fc8-2cfa-0e45-2ed9" name="[GC] - Artefactos arcanos. Guerreros del Caos" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0953-bb85-7434-a0b5" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="65a7-629e-4ed0-796f" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="6136-2548-beec-712c" name="Familiar del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="de90-4b76-847e-7024" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="dd80-75dc-a7dc-7876" type="max"/>
          </constraints>
          <profiles>
            <profile id="a794-6a57-7d5c-cab7" name="Familiar del caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="3827-68b2-d4ed-6b1b" name="Cáliz del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f4f0-944f-b156-c49e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4dd5-6f65-4aa3-7bec" type="max"/>
          </constraints>
          <profiles>
            <profile id="c34e-f856-9eda-1781" name="Cáliz del caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Puede utilizarse al inicio de cada fase de magia propia o del enemigo. Tira 1D6. Con un resultado de 1, el hechicero sufrirá 1D3 heridas automáticas sin posibilidad de salvación por armadura. Con un resultado de 2 a 5, el hechicero genera 1D3 dados de Energía o Dispersión adicionales para esa fase de magia. Con un resultado de 6, todos los magos enemigos en el campo de batalla tendrán que obtener un resultado igual o inferior a su nivel de magia o sufrirán una Disfunción mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a156-da19-2670-234b" name="La calavera de Kasteman" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="aeff-0d87-cbba-ce7f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f9dc-b87f-2c72-7a68" type="max"/>
          </constraints>
          <profiles>
            <profile id="420f-e057-67b0-81a3" name="La calavera de Kasteman" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Proporciona a su portador un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="9a3c-41fb-06bd-b901" name="[GC] - Artefactos arcanos. Guerreros del Caos. Slaanesh" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b34a-0f4e-cf6e-34ec" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7aaa-d602-cce3-7c7d" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="4bdc-3a96-f588-5748" name="Cetro de la dominación de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2dea-78cc-fad8-9bf6" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9eb5-f3a7-a7bb-81f0" type="max"/>
          </constraints>
          <profiles>
            <profile id="7027-e006-8009-68db" name="Cetro de la dominación de Slaanesh" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Slaanesh. Objeto portahechizos, Nivel de energía 6. Puede utilizarse en cada fase de magia propia contra una unidad enemiga no trabada en combate a 18” o menos del portador. Esta unidad deberá realizar un chequeo de Liderazgo tirando 3D6 y descartando el resultado menor. Si lo falla, no podrá cargar, marchar ni disparar durante su siguiente turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="8b74-1002-a8d6-f0d9" name="[GC] - Artefactos arcanos. Guerreros del Caos. Tzeentch" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="917e-86ac-44fd-d781" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="184d-dd8c-e37e-fe8e" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="4c11-8bd8-afd6-839f" name="Liber maleficus" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f1cc-3654-052a-6bc1" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6c6f-6abf-6d00-47d1" type="max"/>
          </constraints>
          <profiles>
            <profile id="ec38-a558-64b2-5a51" name="Liber maleficus" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Tzeentch. Otorga la regla especial Señor del conocimiento (Saber de Tzeentch).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="71b2-275f-17c0-82b4" name="Señor del conocimiento" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(Tzeentch)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="7d37-d714-47fe-1d7b" name="Espejo de plata de Tzeentch" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="008d-09f8-af7f-4c55" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4c6d-2a07-c155-0649" type="max"/>
          </constraints>
          <profiles>
            <profile id="71c4-2523-1c5f-abdc" name="Espejo de plata de Tzeentch" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Tzeentch. Al inicio de cada fase de magia propia, puedes elegir una unidad enemiga en el campo de batalla: el oponente deberá revelarte todos los objetos mágicos que haya en dicha unidad, así como todas las opciones ocultas que contenga (asesinos, fanáticos, etc); a partir de ese momento, dicha unidad pasa a considerarse Escrutada. Cada vez que el portador lance un hechizo contra una unidad enemiga que haya sido Escrutada durante la batalla, puede repetir todos los resultados de 1 que obtenga en sus dados de Energía.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="cd67-3807-3655-598c" name="[GC] - Artefactos arcanos. Reliquias. Guerreros del Caos. Nurgle" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2378-620c-c3ae-2a5b" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="eb25-3e6e-6d39-c676" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="8ab1-dd9d-c237-7753" name="Báculo de Nurgle" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="db7e-abc6-832a-b916" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2a7a-3112-9726-308b" type="max"/>
          </constraints>
          <profiles>
            <profile id="7c94-2759-2d32-46f5" name="Báculo de Nurgle" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Nurgle. Objeto portahechizos, nivel de energía 7. Designa una única miniatura enemiga a 12” o menos del lanzador (puedes seleccionar un personaje dentro de una unidad). Esa miniatura deberá obtener un resultado igual o inferior a su atributo de Resistencia en 2D6 o se retirará como baja. Tira 1D6 cada vez que utilices el báculo exitosamente: con un resultado de 1 o 2, el poder del báculo se habrá agotado temporalmente y no podrá usarse más durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="125.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="617a-a21c-2a7e-a39f" name="[GC] - Estandartes mágicos. Guerreros del Caos" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="173c-4c2e-8784-eb3e" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e006-908b-34af-a056" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="5bc4-ec4a-893f-589f" name="Tótem maldito" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="723f-060b-3c26-57a9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="204a-4d63-8888-fdff" type="max"/>
          </constraints>
          <profiles>
            <profile id="4348-8ada-953a-679b" name="Tótem maldito" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades enemigas a 8” o menos del estandarte tendrán un penalizdor de -1 a su Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0da1-bea0-8ea1-272b" name="Pabellón del odio" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="31d7-e4a5-a948-5b88" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a0e9-2a01-4eff-c622" type="max"/>
          </constraints>
          <profiles>
            <profile id="2782-2e44-5e4b-ed90" name="Pabellón del odio" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtendrán la regla especial Odio (¡todos los enemigos!). Los resultados de 1 para impactar (después de repetir) se resolverán para herir contra la propia unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1e89-980c-47e2-0eca" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="569b-4ee1-5837-28bd" name="Pabellón demoníaco" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="94bd-c58c-8532-86f5" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="95d0-e8b5-1aad-49d0" type="max"/>
          </constraints>
          <profiles>
            <profile id="582c-cab4-f079-53fb" name="Pabellón demoníaco" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Aura demoníaca (5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
