          </constraints>
          <profiles>
            <profile id="2fc3-ec7e-3a80-a35d" name="Espadas sangrientas " hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la Marca de Khorne. Armas emparejadas. Sus impactos se resuelven con Golpe letal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d9a3-bc63-c82b-9ad3" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
