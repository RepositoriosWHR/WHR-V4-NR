    <selectionEntry id="a450-5485-ac57-78f7" name="[H][GI] - Engendro monstruoso del caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="1854-2abc-c938-d165" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f2d5-17e4-3caa-e46d" type="max"/>
      </constraints>
      <rules>
        <rule id="dac2-ecb2-2cfb-0473" name="Vástago del caos" hidden="false">
          <description>Determina al inicio de la batalla (antes del despliegue) los atributos de HA, F, R, H e I del Engendro monstruoso del Caos. Además, tira una vez en la siguiente tabla para determinar los efectos adicionales de las mutaciones del engendro:
1D6 Mutaciones
1 Ataques envenenados
2 Piel escamosa (4+)
3 Arma de aliento de Fuerza 1D6
4 Resistencia mágica (3)
5 Golpe letal
6 Regeneración (4+)</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6006-a95d-8290-c7d7" name="Aura demoníaca (5+)" hidden="false" targetId="e5ed-5149-3d72-6aa4" type="rule"/>
        <infoLink id="8a2f-bc53-654b-02e9" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
