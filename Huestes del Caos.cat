      <selectionEntries>
        <selectionEntry id="5805-c7b7-1bf9-cdb4" name="Venablo siniestro" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="cfa5-0323-5dae-9970" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="bc81-31d3-b08c-039b" type="max"/>
          </constraints>
          <profiles>
            <profile id="7e13-dcb7-04f9-2746" name="Venablo siniestro" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza. Los impactos causados por el Venablo se resuelven con la regla especial Golpe letal. Además, el venablo puede utilizarse para disparar como si fuese una jabalina con las reglas especiales Ataques mágicos y Golpe letal (el venablo vuelve a la mano del portador tras cada disparo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="4eef-3e97-a4ce-e6c5" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
