        <selectionEntry id="33b8-ee15-048a-fc0f" name="Cadenas de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4087-fdca-968d-3b3f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7886-624f-a729-b139" type="max"/>
          </constraints>
          <profiles>
            <profile id="90be-8680-b2ab-756a" name="Cadenas de Slaanesh" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Slaanesh. En combate cuerpo a cuerpo, el portador realiza 1D6 ataques adicionales que se resuelven con Iniciativa 10, utilizando los valores de Habilidad de Armas y Fuerza del portador (no se beneficiarán del efecto de ningún arma mundana o mágica del portador, aunque sí de las Recompensas del Caos que pudiera tener).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="53c8-534c-8c79-04ed" name="[GC] - Objetos hechizados. Guerreros del Caos. Tzeentch" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="759c-c247-4a27-2ce7" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="75af-2c4b-b00f-b220" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="42f8-51f6-b600-afee" name="Prisma caleidoscópico" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e100-d7b4-8fc2-7003" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b6d3-b2fb-4c2d-186d" type="max"/>
          </constraints>
          <profiles>
            <profile id="12c2-362a-f535-ffe9" name="Prisma caleidoscópico" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Tzeentch. Un sólo uso. Puede utilizarse al final de cualquier fase de movimiento propia si el portador no ha movido esa fase (puede utilizarse aunque el portador esté trabado en combate cuerpo a cuerpo). Retira la miniatura del portador del campo de batalla y vuelve a colocarla inmediatamente a 24” o menos de donde se encontraba y a 1” o más de cualquier miniatura amiga o enemiga. Si una unidad enemiga queda destrabada a causa de esto, puede realizar inmediatamente un chequeo de Liderazgo para reorganizarse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
