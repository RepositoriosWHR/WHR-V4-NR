                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="c21c-b022-f64f-6c74" name="Señor de la manada" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="fc23-afa0-c0f1-b98b" type="min"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ba4-0675-08c0-db0c" type="max"/>
              </constraints>
              <profiles>
                <profile id="20d4-71c7-5a05-8ccc" name="Señor de la manada" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Kazakital tiene la regla especial Preencia inspiradora (pese a no ser el General del ejército) con un radio de 18” por ser Objetivo grande. Además, todas las unidades de Bestias del Caos amigas dentro del radio de su Presencia inspiradora que fallen una tirada de Indisciplina no deben tirar en la tabla de Indisciplina: en su lugar, considera que han obtenido un resultado de 5-6 (Furia bestial).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
