          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="76b1-0f4b-520a-f477" type="max"/>
      </constraints>
      <rules>
        <rule id="0c88-5dc9-699f-e19e" name="Magia Melekh el Transmutador" hidden="false">
          <description>Melekh es un hechicero de nivel 4 que sabe todos los hechizos del Saber de Tzeentch.</description>
        </rule>
        <rule id="dfbc-a1e5-e78b-5f85" name="Hechicero guerrero" hidden="false">
          <description>Melekh puede lanzar hechizos con normalidad pese a llevar Escudo. Además, tiene la regla especial Impasible.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="1d76-a5c8-f387-10fe" name="Caballería" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
