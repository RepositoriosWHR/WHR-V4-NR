            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0ab2-15a3-a75f-e960" type="max"/>
          </constraints>
          <profiles>
            <profile id="a6f2-6e89-396b-7a68" name="Hachas de Khorgor" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los ataques con estas armas pueden repetir sus tiradas fallidas para impactar. Además, los impactos con este arma se resuelven con +1 a la Fuerza.</characteristic>
