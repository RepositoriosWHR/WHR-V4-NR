      </constraints>
      <profiles>
        <profile id="0ae0-345e-4efd-ac9f" name="Bárbaros del Caos (10)" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
          <characteristics>
            <characteristic name="M" typeId="4d23232344415441232323">-</characteristic>
