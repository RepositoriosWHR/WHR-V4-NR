      <selectionEntries>
        <selectionEntry id="c46b-89f0-923c-4565" name="Lanza de Caza" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4720-a714-c4b8-eb0f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="284f-8f7f-8120-7064" type="max"/>
          </constraints>
          <profiles>
            <profile id="91ca-da0c-8432-3819" name="Lanza de Caza" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza. Los impactos con este arma se resuelven con la regla especial Poder de penetración. Puede utilizarse como un arma de proyectiles con un alcance de 18”. Los impactos se resuelven con la Fuerza del usuario y las reglas especiales Disparo rápido, Poder de penetración, Arrojadiza y Heridas múltiples (1D3); además, atravesará filas como un Lanzavirotes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8340-971e-9d73-c30c" name="Arrojadiza" hidden="false" targetId="f4e8-fb62-1495-6c04" type="rule"/>
