    <selectionEntry id="cab7-05a1-3086-532c" name="[H][BC][E] - Malagor, el Profeta Oscuro" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="2a81-6a0c-edfa-b306" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="74e6-b415-e85b-d78e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="aa55-70c3-ee42-27e0" type="max"/>
      </constraints>
      <rules>
        <rule id="5694-d21b-7512-0bf1" name="Algo malévolo está por suceder" hidden="false">
          <description>Las unidades enemigas a 6” o menos de Malagor no podrán beneficiarse de la Regla Especial Presencia Inspiradora.</description>
        </rule>
        <rule id="de0a-c0b5-3ebc-772a" name="Poderío Impío" hidden="false">
          <description>Malagor tiene un bonificador a sus tiradas de lanzamiento de hechizos igual al número del turno en curso (+1 en el turno 1, +2 en el turno 2, etc). Además, posee una tirada de salvación especial de 5+ (que se incrementa a 4+ por la Marca de Tzeentch).</description>
        </rule>
        <rule id="1fe7-a72b-5dbb-68fc" name="Magia de Malagor, el Profeta Oscuro" hidden="false">
          <description>Malagor es un hechicero de nivel 4. Puede elegir sus hechizos de entre los Saberes de la Muerte, de las Bestias, de las Sombras, de Magia Oscura, de Tzeentch, de Nurgle y/o de Slaanesh y puede elegir sus hechizos de dos o más de los saberes listados.</description>
        </rule>
        <rule id="1cf3-4d77-0d0b-ee39" name="Gran chamán" hidden="false">
          <description>Malagor conoce 8 hechizos en lugar de los 4 que corresponderían a su nivel.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="adb0-ffc3-6ca4-00cf" name="Cruzar (bosques)" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
        <infoLink id="547d-ed7d-ba1b-5aaf" name="Astados" hidden="false" targetId="1f1e-14b7-0ad7-466d" type="rule"/>
        <infoLink id="3e07-892b-0625-6e53" name="Volar (10)" hidden="false" targetId="be56-917b-a9d5-2c76" type="rule"/>
