          <entryLinks>
            <entryLink id="8d82-d613-aa28-d011" name="[GI] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="924a-4560-4a74-e2be" type="selectionEntry">
              <rules>
                <rule id="7b12-8056-9a0d-378c" name="Marca de Nurgle. Ogro dragón Sharunok" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d770-8a93-dabf-553a" name="Terror" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
