            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="dfde-9d9c-3eef-fe31" type="max"/>
          </constraints>
          <profiles>
            <profile id="26ff-dab1-17ec-ff29" name="Cayado de la Manada" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo hechiceros. Arma a dos manos. El portador puede guardar un dado de Energía o Dispersión no utilizado al final de cada fase de magia, el cual estará disponible en la siguiente fase de magia como dado de Energía o Dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="7d52-063f-d890-47dc" name="[BC] - Arma a dos manos" hidden="false" collective="false" import="true" targetId="bb47-48b8-65a3-26d3" type="selectionEntry">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4c2f-04ad-90c0-ddcc" type="min"/>
              </constraints>
