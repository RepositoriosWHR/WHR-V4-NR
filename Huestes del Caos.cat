                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup id="00ba-54e9-92ec-2626" name="Marca del Caos" hidden="false" collective="false" import="true">
