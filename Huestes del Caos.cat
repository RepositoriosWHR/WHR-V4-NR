    <selectionEntry id="4755-df94-1b53-e4de" name="[H][BC] - Preyton" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="74e6-b415-e85b-d78e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="ed3b-f455-704a-eb96" type="max"/>
      </constraints>
      <rules>
        <rule id="c830-cac3-9ca3-30e7" name="Odio incontenible" hidden="false">
          <description>El Preyton tiene la regla especial Furia asesina, la cual no perderá aunque pierda un combate. Adicionalmente, si el Preyton está luchando en combate cuerpo a cuerpo, cada herida que sufra le otorgará un bonificador extraordinario de +1 al resultado del combate esa fase.</description>
        </rule>
        <rule id="efe9-d838-9cf5-5516" name="Vigor impío" hidden="false">
          <description>Al inicio de cada uno de tus turnos, el Preyton recupera una herida que hubiese sufrido con anterioridad durante la batalla.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="d9b3-9f5f-bb98-917d" name="Ansia de sangre" hidden="false" targetId="2a68-a009-1a7a-c667" type="rule"/>
