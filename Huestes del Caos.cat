      </constraints>
      <rules>
        <rule id="5d62-7770-0935-ad86" name="Pastor de engendros" hidden="false">
          <description>Mientras Frud permanezca con su unidad de Engendros del Caos de Nurgle, esta podrá tirar 1D6 adicional para su Movimiento aleatorio (es decir, moverán al mismo ritmo que Frud) y obtendrán la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="fc89-3119-67f5-3672" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
