      <entryLinks>
        <entryLink id="a87d-ad34-fbdc-fc74" name="[GC] - Marca del Caos absoluto. Pesonajes" hidden="false" collective="false" import="true" targetId="82f2-d2ab-17e8-72cb" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4179-f8c2-4b1f-a1ce" type="min"/>
          </constraints>
          <rules>
            <rule id="2e85-b2f4-f89c-7a5c" name="Marca de Khorne. Harry" hidden="false">
              <description>Harry porta la Marca del Caos Absoluto, lo que hace que podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto a Harry toda la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink id="6c42-5e45-e65d-fe31" name="[GC] - Comandantes de la Hueste de apoyo" hidden="false" collective="false" import="true" targetId="a594-34b5-2c2b-9d65" type="selectionEntry"/>
