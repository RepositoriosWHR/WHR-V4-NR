            <entryLink id="c2b5-58d8-9ba4-a3ed" name="[K] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="851d-09e2-b8cf-0fbb" type="selectionEntry">
              <rules>
                <rule id="eaf5-def5-1738-ad32" name="Marca de Nurgle. Señor de la guerra Kurgan" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="c49e-bc1e-1bc4-2c0d" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
