    <selectionEntry id="de06-b15a-f99c-3fe0" name="[H][K][E] - Sayl el Infiel, vidente de los yermos del Caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a2dc-4181-2326-51c9" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="630c-e652-e78e-53c9" type="max"/>
      </constraints>
      <rules>
        <rule id="c93e-7f04-ceff-dba2" name="Magia Sayl el Infiel" hidden="false">
          <description>Sayl es un hechicero de nivel 3 que puede elegir sus hechizos de entre los Saberes de los Cielos, las Sombras y Magia Oscura y puede elegir sus hechizos de dos o más de los saberes listados. Además, conoce el hechizo La niebla del traidor</description>
        </rule>
        <rule id="d79b-495b-e8d0-df9b" name="Visión mutante" hidden="false">
          <description>Sayl puede repetir todos los chequeos de atributo que falle (salvo Liderazgo) y tendrá un bonificador de +2 a todas sus tiradas de Canalizar.</description>
        </rule>
        <rule id="e3bb-e9b9-5742-0913" name="Hechizo único: La Niebla del Traidor (Dificultad 6+) " hidden="false">
          <description>Se trata de un hechizo de Potenciación que Sayl puede lanzar sobre sí mismo. Si se lanza con éxito, Sayl puede hacer inmediatamente un movimiento con la regla especial Volar (10) como si se encontrase en la sub-fase de Resto de movimientos (no podrá utilizar este movimiento para realizar una carga, pero sí para retirarse de un combate).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2e1e-628a-5647-23d5" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="8621-a5c0-a8ed-2cc7" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
