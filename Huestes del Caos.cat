              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene la regla especial Piel escamosa (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
