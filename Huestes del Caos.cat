                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9ae3-3a38-20ce-8384" type="min"/>
              </constraints>
              <infoLinks>
                <infoLink id="26ff-ff99-19df-1cd6" name="Armadura del Caos" hidden="false" targetId="120a-7fef-0a46-77f1" type="profile"/>
              </infoLinks>
