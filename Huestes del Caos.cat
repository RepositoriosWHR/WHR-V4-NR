            <entryLink id="6d18-fc1e-88dd-9c64" name="[GC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="fea9-b5e3-cb0b-441d" type="selectionEntry">
              <rules>
                <rule id="20d7-1516-bbab-298b" name="Marca de Tzeentch. Hechicero del Caos" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="d2e0-8b2b-813f-51df" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="a6d0-204e-c809-343f" name="[GC] - Marca del Caos absoluto. Pesonajes" hidden="false" collective="false" import="true" targetId="82f2-d2ab-17e8-72cb" type="selectionEntry">
              <rules>
                <rule id="d9d9-fdb7-073b-5153" name="Marca del Caos absoluto. Hechicero del Caos" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="8110-adff-42c1-d606" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
          </entryLinks>
