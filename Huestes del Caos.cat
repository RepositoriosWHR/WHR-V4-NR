            <entryLink id="4edd-302e-8327-4b1c" name="[GI] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="db84-b5c7-fe44-c8b4" type="selectionEntry">
              <rules>
                <rule id="f9b7-1044-a63b-fb3a" name="Marca de Tzeentch. Troll del Caos Anciano" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella); además, tendrá un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="ba8f-22e9-16e1-0b3e" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="3725-dbb6-76b4-d78a" name="[GI] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="924a-4560-4a74-e2be" type="selectionEntry">
              <rules>
                <rule id="5c2d-8eee-d297-a38b" name="Marca de Nurgle. Troll del Caos Anciano" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="fcc5-02fb-f4bb-49ca" name="Terror" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="a4d1-a2e9-94a8-5062" name="[GI] - Marca del caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="38c4-0f99-1e14-3cd5" type="selectionEntry">
              <rules>
                <rule id="43b9-fa9c-b0fd-5a41" name="Marca de caos absoluto. Troll del Caos Anciano" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los Dioses, la cual podrá repetir, y aplica el resultado al personaje durante la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="74c0-c9bf-274d-f979" name="[GI] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="ff62-9412-73a7-b3d9" type="selectionEntry">
