                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule id="3d3a-f99d-6f93-4690" name="Trono de la virulencia" hidden="false">
                  <description>Ku&apos;gath es cargado al campo de batalla en el Trono de la virulencia, que no cambia el tipo del jinete y tiene las reglas especiales Demonio (Nurgle), Ataques aleatorios (3D6) y Protección por montura (1).. Ku&apos;gath obtendrá dos Heridas adicionales en su perfil de atributos (incluidas como +2 en su perfil). La Potencia de unidad de Ku&apos;gath sentado en el Trono de la virulencia es 30.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="76e7-4559-701b-cbb0" name="Demonio" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule"/>
                <infoLink id="b5b1-3c60-a6d1-e61f" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(2D6)"/>
                  </modifiers>
                </infoLink>
