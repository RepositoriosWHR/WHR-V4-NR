            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8c6b-a709-d826-e084" type="max"/>
          </constraints>
          <profiles>
            <profile id="38e7-9075-822a-4333" name="Don del cambio" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo hechiceros. Un sólo uso. Puede utilizarse durante cualquier fase de magia propia para lanzar un hechizo (incluso uno potenciado) sin invertir dados de Energía. El hechizo será lanzado con Fuerza irresistible; tras resolver el hechizo, el hechicero debe realizar una tirada en la tabla de Disfunciones mágicas, aunque tirará con 1D6+6 en lugar del habitual 2D6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="6d92-c104-0dc2-087d" name="Recompensa mayor" hidden="false" collective="false" import="true" targetId="e471-a674-c4bc-d62e" type="selectionEntry"/>
