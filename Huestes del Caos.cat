      <selectionEntryGroups>
        <selectionEntryGroup id="1490-0e70-63bb-147f" name="Monstruosidad disforme" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4770-43c5-31fc-187d" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0c94-235f-91b4-c121" type="min"/>
          </constraints>
          <rules>
            <rule id="71b8-b319-aa0a-4de4" name="Monstruosidad disforme" hidden="false">
              <description>Cada Behemoth demoníaco debe elegir una de las siguientes opciones, al coste en puntos indicado. No puede haber dos Behemoths demoníacos con la misma opción en un mismo ejército:</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry id="536e-264d-9cb5-0100" name="Descomunal" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7527-56bd-7441-2bd4" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="befb-c13e-9020-56f0" type="max"/>
              </constraints>
              <rules>
                <rule id="64c0-a3a1-5e99-ff5e" name="Descomunal" hidden="false">
                  <description>Obtiene +1 a Fuerza, Resistencia y Heridas, pero también -1 a Movimiento, Habilidad de armas, Ataques e Iniciativa.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="35.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="acd6-a0b4-4c78-7d6d" name="Montaña de pozoña" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="22f1-6b60-33be-1552" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d88e-2801-31ef-6a48" type="max"/>
              </constraints>
              <rules>
                <rule id="fa22-883b-a072-30e7" name="Montaña de pozoña" hidden="false">
                  <description>Obtiene la regla especial Ataques de Plaga. Además, al principio de cada fase de combate, todas las miniaturas enemigas en contacto con el Behemoth demoníaco deberán realizar un chequeo de Resistencia, sufriendo una herida sin posibilidad de salvación por armadura si lo fallan.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="e095-01aa-82c5-29ad" name="Ataque de plaga" hidden="false" targetId="5021-a885-be14-93b0" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="30.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="1e87-0935-ce63-389a" name="Cuerpo ardiente" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1624-c8ba-936a-5b15" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f745-74e9-4b5e-9569" type="max"/>
              </constraints>
              <rules>
                <rule id="d708-797f-5283-e85f" name="Cuerpo ardiente" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros e Inmune a fuego. Además, al principio de cada fase de combate, todas las miniaturas enemigas en contacto con el Behemoth demoníaco sufrirán un impacto de Fuerza 3 con la regla especial Ataques solo flamígeros.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="5da8-f075-a842-1cfc" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="4052-d391-3007-b9d8" name="Inmune al fuego" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="006c-82a2-6cfc-296e" name="Cuerpo eléctrico" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="51ac-d606-cb75-69df" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3580-087b-b3f8-a532" type="max"/>
              </constraints>
              <rules>
                <rule id="3cce-b717-50b8-976e" name="Cuerpo eléctrico" hidden="false">
                  <description>Sus ataques en combate cuerpo a cuerpo tienen la regla especial Ataques de rayos y el Behemoth demoníaco no puede ser herido por Ataques de rayos. Al principio de cada fase de disparo, selecciona la unidad (amiga o enemiga) a 12” o menos del Behemoth demoníaco que tenga la mejor tirada de salvación por armadura: esa unidad sufrirá 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="b675-1288-1368-3e60" name="Ataques de rayos" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="40.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="0c47-844a-1312-8596" name="Descarga disforme" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="bedd-b2ab-538c-64a1" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6644-dfa5-a9e8-bd81" type="max"/>
              </constraints>
              <rules>
                <rule id="8d03-5118-93b4-4ed4" name="Descarga disforme" hidden="false">
                  <description>Se trata de un ataque de disparo que puede utilizarse aunque el Behemoth demoníaco mueva (pero no si marcha) y se considera un efecto de Tormenta de proyectiles con un alcance de 18” que causa 2D6 impactos automáticos de Fuerza 4.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="25.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="b9a1-b547-9662-2531" name="Cuerpo de diamante" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d49d-e16a-2db7-4ace" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6c8b-4fd7-f6a2-a02a" type="max"/>
              </constraints>
              <rules>
                <rule id="a5d7-d757-7557-3936" name="Cuerpo de diamante" hidden="false">
                  <description>Obtiene la regla especial Piel escamosa (3+). Además, será inmune a los efectos de las reglas especiales Poder de penetración y Heridas múltiples.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="a7e7-4569-5eb2-5b32" name="Piel escamosa (3+)" hidden="false" targetId="f3fe-4c6e-197e-832f" type="rule"/>
                <infoLink id="2b7f-c36c-cbd9-9137" name="Inmune a Poder de penetración" hidden="false" targetId="1cd7-e229-65a3-05a5" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="30.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="85cf-a031-c9b6-b409" name="Cuerpo helado" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="32b3-6d0d-0e5e-f918" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4a94-8d13-2224-9e54" type="max"/>
              </constraints>
              <rules>
                <rule id="09c6-4e43-deef-551b" name="Cuerpo helado" hidden="false">
                  <description>Obtiene la regla especial Aura de frío. Además, también obtiene un Arma de aliento de Fuerza 2 que no permite tirada de salvación por armadura.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="b150-1e58-c215-06d7" name="Aura de frio" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
                <infoLink id="4504-055e-eea2-77bb" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(F2, sin salvación por armadura)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="d51e-f814-59da-b6b3" name="Anatema mágico" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1829-1d4a-e3dc-39f1" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7199-8a93-03b4-8f65" type="max"/>
              </constraints>
              <rules>
                <rule id="1f5f-0f5f-c18e-6a05" name="Anatema mágico" hidden="false">
                  <description>Obtiene la regla especial Resistencia mágica (3). Además, todos los impactos contra el Behemoth demoníaco que no sean Ataques mágicos tendrán un penalizador de -1 en sus tiradas para herir.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="a860-9600-3bf2-1660" name="Resistencia mágica (3)" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="30.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="0fd0-8fb9-5ee1-0e59" name="Cuerpo de sombras" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c249-4c26-5e13-16de" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4bac-3c8d-e988-f413" type="max"/>
              </constraints>
              <rules>
                <rule id="ba07-f77a-5bb4-ad75" name="Cuerpo de sombras" hidden="false">
                  <description>Todos los disparos que tomen como objetivo al Behemoth demoníaco tendrán un penalizador de -1 para impactar. En combate cuerpo a cuerpo los enemigos que ataquen al Behemoth demoníaco tendrán un penalizador de -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="74ae-bb94-cb0f-0b12" name="Golpe demoledor" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="fe01-aeac-dcfd-8d25" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="31c8-ee2c-4d21-8efc" type="max"/>
              </constraints>
              <rules>
                <rule id="cf9c-b737-4194-2990" name="Golpe demoledor" hidden="false">
                  <description>Obtiene la regla especial Golpe letal heroico en sus ataques en combate cuerpo a cuerpo.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="5d64-3dc2-df07-57d1" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="35.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="3c7d-5ab9-2a95-0db5" name="Aura de nergía impía" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="be68-86e9-87ad-787c" type="max"/>
                <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="75ff-8e59-b9c8-f6e3" type="max"/>
              </constraints>
              <rules>
                <rule id="9ca1-c9d0-2280-d5f7" name="Aura de nergía impía" hidden="false">
                  <description>Obtiene una tirada de salvación especial de 4+.</description>
                </rule>
              </rules>
