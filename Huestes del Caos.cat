    <selectionEntry id="b149-14d1-5695-47c0" name="[H][GC][E] - Conde Mordrek, el condenado" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="0ebb-ea3a-f471-3e39" type="max"/>
      </constraints>
      <rules>
        <rule id="b171-21b5-f74e-ca79" name="Marcado por los dioses" hidden="false">
          <description>Mordrek no puede unirse a unidades ni ser el General del ejército.</description>
        </rule>
        <rule id="8093-9b5a-62ea-2a98" name="Marca del caos absoluto" hidden="false">
          <description>Permite repetir sus tiradas de salvación por armadura fallidas.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="058d-330b-f5dd-32e6" name="Caballería" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
        <infoLink id="170d-2a21-c906-65df" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink id="cdc6-205a-0c55-f093" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink id="4da9-3d99-f4aa-0627" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1D6+1)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <categoryLinks>
        <categoryLink id="5484-2464-0b0a-77b4" name="Comandantes" hidden="false" targetId="4c6f72647323232344415441232323" primary="true"/>
        <categoryLink id="1bb4-dc70-42f3-2915" name="Personajes" hidden="false" targetId="e839-bd6b-7e36-e758" primary="false"/>
        <categoryLink id="5be7-d46b-ec6a-89f7" name="Huestes de Apoyo" hidden="false" targetId="8243-422f-87a4-f048" primary="false"/>
