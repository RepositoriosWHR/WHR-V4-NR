          <entryLinks>
            <entryLink id="03f8-3c51-5f7b-eac1" name="[K] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="851d-09e2-b8cf-0fbb" type="selectionEntry">
              <rules>
                <rule id="78f5-1857-8509-e55d" name="Marca de Nurgle. Señor de la guerra Kurgan" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="9c87-c7c9-6860-96ee" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="cb64-2adc-2a61-5d7c" name="[K] - Marca de Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="00d7-f3ea-aa74-3e65" type="selectionEntry">
              <infoLinks>
                <infoLink id="3455-f99d-9962-bfd2" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink id="e13e-f650-f6cf-9cfc" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="d845-8740-07e5-ef08" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
            <entryLink id="6395-451a-b814-e9d9" name="[K] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="4756-cda3-950a-00a7" type="selectionEntry">
              <rules>
                <rule id="1c17-f570-0d29-4cd8" name="Marca de Tzeentch. Señor de la guerra Kurgan" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial (6+, o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="bda8-b521-48dc-e437" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="cb37-76e3-0df3-afd3" name="[K] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="cd4c-32a7-97a6-4d64" type="selectionEntry">
              <rules>
                <rule id="b7ac-6ceb-688d-419f" name="Marca de Caos absoluto. Señor de la guerra Kurgan" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="7f9e-670f-576a-a9a2" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="10.0"/>
              </costs>
            </entryLink>
          </entryLinks>
