            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1c99-95ad-21c7-ee7d" type="max"/>
          </constraints>
          <profiles>
            <profile id="a2f6-78ec-de21-da32" name="Talismán bendito de Plaga" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la marca de Nurgle. Proporciona a su portador la regla especial Regeneración (6+), o un +1 a su Regeneración si ya disponía de ella. Además, al inicio de cada uno de tus turnos, el portador recupera una herida que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="f36e-9d09-3399-9a4e" name="Regeneración (6+)" hidden="false" targetId="4aee-7485-a141-cd20" type="rule"/>
          </infoLinks>
