            <entryLink id="536d-011a-376e-4e0f" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="2">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="33b9-f5ac-0099-bb43" name="Marca de Tzeentch. Malditos del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink id="2d4f-e79e-a33b-bfb4" name="[GC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="fb11-4524-18fc-0692" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="3">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="f6d0-8070-28d9-ad8c" name="Marca de Nurgle. Malditos del Caos" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink id="2717-1b58-3d86-6761" name="[GC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="08d1-684e-f1be-fa4e" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="1">
                  <repeats>
