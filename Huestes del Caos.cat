            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="9d4b-c2f7-de78-25c9" type="max"/>
          </constraints>
          <profiles>
            <profile id="f8bb-e827-e204-3dd9" name="Esencia demoníaca" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene la regla especial Aura demoníaca (5+, o +1 a su Aura demoníaca si ya disponía de una) y se verá afectado por todos aquellos hechizos o efectos que afecten a miniaturas con la regla especial Demonio.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8efd-fc3c-80ce-2016" name="Aura demoníaca (5+)" hidden="false" targetId="e5ed-5149-3d72-6aa4" type="rule"/>
