            <entryLink id="2f30-0270-b48e-ff03" name="[GC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="e93a-ca85-8a5f-63c2" type="selectionEntry">
              <rules>
                <rule id="f3e8-6269-e80e-d57d" name="Marca de Nurgle. Paladín del Caos" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="06d1-f5ee-f928-5931" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
