            <entryLink id="feeb-646b-7db2-65ba" name="[K] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="5194-ed02-bc34-8b2c" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="20">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="8f38-d0b2-df75-cf35" name="Marca de Khorne. Gigante del Caos" hidden="false">
                  <description>Obtiene la regla especial Resistencia mágica (1); además, suma +1 a todas las tiradas en la tablas de ataques especiales del gigante (los resultados superiores a 6 se consideran 6)</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="3c43-5ff7-e965-e9a8" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="def7-acbc-ab88-2c49" name="[K] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="c752-a5a1-2916-2861" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="10">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="a685-6a43-3d6f-0a90" name="Marca de caos absoluto. Gigante del Caos" hidden="false">
                  <description>Obtiene una tirada de salvación por armadura de 5+.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
