      </modifiers>
      <constraints>
        <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="c7b2-6ef2-a44d-3296" type="max"/>
      </constraints>
      <rules>
        <rule id="4fc5-4921-e4cd-a982" name="Marcado por los dioses" hidden="false">
          <description>Mordrek no puede unirse a unidades ni ser el General del ejército.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="fd30-5b7b-6df0-6161" name="Caballería" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
        <infoLink id="25ea-445b-76ae-2a4b" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
        <infoLink id="c231-5a4a-2176-ce7f" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink id="b208-7ad3-6cde-69f6" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink id="2dca-30b4-ac32-b4e2" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1D6+1)"/>
