        <selectionEntry id="3f70-64b1-0323-ffee" name="Putrefacción de Nurgle" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1156-f8e5-1c73-3f3a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="10d0-6731-665c-e9c7" type="max"/>
          </constraints>
          <profiles>
            <profile id="83ca-a0c4-f7a5-1b45" name="Putrefacción de Nurgle" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Al inicio de cada ronda de combate cuerpo a cuerpo, todas las miniaturas (amigas y enemigas) que no tengan la Marca de Nurgle (o sean Demonios de Nurgle o skaven del Clan Pestilens) en contacto con el personaje sufrirán una herida sin tirada de salvación con armadura con un resultado de 6 en 1D6 (tira por cada miniatura en contacto).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1a6f-2fab-768c-255a" name="Tamaño descomunal" hidden="false" collective="false" import="true" type="upgrade">
