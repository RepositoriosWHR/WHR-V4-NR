                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="c5b4-c6cb-e2a8-9201" name="Marca de Tzeentch. Engendro del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="23c3-799a-0d90-9ceb" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
