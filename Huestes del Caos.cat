          <entryLinks>
            <entryLink id="c3cb-27a7-0be1-212f" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <rules>
                <rule id="7c41-a7a7-41d9-367c" name="Marca del Caos absoluto. Gran chamán del rebaño" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (6+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="fd88-11de-89e9-55c7" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="28c9-6fbd-e44d-4a9e" name="Piel escamosa (6+)" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="fde7-cd9c-7d4a-a5e6" name="[BC] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="824e-e35c-ef47-ee81" type="selectionEntry">
              <rules>
                <rule id="0ec4-8dd6-2a31-acf2" name="Marca de Tzeentch. Gran chamán del rebaño" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="1289-17fe-ef8a-c1ca" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="295a-b847-e297-4b02" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <rules>
                <rule id="65fd-81c8-d9b8-2086" name="Marca de Nurgle. Gran chamán del rebaño" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="df0e-b611-047f-5d58" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="662a-042e-db8a-c51d" name="[BC] - Marca de Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="96ac-1bc9-7f02-12c6" type="selectionEntry">
