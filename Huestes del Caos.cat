              </modifiers>
              <infoLinks>
                <infoLink id="9547-059d-fc28-923d" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="9387-feb0-d853-2db5" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
