        <rule id="b32c-5f33-3100-bca0" name="Las últimas cabras" hidden="false">
          <description>Los Ungors no provocan chequeos de Pánico en otras unidades amigas, salvo en Mutantes del Caos, Mastines del Caos y otras unidades con la clave ungors.</description>
        </rule>
        <rule id="38a5-3c6a-5bd6-9585" name="Los Bandidos Ungor" hidden="false">
          <description>La unidad de Ungors a la que se una Ungrol obtiene las reglas especiales Destruir la civilización, Disparo rápido y Emboscada (aunque Ungrol muera).</description>
        </rule>
      </rules>
