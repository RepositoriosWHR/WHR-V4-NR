            <profile id="1668-0a9b-48f0-8f7d" name="Hacha del pánico" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Las heridas causadas por el Hacha del pánico no pueden ser evitadas con una tirada de salvación especial (excepto si es una tirada de Esquivar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="6dba-1c6a-36f3-1dc2" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
