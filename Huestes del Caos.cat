            <entryLink id="1b2f-9ed7-0b58-0e05" name="[GC] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="d332-c67b-de03-9f0e" type="selectionEntry">
              <rules>
                <rule id="c03a-02dd-d24e-736f" name="Marca de Khorne. Príncipe demonio" hidden="false">
                  <description>Obtiene las reglas especiales Furia asesina, Odio (¡todos los enemigos!) y Resistencia mágica (2). No pierde su Furia asesina si es derrotado en combate.</description>
                </rule>
