    <selectionEntry id="75dd-4a6c-7a6a-05ac" name="[H][GC][E] - Harald Hammerstorm &quot;Harry el Martillo&quot;" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="93f1-c708-b2a3-3467" value="1">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="c1ad-52cf-cd54-a9db" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="93f1-c708-b2a3-3467" type="max"/>
      </constraints>
      <rules>
        <rule id="fc20-d0e7-c8ba-760f" name="Azote de los muertos vivientes" hidden="false">
          <description>Harry tiene la regla especial Odio (No muertos), la cual confiere también a su unidad. Además, cualquier unidad de No muertos que desee cargar contra Harry deberá superar primero un chequeo de Liderazgo; si lo falla, no podrá declarar ninguna carga ese turno.</description>
        </rule>
        <rule id="6348-738d-1ff4-76aa" name="Los guerreros de Harry" hidden="false">
          <description>La unidad de Guerreros del Caos a la que se una Harry el Martillo no tiene máximo de unidad; es decir, puedes incluir los Guerreros del Caos que desees en la unidad, no estás limitado al máximo habitual de 30.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2d1d-9be1-c6b2-5e5a" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
        <infoLink id="c92c-6cdf-712a-4429" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="994e-a6c5-c48f-c57a" name="Odio" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(No muertos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
