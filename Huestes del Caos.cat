    <selectionEntry id="cab4-40d5-e596-fead" name="[H][GC][E] - Sayl el Infiel, vidente de los yermos del Caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f7aa-70c2-83ad-1338" type="max"/>
      </constraints>
      <rules>
        <rule id="4c48-ab92-b21a-571f" name="Magia Sayl el Infiel" hidden="false">
          <description>Sayl es un hechicero de nivel 3 que puede elegir sus hechizos de entre los Saberes de los Cielos, las Sombras y Magia Oscura y puede elegir sus hechizos de dos o más de los saberes listados.. Además, conoce el hechizo La niebla del traidor</description>
        </rule>
        <rule id="9990-1159-e510-ae0c" name="Visión mutante" hidden="false">
          <description>Sayl puede repetir todos los chequeos de atributo que falle (salvo Liderazgo) y tendrá un bonificador de +2 a todas sus tiradas de 
Canalizar.</description>
        </rule>
        <rule id="bd42-e768-d0da-2e30" name="Hechizo único: La Niebla del traidor (Dificultad 6+)" hidden="false">
          <description>Se trata de un hechizo de Potenciación que Sayl puede lanzar sobre sí mismo. Si se lanza con éxito, Sayl puede hacer inmediatamente un movimiento con la regla especial Volar (10) como si se encontrase en la sub-fase de Resto de movimientos (no podrá utilizar este movimiento para realizar una carga, pero sí para retirarse de un combate).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="94f7-5084-26f0-7541" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="a7e8-2e68-130e-d601" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
