              </modifiers>
              <infoLinks>
                <infoLink id="4773-775a-6284-02a2" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="ef29-1739-cccf-10da" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink id="3556-9cea-0c89-4453" name="Carga devastadora" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
