      <selectionEntries>
        <selectionEntry id="da4a-2d5a-fb63-027f" name="Bendecido por el arquitecto del destino" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="39d9-1e32-d83b-383e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="d842-fd85-160c-7945" type="max"/>
          </constraints>
          <profiles>
            <profile id="ef12-38be-bdae-3fc2" name="Bendecido por el arquitecto del destino" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene un bonificador de +1 a su tirada por Aura demoníaca y un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
