      <entryLinks>
        <entryLink id="365d-4d2d-9e91-2a35" name="[GC] - Marca del Caos absoluto. Pesonajes" hidden="false" collective="false" import="true" targetId="82f2-d2ab-17e8-72cb" type="selectionEntry">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1aff-abb0-5588-07d7" type="min"/>
          </constraints>
          <rules>
            <rule id="1884-6ad2-47fc-2b2b" name="Marca del Caos absoluto. Sayl el Infiel" hidden="false">
              <description>Sayl porta la Marca del Caos absoluto, que le otorga la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto a Sayl toda la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="7acc-f9a2-763d-01e8" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
