          <profiles>
            <profile id="8f2c-12e7-adf2-4850" name="Cetro de la mutación" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene +1 a su Fuerza en sus disparos y ataques en combate cuerpo a cuerpo. Cada vez que el demonio cause una baja disparando o combatiendo cuerpo a cuerpo, tira 1D6: por cada resultado de 6, pon bajo tu control una miniatura de Engendro del Caos de Tzeentch a 6” menos del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="9e18-aae9-c39d-0357" name="[DC] - Arma demonio" hidden="false" collective="false" import="true" targetId="020b-fcbd-54b9-7c54" type="selectionEntry"/>
