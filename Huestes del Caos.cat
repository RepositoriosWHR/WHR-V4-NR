                  <modifiers>
                    <modifier type="append" field="name" value="(1D6+2)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
            </entryLink>
            <entryLink id="bbab-e137-423a-5c29" name="[BC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="1915-0c28-504c-dc89" type="selectionEntry">
