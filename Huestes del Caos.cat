              <profiles>
                <profile id="c6c7-de3b-9cb0-ee83" name="Restos de bridas centenarias" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al principio de cada fase de combate cuerpo a cuerpo, antes de realizar los impactos de Torrente de insectos viscosos, elige una miniatura en contacto peana con peana con Takunta&apos;Maha. Esta deberá realizar un chequeo de Iniciativa. En caso de fallarlo, esa miniatura reducirá su Habilidad de Armas a 1 (no reducible por la Marca de Nurgle) y no podrá usar la regla especial Esquivar durante esa fase de combate.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
