        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="1ae5-d572-a0ec-8b61" name="[BC] - Recompensas menores - Bestias del Caos - No hechicero/Khorne" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="4e56-1af9-9af8-daab" name="Hechicería del Caos" hidden="false" collective="false" import="true" type="upgrade">
