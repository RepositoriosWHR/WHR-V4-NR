              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f6b2-2609-27eb-cf23" type="max"/>
              </constraints>
              <rules>
                <rule id="b4ff-1249-901a-3b1b" name="Marca del Khorne. Principe demonio" hidden="false">
                  <description>Obtiene las reglas especiales Demonio (Khorne), Furia asesina y Resistencia mágica (2). No pierde su Furia asesina si es derrotado en combate.</description>
                </rule>
              </rules>
