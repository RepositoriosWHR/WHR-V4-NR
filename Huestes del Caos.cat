      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="18b9-ef6f-2ff8-166a" type="max"/>
      </constraints>
      <rules>
        <rule id="f812-ede0-e43e-c660" name="Regeneración mutante" hidden="false">
          <description>Regeneración (4+). Si regeneran 2 o más heridas en una misma fase, tira en la tabla de Ojo de los Dioses y aplica el resultado a toda la unidad. Considera los resultados de 11 a 14 como “El Ojo está cerrado”.</description>
        </rule>
        <rule id="d8ca-ac29-c8b4-5201" name="Gran vómito de troll" hidden="false">
          <description>En vez de atacar, el Troll del Caos anciano puede causar 1D3 impactos automáticos de Fuerza 5 sin tirada de salvación por armadura a una unidad enemiga en contacto peana con peana.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="c0ad-cba7-3290-af3c" name="Infantería monstruosa" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink id="7c3a-0326-729c-d3ed" name="Estupidez" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
        <infoLink id="e01e-fc5d-e84e-ecb5" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink id="2fa8-8ac8-2fa9-fafa" name="Regeneración mutante" hidden="false" targetId="bfae-ee37-b288-b716" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(4+)"/>
          </modifiers>
        </infoLink>
