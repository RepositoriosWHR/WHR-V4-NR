    <selectionEntry id="6e77-4ed5-e59c-9874" name="[K] - Los incursores de Wulfrik" hidden="false" collective="false" import="true" type="upgrade">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="71c2-769a-d3df-a4d3" type="equalTo"/>
