          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="35ec-8d27-147d-1ebf" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="db28-8f0b-42e2-bcfa" type="max"/>
          </constraints>
          <profiles>
            <profile id="4c48-701c-cfa8-845f" name="Viento del Caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Los Vientos del Caos disparan como un Lanzallamas (puede disparar aunque el personaje mueva o marche) que puede estimar hasta 3 dados. Se resuelve con Fuerza 8, tira para herir contra el Liderazgo del objetivo en lugar de contra su Resistencia y no permite tirada de salvación por armadura; cualquier unidad que sufra al menos una baja por esto deberá realizar inmediatamente un chequeo de Pánico. Si obtienes un resultado de Problemas, el disparo simplemente no se realiza (no tires en la tabla de Problemas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6a14-32b4-ba2d-202a" name="Resolución oscura" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3294-c3e1-0b00-edb4" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8de9-cfc1-6f91-aa8f" type="max"/>
