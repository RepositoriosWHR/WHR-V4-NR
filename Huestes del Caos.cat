        <selectionEntry id="65ce-82cd-81cd-3e07" name="Relicario del destino" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8bb6-2476-b69f-f327" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="eeb1-8d6a-4a8f-6d83" type="max"/>
          </constraints>
          <profiles>
            <profile id="356b-5cdf-b81b-d46f" name="Relicario del destino" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto portahechizos, nivel de energía 1D3. Contiene un hechizo de Potenciación que toma como objetivo a una unidad amiga a 12” o menos del portador y Permanece un turno. Por la duración del hechizo, todas las tiradas para herir contra la unidad tendrán un penalizador de -1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="5c7a-e10c-cfb1-d36f" name="Relicario de llamas" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1e22-0ad7-e630-c09e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="bb9a-acc1-4d6b-0b69" type="max"/>
          </constraints>
          <profiles>
            <profile id="1965-e57f-081d-8128" name="Relicario de llamas" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto portahechizos. Nivel de energía 1D3. Contiene un hechizo de Daño directo con un alcance de 18” que toma como objetivo una unidad enemiga. Cada miniatura de la unidad enemiga sufre un impacto de Fuerza 1 con la regla especial Ataques sólo flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="1024-42ef-eaa7-a7e8" name="Ataques solo flamígeros" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
