              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo hechiceros. Sólo Infantería. El portador obtiene la regla especial Etéreo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2457-53e4-8d3b-7484" name="Etéreo" hidden="false" targetId="34c4-9e60-1a62-eda5" type="rule"/>
