          </constraints>
          <profiles>
            <profile id="722e-36b5-263c-f28d" name="Infestación de nurgletes" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">Al inicio de cada turno de jugador, tira 1D6: con un resultado de 4+, puedes poner un Enjambre de nurgletes a 6” o menos del demonio (puede unirse a una unidad existente de Nurgletes). Además, el demonio obtiene 2D6 ataques adicionales de HA3, F3 e I3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="af07-f8c2-6668-1ed7" name="Torrente de bilis" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="02c4-fcce-fdf3-097c" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="c14f-ca0f-039a-4c3c" type="max"/>
