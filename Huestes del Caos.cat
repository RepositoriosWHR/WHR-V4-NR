            <profile id="52af-8bdb-b9fb-3ccb" name="Meteorito lunar" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
              <characteristics>
                <characteristic name="Rango" typeId="52616e676523232344415441232323">Ilimitado</characteristic>
                <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4 (10)</characteristic>
                <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Plantilla redonda pequeña, Ataques mágicos, Heridas múltiples (1D6, sólo impacto central) </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule id="feb5-cf16-35ef-d8f2" name="Vástago del Orbe Grávido" hidden="false">
              <description>En cada una de tus fases de disparo, podrás efectuar un disparo usando las reglas de Catapulta (aunque no tiene alcance máximo ni mínimo y siempre se considera que tiene línea de visión hacia el objetivo). El disparo se resolverá usando el perfil detallado a continuación. Un resultado de Problemas indica que debes colocar la plantilla centrada en Garralunar.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="c2f5-dbb0-d406-969f" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink id="1485-59f3-e24b-8521" name="Heridas múltiples (1D6)" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule">
              <modifiers>
                <modifier type="append" field="name" value="(Central)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
