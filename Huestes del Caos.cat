              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="b3f4-f3f7-826e-3091" name="[BC] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="eb4f-fa51-51ac-bbec" type="selectionEntry">
              <rules>
                <rule id="4cef-f4b9-e9d4-d12a" name="Marca de Nurgle. Minotauro destripador" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
