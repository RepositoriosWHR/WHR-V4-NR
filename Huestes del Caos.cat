      <rules>
        <rule id="6e06-d279-bdad-943f" name="Magia Gran inmundicia de Nurgle" hidden="false">
          <description>Una Gran inmundicia de Nurgle es un hechicero de nivel 2 que siempre usa el Saber de Nurgle. Puedes aumentar su nivel de magia a 3 (+35 puntos) o hasta 4 (+90 puntos).</description>
        </rule>
      </rules>
