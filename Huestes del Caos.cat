          <profiles>
            <profile id="aa32-de23-07e2-04c1" name="Astado" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene la regla especial Impactos por carga (1D3), si ya disponía de esa regla, sus impactos por carga aumentarán hasta 1D6; si ya causaba 1D6 impactos por carga, puede tirar 2D6 y elegir el resultado mayor para determinar sus Impactos por carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a49a-9c83-8425-9e9e" name="Impactos por carga (1D3)" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
