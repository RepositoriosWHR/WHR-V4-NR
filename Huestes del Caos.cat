      <selectionEntryGroups>
        <selectionEntryGroup id="c73f-f9c5-52ff-c909" name="Marcas del caos" hidden="false" collective="false" import="true">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6974-5e04-302c-f1a4" type="max"/>
          </constraints>
          <entryLinks>
            <entryLink id="6d04-7cc4-bb92-fa0d" name="[GI] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="0d4d-b934-56dd-d521" type="selectionEntry">
              <rules>
                <rule id="9c33-1f86-3ad4-47d5" name="Marca de Nurgle. Engendro monstruoso del Caos" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y en combate cuerpo a cuerpo.</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="30.0"/>
              </costs>
            </entryLink>
            <entryLink id="9d39-2810-27f3-3e26" name="[GI] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="be24-e143-bbb6-e28c" type="selectionEntry">
              <rules>
                <rule id="addf-03e2-1439-7efd" name="Marca de Khorne. Engendro monstruoso del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Odio (¡todos los enemigos!) y Resistencia mágica (1) y sus Ataques aleatorios pasan a ser 2D6+4.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="716f-a4ab-ef88-728b" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="913a-cd41-7048-ef6b" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink id="0d48-76a4-6a4a-b3aa" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(2D6+4)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="25.0"/>
              </costs>
            </entryLink>
            <entryLink id="b147-0de7-2185-968f" name="[GI] - Marca de Slaanesh. Unidades" hidden="false" collective="false" import="true" targetId="2d07-75d8-1827-6aa9" type="selectionEntry">
              <rules>
                <rule id="23c5-8436-5248-597b" name="Marca de Slaanesh. Engendro monstruoso del Caos" hidden="false">
                  <description>Obtiene la regla especial Poder de penetración; además, cada vez que vayas a mover el Engendro monstruoso, puedes repetir la tirada de uno de sus dados de Movimiento aleatorio.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="93a4-1fc3-db2c-2391" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="25.0"/>
              </costs>
            </entryLink>
            <entryLink id="38eb-7df5-573b-413e" name="[GI] - Marca del caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="0b36-c6c0-1cb3-02d0" type="selectionEntry">
              <rules>
                <rule id="c124-1331-f162-74ae" name="Marca de caos absoluto. Engendro monstruoso del Caos" hidden="false">
                  <description>Al inicio de la batalla, realiza una tirada adicional en la tabla de Mutaciones del Engendro monstruoso y aplica el resultado durante toda la batalla (repite los resultados duplicados).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="3f64-9c48-f956-504f" name="Ojo de los dioses" hidden="false" targetId="d775-2334-395b-688e" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="a8a8-40d5-47e4-4cfb" name="[GI] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="5b87-e012-051a-fc0b" type="selectionEntry">
              <rules>
                <rule id="a532-8395-9173-8f7f" name="Marca de Tzeentch. Engendro monstruoso del Caos" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="a89b-6566-85ba-ca7c" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="25.0"/>
              </costs>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
