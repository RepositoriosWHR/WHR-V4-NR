    <selectionEntryGroup id="320a-5344-fd81-6b2b" name="[GC] - Armas mágicas. Guerreros del Caos. Tzeentch. Arma bruja" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7c5f-60a2-b8c2-d3e3" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f792-4368-051f-9cf4" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="6ca9-a5ec-96ee-f059" name="Espada de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6f00-9664-a424-fa4f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="81cf-e5bc-2922-063d" type="max"/>
          </constraints>
          <profiles>
            <profile id="7c57-2fda-7f19-ae39" name="Espada de disformidad" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la Marca de Tzeentch. Arma bruja. Al inicio de cada ronda de combate cuerpo a cuerpo, tira 1D6 en la siguiente tabla y aplica el resultado durante toda la ronda de combate: 
1- El portador realiza la mitad de sus ataques (redondeando hacia abajo) contra sí mismo o contra su propia unidad (a tu elección). Puede realizar normalmente el resto de sus ataques.
2- El portador tiene Iniciativa 1 y +2 a su Fuerza .
3- Todas las miniaturas (amigas o enemigas) en contacto peana con peana con el portador sufren inmediatamente un impacto de Fuerza 4 con la regla especial Ataques sólo flamígeros. 
4- El portador impacta automáticamente. 
5- El portador obtiene la regla especial Heridas múltiples (2) 
6- Golpe letal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="29fa-6a6b-8d1c-78bc" name="Arma bruja" hidden="false" targetId="6497-ea89-cfe5-8284" type="profile"/>
            <infoLink id="8559-0865-baed-d149" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="2b25-408c-66b1-9ed1" name="[GC] - Armas mágicas. Reliquias. Guerreros del Caos. Arma de mano" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9ac1-9890-338c-6c4f" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1dca-aefd-3852-b75a" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="07a6-6c63-4dd3-4cb0" name="Arma demonio" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f74c-4f61-fb20-bd35" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d4f3-5023-0e7c-f504" type="max"/>
          </constraints>
          <profiles>
            <profile id="7f19-802a-3815-51b4" name="Arma demonio" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al atacar con este arma, el portador obtiene 1D6 Ataques adicionales (tira cada vez que vayas a atacar); además, sus impactos se resuelven con +1D3 a su Fuerza (tira cada vez que vayas a atacar). Cada resultado de 1 para impactar con este arma deberá resolverse para herir contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="5385-9196-07d5-ee40" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="75.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9fb9-2b87-9f74-f959" name="Padre de las espadas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e058-78da-a721-6536" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b9ee-eb5d-026e-7512" type="max"/>
          </constraints>
          <profiles>
            <profile id="1940-6be0-1092-ee08" name="Padre de las espadas" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al luchar con este arma, todos los resultados de 1 en las tiradas para impactar en combate cuerpo a cuerpo con este arma se consideran resultados naturales de 6 y todos los enemigos que ataquen en combate cuerpo a cuerpo al portador consideran todos los resultados de 6 en sus tiradas para impactar como resultados naturales de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="15a8-1a02-5ba7-ffb3" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="9ca2-ca9f-cad3-9a76" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
