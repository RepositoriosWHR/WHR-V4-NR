              <rules>
                <rule id="0f8a-edcf-af2b-ce73" name="Marca de Nurgle. Paladín ogro del Caos" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="b55d-8399-0dcf-9dcf" name="Terror" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
