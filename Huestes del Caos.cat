              <profiles>
                <profile id="3ef2-af23-e632-0177" name="Maza del cuervo" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos con la Maza del Cuervo siempre hieren con un resultado de 4+ (sin importar la Resistencia del objetivo), y tienen la regla especial Poder de penetración.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
