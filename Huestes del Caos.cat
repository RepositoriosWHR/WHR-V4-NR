    <selectionEntryGroup id="1b3a-df44-706b-757d" name="[BC] - Armas Mágicas - Bestias del Caos - Lanza" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0440-bfb4-5702-3ec8" type="max"/>
