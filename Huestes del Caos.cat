            <selectionEntry id="834c-282c-e7d6-696e" name="Pócimas pestilentes" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="564e-bf92-9226-3330" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f069-b8c8-d144-23cc" type="min"/>
              </constraints>
              <profiles>
                <profile id="5d65-deb5-7a80-79d0" name="Pócimas pestilentes" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de cada una de tus fases de disparo, puedes elegir uno de los siguientes efectos y aplicarlo:
- Festus u otra miniatura en su unidad recupera una herida que hubiesen sufrido con anterioridad durante la batalla.
- Los Ataques envenenados de Festus y su unidad tendrán efecto con un resultado de 5+ (en lugar del habitual 6+) el inicio de tu siguiente fase de disparo.
- Festus puede realizar un disparo. Coloca la plantilla redonda pequeña a 12” o menos del portador y tira los dados de artillería y dispersión como si estuvieses disparando una Catapulta aunque, si se dispersa, lo hará la mitad de la distancia indicada en el dado de artillería. Cualquier miniatura bajo la plantilla (usa las reglas habituales para impactos parciales) sufrirán un impacto de Fuerza 3 que no permite tirada de salvación por armadura. Cualquier unidad que sufra al menos una baja de este ataque tendrá que efectuar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
                <cost name="pts" typeId="points" value="0.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
            <selectionEntry id="ca01-e01c-c747-c399" name="Familiar nurglete" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f6c7-2540-809e-27aa" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c379-1bbe-f84a-664f" type="min"/>
              </constraints>
              <profiles>
                <profile id="f530-36ab-3cc2-9b91" name="Familiar nurglete" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Además de sus dos hechizos, Festus conoce siempre el hechizo La maldición del leproso (Saber de Nurgle).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <costs>
