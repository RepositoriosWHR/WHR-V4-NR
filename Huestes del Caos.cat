              </costs>
            </entryLink>
            <entryLink id="621c-557f-9a07-6f3d" name="[GI] - Marca de Tzeentch. Personajes" hidden="false" collective="false" import="true" targetId="db84-b5c7-fe44-c8b4" type="selectionEntry">
              <rules>
                <rule id="9095-db41-cace-9d33" name="Marca de Tzeentch. Paladín ogro del Caos" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="3a15-c237-4cbf-75e5" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink id="564e-01f8-9d8b-5b2e" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <costs>
