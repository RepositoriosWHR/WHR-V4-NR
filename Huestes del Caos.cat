            <rule id="5719-244a-9165-23e9" name="Foco mayor del Caos absoluto" hidden="false">
              <description>Al inicio de cada ronda de combate, todas las miniaturas enemigas en contacto con el demonio sufrirán un impacto automático de Fuerza 4 con la regla especial Ataques mágicos.</description>
            </rule>
          </rules>
