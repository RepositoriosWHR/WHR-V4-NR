              </modifiers>
              <rules>
                <rule id="de02-9c71-ccf0-c5f6" name="Marca de Slaanesh. Jinetes soldados del Caos" hidden="false">
                  <description>Obtienen +1 a la Iniciativa (sólo los jinetes) y la regla especial Inmune a Miedo.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="4ca4-03c2-34fc-6e58" name="Inmune al miedo" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="705e-64a5-3b96-5be4" name="[GC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="08d1-684e-f1be-fa4e" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="1">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
