        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0380-1dd6-58a4-1af1" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="493e-1177-18cb-bf36" name="Ojo de la Noche" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a653-f44d-fd1f-162b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="64f1-14aa-1219-f73e" type="max"/>
          </constraints>
