                </modifier>
              </modifiers>
              <rules>
                <rule id="9ed4-b62b-64cb-fbe8" name="Marca de Tzeentch. Ogros dragón" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="eecc-ce94-3e12-6b03" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
