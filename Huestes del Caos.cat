          </constraints>
          <rules>
            <rule id="947f-1bcc-52f1-97bd" name="Magia Bruja Troll del Caos" hidden="false">
              <description>Un único Troll del Caos anciano del ejército que no tenga la Marca de Khorne puede convertirse en Bruja troll del Caos (+40 puntos). Una Bruja troll del Caos es hechicera de nivel 1 que puede elegir sus hechizos de uno (y sólo uno) de los Saberes de las Bestias, Magia oscura o el Saber de su Dios del Caos. Puede aumentarse a nivel 2 de magia (+30 puntos).</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup id="ee13-706b-663a-c026" name="Nivel de magia" hidden="false" collective="false" import="true">
