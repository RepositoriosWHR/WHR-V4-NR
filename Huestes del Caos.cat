                    <rule id="59b3-b6e5-ddda-64e2" name="Recompensas del Caos de Leyenda" hidden="false">
                      <description>Un personaje que porte una Recompensa mayor y una Reliquia, o dos Recompensas mayores, obtiene la regla especial Leyenda.</description>
                    </rule>
                  </rules>
                  <infoLinks>
                    <infoLink id="2f95-1ea7-68dd-a367" name="Leyenda" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
                  </infoLinks>
