      <rules>
        <rule id="760b-6446-d966-f5fb" name="Jauría del dios de la sangre" hidden="false">
          <description>Karanak deberá entrar en batalla unido a una unidad de Mastines de Khorne. No podrá abandonar la unidad durante la batalla.</description>
        </rule>
        <rule id="1b92-9527-e5a0-d7a6" name="Marca de la presa" hidden="false">
          <description>Al inicio de la batalla, elige un personaje enemigo. Los ataques de Karanak dirigidos contra la miniatura elegida podrán repetir las tiradas fallidas para herir.</description>
        </rule>
      </rules>
