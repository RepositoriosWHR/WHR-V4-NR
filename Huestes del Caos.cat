      </constraints>
      <rules>
        <rule id="5c48-133d-3546-4cc8" name="Magia Tchar´zanek" hidden="false">
          <description>Tchar’zanek es un hechicero de nivel 4 que siempre utiliza hechizos del Saber de Tzeentch.</description>
        </rule>
        <rule id="0109-eb67-c366-9847" name="Marcado por la grandeza" hidden="false">
          <description>Tchar’zanek tiene la regla especial Tozudez y puede repetir sus tiradas en la tabla del Ojo de los dioses. Además, puede repetir los resultados de 1 en sus tiradas de salvación especial.</description>
        </rule>
        <rule id="7614-9415-6820-beb8" name="La Hueste del Cuervo" hidden="false">
          <description>Tchar’zanek, puedes incluir una unidad de Elegidos del Caos con la Marca de Tzeentch como opción de Unidad 
Especial. Tchar’zanek debe unirse a esa unidad.</description>
        </rule>
      </rules>
