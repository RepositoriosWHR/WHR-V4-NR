          <entryLinks>
            <entryLink id="d27b-bcbb-4ca4-c6bc" name="[BC] - Marca del Caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="832c-b5f0-c7e2-9e63" type="selectionEntry">
              <rules>
                <rule id="4276-6962-580f-1393" name="Marca del Caos absoluto. Bestia maldita" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (6+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="0914-4e18-4a08-0db8" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink id="0388-8e9e-05b1-e50d" name="Piel escamosa (6+)" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
              </costs>
            </entryLink>
            <entryLink id="8961-0855-bc55-9b83" name="[BC] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="5a59-366d-b4b0-6581" type="selectionEntry">
