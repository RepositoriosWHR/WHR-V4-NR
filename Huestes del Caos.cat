            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="be89-c607-7a0b-7c7e" name="Tótem de rabia y odio" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d26c-5ca6-fb35-8f08" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6848-676c-d7ff-02f8" type="max"/>
          </constraints>
          <profiles>
            <profile id="3a4c-9716-4971-4f90" name="Tótem de rabia y odio" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen las reglas especiales Carga devastadora y Odio (¡todos los enemigos!). Si tienen la marca de Khorne, en su lugar podrán repetir todas sus tiradas fallidas para impactar en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="dc6e-8817-a7ef-619d" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
            <infoLink id="bfba-d4c5-b9aa-b06f" name="Carga devastadora" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="5826-a563-c30b-2481" name="Estandarte de carne viva" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4903-42df-2d05-a703" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6924-91ad-7949-acba" type="max"/>
          </constraints>
          <profiles>
            <profile id="8646-26e3-c6f2-1a99" name="Estandarte de carne viva" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Al inicio de cada fase de combate cuerpo a cuerpo, elige una unidad enemiga en contacto peana con peana con el portador: dicha unidad sufrirá 1D6 impactos de Fuerza 4 con la regla especial Atques mágicos (distribuidos como proyectiles, pero sólo contra la unidad elegida). Las bajas causadas por estos impactos cuentan para el resultado del combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9eb6-bc33-e84e-0df8" name="Estandarte de la vergüenza" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="aba4-5415-05e9-a397" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="195e-419a-13ac-9887" type="max"/>
          </constraints>
          <profiles>
            <profile id="8fa8-b3a7-5ef8-7b6e" name="Estandarte de la vergüenza" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad fallarán automáticamente sus chequeos de Indisciplina.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bfef-1a39-4a0a-5dec" name="Indisciplina" hidden="false" targetId="f12c-aa7a-88e6-b6f2" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="a5b0-a815-2aae-0ded" name="[BC] - Estandartes Mágicos - Bestias del Caos - Emboscada" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d7d8-4d5d-a48f-8a74" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="dc16-7a80-c04b-7e7d" name="Cazapresas" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a425-e9ca-49b8-1e4b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9a69-0421-e57f-6d35" type="max"/>
          </constraints>
          <profiles>
            <profile id="77de-391c-9d41-ef43" name="Cazapresas" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo unidades con Emboscada. La unidad puede repetir sus tiradas fallidas de Refuerzos para determinar si entran al campo de batalla. Además, durante el turno en el que entren en el campo de batalla como Refuerzos, podrán repetir sus tiradas de carga fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="22bf-f77b-8801-e492" name="Emboscada" hidden="false" targetId="205a-c2c4-c48e-44c2" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="dfd1-cd2c-0dd7-63a3" name="[BC] - Objetos Hechizados - Bestias del Caos" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a994-007f-2bc0-6442" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="079d-bfa1-fa38-51b9" name="Cuerno de la Gran Cacería" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ce37-914d-c3ae-e5bd" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a1a0-259f-e464-dcf6" type="max"/>
          </constraints>
          <profiles>
            <profile id="46d0-8f80-de66-650f" name="Cuerno de la Gran Cacería" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 4. Contiene el hechizo Furia primitiva de Magia Oscura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0fde-2d04-e2cb-f2ba" name="Piedra del Resentimiento" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4578-dc7f-1322-da47" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="73db-a0fe-888d-bc4e" type="max"/>
          </constraints>
          <profiles>
            <profile id="d836-5bb7-6081-1252" name="Piedra del Resentimiento" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Cada vez que el portador supere una tirada de salvación por armadura o especial en combate cuerpo a cuerpo, causará inmediatamente a la miniatura o unidad que le causó la herida un impacto automático de Fuerza 5 con la regla especial Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="9bbc-a87f-d473-2a2b" name="Amuleto de piedra de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e9e3-6655-c7d6-fed3" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="68e4-9199-3cc2-c3d9" type="max"/>
          </constraints>
          <profiles>
            <profile id="0e2d-2a76-5160-bbd6" name="Amuleto de piedra de disformidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, Regeneración, un dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1119-612f-70dc-d35d" name="Corazón oscuro" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="64bb-4a8c-88ea-ddae" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0d68-1e65-8d7e-5186" type="max"/>
          </constraints>
          <profiles>
            <profile id="6dca-1b20-fc45-e936" name="Corazón oscuro" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y la unidad en la que se encuentre obtienen la regla especial Furia asesina y no la perderán aunque sean derrotados en un combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="db29-5a1f-4f72-9e53" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="622b-bb1d-1c33-865f" name="Diente ensangrentado" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d384-de64-2a47-737c" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ac96-b565-cb28-c07c" type="max"/>
          </constraints>
          <profiles>
            <profile id="487c-bc97-7c66-4bc8" name="Diente ensangrentado" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador estará sujeto a las reglas especiales Furia asesina, Ansia de sangre y Odio (¡todos los enemigos!). Además, es un objeto portahechizos con nivel de energía 4 que contiene el hechizo Furia vengadora (Saber de las Bestias).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="c277-280c-9a01-a608" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink id="82a3-0ee1-b54e-3b77" name="Ansia de sangre" hidden="false" targetId="2a68-a009-1a7a-c667" type="rule"/>
            <infoLink id="dd14-036d-0a6e-824b" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="f789-dd14-0251-1cde" name="[BC] - Objetos Hechizados - Bestias del Caos - Semental centigor" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="a49b-8f47-9aa1-7650" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="3ad0-c78e-9447-8f9b" name="Las herraduras de Hrufgor" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8673-09e1-57f6-2f35" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4f09-f23d-9bc0-dece" type="max"/>
          </constraints>
          <profiles>
            <profile id="d99a-8124-d8d6-178c" name="Las herraduras de Hrufgor" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo Semental centigor. Incrementa el atributo de Movimiento del portador y de su unidad en +1. Además, el portador y su unidad tirarán 1D6 adicional descartando el resultado menor para cargar, perseguir, huir y arrasar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="fc1d-03e0-91ea-37c1" name="[BC] - Objetos Hechizados - Reliquias - Bestias del Caos" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="da4c-f950-9716-5710" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="dc49-d8ee-65d6-7473" name="Cuerno de la primera bestia" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1d09-8674-6cfb-097a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="895a-c458-63c5-38d9" type="max"/>
          </constraints>
          <profiles>
            <profile id="baca-a358-91f1-89f1" name="Cuerno de la primera bestia" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al inicio de cualquiera de tus turnos. Todas las unidades amigas con la clave BESTIAS DEL CAOS a 24” o menos del portador obtienen la regla especial Carga devastadora hasta el final de tu turno y podrán repetir sus tiradas fallidas de carga ese turno; además, todas las unidades amigas en dicho radio se verán afectadas por Furia bestial (el resultado 5-6 de la tabla de Indisciplina) ese turno, incluso aunque no tengan la regla especial Indisciplina.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="a77d-d31f-0244-5395" name="[BC] - Recompensas mayores - Bestias del Caos" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="e5db-7b0c-08f9-12d0" name="Bendición de Aetyr" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4045-b428-95ab-01be" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7b53-4409-930e-22d0" type="max"/>
          </constraints>
          <profiles>
            <profile id="31df-4d8f-86ca-591c" name="Bendición de Aetyr" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene la regla especial Resistencia mágica (3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2730-215e-e9ba-e190" name="Resistencia mágica (3)" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
          </infoLinks>
          <entryLinks>
            <entryLink id="eb63-2559-167c-ddba" name="Recompensa mayor" hidden="false" collective="false" import="true" targetId="e471-a674-c4bc-d62e" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6150-7409-af26-6c47" name="Coraza demoníaca" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1817-8926-2853-9f02" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6cc7-3304-d784-32e9" type="max"/>
          </constraints>
          <profiles>
            <profile id="228f-b430-aad4-6cb2" name="Coraza demoníaca" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene una tirada de salvación por armadura (1+) y podrá repetir sus tiradas de salvación por armadura fallidas. Esta Recompensa del Caos no penaliza las capacidades mágicas de lanzamiento de hechizos del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="f694-bca5-97e0-c9b3" name="Recompensa mayor" hidden="false" collective="false" import="true" targetId="e471-a674-c4bc-d62e" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f90c-a76a-c4e3-9e7d" name="Esplendor diabólico" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d4c2-3c51-5d81-1986" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1a8b-afb3-7da1-88cd" type="max"/>
          </constraints>
          <profiles>
            <profile id="0049-454a-2dcf-6e51" name="Esplendor diabólico" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Todos los enemigos a 12” o menos del personaje tendrán un penalizador de -1 a su Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="ede1-f8e0-69ad-7c41" name="Recompensa mayor" hidden="false" collective="false" import="true" targetId="e471-a674-c4bc-d62e" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4013-d0a0-6c64-8681" name="Ungido del caos " hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="62ed-c2c1-ac65-a67e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cfe5-b49c-6ef5-6777" type="max"/>
          </constraints>
          <profiles>
