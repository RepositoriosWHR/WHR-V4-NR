      <selectionEntries>
        <selectionEntry id="6f0b-4ce6-fdb8-6b6b" name="Familiar del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c27f-ce5e-9307-9180" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1e05-1065-67d6-1a1b" type="max"/>
          </constraints>
          <profiles>
            <profile id="96c1-24ef-84fc-aa63" name="Familiar del caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El hechicero genera un dado adicional de Energía y Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a311-da02-b0d9-a1d8" name="Bastón rúnico del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8814-3286-e3e8-cda7" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5f47-777e-2ec7-15a1" type="max"/>
          </constraints>
          <profiles>
            <profile id="6de8-71e3-7599-2e75" name="Bastón rúnico del caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, puedes robar uno de los dados de Dispersión de tu oponente y añadirlo a tu reserva de dados de Energía.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="ec6e-5f13-c02d-bd72" name="Collar de cabezas de brujo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7f0d-22fe-0dfd-bdbe" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="adf5-c9ca-8b8b-9bfd" type="max"/>
          </constraints>
          <profiles>
            <profile id="7efe-1ee6-46e8-8022" name="Collar de cabezas de brujo" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, determina al azar un hechizo en la siguiente tabla: el collar actúa como un objeto portahechizos con nivel de energía 1D3+1, lanzando el hechizo indicado (no puede lanzarse la versión potenciada de ninguno de los hechizos).
1D6 Collar de cabezas de brujo
1 Oscura mano de destrucción (Magia Oscura) 
2 Portento de Phar (Saber de los Cielos)
3 Miasma mística de Melkoth (Saber de las Sombras)
4 Forma salvaje de Wyssan (Saber de las Bestias) 
5 Furia primitiva (Magia Oscura)
6 Malicia de Khaine (Magia Oscura)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a93c-97b0-6447-c235" name="Icono de los cataclismos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="ff40-008e-2d8a-6e50" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b0e3-337a-3393-f120" type="max"/>
          </constraints>
          <profiles>
            <profile id="8e6e-76f4-e55b-aa31" name="Icono de los cataclismos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos. Además, si tu ejército incluye un personaje equipado con este objeto mágico, cuando vayas a determinar el Cataclismo antes de la batalla, puedes tirar 2 veces en la tabla y elegir el resultado que desees de entre ambos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="b5cf-d359-f876-14b8" name="[GI] - Estandartes mágicos. Grey infernal" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="74f3-a454-1cf8-39ef" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="55ef-184f-cc81-0a15" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="1da0-a722-e9fd-1fbe" name="Tótem de la muerte" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4337-da10-a3f8-0a40" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d046-b383-cef2-e6fa" type="max"/>
          </constraints>
          <profiles>
            <profile id="4ddd-f933-a53c-4d7a" name="Tótem de la muerte" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad en la que se encuentre obtienen las reglas especiales Furia asesina y Carga devastadora.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="ad89-6f53-d748-d604" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink id="49bb-d055-96e0-30f2" name="Carga devastadora" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="422d-0919-e5ec-1acc" name="[GI] - Objetos hechizados. Grey infernal" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="bc72-7fd2-08c8-9c5d" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="91cd-8ea6-a82b-e015" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="ad76-e71c-39fa-1e8e" name="Ojo brujo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e4db-48e7-91e1-6916" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8bca-29a7-2c88-eb6d" type="max"/>
          </constraints>
          <profiles>
            <profile id="c7a3-e054-faef-43ea" name="Ojo brujo" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de Potenciación que puede lanzarse sobre una unidad 
amiga a 12” o menos del lanzador y Permanece un turno. Tira 1D6 para determinar el efecto sobre la unidad:

1 Atrofia: -1 a la Fuerza y Resistencia. 
2-3 Fortalecimiento: +1 a la Fuerza.
4-5 Vigorización: +1 a la Resistencia.
6 Poder oscuro: +1 a la Fuerza y Resistencia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="fb0f-137d-22a9-b558" name="Amuleto de piedra de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="845a-7240-0e7e-0e22" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ff03-0893-e6d4-a299" type="max"/>
          </constraints>
          <profiles>
            <profile id="adf9-ef75-06d6-3bd8" name="Amuleto de piedra de disformidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, un único dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="2adc-0a01-a480-0f00" name="Cuerno de la embestida" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e03d-07b3-4d82-9cf7" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="36bc-a350-c72c-442c" type="max"/>
          </constraints>
          <profiles>
            <profile id="8be6-387b-dbf0-8410" name="Cuerno de la embestida" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 1D3+1. Contiene un hechizo de Potenciación que toma como objetivo a una unidad amiga a 12” o menos del lanzador y Permanece un turno. Cuando resuelvas el hechizo, si la la unidad objetivo no está trabada en combate, muévela inmediatamente 1D6+2” hacia adelante; si ese movimiento lleva a la unidad a contacto con una unidad enemiga, se considerará una carga. Además, por la duración del conjuro, la unidad obtiene la regla especial Impactos por carga (1) o sumará 1 a sus impactos por carga si ya disponía de dicha regla especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="32d8-c3fa-f484-e4b1" name="Glifo de vitalidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="31e2-f461-a2b4-597f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b811-2b11-94fa-1692" type="max"/>
          </constraints>
          <profiles>
            <profile id="ff81-d332-3110-3bfa" name="Glifo de vitalidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 1D3+1. Contiene un hechizo de Potenciación que puede lanzarse sobre una única miniatura amiga a 12” o menos del lanzador. La miniatura seleccionada recupera inmediatamente hasta 1D3 heridas perdidas previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="f501-852d-4a00-f563" name="[GI] - Objetos hechizados. Reliquias. Grey infernal" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c79c-5b22-4ee4-c3ed" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="dd5f-c4bc-6cbe-0c40" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="9144-9c4b-dd43-6bf9" name="Relicario de Krakanroc el Negro " hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="76b9-653f-7718-016f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ff80-d490-b313-3249" type="max"/>
          </constraints>
          <profiles>
            <profile id="c2ab-bb2c-08fc-f6dc" name="Relicario de Krakanroc el Negro " hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puedes utilizar el Relicario de Krakanroc el Negro al inicio de cualquier turno de jugador (propio o del oponente). Hasta el final de dicho turno de jugador, todas las unidades enemigas a 12” o menos del portador no podrán beneficiarse de las reglas especiales Inmune a psicología, Inmune a Miedo, Inmune a Pánico, Estupidez, Furia asesina, Impasible, Tozudez e Indesmoralizable. Esto no afecta a miniaturas con las reglas especiales Demonio o No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="864f-0027-4945-bb43" name="[GI] - Recompensas del caos" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="4f88-bd06-d0aa-08b5" name="Sudor fangoso" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d094-0855-8b4e-c923" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6838-e162-a20d-cde1" type="max"/>
          </constraints>
          <profiles>
            <profile id="1c25-1dd6-6082-f94c" name="Sudor fangoso" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Todos los ataques cuerpo a cuerpo contra el personaje tendrán un penalizador de -1 en su tirada para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0dae-fe63-57f9-d2e6" name="Corpulencia del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6ca5-5fa5-3953-df3f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="052e-82b1-05c5-26a5" type="max"/>
          </constraints>
          <profiles>
            <profile id="bbd1-8393-7fb8-0314" name="Corpulencia del caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene +1 Herida y -1 a su Iniciativa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8e07-67fa-725a-02a1" name="Don de Morrslieb" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ac2f-30d2-d753-a57d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3292-7323-dd09-2267" type="max"/>
          </constraints>
          <profiles>
            <profile id="e194-226e-6ff1-6ee7" name="Don de Morrslieb" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene la regla especial Resistencia mágica (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="7f50-1bdb-dcc8-1f5a" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1b50-100b-4f38-ef90" name="Astas descomunales" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5ba8-b13b-a4c9-b653" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0e80-82ed-d436-89cc" type="max"/>
          </constraints>
          <profiles>
            <profile id="7ce2-d4f2-be98-a197" name="Astas descomunales" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene la regla especial Impactos por carga (1D3). Si ya causaba Impactos por carga, estos aumentan en +1D3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a0c2-61cb-043c-8aab" name="Impactos por carga (1D3)" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4d22-41d5-3a34-efa7" name="Apéndice adicional" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4ccd-e010-71aa-b383" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6890-b484-3235-9223" type="max"/>
          </constraints>
          <profiles>
            <profile id="0702-90da-c6a7-8428" name="Apéndice adicional" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene un ataque adicional que siempre se realizará con su Fuerza básica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="77f3-839f-1d56-c909" name="Mirada disforme" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7f6c-ad52-d963-6bed" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6ff4-a297-e655-c3d9" type="max"/>
          </constraints>
          <profiles>
            <profile id="e020-f7d6-a6a3-ce9f" name="Mirada disforme" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene un ataque de disparo que tiene un alcance de 12”, puede dispararse aunque el personaje marche y se resuelve con Fuerza 4 y las reglas especiales Francotirador, Disparo rápido y Ataques mágicos. La Mirada disforme puede utilizarse incluso si el personaje está trabado en combate cuerpo a cuerpo, aunque en este caso sólo podrá utilizarse contra una unidad trabada con el personaje. Se recuerda que no se puede usar el mismo turno en el que se ha cargado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="0955-b89a-6a88-3e64" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink id="9197-6fb3-b53d-8f62" name="Francotirador" hidden="false" targetId="8fa0-a4f6-e454-dbfe" type="rule"/>
            <infoLink id="e293-98e4-4336-aec4" name="Disparo rápido" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b2f0-9f81-8ae8-1897" name="Garras afiladas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ff4a-d543-207a-a1b6" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f471-2d04-43cd-dc56" type="max"/>
          </constraints>
          <profiles>
