          </constraints>
          <rules>
            <rule id="9d04-8989-1757-6342" name="Marca de Khorne. Valkia la Sanguinaria" hidden="false">
              <description>Valkia porta orgullosa la Marca de Khorne, que le otorga las reglas especiales Furia asesina y Resistencia mágica (2). No perderá su Furia asesina aunque sea derrotada en combate.</description>
            </rule>
          </rules>
          <infoLinks>
            <infoLink id="4919-7fd9-7183-1773" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink id="b795-2fb4-cdd5-ccda" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
        </entryLink>
