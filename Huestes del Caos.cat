              <rules>
                <rule id="85b6-a047-271a-2b32" name="Marca de Nurgle. Engendros del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques envenenados; además, los enemigos tienen un penalizador de -1 para impactarles con proyectiles y en combate cuerpo a cuerpo.</description>
                </rule>
