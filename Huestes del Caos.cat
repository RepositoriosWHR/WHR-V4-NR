                <cost name="pts" typeId="points" value="15.0"/>
              </costs>
            </entryLink>
            <entryLink id="6785-6e31-b105-faec" name="[GI] - Marca de Slaanesh. Personajes" hidden="false" collective="false" import="true" targetId="718b-c2a0-a578-4f9b" type="selectionEntry">
              <infoLinks>
                <infoLink id="4247-38ea-9d3c-cda4" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink id="2464-575d-ab26-e21b" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink id="85a2-1db3-36d6-a6cb" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
