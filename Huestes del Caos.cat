            <entryLink id="72fe-ab6e-0207-265f" name="[BC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="1915-0c28-504c-dc89" type="selectionEntry">
              <rules>
                <rule id="6760-3e8c-b264-3438" name="Marca de Tzeentch. Carro de garragor" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="b698-3384-70f9-4b41" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule">
