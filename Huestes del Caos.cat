            <entryLink id="d1e2-8d9b-4e98-5555" name="[GI] - Marca del caos absoluto. Personajes" hidden="false" collective="false" import="true" targetId="38c4-0f99-1e14-3cd5" type="selectionEntry">
              <rules>
                <rule id="dd0a-6dcb-3f53-b8ce" name="Marca de caos absoluto. Paladín ogro del Caos" hidden="false">
                  <description>Obtiene la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="3bf7-3b22-3959-ce99" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
