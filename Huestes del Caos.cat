            <entryLink id="ab00-4409-5848-d742" name="[K] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="851d-09e2-b8cf-0fbb" type="selectionEntry">
              <rules>
                <rule id="e166-5310-d720-6f1c" name="Marca de Nurgle. Señor de la guerra Kurgan" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="ab01-8839-0cb6-8eaa" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
