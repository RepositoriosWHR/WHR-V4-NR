    <selectionEntry id="50ff-91d8-2427-71df" name="[DC] - Sapo de plaga" hidden="false" collective="false" import="true" type="upgrade">
      <profiles>
        <profile id="998c-dbfa-b86f-0904" name="Sapo de Plaga" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
          <characteristics>
            <characteristic name="M" typeId="4d23232344415441232323">7</characteristic>
            <characteristic name="HA" typeId="575323232344415441232323">3</characteristic>
            <characteristic name="HP" typeId="425323232344415441232323">4</characteristic>
            <characteristic name="F" typeId="5323232344415441232323">4</characteristic>
            <characteristic name="R" typeId="5423232344415441232323">4</characteristic>
            <characteristic name="H" typeId="5723232344415441232323">3</characteristic>
            <characteristic name="I" typeId="4923232344415441232323">2</characteristic>
            <characteristic name="A" typeId="4123232344415441232323">2</characteristic>
            <characteristic name="L" typeId="4c4423232344415441232323">6</characteristic>
            <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
            <characteristic name="TSE" typeId="576172645361766523232344415441232323"/>
            <characteristic name="Tipo" typeId="5479706523232344415441232323">Bestia monstruosa</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="7fdd-e4fe-4991-e9a7" name="Cuerpo gomoso" hidden="false">
          <description>Todos los impactos contra los Sapos de plaga tendrán un penalizador de -1 en su tirada para herir.</description>
        </rule>
        <rule id="4b21-b6d6-c207-8709" name="Lengua venenosa" hidden="false">
          <description>Se trata de un ataque a distancia que puede efectuar el Sapo de plaga con un alcance de 10”, Fuerza 4 y la regla especial Disparo rápido.</description>
        </rule>
      </rules>
