          </constraints>
          <rules>
            <rule id="0fbf-74b9-3bf7-1312" name="Marca de Tzeentch. Talenchar" hidden="false">
              <description>Le proporciona la regla especial Ataques flamígeros y una 
tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de 
lanzamiento de hechizos.</description>
            </rule>
          </rules>
