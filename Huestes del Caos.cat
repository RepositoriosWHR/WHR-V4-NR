            </modifier>
          </modifiers>
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="1390-e0bb-e38a-e910" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="e31d-0c63-2eba-2ecc" type="max"/>
          </constraints>
          <profiles>
            <profile id="d9a8-036c-c851-ba8b" name="Elegido del caos" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo Paladín del Caos o Señor del Caos. Sustituye el efecto de la Marca del Caos del personaje por la Marca del Caos de los Elegidos equivalente. El personaje tan sólo puede unirse a unidades de Elegidos del Caos (ya sean a pie o montados, de cualquier tipo si su Marca del Caos se lo permite).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f712-0379-5af0-12e5" name="Fuerza mortífera" hidden="false" collective="false" import="true" type="upgrade">
