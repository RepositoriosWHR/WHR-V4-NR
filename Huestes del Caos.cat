          <entryLinks>
            <entryLink id="d077-a16e-49d5-2e52" name="[GI] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="924a-4560-4a74-e2be" type="selectionEntry">
              <rules>
                <rule id="dcc1-4d58-fe18-e79f" name="Marca de Nurgle. Gran Shaggot" hidden="false">
                  <description>Obtiene la regla especial Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarle con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="743b-62ce-d266-9baf" name="Inmune al veneno" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="35.0"/>
              </costs>
            </entryLink>
            <entryLink id="227b-890f-6064-5333" name="[GI] - Marca de Khorne. Personajes" hidden="false" collective="false" import="true" targetId="ff62-9412-73a7-b3d9" type="selectionEntry">
              <infoLinks>
                <infoLink id="d107-a7c3-8c02-aea4" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="1ed5-bb8c-b594-e39a" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
