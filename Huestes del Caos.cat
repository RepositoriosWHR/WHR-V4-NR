      <selectionEntries>
        <selectionEntry id="6aae-9804-d13f-81b9" name="Cetro cristalino de poder" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="da32-4f50-ef81-7539" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1dad-6e8c-47f7-d17b" type="max"/>
          </constraints>
          <profiles>
            <profile id="70d5-3c3e-4f1b-244f" name="Cetro cristalino de poder" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la marca de Tzeentch. Arma de mano. Los impactos con este arma se resuelven con +1 Fuerza. Además, por cada baja causada con este arma en combate cuerpo a cuerpo puedes añadir un dado de magia adicional (de energía o dispersión, según corresponda) en la siguiente fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="0d3b-6659-7ea6-e9c1" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
