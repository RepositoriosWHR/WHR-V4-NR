    <selectionEntry id="df43-a45b-6240-c3fa" name="[GC] - Carruaje del Caos" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="0399-26e4-33e7-906b" name="Potencia de unidad 4" hidden="false">
          <modifiers>
            <modifier type="set" field="name" value="Potencia de unidad 5">
              <conditions>
                <condition field="selections" scope="df43-a45b-6240-c3fa" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="9536-f827-cb94-5385" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
        <rule id="882b-c406-d997-5ef5" name="Marca del Caos. Carruaje del Caos" hidden="false">
          <description>El Carruaje del Caos debe portar la misma Marca que su jinete, al coste en puntos indicado:
-Marca del Caos absoluto (+5 puntos): La Protección por montura aumenta en +1.
-Marca de Khorne (+1 punto): Obtiene la regla especial Furia asesina (sólo el tripulante).
-Marca de Slaanesh (gratis): Sin efecto.
-Marca de Nurgle (gratis): Sin efecto.
-Marca de Tzeentch (+1 punto): Obtiene la regla especial Ataques flamígeros (sólo el tripulante).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="34e6-a7ad-4c05-68ac" name="Carro" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink id="becc-4838-aa91-a0d4" name="La voluntad del Caos" hidden="false" targetId="3639-2a5d-1be2-bcd2" type="rule"/>
        <infoLink id="1ebf-5d9f-ab6a-73e2" name="Inmune al miedo" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
        <infoLink id="7f9e-c9c0-98e4-4636" name="Protección por montura (2)" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
