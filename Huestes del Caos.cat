        <selectionEntry id="c8ba-e622-b33a-2230" name="Hacha Matahombres" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="f2d7-d821-1fe6-0e90" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="35cb-8e5c-8749-4b40" type="max"/>
