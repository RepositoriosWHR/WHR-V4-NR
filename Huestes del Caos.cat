          </constraints>
          <entryLinks>
            <entryLink id="c05c-918b-672e-4b06" name="[K] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="c752-a5a1-2916-2861" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="4">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="5b46-8edb-8da4-4925" name="Marca de Caos absoluto. Licántropos del Caos" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los 
resultados de 2 como 3).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="0b9e-4636-8304-af06" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="e808-0e94-dfe5-981b" name="[K] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="efd6-29ad-5411-f88d" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="5">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="50dd-e519-09fb-e7d5" name="Marca de Nurgle. Licántropos del Caos" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
