        <selectionEntry id="5190-4494-929c-0015" name="Filo ancestral del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6bdf-086c-db3c-4501" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="934f-fe41-33dc-c75d" type="max"/>
          </constraints>
          <profiles>
            <profile id="3021-ad82-bfca-6112" name="Filo ancestral del Caos" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados por este arma se resuelven con la regla especial Golpe letal. Además, al final de cualquier fase de combate cuerpo a cuerpo en la que el portador haya causado al menos una baja con este arma, puede restaurar una herida que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2ca2-0af0-0d65-eeef" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="f843-9f5f-db47-1e24" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
          </infoLinks>
