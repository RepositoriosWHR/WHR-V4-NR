                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Arma a dos manos. Las tiradas de salvación exitosas contra las heridas causadas con este arma deberán repetirse (eso incluye las tiradas de salvación especiales).</characteristic>
                  </characteristics>
                </profile>
