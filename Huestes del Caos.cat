            <profile id="677c-e998-2440-917e" name="Relicario de la sangre hirviente" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Khorne. El portador y su unidad nunca perderán su Furia asesina.</characteristic>
              </characteristics>
