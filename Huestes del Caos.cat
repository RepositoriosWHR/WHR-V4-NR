    <selectionEntry id="db15-8d3a-ec34-9293" name="[H][K][Ex] - Ettin maldito" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a7c9-be80-08a2-aff3" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="a2dc-4181-2326-51c9" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f963-a665-3991-4bb0" type="max"/>
      </constraints>
      <rules>
        <rule id="5ab3-d35e-7394-b0a2" name="Dos cabezas" hidden="false">
          <description>Antes del despliegue, el jugador del Ettin maldito debe elegir qué personalidad está en control al principio de la partida. Al final de cada fase en la cual el Ettin maldito haya sufrido una o más heridas, este debe realizar un chequeo de Liderazgo. Si lo supera, el Ettin maldito mantendrá su personalidad actual. Sin embargo, si lo falla cambia de personalidad. A continuación se presentan las reglas asociadas a cada una de las personalidades: 
-El traidor: Obtiene las reglas especiales Explorador, Odio (¡todos los enemigos!) y Crueldad resentida (más adelante).
-El salvaje: Obtiene las reglas especiales Carga devastadora y Furia asesina.
Crueldad resentida (personalidad del traidor): El bonificador a la resolución de un Ettin maldito en el flanco o la retaguardia de una unidad enemiga se dobla (+2 por flanco y +4 por retaguardia).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="ca90-8e84-cbf7-7068" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="c057-5c00-63d8-c500" name="Cruzar (obstáculos)" hidden="false" targetId="5dfd-3f02-cece-1e02" type="rule"/>
        <infoLink id="cb54-6655-7edf-799d" name="Regeneración (5+)" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
      </infoLinks>
      <categoryLinks>
