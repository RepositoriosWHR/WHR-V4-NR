            <entryLink id="3744-7c87-5659-f3f3" name="[GI] - Marca de Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="924a-4560-4a74-e2be" type="selectionEntry">
              <rules>
                <rule id="88cb-07f7-ef0e-7a9a" name="Marca de Nurgle. Ogro dragón Shaggot" hidden="false">
                  <description>Obtiene la regla especial Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarle con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="c997-7a73-9ec7-266b" name="Inmune al veneno" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
