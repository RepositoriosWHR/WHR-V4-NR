              </costs>
            </entryLink>
            <entryLink id="2757-e81d-a524-949c" name="[DC] - Demonio Nurgle. Personajes" hidden="false" collective="false" import="true" targetId="1c6e-5dcb-5f14-ae09" type="selectionEntry">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="882c-c1e5-9d80-a632" type="max"/>
              </constraints>
              <rules>
                <rule id="3687-182c-8312-ad04" name="Marca del Nurgle. Príncipe demonio" hidden="false">
                  <description>Obtiene la regla especial Demonio (Nurgle). Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1HA.</description>
                </rule>
              </rules>
              <entryLinks>
