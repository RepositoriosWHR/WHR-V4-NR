      <selectionEntries>
        <selectionEntry id="7e7d-12ae-c8ba-070a" name="Carcasa decadente" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="f607-51e4-2a2e-507e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="7394-3f84-1fdb-dcb6" type="max"/>
