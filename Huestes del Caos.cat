              </constraints>
              <rules>
                <rule id="7ffd-1ee1-6315-c6a7" name="Marca de Nurgle. Gran gusano de plaga" hidden="false">
                  <description>Orghotts y el Gran gusano de plaga portan la Marca de Nurgle, lo que les otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
