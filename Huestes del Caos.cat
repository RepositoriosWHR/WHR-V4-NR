            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3229-48bf-80b4-2b49" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="52cb-fe8c-8be1-3a61" type="min"/>
          </constraints>
          <entryLinks>
            <entryLink id="6000-e27a-852c-47a0" name="[GC] - Marca de Tzeentch. Unidades" hidden="false" collective="false" import="true" targetId="9fad-a3ca-229d-38a7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="7">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="6470-c69d-96c5-0399" name="Marca de Tzeentch. Elegidos del Caos en corcel demoníaco" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 5+ (o +2 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="f6cd-c125-3668-d8ec" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="0028-3a68-2954-dc13" name="[GC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="08d1-684e-f1be-fa4e" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="6">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="03e7-7d52-df5d-183b" name="Marca del Caos absoluto. Elegidos del Caos en corcel demoníaco" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad durante la batalla; considera los resultados de 2 como 3. Además, podrán repetir sus tiradas de Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink id="b49e-2165-efc3-d216" name="[GC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="fb11-4524-18fc-0692" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="7">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="19c6-a7b4-69cd-6959" name="Marca de Nurgle. Elegidos del Caos en corcel demoníaco" hidden="false">
                  <description>Obtienen las reglas especiales Ataques envenenados e Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="a50d-b171-526e-3f4c" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink id="59de-8293-d0bb-259e" name="Inmune al veneno" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="7d4f-381e-4c7e-06b1" name="[GC] - Marca de Slaanesh. Unidades" hidden="false" collective="false" import="true" targetId="aa84-8b93-55b7-3497" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="7">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <infoLinks>
                <infoLink id="c50f-d82f-7994-3067" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
                <infoLink id="ad26-d290-2d18-753c" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="1ee6-9a10-b174-d211" name="[GC] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="2f15-75f1-7256-e091" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="7">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="2856-207b-0a17-7c90" name="Marca de Khorne. Elegidos del Caos en corcel demoníaco" hidden="false">
                  <description>Obtienen las reglas especiales Furia asesina (sólo los jinetes), Odio (sólo las monturas) y Resistencia mágica (2). Además, no perderán su Furia asesina aunque sean derrotados en combate.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="7a94-0799-9b0c-467a" name="Furia asesina" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(Sólo los jinetes)"/>
                  </modifiers>
                </infoLink>
                <infoLink id="c2e3-cb25-e922-ab2e" name="Odio" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
                  <modifiers>
                    <modifier type="append" field="name" value="(Sólo las monturas)"/>
                  </modifiers>
                </infoLink>
                <infoLink id="b79f-37f7-2c6c-2a9d" name="Resistencia mágica (2)" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
