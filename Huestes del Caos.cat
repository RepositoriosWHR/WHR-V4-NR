    <selectionEntry id="c11a-a310-cfd9-e70f" name="[H][GC][E] - Los Espadas del Caos (Ungido del Caos)" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="94bf-2e73-11ba-ffcd" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="b243-b8fa-6362-68d5" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="394d-4a02-0ba7-eee5" type="max"/>
      </constraints>
      <rules>
        <rule id="c0b2-04d6-a6f0-e89f" name="Marca del Caos" hidden="false">
          <description>Los Espadas del Caos portan la Marca de los cuatro Dioses del Caos, que les otorgan los siguientes 
beneficios: Resistencia mágica (2), Ataques envenenados, Inmune a veneno, -1 para impactarles con proyectiles, -1HA al enemigo en cuerpo a cuerpo, una tirada de salvación especial de 5+ o +2 si ya disponían de una, Ataques flamígeros e Indesmoralizables.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="de49-8f11-d6c1-9778" name="Caballería monstruosa" hidden="false" targetId="a7be-2cd9-f3c6-b091" type="rule"/>
