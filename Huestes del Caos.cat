            <entryLink id="3a52-7785-f847-afa6" name="[BC] - Marca de Nurgle. Unidades" hidden="false" collective="false" import="true" targetId="e5c2-8b13-3efc-3585" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="10">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="0f07-78bf-0702-bffd" name="Marca de Nurgle. Engendro del Caos" hidden="false">
                  <description>Obtienen la regla especial Ataques envenenados; además, los enemigos tienen un penalizador de -1 para impactarles con proyectiles y en combate cuerpo a cuerpo.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink id="7960-51d5-7e59-9477" name="[BC] - Marca de Slaanesh. Unidades" hidden="false" collective="false" import="true" targetId="be13-29c0-cec5-c51f" type="selectionEntry">
