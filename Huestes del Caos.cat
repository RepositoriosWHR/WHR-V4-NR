                <profile id="9992-d024-4c7a-d8fa" name="Armadura de la condenación" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. Las tiradas para impactar exitosas contra el portador deberán repetirse. Además, Harry podrá repetir sus tiradas de salvación por armadura fallidas.</characteristic>
                  </characteristics>
                </profile>
