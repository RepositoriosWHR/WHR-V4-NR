              <profiles>
                <profile id="2714-67cc-1823-3974" name="Espada rúnica del caos" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques con este arma se resuelven con +1 a su Habilidad de Armas, Fuerza y Ataques.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
