          <entryLinks>
            <entryLink id="50fa-c006-fca7-2cb8" name="[BC] - Marca del Caos absoluto. Unidades" hidden="false" collective="false" import="true" targetId="dff6-7215-247b-8ac7" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="2">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule id="e39c-ef08-9286-6733" name="Marca del Caos absoluto. Bestigors" hidden="false">
                  <description>Obtienen laregla especial Inmune a pánico; además, pueden realizar una tirada enla tabla de Destruir la civilización antes del despliegue y pueden repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="07eb-0ca6-33de-fcf7" name="Inmune al pánico" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink id="b49b-5188-d86d-190c" name="[BC] - Marca de Khorne. Unidades" hidden="false" collective="false" import="true" targetId="afa8-b6fb-a158-27a4" type="selectionEntry">
              <modifiers>
                <modifier type="increment" field="points" value="3">
                  <repeats>
                    <repeat field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="model" repeats="1" roundUp="false"/>
                  </repeats>
                </modifier>
              </modifiers>
              <infoLinks>
                <infoLink id="d43f-08c2-fa87-71af" name="Odio (todos los enemigos)" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink id="b078-01d1-4cd6-1151" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
