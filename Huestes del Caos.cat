      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="525e-a1ce-2290-a100" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="f4bd-c57e-e241-d840" name="Familiar del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8656-a951-16b3-8214" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="06d1-1611-a7ec-4028" type="max"/>
          </constraints>
          <profiles>
            <profile id="c31b-89a6-dadf-5e25" name="Familiar del Caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía y Dispersión. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="60f4-ef08-0e68-adc8" name="Báculo de Darkoth" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="20a3-be8a-e6ab-0990" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6237-5fa6-8336-9bf0" type="max"/>
          </constraints>
          <profiles>
            <profile id="911a-115e-af4c-a387" name="Báculo de Darkoth" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje conoce un hechizo adicional. Además, tendrá un bonificador de +1 a las tiradas para lanzar sus hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="011d-d365-d5d7-2c8d" name="Cráneo de Rarkos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2747-c03b-b53e-fd1e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1388-c70e-3bb3-e80d" type="max"/>
          </constraints>
          <profiles>
            <profile id="9894-a316-01c3-dcaa" name="Cráneo de Rarkos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, determina al azar un hechizo en la siguiente tabla: el Cráneo de Rarkos es un objeto portahechizos con nivel de energía 4 que lanza el hechizo indicado (no puede lanzarse la versión potenciada de ninguno de los hechizos):
1- Enredadera Escarlata (Saber del fuego)
2- Maldición del viento de medianoche (Saber de los Cielos)
3- Aflicción de Dain (Saber de la Vida)
4- Luz cegadora de Amshu (Saber de la Luz)
5- Atrofia gris (Saber de las Sombras)
6- Oro de los insensatos (Saber del Metal)</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="fb36-bc07-d044-3d5c" name="Fetiche del árbol brujo" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="fd2a-3a3a-402f-3986" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3167-7678-099f-baf9" type="max"/>
          </constraints>
          <profiles>
            <profile id="00a6-9747-e362-84fb" name="Fetiche del árbol brujo" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Una vez por fase de magia propia, el personaje podrá repetir la tirada de un único dado de Energía al lanzar un hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
