          <profiles>
            <profile id="30dd-a731-5116-667e" name="Hacha de Khorne" hidden="false" typeId="def6-1530-806b-c3fd" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a72-4a1b-6bc8-e21b">El demonio obtiene la regla especial Golpe letal. Los resultados naturales de 5 en las tiradas para herir del demonio en combate cuerpo a cuerpo se considerarán resultados de 6 a efectos de la regla especial Golpe letal.</characteristic>
              </characteristics>
