    <selectionEntry id="a07b-8a43-29d0-55ad" name="[H][BC] - Ungor Oscuro" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="74e6-b415-e85b-d78e" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="abb7-a9b6-1614-881d" name="General del ejército" hidden="false">
          <description>Un Ungor oscuro no puede ser el señor de una Hueste del Caos a menos que toda su hueste esté compuesta por Ungors, Mastines del Caos, Garragors, Engendros del Caos, Mutantes del Caos y Gigantes del Caos.</description>
        </rule>
        <rule id="f682-f4ab-87f0-c28b" name="Marcado por los dioses" hidden="false">
          <description>Una unidad de Ungors que incluya un Ungor oscuro obtiene la regla especial Destruir la civilización mientras este esté dentro.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6187-bbd9-21a5-6e86" name="Cruzar (bosques)" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
