              <rules>
                <rule id="c119-57cb-8f2d-9795" name="Marca de Tzeentch. Arpías" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="c9fe-4fac-4df7-48dc" name="Ataques flamígeros" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
            </entryLink>
