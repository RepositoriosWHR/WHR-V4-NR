      <selectionEntries>
        <selectionEntry name="Runa magistral del equilibrio. Señor de las runas" id="8c9e-c491-8b67-f132" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="72c5-29fc-1b35-3a98" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
