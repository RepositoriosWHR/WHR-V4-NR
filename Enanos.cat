              <infoLinks>
                <infoLink name="Arma de mano adicional" id="4dbf-285f-fd24-02eb" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Bastón rúnico" id="3f35-3e31-f185-f8c0" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El bastón puede utilizarse como un Arma de mano adicional, proporcionando a Kragg un ataque extra con la regla especial Ataques mágicos. El bastón tiene grabadas la Runa magistral de los herreros rúnicos, que le otorga un +1 adicional a las tiradas para dispersar,  la Runa magistral de la resiliencia, la Runa magistral del equilibrio y una Runa rompehechizos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Runas de Bastón rúnico" id="e955-1d6a-d75d-3971" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="e674-0cef-3574-d689" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="a8a1-d18d-e2b4-71ae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Runa magistral de la resiliencia" id="6af2-6f6d-3a1d-1589" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Otorga al portador una tirada de salvación especial de 4+.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa magistral del equilibrio" id="9bb3-cd60-b418-5048" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Señor de las runas. Robas un dado de Energía al oponente al inicio de cada fase de magia enemiga, que añades a tu reserva de dados de Dispersión.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa rompehechizos" id="adb7-27a6-69a4-49a2" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Forjador rúnico. Un sólo uso. Dispersa un hechizo automáticamente.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
          </selectionEntries>
