      <rules>
        <rule name="Guardaespaldas" id="cbf3-e421-a9bd-ac71" hidden="false">
          <description>Los Martilladores obtienen la regla especial Inmune a psicología mientras que el Señor de los enanos que sea el General del ejército se encuentre unido a ellos. Además, si un personaje que tenga la clave rey se une a la unidad de Martilladores, tanto el personaje como la unidad obtendrán la regla ¡Ni un paso atrás!.</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos" id="8030-37ab-5e12-7cd1" hidden="false"/>
      </rules>
