            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Morir luchando" id="bbec-5ff3-2819-51fb" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Si el personaje muere en combate cuerpo a cuerpo, antes de retirar la miniatura como baja, puedes atacar una última vez con el personaje (exactamente igual que con la regla Matador, salvo que efectúa todos sus ataques en lugar de sólo uno).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Piel de Gromril" id="eb85-a63d-edcf-f18d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6387-0871-8f10-4f49" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="7028-5ea1-a996-fcc5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Piel de Gromril" id="69a8-9d2d-c787-819f" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Todas las tiradas para herir contra el portador fallarán si se obtiene un resultado de 1, 2 o 3 en la tirada; esto no afecta a ataques sin valor de Fuerza o que hieran automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Matabestias" id="eb00-d2fa-f874-f096" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6ee9-cf64-baed-0540" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="9121-1e14-62f7-316f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Matabestias" id="a726-cf49-846a-0da9" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Las heridas infligidas por el personaje en combate cuerpo a cuerpo cuentan el doble a efectos de calcular el resultado del combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Guerrero temible" id="6ecc-6e50-4785-2c07" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="01ca-0ec5-c249-d220" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="49ab-4c48-baf6-4160" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Guerrero temible" id="a0a9-7534-0343-fb0d" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">El personaje aumenta en +1 su atributo de Ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Curtido" id="d28f-8d8f-8c58-fa1b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="21ee-a141-6744-bd65" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="58db-ad10-b690-0efb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Curtido" id="d1ee-8ffa-d8bd-029a" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Todos los impactos contra el personaje tendrán un penalizador de -1 en su tirada para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runas talismánicas magistrales. Señor de los enanos (Amuletos y talismanes)" id="a588-8b7a-5944-9532" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="1f93-6235-d3d9-b0ca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Runa magistral de la realeza" id="98de-3a2d-0e46-49af" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8419-080b-ae92-630a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Runas Magsitrales" id="6b20-2fc4-d400-9dcb" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="bcf3-b9bf-c713-ea02" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Tozudez" id="4071-b73b-85d1-f400" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Runa magistral de la realeza" id="5cb0-0fa4-0b09-75fa" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Señor de los enanos. Otorga al portador la clave rey y las reglas especiales Tozudez e Inmune a psicología. Además, todas las unidades de enanos amigas a 8” o menos del portador obtienen la regla especial Inmune a psicología. Adicionalmente y si el portador es el general del ejército, podrás aplicar un +1 al resultado obtenido en la tirada de tabla de agravios ancestrales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Clanes Enanos" id="0dcc-32fd-43ed-378e" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="2e5e-abd3-9a72-8cd3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="f081-54c4-d627-12cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Clan Real" id="ea51-da50-20dd-d8cf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1d40-73e0-caea-cd78" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Clan Real" id="97df-0759-8fec-0282" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Si el Señor de los Enanos pertenece a este Clan, una única unidad de Martilladores sustituye su armadura pesada por Armadura de Gromril sin coste alguno; además, el portaestandarte de la unidad podrá llevar un estandarte rúnico de hasta 75 puntos. Sin embargo, los Rompehierros se consideran Unidad Singular en lugar de Unidad Especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Clan Minero" id="00bf-0795-a47f-7ae9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ceb9-299a-5ddf-e108" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Clan Minero" id="904c-8fb9-98e9-e45f" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Si el Señor de los Enanos pertenece a este Clan, podrás incluir una única unidad de Mineros como Unidad Básica. Adicionalmente, las unidades de Martilladores se consideran Unidad Singular en lugar de Unidad Especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Clan Ingeniero" id="0246-82e5-d8b4-a92d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6985-c56f-4e19-417d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Clan Ingeniero" id="cf28-6553-3430-9979" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Si el Señor de los Enanos pertenece a este Clan, un único Maestro Ingeniero puede montar en Girocóptero (+135 puntos) o un Girobombardero (+135 puntos) sustituyendo al Ingeniero Piloto. Sustituye la armadura de Gromril por Armadura ligera. Solamente podrá equiparse con Pistola enana (+5 puntos), Ristra de pistolas enanas (+10 puntos), Pistola draco (+7 puntos), Ristra de pistolas draco (+12 puntos) o cañón de azufre (+10 puntos, solo si monta en Girobombardero). Además, puede elegir hasta dos de entre los siguientes: Pólvora mejorada (+5 puntos), Cañón de ánima estriada (+5 puntos), Recámara (+5 puntos), Sistema de guía (+10 puntos), Bombas de mano de Malakai Makaisson (+15 puntos) y/o Fuego etílico (+20, solo si monta en Girocoptero). Adicionalmente, las unidades de Martilladores y Rompehierros se consideran Unidad Singular en lugar de Unidad Especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Clan Explorador" id="c6b3-266e-875d-0fe2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f145-0508-e9f3-cf8e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Clan Explorador" id="4c69-8743-39df-6489" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Si el Señor de los Enanos pertenece a este Clan, una única unidad de Montaraces se considerará Unidad Básica. Adicionalmente, las unidades de Martilladores y Rompehierros se considerarán Unidad Singular en lugar de Unidad Especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Clan Guerrero" id="60aa-0348-b34e-5742" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="85b9-b944-cdcd-78b3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Clan Guerrero" id="d36d-a99d-11ef-7e7d" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Si el Señor de los Enanos pertenece a este Clan, podrás incluir una unidad de Barbaslargas sin necesidad de incluir una unidad de Guerreros del Clan pero el General deberá incluirse en dicha unidad y no podrá abandonarla voluntariamente durante la batalla. Adicionalmente, las unidades de Rompehierros se considerarán Unidad Singular en lugar de Unidad Especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
