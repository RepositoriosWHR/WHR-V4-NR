              <characteristics>
                <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">El adversario debe repetir cualquier tirada para herir exitosa contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa magistral devoradora de magia" id="0c6a-81cc-8ec9-891c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="78a1-910e-b061-abe9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
