            <profile name="Runa mataelfos" id="4733-407a-66f6-77f0" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Cada vez que una miniatura con la clave elfos sufra una herida a causa de este arma, debe efectuar un chequeo de 
Resistencia; si lo falla, será retirado como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
