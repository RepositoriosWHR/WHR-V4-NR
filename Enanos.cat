          <profiles>
            <profile name="Runa de la forja" id="a393-b0e3-bee7-4dbf" hidden="false" typeId="2915-68d1-ee1b-ddd9" typeName="Runa de los ingenieros">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="688e-e9ce-32c4-32ff">Sólo Cañón enano. Un sólo uso. Repite la tirada del dado de artillería si obtiene Problemas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
