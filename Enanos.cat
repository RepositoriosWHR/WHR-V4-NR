      <categoryLinks>
        <categoryLink name="New CategoryLink" id="60b4-b1c5-4bc7-0784" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="1167-1a8e-f4bb-5ad3" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
