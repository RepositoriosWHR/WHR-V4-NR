            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa certera de Grimm" id="9f4d-f348-b472-f34a" hidden="false" typeId="37d3-b183-e1a9-ca49" typeName="Runa de protección">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7ece-0fe9-e543-e3fc">Sólo Ballesteros. Otorga al portador y su unidad un bonificador de +1 en la tirada para impactar con proyectiles al utilizar Ballesta para disparar. Múltiples Runas certeras de Grimm son redundantes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Habilidades de Matador" id="a430-657d-c4b2-e3db" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Morir luchando" id="12b8-fd32-7608-146a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0546-deb7-9606-a56a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="3605-63b7-9ee5-f847" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
