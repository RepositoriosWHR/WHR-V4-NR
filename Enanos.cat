                    <profile name="Runa de la suerte" id="e7a9-dd64-5e1d-dc40" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Un solo uso. Puede repetir una tirada para impactar, herir, tirada de salvación por armadura o especial, chequeo de atributo o un único dado en una tirada de dispersión de hechizo.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
