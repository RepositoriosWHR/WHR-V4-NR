      <rules>
        <rule name="Forjador rúnico" id="239c-d68a-714b-5394" hidden="false">
          <description>Al utilizar el Yunque rúnico, Kragg no deberá efectuar tirada alguna en la tabla de efectos secundarios.</description>
        </rule>
        <rule name="Gruñón" id="bee5-2841-9f24-dbed" hidden="false">
          <description>Si incluyes a Kragg en el ejército, no podrás incluir otros Señores de las runas (ni personajes especiales con la regla especial Forjador rúnico).</description>
        </rule>
        <rule name="Ancestro viviente" id="1264-6b43-2a23-1989" hidden="false">
          <description>Kragg tiene la regla especial Inmune a psicología.</description>
        </rule>
        <rule name="Forjador consumado" id="880e-d756-e640-721e" hidden="false">
          <description>Al utilizar el Yunque rúnico, Kragg no deberá efectuar tirada alguna en la tabla de efectos secundarios.</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos" id="de9b-a06b-70cd-c495" hidden="false"/>
        <rule name="Venerable forjador rúnico" id="2dc9-e7bb-7a77-44cf" hidden="false">
          <description>Kragg genera dos dados de Dispersión adicionales para el ejército enano en cada fase de magia del oponente y puede Canalizar dados de Dispersión como si fuese un hechicero. Además, tiene la regla especial Resistencia mágica (2). Adicionalmente, un ejército enano con Kragg tiene un bonificador para dispersar de +5 en vez del indicado por la regla especial Resistentes a la magia.</description>
        </rule>
      </rules>
