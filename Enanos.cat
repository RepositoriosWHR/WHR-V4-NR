                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El martillo tiene grabada la Runa magistral de la rapidez y la Runa de Snorri Spanglehelm.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Runas de Martillo Rúnico" id="55ad-71cd-4555-50ea" collective="false" hidden="false" import="true" type="upgrade">
