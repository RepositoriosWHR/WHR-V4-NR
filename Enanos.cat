      <selectionEntryGroups>
        <selectionEntryGroup name="Opciones" id="cc68-be43-1d03-b9b1" collective="false" hidden="false" import="true">
          <rules>
            <rule name="Opciones" id="800f-9b68-7b36-da2c" hidden="false">
              <description>El Espíritu de Grungni puede incluir a Gotrek y Félix (+350 puntos), a Snorri Muerdenarices (+140 puntos), a Ulrika Magdova Straghov (+125 puntos, ver libro de ejército de Las aventuras de Gótrek y Félix) y a Max Schreiber (+225 puntos, ver libro de ejército de Las aventuras de Gótrek y Félix). Pueden desembarcar del mismo modo que la unidad de Barbaslargas descrita en “Tropas”. Mientras se encuentren en la aeronave, pueden disparar y lanzar hechizos, aunque los alcances se verán reducidos en 6” por la distancia vertical.</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Personajes especiales" id="7326-a5b3-22cf-cb72" collective="false" hidden="false" import="true">
