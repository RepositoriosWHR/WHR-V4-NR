                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Runa magistral de la ruina" id="96d4-3616-fbef-ec2a" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Si el arma impacta a un enemigo equipado con un arma mágica, el poder de dicho arma quedará anulado y pasará a considerarse un arma mundana de su mismo tipo.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la agonía" id="9369-b862-7da0-8727" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los ataques con el arma obtienen la regla especial Heridas múltiples (1D3).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la fuerza" id="2ebe-f84c-9aad-5212" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los impactos con el arma se resuelven con un bonificador de +1 a la Fuerza (este bonificador se acumula con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
