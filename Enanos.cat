          <modifiers>
            <modifier field="name" type="append" value="(Después 1ª herida)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Furia asesina" id="0f7a-80a9-a41d-6f59" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Después 1ª herida)"/>
          </modifiers>
        </infoLink>
