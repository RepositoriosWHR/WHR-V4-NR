          <profiles>
            <profile name="Runa del destino" id="75b0-40e2-4bb4-98d1" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Un solo uso. Una vez por batalla, otorga a su portador una tirada de salvación especial de 2+ contra una única herida que sufra.</characteristic>
              </characteristics>
            </profile>
