      <selectionEntries>
        <selectionEntry name="Runa magistral de la tormenta" id="3f7a-4c51-ff6c-530c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0161-3598-f42b-1254" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
