              <characteristics>
                <characteristic name="Reglas especiales" typeId="7ece-0fe9-e543-e3fc">Sólo Portaestandarte de batalla. El portador y la unidad en la que se incluya ignorarán la regla Mover o Disparar de sus armas de proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runas talismánicas magistrales. Señor de las runas (Amuletos y talismanes)" id="8da0-5c17-e1b4-3625" collective="false" hidden="false" import="true">
