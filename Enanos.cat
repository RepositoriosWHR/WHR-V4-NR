        <infoLink name="Avance imparable" id="4e89-ec96-49e2-60ab" hidden="false" targetId="1ad7-2f8f-dcd1-cb6f" type="rule"/>
        <infoLink name="Caballería monstruosa" id="b426-6e93-d0e5-c2bb" hidden="false" targetId="a7be-2cd9-f3c6-b091" type="rule"/>
