              <entryLinks>
                <entryLink name="Runas Magsitrales" id="0758-2c77-95eb-85b9" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
              </entryLinks>
              <profiles>
                <profile name="Runa magistral de la destrucción" id="3a1f-58d6-c5fe-d011" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Heridas múltiples (1D6)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Runa Magistral del vuelo" id="5bfd-2698-4186-658c" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6a92-57c2-ffef-4f67" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="fea5-ff12-95e2-3edf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="1c74-670a-defe-4127" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <entryLinks>
                <entryLink name="Runas Magsitrales" id="4834-a55a-363b-df0f" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
              </entryLinks>
              <profiles>
                <profile name="Runa magistral del vuelo" id="11e4-2df2-9c44-fac7" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">El arma rúnica puede usarse como Arma arrojadiza que retorna a la mano de su portador tras ser usada. Tiene un alcance de 10” y las reglas especiales Disparo rápido y Arrojadiza. Impacta con la Fuerza del usuario, y tiene Ataques mágicos, así como las demás propiedades que confieran otras runas grabadas en el arma.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos rúnicos legendarios. Talismán rúnico. Señor de los enanos" id="9eb8-c7c6-bfdd-c3bb" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f400-3f89-49c0-8f23" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="La corona perdida de Karak Drazh" id="d192-70ce-32b3-e12c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="15df-2139-da28-114f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5bed-a532-10ec-9c65" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="80"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="a62d-711b-3e93-dc18" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Tozudez" id="0294-25c2-182e-087c" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="La corona perdida de Karak Drazh" id="1267-034d-7067-b465" hidden="false" typeId="e776-3e82-55cc-e65e" typeName="Objeto rúnico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a9b7-9733-fc31-8e25">Sólo Señor de los enanos. La corona tiene grabada la Runa magistral de la realeza y la Runa de la restauración. Además, proporciona un bonificador de +1 a la tirada de salvación por armadura del portador.</characteristic>
              </characteristics>
            </profile>
            <profile name="Runa magistral del restablecimiento" id="8436-b183-65f1-24a0" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">Restablece al portador una de las heridas que hubiese sufrido previamente durante la batalla al comienzo de cada turno enano. Además, proporciona un bonificador de +1 a la tirada de salvación por armadura del portador (como un yelmo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Runa Magistral de la Realeza" id="fad5-7dbe-beb6-2737" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c12a-941e-d93e-afb2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="7e04-ad14-7fd4-56f0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <entryLinks>
                <entryLink name="Runas Magsitrales" id="4597-a3bb-357a-1dc2" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
              </entryLinks>
              <profiles>
                <profile name="Runa magistral de la Realeza" id="7c9b-3fd1-d8f8-f808" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Señor de los enanos. Otorga al portador la clave rey y las reglas especiales Tozudez e Inmune a psicología. Además, todas las unidades de enanos amigas a 8” o menos del portador obtienen la regla especial Inmune a psicología. Adicionalmente y si el portador es el general del ejército, podrás aplicar un +1 al resultado obtenido en la tirada de tabla de agravios ancestrales.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="La corona del Pináculo de Plata" id="fa4b-175a-2dea-74b9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5d5e-d771-72e6-b24f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5e56-ab68-22c0-80c4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="140"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="La corona del Pináculo de Plata" id="59f2-441f-bcc0-3c17" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo Señor de los enanos. La corona tiene grabadas la Runa magistral de la Realeza, la Runa magistral de la resiliencia y la Runa de la plata, que hace que todas las tiradas para impactar contra el portador y su unidad tengan un penalizador de -1, tanto con proyectiles como en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
            <profile name="Runa de plata" id="47f9-5f62-c5c0-9d20" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Todas las tiradas para impactar contra el portador y su unidad tendrán un penalizador de -1, tanto con proyectiles como en  combate cuerpo a cuerpo</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Objeto rúnico legendario" id="a575-2eb4-7225-00d4" hidden="false">
              <description>Pueden ser elegidos por comandantes enanos en lugar de uno  de sus objetos rúnicos habituales. No pueden grabarse más runas en estos objetos.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Runa Magistral de la Resiliencia" id="7787-f087-4b51-44cc" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a6d9-4802-d826-e254" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="d517-c06f-1a53-d957" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
