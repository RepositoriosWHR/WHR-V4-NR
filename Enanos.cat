            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Runas Magsitrales" id="2d45-0a08-fab1-29e9" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Runa magistral del equilibrio" id="bd57-4283-d3dc-a078" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Señor de las runas. Robas un dado de Energía al oponente al inicio de cada fase de magia enemiga, que añades a tu reserva de dados de Dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa magistral de los herreros rúnicos" id="0f32-a589-e933-4791" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cc06-235c-9f84-7a42" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Runas Magsitrales" id="3218-8a4c-d5b7-d055" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Runa magistral de los herreros rúnicos" id="d69a-20cc-3501-4f2b" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Señor de las runas. Otorga al portador un bonificador de +1 a sus tiradas para dispersar hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runas talismánicas. Señor de las runas (Amuletos y talismanes)" id="2e88-02a3-1ce2-d450" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="2870-ad59-21c2-0bb7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
        <constraint id="45d2-a73a-07eb-03b3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Runa de la retribución" id="74ba-55a1-9939-5237" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9c67-aa2e-35e4-7001" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de la retribución" id="5caa-b0da-e51c-8f83" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Solo Señor de las runas. Cada vez que un oponente utilice un objeto portahechizos a 24” o menos del portador, este obtiene un dado de Dispersión adicional que sólo puede usar para dispersar ese objeto portahechizos. Adicionalmente, una vez por batalla, si consigue dispersarlo tira 1D6: si obtienes un resultado de 4+, el poder del objeto portahechizos se habrá agotado y pasará a ser un objeto mundano de su mismo tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runas talismánicas. Señor del Clan (Amuletos y talismanes)" id="0882-7784-7c18-6fa7" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="eaa1-0692-2053-9f88" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
        <constraint id="7f02-ed28-3ae3-b7b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Runa de la camaradería" id="0a3e-74e0-bf15-7865" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cf10-6675-9a1f-984f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de la camaradería" id="094f-c986-32b1-1eae" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Señor de clan. El personaje sólo puede unirse a unidades de Mineros o Montaraces. Si se une a una unidad de Montaraces, obtiene +1 a su Movimiento y la regla especial Montaraces. Si se une a una unidad de Mineros, tanto el personaje como su unidad podrán repetir sus tiradas de carga fallidas durante el mismo turno en el que entraron en el campo de batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runas talismánicas. Forjador rúnico (Amuletos y talismanes)" id="3cf2-b6b2-1ddf-f186" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ed53-4b69-f572-a4aa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
        <constraint id="3d66-9d61-1a62-6d12" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Runa comehechizos" id="06eb-c549-d4c8-a8ab" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3d82-55ed-7e0b-e3f1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa comehechizos" id="5ec9-a7fe-c64c-f5ed" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Forjador rúnico. Un sólo uso. Dispersa automáticamente un hechizo y tira 1D6: con un resultado de 4+, el hechizo quedará borrado de la mente del hechicero y no podrá usarlo de nuevo durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa rompehechizos" id="a587-a9f6-9e0e-463e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fcf5-2ebf-65a9-fabe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa rompehechizos" id="862d-d57b-d7e3-a294" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Forjador rúnico. Un sólo uso. Dispersa un hechizo automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa ígnea" id="00d5-e513-edb7-fdc7" collective="false" hidden="false" import="true" type="upgrade">
