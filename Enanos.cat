                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="a9b7-9733-fc31-8e25">Arma de mano. Lleva inscritas la Runa magistral de la destrucción y una Runa de perforación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
