      <rules>
        <rule name="Forjador rúnico" id="2e6d-1073-f60a-5830" hidden="false">
          <description>Un Señor de las runas genera dos dados de Dispersión adicionales para el ejército enano en cada fase de magia del oponente y puede Canalizar dados de Dispersión como si fuese un hechicero. Además, tiene la regla especial Resistencia mágica (2).</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos" id="4f6b-e7bc-c13d-d654" hidden="false"/>
      </rules>
