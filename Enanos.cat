                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Este estandarte tiene grabada una Runa de la orientación, ya que el Clan Bronn fue un clan minero, y la Runa magistral de Grugni, para protegerse de los agravios sufridos por su vecino clan Thrund.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Runa magistral de Grungni" id="8ed3-243d-e135-9023" hidden="false" typeId="37d3-b183-e1a9-ca49" typeName="Runa de protección">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7ece-0fe9-e543-e3fc">Otorga una tirada de salvación especial de 5+ a todas las unidades amigas a 8” del estandarte.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Runa de la orientación" id="ebe3-7565-afcd-f03d" hidden="false" typeId="37d3-b183-e1a9-ca49" typeName="Runa de protección">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7ece-0fe9-e543-e3fc">Solo Mineros. La unidad podrá repetir la tirada en la tabla de problemas por su regla especial Avance subterráneo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
