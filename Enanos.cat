            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de la invisibilidad" id="3f08-a180-3f96-337d" hidden="false" typeId="2915-68d1-ee1b-ddd9" typeName="Runa de los ingenieros">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="688e-e9ce-32c4-32ff">Sólo una por ejército. La máquina de guerra no puede ser designada como objetivo de disparos o hechizos por unidades enemigas situadas a más de 18”.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa buscadora de Flaksson" id="9eee-7d48-7055-e4e7" collective="false" hidden="false" import="true" type="upgrade">
