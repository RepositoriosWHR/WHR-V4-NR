              <characteristics>
                <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">Proporciona al portador una tirada de salvación por armadura de 1+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa magistral de la entereza" id="7311-7843-0a3a-e40f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="09fe-f565-53ec-b3a9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
