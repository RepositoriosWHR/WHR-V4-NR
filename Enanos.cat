              <characteristics>
                <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">Otorga a su portador Resistencia 10. Si lleva esta runa, no puede llevar otras runas de defensa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
