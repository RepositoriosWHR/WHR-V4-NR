              <profiles>
                <profile name="Martillo de Kragg" id="8661-1aa5-dc5e-7591" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El martillo tiene grabada la Runa magistral de Kragg el Gruñón, por la cual los ataques con el arma se resuelven con Fuerza 10 y la regla especial Ataques flamígeros, una Runa magistral de la destrucción y una Runa de furia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Runas de " id="eba1-eb1a-2b9f-7631" collective="false" hidden="false" import="true" type="upgrade">
