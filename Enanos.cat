                        <profile name="Ingeniero piloto" id="cfb5-5d3a-56f7-39b4" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
                          <characteristics>
                            <characteristic name="M" typeId="4d23232344415441232323">3</characteristic>
                            <characteristic name="HA" typeId="5.753232323444154e+23">4</characteristic>
