          <profiles>
            <profile name="Falsa runa de Kragg el Gruñón" id="c7ed-a037-60a9-58ed" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Sólo Arma de mano. El arma obtiene las reglas de un Arma a dos manos (+2 a la Fuerza, Lenta, Requiere ambas manos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
