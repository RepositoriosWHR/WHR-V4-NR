      <rules>
        <rule name="Alto rey de los enanos" id="d45b-9d51-d728-07d6" hidden="false">
          <description>El radio de la regla especial Presencia inspiradora de Thorgrim se verá aumentado hasta 24”.</description>
        </rule>
        <rule name="Nunca olvidar, jamás perdonar" id="c14e-2a62-eb21-0d1e" hidden="false">
          <description>Todas las unidades del ejercito enano obtienen la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos , rey" id="68dd-e286-00bf-a77c" hidden="false"/>
      </rules>
      <selectionEntries>
