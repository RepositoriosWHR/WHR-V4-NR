              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Tozudez" id="072f-41ff-5bab-252d" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
                <infoLink name="Inmune a la psicología" id="de7c-2d1b-6cac-cf09" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Corona del dragón de Karaz-a-Karak" id="c33c-8aff-990a-9afc" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">La corona tiene grabadas la Runa magistral de la resiliencia, la Runa magistral del desafio y la Runa magistral del imperio enano, que hace que Thorgrim y todas las unidades enanas amigas a 12” o menos obtengan las reglas especiales Tozudez e Inmune a psicología.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
