              </entryLinks>
              <profiles>
                <profile name="Runa magistral de la Resiliencia" id="36f4-cda9-ce54-6ffa" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Otorga al portador una tirada de salvación especial de 4+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
