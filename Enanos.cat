              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Sólo Forjador rúnico. Obtiene un bonificador de +2 a sus tiradas para Canalizar. Múltiples Runas de los vientos son redundantes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos rúnicos legendarios. Arma rúnica" id="7e20-096c-1dd9-01c8" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="893a-5010-c033-dd3d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Martillo del destino" id="5932-0a78-93e7-20b2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3bcf-5a80-c211-9c5b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7c20-ec3f-1bed-75a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
