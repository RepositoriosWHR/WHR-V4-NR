          <profiles>
            <profile name="Runa de la restauración" id="2e9e-e4be-a5af-1e35" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Al inicio de cada uno de tus turnos, el portador puede restaurar una herida que hubiese sufrido previamente durante la batalla. Múltiples Runas de restauración son redundantes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runas de los ingenieros (Máquinas de guerra)" id="04b0-4acb-d68d-fee8" collective="false" hidden="false" import="true">
