                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Tiene grabada una Runa de furia y dos Runas de fuerza.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Runas de Martillo ancestral de Vala-Azrilungol" id="4ea8-8333-0b58-8761" collective="false" hidden="false" import="true" type="upgrade">
