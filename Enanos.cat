    <selectionEntryGroup name="Objetos rúnicos legendarios. Talismán rúnico" id="712d-b4a2-3bc7-1abc" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="a7b9-4451-2bc1-8755" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Anillo llameante de Thori" id="2e17-66e8-ba9a-02c4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9aed-74e8-4f50-9b95" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="383c-a97c-8fa1-be1d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune al fuego" id="a9be-4e6e-1985-b520" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
            <infoLink name="Ataques solo flamígeros" id="7b8f-ce50-7bb0-d4a3" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
            <infoLink name="Ataques mágicos" id="f6b2-de70-e818-2ec9" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Arma de aliento" id="7b91-769c-2dce-177d" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(F4, Ataques mágicos y Ataques solo flamígeros)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Anillo llameante de Thori" id="9b7c-d308-dea0-f9a7" hidden="false" typeId="e776-3e82-55cc-e65e" typeName="Objeto rúnico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a9b7-9733-fc31-8e25">El portador puede utilizar el anillo como un Arma de aliento de Fuerza 4 con las reglas especiales Ataques mágicos y Ataques solo flamígeros. Además, otorga al portador la regla especial Inmune a fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Objeto rúnico legendario" id="11af-1b5c-057e-31f9" hidden="false">
              <description>Pueden ser elegidos por comandantes enanos en lugar de uno  de sus objetos rúnicos habituales. No pueden grabarse más runas en estos objetos.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Cetro dorado de Norgrim" id="bab9-7700-11aa-05ce" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5b3a-c387-9708-7d6c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6e64-2f06-645d-be10" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro dorado de Norgrim" id="cdff-0778-f380-8678" hidden="false" typeId="e776-3e82-55cc-e65e" typeName="Objeto rúnico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a9b7-9733-fc31-8e25">Al inicio de cada turno enano, el portador puede elegir uno de los tres poderes del cetro, que le afectarán a él y a toda su unidad hasta el inicio del siguiente turno de los enanos: +2 al Movimiento, +1 a la Fuerza o +1 a la tirada de salvación por armadura. No podrá escogerse el mismo poder durante dos turnos consecutivos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Objeto rúnico legendario" id="6c8a-c943-486f-8d4e" hidden="false">
              <description>Pueden ser elegidos por comandantes enanos en lugar de uno  de sus objetos rúnicos habituales. No pueden grabarse más runas en estos objetos.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Cuerno plateado de la venganza" id="5cec-070c-6e34-bc2e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="37bf-0914-713d-4cab" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7137-731c-fdcc-9b06" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Carga devastadora" id="508f-867e-853e-600b" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
            <infoLink name="Odio" id="952d-0d6b-42d3-798d" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Elfos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Cuerno plateado de la venganza" id="74d7-af04-13fb-9138" hidden="false" typeId="e776-3e82-55cc-e65e" typeName="Objeto rúnico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a9b7-9733-fc31-8e25">Un solo uso. El portador puede utilizarlo al inicio de cualquiera de sus turnos. Todas las unidades amigas a 8” o menos del portador obtendrán hasta el inicio de su siguiente turno las reglas especiales Carga devastadora y Odio (elfos). Además, el portador y toda su unidad causará Terror a elfos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Objeto rúnico legendario" id="2c3a-574d-b4c4-9c4f" hidden="false">
              <description>Pueden ser elegidos por comandantes enanos en lugar de uno  de sus objetos rúnicos habituales. No pueden grabarse más runas en estos objetos.</description>
            </rule>
            <rule name="Odio (elfos)" id="9b31-1d66-1d56-6de5" hidden="false">
              <description>Una miniatura que Odie podrá repetir los resultados de 1 obtenidos en sus tiradas para impactar en combate cuerpo a cuerpo contra aquellos a quienes odie.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Pan de piedra" id="0bc1-b6f8-7057-d4df" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6587-f5cf-4ed6-9a35" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9179-6694-8b82-a320" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pan de piedra" id="eed7-753c-5172-bf3c" hidden="false" typeId="e776-3e82-55cc-e65e" typeName="Objeto rúnico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a9b7-9733-fc31-8e25">Un sólo uso. El portador puede comerse su pan de piedra al inicio de cualquiera de sus turnos. Si lo hace, restaura todas las heridas que hubiese sufrido durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Objeto rúnico legendario" id="7fd0-f442-1d77-9d4d" hidden="false">
              <description>Pueden ser elegidos por comandantes enanos en lugar de uno  de sus objetos rúnicos habituales. No pueden grabarse más runas en estos objetos.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
