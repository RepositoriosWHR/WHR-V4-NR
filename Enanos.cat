          </entryLinks>
          <profiles>
            <profile name="Runa magistral del rencor" id="b6a8-4cdf-6239-3c4f" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Otorga al portador una tirada de salvación especial de 4+. Por cada herida salvada con esta runa en combate cuerpo a cuerpo, el que causó la herida sufrirá una herida sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa magistral del desaliento" id="5316-ed2b-ce0f-7b55" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9dd2-39c5-a5de-c4aa" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Runa Magistral" id="993d-3fab-d5cf-2b33" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Runa magistral del desaliento" id="bc96-3a44-cb3b-18aa" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Un solo uso. Puede utilizarse al inicio de cualquier fase de movimiento enemiga contra una unidad enemiga a 12” o menos del portador. Esa unidad deberá, si puede, declarar una carga contra el portador y su unidad o huir como si hubiese fallado un chequeo de Pánico. Esto no afecta a unidades con la regla especial Inmune a psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa magistral del desafío" id="bc95-609b-79bf-6f4b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="69cf-3fa1-450a-fc8f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
