      <rules>
        <rule name="La compañía" id="59f8-aff0-9c3f-72a8" hidden="false">
          <description>Thorgrim y sus compañeros son personajes todos ellos, pero en batalla forman una unidad de Hostigadores a la que ningún otro personaje puede unirse y ellos no pueden abandonar. Debes distribuir los disparos aleatoriamente entre los seis.</description>
        </rule>
        <rule name="Llamado del destino" id="84c3-79ee-332c-254e" hidden="false">
          <description>Todos los compañeros tienen la regla especial Tozudez y una tirada de salvación especial de 4+ (que se incrementa a 3+ en el caso de Thorgrim).</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos" id="e6bc-4a9e-3b4b-1ba8" hidden="false"/>
      </rules>
