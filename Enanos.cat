          <infoLinks>
            <infoLink name="Ataques mágicos" id="c7a8-8c54-a318-4746" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Ataques flamígeros" id="41f2-0931-e64f-f303" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Runa de la inmolación" id="37d7-9970-986b-b7c2" hidden="false" typeId="2915-68d1-ee1b-ddd9" typeName="Runa de los ingenieros">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="688e-e9ce-32c4-32ff">Un solo uso. La máquina explotará cuando sea destruida. Toda unidad (amiga o enemiga) a 1D6” o menos de la máquina de guerra sufre 2D6 impactos de Fuerza 4 con las reglas especiales Ataques mágicos y Ataques flamígeros que se distribuyen como disparos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa del valor" id="4f16-e403-5815-cfdb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2d92-0e96-76a9-4794" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
