      <selectionEntryGroups>
        <selectionEntryGroup name="Montura" id="e082-33e0-8d11-31f9" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Yunque Rúnico" id="a9b3-77ba-cc69-1516" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5186-8045-489b-f4f8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="893e-3d0c-4df1-c17d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="290"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Impactos por carga (1D3)" id="2f7f-3151-bbcc-68a2" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
                <infoLink name="Indesmoralizable" id="2b9f-398a-cbce-fea3" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
                <infoLink name="Resistencia mágica (3)" id="d3bd-e1d7-a9e4-7783" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
                <infoLink name="Protección por montura (2)" id="f477-7dcb-a4c1-049c" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
                <infoLink name="Odio (Pielesverdes y Skaven)" id="6853-cccc-420a-7fb3" hidden="false" targetId="8701-9eaa-6523-4996" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Guardián del yunque (2)" id="35bb-c8a7-4310-615d" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
                  <characteristics>
                    <characteristic name="M" typeId="4d23232344415441232323">3</characteristic>
                    <characteristic name="HA" typeId="5.753232323444154e+23">5</characteristic>
                    <characteristic name="HP" typeId="4.2532323234441546e+23">3</characteristic>
                    <characteristic name="F" typeId="5.323232344415441e+21">4</characteristic>
                    <characteristic name="R" typeId="5.423232344415441e+21"/>
                    <characteristic name="H" typeId="5.723232344415441e+21"/>
                    <characteristic name="I" typeId="4.923232344415441e+21">2</characteristic>
                    <characteristic name="A" typeId="4.123232344415441e+21">2(4)</characteristic>
                    <characteristic name="L" typeId="4c4423232344415441232323">10</characteristic>
                    <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
                    <characteristic name="TSE" typeId="5.761726453617665e+35"/>
                    <characteristic name="Tipo" typeId="5.479706523232345e+27">Infantería</characteristic>
                  </characteristics>
                </profile>
                <profile name="Yunque rúnico" id="11dd-97ad-778d-b94e" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
                  <characteristics>
                    <characteristic name="M" typeId="4d23232344415441232323">6</characteristic>
                    <characteristic name="HA" typeId="5.753232323444154e+23"/>
                    <characteristic name="HP" typeId="4.2532323234441546e+23"/>
                    <characteristic name="F" typeId="5.323232344415441e+21">5</characteristic>
                    <characteristic name="R" typeId="5.423232344415441e+21"/>
                    <characteristic name="H" typeId="5.723232344415441e+21">+2</characteristic>
                    <characteristic name="I" typeId="4.923232344415441e+21"/>
                    <characteristic name="A" typeId="4.123232344415441e+21"/>
                    <characteristic name="L" typeId="4c4423232344415441232323"/>
                    <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
                    <characteristic name="TSE" typeId="5.761726453617665e+35"/>
                    <characteristic name="Tipo" typeId="5.479706523232345e+27">Carro</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Yunque rúnico" id="cefc-1bff-249f-57b8" hidden="false">
                  <description>El Yunque rúnico proporciona a su jinete dos Heridas adicionales y aumenta en +4 su Potencia de unidad.</description>
                </rule>
                <rule name="Martillear runas en el yunque rúnico" id="3bb1-af87-b11f-479a" hidden="false">
                  <description>Un Señor de las runas puede utilizar el poder del Yunque rúnico para desatar potentes efectos mágicos una vez por fase de magia propia. Para poder utilizar esta regla especial, el Señor de las runas deberá portar un arma rúnica. En cada fase de magia propia, puedes elegir una de las siguientes runas y lanzarla. Tras resolver el efecto, tira 1D6 en la Tabla de efectos secundarios del Yunque rúnico y aplica el resultado correspondiente. No puedes utilizar la misma runa durante dos fases de magia consecutivas. Al lanzar una runa, puedes decidir desatar el poder de los ancestros: aplica el efecto Poder de los ancestros descrito en la runa en lugar del efecto normal. Tras resolver el efecto del Poder de los ancestros, tira 1D6+3 en la Tabla de efectos secundarios del Yunque rúnico y aplica el resultado correspondiente.</description>
                </rule>
                <rule name="Centro de poder" id="606a-3514-4662-c471" hidden="false">
                  <description>Otorga una tirada de salvación especial de 4+, +2 a Canalizar y las reglas especiales Resistencia mágica·(3) e Indesmoralizable, las cuales conferirá a la unidad a la que se una. A efectos de selección de objetivos, un yunque se considera un objetivo separado de su unidad.</description>
                </rule>
                <rule name="Unido a la roca y la tierra" id="c2c2-3c37-2a4f-2aa4" hidden="false">
                  <description>Un Yunque rúnico sin Ruedas no puede mover de ninguna manera y no puede unirse a unidades. Sin embargo, debido a la unión con la tierra, una vez por batalla podrá repetir la tirada en la Tabla de efectos secundarios del Yunque rúnico.</description>
                  <modifiers>
                    <modifier field="name" type="append" value="(Yunque sin ruedas)"/>
                  </modifiers>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry name="Ruedas" id="0e9b-22de-dd18-b499" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="e484-2347-469d-1704" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="f25e-f305-2adc-844e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Ruedas" id="3d64-e7f8-ff04-43d8" hidden="false">
                      <description>Puedes añadir Ruedas al Yunque rúnico por +80 puntos. Las ruedas le confieren una capacidad de movimiento de 6” y cambia su tipo de tropa a Carro, con la diferencia de que puede unirse a una unidad de enanos como un personaje y podrá marchar junto a la unidad que lo acompañe. Sin embargo, no podrá hacer uso de las reglas especiales Vanguardia, Explorador o Avance subterráneo, no es Veloz y tiene la regla especial Impactos por carga (1D3) en vez del normal 1D6 por tratarse de un Carro.</description>
                    </rule>
                  </rules>
                </selectionEntry>
                <selectionEntry name="Equipo guardianes del yunque" id="b9b5-de1f-9821-2693" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="458f-67be-0f6b-cf76" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="1045-8113-ade3-e43f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <selectionEntries>
                    <selectionEntry name="Arma a dos mano" id="7648-e003-556a-bf22" collective="false" hidden="false" import="true" type="upgrade">
                      <constraints>
                        <constraint id="3e86-b902-8949-5dc1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                        <constraint id="3b62-1159-e130-fed6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                      </constraints>
                      <costs>
                        <cost name="pts" typeId="points" value="0"/>
                        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                      </costs>
                      <infoLinks>
                        <infoLink name="Arma a dos manos" id="5f8f-272f-a73c-f8eb" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
                      </infoLinks>
                    </selectionEntry>
                  </selectionEntries>
                </selectionEntry>
                <selectionEntry name="Runas del Yunque Rúnico" id="168d-6e37-dac6-e1b7" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="41ad-30ca-af68-73e6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <rules>
                    <rule name="Runas del Yunque Rúnico" id="937a-6a6b-619e-db90" hidden="false">
                      <description>-Runa del hogar y el clan: Cuando se martillea esta runa, todos los enanos aliados que estén huyendo en el campo de batalla se reagrupan automáticamente. Todos los enanos aliados obtienen la regla especial Inmune a psicología hasta el inicio de tu siguiente fase de magia. Poder de los ancestros: Además de lo mencionado anteriormente, todas las unidades de enanos aliadas en el campo de batalla duplican su Potencia de unidad hasta el inicio de tu siguiente fase de magia.

-Runa de la devastación: Selecciona una unidad enemiga a 36” o menos del Yunque rúnico. Esta unidad sufrirá 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos. Ten en cuenta que no se considera un proyectil. Poder de los ancestros: En lugar de seleccionar una unidad enemiga, selecciona 1D2+1 unidades diferentes como objetivo para los rayos. Cada una sufrirá impactos como se ha descrito anteriormente.

-Runa del oprobio: Elige una unidad enemiga a 24” o menos del Yunque rúnico. Esa unidad verá su Movimiento e Iniciativa reducidos a la mitad hasta el inicio de tu siguiente fase de magia. Además, perderá la regla Veloz y tendrá un penalizador de -1 a su Liderazgo por la misma duración. Poder de los ancestros: Selecciona 1D2+1 unidades diferentes en lugar de solo una dentro del alcance; aplica los penalizadores a todas ellas.

-Runa del poder marcial: Selecciona una unidad amiga a 24” o menos del Yunque rúnico. Esta obtiene un bonificador de +1 a su Fuerza y un bonificador de +1 a impactar tanto en cuerpo a cuerpo como en disparo; el efecto dura hasta el inicio de tu siguiente fase de magia. Poder de los ancestros: En lugar de afectar a una unidad amiga, afecta a todas las unidades amigas a 24” o menos del Yunque rúnico.

-Runa de la furia y los agravios: Selecciona una unidad amiga a 24” o menos que no esté huyendo ni trabada en combate. Esa unidad moverá inmediatamente hacia delante 1D6+2”; si ese movimiento es suficiente para llegar a contacto con una unidad enemiga, se considera carga como si hubiese sido hecha por una unidad con Movimiento aleatorio. Poder de los ancestros: Selecciona 1D2+1 unidades diferentes en lugar de solo una dentro del alcance.</description>
                    </rule>
                    <rule name="Tabla de efectos secundarios del Yunque Rúnico" id="3eaf-9742-253d-bf6c" hidden="false">
                      <description>1D6 Efectos secundarios

1-4 No hay efectos adicionales.

5 El personaje y todas las miniaturas (amigas y enemigas) en contacto peana con peana con el Yunque rúnico sufrirán un impacto de Fuerza 4 con las reglas especiales Ataques mágicos y Ataques flamígeros.

6 Durante la siguiente fase de magia enemiga, los hechiceros superarán automáticamente todas sus tiradas para Canalizar.

7 El personaje no podrá usar ninguna runa durante su siguiente
fase de magia.

8 La runa que provocó esta tirada no podrá usarse más durante el resto de la partida. Adicionalmente, el personaje sufrirá una herida sin tirada de salvación de ningún tipo.

9+ El personaje sufre 1D6 impactos de Fuerza 10 con las reglas especiales Ataques mágicos y Ataques flamígeros. Todas las miniaturas (amigas y enemigas) en contacto peana con peana con el Yunque rúnico deberán superar un chequeo de Iniciativa. Si lo fallan, sufrirá un impacto de Fuerza 10 con las reglas especiales Ataques mágicos y Ataques flamígeros.</description>
                    </rule>
                  </rules>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="[E] - Grombrindal, el Enano Blanco" id="ee09-9044-919c-2731" collective="false" hidden="false" import="true" type="unit">
