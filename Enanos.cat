          </entryLinks>
          <profiles>
            <profile name="Runa magistral devoradora de magia" id="ab61-83ea-e802-5e93" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">El portador no puede verse afectado por hechizos de ningún tipo; no significa que los disperse, sino que simplemente no le causan ningún efecto o daño. Ten en cuenta que esto sólo afecta al portador, no a la unidad en la que se encuentre. Además, le otorga una tirada de salvación especial de 4+ contra Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
