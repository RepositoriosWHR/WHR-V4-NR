                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Arma de mano" id="1b4a-003d-9339-b4dd" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
                <infoLink name="Heridas múltiples (1D3)" id="22c8-8375-c0b0-aedc" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Hachas gemelas de Grimnir" id="c0c9-ab1e-2097-55ae" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques efectuados con este arma herirán siempre con un resultado de 2+ sin importar la resistencia del objetivo, no permiten tirada de salvación por armadura y tienen la regla especial Heridas múltiples (1D3), que se verá incrementada a 1D6 contra trolls y ogros. La magia de este hacha es tan potente que no puede ser anulada o destruida por objetos mágicos, reglas especiales u otros efectos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura de Skaldor" id="3833-fa31-fcf1-5a37" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dc1f-39d2-9d71-2524" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="0c25-5501-fea9-e433" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Armadura de Gromril" id="d9c2-3ba2-3ae7-c9ab" hidden="false" targetId="89a8-80b1-f54b-d42b" type="profile"/>
                <infoLink name="Inmune al fuego" id="4947-069e-251a-dbba" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
                <infoLink name="Inmune al veneno" id="8526-de5c-53ef-1d28" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Armadura de Skaldor" id="9ed8-fc2b-5f1a-c920" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de gromril. La armadura tiene grabadas la Runa magistral de gromril, una Runa de la resistencia, una Runa ígnea (aunque sea una runa talismánica) y una Runa de la salvación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Runas de Armadura de Skaldor" id="dce5-cbe6-1ccd-fd80" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="60dc-c2f0-dc19-1529" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="fa85-f605-7999-393c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Runa magistral de Gromril" id="597d-5703-d841-9530" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">Proporciona al portador una tirada de salvación por armadura de 1+.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la resistencia" id="7f34-50ea-dec3-9eed" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">El portador puede repetir sus tiradas de salvación por armadura fallidas.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa ígnea" id="ab14-a593-3b88-92bd" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">El personaje obtiene la regla especial Inmune a fuego.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la salvación" id="e432-6bef-9b86-d5f3" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">El portador obtiene la regla especial Inmune a veneno e inmunidad a la regla especial Golpe letal.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
            <selectionEntry name="Corona del dragón de Karaz-a-Karak" id="a935-a1ea-2905-68bf" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7caa-63c6-986e-919a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="b0d4-5368-1de6-9e8b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
