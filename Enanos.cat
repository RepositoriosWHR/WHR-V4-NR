  <sharedProfiles>
    <profile name="Arcabuz enano" id="feed-806b-3311-c2bb" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Mover o disparar, Poder de penetración, Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Taladro a vapor" id="cf1c-fbdf-b62c-90c0" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Lenta, Heridas múltiples (2), Una unidad de Mineros que cuente con un Capataz con Taladro a vapor puede repetir la tirada para determinar si entran al campo de batalla al utilizar la regla Avance subterráneo.</characteristic>
      </characteristics>
    </profile>
    <profile name="Martillo real" id="681d-619b-21fd-60f1" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Ataques mágicos</characteristic>
      </characteristics>
    </profile>
    <profile name="Cañón draco" id="0c1a-fa2b-ba29-d044" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">18&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Disparo rápido, Poder de penetración, Ataques flamígeros, Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Arcabuz de repetición enano" id="f8ca-ddfb-5bb4-c5dd" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Mover o disparar, Poder de penetración, Disparos múltiples (3), Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas draco (disparo)" id="b187-ba01-8091-cf19" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Disparos múltiples (2), Ataques flamígeros. Al luchar con ambas en combate cuerpo a cuerpo, puede realizar todos sus ataques en la primera ronda de cada combate con F5 y Poder de penetración.</characteristic>
      </characteristics>
    </profile>
    <profile name="Torpedo martillo de troll" id="4b5c-08b3-f63e-4966" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">18&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Atraviesa filas, Heridas múltiples (1D3), Poder de penetración</characteristic>
      </characteristics>
    </profile>
    <profile name="Fuego etílico" id="5023-042b-59ae-0305" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Arma de aliento</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Se trata de un Arma de aliento de Fuerza 3 con la regla especial Ataques sólo flamígeros.</characteristic>
      </characteristics>
    </profile>
    <profile name="Bombas de mano de Malakai Makaisson" id="fc9a-6c29-0dd4-9c7b" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">10&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Dispara como Catapulta: Las Bombas de mano de Malakai Makaisson se disparan como una Catapulta que puede disparar aunque su portador mueva. Coloca la plantilla redonda pequeña dentro del alcance y tira los dados de dispersión y artillería, reduciendo las distancias del dado de artillería a la mitad. Este ataque no tiene impacto central. Si obtienes Problemas, coloca la plantilla sobre el lanzador. No puede utilizarse para Aguantar y disparar o Disparar y huir.</characteristic>
      </characteristics>
    </profile>
    <profile name="Hachas de matador" id="e32e-d9de-038c-be2a" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323"/>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Se trata de un arma de combate la cual, al inicio de cada ronda de combate, puedes elegir si utilizarla como Armas emparejadas o Arma a dos manos.</characteristic>
      </characteristics>
    </profile>
    <profile name="Armadura de gromril" id="89a8-80b1-f54b-d42b" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Inmune a Poder de penetración</characteristic>
      </characteristics>
    </profile>
    <profile name="Cargas de demolición" id="6131-92e1-334a-38ab" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323"/>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Sólo pueden utilizarse para Aguantar y disparar. Causan 1D6 impactos automáticos de Fuerza 5 con las reglas especiales Disparo rápido y Poder de penetración.</characteristic>
      </characteristics>
    </profile>
    <profile name="Cañón de azufre" id="eacd-5536-a566-6981" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Disparos múltiples (1D6+1), Disparo rápido, Ataques sólo
flamígeros, Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Tatuajes protectores" id="c0f3-90af-7b40-4d76" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Otorga la regla especial Resistencia mágica (1) y una tirada de salvación especial de 6+ contra proyectiles y hechizos del tipo Proyectil mágico.</characteristic>
      </characteristics>
    </profile>
    <profile name="Sistema de guía" id="e083-76d0-1151-4266" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El portador obtiene un bonificador de +1 a sus tiradas para impactar con proyectiles.</characteristic>
      </characteristics>
    </profile>
    <profile name="Mirilla de aumento" id="c1f9-9190-a758-b526" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Si el personaje va equipado con un Arcabuz enano, éste obtiene la regla especial Francotirador.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pólvora mejorada" id="451c-3d68-4464-9ff4" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Aumenta en uno la Fuerza del Arcabuz enano, Arcabuz de repetición enano, Pistola enana o Ristra de pistolas enanas del portador.</characteristic>
      </characteristics>
    </profile>
    <profile name="Diseño superior" id="32cb-76e2-0790-ecd6" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">No tienen el penalizador de -1 por disparar a larga distancia.</characteristic>
      </characteristics>
    </profile>
    <profile name="Recámara" id="efdb-439f-adb7-95d5" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El Arcabuz enano y Pistola enana del portador obtienen la regla especial Disparos múltiples (2). El Arcabuz de repetición enano o Ristra de pistolas enanas del portador aumentan su valor de Disparos múltiples en uno.</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola enana (combate)" id="9c9a-8151-2b34-8ed7" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Arma de mano adicional, Descarga</characteristic>
      </characteristics>
    </profile>
    <profile name="Pistola enana (disparo)" id="c7bb-329c-74f7-cf31" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">12&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Disparo rápido, Diseño superior</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas enanas (combate)" id="21d4-dcfe-0d6c-0f66" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Poder de penetración, Armas emparejadas, Descarga</characteristic>
      </characteristics>
    </profile>
