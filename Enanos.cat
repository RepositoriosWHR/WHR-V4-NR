            <profile name="Runa del escrutinio" id="993c-0818-6186-c0b2" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Al comienzo de cada turno enano, todas las unidades enemigas a 18” o menos del portador deberán revelar todas sus opciones ocultas.</characteristic>
              </characteristics>
