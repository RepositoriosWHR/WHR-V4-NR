          <profiles>
            <profile name="Runa magistral del acero" id="4c63-b2c5-5551-f916" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">Los resultados de 1, 2 y 3 en las tiradas para herir contra el portador siempre se consideran un fallo; esto no tiene efecto en ataques que hieran automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Karak-Rhun, runa magistral de la eternidad" id="bc70-eacd-91fd-48b1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fe35-efac-6b7b-fa10" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
