            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de defensa" id="2c0f-673c-ad7a-3f31" hidden="false" typeId="37d3-b183-e1a9-ca49" typeName="Runa de protección">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7ece-0fe9-e543-e3fc">Solo Portaestandarte de batalla. El portador obtiene +1 Herida (este bonificador se acumula con varias runas iguales).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de la sorpresa" id="e2f6-eee9-2e62-503b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
