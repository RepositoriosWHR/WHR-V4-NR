                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los ataques con el arma obtienen la regla especial Heridas múltiples (1D6).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la furia" id="9db7-24dd-a07a-01ad" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Al atacar con el arma, el personaje obtiene +1 Ataque (este bonificador se acumula con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la fuerza" id="b572-6dd4-721e-2a8d" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los impactos con el arma se resuelven con un bonificador de +1 a la Fuerza (este bonificador se acumula con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
