                  <profiles>
                    <profile name="Runa del hierro (2)" id="09aa-860a-9c25-363a" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">Otorga al portador una tirada de salvación especial de 6+. Esto aumenta a 5+ con dos Runas del hierro. No pueden grabarse tres Runas de hierro en una misma armadura.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la resistencia" id="3959-0812-7ca7-d917" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">El portador puede repetir sus tiradas de salvación por armadura fallidas.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
            <selectionEntry name="Armadura de gromril" id="96b8-23f6-65c0-03d7" collective="false" hidden="false" import="true" type="upgrade">
