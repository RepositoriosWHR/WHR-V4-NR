          <profiles>
            <profile name="Runa buscadora de Flaksson" id="2294-3248-1212-df65" hidden="false" typeId="2915-68d1-ee1b-ddd9" typeName="Runa de los ingenieros">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="688e-e9ce-32c4-32ff">Sólo Lanzavirotes enano. Proporciona un bonificador de +1 en sus tiradas para impactar contra objetivos con la regla especial Volar o Flotar. Además, sus disparos obtienen la regla especial Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de recarga" id="92dc-3ee0-22ee-4cfd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="727c-e63d-c10e-4008" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de recarga" id="0163-bc4a-a66c-fbf7" hidden="false" typeId="2915-68d1-ee1b-ddd9" typeName="Runa de los ingenieros">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="688e-e9ce-32c4-32ff">Un sólo uso. La máquina de guerra ignora el primer resultado de 3-4 (tabla de problemas de Cañón) o de 2-3 (tabla de problemas de Catapulta) que obtenga en la batalla, considerándolo como 5-6 o 4-6 respectivamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de la forja" id="03e9-dc01-1b62-bdfe" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b321-5392-4c13-c14a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="3"/>
