      <entryLinks>
        <entryLink name="Señor de las runas" id="ccbb-3816-7591-dc4f" collective="false" hidden="false" import="true" targetId="8beb-59e5-a856-84a3" type="selectionEntry"/>
        <entryLink name="Señor de las runas o Herrero rúnico" id="22d7-3bc4-d342-752c" collective="false" hidden="false" import="true" targetId="30f1-7d45-d7de-2f2a" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Avance imparable" id="39e5-391d-c59c-f367" hidden="false" targetId="1ad7-2f8f-dcd1-cb6f" type="rule"/>
        <infoLink name="Infantería" id="eabd-9dfd-a3b2-d4c8" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Resistencia mágica (2)" id="79f2-58db-f081-cfee" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
        <infoLink name="Odio (Pielesverdes y Skaven)" id="5314-89b1-d44d-b0a2" hidden="false" targetId="8701-9eaa-6523-4996" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Forjador Rúnico" id="a861-0ec9-ee3b-bdf5" hidden="false">
          <description>Thorek genera dos dados de Dispersión adicionales para el ejército enano en cada fase de magia del oponente y puede Canalizar dados de Dispersión como si fuese un hechicero. Además, tiene la regla especial Resistencia mágica (2). Adicionalmente, un ejército enano con Thorek tiene un bonificador para dispersar de +4 en vez del indicado por la regla especial Resistentes a la magia.</description>
        </rule>
        <rule name="Maestro del conocimiento de los antiguos" id="6951-5f75-3ef8-d4d2" hidden="false">
          <description>Thorek resta 1 de todas las tiradas que realice en la tabla de efectos secundarios del Yunque rúnico. Cualquier resultado inferior a 1 se considera 1.</description>
        </rule>
        <rule name="Kraggi, ayudante de la forja" id="386f-a8f2-fb68-3f88" hidden="false">
          <description>Kraggi añade una Herida adicional (para un total de 6) al conjunto de Thorek y su Yunque rúnico. Cada vez que tire en la tabla de efectos secundarios del Yunque rúnico, Thorek puede repetir la tirada en la tabla de efectos secundarios del Yunque rúnico. Sin embargo, al repetir esa tirada, no restará 1 por la regla especial Maestro del conocimiento de los antiguos.</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos" id="eccc-ba0e-7dc1-7796" hidden="false"/>
      </rules>
