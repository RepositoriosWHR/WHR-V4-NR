      <rules>
        <rule name="Poder rúnico" id="5b62-92be-b88e-a0ae" hidden="false">
          <description>Guardianes rúnicos tienen las reglas especiales Ataques mágicos y Resistencia mágica (3), además de una tirada de salvación especial de 5+.</description>
        </rule>
        <rule name="Iconos legendarios" id="deee-b810-febb-bd99" hidden="false">
          <description>Todas las unidades aliadas de enanos a 12” o menos de los Guardianes rúnicos tendrán la regla especial Inmune a psicología, y obtendrán un bonificador extraordinario de +1 al resultado del combate (esto no afecta a los propios Guardianes rúnicos).</description>
        </rule>
        <rule name="Constructos rúnicos" id="7b7e-fe00-55dd-77a3" hidden="false">
          <description>Los Guardianes rúnicos tienen las reglas especiales Indesmoralizables e Inmune a veneno.</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos , constructo" id="d3b1-676e-0307-81b1" hidden="false"/>
      </rules>
