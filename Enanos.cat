                    <profile name="Runa magistral de la destrucción" id="dd1b-72e9-fb44-ffbc" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los ataques con el arma obtienen la regla especial Heridas múltiples (1D6).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la furia" id="9909-1807-4e6e-656a" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Al atacar con el arma, el personaje obtiene +1 Ataque (este bonificador se acumula con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
