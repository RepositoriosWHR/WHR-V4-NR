                    <profile name="Runa magistral de Gromril" id="2d74-9c0c-d5d8-8643" hidden="false" typeId="f563-34bd-3dca-0be2" typeName="Runa de defensa">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c878-837a-2160-6de3">Proporciona al portador una tirada de salvación por armadura de 1+.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa ígnea" id="0d1d-1493-2245-af7a" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
