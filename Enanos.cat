          </infoLinks>
          <profiles>
            <profile name="Runa ígnea" id="b7f8-e3eb-1593-be82" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">El personaje obtiene la regla especial Inmune a fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de la venganza" id="185d-a9a4-37f8-4723" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eee2-1c8e-ed54-bd89" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de la venganza" id="e4a4-1d1a-9b9c-f537" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Si el portador es seleccionado exclusivamente como objetivo de un hechizo de Daño directo o mediante la regla especial Francotirador, el efecto del hechizo o disparo deberá resolverse contra el hechicero o tirador que lo efectuó.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de salvaguarda" id="1798-1d59-a42f-a24e" collective="false" hidden="false" import="true" type="upgrade">
