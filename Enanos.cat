            <entryLink name="Runas Magsitrales" id="05b3-13a9-81e1-2ec3" collective="false" hidden="false" import="true" targetId="2b9d-3fb9-eb1b-2fee" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Runa magistral del desafío" id="e1bf-39e7-e63e-c30f" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Si el portador lanza un Desafío, el oponente deberá aceptarlo obligatoriamente si le es posible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa magistral eterna" id="4fca-9ffa-8375-8e33" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8e8f-a486-a5e1-506d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
