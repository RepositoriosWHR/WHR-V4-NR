          </infoLinks>
          <profiles>
            <profile name="Runa de salvaguarda" id="8b54-91a9-f6e7-8339" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">El portador obtiene la regla especial Resistencia mágica (1) (este bonificador se acumula hasta un máximo de Resistencia mágica [3]).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de la restauración" id="4483-485c-2843-1a36" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="40ab-7250-3d7e-3472" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
