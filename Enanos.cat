              <profiles>
                <profile name="Brazo mecánico" id="d3ca-0681-8d15-e017" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El Brazo mecánico otorga a Grimm un bonificador de +1 a su tirada de salvación por armadura. En combate, Grimm puede utilizar su brazo para realizar un ataque especial (ya indicado en su perfil); el ataque se resolverá con un bonificador de +2 a la Fuerza.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
