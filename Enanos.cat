          <profiles>
            <profile name="Runa de la puntería" id="483d-1df7-dc4f-1204" hidden="false" typeId="2915-68d1-ee1b-ddd9" typeName="Runa de los ingenieros">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="688e-e9ce-32c4-32ff">Sólo Lanzavirotes enano. Un sólo uso. Impacta a 2+ en disparo, sin tener en cuenta otros modificadores. Además, ese disparo tendrá la regla especial Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa del orgullo artillero" id="bb1f-4568-eed4-21c5" collective="false" hidden="false" import="true" type="upgrade">
