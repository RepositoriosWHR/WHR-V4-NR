                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los ataques con el arma no permiten tirada de salvación por armadura.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la furia (2)" id="75c4-184c-033d-9d66" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Al atacar con el arma, el personaje obtiene +1 Ataque (este bonificador se acumula con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
