        <selectionEntry name="Runa magistral del rencor" id="6366-611d-044a-8f0b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2eef-604e-a4ae-c153" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
