              <profiles>
                <profile name="Hacha del justo castigo" id="0a40-2de7-57d7-d961" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. El hacha tiene grabadas la Runa magistral de la ruina, una Runa de la agonía y una Runa de la fuerza.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
