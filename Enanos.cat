              <infoLinks>
                <infoLink name="Arma emparejadas" id="fd8e-631d-482d-ea03" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink name="Resistencia mágica (2)" id="6d50-6fc0-659e-4c7e" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Hachas de Kadrin" id="1327-6b73-9dae-3009" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Tienen grabadas la Runa magistral de Alaric el Loco y dos Runas de la furia. Además, los amuletos amarrados a estas hachas otorgan a Garagrim la regla especial Resistencia mágica (2).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
