            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de la suerte" id="b5e3-0e22-2ca9-eb2f" hidden="false" typeId="4be9-2442-f655-1d41" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="1f0c-8872-de47-0b6d">Un solo uso. Puede repetir una tirada para impactar, herir, tirada de salvación por armadura o especial, chequeo de atributo o un único dado en una tirada de dispersión de hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
