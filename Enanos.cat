            <infoLink name="Arrojadiza" id="eddb-1926-fed4-89fd" hidden="false" targetId="f4e8-fb62-1495-6c04" type="rule"/>
            <infoLink name="Heridas múltiples (1D6)" id="b2b6-1ac7-537c-df75" hidden="false" targetId="e658-6033-5e1f-c1c4" type="rule"/>
            <infoLink name="Disparo rápido" id="73ff-c461-f448-4663" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Martillo del destino" id="a509-05f8-3ade-7023" hidden="false" typeId="e776-3e82-55cc-e65e" typeName="Objeto rúnico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a9b7-9733-fc31-8e25">Se trata de un martillo que tiene grabada la Runa Magistral del Vuelo, la Runa Magistral de la Destrucción y dos Runas de la fuerza.</characteristic>
              </characteristics>
            </profile>
            <profile name="Runa de la fuerza (2)" id="8363-97d9-99b6-8368" hidden="false" typeId="3eb7-0571-1e63-c3fd" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los impactos con el arma se resuelven con un bonificador de +1 a la Fuerza (este bonificador se acumula con varias runas iguales).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Objeto rúnico legendario" id="b5b2-71b3-b166-eb74" hidden="false">
              <description>Pueden ser elegidos por comandantes enanos en lugar de uno  de sus objetos rúnicos habituales. No pueden grabarse más runas en estos objetos.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Runa Magistral de la Destruccion" id="25ec-1461-6b0c-efe7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5141-8f1a-e408-e02c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="84b4-7bef-5263-0cd2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="1601-e4cf-a105-90d3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
