          <profiles>
            <profile name="Runa de la firmeza" id="d330-ff59-830b-8968" hidden="false" typeId="2915-68d1-ee1b-ddd9" typeName="Runa de los ingenieros">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="688e-e9ce-32c4-32ff">Otorga un bonificador extraordinario de +1 al resultado del combate de la máquina de guerra (este bonificador se acumula con varias runas iguales).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de la defensa" id="a3ba-63f0-1ab2-6477" collective="false" hidden="false" import="true" type="upgrade">
