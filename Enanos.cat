                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="c4c7-fd71-d85a-640e">Los ataques con el arma tienen un bonificador de +1 para impactar en cuerpo a cuerpo (este bonificador se acumula 
con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
