                  <rules>
                    <rule name="CLAVE : ENANOS, IMPERIO, enanos (sólo Gotrek), humanos (sólo Félix)." id="7c5b-1bc6-f2fc-67de" hidden="false"/>
                    <rule name="¡Sorpresa!" id="6e5c-4afb-bca2-1472" hidden="false">
                      <description>Al inicio de la batalla elige entre Exploradores o Vanguardia:  Gotrek y Félix ganan dicha regla especial durante la batalla.</description>
                    </rule>
                  </rules>
