      <rules>
        <rule name="Control de los vientos de la magia" id="af51-e054-e274-ad24" hidden="false">
          <description>Un Señor de las Runas genera un dado de dispersión adicional para el ejército enano, y puede canalizar dados de dispersión como si fuese un hechicero.</description>
        </rule>
        <rule name="Forjador rúnico" id="2f9d-54a0-c08e-ac5c" hidden="false">
          <description>Un Herrero rúnico genera un dado de Dispersión adicional para el ejército enano en cada fase de magia del oponente y puede Canalizar dados de Dispersión como si fuese un hechicero. Además, tiene la regla especial Resistencia mágica (1).</description>
        </rule>
      </rules>
