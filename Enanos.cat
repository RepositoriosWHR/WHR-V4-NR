    <selectionEntry name="[Ex] - Sacerdotisa de Valaya" id="8357-0756-c7e4-84b1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="5842-c625-1b74-7b5a" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
        <categoryLink name="Personajes" id="3fda-934e-4886-b872" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="8e01-9f72-2257-421e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="ee73-e256-d47e-f592" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Odio (Pielesverdes y Skaven)" id="06e3-e2db-447e-bee4" hidden="false" targetId="8701-9eaa-6523-4996" type="rule"/>
        <infoLink name="Avance imparable" id="2628-6494-499d-6731" hidden="false" targetId="1ad7-2f8f-dcd1-cb6f" type="rule"/>
        <infoLink name="Resistencia mágica (2)" id="f905-ea71-e59b-44e7" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="No combatiente" id="6019-a424-d9da-ac68" hidden="false">
          <description>Pese a ser personaje, una Sacerdotisa de Valaya puede colocarse en la segunda fila de una unidad; la unidad podrá seguir beneficiándose de su Liderazgo pese a estar en segunda fila. Tan sólo tendrá que moverse a la primera fila si quedan menos de 6 miniaturas en su unidad. Una Sacerdotisa no puede atacar y tampoco puede lanzar o aceptar Desafíos.</description>
        </rule>
        <rule name="Poder sanador de Valaya" id="0392-9269-6800-56ee" hidden="false">
          <description>Si la Sacerdotisa de Valaya se une a una unidad, tanto ella como la unidad obtienen la regla especial Regeneración (6+). Además, al inicio de cada uno de tus turnos puedes elegir un personaje en la misma unidad que la Sacerdotisa de Valaya (puede ser la propia sacerdotisa): ese personaje puede restaurar una de las heridas que hubiese sufrido previamente durante la batalla.</description>
        </rule>
        <rule name="Discernir la verdad" id="2e40-f5d3-41b7-8756" hidden="false">
          <description>Al inicio de cada uno de tus turnos, el enemigo tendrá que revelar todas las opciones secretas de sus unidades a 18” o menos de la Sacerdotisa de Valaya.</description>
        </rule>
        <rule name="Desbaratar la magia" id="9838-d8e4-41cf-7fa0" hidden="false">
          <description>Una Sacerdotisa de Valaya tiene la regla especial Resistencia mágica (2). Si un hechicero enemigo selecciona a la unidad donde está una Sacerdotisa de Valaya como objetivo de un hechizo, sufrirá unaDisfunción mágica si obtiene cualquier resultado de dobles en su tirada de lanzamiento (adicionalmente a cualquier disfunción que pudiese sufrir por el lanzamiento del hechizo).</description>
        </rule>
        <rule name="CLAVE : ENANOS , enanos" id="5c57-c4d0-0e63-fe5a" hidden="false"/>
      </rules>
      <selectionEntries>
        <selectionEntry name="General del ejército" id="b5fb-a003-edd6-223e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="44ce-2c5e-f40a-e6bc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
