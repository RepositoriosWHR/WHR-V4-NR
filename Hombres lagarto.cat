            <selectionEntry name="Primera generación" id="43f2-5f8e-601c-b2ba" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="595f-8adc-4a29-8062" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="cc3d-3ec4-dd20-a782" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Primera generación Lord Kroak de la primera generación" id="1245-2c3d-35c3-4d15" hidden="false">
                  <description>Kroak es un Mago-Sacerdote de Primera Generación: es inmune a las Disfunciones mágicas, no perderá la concentración si no consigue lanzar o dispersar con éxito un hechizo, Canaliza automáticamente y genera 1D3 dados adicionales de Energía o Dispersión al inicio de cada fase de magia. Cada vez que lance un hechizo, Kroak genera un dado de Energía adicional para ese hechizo y, cada vez que realiza un intento de dispersión, genera 
un dado de Dispersión adicional para ese intento de dispersión. Además, podrá lanzar un mismo hechizo más de una vez por fase de magia. Por último, al inicio de cada fase de magia, elige un número del 1 al 5: todos los dados de Energía o Dispersión que lance Kroak y obtengan el número elegido se considerará que han obtenido un resultado de 6.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
