      <rules>
        <rule name="Cola maza" id="695f-ccf8-728a-9391" hidden="false">
          <description>El ataque adicional del Bastiodón tiene la regla especial Heridas múltiples (1D3) y se resuelve con +1 Fuerza.</description>
        </rule>
        <rule name="Defensa impenetrable" id="f353-af23-1c09-b6cb" hidden="false">
          <description>A la hora de calcular modificadores al resultado de combate el Bastiodón cuenta como si no tuviera ni flancos ni retaguardia (es decir, el enemigo nunca obtendrá el bonificador de +1/+2 por atacar por el flanco/la retaguardia contra un Bastiodón).</description>
        </rule>
        <rule name="Potencia de unidad 10" id="a4b2-d2d2-c454-be9a" hidden="false">
          <description>Potencia de unidad 10</description>
        </rule>
      </rules>
