                        <characteristic name="H" typeId="5.723232344415441e+21">+1</characteristic>
                        <characteristic name="I" typeId="4.923232344415441e+21">4</characteristic>
                        <characteristic name="A" typeId="4.123232344415441e+21">1</characteristic>
