        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Kremlo, el slann" id="a8aa-89af-7edb-8976" hidden="false">
          <description>Kremlo es un hechicero de nivel de magia 3 que toma sus hechizos del saber de Alta Magia.</description>
        </rule>
        <rule name="Marcado por los ancestrales" id="b33c-03c0-c828-cfb9" hidden="false">
          <description>El efecto de la Marca sagrada de los ancestrales le proporciona a Kremlo una tirada de salvación especial de 4+ y hasta 2D3 repeticiones de tiradas que podrá realizar durante la batalla (en lugar de 1D3 como es habitual). Además, tiene la regla especial ¡Ni un paso atrás!.</description>
        </rule>
        <rule name="Identidad anacrónica" id="7d06-ab9e-7ea1-cc37" hidden="false">
          <description>Kremlo tiene la regla especial Odio (Caos). Además, cualquier unidad de Guerreros eslizón en la que Kremlo sea desplegado al comienzo de la batalla obtendrá dicha regla especial.</description>
        </rule>
      </rules>
