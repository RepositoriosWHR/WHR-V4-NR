          </infoLinks>
          <profiles>
            <profile name="Lanza de guerra del estegadón" id="7084-47a1-781f-d320" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza de caballería. Sólo eslizones montados en Estegadón o Estegadón anciano. Cuando el estegadón cause impactos por carga, tira 2D6 y elige el resultado mayor para determinar el número de impactos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Reliquias. Hombres lagarto. Saurios" id="ccf0-7c3b-fff4-f4ec" collective="false" hidden="false" import="true">
