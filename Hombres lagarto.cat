        <selectionEntry name="Desove sagrado de Xoloc" id="012a-851f-6fcf-1233" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4f86-4d31-e5f5-5302" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
