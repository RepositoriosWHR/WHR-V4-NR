    <selectionEntry name="[E] - Tetto&apos;eko, astromante del templo del eclipse" id="889b-b9a6-4982-af3c" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="89d7-d183-f8de-9ba1" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
