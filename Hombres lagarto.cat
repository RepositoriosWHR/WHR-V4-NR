                  </infoLinks>
                  <profiles>
                    <profile name="Maza cobra" id="0cb6-c9fa-b3c1-752e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Otorga a Mazdamundi la regla especial Ataques envenenados. Adicionalmente, efectúa una tirada de 1D6 por cada impacto que cause a una miniatura enemiga con esta maza. Si obtienes al menos un resultado de 4+, todos los objetos mágicos que poseyese la miniatura perderán sus propiedades mágicas hasta el final de la batalla. Estos objetos pasarán a considerarse objetos mundanos de su mismo tipo.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
