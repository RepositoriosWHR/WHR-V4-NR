              <infoLinks>
                <infoLink name="Leyenda" id="106a-706b-f51d-67a9" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
                <infoLink name="Inmune a psicología" id="5964-53d7-e5c9-918f" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Primera generación El venerable Cacique-Kroak" id="b9c5-28e2-1e48-42be" hidden="false">
                  <description>Kroak es un Mago-sacerdote slann de Primera generación. Sus poderes impiden que sufra Disfunciones mágicas, le permite Canalizar automáticamente y generar un dado de energía en cada fase de magia propia. Además, puede repetir un dado de Energía o Dispersión en cada uno de sus hechizos o dispersiones, no pierde la concentración si no consigue lanzar o dispersar con éxito un hechizo y puede lanzar un mismo hechizo más de una vez por fase de magia.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
          <selectionEntryGroups>
            <selectionEntryGroup name="Montura" id="6005-e7e5-48e7-589f" collective="false" hidden="false" import="true">
