        <infoLink name="Inmune a psicología" id="bb11-5150-4af2-6505" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Indesmoralizable" id="fa91-861d-1bea-a45c" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
      </infoLinks>
      <modifiers>
