      <rules>
        <rule name="Estegadón anciano (montura)" id="ab03-e44a-ff61-93a7" hidden="false">
          <description>Los Eslizones que montan el castillo del Estegadón anciano obtienen de forma gratuita el Desove sagrado 
de su portador (si los Eslizones de la Unidad Singular Estegadón anciano pueden adquirir dicho desove).</description>
        </rule>
        <rule name="Potencia de unidad 9" id="3f38-b279-826a-5b6d" hidden="false">
          <description>Potencia de unidad 9 (+1 por cada Eslizón adicional).</description>
        </rule>
      </rules>
