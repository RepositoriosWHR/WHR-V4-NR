        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Generaciones" id="b203-cb21-4fcd-b181" collective="false" hidden="false" import="true" targetId="2d5c-4069-916b-f22e" type="selectionEntryGroup"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="9a14-6fec-3cef-f025" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Sangre fría" id="2ddd-64d3-0003-13d2" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink name="Cruzar (elementos acuáticos)" id="3020-05ea-30e8-f0be" hidden="false" targetId="b7d4-b324-49ee-71ae" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Escudo de los ancestrales" id="1180-6807-ed63-0b8e" hidden="false">
          <description>Los Magos-sacerdote Slann tienen una tirada de salvación especial de 5+. Además, tienen una Potencia de unidad de 3. Un Mago-sacerdote Slann tan solo puede unirse a unidades de Guerreros saurio o Guardia del templo; en caso de ir montado en Palanquín de la guardia, sólo podrá unirse a unidades de Guardia del templo.</description>
        </rule>
        <rule name="Telepatía" id="f594-d8ec-f4bf-c1aa" hidden="false">
          <description>Un Mago-sacerdote slann puede lanzar sus hechizos desde otra miniatura de Mago-sacerdote slann o de Chamán eslizón a 24” o menos; simplemente ten en cuenta el alcance y la línea de visión desde la miniatura que elijas, aunque la tirada de lanzamiento la realizará el poseedor original del hechizo.</description>
        </rule>
        <rule name="Magia Mago-Sacerdote Slann" id="a93b-785a-74c8-95aa" hidden="false">
          <description>Un Mago-sacerdote slann es un hechicero de nivel 4. Puede escoger sus hechizos de entre los saberes de Alta Magia o los ocho saberes básicos.</description>
        </rule>
      </rules>
