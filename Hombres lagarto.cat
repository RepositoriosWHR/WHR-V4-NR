    <selectionEntryGroup name="Objetos hechizados. Hombres lagarto" id="e103-2f22-0afd-4f9b" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4038-0c82-51ab-b87d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estatuilla del rencor" id="7603-1323-15b7-858b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d092-c5e3-0334-644e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0696-efb9-8529-4967" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estatuilla del rencor" id="8897-a310-c733-ea58" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos. Nivel de energía 4. Contiene un hechizo de Daño directo que toma como objetivo a una única miniatura enemiga a 12” o menos del portador, pudiéndose seleccionar incluso a un personaje en una unidad. El objetivo debe realizar inmediatamente un chequeo de Resistencia con 2D6. Si lo falla, perderá inmediatamente la mitad de las heridas que le queden, redondeando hacia arriba.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colgante reluciente de Chotek" id="f3f1-6963-27a5-ca97" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2e28-2007-6cc1-4543" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="223b-5a9d-bff5-a13e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Colgante reluciente de Chotek" id="a119-5a0b-3e5a-e1c5" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier fase de combate cuerpo a cuerpo. Todos los enemigos en contacto peana con peana con el portador verán su Iniciativa reducida a cero hasta el final de la fase de combate cuerpo a cuerpo en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pájaro de Chotek" id="3d0a-a72b-9d4d-4016" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8eff-a1cc-9ba9-bb23" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5855-5f5a-fcf4-9620" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pájaro de Chotek" id="5bb6-6575-8ae7-4baa" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier turno de los hombres lagarto. Hasta el inicio del siguiente turno de los hombres lagarto, todas las miniaturas (amigas y enemigas) con la regla especial Volar o Flotar en el campo de batalla no podrán hacer uso de dichas reglas. Además, todas las unidades (amigas y enemigas) que disparen tendrán un penalizador de -1 en su tirada para impactar durante dicho turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Veneno de la ranita de luz" id="ae68-b0b6-284c-d202" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9634-deb5-b0f6-89c1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ef5e-9fe9-7f72-187c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques mágicos" id="f34b-7f04-ee51-e12a" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Ataques envenenados" id="be5d-b072-0444-f6c8" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Veneno de la ranita de luz" id="db40-7e4b-cb2d-2fdf" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene las reglas especiales Ataques envenenados y Ataques mágicos. Si ya disponía de la regla especial Ataques envenenados, estos surtirán efecto con un resultado de 5+ en lugar del 6+ habitual.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pendiente del carnosaurio" id="e702-1b66-fc6f-0d7c" collective="false" hidden="true" import="true" type="upgrade">
          <constraints>
            <constraint id="065b-105d-1863-a333" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="96a0-bc8e-819b-b2ff" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="027d-c8d7-f8ff-da8a" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="false">
              <conditions>
                <condition childId="08de-9145-45ba-07f8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="atLeast" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Pendiente del carnosaurio" id="5a54-eba7-f4c7-5edf" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con el Desove Sagrado de Itzl. Si el portador sufre una o más heridas, obtendrá la regla especial Furia asesina y no la perderá aunque pierda el combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tambor de guerra de Xahutec" id="186b-33de-bc78-507c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="efd3-3cc0-7246-12e7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="28d4-4827-47d2-1682" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tambor de guerra de Xahutec" id="bbf6-82be-a9cd-9f9a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y la unidad en la que se encuentre superarán automáticamente todos los chequeos que deban realizar para marchar cuando tengan enemigos cerca. Adicionalmente, todas las unidades amigas que intenten reagruparse a 12” o menos del portador podrán sumar +1 a su atributo de Liderazgo para ese chequeo. El portador se considerará Músico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El cuerno de Kygor" id="fec2-8cbe-b889-0ef5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2348-a933-7fdc-527e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5542-d0f8-2146-f552" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="b52c-c68e-3bae-d4d2" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="El cuerno de Kygor" id="86e4-2c82-64fb-bbdb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al inicio de cualquiera de tus turnos. Cuando se activa, todas las Bestias, Bestias monstruosas, Monstruos y Enjambres amigas, así como todas las monturas amigas a 24” o menos del portador obtienen la regla especial Furia asesina hasta el final del turno de jugador en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Reliquias. Hombres lagarto" id="459e-b903-636e-ec2c" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="02b7-f80e-a2ae-561b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="57a9-9414-8fbf-4abd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Amuleto de Xapati" id="5fde-9013-2ce1-94f7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ed8e-41d7-82de-662f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4a39-6e8f-431f-095c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="05f0-90cd-57cd-78d1" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Resistencia a la magia (3)" id="ab4f-996c-ae1d-1e9a" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Amuleto de Xapati" id="6bb9-19fb-781c-5668" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a su portador la regla especial Resistencia mágica (3). Si un hechizo es dispersado utilizando los dados proporcionados por esta Resistencia mágica, el hechicero que lo lanzó sufrirá inmediatamente un número de heridas automáticas igual al resultado de la tirada de 1D6 menos su nivel de magia, sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cubo de oscuridad" id="dd2c-cd30-a5d4-f30e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="66ed-6bc5-27c1-cfbf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="58f7-d5be-db88-5adb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="1f99-83f2-e36b-e612" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Cubo de oscuridad" id="369b-81bd-820e-004e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Puedes utilizar el Cubo de oscuridad en el momento que uno de tus oponentes lanzase con éxito uno de sus hechizos. El hechizo será dispersado automáticamente (siempre y cuando no haya sido lanzado con Fuerza irresistible). Además, efectúa una tirada de 1D6: con un resultado de 4+, la fase de magia concluirá de inmediato.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Huevo de Quango" id="5713-0274-ab7b-9e13" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e6d3-68c4-da8e-b1da" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ac40-e47a-24b5-3f01" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="4417-63e6-86be-25f2" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Huevo de Quango" id="7b53-6b85-475e-aac9" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El portador puede utilizar el Huevo de Quango al inicio de cualquier fase de magia propia. Tira 1D6 en la siguiente tabla para determinar qué ocurre:
1-2: Todas las unidades enemigas a 12” o menos sufren 1D6 impactos de Fuerza 4 con la regla especial Ataque de rayos, los cuales aumentan a Fuerza 5 contra miniaturas con las claves demonios o no muertos.
3-5:Todas las unidades enemigas a 12” o menos sufren 2D6 impactos de Fuerza 4 con la regla especial Ataque de rayos, los cuales aumentan a Fuerza 5 contra miniaturas con las claves demonios o no muertos. Hasta el final de la fase de magia, el lanzador obtiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos.
6:Todas las unidades enemigas a 12” o menos sufren 2D6 impactos de Fuerza 6 con la regla especial Ataque de rayos, los cuales aumentan a Fuerza 7 contra miniaturas con las claves demonios o no muertos. Hasta el final de la fase de magia, el lanzador obtiene 
un bonificador de +2 a sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Placa sagrada del señor Tlaco" id="a0f2-4063-d218-9ff3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5537-1faa-9145-8910" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c803-e88f-947a-4280" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="a5b1-6782-ccc7-e19f" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Archienemigo" id="09d4-3732-b06f-fee7" hidden="false" targetId="837a-4a9a-7d71-e8fe" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Placa sagrada del señor Tlaco" id="bf34-0b99-b0fb-c359" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de la batalla, tras el despliegue, designa un personaje enemigo: el oponente deberá revelar todos los objetos mágicos y opciones de equipo del personaje elegido; el portador de la tablilla obtiene la regla especial Archienemigo (el personaje elegido). Adicionalmente, el portador podrá repetir todas las tiradas para herir fallidas con sus hechizos contra el personaje elegido.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Hombres lagarto" id="e0be-7b80-52f1-3cef" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e14c-6b84-f5e6-bfd0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="4ceb-a307-5ce4-3192" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Diadema de poder" id="239a-5afe-5f22-b05e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3815-85fa-eff8-743d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="915d-7275-6a29-3763" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia a la magia (1)" id="9b23-58b6-3615-9a80" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Diadema de poder" id="d2cf-4111-7d13-6f95" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene la regla especial Resistencia mágica (1). Al final de cada fase de magia puedes guardar hasta dos de los dados no utilizados, que podrás utilizar en una fase de magia posterior (ya sea como dados de Energía o de Dispersión).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de la maldición de Tepok" id="b8b0-ee5c-5f0a-dba3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1bc5-b39b-9f67-94c3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="21f7-deb0-bf60-a214" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de la maldición de Tepok" id="d65c-10f7-a8ad-5233" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Puede utilizarse cuando un hechicero enemigo sufra una disfunción mágica, obligándole a repetir la tirada que obtuvo en esa tabla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Larvas de Itxi" id="d558-0ea3-9717-aab3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e5be-4ed2-d0a3-afd9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="db76-3c61-6757-6f06" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Larvas de Itxi" id="9400-2078-bc19-4d11" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Puede utilizarse tras lanzar un hechizo (exitosamente o no), pero antes de que el oponente realice su intento de dispersión. Aumenta en +4 el valor de lanzamiento del hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Hombres lagarto" id="9ac4-f12b-668b-4a73" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e5a9-c06c-0df4-5b47" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="46b5-9c8f-b13c-8199" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Tótem de las profecías" id="e3b6-8191-7f95-7323" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1e81-6272-1d99-91a2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="81e6-ab09-3b04-eba2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="70"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="8195-33a5-7c50-aa99" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Inmune a psicología" id="f082-1d34-1637-7e2a" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Tótem de las profecías" id="ef13-cad2-e7b0-0084" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades aliadas a 12” o menos del portador del Tótem podrán repetir los resultados naturales de 1 obtenidos en sus tiradas para impactar y herir tanto en combate cuerpo a cuerpo como con proyectiles. El portador del Tótem y la unidad de la que forme parte obtendrán la Regla Especial Inmunes a Psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Hombres lagarto" id="8a19-a3ad-7f09-de11" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="6b24-5617-e8da-5c12" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
        <constraint id="449c-c162-52e2-431d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte del Sol de Chotek" id="56d5-c5bb-09c0-d557" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="1dcb-0db7-5148-6937" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ae59-eadd-6973-571d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte del sol de Sotek" id="8add-5d3b-65cd-5d33" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los disparos enemigos dirigidos contra el portador y la unidad en la que se encuentre este estandarte deberán aplicar un penalizador de -1 a sus tiradas para impactar. La unidad no podrá ser afectada por hechizos del Saber de las Sombras, ya fuesen lanzados por aliados o enemigos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del jaguar" id="5dd8-d467-4ad9-133d" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="95be-658f-622c-ecc6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e724-5427-0109-8845" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Veloz" id="8e94-3531-2b0b-f0e1" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del jaguar" id="fbee-bd71-563b-1d2c" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Otorga al portador y a la unidad que lo acompañe la regla especial Veloz y un bonificador de +1 a su atributo de movimiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de piel de skaven" id="8f89-1ed2-fa56-7789" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="c91d-b36b-8b17-6b57" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1b53-373c-417d-3ba6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Miedo" id="a019-68c8-79fa-28b0" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
            <infoLink name="Odio" id="80df-5b9d-8796-170d" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Skavens)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de piel de skaven" id="f517-6c3b-efd8-4fff" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Las miniaturas de la unidad obtienen la regla especial Odio (skavens) y causan Miedo a skavens. Sin embargo, los skavens obtendrán la regla especial Odio contra las miniaturas que formen parte de la unidad que lo porta.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tótem sagrado de Huanchi" id="7ac3-5f81-ddd9-7962" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e2e2-eeec-aa36-c419" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b157-e0e2-9714-b296" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tótem sagrado de Huanchi" id="eb6f-2381-4126-ccd6" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un solo uso. Objeto portahechizos. Nivel de energía 6. Contiene el hechizo Puente de sombras del Saber de las Sombras. Solamente podrá afectar al portador y su unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Generaciones" id="2d5c-4069-916b-f22e" collective="false" defaultSelectionEntryId="5d11-fe73-bf96-8c34" hidden="false" import="true">
      <constraints>
        <constraint id="7639-90b0-1d6d-5e76" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="9b6c-e6e6-6407-da16" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="5ª generación" id="5d11-fe73-bf96-8c34" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="386b-907e-39d7-089e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <rules>
            <rule name="Quinta generación" id="b710-2f78-5cb1-0f60" hidden="false">
              <description>Los Magos-sacerdote slann de Quinta generación siempre suman +1 a sus tiradas en la tabla de Disfunciones mágicas (cualquier resultado superior a 12 se considera 12) y tendrán éxito en sus tiradas para Canalizar con un resultado de 4+.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="4ª generación" id="19e5-1c2b-955d-5d2a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e813-f0fb-8f7c-fb1b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="91be-f82a-eedc-8b9a" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Alta o 8 básicos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <rules>
            <rule name="Cuarta generación" id="5a07-5bd8-6777-192f" hidden="false">
              <description>Los Magos-sacerdote slann de Cuarta generación siempre suman +2 a sus tiradas en la tabla de Disfunciones mágicas (cualquier resultado superior a 12 se considera 12) y tendrán éxito en sus tiradas para Canalizar con un resultado de 3+. Además, podrán elegir hasta dos Artefactos arcanos en lugar de sólo uno y obtienen la regla especial Señor del conocimiento, a elegir entre Alta Magia o uno de los ocho saberes básicos.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="3ª generación" id="5f00-a368-df9a-4530" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="770a-671d-efc2-77d0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="110"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Leyenda" id="eb4e-be5b-f2dd-5c01" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="aefd-b8be-5cc8-0349" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Dos entre, Alta o 8 básicos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <rules>
            <rule name="Tercera generación" id="f023-709a-6ce4-a2b6" hidden="false">
              <description>Los Magos-sacerdote slann de Tercera generación siempre suman +3 a sus tiradas en la tabla de Disfunciones mágicas (cualquier resultado superior a 12 se considera 12) y tendrán éxito en sus tiradas para Canalizar con un resultado de 2+. Podrá elegir hasta tres Artefactos arcanos en lugar de sólo uno. Además, hasta dos de sus objetos mágicos podrán ser Reliquias. Además, los Magos-sacerdote slann de la Tercera generación obtienen la regla especial Leyenda y Señor del conocimiento dos veces, a elegir entre Alta Magia o los ocho saberes básicos</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="2ª generación" id="4e19-5a8b-217e-f3fb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9d57-0483-15cf-e5c9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="175"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Leyenda" id="3b17-c9cf-480b-9f33" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="e3a5-24da-d16a-18d6" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Dos entre, Alta o 8 básicos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <rules>
            <rule name="Segunda generación" id="b7b8-7d46-0159-8480" hidden="false">
              <description>Los Magos-sacerdote slann de Segunda generación siempre suman +4 a sus tiradas en la tabla de Disfunciones mágicas (cualquier resultado superior a 12 se considera 12) y Canalizan dados de Energía y Dispersión de forma automática. Además, podrá elegir hasta tres Artefactos arcanos en lugar de sólo uno y todos sus objetos mágicos podrán ser Reliquias. Los Magos-sacerdote slann de la Segunda generación tienen las reglas especiales Leyenda, Inmune a psicología y Señor del conocimiento dos veces, a elegir entre Alta Magia o los ocho saberes básicos. Adicionalmente, pueden repetir un dado de Energía o Dispersión en cada uno de sus intentos de lanzamiento y dispersión de hechizos y tienen un nivel de magia 5.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
