        <infoLink name="Infantería" id="fba1-6e76-ae11-622c" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Cruzar (elementos acuáticos)" id="c10e-37ad-284d-ed18" hidden="false" targetId="b7d4-b324-49ee-71ae" type="rule"/>
        <infoLink name="Ataques envenenados" id="2396-82a8-44c1-818c" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink name="Señor del conocimiento" id="4e16-8768-cb17-cba4" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Cielos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Tetto´eko" id="1fd9-a7b8-7890-5980" hidden="false">
          <description>Tetto&apos;Eko es un hechicero de nivel 3 que siempre conoce todos los hechizos del Saber de los Cielos.</description>
        </rule>
        <rule name="Favorito de los magos sacerdote" id="8550-ba84-b1d3-d9c8" hidden="false">
          <description>Si Tetto&apos;Eko se encuentra unido a una unidad de Guardia del templo, tanto Tetto&apos;Eko como la unidad obtendrán la regla especial Tozudez.</description>
        </rule>
        <rule name="Oráculo celestial" id="6d39-9147-f932-0300" hidden="false">
          <description>Tetto&apos;eko conoce el hechizo “Tempestad de Cassandora” del Saber de los Cielos (pese a que normalmente su nivel de magia no se lo permitiría) y puede lanzarlo hasta dos veces por fase de magia. Este efecto no permite volver a intentar lanzar un hechizo cuando el intento previo fue fallido.</description>
        </rule>
        <rule name="Defensa de los ancestrales" id="2951-0079-3b01-72eb" hidden="false">
          <description>Tetto&apos;eko tiene una tirada de salvación especial de 5+ (la cual aumenta a 4+ al ir montado en un Trono de piedra).</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Tetto´eko" id="4058-91af-71a2-a7e8" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="e6aa-a93b-6530-2b5a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="079f-9653-844d-0e17" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="300"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
