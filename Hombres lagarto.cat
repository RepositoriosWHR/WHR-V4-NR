                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Kroak puede repetir, si lo desea, la tirada de los Vientos de la Magia en sus fases de magia propias.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Placa del apocalipsis" id="0f60-c17f-855c-632a" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="0bf4-3f80-c2cd-6d8a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="5156-e7fe-127a-2ef8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
                  <costs>
                    <cost name="pts" typeId="points" value="0"/>
                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <profiles>
                    <profile name="Placa del apocalipsis" id="2f5f-9f0d-765c-529b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo tres usos. Objeto portahechizos. Nivel de energía 25. Se trata de un hechizo de Maldición que puede lanzarse sobre una unidad enemiga a 30” o menos de Kroak. Si el hechizo se resuelve con éxito, retira inmediatamente como baja todas las miniaturas de dicha unidad. Los Grandes demonios exaltados y los hechiceros de nivel 5 o superior son inmunes a este efecto, así como cualquier miniatura o unidad que tenga un objeto mágico que no pueda ser destruido o anulado.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
