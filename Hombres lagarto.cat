    <selectionEntry name="Mago-Sacerdote Slann" id="4d55-bde7-cd56-aa30" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="ea3d-a989-d817-f62e" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="067b-ba31-cc45-4cf7" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <costs>
