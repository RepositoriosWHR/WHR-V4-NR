          <profiles>
            <profile name="Desove sagrado de Xoloc" id="e973-a9c6-5f42-3c02" hidden="false" typeId="9ec5-91ab-c1bc-3ae5" typeName="Desove">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0e88-2445-1583-881a">Las miniaturas pertenecientes a este desove ignoran el penalizador de -1 para impactar con proyectiles por larga distancia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Marca sagrada de los ancestrales" id="374e-8085-08c9-8f98" collective="false" hidden="false" import="true" type="upgrade">
