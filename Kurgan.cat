      <rules>
        <rule name="Renombre oscuro" id="3d18-c45a-7799-8635" hidden="false">
          <description>Asavar Kul debe ser obligatoriamente el general del ejército; además, su Presencia inspiradora tiene un alcance de 18” en lugar de las 12” habituales.</description>
        </rule>
        <rule name="Guerreros benditos Kul" id="5629-005a-bb7e-d442" hidden="false">
          <description>La unidad de Guerreros consagrados Kurgan que debes incluir si incluyes a Asaver Kul debe portar las Marcas de Khorne, Slaanesh, Nurgle y Tzeentch.</description>
        </rule>
      </rules>
