              <infoLinks>
                <infoLink name="Inmune a la psicología" id="ec0a-4450-0e17-fef4" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink name="Poder de penetración" id="edc3-1ae6-b456-1c43" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Sangre fría" id="0d1e-d088-a3c6-b498" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="57d6-7071-74d9-0ce2" collective="false" hidden="false" import="true" targetId="0cbb-1c3a-5e70-7f3b" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="05f0-fe5d-cd7f-e0b8" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Señor de la guerra Kurgan" id="3fc3-a197-06ec-ecab" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial (6+, o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Caos absoluto. Personajes" id="955c-fc95-caf2-e225" collective="false" hidden="false" import="true" targetId="f4e7-b253-934f-81e7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="aef2-f9fc-20d2-9ba2" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Caos absoluto. Señor de la guerra Kurgan" id="58ce-1e3f-f926-6ec8" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
