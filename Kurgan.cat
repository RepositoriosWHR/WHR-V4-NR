            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma emparejadas" id="3c04-a845-c7ce-04e0" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Hachas del campeón" id="99d9-f4d5-a96a-a3bb" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Proporcionan a su portador un bonificador de +1 a su Iniciativa en combate cuerpo a cuerpo. Si está combatiendo en un desafío, el portador puede repetir sus tiradas para impactar y herir en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
