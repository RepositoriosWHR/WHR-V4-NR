            <entryLink name="Marca de Slaanesh. Unidades" id="691d-87fa-6a93-c20a" collective="false" hidden="false" import="true" targetId="b4f5-abca-1828-c275" type="selectionEntry">
              <infoLinks>
                <infoLink name="Poder de penetración" id="b30c-2c84-ab3b-916e" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
