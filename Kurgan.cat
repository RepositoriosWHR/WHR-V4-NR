              <profiles>
                <profile name="Armadura negra del caos" id="5069-8799-d617-f08f" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. Proporciona a Asavar un bonificador de +3 a su tirada de salvación por armadura (totalizando 1+); además, todos los impactos que no tengan la regla Ataques mágicos tendrán un penalizador de -1 en sus tiradas para herir contra Asavar Kul.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
