              <rules>
                <rule name="Marca de Nurgle. Señor de la guerra Kurgan" id="b898-dad3-83ed-82d4" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="e3f6-61ff-4821-4e98" collective="false" hidden="false" import="true" targetId="2130-8db6-f7dc-8c82" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="bec5-6052-dca4-8261" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink name="Poder de penetración" id="cc4f-1c33-8883-db50" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Sangre fría" id="5163-b962-38a3-a636" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="71b4-5373-fc78-4f33" collective="false" hidden="false" import="true" targetId="0cbb-1c3a-5e70-7f3b" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="9c46-7fc2-ed51-6df7" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="a8b8-2cbe-81c3-fe95" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Señor de la guerra Kurgan" id="8ce4-28d4-0cb1-0cb9" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Caos absoluto. Personajes" id="3772-3351-95f0-dd97" collective="false" hidden="false" import="true" targetId="f4e7-b253-934f-81e7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="9da6-6ea9-12b8-9877" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Caos absoluto. Señor de la guerra Kurgan" id="e7aa-f2ad-b4e7-2d5e" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
