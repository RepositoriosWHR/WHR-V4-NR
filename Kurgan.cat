          <rules>
            <rule name="Marca de Nurgle Asavar Kul" id="da8e-9cbe-2d5e-6fb4" hidden="false">
              <description>La Marca de Nurgle hace que todos los disparos contra Asavar y su unidad tengan un penalizador de -1 en sus tirada para impactar, y todos los ataques en combate cuerpo a cuerpo contra Asavar tendrán un penalizador de -1 en su tirada para impactar</description>
            </rule>
          </rules>
        </entryLink>
