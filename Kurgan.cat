    <selectionEntry name="Los merodeadores" id="e4f8-1810-c53a-c733" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="46c3-5f69-824d-37fd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="aaba-2010-3f04-0729" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Los merodeadores" id="caa0-278a-1ad9-d47a" hidden="false">
          <description>Los Merodeadores son Inmunes a fuego. Al inicio de la batalla, tras el despliegue, tira 1D6 en la siguiente tabla y aplica el resultado a Volrik y a su unidad durante la batalla.
1D6 	Bendición de los Merodeadores
1 	Causan Miedo.
2 	Obtienen la regla especial Resistencia mágica (2).
3 	Obtienen las reglas especiales Inmunes a la psicología e Impasibles.
4 	Obtienen la regla especial Piel escamosa (6+).
5 	Obtienen un bonificador de +1 a su atributo de Fuerza.
6 	Obtienen una tirada de salvación especial de 5+.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="La Tribu del Cuervo" id="0f34-a5e2-4480-513e" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="c355-2a82-ba67-7e99" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
