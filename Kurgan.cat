              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="7a07-2681-c3d9-fdc3" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Señor de la guerra Kurgan" id="76fc-5573-2cf9-b6ed" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="0fc3-708e-6a98-1314" collective="false" hidden="false" import="true" targetId="2130-8db6-f7dc-8c82" type="selectionEntry">
