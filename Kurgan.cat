          <entryLinks>
            <entryLink name="Marca de Nurgle. Personajes" id="e445-b386-d34c-98d1" collective="false" hidden="false" import="true" targetId="cf15-f28c-0689-515e" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="e645-8c2b-b496-5d65" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Señor de la guerra Kurgan" id="51a6-5be9-1692-1975" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="4c94-c8a7-45b5-d3e7" collective="false" hidden="false" import="true" targetId="2130-8db6-f7dc-8c82" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="193e-b090-b730-908c" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink name="Poder de penetración" id="2ae5-e0ff-ca57-7f28" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Sangre fría" id="967f-bdab-7e4b-d962" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="fecc-2f98-682e-a6e5" collective="false" hidden="false" import="true" targetId="0cbb-1c3a-5e70-7f3b" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="ff24-408b-85d6-26ff" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Señor de la guerra Kurgan" id="a129-36b3-6492-5a70" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial (6+, o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Caos absoluto. Personajes" id="b3e6-273d-df39-55dd" collective="false" hidden="false" import="true" targetId="f4e7-b253-934f-81e7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="ba62-ce59-b122-56ff" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Caos absoluto. Señor de la guerra Kurgan" id="d1fd-0f6e-e295-b25f" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
