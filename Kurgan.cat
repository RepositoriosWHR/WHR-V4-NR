                <infoLink name="Poder de penetración" id="2316-3a79-bc56-671a" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Sangre fría" id="13f4-c1e8-1da3-7edc" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
