        <constraint id="e71d-e08e-b30b-5c4d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="033f-a640-8dbd-3b1a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Martillo rúnica del Caos" id="0142-9585-40ad-950f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e807-449e-371e-fcf3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="083c-6844-a358-ee75" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="6740-0f0d-2328-e529" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Martillo rúnica del Caos" id="25a2-05ad-d8e5-3a8f" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al luchar con este arma el portador obtiene +1 a su Habilidad de Armas y +1 Ataque. Los impactos con este arma se resuelven con +1 a su Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espada gelida de las estepas" id="12b4-776d-c7b3-424a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9fe4-1076-ce55-152f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ac63-24bf-b607-0870" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="ea93-bdef-ea70-c078" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Aura de frio" id="45f3-f79a-5d90-876a" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
            <infoLink name="Inmune al fuego" id="fe34-c1bd-2ca2-9218" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Espada gelida de las estepas" id="7305-24c5-c3d9-5af3" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques realizados con la Espada gélida de las estepas se resuelven con +1 Fuerza. Además, proporciona a su portador las reglas especiales Aura de frío e Inmune a fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
