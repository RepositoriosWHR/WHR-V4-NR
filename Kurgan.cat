          <rules>
            <rule name="Marca de Tzeentch Asavar Kul" id="ca34-87f3-c92f-ec20" hidden="false">
              <description>La Marca de Tzeentch le proporciona un bonificador de +1 a su tirada de salvación especial y la regla especial Ataques flamígeros.</description>
