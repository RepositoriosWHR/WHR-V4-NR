            <entryLink name="Marca de Nurgle. Personajes" id="3163-5716-a332-e1bc" collective="false" hidden="false" import="true" targetId="cf15-f28c-0689-515e" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="ae5a-5f1e-727a-b488" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Señor de la guerra Kurgan" id="3f63-afa6-61f3-51f5" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="502c-65c0-a74f-fa54" collective="false" hidden="false" import="true" targetId="2130-8db6-f7dc-8c82" type="selectionEntry">
              <costs>
