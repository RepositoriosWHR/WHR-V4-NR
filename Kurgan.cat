                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Arma de mano" id="3e2c-7f5d-9b6b-8e30" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
                <infoLink name="Arma de mano adicional" id="d306-69c8-5783-e109" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink name="Golpe letal" id="5c9a-947d-9b64-283a" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Desmembradora y Decapitador" id="e953-10e2-cfff-b29d" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas (Asavar realiza un total de 6 Ataques con estas armas). Cada vez que Asavar vaya a atacar debe repartir sus seis ataques como desee entre ambas armas, aunque debe realizar al menos un ataque con cada una de ellas. Los impactos con Desmembradora se resuelven con +1F y no permiten tirada de salvación por armadura, y los impactos con Decapitador se resuelven con +1F y la regla especial Golpe letal.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura negra del caos" id="3a9b-304b-4063-2153" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1edb-2b46-3297-08f0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="ea39-4e0f-d9cf-f870" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
