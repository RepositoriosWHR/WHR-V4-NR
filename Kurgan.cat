    <selectionEntryGroup name="Armas mágicas. Kurgan. Armas emparejadas" id="cf12-bb88-3dd3-a4df" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4a0b-330e-b16a-3e36" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="fd1d-c1aa-ab13-aae5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Hachas del campeón" id="bf3c-8dda-a220-ec84" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a357-0d7c-10b6-1752" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7a6b-d4d7-458b-25a6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
