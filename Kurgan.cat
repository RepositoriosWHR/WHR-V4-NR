          <profiles>
            <profile name="Maestro de la hechicería" id="c4d1-0d2d-e874-33fb" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Sólo hechiceros. El personaje conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Destino de Tzeentch" id="b81a-e8fe-991e-9937" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="812e-e9db-1e1c-3b0a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c757-5a05-d1bc-873e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Destino de Tzeentch" id="3e95-33cb-1838-1b98" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Sólo hechiceros. El personaje puede repetir sus tiradas en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Don del cambio" id="d61f-0229-b479-f26b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c553-f64b-c8b4-42e0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d4c9-819a-fec2-a62b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Recompensa Mayor" id="b067-074e-7f53-dd63" collective="false" hidden="false" import="true" targetId="1e00-b3e9-2eaf-bcf7" type="selectionEntry"/>
          </entryLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="and">
                  <conditions>
                    <condition childId="7225-fa3e-f95d-5111" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                    <condition childId="32db-5303-87ba-c616" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="ancestor" shared="true" type="notInstanceOf" value="0"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Don del cambio" id="7723-4181-93c6-dd12" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Sólo hechiceros. Un sólo uso. Puede utilizarse durante cualquier fase de magia propia para lanzar un hechizo (incluso uno potenciado) sin invertir dados de Energía. El hechizo será lanzado con Fuerza irresistible; tras resolver el hechizo, el hechicero debe realizar una tirada en la tabla de Disfunciones mágicas, aunque tirará con 1D6+6 en lugar del habitual 2D6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Reliquias. Kurgan. Arma a dos manos" id="a6a9-d170-8669-98ad" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="1f38-ca39-48a3-f743" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="db48-5a86-7b0f-0315" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
