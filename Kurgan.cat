                <profile name="Bastón negro" id="5544-abf4-a1e0-4623" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Talenchar conoce 1D3+3 hechizos adicionales. Además, puede guardar en el bastón un dado de energía o dispersión al final de cada fase de magia para utilizarlo en una fase de magia posterior.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
