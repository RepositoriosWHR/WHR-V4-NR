            <profile name="Putrefacción de Nurgle" id="9da7-ac8d-f4b8-773a" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Al inicio de cada ronda de combate cuerpo a cuerpo, todas las miniaturas (amigas y enemigas) que no tengan la Marca de Nurgle (o sean Demonios de Nurgle o skaven del Clan Pestilens) en contacto con el personaje sufrirán una herida sin tirada de salvación con armadura con un resultado de 6 en 1D6 (tira por cada miniatura en contacto).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Carcasa decadente" id="3ec8-2116-ca1d-fcf4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f69e-cfac-96a8-f873" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d215-75b0-6ccc-2f42" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="6c4b-a143-cef3-f118" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink name="Inmune al veneno" id="a426-a5c1-5b36-0c81" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Carcasa decadente" id="95ca-a8fd-6b68-59ad" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">El personaje obtiene las reglas especiales Inmune a veneno y Ataques envenenados; los resultados de 5 natural al impactar se considerarán Ataques envenenados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vitalidad de Nurgle" id="e7c3-19c7-087b-cc70" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cd89-9365-23ab-596c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5435-8e2f-8178-c792" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vitalidad de Nurgle" id="1c1d-6446-1c3b-7fd4" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Al inicio de cada uno de tus turnos, el personaje recupera una de las heridas que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Recompensas del caos. Tzeentch" id="6bae-aac3-5772-8253" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Ojo de Tzeentch" id="ebe8-0c63-5f81-7f4f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0476-7a66-9d10-e95b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8d43-ce40-15ad-6eb6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ojo de Tzeentch" id="4f5f-78c3-7f45-1b3a" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">El personaje podrá repetir todas sus tiradas fallidas para impactar, tanto en combate cuerpo a cuerpo como con proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Voluntad de Tzeentch" id="0694-31d0-63f0-9ac0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="595c-ead1-a98f-6ee2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5763-2098-dc23-0e4c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Voluntad de Tzeentch" id="2699-4188-9dbe-ab75" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">El personaje genera un dado de Energía adicional en cada fase de magia propia, que puede ser utilizado por cualquier personaje con la Marca de Tzeentch.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fortuna de Tzeentch" id="71a4-9af8-898c-64bd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c1b0-3460-5b62-de98" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7aa8-c97c-95e8-6872" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Fortuna de Tzeentch" id="fbcb-4144-b1f3-2aa0" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Una vez por turno de jugador, el personaje puede repetir una tirada de 1D6. Puede ser una tirada para impactar, herir, salvación (por armadura o especial), Regeneración o un chequeo de atributo (excepto de Liderazgo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sanguijuela arcana" id="d3ea-f30c-35ca-d44a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7c62-d23e-ab25-6d9e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d906-9c8a-ab2b-40b0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sanguijuela arcana" id="4ebd-5a2b-e21d-a270" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Por cada herida causada en combate cuerpo a cuerpo por el personaje tira 1D6; con un resultado de 5+, podrás añadir un dado de Energía o Dispersión durante la próxima fase de magia (según corresponda).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Aura mágica de Tzeentch" id="10d8-01df-c833-3455" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a516-7711-f9f8-fcb5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b716-3421-b2bd-839d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Aura mágica de Tzeentch" id="a934-fd49-cb8a-cff2" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Sólo miniaturas con la Marca de Tzeentch. El personaje obtiene una tirada de salvación especial de 6+ y la regla especial Resistencia mágica (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Recompensas del caos. Tzeentch. Hechiceros" id="8c7c-0066-c2e2-e721" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Maestro de la hechicería" id="fa66-f3af-2331-c0dc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
