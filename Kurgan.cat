                <profile name="Marca del ungido" id="8bc3-2f36-91b4-c014" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">La Marca del Ungido hace que Asavar Kul cause Terror y sea Indesmoralizable. La unidad de Guerreros benditos Kul también será Indesmoralizable mientras Asaver Kul siga con vida.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Recompensas del Caos" id="06a0-f197-5277-f786" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Señal de los Dioses" id="e629-c378-1ac3-1771" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1788-e71f-d2c5-882f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="3492-3192-8438-b5c9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Señal de los Dioses" id="7b1b-236f-2b53-398c" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Si Asavar obtiene un resultado de 2, 3 o 12 en la tabla del Ojo de los Dioses, en lugar de aplicar el efecto descrito, puedes elegir cualquier otro resultado de la tabla y aplicarlo a Asavar Kul. Además, Asavar tiene una tirada de salvación especial de 5+ (que se incrementa a 4+ por la Marca de Tzeentch).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="[E] - Conde Mordrek, el condenado" id="2327-2154-608b-8f74" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="9de9-a1ef-af58-93fe" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
