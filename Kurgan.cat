            <entryLink name="Marca de Tzeentch. Personajes" id="cfe7-457e-02a5-f899" collective="false" hidden="false" import="true" targetId="0cbb-1c3a-5e70-7f3b" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="6bf7-d355-c4af-d2d2" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="fd1a-91a9-0df0-d145" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Señor de la guerra Kurgan" id="d266-daec-aba9-3d93" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Caos absoluto. Personajes" id="7c9b-9d4f-a993-d9cb" collective="false" hidden="false" import="true" targetId="f4e7-b253-934f-81e7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="7fc6-0c66-c78f-8971" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Caos absoluto. Señor de la guerra Kurgan" id="a981-05fe-0aa5-dfac" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
