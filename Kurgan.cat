          <entryLinks>
            <entryLink name="Marca de Caos absoluto. Unidades" id="d4f8-4d62-7213-4ce5" collective="false" hidden="false" import="true" targetId="cf4d-6b71-a4c4-c958" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <rules>
                <rule name="Marca de Caos absoluto catapulta de asedio kurgan" id="4179-1cf6-3bf2-60ae" hidden="false">
                  <description>Se trata de un disparo normal de catapulta con la regla especial Ataques mágicos; los chequeos de pánico provocados por la catapulta deberán efectuarse con 3D6 y descartando el resultado menor.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="d33e-1e68-f732-caa6" collective="false" hidden="false" import="true" targetId="aba0-1add-f8e6-6168" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <rules>
                <rule name="Marca de Nurgle catapulta de asedio kurgan" id="d327-6e64-6430-e713" hidden="false">
                  <description>Utiliza la plantilla redonda grande, y se resuelve con F2 y no permite tirada de salvación por armadura (no tiene impacto central diferenciado).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="b565-54e0-6f95-cd1a" collective="false" hidden="false" import="true" targetId="b4f5-abca-1828-c275" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <rules>
                <rule name="Marca de Slaanesh catapulta de asedio kurgan" id="dc9d-c26a-f5a3-5e9c" hidden="false">
                  <description>Utiliza la plantilla redonda pequeña, y se resuelve con F4 y la regla especial Golpe letal (F6, Golpe letal y Heridas múltiples 1D3 el impacto central).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Unidades" id="b7ed-8d93-7cac-f3c8" collective="false" hidden="false" import="true" targetId="9368-30c0-5c4e-baa3" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <rules>
                <rule name="Marca de Tzeentch catapulta de asedio kurgan" id="e0e9-f18c-236d-c81a" hidden="false">
                  <description>Utiliza la plantilla redonda grande, y se resuelve con F1D6, Ataques flamígeros y Poder de penetración (no tiene impacto central diferenciado).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="194d-13ca-69ce-4b99" collective="false" hidden="false" import="true" targetId="41a6-d18a-1460-aabc" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <rules>
                <rule name="Marca de Khorne catapulta de asedio kurgan" id="1f27-1e2f-93b9-c22d" hidden="false">
                  <description>Utiliza la plantilla redonda pequeña, y se resuelve con F5 (F10 y Heridas múltiples [1D6] el impacto central).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
