      <entryLinks>
        <entryLink name="Marca de Tzeentch. Personajes" id="2481-03a0-32c4-8618" collective="false" hidden="false" import="true" targetId="0cbb-1c3a-5e70-7f3b" type="selectionEntry">
          <constraints>
            <constraint id="92c1-c468-1492-82db" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="0aa6-f07b-1fb8-0901" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Talenchar" id="9966-201a-5fd2-a06c" hidden="false">
              <description>Le proporciona la regla especial Ataques flamígeros y una 
tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de 
lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="3b68-5fa8-b7dd-f486" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="La voluntad del caos" id="edba-8e9d-2b4f-d4e6" hidden="false" targetId="56e3-cc6c-c4a6-3373" type="rule"/>
        <infoLink name="Ojo de los dioses" id="7795-b751-1f2c-e916" hidden="false" targetId="f5d0-891d-c44d-7574" type="rule"/>
        <infoLink name="Ataques envenenados" id="0448-59f0-a784-fb16" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Talenchar" id="8283-7398-8e0b-eaa7" hidden="false">
          <description>Talenchar es un hechicero de nivel 4 que puede elegir sus hechizos de entre los saberes de los Cielos, Magia Oscura y el Saber de Tzeentch.</description>
        </rule>
        <rule name="Maestro envenenador" id="9f9c-ff68-10c3-177a" hidden="false">
          <description>Al inicio de la batalla, tras el despliegue, puedes elegir una de tus unidades de infantería o caballería con la Marca de Tzeencth: esa unidad obtiene la regla especial Ataques envenenados.</description>
        </rule>
      </rules>
