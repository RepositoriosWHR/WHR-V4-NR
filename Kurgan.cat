          </infoLinks>
          <profiles>
            <profile name="Collar de Khorne" id="aa94-bb2c-6c61-554c" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la Marca de Khorne. Proporciona una tirada de salvación especial de 5+ y Resistencia mágica (3) .</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Kurgan. Tzeentch" id="3804-dd64-8fe8-aeba" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="589a-5b34-baea-4869" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="6510-6a0e-4578-2445" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pluma del gran águila" id="19ed-0a33-e958-27bc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="319b-3ce0-6e39-0068" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="93bf-18a4-c605-c778" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pluma del gran águila" id="8a7d-ed7e-a643-d065" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la marca de Tzeentch. Al inicio de la batalla, tras el despliegue, tira 1D6 para determinar el efecto de la Pluma durante la batalla. Con un resultado de 1, la Pluma no tiene ningún efecto; con un resultado de 2-3, proporciona una tirada de salvación especial de 6+; con un resultado de 4-5, proporciona una tirada de salvación especial de 5+; y con un resultado de 6, proporciona una tirada de salvación especial de 4+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Kurgan. Nurgle" id="b106-ed76-7117-5839" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="08ab-b386-3809-fe8f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="fa0a-3680-e666-96e9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Talismán bendito de Plaga" id="7540-57b5-78a3-08d5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3322-db57-6a67-f6c2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cfe7-3793-57d6-a9b5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (6+)" id="b6e5-4a79-a8f0-4d37" hidden="false" targetId="4aee-7485-a141-cd20" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Talismán bendito de Plaga" id="dc86-e502-95a0-0101" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la marca de Nurgle. Proporciona a su portador la regla especial Regeneración (6+), o un +1 a su Regeneración si ya disponía de ella. Además, al inicio de cada uno de tus turnos, el portador recupera una herida que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Kurgan" id="7d5c-7d3b-5728-d1cd" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="78ee-cf73-ee62-c67d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="8032-9cd1-9fb2-f07f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Tatuajes impíos" id="0f17-185e-5a13-8e9f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5dfc-db79-aa1c-0520" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a96e-4ff2-ab38-16e9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Aura demoníaca (4+)" id="c466-0832-aff1-b378" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Tatuajes impíos" id="faa1-0d9b-62e0-5bbf" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene la regla especial Aura demoníaca (4+). Sin embargo, se verá afectado por aquellos objetos mágicos, hechizos o reglas especiales que afecten especialmente a demonios o lo hagan de forma aumentada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Kurgan" id="4344-6e22-c9f6-7e45" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="b174-677d-db10-4a7e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7d9a-7de2-b96d-a27f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Familiar del Caos" id="75b9-2e98-ff26-cfb6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="44be-c9d0-5aef-8151" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3941-12c7-c77a-9447" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Familiar del Caos" id="556c-d4f3-ce4e-13d6" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro de la gran bestia del norte" id="9b9f-37b6-3370-8780" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4b17-a0de-1251-f1be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8632-fc28-598d-6c48" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro de la gran bestia del norte" id="721d-c4ac-291a-7d9e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene el hechizo Forma salvaje de Wyssan, del Saber de las Bestias.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vara demoníaca" id="8e2b-e3f7-6df0-a3e4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="04f5-6943-5d1c-d2b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="effe-88ce-fd31-7d06" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vara demoníaca" id="4f70-bb1f-b9ff-4763" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador conoce un hechizo adicional; además, le proporciona un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Orbe de piedra divina" id="f749-254a-69f5-496e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="11f9-5132-38a1-4ff9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8273-3eb6-7caf-6065" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Orbe de piedra divina" id="5540-c7c5-a3ee-b336" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador vaya a lanzar un hechizo, puede elegir generar un dado de energía adicional (usa un dado de color diferente) y tirarlo junto a los dados que desee para lanzar ese hechizo (debe gastar por lo menos un dado). Sin embargo, si en el dado adicional obtiene un resultado de 1, el portador sufre una herida automática sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Kurgan. Tzeentch" id="4557-70f9-835c-e5c9" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="d6c6-0181-8e5b-8854" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="aad3-8777-b533-c669" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Máscara de la tribu del águila" id="a6d8-881c-2ac1-ddc1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fabe-9b0a-b28c-960b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2b62-18d4-5a1b-73ca" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Máscara de la tribu del águila" id="0c37-c931-208c-94b3" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la marca de Tzeentch. El portador causa Terror. Además, la máscara es un Objeto portahechizos con nivel de energía 1D6+1; contiene un hechizo de maldición que puede lanzarse sobre una unidad enemiga a 18” o menos del lanzador y permanece un turno. Por la duración del conjuro, el valor de Liderazgo de todos los miembros de la unidad se verá reducido a la mitad (redondeando hacia arriba), y no pueden hacer uso de Presencia inspiradora.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Kurgan" id="a51b-37b7-3368-dc4f" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="be14-e5ce-4096-28f4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="abdb-7318-8395-1583" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Brebaje berserker" id="29e0-8529-481d-94ff" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ac59-526f-f6a9-976a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ab8a-ebef-ca2c-4d28" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brebaje berserker" id="c060-a522-5838-4bfb" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al comienzo de cualquier fase de combate cuerpo a cuerpo. Hasta el final de la fase, el portador obtiene 1D6 Ataques adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Poción del Caos" id="bf1a-aee3-dabc-d76f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0501-698b-c268-7e7a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="aff5-521a-49d4-5758" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Estupidez" id="6e47-193f-5e6b-b6c9" hidden="false" targetId="eff6-2d64-db5e-d51e" type="rule"/>
            <infoLink name="Ataques flamígeros" id="2058-d6c0-bc55-9363" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Regeneración (4+)" id="0685-03fc-2725-8b11" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
            <infoLink name="Arma de aliento" id="3c30-0f4b-205c-c71c" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(F4, Ataques flamígeros)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Poción del Caos" id="ca91-d198-3e30-c6ed" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje puede beberla al inicio de la batalla, tras el despliegue. Tira 1D6 en la siguiente tabla: 
D6 Poción del Caos
1 Engendro del Caos: El personaje se transforma en un engendro del Caos con la marca apropiada. Si tu ejército incluye una unidad de engendros con la misma marca, puedes unirlo a ella.
2 Fuerza demencial: obtiene +1 F y Estupidez.
3 Llamas del Caos: Ataques flamígeros y Arma de aliento (F4, Ataques flamígeros)
4 Metabolismo acelerado: Regeneración (4+).
5 Furia homicida: el portador obtiene +1 F, R y A.
6 Poder del Caos: El portador suma +1 a todos sus atributos (excepto M y L). Al inicio de cada uno de sus turnos debe superar un chequeo de Resistencia o sufrirá 1 herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brazaletes de la brutalidad" id="39cb-a453-911b-6b4d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="89a1-42fd-41da-3e8c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="79ee-61db-e17a-b93c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brazaletes de la brutalidad" id="4ae0-9cba-2718-d803" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 1D6. Contiene un hechizo de potenciación que puede lanzarse sobre una unidad amiga a 12” o menos del portador, y permanece un turno. Por la duración del conjuro, la unidad tendrá un bonificador de +1F</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de piedra de disformidad" id="55ae-647e-d7ef-3cfc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="693f-d302-b573-3b37" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d81d-95dc-5719-7184" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="87a4-57a7-fcd6-28b2" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, canalizar, un único dado de energía o dispersión, o una tirada en la tabla de disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Favor de los Dioses" id="3243-de41-69b5-b230" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="69bc-b3d4-95b1-92f7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dd20-e5f6-7625-86d4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Favor de los Dioses" id="7c72-6c35-c76b-5eaa" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla de El Ojo de los Dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
