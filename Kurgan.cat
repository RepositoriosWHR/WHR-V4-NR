    <selectionEntry name="[Ex] - Ettin maldito" id="c860-ade0-b89f-96f6" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="85dd-f3d0-0318-0579" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
