        <infoLink name="Inmune al fuego" id="3991-cb0a-653e-b72d" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
        <infoLink name="Piel escamosa (5+)" id="0ca1-59f1-6cf1-8368" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
        <infoLink name="Caballería pesada" id="6665-57e7-ee14-9272" hidden="false" targetId="b6eb-e533-d53c-7d5c" type="rule"/>
