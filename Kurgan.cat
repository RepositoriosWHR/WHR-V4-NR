      </modifiers>
      <rules>
        <rule name="Marcado por los dioses" id="e9ed-7c46-a57e-e881" hidden="false">
          <description>Mordrek no puede unirse a unidades ni ser el General del ejército.</description>
        </rule>
        <rule name="Marca del caos absoluto" id="4954-88e0-a288-efac" hidden="false">
          <description>Permite repetir sus tiradas de salvación por armadura fallidas.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="7430-481c-8c42-5204" collective="false" hidden="false" import="true" type="upgrade">
