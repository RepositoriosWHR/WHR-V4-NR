          </entryLinks>
          <infoLinks>
            <infoLink name="Arma a dos manos" id="cfa0-d5c6-44ad-0ffe" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Mandoble berserker" id="f5f7-ecd3-a673-84bb" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Cada vez que el portador ataque en combate cuerpo a cuerpo, puede efectuar 1D6 ataques adicionales (tira cada vez que el portador vaya a atacar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hacha de la destrucción" id="610c-909b-d436-dde7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5c07-e7c8-9c28-67b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f3e4-ef64-34b3-44bd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="25e6-4117-079e-8b47" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Heridas múltiples (1D3)" id="c580-911a-e9f3-fc45" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
            <infoLink name="Arma a dos manos" id="41cf-9ac4-6a79-be38" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Hacha de la destrucción" id="d14f-39a9-7164-bcff" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Las heridas causadas por este arma no permiten tirada de salvación por armadura. Además, contra miniaturas de los ejércitos de las Fuerzas del Orden sus impactos se resuelven con la regla especial Heridas múltiples 
(1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Kurgan. Arma de mano" id="3943-53e5-50c2-4332" collective="false" hidden="false" import="true">
