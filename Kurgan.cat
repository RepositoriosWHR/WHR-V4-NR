          <profiles>
            <profile name="Gema de la gran serpiente" id="c444-eebf-2609-546c" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la marca de Slaanesh. Todos los enemigos que ataquen contra el portador en combate cuerpo a cuerpo verán su HA reducida a la mitad (redondeando fracciones hacia arriba) para esos ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Kurgan. Khorne" id="2747-9b23-29c1-2e6e" collective="false" hidden="false" import="true">
