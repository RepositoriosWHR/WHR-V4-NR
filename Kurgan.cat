              </modifiers>
              <rules>
                <rule name="Marca de Caos absoluto. Guerreros consagrador Kurgan" id="844b-08b3-65f6-3b2d" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="ffd4-01e9-76f2-a289" collective="false" hidden="false" import="true" targetId="aba0-1add-f8e6-6168" type="selectionEntry">
