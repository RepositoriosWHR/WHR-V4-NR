            <entryLink name="Marca de Tzeentch. Personajes" id="de2b-6492-f8fb-1918" collective="false" hidden="false" import="true" targetId="0cbb-1c3a-5e70-7f3b" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="7d59-57fb-9fc1-3697" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="4ac3-2e2a-6530-a576" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Señor de la guerra Kurgan" id="88e2-ed6c-3fe0-19c2" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Caos absoluto. Personajes" id="1684-d7ad-da53-f2f1" collective="false" hidden="false" import="true" targetId="f4e7-b253-934f-81e7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="a28a-f291-c43c-1ae5" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Caos absoluto. Señor de la guerra Kurgan" id="22df-7da6-7764-625c" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
