            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Clave: Hechicero" id="d680-9fe0-39c2-4b6e" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Hechicería del Caos" id="8a13-8e4b-b9a8-1e27" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="6f38-0f8e-f5c8-4ecc" collective="false" hidden="false" import="true">
              <entryLinks>
                <entryLink name="Saber de Tzeentch" id="39fa-76b5-17e1-b942" collective="false" hidden="false" import="true" targetId="b20e-2adb-6db4-44be" type="selectionEntry"/>
                <entryLink name="Saber de Slaanesh" id="531e-fc43-5d56-bb1a" collective="false" hidden="false" import="true" targetId="6f45-b771-55d8-cc14" type="selectionEntry"/>
                <entryLink name="Saber de la Muerte" id="de41-0cd1-9bca-1453" collective="false" hidden="false" import="true" targetId="64a6-d9e9-3822-4168" type="selectionEntry"/>
                <entryLink name="Saber de Nurgle" id="bec9-03a1-43d0-df2d" collective="false" hidden="false" import="true" targetId="3352-4875-5820-8bbe" type="selectionEntry"/>
                <entryLink name="Magia Oscura" id="62f1-4602-4a13-52fe" collective="false" hidden="false" import="true" targetId="7a1e-b29e-9f4b-44a5" type="selectionEntry"/>
                <entryLink name="Saber del Fuego" id="93b3-bf2d-4c32-66dc" collective="false" hidden="false" import="true" targetId="bff8-8e34-eb37-f67a" type="selectionEntry"/>
              </entryLinks>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
