              <infoLinks>
                <infoLink name="Miedo" id="b414-d856-9ea8-29f2" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Señor de la guerra Kurgan" id="7dd9-45d5-657a-a59b" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="c989-0068-9583-c76e" collective="false" hidden="false" import="true" targetId="2130-8db6-f7dc-8c82" type="selectionEntry">
