            <infoLink name="Armadura pesada" id="9f1f-5c43-30df-a5ef" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Coraza sangrienta" id="4292-3b98-4430-ee9a" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Todos los impactos contra el portador tendrán un penalizador de -1 en su tirada para herir. No afecta a impactos sin un valor de Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
