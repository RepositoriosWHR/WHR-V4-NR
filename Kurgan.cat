          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa del Caos indiviso" id="3d8a-af13-80b3-f1f8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6c3d-2762-fd69-a69b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6a8e-4b2b-afba-c7e5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="af9b-b297-9ae3-2e64" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Runa del Caos indiviso" id="7118-c706-f9b2-6183" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">El personaje causa Terror. Además, todas las unidades enemigas en contacto peana con peana con el portador deberán repetir todos sus chequeos exitosos de desmoralización.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vientos del Caos" id="783e-24d5-266c-1643" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ae1d-aa02-3466-7ac0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d034-312d-c7de-8dbc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vientos del Caos" id="a801-a031-d604-c92b" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">Los Vientos del Caos disparan como un Lanzallamas (puede disparar aunque el personaje mueva o marche) que puede estimar hasta 3 dados. Se resuelve con Fuerza 8, tira para herir contra el Liderazgo del objetivo en lugar de contra su Resistencia y no permite tirada de salvación por armadura; cualquier unidad que sufra al menos una baja por esto deberá realizar inmediatamente un chequeo de Pánico. Si obtienes un resultado de Problemas, el disparo simplemente no se realiza (no tires en la tabla de Problemas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Resolución oscura" id="859a-42a4-93fd-ac7e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="71bd-da3e-25de-ba94" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="44e7-916d-0d70-3cbf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio (todos los enemigos)" id="a86f-c9f7-abfc-8660" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Resolución oscura" id="eff9-786e-39f4-8c80" hidden="false" typeId="1902-3bc7-65bd-b65b" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6cc9-3fc9-1077-bea6">El personaje obtiene la regla especial Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
