              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los impactos causados contra la unidad tendrán un penalizador de -1 en sus tiradas para herir (recuerda que un resultado de 6 siempre hiere).</characteristic>
              </characteristics>
