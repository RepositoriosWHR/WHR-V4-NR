            <profile name="Pellejos de licántropo" id="bb87-7963-bbfe-252a" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Proporciona a su portador las reglas especiales Regeneración (5+) y Furia asesina. Además, el portador no perderá su furia asesina aunque sea derrotado en combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escudo del viento" id="b194-6d9e-78f8-2358" collective="false" hidden="false" import="true" type="upgrade">
