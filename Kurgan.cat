        <infoLink name="Odio (todos los enemigos)" id="596b-58ce-584a-b022" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(No a Demonio o No muertos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="8d75-600f-8fcf-a9bb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="La Tribu del Cuervo" id="314e-db33-9bc2-7004" hidden="false">
          <description>La unidad de Guerreros Kurgan a la que se una Valnir obtendrá las reglas especiales Inmune a psicología y Odio a todos los enemigos que no tengan la regla especial Demonio o No muerto.</description>
        </rule>
      </rules>
    </selectionEntry>
