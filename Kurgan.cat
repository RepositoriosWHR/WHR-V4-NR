                  <description>Obtiene la regla especial Poder de penetración en todos sus ataques y +1 Iniciativa.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Unidades" id="8f08-9995-9b47-3aab" collective="false" hidden="false" import="true" targetId="9368-30c0-5c4e-baa3" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="ed43-46d6-0c44-3977" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="15">
                  <repeats>
