    <selectionEntry name="[E] - Wulfrik el Errante, trotamundos eterno" id="7fec-45bf-0045-82ec" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="f799-ee2a-546b-56d4" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
        <categoryLink name="New CategoryLink" id="d6f2-5b75-7c4e-5755" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
      </categoryLinks>
      <constraints>
        <constraint id="b9e4-4e13-0aff-f91a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
