          </constraints>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="e2b4-86e8-f805-bcdb" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Ataques mágicos" id="5057-b202-14c3-ca8b" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Volrik" id="ba53-96ef-1da0-5378" hidden="false">
              <description>Le proporciona las reglas especiales Ataques flamígeros y Ataques mágicos, y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
