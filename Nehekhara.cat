    <selectionEntry id="d155-20f2-0aa7-9d99" name="Gran salmodiador" hidden="false" collective="false" import="true" type="unit">
      <rules>
        <rule id="abad-73d5-b23a-888a" name="Cánticos de guerra" hidden="false">
          <description>Un Gran salmodiador conoce todos los Cánticos de guerra y puede lanzar hasta dos de ellos por fase de magia con nivel de energía 5; además, puede Canalizar y dispersar hechizos como si fuese un 
hechicero de nivel 3.</description>
        </rule>
      </rules>
