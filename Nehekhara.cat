              <profiles>
                <profile id="bb55-77cc-98f8-c309" name="Bastón del liche" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que lance un hechizo Khatep puede, si lo desea, repetir todos los dados de la tirada de lanzamiento.</characteristic>
