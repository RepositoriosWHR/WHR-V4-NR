            <modifier type="set" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="2463-bb1e-8285-41cd" name="Inflamable" hidden="false" targetId="93e4-15ce-63a5-ad92" type="rule"/>
        <infoLink id="f687-67b6-340f-7fb7" name="Odio" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Orcos y Goblins)"/>
          </modifiers>
