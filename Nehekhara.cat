              <rules>
                <rule id="3ebe-073f-5c12-e27c" name="Bendición de Khsar" hidden="false">
                  <description>Pese a ser inmunes a la psicología, pueden reaccionar a una carga aguantando y
disparando, huyendo o disparando y huyendo, además de manteniendo la posición. Se reagrupan automáticamente.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="270e-6bd6-ffaa-c06a" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule"/>
