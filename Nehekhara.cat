          <profiles>
            <profile id="68cd-96fd-1883-205c" name="Escudo de Ptra" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Si el portador realiza una tirada de salvación por armadura exitosa en combate cuerpo a cuerpo, todas las miniaturas de cualquier unidad enemiga en contacto peana con peana con el personaje verán reducida su Habilidad de armas a 1 durante el resto de la fase de combate cuerpo a cuerpo en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="35b2-39e8-48f7-0760" name="Escudo" hidden="false" targetId="c028-354e-9169-7463" type="profile"/>
          </infoLinks>
          <costs>
