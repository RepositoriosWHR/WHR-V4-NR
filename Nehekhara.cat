        <infoLink id="484b-3914-3271-f305" name="Señor del conocimiento" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Nehekhara)"/>
          </modifiers>
        </infoLink>
