              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Otorga una Herida adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
