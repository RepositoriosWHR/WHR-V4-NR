    <selectionEntry id="53ec-e2c6-23e4-2e5e" name="[E] - Príncipe Tutankhanut de Numas" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0606-1946-5b01-43d9" type="max"/>
      </constraints>
      <rules>
        <rule id="7ce2-0587-633c-4819" name="La maldición" hidden="false">
          <description>Si Tutankhanut muere a manos de un personaje o Monstruo enemigo, este deberá efectuar inmediatamente un chequeo de Liderazgo con un penalizador de -1; si lo falla, sufrirá inmediatamente 1D3 heridas sin tirada de salvación por armadura.</description>
        </rule>
        <rule id="cb2f-1a6d-501e-7ba6" name="¡Hágase mi voluntad!" hidden="false">
          <description>Una vez por fase de magia propia, puede lanzar el hechizo del Saber de Nehekhara “Encantamiento del viento desértico de Khsar” como un objeto portahechizos con nivel de energía 2.</description>
        </rule>
        <rule id="f532-dc8a-cf20-d2e5" name="Cuerpo de oro" hidden="false">
          <description>Tutankhanut tiene la regla especial Constructo. Además, el cuerpo de oro cuenta como una Armadura pesada (dándole una tirada de salvación por armadura total de 2+ por su Máscara mortuoria).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="e1fa-7653-8fbd-c460" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule">
          <modifiers>
            <modifier type="set" field="hidden" value="true">
              <conditions>
                <condition field="selections" scope="53ec-e2c6-23e4-2e5e" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="52f9-e422-63e6-c05a" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink id="76c5-9c9f-1e41-035b" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="0ebc-46ec-b06d-0253" name="Inflamable" hidden="false" targetId="93e4-15ce-63a5-ad92" type="rule"/>
        <infoLink id="1e46-c16d-e3fe-817e" name="Constructo" hidden="false" targetId="205f-bd49-226e-55e1" type="rule"/>
      </infoLinks>
