    <selectionEntry id="bad6-4d71-119b-5949" name="Hierotitán" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="041a-ba16-8dd9-1760" type="max"/>
      </constraints>
      <rules>
        <rule id="8f24-4589-9bb9-d812" name="Conducto espiritual" hidden="false">
          <description>Cada vez que un efecto de invocación fuera a restaurar heridas a una unidad amiga con la regla especial No muerto a 12” o menos de un Hierotitán, tira dos veces por cada dado y elige el resultado mayor.</description>
        </rule>
        <rule id="02bb-cea3-e622-fc33" name="Magia Hierotitán" hidden="false">
          <description>Un Hierotitán es un hechicero de nivel 2 que siempre usa el Saber de Nehekhara.</description>
        </rule>
        <rule id="ed00-5f39-3a91-f7fd" name="Resistencia excepcional" hidden="false">
          <description>Cada vez que el Hierotitán fuese a recibir heridas por efecto de la regla especial Heridas múltiples, divide el número de heridas a la mitad (redondeando hacia arriba).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="6988-c382-6e72-2ebc" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="fd4e-3531-db39-f471" name="Constructo" hidden="false" targetId="205f-bd49-226e-55e1" type="rule"/>
        <infoLink id="02f8-7e80-7239-4feb" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="d614-5246-7401-63ab" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
