          <profiles>
            <profile name="Rey de Numas" id="02e2-da42-7ca2-7147" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Pudiendo equiparse con un objeto mágico adicional. Además, una de las unidades de Esqueletos o Caballería esquelética del ejército podrá equiparse con un estandarte mágico de hasta 50 puntos, en lugar de los 25 habituales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
