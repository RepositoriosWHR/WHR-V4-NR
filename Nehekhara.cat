    <selectionEntry id="59ed-173c-7f19-b4e8" name="[E] - Sehensmet, Visir de Quatar" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c069-8517-9efe-857a" type="max"/>
      </constraints>
      <profiles>
        <profile id="2c04-b6b8-cc65-38aa" name="Encantamiento del viento desértico de Khsar" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
          <characteristics>
            <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
            <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">Portahechizos nivel 4</characteristic>
            <characteristic name="Rango" typeId="544c-fa75-b146-79c4">18&quot;</characteristic>
            <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
            <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 18” o menos del lanzador. La unidad podrá realizar inmediatamente un movimiento como si se encontrase en la sub-fase de Resto de movimientos de su fase de movimiento, una carga como si se encontrase en la sub-fase de declaración de cargas de su fase de movimiento o disparar como si se encontrase en la fase de disparo. Puede potenciarse para que afecte a todas las unidades amigas con la regla especial No muerto a 12” o menos del lanzador, en cuyo caso la dificultad será de 19+.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ca4d-c705-0351-6390" name="Magia Sehensmet, visir de Quatar" hidden="false">
          <description>Sehenesmet es una hechicero de nivel 4 que elige sus hechizos del Saber de Nehekhara.</description>
        </rule>
        <rule id="6885-6c6c-daca-c4fa" name="Aura sagrada de Kharnut" hidden="false">
          <description>Otorga a todas las unidades amigas a 12” o menos de Sehenesmet la regla especial Resistencia mágica (2).</description>
        </rule>
        <rule id="1b6c-49fc-8e59-22c3" name="Maestro artífice" hidden="false">
          <description>Cada vez que una unidad con la regla especial Constructo a 18” o menos de Sehenesmet vaya a recuperar heridas por un efecto de invocación de un hechizo lanzado por Sehenesmet, recuperarán el doble de heridas de lo indicado en la tirada.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="1442-5160-91f9-33a4" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="b163-f430-bfbf-2971" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="a0d9-5b4f-3156-52a9" name="Constructo" hidden="false" targetId="205f-bd49-226e-55e1" type="rule"/>
        <infoLink id="55bb-4c3e-81f1-1a6b" name="Regeneración (6+)" hidden="false" targetId="4aee-7485-a141-cd20" type="rule"/>
