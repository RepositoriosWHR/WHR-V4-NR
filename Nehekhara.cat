  <sharedProfiles>
    <profile name="Arco compuesto" id="cd7d-8ec0-ade0-b2ea" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">30&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">5</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Lluvia de flechas, Poder de penetración, Empalar: Los resultados naturales de 6 para herir con estas armas se resuelven con la regla especial Heridas múltiples (1D3).</characteristic>
      </characteristics>
    </profile>
    <profile name="Bastón de fuego" id="4f80-cc12-c159-9bfc" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">18&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">4</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Mover o disparar, Poder de penetración</characteristic>
      </characteristics>
    </profile>
    <profile name="Arco del desierto" id="5cb5-ebf0-e0f6-1c2f" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">48&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">6</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Atraviesa filas, Heridas múltiples (1D3), niega la tirada de salvación por armadura</characteristic>
      </characteristics>
    </profile>
    <profile name="Lanza funeraria" id="306f-b0ec-6ddc-c498" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataque rápido, Ataques mágicos, Golpe letal, +1F en el turno de carga</characteristic>
      </characteristics>
    </profile>
    <profile name="Armas emparejadas funerarias" id="6cea-9efe-4af6-2db5" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, +1 Ataque, Ataques mágicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
    <profile name="Arma a dos manos funeraria" id="4a6a-0fed-4feb-f567" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Lenta, Ataques mágicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
    <profile name="Alabarda funeraria" id="74da-c7e8-243d-ee8d" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Luchar con filas adicionales (1), Ataques mágicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
    <profile name="Mayal funerario" id="93f7-a4f6-09ed-14b8" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+2</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Requiere ambas manos, Agotamiento, Ataques mágicos, Golpe letal.</characteristic>
      </characteristics>
    </profile>
    <profile name="Arma de mano funeraria" id="ed90-c35e-9ec0-3023" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Golpe letal. Arma de mano: Se considera un Arma de mano a todos los efectos y puede utilizarse en combinación con un Escudo para realizar Parada, siguiendo las reglas habituales.</characteristic>
      </characteristics>
    </profile>
    <profile name="Látigo de necrotecto" id="f274-1a05-6672-11b4" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Arma adicional (+1A), Combate desde atrás: Pese a ser un personaje, el Necrotecto puede situarse en la segunda fila de una unidad y atacar desde allí como si su peana fuese la peana de la miniatura situada inmediatamente delante de la suya.</characteristic>
      </characteristics>
    </profile>
    <profile name="Arco funerario" id="2865-e0bd-d636-f0be" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">24&quot;</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">3</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Lluvia de flechas, Ataques mágicos, Golpe letal</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
  <sharedRules>
    <rule name="Constructo" id="205f-bd49-226e-55e1" hidden="false">
      <description>Las miniaturas con la regla especial Constructo tienen la regla especial No muertos, pero sufren una herida menos de las que les correspondiesen por perder un combate cuerpo a cuerpo (por su regla especial Inestables), así como una herida menos en los chequeos por muerte del Hierofante. Además, los Constructos poseen una tirada de salvación por armadura de 5+, que puede combinarse de la forma habitual con armaduras y monturas.</description>
    </rule>
    <rule name="Flechas áspid" id="0db4-e866-49ca-e084" hidden="false">
      <description>Al disparar un arma de proyectiles con Flechas áspid se ignoran todos los modificadores (tanto positivos como negativos) a la tirada para impactar.</description>
    </rule>
    <rule name="Bendición de Khsar" id="d943-ff2d-73ac-5106" hidden="false">
      <description>Pese a tener la regla especial Inmune a psicología, las unidades con esta regla especial pueden reaccionar a una carga Aguantando y disparando, Huyendo o Disparando y huyendo, además de Manteniendo la posición. Se reagrupan automáticamente tras terminar su huida.</description>
    </rule>
    <rule name="Cánticos de guerra" id="72fc-6beb-604d-cf23" hidden="false">
      <description>Cántico de venganza de Sekhubi: Se trata de un hechizo de Proyectil mágico con un alcance de 18” que causa 2D6 impactos de Fuerza 4.
Cántico del embate de Horekhah: Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga a 12” o menos del lanzador y Permanece un turno. Por la duración del conjuro, la unidad podrá repetir sus tiradas fallidas para impactar, tanto en combate cuerpo a cuerpo como con proyectiles.
Cántico de la invocación de Djedra: Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga a 12” o menos del lanzador: la unidad recupera inmediatamente tantas heridas como se indica en su regla especial No muerto.
Cántico del apremio de Mankara: Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga a 12” o menos del lanzador: la unidad puede efectuar inmediatamente un movimiento recto hacia delante de 2D6”; si este movimiento es suficiente para llegar a contacto peana con peana con el enemigo, se considerará una carga.</description>
    </rule>
    <rule name="Hierofante" id="28cb-89f0-99be-dc63" hidden="false">
      <description>El ejército de Nehekhara debe incluir al menos un personaje con niveles de magia. Debes designar de entre ellos al que tenga mayor nivel de magia (elige si hay varios con el mismo nivel) y comunícaselo a tu oponente; ese será el Hierofante, que habrá levantado el ejército. El Hierofante otiene la regla especial Regeneración (5+) y cualquier unidad a la que se una obtendrá la regla especial Regeneración (6+). Si tu Hierofante muere, todo tu ejército (en la vieja tradición de los no muertos) comenzará a deshacerse en polvo. Al final de la fase en la que el Hierofante haya muerto y al inicio de cada turno posterior de Nehekhara, cada unidad con la regla especial No muerto de tu ejército debe efectuar un chequeo de Liderazgo, sufriendo una herida sin tirada de salvación por cada punto por el que fallen dicho chequeo. Puede utilizarse el Liderazgo de un personaje al mando de la unidad para este chequeo. Los personajes independientes no resultan afectados por la muerte del Hierofante.</description>
    </rule>
  </sharedRules>
  <sharedSelectionEntries>
    <selectionEntry name="Hierofante" id="e950-52d8-27af-6541" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="c682-d315-b492-7b58" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
        <constraint id="8191-3fbf-0dce-17e4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="min" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Regeneración (5+)" id="7f79-b49c-26ba-e85e" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Hierofante" id="a4c3-8062-027a-b2f1" hidden="false">
          <description>El ejército de Nehekhara debe incluir al menos un sacerdote o sumo sacerdote. Debes designar de entre ellos al que tenga mayor nivel de magia (elige si hay varios con el mismo nivel) y comunícaselo a tu oponente; ese será el Hierofante, que habrá levantado el ejército. El Hierofante posee la regla especial Regeneración (5+), y cualquier unidad de no muertos a la que se una obtendrá la regla especial Regeneración (6+). Si tu hierofante muere, todo tu ejército (en la vieja tradición de los No Muertos) comenzará a deshacerse en polvo. Al final de la fase en la que el hierofante haya muerto, y al inicio de cada turno posterior de Nehekhara, cada unidad no muerta debe efectuar un chequeo de liderazgo, sufriendo una herida sin tirada de salvación por cada punto por el que fallen dicho chequeo. Puede utilizarse el liderazgo de un personaje al mando de la unidad para este chequeo. Los personajes no resultan afectados por la muerte del Hierofante.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Arca de las almas" id="498a-f35d-9e53-f2c2" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="bccb-15f5-89d1-fb6c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Terror" id="54eb-6207-a473-9e91" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Resistencia mágica (2)" id="c65f-9060-8373-45ea" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
        <infoLink name="No muerto" id="ae6c-b913-610b-7cb5" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier field="name" type="set" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Indesmoralizable" id="153a-df04-3ebf-a6a7" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink name="Constructo" id="67c7-a2cd-36ed-4519" hidden="false" targetId="205f-bd49-226e-55e1" type="rule"/>
        <infoLink name="Carro" id="f48b-99ae-0a6f-149b" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink name="Protección por montura (2)" id="acb9-ab64-2663-6e90" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Potencia de unidad 4" id="7d84-8234-f1f4-6446" hidden="false">
          <description>Potencia de unidad 4</description>
        </rule>
        <rule name="Pacto de poder" id="5c76-2e37-5ad6-9305" hidden="false">
          <description>Al inicio de cada fase de magia propia, un Arca de las almas genera 1D3 dados de Energía adicionales.</description>
        </rule>
        <rule name="Espíritus de los condenados" id="211c-17f9-188e-601c" hidden="false">
          <description>Al inicio de cada una de tus fases de disparo, puedes liberar el poder de los espíritus atrapados en el arca. Esto afecta a todas las unidades enemigas no trabadas en combate a 36” o menos del Arca de las almas y que tengan línea de visión hacia el Arca de las almas. Por cada una de esas unidades, tira 2D6+2 y resta el Liderazgo del objetivo: esas son las heridas causadas sin tirada de salvación por armadura. Cualquier unidad que sufra al menos una baja como consecuencia de este ataque deberá realizar inmediatamente un chequeo de Pánico.</description>
        </rule>
        <rule name="Estructura inmóvil" id="3b2f-4d51-4dc8-2886" hidden="false">
          <description>Pese a ser un Carro, el Arca de las almas no puede mover y no tiene bestias que tiren de ella. El Arca de las almas posee una tirada de salvación especial de 4+; además, su Resistencia aumenta hasta 10 contra proyectiles y hechizos del tipo Proyectil mágico.</description>
        </rule>
      </rules>
      <selectionEntries>
