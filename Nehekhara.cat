      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3dda-748d-6f2f-0bc7" type="max"/>
      </constraints>
      <rules>
        <rule id="df9a-8c74-8966-fead" name="Magia Amenadresh, el heraldo de Ptra" hidden="false">
          <description>Amenadresh es un hechicero de nivel 2 que puede utilizar hechizos del Saber de la Luz y/o de Nehekhara.</description>
        </rule>
        <rule id="a6a5-1ba2-3700-cfda" name="Cánticos de guerra Amenadresh, el heraldo de Ptra" hidden="false">
          <description>Amenadresh conoce todos los Cánticos de guerra y puede lanzar hasta dos de ellos por fase de magia con nivel de energía 5; además, puede dispersar hechizos como si fuese un hechicero de nivel 3 (en lugar de utilizar su nivel de magia 2 como sería habitual)</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="c2a9-b593-2e23-9404" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule"/>
        <infoLink id="2e0e-047d-5223-5f3a" name="Caballería monstruosa" hidden="false" targetId="a7be-2cd9-f3c6-b091" type="rule"/>
