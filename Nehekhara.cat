            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4697-5945-9e85-5795" type="max"/>
          </constraints>
          <profiles>
            <profile id="9021-ebb5-1c1f-394d" name="Armadura del escorpión" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. El portador (o la unidad en la que se encuentre) sufren una herida menos como resultado de su regla especial Inestables al perder un combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
