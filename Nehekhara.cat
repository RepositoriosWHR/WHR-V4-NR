            <characteristic name="A" typeId="4123232344415441232323">6</characteristic>
            <characteristic name="L" typeId="4c4423232344415441232323">8</characteristic>
            <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
            <characteristic name="TSE" typeId="576172645361766523232344415441232323"/>
            <characteristic name="Tipo" typeId="5479706523232344415441232323">Monstruo</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="27b0-9ec5-b1dd-6c51" name="Aliento mortal" hidden="false">
          <description>Se trata de un Arma de aliento: cualquier miniatura impactada por esta será herida con un resultado de 4+, sin importar su Resistencia. Estas heridas no permiten tirada de salvación por armadura.</description>
        </rule>
        <rule id="12d7-b940-c8b4-3fe8" name="Monstruo de hueso" hidden="false">
          <description>El Rey funerario que monte un Dragón esqueleto puede repetir sus tiradas de salvación por armadura fallidas contra impactos de Fuerza 5 o inferior.</description>
        </rule>
        <rule id="c331-821e-1e44-2043" name="Embebido en magia" hidden="false">
          <description>Un Dragón esqueleto tiene las reglas especiales Ataques mágicos y Resistencia mágica (1).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9b2f-326f-612e-9344" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="5d92-88b3-4605-9946" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="a22d-b950-4cc9-cd90" name="Volar (8)" hidden="false" targetId="4976-4d2f-fd36-1a17" type="rule"/>
        <infoLink id="623d-b3f5-da12-d15e" name="Protección por montura (2)" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
        <infoLink id="1f1c-9882-31ef-c025" name="Arma de aliento" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Aliento mortal)"/>
          </modifiers>
        </infoLink>
        <infoLink id="7aa5-ac77-9a57-fb90" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
