          <profiles>
            <profile name="Estandarte de la legión eterna" id="4794-6625-5981-53ae" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Cada vez que el portador o su unidad causen una herida como resultado de un Golpe letal exitoso, la unidad recupera una única herida (es un efecto de invocación).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Pergaminos arcanos" id="efd8-9c80-7fbf-0878" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Pergamino de invocación ultraterrena de Djedra" id="6adc-65c8-3d8e-8ffd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c620-d783-e8d0-7615" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="-1"/>
            <constraint id="f200-92bd-7ad1-72ce" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de invocación ultraterrena de Djedra" id="fa30-9827-4527-f6f9" hidden="false" typeId="5602-01f3-6157-f454" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4745-0499-4ee7-094e">Un sólo uso. Objeto portahechizos, nivel de energía 1D3+1. Contiene un hechizo de Potenciación que afecta a una unidad amiga con la regla especial No muerto a 12” o menos del lanzador. Si el hechizo se resuelve con éxito, la unidad afectada recupera inmediatamente el doble de las heridas indicadas en su regla especial No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino de la furia sagrada de Khorekhab" id="d11b-0355-f8b5-57ff" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5cd0-224f-8076-5228" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="-1"/>
            <constraint id="3c7a-984b-79bd-494e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de la furia sagrada de Khorekhab" id="55f6-4c60-fb06-290d" hidden="false" typeId="5602-01f3-6157-f454" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4745-0499-4ee7-094e">Un sólo uso. Objeto portahechizos, nivel de energía 1D3. Contiene la versión normal del hechizo Encantamiento del justo castigo de Ptra, del Saber de Nehekhara.</characteristic>
              </characteristics>
            </profile>
            <profile name="Encantamiento del justo castigo de Ptra" id="9909-69f3-bcc9-a78b" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">Portahechizos nivel 1D3</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">12&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">Permanece un turno</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 12” o menos del lanzador y Permanece un turno. Mientras dure el hechizo, el atributo de Ataques de las miniaturas de la unidad se incrementa en +1 y si están equipada con arcos (de cualquier tipo), obtienen la regla especial Disparos múltiples (2). Puede potenciarse para que afecte a todas las unidades amigas con la regla especial No muerto a 12” o menos del lanzador, en cuyo caso la dificultad será de 18+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino de la vitalidad de Menkaure" id="015e-a192-56e3-b4bc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="26ab-23ea-26be-31ac" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="-1"/>
            <constraint id="d418-5d65-1f24-f420" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de la vitalidad de Menkaure" id="3b0f-0114-1779-272b" hidden="false" typeId="5602-01f3-6157-f454" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4745-0499-4ee7-094e">Un sólo uso. Objeto portahechizos, nivel de energía 1D3. Contiene la versión normal del hechizo Encantamiento del viento desértico de Khsar, del Saber de Nehekhara.</characteristic>
              </characteristics>
            </profile>
            <profile name="Encantamiento del viento desértico de Khsar" id="24b9-f273-573d-2f9d" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">Portahechizos nivel 1D3</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">18&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 18” o menos del lanzador. La unidad podrá realizar inmediatamente un movimiento como si se encontrase en la sub-fase de Resto de movimientos de su fase de movimiento, una carga como si se encontrase en la sub-fase de declaración de cargas de su fase de movimiento o disparar como si se encontrase en la fase de disparo. Puede potenciarse para que afecte a todas las unidades amigas con la regla especial No muerto a 12” o menos del lanzador, en cuyo caso la dificultad será de 19+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
