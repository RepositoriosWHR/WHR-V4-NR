      <selectionEntries>
        <selectionEntry id="ef6d-ff0a-f27e-dc06" name="Máscara mortuoria de Kharnut" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="dab9-a36c-7b3c-13e5" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a969-fcba-61a0-5f7c" type="max"/>
