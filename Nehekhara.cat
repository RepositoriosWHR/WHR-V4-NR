              </infoLinks>
              <profiles>
                <profile name="Máscara mortuoria" id="9e1a-e8dc-d6ce-eaa1" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Yelmo. Cualquier miniatura que intente atacar a Tutankhanut en combate cuerpo a cuerpo deberá superar un chequeo de Liderazgo; si lo supera, podrá atacar normalmente. Si falla, no podrá atacar a Tutankhanut durante esa fase de combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Arco de caza" id="a0d8-0bb6-8144-5eea" collective="false" hidden="false" import="true" type="upgrade">
