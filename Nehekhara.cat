      <rules>
        <rule id="7eeb-8259-684a-2352" name="Sumo celador" hidden="false">
          <description>Si Pedget se encuentra unido a una unidad de Guardia del sepulcro, la unidad obtiene la regla especial Tozudez en cualquier turno en el que Pedget haya participado en un Desafío (incluso aunque haya muerto a consecuencia del Desafío).</description>
        </rule>
      </rules>
