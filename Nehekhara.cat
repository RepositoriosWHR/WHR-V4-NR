              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Sus impactos se resuelven con la regla especial Golpe letal. Cada vez que el portador elimine a un oponente en combate cuerpo a cuerpo con un Golpe letal, el atributo de Heridas de este aumenta permanentemente 
en +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="d275-d8b7-35e9-f7cc" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
