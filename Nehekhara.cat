        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Amenadresh, el heraldo de Ptra" id="df9a-8c74-8966-fead" hidden="false">
          <description>Amenadresh es un hechicero de nivel 2 que puede utilizar hechizos del Saber de la Luz y/o de Nehekhara.</description>
        </rule>
        <rule name="Cánticos de guerra Amenadresh, el heraldo de Ptra" id="a6a5-1ba2-3700-cfda" hidden="false">
          <description>Amenadresh conoce todos los Cánticos de guerra y puede lanzar hasta dos de ellos por fase de magia con nivel de energía 5; además, puede dispersar hechizos como si fuese un hechicero de nivel 3 (en lugar de utilizar su nivel de magia 2 como sería habitual)</description>
        </rule>
      </rules>
