    <selectionEntry id="6b34-dfac-7512-6b8d" name="[E] - Príncipe Apophas, señor maldito de los escarabajos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="694d-7fa9-c665-078f" type="max"/>
      </constraints>
      <rules>
        <rule id="f151-c01d-6999-1363" name="Aparición del desierto" hidden="false">
          <description>Apophas no puede ser el General del ejército ni unirse a unidades; además, Apophas tiene la regla especial Tozudez, aunque nunca puede beneficiarse del efecto de Presencia inspiradora o ¡Ni un paso atrás!</description>
        </rule>
        <rule id="3027-540b-cee7-cb36" name="Marea de escarabajos" hidden="false">
          <description>Apophas tiene un Arma de aliento de F2 con las reglas especiales Poder de penetración y Ataques mágicos. Además, si Apophas va a ser retirado como baja, coloca la plantilla redonda grande centrada en Apophas antes de retirar la miniatura: cualquier miniatura bajo la plantilla (utiliza las reglas habituales para impactos parciales) sufrirá un impacto de Fuerza 2 con las reglas especiales Poder de penetración y Ataques mágicos; a continuación, retira la miniatura de Apophas como baja.</description>
        </rule>
        <rule id="8698-a960-3e41-6378" name="Cosechador de almas" hidden="false">
          <description>Al inicio de la batalla, tras el despliegue, designa un personaje enemigo, que será el alma que Apophas tratará de entregar a Usirian para saldar su deuda. Apophas podrá repetir todas sus tiradas para impactar fallidas durante la batalla contra el personaje designado.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="2785-6022-ac80-f68d" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="ac72-35a6-de16-d74f" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier type="set" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
        <infoLink id="9950-b389-3d49-e8f5" name="Volar (11)" hidden="false" targetId="80a9-39e5-b1f1-d428" type="rule"/>
        <infoLink id="4752-24ed-50c1-a646" name="Terror" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
