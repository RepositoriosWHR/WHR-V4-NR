    <selectionEntry name="[E] - Rey Anera-Kotrak de Zandri" id="3950-8323-cf3f-41cd" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="0b0e-0805-cc08-4090" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
