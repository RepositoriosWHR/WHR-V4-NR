      <selectionEntries>
        <selectionEntry id="0848-a4f4-97a1-df78" name="Kephra azul" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d147-2ff1-ae74-9086" type="max"/>
