              <profiles>
                <profile id="99f1-f80f-facb-b8c7" name="Nehaja de cráneos" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Mangual. Debido al escaso peso del arma y a la robusta constitución del Rey Phar, no tiene la regla especial Agotamiento. Los impactos causados por este arma se resuelven con las reglas especiales Poder de penetración y Heridas múltiples (2).</characteristic>
