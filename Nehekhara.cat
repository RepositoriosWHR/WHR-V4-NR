            <profile id="a4e4-f4fa-a386-50f4" name="Cetro serpiente" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Solo hechiceros o personajes con la regla especial Cánticos de guerra. Arma de mano. Los ataques con este arma se resuelven con la regla especial Ataques envenenados. El portador puede repetir sus tiradas fallidas para herir en combate cuerpo a cuerpo. Suma +1 a sus tiradas de Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="84ab-7818-e1b6-e284" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="48f3-9eb7-7997-d280" name="Ataques envenenados" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
