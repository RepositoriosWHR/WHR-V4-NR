          <profiles>
            <profile id="9b49-ac99-8bbe-4236" name="Corona de los reyes" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo Rey funerario. Yelmo. Otorga a su portador la regla especial Resistencia mágica (1) y, si es el General del ejército, aumenta en 6” el radio de su Presencia inspiradora. Además, al inicio de cada fase de combate cuerpo a cuerpo (propia o del oponente), puedes seleccionar una unidad amiga con la regla especial No muerto a 12” o menos del portador: todos los miembros de la unidad obtendrán un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo durante esa fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="de0a-f434-c1d2-a1cc" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
            <infoLink id="826b-7247-625b-7205" name="Yelmo" hidden="false" targetId="9607-7f57-879f-5c42" type="profile"/>
