    <selectionEntry id="2775-cb01-8a4d-7c43" name="[E] - Khatep el eterno, Sumo hierofante de Khemri" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="e01b-aa63-8a17-da7d" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="789b-2014-65d1-4128" type="max"/>
      </constraints>
      <rules>
        <rule id="a75f-787f-daf8-7723" name="Magia Khatep el eterno, sumo hierofante de Khemri" hidden="false">
          <description>Khatep el Eterno es un hechicero de nivel 4 que conoce todos los hechizos del Saber de Nehekhara.</description>
        </rule>
        <rule id="fd83-6303-b107-fd4b" name="Sumo hierofante" hidden="false">
          <description>Khatep posee la regla especial Regeneración (4+). Cualquier unidad a la que se una obtendrá la regla especial Regeneración (5+) en lugar del 6+ habitual por tener al Hierofante en la unidad.</description>
        </rule>
        <rule id="0f81-70ad-adef-4504" name="Magia ritual" hidden="false">
          <description>Cada vez que Khatep realice una tirada en la tabla de Disfunciones mágicas, tira 1D3 adicional y añádelo al resultado de la tirada. Si obtienes un resultado superior a 12, la Disfunción mágica no tendrá efecto.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="9360-5b9d-37b9-b13a" name="Infantería" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink id="9a14-faf5-6391-cd21" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(1)"/>
          </modifiers>
        </infoLink>
