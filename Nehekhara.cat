    <selectionEntry name="[E] - Ramhotep el visionario" id="6e5f-64a4-0b46-b7a6" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="5f6a-7442-25c6-a037" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
