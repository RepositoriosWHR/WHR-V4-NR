      </infoLinks>
      <rules>
        <rule name="Conducto espiritual" id="8f24-4589-9bb9-d812" hidden="false">
          <description>Cada vez que un efecto de invocación fuera a restaurar heridas a una unidad amiga con la regla especial No muerto a 12” o menos de un Hierotitán, tira dos veces por cada dado y elige el resultado mayor.</description>
        </rule>
        <rule name="Magia Hierotitán" id="02bb-cea3-e622-fc33" hidden="false">
          <description>Un Hierotitán es un hechicero de nivel 2 que siempre usa el Saber de Nehekhara.</description>
        </rule>
        <rule name="Resistencia excepcional" id="ed00-5f39-3a91-f7fd" hidden="false">
          <description>Cada vez que el Hierotitán fuese a recibir heridas por efecto de la regla especial Heridas múltiples, divide el número de heridas a la mitad (redondeando hacia arriba).</description>
        </rule>
      </rules>
