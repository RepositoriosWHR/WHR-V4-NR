      <selectionEntries>
        <selectionEntry name="Báculo de las plagas" id="6daa-cb88-9fb1-8779" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0029-017c-5900-09b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a011-5079-f7a6-0d4d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="70"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="e013-b35b-3d57-ef3b" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Báculo de las plagas" id="9c88-54ae-2051-7ea9" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 5. Contiene un hechizo de Daño directo que toma como objetivo a una única unidad enemiga a 18” o menos del portador. El hechizo causa 7D6 impactos de Fuerza 1 que no permiten tirada de salvación por armadura. Cualquier unidad que sufra al menos una baja por efecto de este hechizo deberá realizar inmediatamente un chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tablillas de los poderosos cánticos de Neferra" id="959d-c77b-3809-64f0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="de33-576c-63f7-8fad" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="61c4-d01d-164b-79b9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="4c16-d250-5648-4458" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Tablillas de los poderosos cánticos de Neferra" id="0d4c-7a6d-2d06-5eee" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador intente lanzar o dispersar un hechizo, puede repetir la tirada de uno de sus dados de 
Energía o Dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Nehekhara" id="80e3-b1a6-b38d-043b" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="52c7-72dd-70bc-7ca9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="2c5a-a09b-2b11-547d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Báculo de la maestría" id="0531-267f-2e85-06e6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1c92-c29b-09d2-1bae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b5f3-1e55-fd3d-42a4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo de la maestría" id="d957-d4e9-5a9e-6f82" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de Maldición que afecta a todos los hechizos enemigos que Permanecen en efecto o Permanecen un turno en el campo de batalla. Si el hechizo se resuelve exitosamente, todos esos hechizos quedan inmediatamente dispersados y su efecto cesa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cánope de Enkhil" id="0615-f66f-0ccb-9758" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="781f-8085-7299-82dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cc4f-cb39-46ab-bb56" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cánope de Enkhil" id="58dc-44aa-0cbd-cda8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de maldición que afecta a todos los hechizos enemigos que permanecen en efecto o permanecen un turno en el campo de batalla. Si el hechizo se resuelve exitosamente, todos esos hechizos quedan inmediatamente dispersados y su efecto cesa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vaso hierático" id="1aa9-c159-0ab1-d958" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3d7e-e815-3588-49f6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b925-88ea-c5a6-f0bd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vaso hierático" id="c7a0-800a-21af-a323" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El personaje puede utilizar el Vaso hierático durante cualquiera de sus fases de magia para lanzar uno de sus hechizos sin invertir ningún dado de Energía. El hechizo será lanzado a su nivel básico de dificultad y podrá ser dispersado normalmente. No es posible lanzar la versión potenciada de un hechizo con este objeto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El Báculo de Usirian" id="83f0-cc80-436c-a721" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="598a-5d7d-a81d-beec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9940-ac2e-9f4b-9393" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El Báculo de Usirian" id="1bf4-c8ee-5a35-c292" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de Daño directo. Traza una línea recta de 18” desde el lanzador. Cualquier miniatura bajo esa línea sufrirá un impacto de Fuerza 6 con la regla especial Golpe letal. Cualquier unidad que sufra al menos una baja como resultado de este hechizo deberá efectuar de inmediato un 
chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Reliquias. Nehekhara" id="40d2-65b5-f646-ef59" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ab9c-3887-152c-3ef8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7ebb-f439-9ef3-46b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte de la guardia oculta" id="b329-3ed5-839b-85b3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c6b2-33d2-8c6d-738b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c30f-e389-2435-c1b0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="100"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="6f09-160d-66af-f984" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Estandarte de la guardia oculta" id="4ab2-058b-5f25-933f" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Puede utilizarse al inicio de cualquiera de tus turnos, antes de declarar las cargas. El poder del estandarte convoca inmediatamente una unidad de 4D3+4 Guardias del sepulcro equipados con Alabarda, Armadura ligera y Escudo. Uno de ellos será un Portaestandarte. Coloca la unidad a 12” o menos del Estandarte de la guardia oculta y a 1” o más de cualquier unidad enemiga. La unidad recién aparecida puede actuar durante el turno en el que aparece, aunque no otorga puntos de victoria al enemigo si es destruida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las arenas" id="b5ec-98b3-00dd-af61" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9587-bec2-79b4-24d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c3f4-3228-01ff-bd53" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="8543-8757-1416-c91f" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Estandarte de las arenas" id="6300-9092-465d-68f3" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los disparos contra el portador y la unidad en la que se encuentre tendrán un penalizador adicional de -2 para impactar y todos los impactos causados por plantillas de área de efecto sobre la unidad y el portador se consideran impactos parciales; los efectos de Tormenta de proyectiles deberán dividir a la mitad el número de impactos causados. Mientras el portador del estandarte siga con vida, todas las unidades enemigas en el campo de batalla tendrán un penalizador de -1 a su Liderazgo en todos sus intentos de reagruparse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Nehekhara" id="7013-f91e-5600-9a59" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="b5ae-09eb-3b12-92ef" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
        <constraint id="3e62-3659-4a96-7424" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pabellón del ojo sagrado" id="cb6d-5bdc-3bda-1a0c" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="0b0a-d31d-5afa-4666" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8fd4-e469-4550-32e0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pabellón del ojo sagrado" id="870d-b775-5e37-6b15" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad en la que se encuentra (incluyendo las monturas) obtienen un bonificador de +1 en sus tiradas para impactar en la primera ronda de cada combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de los espejismos" id="23e9-82bd-4ec8-973f" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="7311-5b7d-1dd5-66eb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9b1c-e3e1-328a-62b2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de los espejismos" id="ab49-6661-73b5-5889" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las tiradas para impactar exitosas contra la unidad durante la fase de disparo enemiga deberán repetirse; los efectos de Tormenta de proyectiles deberán dividir a la mitad el número de impactos causados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Icono de Rakaph" id="8590-7844-1099-051e" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="bb5f-d37f-3c5f-2a91" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1cf8-ecb7-6831-7e66" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Icono de Rakaph" id="a824-cdfc-6d86-667c" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. La unidad que porte el estandarte podrá, al inicio de cualquiera de tus turnos, reorganizarse de forma gratuita y sin efectuar ningún chequeo para ello. Esta reorganización se realiza antes de declarar cargas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las palabras malditas" id="53a8-0a6b-2b94-056b" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="eba1-23fb-b294-9641" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="80af-625b-3009-2b4e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las palabras malditas" id="1291-2174-5914-0608" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los chequeos de Miedo provocados por la unidad se efectuarán con 3D6 y descartando el resultado más bajo (este efecto se anula con la regla especial Sangre fría).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las legiones de Nehekhara" id="8556-6754-cc86-aa4b" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="7082-2e3e-cc43-34d9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8671-84d1-25f6-d8f5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las legiones de Nehekhara" id="3d73-5557-9b83-0787" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Cada vez que la unidad que porta el estandarte restaure miniaturas por un efecto de invocación, tira dos veces los dados y elige el resultado mayor.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de la legión eterna" id="72ad-35c6-622b-294b" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="2c20-fa75-a77d-6f07" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2745-f23f-28cb-8321" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
