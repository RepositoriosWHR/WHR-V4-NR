      <rules>
        <rule name="Ira del creador" id="7733-6ce2-4e31-397d" hidden="false">
          <description>Todas las unidades con la regla especial Constructo amigas a 12” o menos del Necrotecto obtienen la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
        <rule name="Forjador arcano" id="3619-9b94-7240-6c14" hidden="false">
          <description>Al inicio de cada uno de tus turnos, elige una unidad amiga con la regla especial Constructo a 12” o menos del Necrotecto: esta recupera inmediatamente las heridas indicadas en su regla especial No muerto.</description>
        </rule>
      </rules>
