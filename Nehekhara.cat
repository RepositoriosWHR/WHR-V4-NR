            <profile id="e0b6-a2a6-def7-bfa9" name="Kephra azul" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y todas las unidades amigas a 12” o menos del portador obtienen la regla especial Resistencia mágica (1) o la verán incrementada en un punto si ya disponían de ella. Si un hechizo de cualquiera de los Saberes de Magia Oscura es dispersado usando el dado adicional proporcionado por el Kephra azul, tira 1D6: con un resultado de 5+, el hechizo resultará destruido y no podrá utilizarse de nuevo durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="880f-fc55-c1b0-237f" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <entryLinks>
            <entryLink id="9f6b-ebf0-726e-d717" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="9902-1be7-9efa-fcac" name="Objetos hechizados. Nehekhara. Personajes en carro de guerra" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="03e1-4f5c-7eae-54ba" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="22fa-b954-488a-d814" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="4cc8-4ba3-6ab7-bd01" name="Carro de fuego" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5984-6f77-4877-6552" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="88b4-9ccf-b213-7c8e" type="max"/>
          </constraints>
          <profiles>
            <profile id="0ec1-598a-c254-cbe7" name="Carro de fuego" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo personajes montados en Carro de guerra. El Carro de guerra del personaje pasa a causar 1D6 impactos por carga adicionales (para un total de 2D6+1 si cuenta con Cuchillas), que se resuelven con la regla especial Ataques flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f7fe-2143-c435-9ae1" name="Icono del héroe" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c9a2-d569-10cc-a87d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8acd-a038-9642-9029" type="max"/>
          </constraints>
          <profiles>
            <profile id="3654-bf62-cf12-87a1" name="Icono del héroe" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo personajes montados en Carro de guerra. Puede elegirse aunque ya se haya escogido otro Objeto hechizado. La Potencia de unidad del personaje aumenta en +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="10.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="73ea-9b9a-1a64-a2e2" name="Artefactos arcanos. Reliquias. Nehekhara" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0dc7-872c-c1ca-2930" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9c48-b57f-65b1-e381" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="6daa-cb88-9fb1-8779" name="Báculo de las plagas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0029-017c-5900-09b2" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a011-5079-f7a6-0d4d" type="max"/>
          </constraints>
          <profiles>
            <profile id="9c88-54ae-2051-7ea9" name="Báculo de las plagas" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 5. Contiene un hechizo de Daño directo que toma como objetivo a una única unidad enemiga a 18” o menos del portador. El hechizo causa 7D6 impactos de Fuerza 1 que no permiten tirada de salvación por armadura. Cualquier unidad que sufra al menos una baja por efecto de este hechizo deberá realizar inmediatamente un chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="e013-b35b-3d57-ef3b" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="70.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="959d-c77b-3809-64f0" name="Tablillas de los poderosos cánticos de Neferra" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="de33-576c-63f7-8fad" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="61c4-d01d-164b-79b9" type="max"/>
          </constraints>
          <profiles>
            <profile id="0d4c-7a6d-2d06-5eee" name="Tablillas de los poderosos cánticos de Neferra" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador intente lanzar o dispersar un hechizo, puede repetir la tirada de uno de sus dados de 
Energía o Dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="4c16-d250-5648-4458" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="80e3-b1a6-b38d-043b" name="Artefactos arcanos. Nehekhara" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="52c7-72dd-70bc-7ca9" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2c5a-a09b-2b11-547d" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="0531-267f-2e85-06e6" name="Báculo de la maestría" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1c92-c29b-09d2-1bae" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b5f3-1e55-fd3d-42a4" type="max"/>
          </constraints>
          <profiles>
            <profile id="d957-d4e9-5a9e-6f82" name="Báculo de la maestría" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de Maldición que afecta a todos los hechizos enemigos que Permanecen en efecto o Permanecen un turno en el campo de batalla. Si el hechizo se resuelve exitosamente, todos esos hechizos quedan inmediatamente dispersados y su efecto cesa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="0615-f66f-0ccb-9758" name="Cánope de Enkhil" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="781f-8085-7299-82dd" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="cc4f-cb39-46ab-bb56" type="max"/>
          </constraints>
          <profiles>
            <profile id="58dc-44aa-0cbd-cda8" name="Cánope de Enkhil" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de maldición que afecta a todos los hechizos enemigos que permanecen en efecto o permanecen un turno en el campo de batalla. Si el hechizo se resuelve exitosamente, todos esos hechizos quedan inmediatamente dispersados y su efecto cesa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="1aa9-c159-0ab1-d958" name="Vaso hierático" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3d7e-e815-3588-49f6" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b925-88ea-c5a6-f0bd" type="max"/>
          </constraints>
          <profiles>
            <profile id="c7a0-800a-21af-a323" name="Vaso hierático" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El personaje puede utilizar el Vaso hierático durante cualquiera de sus fases de magia para lanzar uno de sus hechizos sin invertir ningún dado de Energía. El hechizo será lanzado a su nivel básico de dificultad y podrá ser dispersado normalmente. No es posible lanzar la versión potenciada de un hechizo con este objeto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="83f0-cc80-436c-a721" name="El Báculo de Usirian" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="598a-5d7d-a81d-beec" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9940-ac2e-9f4b-9393" type="max"/>
          </constraints>
          <profiles>
            <profile id="1bf4-c8ee-5a35-c292" name="El Báculo de Usirian" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 4. Contiene un hechizo de Daño directo. Traza una línea recta de 18” desde el lanzador. Cualquier miniatura bajo esa línea sufrirá un impacto de Fuerza 6 con la regla especial Golpe letal. Cualquier unidad que sufra al menos una baja como resultado de este hechizo deberá efectuar de inmediato un 
chequeo de Pánico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="40d2-65b5-f646-ef59" name="Estandartes mágicos. Reliquias. Nehekhara" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ab9c-3887-152c-3ef8" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7ebb-f439-9ef3-46b2" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="b329-3ed5-839b-85b3" name="Estandarte de la guardia oculta" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c6b2-33d2-8c6d-738b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c30f-e389-2435-c1b0" type="max"/>
          </constraints>
          <profiles>
            <profile id="4ab2-058b-5f25-933f" name="Estandarte de la guardia oculta" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Puede utilizarse al inicio de cualquiera de tus turnos, antes de declarar las cargas. El poder del estandarte convoca inmediatamente una unidad de 4D3+4 Guardias del sepulcro equipados con Alabarda, Armadura ligera y Escudo. Uno de ellos será un Portaestandarte. Coloca la unidad a 12” o menos del Estandarte de la guardia oculta y a 1” o más de cualquier unidad enemiga. La unidad recién aparecida puede actuar durante el turno en el que aparece, aunque no otorga puntos de victoria al enemigo si es destruida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="6f09-160d-66af-f984" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="100.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="b5ec-98b3-00dd-af61" name="Estandarte de las arenas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9587-bec2-79b4-24d3" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c3f4-3228-01ff-bd53" type="max"/>
          </constraints>
          <profiles>
            <profile id="6300-9092-465d-68f3" name="Estandarte de las arenas" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los disparos contra el portador y la unidad en la que se encuentre tendrán un penalizador adicional de -2 para impactar y todos los impactos causados por plantillas de área de efecto sobre la unidad y el portador se consideran impactos parciales; los efectos de Tormenta de proyectiles deberán dividir a la mitad el número de impactos causados. Mientras el portador del estandarte siga con vida, todas las unidades enemigas en el campo de batalla tendrán un penalizador de -1 a su Liderazgo en todos sus intentos de reagruparse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="8543-8757-1416-c91f" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="55.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="7013-f91e-5600-9a59" name="Estandartes mágicos. Nehekhara" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b5ae-09eb-3b12-92ef" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3e62-3659-4a96-7424" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="cb6d-5bdc-3bda-1a0c" name="Pabellón del ojo sagrado" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0b0a-d31d-5afa-4666" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8fd4-e469-4550-32e0" type="max"/>
          </constraints>
          <profiles>
            <profile id="870d-b775-5e37-6b15" name="Pabellón del ojo sagrado" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad en la que se encuentra (incluyendo las monturas) obtienen un bonificador de +1 en sus tiradas para impactar en la primera ronda de cada combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="23e9-82bd-4ec8-973f" name="Estandarte de los espejismos" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7311-5b7d-1dd5-66eb" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9b1c-e3e1-328a-62b2" type="max"/>
          </constraints>
          <profiles>
            <profile id="ab49-6661-73b5-5889" name="Estandarte de los espejismos" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las tiradas para impactar exitosas contra la unidad durante la fase de disparo enemiga deberán repetirse; los efectos de Tormenta de proyectiles deberán dividir a la mitad el número de impactos causados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8590-7844-1099-051e" name="Icono de Rakaph" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="bb5f-d37f-3c5f-2a91" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="1cf8-ecb7-6831-7e66" type="max"/>
          </constraints>
          <profiles>
            <profile id="a824-cdfc-6d86-667c" name="Icono de Rakaph" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. La unidad que porte el estandarte podrá, al inicio de cualquiera de tus turnos, reorganizarse de forma gratuita y sin efectuar ningún chequeo para ello. Esta reorganización se realiza antes de declarar cargas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="53a8-0a6b-2b94-056b" name="Estandarte de las palabras malditas" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="eba1-23fb-b294-9641" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="80af-625b-3009-2b4e" type="max"/>
          </constraints>
          <profiles>
            <profile id="1291-2174-5914-0608" name="Estandarte de las palabras malditas" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los chequeos de Miedo provocados por la unidad se efectuarán con 3D6 y descartando el resultado más bajo (este efecto se anula con la regla especial Sangre fría). </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8556-6754-cc86-aa4b" name="Estandarte de las legiones de Nehekhara" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7082-2e3e-cc43-34d9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="8671-84d1-25f6-d8f5" type="max"/>
          </constraints>
          <profiles>
            <profile id="3d73-5557-9b83-0787" name="Estandarte de las legiones de Nehekhara" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Cada vez que la unidad que porta el estandarte restaure miniaturas por un efecto de invocación, tira dos veces los dados y elige el resultado mayor.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="72ad-35c6-622b-294b" name="Estandarte de la legión eterna" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2c20-fa75-a77d-6f07" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2745-f23f-28cb-8321" type="max"/>
          </constraints>
          <profiles>
            <profile id="4794-6625-5981-53ae" name="Estandarte de la legión eterna" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Cada vez que el portador o su unidad causen una herida como resultado de un Golpe letal exitoso, la unidad recupera una única herida (es un efecto de invocación).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="efd8-9c80-7fbf-0878" name="Pergaminos arcanos" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="6adc-65c8-3d8e-8ffd" name="Pergamino de invocación ultraterrena de Djedra" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c620-d783-e8d0-7615" type="max"/>
            <constraint field="selections" scope="roster" value="-1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="f200-92bd-7ad1-72ce" type="max"/>
          </constraints>
          <profiles>
            <profile id="fa30-9827-4527-f6f9" name="Pergamino de invocación ultraterrena de Djedra" hidden="false" typeId="5602-01f3-6157-f454" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4745-0499-4ee7-094e">Un sólo uso. Objeto portahechizos, nivel de energía 1D3+1. Contiene un hechizo de Potenciación que afecta a una unidad amiga con la regla especial No muerto a 12” o menos del lanzador. Si el hechizo se resuelve con éxito, la unidad afectada recupera inmediatamente el doble de las heridas indicadas en su regla especial No muerto. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d11b-0355-f8b5-57ff" name="Pergamino de la furia sagrada de Khorekhab" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="5cd0-224f-8076-5228" type="max"/>
            <constraint field="selections" scope="roster" value="-1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3c7a-984b-79bd-494e" type="max"/>
          </constraints>
          <profiles>
            <profile id="55f6-4c60-fb06-290d" name="Pergamino de la furia sagrada de Khorekhab" hidden="false" typeId="5602-01f3-6157-f454" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4745-0499-4ee7-094e">Un sólo uso. Objeto portahechizos, nivel de energía 1D3. Contiene la versión normal del hechizo Encantamiento del justo castigo de Ptra, del Saber de Nehekhara.</characteristic>
              </characteristics>
            </profile>
            <profile id="9909-69f3-bcc9-a78b" name="Encantamiento del justo castigo de Ptra" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">Portahechizos nivel 1D3</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">12&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">Permanece un turno</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 12” o menos del lanzador y Permanece un turno. Mientras dure el hechizo, el atributo de Ataques de las miniaturas de la unidad se incrementa en +1 y si están equipada con arcos (de cualquier tipo), obtienen la regla especial Disparos múltiples (2). Puede potenciarse para que afecte a todas las unidades amigas con la regla especial No muerto a 12” o menos del lanzador, en cuyo caso la dificultad será de 18+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="015e-a192-56e3-b4bc" name="Pergamino de la vitalidad de Menkaure" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="26ab-23ea-26be-31ac" type="max"/>
            <constraint field="selections" scope="roster" value="-1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="d418-5d65-1f24-f420" type="max"/>
          </constraints>
          <profiles>
            <profile id="3b0f-0114-1779-272b" name="Pergamino de la vitalidad de Menkaure" hidden="false" typeId="5602-01f3-6157-f454" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4745-0499-4ee7-094e">Un sólo uso. Objeto portahechizos, nivel de energía 1D3. Contiene la versión normal del hechizo Encantamiento del viento desértico de Khsar, del Saber de Nehekhara.</characteristic>
              </characteristics>
            </profile>
            <profile id="24b9-f273-573d-2f9d" name="Encantamiento del viento desértico de Khsar" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">Portahechizos nivel 1D3</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">18&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 18” o menos del lanzador. La unidad podrá realizar inmediatamente un movimiento como si se encontrase en la sub-fase de Resto de movimientos de su fase de movimiento, una carga como si se encontrase en la sub-fase de declaración de cargas de su fase de movimiento o disparar como si se encontrase en la fase de disparo. Puede potenciarse para que afecte a todas las unidades amigas con la regla especial No muerto a 12” o menos del lanzador, en cuyo caso la dificultad será de 19+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
