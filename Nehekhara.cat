    <selectionEntry id="2de4-859c-d83c-5a72" name="Acechadores sepulcrales" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="ba65-050a-5789-9a5f" value="3.0">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="170b-06ad-215f-f891" type="equalTo"/>
          </conditions>
        </modifier>
        <modifier type="set" field="ba65-050a-5789-9a5f" value="4.0">
          <conditions>
            <condition field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="3673-aaa8-d1d9-e6c2" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="2.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ba65-050a-5789-9a5f" type="max"/>
      </constraints>
      <rules>
        <rule id="96e5-22e1-5d27-81d7" name="Mirada maldita" hidden="false">
          <description>Se trata de un ataque de disparo con un alcance de 10”. En lugar de tirar para impactar, tira el dado de artillería por cada Acechador sepulcral y suma los resultados: ese será el número de impactos automáticos que causen los Acechadores sepulcrales (se trata de un efecto de Tormenta de proyectiles), que se resolverán con Fuerza 2 con la regla especial Ataques mágicos que no permiten tirada de salvación por armadura. Por cada resultado de problemas, los Acechadores sepulcrales sufrirán una herida sin tirada de salvación por armadura. Este ataque no afecta a miniaturas con la regla especial Etéreo.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f257-6841-0851-3758" name="No Muerto (1D2)" hidden="false" targetId="b314-335e-6db5-cb02" type="rule"/>
