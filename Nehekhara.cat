    <selectionEntry id="48c9-ea93-c78b-0bc5" name="Necroesfinge" hidden="false" collective="false" import="true" type="unit">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2179-0a6b-e6d7-c17f" type="max"/>
      </constraints>
      <rules>
        <rule id="d494-6c55-6eb0-3f3d" name="Piel de piedra" hidden="false">
          <description>Esta regla especial proporciona a la Necroesfinge una tirada de salvación por armadura de 4+ que, combinada con la regla especial Constructo, totaliza una tirada de salvación por armadura de 2+.</description>
        </rule>
        <rule id="b42c-4b31-c2c4-a3c8" name="Golpe decapitador" hidden="false">
          <description>El ataque adicional de la Necroesfinge se resuelve con Fuerza 10 y la regla especial Golpe letal heroico.</description>
        </rule>
        <rule id="44df-84c7-533c-f3f4" name="Avatar de Usirian" hidden="false">
          <description>Siempre que una Necroesfinge ataque en combate cuerpo a cuerpo a tropas que no sean de las categorías Infantería o Enjambres podrá repetir los resultados de 1 en sus tiradas para impactar.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="111c-9e14-1af5-e14a" name="No muerto" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
