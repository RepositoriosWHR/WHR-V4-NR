    <selectionEntry name="Arca de las almas" id="5d09-19ce-8dc0-6cb4" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Terror" id="12b6-fc8b-fc6f-6f63" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Resistencia mágica (2)" id="277c-5afd-5ff5-c434" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
        <infoLink name="No muerto" id="3aac-136b-52be-3f86" hidden="false" targetId="3d39-5d46-7335-225c" type="rule"/>
        <infoLink name="Indesmoralizable" id="8444-9af9-ec6d-58f2" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink name="Constructo" id="4ea6-eeae-34a7-328d" hidden="false" targetId="9623-395d-eb61-efd6" type="rule"/>
        <infoLink name="Carro" id="9096-b6d0-7184-5841" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Potencia de unidad 4" id="8bf7-ca57-14e6-64c7" hidden="false">
          <description>Potencia de unidad 4</description>
        </rule>
        <rule name="Tirada de salvación 4+" id="bdca-2da1-0ffc-bccc" hidden="false">
          <description>Tirada de salvación por armadura 4+.</description>
        </rule>
        <rule name="Arca de las almas" id="3879-dd27-07a3-87bd" hidden="false">
          <description>Un Arca de las Almas no puede mover, y el sumo sacerdote asignado a ella tampoco puede mover mientras el Arca de las Almas siga sobre el campo de batalla. Pese a considerarse un Carro, el Arca de las Almas no puede mover, y no tiene bestias que tiren de ella. El Arca posee una tirada de salvación espeical de 4+, y se la proporciona también al sumo sacerdote.</description>
        </rule>
        <rule name="Pacto de poder" id="a558-4b83-77a3-741b" hidden="false">
          <description>Al inicio de cada fase de magia propia, un Arca de las Almas genera 1D3 dados de energía adicionales para tu bando.</description>
        </rule>
        <rule name="Espíritus de los condenados" id="90cf-84e3-7ace-e857" hidden="false">
          <description>Al inicio de cada una de tus fases de disparo, puedes liberar el poder de los espíritus atrapados en el Arca. Esto afecta a todas las unidades enemigas en el campo de batalla que tengan línea de visión hacia el Arca. Por cada una de esas unidades tira 2D6+2 y resta el liderazgo del objetivo: esas son las heridas causadas sin tirada de salvación por armadura. Cualquier unidad que sufra al menos una baja como consecuencia de este ataque deberá realizar inmediatamente un chequeo de pánico.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Arca de las almas" id="d3f7-f024-75b6-f132" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2963-edeb-1e89-54f6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
