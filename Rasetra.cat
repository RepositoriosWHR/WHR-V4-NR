      <constraints>
        <constraint id="d60c-93a6-dee6-250a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="8dd3-c058-df05-c7a6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Kephra azul" id="8763-7811-1e52-327f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ef52-8bcd-b916-a297" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="287d-03c8-6bb7-a780" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="52ef-278f-49d0-d301" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Resistencia mágica (1)" id="15fd-47ed-aa48-0182" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Kephra azul" id="9699-d1e9-7965-ed41" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y todas las unidades amigas a 12” o menos del portador obtienen Resistencia mágica (1), o verán incrementada su Resistencia mágica en un punto si ya disponían de ella. Si un hechizo del Viento de Magia Oscura, es dispersado usando el dado adicional proporcionados por el Kephra Azul, tira 1D6: con un resultado de 5+, el hechizo resultará destruido y no podrá utilizarse de nuevo durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Pergaminos arcanos" id="0ae8-ece9-2ed1-b786" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="895b-54b9-82fb-e624" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="-1"/>
        <constraint id="dbd9-c06d-223d-81e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pergamino de invocación ultraterrena de Djedra" id="29cd-49ca-0f61-68f2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="10e0-7676-34a3-aaea" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="-1"/>
            <constraint id="8d78-6a1d-18c6-d087" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de invocación ultraterrena de Djedra" id="1025-7fda-412d-bc17" hidden="false" typeId="3515-cd55-95a5-ea4a" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="de6f-f98b-188a-33fd">Un sólo uso. Objeto portahechizos, nivel de energía 1D3+1. Contiene un hechizo de Potenciación que afecta a una unidad amiga con la regla especial No muerto a 12” o menos del lanzador. Si el hechizo se resuelve con éxito, la unidad afectada recupera inmediatamente el doble de las heridas indicadas en su regla especial No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino de la furia sagrada de Khorekhab" id="7e3e-e2e1-4813-7888" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a58c-2aab-64db-6fe4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="-1"/>
            <constraint id="4bd6-f89e-1af9-7eb0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de la furia sagrada de Khorekhab" id="0dc8-e1bd-7753-9790" hidden="false" typeId="3515-cd55-95a5-ea4a" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="de6f-f98b-188a-33fd">Un sólo uso. Objeto portahechizos, nivel de energía 1D3. Contiene la versión normal del hechizo Encantamiento del justo castigo de Ptra, del Saber de Nehekhara.</characteristic>
              </characteristics>
            </profile>
            <profile name="Encantamiento del justo castigo de Ptra" id="514e-8a7f-2aed-cc23" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">Portahechizos nivel 1D3</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">12&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">Permanece un turno</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 12” o menos del lanzador y Permanece un turno. Mientras dure el hechizo, el atributo de Ataques de las miniaturas de la unidad se incrementa en +1 y si están equipada con arcos (de cualquier tipo), obtienen la regla especial Disparos múltiples (2). Puede potenciarse para que afecte a todas las unidades amigas con la regla especial No muerto a 12” o menos del lanzador, en cuyo caso la dificultad será de 18+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino de la vitalidad de Menkaure" id="2b3f-679c-b340-c44a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c39a-95d3-04d0-56ce" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="-1"/>
            <constraint id="e1cd-c5a4-9d4a-d0ce" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pergamino de la vitalidad de Menkaure" id="afa7-a625-656b-22a9" hidden="false" typeId="3515-cd55-95a5-ea4a" typeName="Pergamino arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="de6f-f98b-188a-33fd">Un sólo uso. Objeto portahechizos, nivel de energía 1D3. Contiene la versión normal del hechizo Encantamiento del viento desértico de Khsar, del Saber de Nehekhara.</characteristic>
              </characteristics>
            </profile>
            <profile name="Encantamiento del viento desértico de Khsar" id="17a3-5837-ba30-e4d8" hidden="false" typeId="aa67-99ab-2618-c451" typeName="Hechizo">
              <characteristics>
                <characteristic name="Tipo" typeId="3b39-64e9-beb6-7abc">Potenciación</characteristic>
                <characteristic name="Dificultad" typeId="e3cf-4d57-0b28-a094">Portahechizos nivel 1D3</characteristic>
                <characteristic name="Rango" typeId="544c-fa75-b146-79c4">18&quot;</characteristic>
                <characteristic name="Duración" typeId="bd4f-3a08-5f1c-a7c7">-</characteristic>
                <characteristic name="Efecto" typeId="43ea-afef-1216-a118">Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga con la regla especial No muerto a 18” o menos del lanzador. La unidad podrá realizar inmediatamente un movimiento como si se encontrase en la sub-fase de Resto de movimientos de su fase de movimiento, una carga como si se encontrase en la sub-fase de declaración de cargas de su fase de movimiento o disparar como si se encontrase en la fase de disparo. Puede potenciarse para que afecte a todas las unidades amigas con la regla especial No muerto a 12” o menos del lanzador, en cuyo caso la dificultad será de 19+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Rasetra" id="c04a-9c67-7b1b-4d7f" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4583-db37-2227-900f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="40fe-c532-1977-2546" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Amuleto de Pha-Stah" id="0ac9-ac41-b474-45e7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="718d-47ce-d4e6-cf18" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ff73-14a0-d120-55a9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de Pha-Stah" id="aff8-9f8c-5cba-ecb6" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cualquier Talismán, Objeto hechizado o Artefacto arcano que porte cualquier miniatura (amiga o enemiga) en contacto peana con peana con el portador deja de funcionar y se considera un objeto mundano de su mismo tipo (tan sólo mientras permanezcan en contacto peana con peana). El portador no puede llevar ningún artefacto arcano u objeto hechizado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pectoral de Shapesh" id="60c6-b407-dbde-d4c7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2841-d2fa-d25e-3289" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4a7f-d16b-d4e4-d079" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pectoral de Shapesh" id="ee74-3bbc-fb82-80e8" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Cada vez que el portador fuese a sufrir una herida (tras las tiradas de salvación y regeneración pertinentes), tira 1D6: con un resultado de 1-3, la herida se asigna al personaje de manera habitual. Con un resultado de 4+, la herida se asigna en su lugar a una miniatura amiga de tu elección a 8” o menos del portador. Ten en cuenta que una herida reasignada no puede salvarse o evitarse de ninguna manera. Si no hay otras miniaturas amigas a 8” o menos del portador, el Pectoral de Shapesh no tiene efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello de invocación de Djedra" id="cc19-1dee-0e3d-9caf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8716-3578-bdfd-3219" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2253-c22e-3adb-0e2d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sello de invocación de Djedra" id="2e3d-2be5-646e-e3c0" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Al inicio de cada una de tus fases de magia, elige una unidad amiga a 12” o menos del portador: dicha unidad restaura inmediatamente tantas heridas como se indica en su regla especial No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vial sagrado" id="14d8-387c-70f7-46c0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="680e-968f-2f97-50f1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="435b-33c2-daf0-1cfc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vial sagrado" id="df3e-2986-762c-65b7" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Si el portador o la unidad en la que se encuentre es objetivo o se verá afectado por un hechizo de Proyectil mágico, Daño directo o Maldición, todos los resultados de 6 obtenidos en los dados de energía de lanzamiento de dicho hechizo se consideran resultados de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escarabeo de la Vida" id="4662-71a1-f928-0064" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a8b1-7fd3-3b52-bd33" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="946f-ac21-66b8-54c9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (6+)" id="34e9-5b14-e5e6-08de" hidden="false" targetId="4aee-7485-a141-cd20" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Escarabeo de la vida" id="6758-2238-d8c7-ed94" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene la regla especial Regeneración (6+), o un bonificador de +1 a sus tiradas de Regeneración si ya disponía de ella (hasta un máximo de 3+ como es habitual). Además, podrá repetir sus tiradas fallidas de Regeneración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Reliquias. Rasetra" id="2125-86fe-66eb-9e79" collective="false" hidden="false" import="true">
