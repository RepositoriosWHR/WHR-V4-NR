          <profiles>
            <profile name="Tomo sagrado de Sebayet" id="ae5f-9ed4-60f1-e824" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo General del ejército. Al inicio de la batalla, antes del despliegue, elige una unidad de tu ejército: dicha unidad obtendrá la regla especial Vanguardia. Además, ninguna unidad enemiga con la regla especial Exploradores podrá desplegar a 18” o menos del portador de este objeto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
