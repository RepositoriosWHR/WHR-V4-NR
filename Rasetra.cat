            <profile name="Khopesh del Pueblo de las Montañas" id="5671-5c21-2ef3-df1e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques con este Khopesh se resuelven con +1 Fuerza y no permiten tirada de salvación por armadura. Además, contra No muertos, sus impactos se resuelven con la regla especial Heridas múltiples (1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
