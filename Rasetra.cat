      <rules>
        <rule name="Bendición de Ksar" id="591c-c790-4db7-139c" hidden="false">
          <description>Pese a ser inmunes a la psicología, pueden reaccionar a una carga aguantando y disparando, huyendo o disparando y huyendo, además de manteniendo la posición. Se reagrupan automáticamente.</description>
        </rule>
      </rules>
