          </entryLinks>
          <infoLinks>
            <infoLink name="Regeneración (4+)" id="21f0-68fe-0abd-5c32" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
            <infoLink name="Inmune al fuego" id="2704-a7be-c83b-195f" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Ankhra dorada" id="f29f-1b63-fa06-678c" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene las reglas especiales Regeneración (4+) e Inmune al fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Rasetra. Cantor de guerra y Gran salmodiador" id="72eb-7832-2576-5161" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5bb4-5664-0dcd-0b46" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="fe4c-64fa-c3b1-4b44" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Gargantilla de Neferra" id="249c-3bac-890e-5064" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3ab8-a73d-6913-05d7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8132-b1c2-8a30-33fe" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gargantilla de Neferra" id="5948-2b39-144a-5781" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo cantores de guerra y grandes salmodiadores; puede elegirse como objeto mágico para éstos pese a ser un Artefacto arcano. El portador puede repetir cualquiera de los dados al lanzar un cántico de guerra (puede repetir tanto el dado de energía invertido como el nivel de energía, o ambos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Rasetra. Jinetes lagarto del trueno o Jinetes del rey" id="cc9b-fdc6-db83-3eac" collective="false" hidden="false" import="true">
