            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Khatep el eterno, sumo hierofante de Khemri" id="8994-9445-e1ab-8579" hidden="false">
          <description>Khatep el Eterno es un hechicero de nivel 4 que conoce todos los hechizos del Saber de Nehekhara.</description>
        </rule>
        <rule name="Sumo hierofante" id="43de-6f49-88b7-8f3b" hidden="false">
          <description>Khatep posee la regla especial Regeneración (4+). Cualquier unidad a la que se una obtendrá la regla especial egeneración (5+) en lugar del 6+ habitual por tener al Hierofante en la unidad.</description>
        </rule>
        <rule name="Magia ritual" id="05a1-2ffb-ffd2-a69b" hidden="false">
          <description>Cada vez que Khatep realice una tirada en la tabla de Disfunciones mágicas, tira 1D3 adicional y añádelo al resultado de la tirada. Si obtienes un resultado superior a 12, la Disfunción mágica no tendrá efecto.</description>
        </rule>
      </rules>
