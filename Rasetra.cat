            <profile name="Manto de las dunas" id="daa1-ac01-7230-9b8b" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo sacerdotes funerarios. El portador obtiene la regla especial Volar(10).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Reliquias. Rasetra" id="8533-37b5-ce44-6602" collective="false" hidden="false" import="true">
