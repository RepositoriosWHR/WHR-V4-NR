              <modifiers>
                <modifier field="name" type="append" value="(Nehekhara)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Tablillas del conocimiento" id="6426-c27f-70c4-5c39" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene la regla especial Señor del Conocimiento (Nehekhara).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
