              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Golpe letal. Cada vez que el portador elimine a un oponente en combate cuerpo a cuerpo con un golpe letal, el atributo de heridas de éste aumenta permanentemente en un +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
