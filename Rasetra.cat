          <profiles>
            <profile name="Báculo de la maestría" id="aba6-e4fa-b88e-2fc1" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador siempre canaliza dados de energía o dispersión con un resultado de 2+, sin tener en cuenta otros modificadores.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cánope de Enkhil" id="7ccc-d948-50dc-2a0d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0285-0946-b788-d168" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cdd4-1280-dcb5-2c51" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cánope de Enkhil" id="f5bb-4a57-1c56-e806" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de maldición que afecta a todos los hechizos enemigos que permanecen en efecto o permanecen un turno en el campo de batalla. Si el hechizo se resuelve exitosamente, todos esos hechizos quedan inmediatamente dispersados y su efecto cesa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vaso hierático" id="3905-743a-53d5-22aa" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5ee8-be97-914f-375f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e245-3883-8eef-cdaa" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vaso hierático" id="b53e-c3ed-e8da-7f10" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El sacerdote puede utilizar el Vaso Hierático durante cualquiera de sus fases de magia, para lanzar uno de sus hechizos sin invertir ningún dado de energía. El hechizo será lanzado a su nivel básico de dificultad, y podrá ser dispersado normalmente. No es posible lanzar la versión potenciada de un hechizo con este objeto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Placa dorada de la jungla" id="0172-a457-5f56-2e69" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c019-d224-c46c-eb93" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="fb2d-1d26-3911-1dfb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Placa dorada de la jungla" id="03e9-232f-cad9-9afc" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador lance un hechizo, la placa generará un dado de energía adicional para ese hechizo(no cuenta para el límite habitual de dados del hechicero).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tablillas del conocimiento" id="014b-96a1-9498-fb74" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="97bb-a3cc-460c-d2f1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d7db-1f26-9f9f-9669" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
