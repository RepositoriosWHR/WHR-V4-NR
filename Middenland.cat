          <entryLinks>
            <entryLink name="Reliquia" id="53bb-c4cc-bf00-2e8a" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Arma de mano" id="fee5-1a69-ba21-acda" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Golpe letal" id="1d84-d276-be37-63dd" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Furia de Ulric" id="02e4-b3b9-d2ac-0468" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques efectuados con este martillo se resuelven con un bonificador de +2 a la Fuerza y tienen la regla Golpe letal. Por cada miniatura enemiga retirada como baja a causa de heridas causadas por este martillo, el portador podrá realizar de inmediato un ataque adicional, esos ataques adicionales no podrán producir a su vez nuevos ataques adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Middenland. Arma a dos manos" id="d854-b680-0e1d-f4b9" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="6727-111c-7905-6b37" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="077d-1565-7d7b-839e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Hachan Negra de la Desolación" id="ca01-f944-a31b-bd15" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="18b9-9686-d52c-0396" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b372-1304-953f-f73d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma a dos manos" id="6c38-7e2a-798b-fa11" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
            <infoLink name="Heridas múltiples (1D3)" id="bdf4-97d5-5ff2-c24a" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Hachan Negra de la Desolación" id="074e-19f2-0a8a-09f9" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Los ataques efectuados por el portador con esta arma obtendrán la regla especial Heridas Múltiples (1D3). Además, su portador podrá repetir las tiradas para herir contra miniaturas con la clave (Caos). Todas las miniaturas con la regla especial Envueltos en Niebla obtendrán la regla especial Odio frente al portador de esta arma mágica y obtendrán 100 puntos de victoria adicionales al final de la batalla si uno de ellos logra derrotar al portador del arma en Desafío. Además, las heridas causadas con este arma matan si causan al menos una herida a miniaturas con la regla especial Envueltos en niebla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Martillo Aullante" id="a45e-7cfd-82e9-682d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6bb9-4870-8556-9732" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4a48-8df8-5ea9-c412" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
