        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="4563-c8b3-ba09-448e" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5926-943c-129c-e105" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="d35d-d6bf-55d3-3c0e" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink name="Habitantes del Drakwald" id="31a8-1c81-e319-2017" hidden="false" targetId="b764-ec88-2172-5311" type="rule"/>
        <infoLink name="Golpe letal" id="ab57-550b-685b-6265" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Combate)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Inmune al pánico" id="c2fb-17b0-ec5a-4063" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
        <infoLink name="Odio (todos los enemigos)" id="54b7-eff5-0025-ca08" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Subordinado" id="3b3e-a649-877b-f51b" hidden="false">
          <description>No puede ser el general del ejército si se incluye otro personaje sin esta regla).</description>
        </rule>
        <rule name="Juez y verdugo" id="f5fc-9dee-07e4-87eb" hidden="false">
          <description>Tiene las reglas especiales Odio (¡todos los enemigos!) e Inmune a pánico. Si se incluye en una unidad, ésta ganará la regla especial Odio (¡todos los enemigos!) mientras el Campeón Judicial permanezca con vida. Esto no afecta a otros personajes. No puede unirse a unidades con la regla especial El culto de Ulric.</description>
        </rule>
        <rule name="Duelista" id="39dd-b9fa-fbf2-4b17" hidden="false">
          <description>El campeón judicial se verá obligado a aceptar desafíos lanzados por su oponente, pero no está obligado a lanzarlos. El Campeón judicial puede repetir las tiradas para impactar fallidas cuando participa en un Desafío.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Campeón Judicial" id="b976-dbb8-3f1d-67f8" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="fdd8-6e73-ce0b-d080" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="55d0-479e-0b32-4836" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="85"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
