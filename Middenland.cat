      </infoLinks>
      <rules>
        <rule name="Plegarias Sacerdote de Ulric" id="9323-e58c-ab19-2fc2" hidden="false">
          <description>Un Sacerdote de Ulric conoce todas las plegarias a Ulric y puede lanzar una de ellas por fase de magia propia con Nivel de energía 3.</description>
        </rule>
        <rule name="Azote de indignos" id="d2fb-cdb1-e28c-6b0d" hidden="false">
          <description>Tiene la regla Aplastar al débil, la cual confiere a la unidad a la que esté unido.</description>
        </rule>
      </rules>
