                      </infoLinks>
                      <rules>
                        <rule name="Cañón tanque a vapor imperial" id="ef19-15b6-498d-8ab4" hidden="false">
                          <description>El Cañón funciona como un Cañón normal que estima hasta 10 dados y sus impactos se resuelven con F10 y Heridas múltiples (1D6) (si obtienes un resultado de Problemas, tira 1D6+los Puntos de vapor de ese turno+las heridas que lleve hechas el tanque +1 en la tabla de la Caldera).</description>
                        </rule>
                      </rules>
                    </selectionEntry>
                    <selectionEntry name="Cañón de vapor" id="e3c1-430a-b57c-6989" collective="false" hidden="false" import="true" type="upgrade">
