      <rules>
        <rule name="Favor de Ulric" id="b78c-9567-6ad5-e7b9" hidden="false">
          <description>Vorn obtiene salvación especial de 4+ y tiene las reglas especiales Ataques Mágicos, Inmune a miedo e Inmune a Pánico.</description>
        </rule>
        <rule name="Devoto de Ulric" id="200e-2dff-cc08-8853" hidden="false">
          <description>Vorn Thugenheim debe ser obligatoriamente el Portaestandarte de batalla y pertenece a la de la Orden de caballería de los Caballeros del Lobo Blanco.</description>
        </rule>
        <rule name="Presencia de Mando" id="a589-6e07-5ca2-44d1" hidden="false">
          <description>Únicamente puede unirse a unidades que pertenezcan a la Orden de los Caballeros del Lobo Blanco o a cualquier unidad con la regla especial El culto de Ulric.</description>
        </rule>
      </rules>
