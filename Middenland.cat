              <rules>
                <rule name="Estandarte condal (Comandante)" id="056a-b037-54a1-7a2a" hidden="false">
                  <description>Una unidad de Espadachines, Lanceros, Ballesteros, Arqueros, Fusileros o Alabarderos puedan equiparse con un estandarte mágico de hasta 50 puntos en lugar de los 25 puntos habituales.</description>
