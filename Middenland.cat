          <infoLinks>
            <infoLink name="Arma de mano" id="3bb3-fdf1-8e94-c4ef" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espada de Segismundo" id="8863-9e0e-1fb7-d658" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El portador tendrá un bonificador de +1F en combate cuerpo a cuerpo, y aumentará su I hasta 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Esencia de Invierno" id="fc0f-13e0-e018-6e8c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5f32-3743-9809-835b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="669a-5220-e0ca-f625" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
