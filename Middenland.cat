    <selectionEntryGroup name="Talismanes de Ulric" id="e073-d5b4-657a-c361" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="85c8-6535-e43b-9d90" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="67f7-7226-fbb9-d0c4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Fragmento de Skoll" id="4dd6-47fc-ad7d-4a3a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eb0d-426e-0fff-ea46" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Fragmento de Skoll" id="1795-a23e-78ea-71ad" hidden="false" typeId="a55d-2199-82f9-73d2" typeName="Talismán de Ulric">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4770-7b42-f25f-a700">Un sólo uso. Debes declarar que usas el Fragmento de Skoll cuando el oponente lance exitosamente un hechizo, pero antes de efectuar la tirada para dispersar. El portador obtendrá Resistencia a la magia (3) pero solo contra ese hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Emblema de Cabeza de Lobo" id="c3a2-78a5-a996-edac" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="da7d-68bc-a6a3-b2ae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Emblema de Cabeza de Lobo" id="0d49-64c1-48cf-913f" hidden="false" typeId="a55d-2199-82f9-73d2" typeName="Talismán de Ulric">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4770-7b42-f25f-a700">Al inicio de cada fase de magia del jugador adversario, en la subfase de canalizar, tira 1D6: a 4+, el Emblema de Cabeza de Lobo genera un Dado de dispersión para tu reserva de dados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colmillo de Lobo invernal" id="c504-e0da-4f92-a8b8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5837-941c-a7d6-1a08" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (5+)" id="811d-0569-8d0b-dd25" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Colmillo de Lobo invernal" id="d212-0a19-ea50-5fcb" hidden="false" typeId="a55d-2199-82f9-73d2" typeName="Talismán de Ulric">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4770-7b42-f25f-a700">Un solo uso. Debes declarar que usas el Colmillo del Lobo Invernal antes de lanzar una plegaria con su portador. Si el portador es un Paladín de Ulric conocerá todas las plegarias de Ulric cuando haga uso del Colmillo del Lobo invernal. La plegaria será lanzada con fuerza irresistible salvo que en el Dado de energía que se utilice para calcular el nivel de energía se obtenga un resultado natural de 1, en cuyo caso el lanzamiento falla. Pese a ser lanzada con fuerza irresistible no provoca una disfunción mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colmillo ámbar" id="f99e-c87f-a2d5-9ef9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="730a-631b-75e8-ac8d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Colmillo ámbar" id="4e62-786c-c91e-d225" hidden="false" typeId="a55d-2199-82f9-73d2" typeName="Talismán de Ulric">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4770-7b42-f25f-a700">Permite a su portador lanzar una plegaria adicional por fase de magia. Si su portador es un Paladín de Ulric, conocerá todas las plegarias de Ulric y podrá lanzar una de ellas por fase de magia propia con Nivel de energía 3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Daga de los Teutógenos" id="3072-40a3-cd3c-45fb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9fe8-7967-606c-b544" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (5+)" id="973d-d018-59b3-e3dc" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Daga de los Teutógenos" id="2b60-066b-180e-0606" hidden="false" typeId="a55d-2199-82f9-73d2" typeName="Talismán de Ulric">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4770-7b42-f25f-a700">Una plegaria a Ulric cuyo lanzador se encuentre unido a una unidad en la que cualquier personaje que pertenezca a la misma unidad porte La Daga de los Teutógenos verá aumentado su nivel de energía en un bonificador igual a bonificador por filas de la unidad (hasta un máximo de +3). Adicionalmente, si el portador de La Daga de los Teutógenos tiene como montura el Altar de Ulric, sumará +1D3 al nivel de energía de cada plegaria que lance.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Reliquias. Middenland. Comandante. Arma de mano" id="dfbf-721f-2b19-84b7" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f7df-0646-43f4-c5de" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="b0bb-7608-47f9-3e8d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Muerdepiernas, colmillo rúnico de Middenland" id="e7e2-dd39-d21d-e59d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ee5e-aeaf-aaaf-3e39" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="cdbd-fe51-4101-0303" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="100"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="267d-3495-0e2e-d1ee" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Arma de mano" id="e44d-1a8a-22ee-425f" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Heridas múltiples (2)" id="8677-d971-69ff-0577" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(No muerto)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditionGroups>
                <conditionGroup type="or">
                  <conditions>
                    <condition childId="3dbc-5db6-fec2-2b21" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
                    <condition childId="be5e-2ab7-9727-1c8b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </conditionGroup>
              </conditionGroups>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Muerdepiernas, colmillo rúnico de Middenland" id="71f2-a9eb-86e8-99d2" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo Comandante del Imperio. Si el ejército incluye a Boris Todbringer o a Lothar Metternich el Colmillo Rúnico de Middenland no podrá ser usado por otro personaje salvo por el propio Boris o Lothar Metternich. Arma de mano. Los impactos causados por un Colmillo Rúnico hieren automáticamente (no es necesario efectuar la tirada para herir) y no permiten tirada de salvación por armadura. Además, tiene la regla especial Heridas múltiples (2) contra miniaturas con la regla especial No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Reliquias. Middenland. Arma de mano" id="01fa-c97d-c061-4ee9" collective="false" hidden="false" import="true">
      <constraints>
