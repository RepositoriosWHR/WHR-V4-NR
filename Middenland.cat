              <profiles>
                <profile name="Martillo Rúnico de Obsidiana" id="8a55-8499-2e50-7e38" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Martillo del Lobo Blanco. Al atacar con este arma el Jerek realiza 1 Ataque adicional. Los ataques realizados con este arma se resuelven con un bonificador de +1 a la iniciativa. Si impacta a un enemigo equipado con un arma mágica, esta quedará anulada mientras el portador se encuentre peana con peana con Jerek y pasará a considerarse un arma mundana de su mismo tipo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Fragmento de Skoll" id="f5d3-f481-9498-3670" collective="false" hidden="false" import="true" type="upgrade">
