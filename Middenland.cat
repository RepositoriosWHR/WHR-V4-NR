          <modifiers>
            <modifier field="name" type="append" value="(Combate)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Odio (todos los enemigos)" id="0cf9-950f-ba8f-7d8e" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
        <infoLink name="Inmune a la psicología" id="0af6-759d-fb34-8952" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Subordinado" id="d51b-c229-81d4-3409" hidden="false">
          <description>Olaf no puede ser el general del ejército si se incluye otro personaje sin esta regla.</description>
        </rule>
        <rule name="Duelista" id="d22a-85e3-ce42-8e52" hidden="false">
          <description>Olaf se verá obligado a aceptar desafíos lanzados por su oponente, pero no está obligado a lanzarlos. Olaf puede repetir las tiradas para impactar fallidas cuando participa en un Desafío.</description>
        </rule>
        <rule name="Juez y Verdugo de Middenlehim" id="c502-869d-b3bc-baab" hidden="false">
          <description>Tiene las reglas especiales Odio (¡todos los enemigos!) e Inmune a psicología. Si se incluye en una unidad, ésta ganará la regla especial Odio (¡todos los enemigos!) mientras Olaf permanezca con vida. Esto no afecta a otros personajes. Olaf, a diferencia de otros Campeones Judiciales de Middenland, si puede unirse a unidades con la regla especial El culto de Ulric.</description>
        </rule>
      </rules>
