            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Talismán de la garra" id="89fc-d93c-21ab-f70e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y la unidad donde se encuentre unido podrán repetir la tirada de dados para calcular la distancia cuando realice un movimiento de carga, persecución o arrasamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pellejo de Horros" id="7c1d-28a1-82cd-2ba2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="73a0-8098-5ea2-1e77" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="57ce-a855-4b56-024f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
