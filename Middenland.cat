          <selectionEntries>
            <selectionEntry name="Tropas de Middenland" id="4ba4-d962-ce40-5063" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="71b0-3939-55d6-4e24" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
