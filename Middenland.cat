        <rule name="Plegarias Sumo sacerdote de Ulric" id="44c3-4744-c40b-534a" hidden="false">
          <description>Un Sumo Sacerdote de Ulric conoce todas las plegarias a Ulric y puede lanzar dos de ellas por fase de magia propia con Nivel de energía 4.</description>
        </rule>
        <rule name="Azote de indignos" id="0d78-e371-e468-ae21" hidden="false">
          <description>Tiene la regla Aplastar al débil, la cual confiere a la unidad a la que esté unido.</description>
        </rule>
      </rules>
