    <selectionEntry name="Cañón de salvas Hellblaster" id="7fb0-c091-55a6-2cdb" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="7649-52b1-0c06-6cb4" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
