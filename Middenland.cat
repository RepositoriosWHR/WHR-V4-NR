            <infoLink name="Miedo" id="2b3b-b2a2-2bba-6481" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Martillo Aullante" id="3d68-7c92-cf7a-b551" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. El portador del Martillo Aullante Causa Miedo y obtiene +1 HA.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
