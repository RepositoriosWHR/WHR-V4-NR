            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Miedo" id="b623-97eb-7e49-916a" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pellejo de Horros" id="04a1-0af7-81d5-e9bc" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene +1 en el atributo de Fuerza y causa Miedo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espejo de Van Horstmann" id="b4d4-ca44-26c8-1bcd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ea2e-1e4b-f8d9-5b58" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="91b8-95c2-e9cc-859b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Espejo de Van Horstmann" id="8112-1543-64a0-1dbe" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo funciona cuando el personaje se encuentra trabado en un Desafío. El portador puede intercambiar con su oponente sus atributos de Habilidad de armas, Fuerza, Resistencia, Iniciativa y Ataques hasta el final de la fase de combate cuerpo a cuerpo. Debe intercambiar todos esos atributos o no intercambiar ninguno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bastón de mando" id="0127-2b42-dfc5-45c0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7b0c-392e-537c-b0e7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="fc7a-e8d1-420c-e3c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bastón de mando" id="c3e3-9505-f5b9-a940" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. El portador puede utilizar el bastón antes de efectuar un chequeo de desmoralización: si lo hace, superará el chequeo automáticamente. No puede utilizarse el bastón en la misma fase de combate en la que el portador haya rehusado un desafío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Retazo de la capa Van Horstmann" id="3511-dc7b-5f90-5091" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8404-e2cf-8bd7-0322" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8572-f503-3e8e-8b49" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Retazo de la capa Van Horstmann" id="456d-0899-bcbd-13ef" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Los enemigos en contacto peana con peana con el portador deberán repetir sus tiradas de salvación especial exitosas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Anillo de Volans" id="3b8f-69ec-28a2-0020" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="26cf-f9fd-ce8c-5e5f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="656d-da13-df79-908a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Anillo de Volans" id="8c13-0088-32c3-53e4" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía variable. Al inicio de cada una de tus fases de magia, escoge uno de los 8 Saberes Básicos y tira un hechizo al azar de esa lista. El portador puede lanzar ese hechizo sin invertir dados de Energía (no es necesario gastar un dado, como con otros objetos portahechizos), con un valor de lanzamiento igual a su dificultad básica (no pueden lanzarse hechizos potenciados usando este objeto).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Laurel de la victoria" id="16f9-3b43-6be1-9827" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8692-3a72-c50a-15e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7b4c-f7e0-aac0-dcc2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Laurel de la victoria" id="6165-f86d-5030-fed8" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Cada herida causada por el portador en combate cuerpo a cuerpo contará como dos heridas al determinar el resultado del combate. Además, cualquier unidad que declare una carga contra el portador o la unidad en la que se encuentre ha de realizar un chequeo de liderazgo con un penalizador de -1. Si lo falla, esa unidad no podrá cargar ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
