      <rules>
        <rule name="Nacida en La Marca" id="0eed-8d38-cf7d-8563" hidden="false">
          <description>Ulrika puede repetir todas sus tiradas para herir fallidas, tanto al disparar como en combate cuerpo a cuerpo; además, tiene la regla especial Esquivar (4+).</description>
        </rule>
        <rule name="Respetada" id="e794-dfc9-45d1-fb13" hidden="false">
