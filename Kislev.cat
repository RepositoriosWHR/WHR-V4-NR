                <profile name="Cetro de Miska" id="aa4e-c16f-e592-6db7" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Permite a Katarin guardar hasta tres dados de magia de Energía o Dispersión al final de cualquier fase de magia para utilizarlos en una fase de magia posterior. Comienza la batalla con 1D3 dados guardados en su interior.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
