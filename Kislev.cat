        <infoLink name="Unidad mixta" id="df49-0307-9d94-168e" hidden="false" targetId="71f0-691e-7aa2-fb9a" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="afe3-fa63-3162-9362" type="set" value="3">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
