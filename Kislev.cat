          </infoLinks>
          <profiles>
            <profile name="Cetro de Tor" id="a0ab-e318-f474-6e53" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">La portadora conocerá un hechizo adicional a los que puede conocer que será el Rayo atronador de Urannon del Saber de los Cielos. Pese a conocer este hechizo, no se beneficia de la regla especial del Saber de los Cielos.
Además, la portadora tendrá la regla especial Inmune a psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
