    <selectionEntry name="Guardia de hielo" id="4515-b307-2382-54e2" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="0b70-f6b4-f723-90ae" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
