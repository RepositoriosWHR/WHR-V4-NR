      <infoLinks>
        <infoLink name="Infantería" id="f625-8a1c-74db-e838" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Inmune a la psicología" id="9073-2d2a-d0b2-58a6" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Ataques mágicos" id="38d1-7942-5027-df6c" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
        <infoLink name="Odio" id="22c8-db0c-927e-035b" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
