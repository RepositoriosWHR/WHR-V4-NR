        </modifier>
      </modifiers>
      <rules>
        <rule name="Encarnación de Kislev" id="0df5-cc13-e40e-3eb0" hidden="false">
          <description>El Oso elemental tiene la regla ¡Ni un paso atrás!, que afecta a las unidades kislevitas aliada a 18”.</description>
        </rule>
        <rule name="La fuerza del invierno" id="b8cd-716b-1397-8505" hidden="false">
          <description>El Oso elemental tiene la regla especial Aura de frío, que afecta a todos los enemigos a 8” o menos de él. Además, todos los hechiceros que usen el Saber del Hielo que estén a 8” o menos de un Oso elemental tendrán un bonificador de +1 al lanzamiento de hechizos de ese saber.</description>
        </rule>
        <rule name="Aliento alado" id="e7ff-4e94-6bf5-24ee" hidden="false">
          <description>El Oso elemental dispone de un Arma de aliento de Fuerza 4 que no permite tirada de salvación por armadura.</description>
        </rule>
        <rule name="Mole de nieve, hielo y tierra" id="5e9c-69a3-a825-fefb" hidden="false">
          <description>El Oso elemental tiene la regla especial Regeneración (5+) y es inmune a los efectos de las reglas especiales Golpe letal, Golpe letal heroico y Heridas múltiples.</description>
        </rule>
      </rules>
