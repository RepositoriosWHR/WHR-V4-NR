            <constraint id="bb04-d686-e2d5-869e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="1458-300c-4661-a68c" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Tozudez" id="c598-ce0d-ac22-f90e" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="La manzana de Kislev" id="7bb5-e465-a6bc-03a1" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo General del ejército. El Liderazgo del portador se incrementa en un punto y obtiene la regla especial Tozudez. Todas las unidades amigas a 12” o menos del portador superarán automáticamente sus chequeos de Miedo, Terror y Pánico. Si la porta una Hija de Miska, este alcance aumentará a 18”.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Kislev" id="4c63-63ec-56bd-76d5" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="10c9-7700-da92-15b8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="f1a5-0976-13d1-3659" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pluma de Finist el halcón" id="58ac-e25c-892b-0319" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9985-2250-2ed3-967f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a932-1205-8694-30c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
