                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de placas (proporciona una tirada de salvación por armadura de 4+). Boris puede repetir sus tiradas de salvación por armadura fallidas. Además, el atributo de Ataques de Boris aumentará en +1 por cada herida que sufra durante la batalla.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Armadura de placas" id="3f6c-8886-80aa-395f" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
