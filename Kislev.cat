      <rules>
        <rule name="Magia Bruja ungol" id="7042-a254-7e72-37f8" hidden="false">
          <description>Nivel de magia 1, puede aumentarse a 2 (+30 puntos). Puede elegir sus hechizos de uno (y sólo uno) de los Saberes de las Bestias o de los Cielos.</description>
        </rule>
        <rule name="Protectora de almas" id="5202-68eb-86db-8dee" hidden="false">
          <description>Una Bruja ungol tiene la regla especial Resistencia mágica (1) que se incrementa a Resistencia mágica (2) contra hechizos de los Saberes del viento de Magia Oscura.</description>
        </rule>
      </rules>
