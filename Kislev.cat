          <profiles>
            <profile name="Gotrek Gurnisson" id="b15b-7902-5c35-9efd" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">3</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">8</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">1</characteristic>
                <characteristic name="F" typeId="5.323232344415441e+21">5</characteristic>
