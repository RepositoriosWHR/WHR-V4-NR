              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos y conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La trenza de Vasilisa" id="3d03-382e-1d3b-bc07" collective="false" hidden="false" import="true" type="upgrade">
