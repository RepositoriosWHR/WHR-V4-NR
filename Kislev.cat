      <rules>
        <rule name="Oso blanco kislevita" id="87ec-06ee-8dae-4b82" hidden="false">
          <description>La gruesa piel de los osos proporciona a sus jinetes un bonificador de +2 a su tirada de salvación por armadura, en lugar del +1 habitual.</description>
        </rule>
        <rule name="Seguidos por el invierno" id="cec3-dc40-008b-fdd6" hidden="false">
          <description>Todas las unidades enemigas en contacto peana con peana con los Hijos de Ursun verán su Iniciativa reducida a la mitad mientras permanezcan en contacto con éstos.</description>
        </rule>
      </rules>
