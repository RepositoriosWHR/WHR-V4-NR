              <profiles>
                <profile name="Espada heroica" id="7996-255b-c87a-da9e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. La Espada heroica golpea siempre con una Fuerza igual a la Resistencia del enemigo (es decir, que siempre herirá con un resultado de 4+, excepto si la Resistencia del objetivo es menos que la Fuerza de Ivan Radinov).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
