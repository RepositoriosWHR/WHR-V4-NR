      </infoLinks>
      <profiles>
        <profile name="Ave de la tormenta" id="10da-2c0c-bccf-ed51" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
          <characteristics>
            <characteristic name="M" typeId="4d23232344415441232323">4</characteristic>
            <characteristic name="HA" typeId="5.753232323444154e+23">6</characteristic>
            <characteristic name="HP" typeId="4.2532323234441546e+23">0</characteristic>
            <characteristic name="F" typeId="5.323232344415441e+21">6</characteristic>
            <characteristic name="R" typeId="5.423232344415441e+21">6</characteristic>
            <characteristic name="H" typeId="5.723232344415441e+21">6</characteristic>
            <characteristic name="I" typeId="4.923232344415441e+21">4</characteristic>
            <characteristic name="A" typeId="4.123232344415441e+21">5</characteristic>
            <characteristic name="L" typeId="4c4423232344415441232323">10</characteristic>
            <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
            <characteristic name="TSE" typeId="5.761726453617665e+35">5</characteristic>
            <characteristic name="Tipo" typeId="5.479706523232345e+27">Monstruo</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Salvación especial 5+" id="9c8f-1813-1a7b-dbef" hidden="false"/>
        <rule name="Aura de escarcha Ave de la tormenta" id="78ea-4f4b-1f99-4400" hidden="false">
          <description>El Ave de la tormenta tiene la regla especial Aura de frío, que afecta a todos los enemigos a 8” o menos de él. Todos los enemigos que ataquen a un Ave de la tormenta en combate cuerpo a cuerpo tendrán un penalizador de -1 a su tirada para impactar. Por último, un Ave de la tormenta tiene la regla especial Inmune a fuego.</description>
        </rule>
        <rule name="Heraldo de la tormenta" id="4da8-bcfa-3c14-6e4c" hidden="false">
          <description>En cada una de tus fases de disparo, tira 1D6 por cada unidad enemiga a 12” o menos del Ave de la tormenta: si obtienes un resultado de 5+, esa unidad sufrirá 1D6 impactos de Fuerza 5 (distribuidos como proyectiles) con la regla especial Ataque de rayos. Además, un Ave de la tormenta tiene la regla especial Inmune a rayos.</description>
        </rule>
      </rules>
