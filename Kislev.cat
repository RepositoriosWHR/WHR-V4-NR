              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas de la unidad obtienen un bonificador de +1 a su Habilidad de armas (excepto las monturas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte aullante de Njevski" id="3556-800e-6460-5265" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="991d-e306-c677-d91a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
