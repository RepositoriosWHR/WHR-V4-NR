    <selectionEntry name="[E] - Ilya de Moruva, el hombre más fuerte de Kislev" id="4b8e-cc94-cbf7-4ecc" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="5a5b-3d86-30d9-83e2" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
