        </infoLink>
        <infoLink name="Inmune a la psicología" id="15d2-a045-e91f-8330" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Resistencia mágica (1)" id="2d1d-4b3b-3e08-19b6" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
        <infoLink name="Odio" id="6acd-aa43-ff08-95ac" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Caos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Magia Hija de Miska" id="8e15-d7fc-97fb-bcbc" hidden="false">
          <description>Nivel de magia 2, puede aumentarse a 3 (+50 puntos). Siempre utiliza el Saber del Hielo.</description>
        </rule>
        <rule name="Icono legendario" id="e2d4-3cb5-45b9-5f95" hidden="false">
          <description>Todas las unidades kislevitas aliadas a 12” o menos de una Hija de Miska obtendrán la regla especial Inmune a psicología. El radio aumenta a 18” si va montada en Dragón blanco. Además, si una Hija de Miska es la General de un Gran ejército, podrá incluir hasta dos unidades de Guardia de hielo en su ejército.</description>
        </rule>
      </rules>
