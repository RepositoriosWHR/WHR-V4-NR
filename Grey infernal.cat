    <selectionEntry name="[E] - Throgg, rey troll" id="bb94-6950-ad68-7cb1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="73e3-8298-334d-9c9c" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
        <categoryLink name="Personajes" id="8c82-87ca-f6ea-8c8b" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
