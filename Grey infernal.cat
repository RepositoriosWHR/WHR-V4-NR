      <constraints>
        <constraint id="21a9-7bb6-01e0-0d99" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="0"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="General no engendro" id="6b2f-5ab2-d281-2ad9" collective="false" hidden="false" import="true" targetId="ad35-f170-fcd1-781b" type="selectionEntry"/>
        <entryLink name="Marca de caos absoluto. Personajes" id="1e49-a286-f9fb-19ae" collective="false" hidden="false" import="true" targetId="f6f4-ba5d-ee7d-1e7f" type="selectionEntry">
          <constraints>
            <constraint id="a3c2-284e-8070-5e98" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ojo de los dioses" id="9e1d-36b7-8b10-583f" hidden="false" targetId="0d5a-e32a-368d-58ff" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de caos absoluto. Throgg" id="9ff8-9162-769c-708f" hidden="false">
              <description>Al inicio de la batalla efectúe una tirada en la tabla de Ojo de los dioses y aplica el resultado a Throgg durante la batalla (considera los resultados de 2 como 3). Además, tanto él como su unidad podrá repetir las tiradas en la tabla de Ojo de los dioses.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería monstruosa" id="b2b3-df99-21c4-90db" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink name="Miedo" id="153b-7328-e721-340c" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink name="Inmune a la psicología" id="4ae7-8a2f-7a33-0317" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Regeneración mutante" id="421b-5a92-c987-6f6f" hidden="false" targetId="8d1d-9450-a791-0761" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(4+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="21a9-7bb6-01e0-0d99" type="set" value="1">
          <conditions>
            <condition childId="d3cb-a5ee-7736-723e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="436f726523232344415441232323" shared="true" type="atLeast" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Regeneración mutante" id="73ee-4a2b-925a-2aa3" hidden="false">
          <description>Regeneración (4+). Si regeneran 2 o más heridas en una misma fase, tira en la tabla de Ojo de los Dioses y aplica el resultado a toda la unidad. Considera los resultados de 11 a 14 como “El Ojo está cerrado”.</description>
        </rule>
        <rule name="Vómito copioso" id="be73-f430-d88a-05e1" hidden="false">
          <description>En lugar de realizar sus ataques normales en combate cuerpo a cuerpo, Throgg puede optar por causar 1D6 impactos automáticos de Fuerza 5 que no permiten tirada de salvación por armadura. Además, una vez por batalla, Throgg puede utilizar su vómito como un Arma de aliento con Fuerza 5 que no permite tirada de salvación por armadura.</description>
        </rule>
        <rule name="La horda monstruosa" id="04d9-a3f5-dbf2-7107" hidden="false">
          <description>La unidad de Trolls del Caos a la que se una Throgg perderá la regla especial Estupidez mientras Throgg continúe con vida.</description>
        </rule>
      </rules>
      <selectionEntries>
