                <infoLink name="Poder de penetración" id="82ad-37b0-e8ea-394e" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Sangre fría" id="2e3a-d086-53b0-3d39" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
