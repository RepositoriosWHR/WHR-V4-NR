            <entryLink name="Marca de Nurgle. Personajes" id="0103-943d-8e22-217a" collective="false" hidden="false" import="true" targetId="41c9-9a2f-5f45-a93a" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Terror" id="2239-d7a1-78d3-4822" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Brujo ogro del Caos" id="bfa5-aead-e980-c88c" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="9ad6-8fb3-2ad5-d446" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="e611-e3fd-16dd-c263" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="b9f3-47d9-5ff9-9060" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Brujo ogro del Caos" id="2f16-7e0f-0a55-15c1" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella); además, tendrá un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Caos absoluto. Personajes" id="d0ad-2872-7b50-f4d0" collective="false" hidden="false" import="true" targetId="f6f4-ba5d-ee7d-1e7f" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="81bd-6b7e-0bec-ad66" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de caos absoluto. Brujo ogro del Caos" id="485f-09d0-a98d-6932" hidden="false">
                  <description>Obtiene la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
