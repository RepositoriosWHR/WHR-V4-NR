        <entryLink name="Marca de Tzeentch. Personajes" id="a058-9d86-d1e7-9d9e" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
          <constraints>
            <constraint id="6380-0612-23e5-7cfe" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="950a-ddc3-e447-3c07" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Urannon" id="22a5-775d-fcfc-7dcc" hidden="false">
              <description>Otorga la regla especial Ataques flamígeros, una tirada de 
salvación especial de 5+ (o +2 a si ya disponía de ella) y un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Miedo" id="a13b-a4d2-11fe-0c65" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink name="Bestia monstruosa" id="8291-4441-70eb-7a9c" hidden="false" targetId="2e1e-da3a-8081-991c" type="rule"/>
        <infoLink name="Piel escamosa (4+)" id="a11a-c034-3259-ac4b" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink name="Cólera de la tormenta" id="6bb1-069f-991e-c020" hidden="false" targetId="3c8a-7dd2-ec67-87bd" type="rule"/>
        <infoLink name="La vida es sueño" id="beb2-01d2-c31c-6938" hidden="false" targetId="7cad-24fc-d28b-2d56" type="rule"/>
        <infoLink name="Sangre fría" id="5590-0bcf-8fa8-0403" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink name="Señor del conocimiento" id="6fd4-f273-3fc5-4f9c" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Cielos)"/>
          </modifiers>
        </infoLink>
        <infoLink name="La voluntad del caos" id="6764-bafd-00c1-008f" hidden="false" targetId="7af2-437f-defb-d01a" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Urannon, la voz de la tormenta" id="3a80-3736-46a2-6cd7" hidden="false">
          <description>Urannon es un hechicero de nivel 4 que conoce todos los hechizos del Saber de los Cielos.</description>
        </rule>
        <rule name="Voluntad inquebrantable" id="2947-30ec-c47c-fa1f" hidden="false">
          <description>Urannon tiene la regla especial Sangre fría. Además, tiene la regla especial ¡Ni un paso atrás!, que afecta a todos los Ogros dragón y Ogros dragón sharunok (pero no Ogros dragón shaggoth) a 12” o menos de él.</description>
        </rule>
        <rule name="Vigor de la tormenta" id="dc4c-a2e5-90f4-9255" hidden="false">
          <description>Además de los efectos habituales de la Cólera de la tormenta, si Urannon o su unidad recibe un Ataque de rayos, restauran todas las heridas que hubiesen sufrido con anterioridad durante la batalla (esto no puede resucitar Ogros dragón muertos).</description>
        </rule>
        <rule name="Criatura descomunal" id="0e98-aa98-b8de-94ee" hidden="false">
          <description>Urannon tiene Potencia de unidad 4 y tamaño Muy grande.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="a94d-993a-d242-8c2e" collective="false" hidden="false" import="true" type="upgrade">
