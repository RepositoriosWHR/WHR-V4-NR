          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Kholek" id="7559-2536-c59a-4748" hidden="false">
              <description>Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
            </rule>
          </rules>
