            <rule name="Marca de Nurgle" id="d858-19f9-d4f0-9217" hidden="false">
              <description>Obtiene la regla especial Ataques envenenados y los 
enemigos reciben un penalizador de -1 para impactarle tanto en disparo como en combate.</description>
            </rule>
          </rules>
