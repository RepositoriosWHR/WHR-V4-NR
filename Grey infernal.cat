          <profiles>
            <profile name="El yelmo embrujado" id="9914-8c71-4931-05f8" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Yelmo (el portador verá su tirada de salvación por armadura incrementada en un +1). El portador obtiene la regla 
especial Resistencia mágica (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura de las tormentas" id="9f2b-df40-aef4-531d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
