              </infoLinks>
            </entryLink>
            <entryLink name="Marca de caos absoluto. Personajes" id="dac4-2b44-83e8-3a14" collective="false" hidden="false" import="true" targetId="f6f4-ba5d-ee7d-1e7f" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <infoLinks>
                <infoLink name="Ojo de los dioses" id="c74a-4ace-254d-2941" hidden="false" targetId="0d5a-e32a-368d-58ff" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de caos absoluto. Gran Shaggot" id="e797-8b66-a797-5a9c" hidden="false">
                  <description>Al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses, la cual podrá repetir, y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="025e-0a0d-b072-7ebb" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="4a78-3fe8-0428-1a10" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="95d4-cbcd-500b-9805" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Ogro dragón Shaggot" id="b9e0-d128-ff19-c332" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
