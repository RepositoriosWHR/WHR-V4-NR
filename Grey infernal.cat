            <profile name="Tótem de la muerte" id="12c2-c982-a808-a9d0" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y la unidad en la que se encuentre obtienen las reglas especiales Furia asesina y Carga devastadora.</characteristic>
