          <entryLinks>
            <entryLink name="Clave: Hechicero" id="c15f-0f70-e514-7c1d" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="fd5d-411f-744c-dd04" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="77ef-c616-1413-c7df" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Magia Bruja Troll del Caos" id="f75e-49c4-0c60-f3b8" hidden="false">
              <description>Un único Troll del Caos anciano del ejército que no tenga la Marca de Khorne puede convertirse en Bruja troll del Caos (+40 puntos). Una Bruja troll del Caos es hechicera de nivel 1 que puede elegir sus hechizos de uno (y sólo uno) de los Saberes de las Bestias, Magia oscura o el Saber de su Dios del Caos. Puede aumentarse a nivel 2 de magia (+30 puntos).</description>
            </rule>
          </rules>
          <selectionEntryGroups>
            <selectionEntryGroup name="Nivel de magia" id="6bed-68dc-f985-ec46" collective="false" defaultSelectionEntryId="9a9a-b617-cba1-14c8" hidden="false" import="true">
