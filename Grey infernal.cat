              <infoLinks>
                <infoLink name="Terror" id="32de-411f-ed84-ab68" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Paladín ogro del Caos" id="7748-2246-87ba-419f" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="f999-a827-74a0-1d9d" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="017b-23cf-334a-0949" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="1a80-288c-0f39-eb2b" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Paladín ogro del Caos" id="0276-c258-5262-df2b" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="4755-bcec-51af-1cf8" collective="false" hidden="false" import="true" targetId="fd5d-411f-744c-dd04" type="selectionEntry">
