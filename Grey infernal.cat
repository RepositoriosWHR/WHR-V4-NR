        <selectionEntryGroup name="Marcas del caos" id="79dc-87e4-7ca7-796f" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="5353-cca6-ed5c-c488" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="Marca de Nurgle. Unidades" id="cf27-a2a5-ca3e-b652" collective="false" hidden="false" import="true" targetId="aec5-1a32-6b7a-7a46" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <rules>
                <rule name="Marca de Nurgle. Engendro monstruoso del Caos" id="08c0-95ac-ad49-49f4" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y en combate cuerpo a cuerpo.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="a648-3f25-c617-b5c7" collective="false" hidden="false" import="true" targetId="313c-f79a-8551-3f76" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <infoLinks>
                <infoLink name="Odio (todos los enemigos)" id="3c7d-8ab9-f3d9-6c29" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink name="Resistencia mágica (1)" id="2f80-30f6-99dd-2b2b" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink name="Ataques aleatorios" id="b6ee-ecae-397a-233f" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(2D6+4)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Marca de Khorne. Engendro monstruoso del Caos" id="96fe-734a-78d3-0528" hidden="false">
                  <description>Obtiene las reglas especiales Odio (¡todos los enemigos!) y Resistencia mágica (1) y sus Ataques aleatorios pasan a ser 2D6+4.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="e06c-087e-6a5c-0127" collective="false" hidden="false" import="true" targetId="824f-aedf-0479-e653" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <infoLinks>
                <infoLink name="Poder de penetración" id="e987-364c-5e1e-5638" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Slaanesh. Engendro monstruoso del Caos" id="c227-f261-3742-02bf" hidden="false">
                  <description>Obtiene la regla especial Poder de penetración; además, cada vez que vayas a mover el Engendro monstruoso, puedes repetir la tirada de uno de sus dados de Movimiento aleatorio.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de caos absoluto. Unidades" id="8f92-a6a3-00f8-c701" collective="false" hidden="false" import="true" targetId="0b5b-ba9a-9413-09a2" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Ojo de los dioses" id="e3d0-1ecf-f9f5-ebb1" hidden="false" targetId="0d5a-e32a-368d-58ff" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de caos absoluto. Engendro monstruoso del Caos" id="9037-b350-92e2-6c09" hidden="false">
                  <description>Al inicio de la batalla, realiza una tirada adicional en la tabla de Mutaciones del Engendro monstruoso y aplica el resultado durante toda la batalla (repite los resultados duplicados).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Unidades" id="cbe3-8376-1021-60d3" collective="false" hidden="false" import="true" targetId="9a18-47e5-3b0d-7788" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="fb28-a4b4-2fcd-6e4b" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Engendro monstruoso del Caos" id="9196-5586-e121-f129" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Opciones" id="ef40-9ef8-dffe-56b6" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Segunda tirada en la tabla de mutaciones" id="c7d7-3c99-99eb-fbff" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1899-7e43-49f2-f9f3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
