          <entryLinks>
            <entryLink name="Marca de Nurgle. Personajes" id="1d79-3a2b-63f7-c515" collective="false" hidden="false" import="true" targetId="41c9-9a2f-5f45-a93a" type="selectionEntry">
              <costs>
