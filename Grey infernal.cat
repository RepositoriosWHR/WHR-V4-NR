        <infoLink name="Tozudez" id="1a0a-5529-2277-6dd7" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink name="Furia asesina" id="709b-e6ae-3957-3e1d" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
        <infoLink name="Impactos por carga (1D6)" id="0056-dfe2-eff3-dce7" hidden="false" targetId="bdc4-4c8b-a303-ec51" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="78c2-286b-7bf6-f2c2" type="set" value="2">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
