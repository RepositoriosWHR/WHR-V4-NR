    <selectionEntry name="Bestia espinosa del caos" id="c739-043f-2f96-6571" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="5d8f-8e7c-519c-f2be" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
