          <profiles>
            <profile name="Fortuna de Tzeentch" id="dd5a-f6c9-ab6d-221f" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Sólo miniaturas con la Marca de Tzeentch. Una vez por turno de jugador, el Paladín puede repetir una tirada de 1D6. Puede ser una tirada para impactar, herir, salvación (por armadura o especial) o un chequeo de atributo (excepto de Liderazgo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ojo de Tzeentch " id="c46d-3b92-d25d-ee75" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="04a0-b20c-891e-77de" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="969a-1575-8272-33e9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ojo de Tzeentch " id="4012-5512-ec3b-e4a1" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje podrá repetir todas sus tiradas fallidas para impactar, tanto en combate cuerpo a cuerpo como con proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sanguijuela arcana" id="42dc-9999-18d2-f695" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4f3a-09f9-45cd-0a13" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5fc5-eaff-9761-5826" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
