        <entryLink name="Marca de Tzeentch. Personajes" id="f77f-9b7e-4074-b790" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
          <constraints>
            <constraint id="04be-87a9-e704-0b6f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <rules>
            <rule name="Marca de Tzeentch Galrauch" id="0913-0e51-ea16-b85c" hidden="false">
              <description>Otorga la regla especial Ataques flamígeros, una mejora de su tirada de salvación especial (ver Dragón demonio) y un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="General no engendro" id="a5bc-e2b1-9599-9263" collective="false" hidden="false" import="true" targetId="ad35-f170-fcd1-781b" type="selectionEntry"/>
        <entryLink name="Leyenda" id="c46e-817b-bc3a-1671" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
        <entryLink name="Saga (Galrauch)" id="f258-4bce-50b1-d7e4" collective="false" hidden="false" import="true" targetId="09cb-ca55-cdcf-e5ce" type="selectionEntry"/>
      </entryLinks>
