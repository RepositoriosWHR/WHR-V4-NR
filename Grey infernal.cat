    <selectionEntry name="Ogro dragón Shaggot" id="6b21-45e0-cd72-3f20" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="b523-f242-3b21-3d4c" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="4d38-5b9a-9439-6071" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
