          </constraints>
          <rules>
            <rule name="Marca de Tzeentch Galrauch" id="da74-39ad-a173-b07c" hidden="false">
              <description>Otorga la regla especial Ataques flamígeros, una mejora de su tirada de salvación especial (ver Dragón demonio) y un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="General no engendro" id="18fb-336c-c758-5913" collective="false" hidden="false" import="true" targetId="ad35-f170-fcd1-781b" type="selectionEntry"/>
