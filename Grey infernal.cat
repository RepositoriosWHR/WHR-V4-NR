            <profile name="Runa del Caos indiviso" id="2c90-2c90-d03c-e2dd" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje causa Terror. Además, todas las unidades enemigas en contacto peana con peana con el portador deberán repetir todos sus chequeos exitosos de desmoralización.</characteristic>
              </characteristics>
            </profile>
