              </infoLinks>
            </entryLink>
            <entryLink name="Marca de caos absoluto. Personajes" id="410e-4513-f4ba-8d6b" collective="false" hidden="false" import="true" targetId="f6f4-ba5d-ee7d-1e7f" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ojo de los dioses" id="71ac-8bc3-4311-69fb" hidden="false" targetId="0d5a-e32a-368d-58ff" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de caos absoluto. Ogro dragón Sharunok" id="9337-9ef7-93e0-2c52" hidden="false">
                  <description>Al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses, la cual podrá repetir, y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="9ac5-316f-a6ba-ea81" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="f25e-b98d-bcf4-5c72" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="e876-c5ec-7de7-a95f" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Ogro dragón Sharunok" id="5bf4-2819-24dd-7340" hidden="false">
                  <description>Obtiene las reglas especial Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
