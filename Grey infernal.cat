                <infoLink name="Resistencia mágica (2)" id="c66e-c50e-5327-2d7f" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de caos absoluto. Personajes" id="3dcb-1396-f35b-34c5" collective="false" hidden="false" import="true" targetId="f6f4-ba5d-ee7d-1e7f" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="d30c-2e96-7061-ccb8" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de caos absoluto. Paladín ogro del Caos" id="2bce-1a4b-5ac4-9720" hidden="false">
                  <description>Obtiene la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
