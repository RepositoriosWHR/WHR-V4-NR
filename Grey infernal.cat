        <infoLink name="Esquivar (5+)" id="cfc2-e884-9e45-3808" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Bandada de muerte" id="3785-5299-7cc1-3114" hidden="false">
          <description>La unidad de Arpías a la que se une Shyishet obtiene la regla especial Esquivar (5+).</description>
        </rule>
      </rules>
