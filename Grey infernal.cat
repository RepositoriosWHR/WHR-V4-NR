            <infoLink name="Ataques flamígeros" id="463f-6369-c3a9-49d6" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Kholek" id="8d09-da9e-acba-4368" hidden="false">
              <description>Ataques flamígeros, Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella</description>
            </rule>
