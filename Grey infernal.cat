              </profiles>
              <rules>
                <rule name="Golpe de cola" id="f64b-a5a5-4104-68a5" hidden="false">
                  <description>El ataque adicional del Pagowyrm se resuelve con un bonificador de +1 a su Fuerza y las reglas especiales Ataques envenenados y Heridas múltiples (1D3).</description>
                </rule>
                <rule name="Frío entumecedor" id="9b61-7cd3-5848-afcb" hidden="false">
                  <description>El Pagowyrm tiene la regla especial Aura de frío, la cual afecta a todas las enemigas a 6” o menos del Pagowyrm.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Sciowyrm" id="e5ae-efe9-ee61-8631" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
