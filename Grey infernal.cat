              <infoLinks>
                <infoLink name="Inmune al veneno" id="c22f-8137-e031-5107" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Gran Shaggot" id="c299-ffb0-db3d-7f2e" hidden="false">
                  <description>Obtiene la regla especial Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarle con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="3617-d8b7-4fde-a921" collective="false" hidden="false" import="true" targetId="fd5d-411f-744c-dd04" type="selectionEntry">
