              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Solo hechiceros. El personaje conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hemónculo" id="bc3e-eed0-6349-0453" collective="false" hidden="false" import="true" type="upgrade">
