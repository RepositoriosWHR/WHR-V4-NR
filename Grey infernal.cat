              </costs>
              <infoLinks>
                <infoLink name="Terror" id="47da-1686-6f8a-01aa" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Ogro dragón Sharunok" id="dc2e-7bce-7091-7a64" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="b8cc-8ff2-6369-1721" collective="false" hidden="false" import="true" targetId="fd5d-411f-744c-dd04" type="selectionEntry">
              <costs>
