                    <characteristic name="I" typeId="4.923232344415441e+21">2</characteristic>
                    <characteristic name="A" typeId="4.123232344415441e+21">5+1</characteristic>
                    <characteristic name="L" typeId="4c4423232344415441232323">9</characteristic>
