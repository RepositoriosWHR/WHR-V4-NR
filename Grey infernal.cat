        <selectionEntry name="Bruja troll del caos" id="df73-1187-ff5a-9b3c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ea23-b521-9f13-6e91" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
