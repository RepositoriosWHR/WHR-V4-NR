                <infoLink name="Resistencia mágica (2)" id="9963-6906-c70e-c7cc" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
