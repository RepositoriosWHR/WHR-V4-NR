                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Mutaciones del caos" id="ec97-ebab-1b38-2769" hidden="false">
                  <description>Puede tener Mutaciones del Caos (+10 puntos): Al inicio de la batalla, antes del despliegue, efectúa una tirada de 1D6 en la siguiente tabla: el resultado indica el beneficio que obtiene el Gigante del Caos.
1	Locura del Caos: Estupidez y Tozudez.
2	Aura del Caos: Ataques mágicos y Resistencia mágica 2.
3	Pinchos : Impactos por carga (1D3).
4	Pellejo pétreo: Piel escamosa (5+).
5	Corpulencia del Caos: +1 Herida.
6	Carne mutada: Regeneración (5+).</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Marcas del caos" id="c255-b98f-755b-58a9" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="3c14-7a26-5359-bfc2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="Marca de Nurgle. Unidades" id="c136-ad49-718d-8556" collective="false" hidden="false" import="true" targetId="aec5-1a32-6b7a-7a46" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <rules>
                <rule name="Marca de Nurgle. Gigante del Caos" id="7dbe-b3c1-7b8a-f893" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y en cuerpo a cuerpo.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="1bb8-8a49-2bdd-bcce" collective="false" hidden="false" import="true" targetId="824f-aedf-0479-e653" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Poder de penetración" id="93ff-29bd-1b98-e87f" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Slaanesh. Gigante del Caos" id="a956-39d3-cff8-16af" hidden="false">
                  <description>Obtiene la regla especial Poder de penetración en todos sus ataques y +1 Iniciativa.</description>
                </rule>
              </rules>
            </entryLink>
