                <infoLink name="Odio (todos los enemigos)" id="7114-0727-0d02-7436" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink name="Resistencia mágica (2)" id="f5f6-9df9-3d86-7112" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="b2c3-d870-e65e-cbb1" collective="false" hidden="false" import="true" targetId="5ab4-1ea2-d076-216f" type="selectionEntry">
              <costs>
