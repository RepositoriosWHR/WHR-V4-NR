            <entryLink name="Marca de Nurgle. Personajes" id="74be-adf8-4b3a-8877" collective="false" hidden="false" import="true" targetId="41c9-9a2f-5f45-a93a" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques envenenados" id="25a8-016d-75c1-cf6a" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Gran arpía" id="d3c6-34cb-6620-309a" hidden="false">
                  <description>Obtiene la regla especial Ataques envenenados. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="0966-28d5-5677-e229" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="b0dd-69c9-1768-efb9" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="f5dd-5299-5144-90df" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Gran arpía" id="cdd2-98c7-deaf-1d18" hidden="false">
                  <description>Obtiene las reglas especiales Ataques mágicos y Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="f49b-d5a6-632d-c5bd" collective="false" hidden="false" import="true" targetId="fd5d-411f-744c-dd04" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Odio (todos los enemigos)" id="2731-83dc-df1c-b80b" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink name="Resistencia mágica (2)" id="4e31-e473-4543-843f" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de caos absoluto. Personajes" id="3ae0-66f8-53d2-07f4" collective="false" hidden="false" import="true" targetId="f6f4-ba5d-ee7d-1e7f" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune al pánico" id="6bcc-604a-c319-0e29" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de caos absoluto. Gran arpía" id="ad1b-504e-16a4-ecc7" hidden="false">
                  <description>Obtiene la regla especial Inmune a Pánico. Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses, la cual podrá repetir, y aplica el resultado al personaje durante la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
