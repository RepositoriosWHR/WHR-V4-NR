      <infoLinks>
        <infoLink name="Aura demoníaca (5+)" id="f460-e519-042d-4348" hidden="false" targetId="e5ed-5149-3d72-6aa4" type="rule"/>
        <infoLink name="Indesmoralizable" id="9ee9-c5cb-c85d-4633" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink name="Monstruo" id="3bc4-12a7-d1cf-90b3" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Movimiento aleatorio (3D6)" id="9302-6e63-9d34-c188" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
        <infoLink name="Ataques aleatorios" id="9169-dee3-68f4-aaff" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(2D6+2)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="2b4d-6ae8-684e-76fb" type="set" value="3">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="2b4d-6ae8-684e-76fb" type="set" value="4">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Vástago del caos" id="8658-0913-e676-0ce9" hidden="false">
          <description>Determina al inicio de la batalla (antes del despliegue) los atributos de HA, F, R, H e I del Engendro monstruoso del Caos. Además, tira una vez en la siguiente tabla para determinar los efectos adicionales de las mutaciones del engendro:
1D6 Mutaciones
1 Ataques envenenados
2 Piel escamosa (4+)
3 Arma de aliento de Fuerza 1D6
4 Resistencia mágica (3)
5 Golpe letal
6 Regeneración (4+)</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="d644-576d-d86f-57f1" collective="false" hidden="false" import="true" type="upgrade">
