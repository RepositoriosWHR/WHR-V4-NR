              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Sólo miniaturas con la Marca de Tzeentch. El personaje obtiene una tirada de salvación especial de 6+ y la regla especial Resistencia mágica (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
