              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje genera un dado de Energía adicional en cada fase de magia propia, que puede ser utilizado por cualquier personaje con la Marca de Tzeentch.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fortuna de Tzeentch" id="dfa9-e9c1-39af-562a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8730-a4da-b1c2-719c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="1717-6c29-c8e2-ddae" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
