              </costs>
              <rules>
                <rule name="Segunda tirada" id="9afc-7e83-a72a-f6b3" hidden="false">
                  <description>Puedes pagar una segunda tirada en la tabla de mutaciones al inicio de la batalla por +20 puntos.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
