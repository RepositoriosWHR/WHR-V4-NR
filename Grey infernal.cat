    <selectionEntry name="[E] - Urannon, la voz de la tormenta" id="951b-e8a4-e245-a0b7" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="4850-1171-a431-3a6b" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
