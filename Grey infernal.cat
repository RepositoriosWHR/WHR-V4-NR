          </entryLinks>
          <profiles>
            <profile name="Relicario de Krakanroc el Negro " id="7d24-31ef-6693-3169" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puedes utilizar el Relicario de Krakanroc el Negro al inicio de cualquier turno de jugador (propio o del oponente). Hasta el final de dicho turno de jugador, todas las unidades enemigas a 12” o menos del portador no podrán beneficiarse de las reglas especiales Inmune a psicología, Inmune a Miedo, Inmune a Pánico, Estupidez, Furia asesina, Impasible, Tozudez e Indesmoralizable. Esto no afecta a miniaturas con las reglas especiales Demonio o No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
