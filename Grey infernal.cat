            <entryLink name="Reliquia" id="32da-d44e-3e65-4088" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Pabellón del relámpago" id="2e12-3c84-effb-31e9" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Ogro dragón sharunok. Al inicio de cada una de tus fases de disparo, todas las unidades (amigas y enemigas, incluyendo al portador o su unidad) a 12” del portador sufren un impacto automático de Fuerza 5 con la regla especial Ataque de rayos. Además, si el portador o su unidad reciben un impacto con la regla especial Ataques de rayos, la unidad puede restaurar hasta 1D3 heridas que hubiese sufrido previamente durante la batalla (tú decides qué miniaturas se curan).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
