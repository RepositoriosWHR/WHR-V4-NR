                <infoLink name="Resistencia mágica (2)" id="3b7f-d1ce-934f-d19c" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="e99e-092e-53fe-7c24" collective="false" hidden="false" import="true" targetId="5ab4-1ea2-d076-216f" type="selectionEntry">
              <costs>
