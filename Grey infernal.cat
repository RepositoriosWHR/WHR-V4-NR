              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Sangre fría" id="1e02-f56c-cd0b-2148" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink name="Poder de penetración" id="eec5-f1e9-640a-20af" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="dd60-dcd4-b5fd-04b6" collective="false" hidden="false" import="true" targetId="1724-b3eb-69bc-3660" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="e38a-ffb6-d988-1198" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Troll del Caos Anciano" id="5d62-22ef-5006-e68c" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella); además, tendrá un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="155a-fe51-517a-c94a" collective="false" hidden="false" import="true" targetId="41c9-9a2f-5f45-a93a" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Terror" id="6171-71ff-f668-6563" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Troll del Caos Anciano" id="510a-2187-4ba4-d6a7" hidden="false">
                  <description>Causa Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de caos absoluto. Personajes" id="8818-214d-6fd2-d595" collective="false" hidden="false" import="true" targetId="f6f4-ba5d-ee7d-1e7f" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <rules>
                <rule name="Marca de caos absoluto. Troll del Caos Anciano" id="3096-8228-c49a-bb47" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los Dioses, la cual podrá repetir, y aplica el resultado al personaje durante la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="ed30-2e8a-5647-ece4" collective="false" hidden="false" import="true" targetId="fd5d-411f-744c-dd04" type="selectionEntry">
              <costs>
