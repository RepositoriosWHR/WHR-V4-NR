            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Viento del Caos" id="8a74-ab0a-a531-0318" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Los Vientos del Caos disparan como un Lanzallamas (puede disparar aunque el personaje mueva o marche) que puede estimar hasta 3 dados. Se resuelve con Fuerza 8, tira para herir contra el Liderazgo del objetivo en lugar de contra su Resistencia y no permite tirada de salvación por armadura; cualquier unidad que sufra al menos una baja por esto deberá realizar inmediatamente un chequeo de Pánico. Si obtienes un resultado de Problemas, el disparo simplemente no se realiza (no tires en la tabla de Problemas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Resolución oscura" id="2688-d595-f683-0d94" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="21f9-2104-3f65-8e34" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="ee6e-255a-8a7e-24c3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
