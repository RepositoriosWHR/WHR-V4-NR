          <modifiers>
            <modifier field="name" type="append" value="(4+)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="4d55-4e4b-602e-4758" type="increment" value="1">
          <repeats>
            <repeat childId="c35d-237a-bec8-42d2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="1"/>
          </repeats>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Regeneración mutante" id="7903-d2d4-c533-6b7f" hidden="false">
          <description>Regeneración (4+). Si regeneran 2 o más heridas en una misma fase, tira en la tabla de Ojo de los Dioses y aplica el resultado a toda la unidad. Considera los resultados de 11 a 14 como “El Ojo está cerrado”.</description>
        </rule>
        <rule name="Gran vómito de troll" id="e1c3-a1fd-639f-9a38" hidden="false">
          <description>En vez de atacar, el Troll del Caos anciano puede causar 1D3 impactos automáticos de Fuerza 5 sin tirada de salvación por armadura a una unidad enemiga en contacto peana con peana.</description>
        </rule>
      </rules>
