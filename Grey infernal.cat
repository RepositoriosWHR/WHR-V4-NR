              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Por cada herida causada en combate cuerpo a cuerpo por el personaje tira 1D6; con un resultado de 5+, podrás añadir un dado de Energía o Dispersión durante la próxima fase de magia (según corresponda).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Aura mágica de Tzeentch" id="abed-76ac-bf20-ac3a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8f16-3f09-205d-8c14" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="0ca0-3827-b752-ba06" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
