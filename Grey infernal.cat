    <selectionEntry name="[E] - Mutalith, la bestia del Vórtice" id="74d1-9bc5-1d0d-f2a2" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="da9b-412f-2b73-6432" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
