          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="175"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gigante del Caos" id="8064-8e45-2ff7-9c8c" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">7</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">3</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">2</characteristic>
                <characteristic name="F" typeId="5.323232344415441e+21">6</characteristic>
                <characteristic name="R" typeId="5.423232344415441e+21">6</characteristic>
                <characteristic name="H" typeId="5.723232344415441e+21">6</characteristic>
