                  <description>Obtienen laregla especial Inmune a pánico; además, pueden realizar una tirada enla tabla de Destruir la civilización antes del despliegue y pueden repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="39f6-d6fc-a1ae-b8ff" collective="false" hidden="false" import="true" targetId="5a2a-6be8-da51-4912" type="selectionEntry">
              <infoLinks>
                <infoLink name="Odio (todos los enemigos)" id="2a0e-0dc0-d2e7-283f" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink name="Resistencia mágica (1)" id="c573-4571-6dbf-0d9b" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
