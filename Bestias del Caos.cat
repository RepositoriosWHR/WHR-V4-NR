      <selectionEntries>
        <selectionEntry name="Cáliz de Plaga" id="a66c-6633-9ba4-5315" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e7c0-ec5d-969a-0b02" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="0275-3291-239f-a81b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cáliz de Plaga" id="d211-c088-98fd-c3bf" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Nurgle. Al inicio de cada fase de magia, el personaje puede beber del cáliz. Si lo hace, deberá realizar un chequeo de Resistencia. Si supera el chequeo, obtiene inmediatamente 1D3 dados de Energía o Dispersión, según corresponda, que tan sólo podrá usar el chamán. Si falla, sufrirá una herida automática sin tirada de salvación de ningún tipo salvo Regeneración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
