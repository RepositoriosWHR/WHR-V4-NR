              <infoLinks>
                <infoLink name="Terror" id="e3d9-0744-7b0c-38bf" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Takunta&apos;Maha" id="baca-ebc3-9436-ec08" hidden="false">
                  <description>Takunta&apos;Maha porta la marca de Nurgle, que hace que cause Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
