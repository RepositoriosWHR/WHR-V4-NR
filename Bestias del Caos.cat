              </modifiers>
              <rules>
                <rule name="Marca del Caos absoluto. Gors" id="6cc0-131f-4f12-54ee" hidden="false">
                  <description>Obtienen la regla especial Inmune a pánico; además, pueden realizar una tirada en la tabla de Destruir la civilización antes del despliegue y pueden repetir sus tiradas en la tabla de Destruir 
la civilización.</description>
                </rule>
              </rules>
            </entryLink>
