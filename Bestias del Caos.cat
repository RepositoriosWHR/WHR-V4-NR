                <infoLink name="Ataques flamígeros" id="fef2-7b44-7881-d284" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Ograh el Astuto" id="f7d4-df2c-c881-9138" hidden="false">
                  <description>Ograh porta la Marca de Tzeentch, que le otorga la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella), así como un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
