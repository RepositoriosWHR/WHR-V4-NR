              <infoLinks>
                <infoLink name="Inmune al pánico" id="c8ee-a7c5-0ae6-8f88" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink name="Piel escamosa (6+)" id="b7be-6453-4e84-77f4" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Bestia maldita" id="fa7a-845a-6e76-c311" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (6+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
            </entryLink>
