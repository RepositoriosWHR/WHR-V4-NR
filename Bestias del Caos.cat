                <infoLink name="Resistencia mágica (2)" id="202d-5943-a8b1-feeb" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
                <infoLink name="Carga devastadora" id="9cba-ea38-f525-4a99" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
              </infoLinks>
