            <entryLink name="Marca de Tzeentch. Personajes" id="8fb0-fbe0-723c-c0e9" collective="false" hidden="false" import="true" targetId="5d72-4fd2-3631-9d37" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
