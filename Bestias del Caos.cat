          </constraints>
          <entryLinks>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="a4d4-e30f-27e8-a31b" collective="false" hidden="false" import="true" targetId="c48b-0028-1339-9ee7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune al pánico" id="2b17-4c1f-cea9-0d09" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink name="Piel escamosa (6+)" id="b2e3-834e-5ae6-b922" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Chamán del rebaño" id="beb9-4e3d-af1a-4481" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (6+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="5377-91d2-a9bc-21d1" collective="false" hidden="false" import="true" targetId="5d72-4fd2-3631-9d37" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="3ec5-90d0-a841-e6cb" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Chamán del rebaño" id="768a-e18c-e180-c2ad" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="f9d9-9c17-b6cc-4564" collective="false" hidden="false" import="true" targetId="6957-61b9-3179-47e8" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="d987-e909-6b1f-11e4" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Chamán del rebaño" id="44a7-df0b-deb1-f9e9" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="f669-3018-2db1-75a5" collective="false" hidden="false" import="true" targetId="637a-8947-fb1a-55c0" type="selectionEntry">
