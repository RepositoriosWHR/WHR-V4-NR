            <entryLink name="Marca de Tzeentch. Personajes" id="81f7-9f25-ca1f-2f5f" collective="false" hidden="false" import="true" targetId="5d72-4fd2-3631-9d37" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="4251-5b97-cdbd-c804" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="1374-583e-a48e-993e" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Semental centigor" id="1a5b-a60e-ece7-4bd3" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="76d6-7dde-9a81-ad2f" collective="false" hidden="false" import="true" targetId="6957-61b9-3179-47e8" type="selectionEntry">
