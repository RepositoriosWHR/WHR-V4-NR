            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Fetiche del árbol brujo" id="ba62-3103-6c28-976d" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Una vez por fase de magia propia, el personaje podrá repetir la tirada de un único dado de Energía al lanzar un hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos Hechizados - Reliquias - Bestias del Caos" id="1cdd-2a60-edf2-2efe" collective="false" hidden="false" import="true">
