    <selectionEntry name="[E] - Conde Mordrek, el Condenado" id="e0bc-1d80-e43b-18be" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="a856-a558-ef69-e908" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="09fa-d410-4d81-a4b9" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
