              </costs>
              <infoLinks>
                <infoLink name="Inmune al pánico" id="78f4-02c6-bc8d-d542" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink name="Piel escamosa (5+)" id="8c79-3ab8-7a6e-76a7" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Semental centigor" id="d7fa-a199-8e7b-0716" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (5+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="d125-29e9-470b-0b0d" collective="false" hidden="false" import="true" targetId="0eda-2327-8a26-54ac" type="selectionEntry">
