              <infoLinks>
                <infoLink name="Miedo" id="8415-4757-2b67-4e51" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Semental centigor" id="c697-b8b5-0201-5a6f" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
