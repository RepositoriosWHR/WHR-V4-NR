          </constraints>
          <selectionEntries>
            <selectionEntry name="Portador de la descomposición" id="33a8-a2fd-e80c-9787" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="c4d2-191d-adb4-c641" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="6c0b-9434-18f2-cbd4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Portador de la descomposición" id="bbe7-5c42-1bab-cff5" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Por cada herida causada por uno de los ataques de Lenguababosa, la miniatura herida deberá hacer un chequeo de Resistencia. Si lo falla, sufrirá 1D6 heridas automáticas adicionales sin tirada de salvación por armadura. Además, todos los lanzamientos de hechizos de los Saberes de la Muerte, la Plaga y/o Nurgle obtendrán un bonificador de +2 a su valor total de lanzamiento, mientras que los lanzamientos de hechizos de los Saberes de la Vida o Alta Magia sufrirán un penalizador de -2 a su valor total de lanzamiento.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
        <selectionEntryGroup name="Marca del Caos" id="3188-3763-1178-c38a" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="3856-7d8c-cdc2-c441" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="dd67-b719-742d-0bc6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="Marca de Nurgle. Personajes" id="7e06-b918-9ef1-b15e" collective="false" hidden="false" import="true" targetId="6957-61b9-3179-47e8" type="selectionEntry">
              <constraints>
                <constraint id="9f81-812e-d390-188d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Terror" id="35b9-bd0f-f133-8661" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Molokh" id="2cc0-ca4a-6b6c-d8af" hidden="false">
                  <description>Molokh porta la Marca de Nurgle, que hace que cause Terror. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Los saberes de la magia" id="8ad5-e7f6-e4d7-6f4c" collective="false" hidden="false" import="true">
