      <selectionEntries>
        <selectionEntry name="Cuerno de la primera bestia" id="b297-736a-695f-0842" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aea9-951a-9a5b-a45e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c37a-4b72-9638-b86c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
