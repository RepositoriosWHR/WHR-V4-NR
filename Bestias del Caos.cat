            <profile name="Cimitarras de Skultar" id="72a2-8b71-36f6-5c44" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los impactos con estas armas se resuelven con la regla especial Poder de penetración. Los resultados naturales de 6 en tiradas para herir con estas armas no permiten tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
