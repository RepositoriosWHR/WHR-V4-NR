              <infoLinks>
                <infoLink name="Ataques flamígeros" id="f11c-4a2e-46b1-59a0" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="9fbd-fdc8-c7bb-5efb" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Beligor" id="5242-6fe8-99ac-785b" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="6243-c454-7f4e-dbae" collective="false" hidden="false" import="true" targetId="6957-61b9-3179-47e8" type="selectionEntry">
              <costs>
