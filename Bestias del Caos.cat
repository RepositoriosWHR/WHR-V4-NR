            <profile name="Tótem de rabia y odio" id="41a6-e343-18ef-8239" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen las reglas especiales Carga devastadora y Odio (¡todos los enemigos!). Si tienen la marca de Khorne, en su lugar podrán repetir todas sus tiradas fallidas para impactar en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de carne viva" id="f8e9-d7fc-26bd-95c5" collective="false" hidden="false" import="true" page="0" type="upgrade">
