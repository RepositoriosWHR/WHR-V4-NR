              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Gorthor" id="c705-d42d-c337-b0b1" hidden="false">
                  <description>Causa Miedo: además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="1aae-650c-9515-bf64" collective="false" hidden="false" import="true" targetId="5d72-4fd2-3631-9d37" type="selectionEntry">
              <constraints>
                <constraint id="43e5-f0ea-abc0-7ec7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="931d-e200-0dab-8657" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="340b-d911-df45-016b" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Gorthor" id="577c-43ff-6e13-35a4" hidden="false">
                  <description>Ataques flamígeros y una tirada de salvación especial (6+, o +1 si ya disponía de ella), además de un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
