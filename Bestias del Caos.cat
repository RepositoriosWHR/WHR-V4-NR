              <infoLinks>
                <infoLink name="Miedo" id="faad-f223-691c-373a" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Beligor" id="7ea4-86fe-2089-4fa6" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
