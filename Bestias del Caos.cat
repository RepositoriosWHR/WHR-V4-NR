            <profile name="Augurio divino" id="4e42-4025-6161-20f2" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensas de las Bestias del Caos">
              <characteristics>
                <characteristic name="Propiedades mágicas" typeId="c061-8049-b24d-6e12">Al inicio de la batalla, tras el despliegue, tira 1D3+1: ese será el número de tiradas que pueda repetir el personaje durante la partida. Puede tratarse de tiradas para impactar, herir, salvaciones por armadura o especiales, chequeos de atributo (incluyendo de Liderazgo), tiradas de Regeneración o dados de Energía o Dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cola maza" id="d3b1-610b-137d-33a6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="35f4-9adc-dab5-891d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
