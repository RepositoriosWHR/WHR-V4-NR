          </infoLinks>
          <profiles>
            <profile name="Gran Colmillo" id="fb1c-f1b0-2db3-9a58" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados con este arma siempre hieren con un resultado de 2+, sin importar la Resistencia del objetivo. Además, se resuelven con la regla especial Poder de penetración.</characteristic>
              </characteristics>
            </profile>
