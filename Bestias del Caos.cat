          <profiles>
            <profile name="Mangual de bronce" id="d33b-ef7e-9edf-b787" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Mangual. Al inicio de cada ronda de combate cuerpo a cuerpo, elige una única miniatura enemiga en contacto peana con peana con el portador. Este arma causa a esa miniatura un impacto automático de Fuerza 5.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos Arcanos - Bestias del Caos - Nurgle" id="222d-da28-fadd-ef85" collective="false" hidden="false" import="true">
