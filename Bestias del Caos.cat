          <entryLinks>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="e70c-9997-b408-d410" collective="false" hidden="false" import="true" targetId="c48b-0028-1339-9ee7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune al pánico" id="333a-32a7-3751-e125" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Ungor Oscuro" id="03e1-45a7-056b-9e24" hidden="false">
                  <description>Obtiene la regla especial Inmune a pánico, puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="c5ef-f603-e4a0-4485" collective="false" hidden="false" import="true" targetId="0eda-2327-8a26-54ac" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Odio (todos los enemigos)" id="4eff-f231-7ffa-783a" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink name="Resistencia mágica (1)" id="ba5d-1f65-81f5-ef6c" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink name="Carga devastadora" id="7306-339b-43fd-cb0c" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="1287-47d3-5469-5816" collective="false" hidden="false" import="true" targetId="5d72-4fd2-3631-9d37" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="bfd4-f8c3-bb35-ab72" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Ungor Oscuro" id="77c0-e391-6136-357e" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="9370-4750-87de-fb12" collective="false" hidden="false" import="true" targetId="6957-61b9-3179-47e8" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques envenenados" id="f46a-ca5c-368b-e6ba" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Ungor Oscuro" id="c909-00d0-286e-bccb" hidden="false">
                  <description>Obtiene las reglas especiales Ataques envenenados. Además, los enemigos tienen un penalizador de -1 para
impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="6efd-13a4-640a-e704" collective="false" hidden="false" import="true" targetId="637a-8947-fb1a-55c0" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Sangre fría" id="fdb2-dd9a-da9b-33af" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink name="Poder de penetración" id="f307-4946-35bf-d6e3" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Slaanesh. Ungor Oscuro" id="030a-5611-ca47-7393" hidden="false">
                  <description>Obtiene +1 a sus atributos de Movimiento e Iniciativa y las reglas especiales Sangre fría y Poder de penetración.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
