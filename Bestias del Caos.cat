            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Don del cambio" id="39c9-a0bd-5c4e-eafd" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensas de las Bestias del Caos">
              <characteristics>
                <characteristic name="Propiedades mágicas" typeId="c061-8049-b24d-6e12">Sólo hechiceros. Un sólo uso. Puede utilizarse durante cualquier fase de magia propia para lanzar un hechizo (incluso uno potenciado) sin invertir dados de Energía. El hechizo será lanzado con Fuerza irresistible; tras resolver el hechizo, el hechicero debe realizar una tirada en la tabla de Disfunciones mágicas, aunque tirará con 1D6+6 en lugar del habitual 2D6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
