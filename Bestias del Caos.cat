              <characteristics>
                <characteristic name="Propiedades mágicas" typeId="c061-8049-b24d-6e12">El personaje obtiene un ataque adicional en combate cuerpo a cuerpo, que se resolverá siempre con Fuerza 5.</characteristic>
              </characteristics>
            </profile>
