              <characteristics>
                <characteristic name="Propiedades mágicas" typeId="c061-8049-b24d-6e12">Al inicio de cada uno de tus turnos, el personaje recupera una de las heridas que hubiese sufrido previamente durante la batalla.</characteristic>
