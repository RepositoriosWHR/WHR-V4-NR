    <selectionEntryGroup name="Recompensas mayores - Hechiceros - Tzeentch" id="9d17-75d1-4b0e-e9ae" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Don del cambio (Sólo hechiceros)" id="7a15-bce3-cbeb-0e5f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1b3b-05a8-290a-130a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="c946-0a8a-3d23-9e52" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
