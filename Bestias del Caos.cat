              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <rules>
                <rule name="Marca del Caos absoluto. Gigante del Caos" id="83ce-185d-4dc1-73e0" hidden="false">
                  <description>Obtiene una tirada de salvación por armadura de 5+.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="ba34-6aeb-a79f-46cd" collective="false" hidden="false" import="true" targetId="5a2a-6be8-da51-4912" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Resistencia mágica (1)" id="2520-a286-4974-1ee5" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Khorne. Gigante del Caos" id="4498-2d32-6641-c82b" hidden="false">
                  <description>Obtiene la regla especial Resistencia mágica (1); además, suma +1 a todas las tiradas en la tablas de ataques especiales del gigante (los resultados superiores a 6 se consideran 6)</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Unidades" id="9549-9db1-0430-74b5" collective="false" hidden="false" import="true" targetId="192e-4d0e-4347-b1b1" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="59d3-0fb7-e8d9-eb75" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Gigante del Caos" id="06c8-8279-d6ca-6caa" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="3e1f-9561-1959-4074" collective="false" hidden="false" import="true" targetId="7be1-00a2-f389-5c87" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <rules>
                <rule name="Marca de Nurgle. Gigante del Caos" id="865c-9851-ad48-29f2" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y en cuerpo a cuerpo.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="0617-e578-dd79-d5fd" collective="false" hidden="false" import="true" targetId="e1e7-28a3-3109-361e" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Poder de penetración" id="48d8-8cf6-06d6-3625" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Slaanesh. Gigante del Caos" id="4f4f-40c8-cb5d-5ca7" hidden="false">
                  <description>Obtiene la regla especial Poder de penetración en todos sus ataques y +1 Iniciativa.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
