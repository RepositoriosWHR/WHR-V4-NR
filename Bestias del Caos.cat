          <profiles>
            <profile name="Familiar del Caos" id="c136-f5ba-7507-9eae" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía y Dispersión. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo de Darkoth" id="db55-1e81-d1c6-6a68" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cef7-66fd-4a98-2091" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4e29-f18d-36f2-0951" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo de Darkoth" id="42ce-9cfd-ee56-3df8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje conoce un hechizo adicional. Además, tendrá un bonificador de +1 a las tiradas para lanzar sus hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cráneo de Rarkos" id="b999-5bd0-2d58-1832" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d0d3-c0b2-cbb4-6888" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="81b7-7ccf-497b-adce" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cráneo de Rarkos" id="b87f-d664-28a8-900f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, determina al azar un hechizo en la siguiente tabla: el Cráneo de Rarkos es un objeto portahechizos con nivel de energía 4 que lanza el hechizo indicado (no puede lanzarse la versión potenciada de ninguno de los hechizos):
1- Enredadera Escarlata (Saber del fuego)
2- Maldición del viento de medianoche (Saber de los Cielos)
3- Aflicción de Dain (Saber de la Vida)
4- Luz cegadora de Amshu (Saber de la Luz)
5- Atrofia gris (Saber de las Sombras)
6- Oro de los insensatos (Saber del Metal)</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fetiche del árbol brujo" id="e44a-2e76-a408-147a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2438-dcb3-e108-5ac6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="ef2b-f951-d03c-737a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
