        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="2a81-6a0c-edfa-b306" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="1378-c8c9-d665-4f67" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Algo malévolo está por suceder" id="5e08-f5af-97de-366a" hidden="false">
          <description>Las unidades enemigas a 6” o menos de Malagor no podrán beneficiarse de la Regla Especial Presencia Inspiradora.</description>
        </rule>
        <rule name="Poderío Impío" id="1693-1212-b9b1-df45" hidden="false">
          <description>Malagor tiene un bonificador a sus tiradas de lanzamiento de hechizos igual al número del turno en curso (+1 en el turno 1, +2 en el turno 2, etc). Además, posee una tirada de salvación especial de 5+ (que se incrementa a 4+ por la Marca de Tzeentch).</description>
        </rule>
        <rule name="Magia de Malagor, el Profeta Oscuro" id="7120-b295-7930-8428" hidden="false">
          <description>Malagor es un hechicero de nivel 4. Puede elegir sus hechizos de entre los Saberes de la Muerte, de las Bestias, de las Sombras, de Magia Oscura, de Tzeentch, de Nurgle y/o de Slaanesh y puede elegir sus hechizos de dos o más de los saberes listados.</description>
        </rule>
        <rule name="Gran chamán" id="3b87-f080-33a1-7e14" hidden="false">
          <description>Malagor conoce 8 hechizos en lugar de los 4 que corresponderían a su nivel.</description>
        </rule>
      </rules>
      <selectionEntries>
