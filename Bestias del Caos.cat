      </infoLinks>
      <rules>
        <rule name="General del ejército" id="a9fd-60aa-f6d8-54c1" hidden="false">
          <description>Un Ungor oscuro no puede ser el señor de una Hueste del Caos a menos que toda su hueste esté compuesta por Ungors, Mastines del Caos, Garragors, Engendros del Caos, Mutantes del Caos y Gigantes del Caos.</description>
        </rule>
        <rule name="Marcado por los dioses" id="c598-45c8-8bd4-be84" hidden="false">
          <description>Una unidad de Ungors que incluya un Ungor oscuro obtiene la regla especial Destruir la civilización mientras este esté dentro.</description>
        </rule>
      </rules>
