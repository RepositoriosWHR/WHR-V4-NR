              <rules>
                <rule name="Marca del Caos absoluto. Conde Mordrek" id="8359-4c47-3f5f-3889" hidden="false">
                  <description>Mordrek porta la Marca del Caos absoluto, que le permite repetir sus tiradas de salvación por armadura fallidas.</description>
