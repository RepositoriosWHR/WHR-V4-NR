              <characteristics>
                <characteristic name="Propiedades mágicas" typeId="c061-8049-b24d-6e12">El personaje obtiene las reglas especiales Inmune a veneno y Ataques envenenados; los resultados de 5 natural al impactar se considerarán Ataques envenenados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Putrefacción de Nurgle" id="31cc-50f8-33dc-454c" collective="false" hidden="false" import="true" type="upgrade">
