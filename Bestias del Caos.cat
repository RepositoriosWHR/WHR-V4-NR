            <infoLink name="Ansia de sangre" id="cca3-7cc9-16d0-2e28" hidden="false" targetId="2a68-a009-1a7a-c667" type="rule"/>
            <infoLink name="Odio (todos los enemigos)" id="6322-bfd2-6533-4618" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Diente ensangrentado" id="7c3f-1c4e-43a4-8c27" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador estará sujeto a las reglas especiales Furia asesina, Ansia de sangre y Odio (¡todos los enemigos!). Además, es un objeto portahechizos con nivel de energía 4 que contiene el hechizo Furia vengadora (Saber de las Bestias).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes Mágicos - Reliquias - Bestias del Caos" id="01ee-4fc3-0169-90a5" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4fcd-4409-7222-728b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte de la Gran Bestia" id="c2d1-2add-b832-0a88" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d0cb-680d-9e57-5ec7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
