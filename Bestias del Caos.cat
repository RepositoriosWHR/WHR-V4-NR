                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Proporciona a Ograh la regla especial Piel escamosa (4+). 
Objetos mágicos:</characteristic>
                  </characteristics>
                </profile>
              </profiles>
