                <infoLink name="Resistencia mágica (2)" id="f4f8-618e-5a57-73ec" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
                <infoLink name="Furia asesina" id="3819-f282-965f-ca36" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="hidden" type="set" value="true">
                  <conditions>
                    <condition childId="614d-bf3c-8921-4b1d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="eb05-db35-d587-b1fb" shared="true" type="equalTo" value="1"/>
                  </conditions>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Khorne. Gran bestia ungida" id="2f99-8d28-9208-ccfa" hidden="false">
                  <description>Obtiene las reglas especiales Furia asesina, Odio (¡Todos los enemigos!) y Resistencia mágica (2). No pierde su Furia asesina si es derrotado en combate.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="2aee-3fb6-d7bf-e225" collective="false" hidden="false" import="true" targetId="5d72-4fd2-3631-9d37" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="456f-ede7-1ed6-cc03" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Inmune al fuego" id="b3b3-6a8a-3385-3556" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Gran bestia ungida" id="c9f4-b81e-70a8-9194" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros e Inmune a fuego y una tirada de salvación especial de 5+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="cc31-8253-4170-1be6" collective="false" hidden="false" import="true" targetId="6957-61b9-3179-47e8" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques envenenados" id="1b0f-53a5-8b18-566e" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Gran bestia ungida" id="fe87-bbaa-83dc-0348" hidden="false">
                  <description>Obtiene la regla especial Ataques envenenados. Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1HA.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="ff86-8304-9cfb-ccde" collective="false" hidden="false" import="true" targetId="637a-8947-fb1a-55c0" type="selectionEntry">
