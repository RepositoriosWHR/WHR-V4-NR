                <infoLink name="Piel escamosa (6+)" id="683f-c1a5-e018-fe6b" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Beligor" id="0fed-49b9-123a-65e3" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (6+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="d040-c878-d932-8eb1" collective="false" hidden="false" import="true" targetId="0eda-2327-8a26-54ac" type="selectionEntry">
