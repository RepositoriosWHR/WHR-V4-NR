          <entryLinks>
            <entryLink name="Marca del Caos absoluto. Personajes" id="49d4-d883-d6ce-26d8" collective="false" hidden="false" import="true" targetId="c48b-0028-1339-9ee7" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune al pánico" id="907b-571e-ecb0-7da7" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
                <infoLink name="Piel escamosa (6+)" id="bbdb-0a89-8414-44c3" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Gran chamán del rebaño" id="e523-00ba-da0a-4fb8" hidden="false">
                  <description>Obtiene las reglas especiales Inmune a Pánico y Piel escamosa (6+); puede realizar una tirada en la tabla de Destruir la civilización antes del despliegue y puede repetir sus tiradas en la tabla de Destruir la civilización.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="8a45-2bd3-f1c2-6db4" collective="false" hidden="false" import="true" targetId="5d72-4fd2-3631-9d37" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="fff5-2d9a-26cc-3f7d" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Gran chamán del rebaño" id="a70d-1619-57b4-1ddc" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="c69e-b9be-7d1d-baa9" collective="false" hidden="false" import="true" targetId="6957-61b9-3179-47e8" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="c318-d94b-dd52-7b71" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Gran chamán del rebaño" id="9c89-f427-27ee-614d" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="3275-13f0-4822-5b4c" collective="false" hidden="false" import="true" targetId="637a-8947-fb1a-55c0" type="selectionEntry">
