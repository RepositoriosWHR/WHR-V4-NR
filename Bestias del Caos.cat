          </entryLinks>
          <profiles>
            <profile name="Corona de Cuernos" id="faa1-c0d3-1df6-298c" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo General del ejército. Proporciona a su portador una tirada de salvación especial de 4+ y aumenta en 6” el radio de su Presencia inspiradora. Además, todas las unidades amigas dentro del radio de su Presencia inspiradora podrán repetir todas sus tiradas de carga fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
