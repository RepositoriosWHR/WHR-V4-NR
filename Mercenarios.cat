          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Reliquias Ogras - Armaduras" id="a88b-971e-f422-17f9" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="958e-7e4c-b27c-5678" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Armadura de las Fauces" id="28da-54c1-8234-0308" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (4+)" id="02fd-a3f1-6fa1-07ae" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura de las Fauces" id="cf7c-21d6-3a05-1473" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. El portador obtiene la regla especial Regeneración (4+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño Codicioso" id="4561-7d83-bf99-9042" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Parada" id="ed23-7f87-ae7f-fb9f" hidden="false" targetId="9d92-3851-6695-cf71" type="rule"/>
            <infoLink name="Puño de hierro" id="b7d8-eeff-47bc-6f7a" hidden="false" targetId="61a6-d06b-d037-d136" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Puño Codicioso" id="d66e-2d15-e8c7-f684" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Puño ogro. El portador obtiene una tirada de salvación especial de 5+. Si el portador salva una o más heridas causadas por un Arma mágica con esta salvación especial, el Arma mágica quedará destruida y pasará a considerarse un arma mundana de su mismo tipo. Un hechicero herido por el Puño codicioso debe tirar 1D6 al final de la fase de combate cuerpo a cuerpo en la que fue herido: si obtiene un resultado superior, perderá inmediatamente un nivel de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Puño de Hierro" id="0c7d-fffe-6615-65e6" hidden="false">
              <description>Al inicio de cada combate la unidad decidirá si los usa como escudo o como una maza ogra como arma de mano adicional. Si se utiliza como escudo puede usarse Parada.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes ogros" id="7b56-77db-7c26-d60f" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="cba3-f63b-b34d-e4ec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Piedraladrona Gnoblar" id="6fd4-fabb-45ca-1d47" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (2)" id="9cfd-e661-fb77-9a6b" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Piedraladrona Gnoblar" id="a8e4-a005-db53-57ef" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene la regla especial Resistencia mágica (2). Además, tira 1D6 al inicio de la batalla: el portador obtendrá el objeto mágico indicado en la tabla. Ten en cuenta que es posible tener dos objetos mágicos del mismo tipo gracias al efecto de la Piedraladrona gnoblar.
1: Amuleto de la suerte.
2: Semilla de renacimiento.
3: Poción de fuerza.
4: Gema del fuego.
5: Anillo del fuego infernal.
6: Poción de curación.</characteristic>
              </characteristics>
            </profile>
