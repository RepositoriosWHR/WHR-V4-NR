              <characteristics>
                <characteristic name="Reglas especiales" typeId="f05e-207b-7f53-ab87">El ejército no podrá incluir miniaturas con la regla especial No muerto o Demonio. El personaje obtiene una tirada de salvación especial de 5+ y resistencia mágica (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Capitán veterano" id="b44a-9c70-ff50-a708" collective="false" hidden="false" import="true" type="upgrade">
