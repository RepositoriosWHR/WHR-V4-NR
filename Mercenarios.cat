        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Caballería" id="1fda-0dde-4821-2923" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
        <infoLink name="Mercenario" id="01b3-3590-481b-13a3" hidden="false" targetId="f693-0c5c-49bd-91e7" type="rule"/>
        <infoLink name="Ataques envenenados" id="7c2a-a4c5-ca03-6d79" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Lucrezzia Belladonna, la mujer más hermosa de Tilea " id="9ad5-680a-14a3-c22c" hidden="false">
          <description>Lucrezzia es una poderosa maga. Tiene nivel de magia 3. Puede elegir sus hechizos del Saber de la Muerte.</description>
        </rule>
        <rule name="Belleza sobrecogedora" id="4a58-d072-54c1-889a" hidden="false">
          <description>Si se incluye dentro de una unidad puede situarse en el centro de la segunda fila pese a ser personaje (mientras haya una segunda fila), y cualquier personaje u oficial puede aceptar un desafío en su lugar, empezando por los personajes u oficial de la unidad (no tiene efecto contra habilidades que permitan escoger el objetivo de un desafío).</description>
        </rule>
        <rule name="Vial de veneno" id="66f5-c3cd-f862-9121" hidden="false">
          <description>Una vez por batalla, al inicio de cualquier fase de combate, puedes declarar que Lucrezzia usa el vial de veneno. Hasta el inicio de la siguiente fase, los ataques de Lucrezzia se resuelven con las reglas especiales Ataques envenenados y Heridas múltiples (1D6); esto no afecta a miniaturas con la regla especial Inmune a veneno.</description>
        </rule>
      </rules>
