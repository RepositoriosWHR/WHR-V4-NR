              <profiles>
                <profile name="Hacha certera" id="94ae-2241-b069-570e" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Hachas de matador. Tienen grabadas una Runa magistral del vuelo (El arma puede usarse como arma de disparo que retorna a la mano de su portador tras ser usada. Tiene un alcance de 10”, la Fuerza del usuario y las reglas especiales Ataques mágicos, Disparo rápido y Arrojadiza, así como las demás propiedades que confieran otras runas grabadas en el arma) y una Runa de la agonía (Heridas múltiples (1D3)).</characteristic>
                  </characteristics>
                </profile>
                <profile name="Hachas de matador" id="97b2-da1e-fc79-f502" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323"/>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">En cada combate puedes elegir si utilizarlas como arma a dos manos o como dos armas de mano.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
