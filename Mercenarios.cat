      <rules>
        <rule name="Repliegue" id="570c-f648-5e59-9927" hidden="false">
          <description>Obtienen la regla especial Veloz al realizar movimientos de Huida. Si son objetivo de una carga pueden efectuar la reacción “Disparar y huir” del mismo modo que las unidades de caballería rápida.</description>
        </rule>
        <rule name="Unidad secundaria" id="8358-4d73-fac2-17f6" hidden="false">
          <description>No podrás incluir en el ejército mas unidades con esta regla que sin ella.</description>
        </rule>
