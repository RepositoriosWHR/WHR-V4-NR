            <profile name="Armadura sagrada de Miragliano" id="2ee8-054d-235c-be7a" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Otorga al portador la regla especial Inmune a Veneno y una tirada de salvación Especial (4+)</characteristic>
