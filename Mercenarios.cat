              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados con esta espada se resuelven con un +1 a la fuerza de su portador y no permiten tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
