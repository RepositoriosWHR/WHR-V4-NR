            <constraint id="cfee-cd79-9972-21fb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="beab-98a0-fd8a-5f63" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Requiere ambas manos" id="c4eb-3c55-669f-48d3" hidden="false" targetId="41a9-6192-62dd-4867" type="rule"/>
            <infoLink name="Inmune al veneno" id="e9f9-5ffa-7ca2-fdb5" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Matasierpes" id="b6b7-9c05-f8ce-5045" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Requiere ambas manos. Los impactos con este arma se resolverán con un bonificador de +1 a la Fuerza. Los impactos de esta arma siempre herirán con un resultado de 4+ salvo que la Fuerza del ataque permita herir con un resultado menor. Cualquier miniatura herida por esta arma no podrá beneficiase de su salvación por Piel escamosa para salvar dicha herida. Por último, el portador obtiene la regla especial Inmune a veneno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas ogras" id="7c68-64b4-2247-db70" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e531-33e0-22ed-247f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Armadura de Mastodonte" id="d9a9-d471-b713-059a" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura pesada" id="8b4c-d450-e07e-fa5f" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura de Mastodonte" id="57b6-e4fd-80e4-209a" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Al inicio de cada uno de tus turnos, el personaje recupera una de las heridas que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Grancráneo" id="a19d-b795-c8d5-8d21" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Protegetripas" id="38e5-5b5c-3527-8800" hidden="false" targetId="0716-5750-5439-839a" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Grancráneo" id="34dc-5a30-f7d5-4ef9" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. Cualquier hechicero que designe como objetivo de uno de sus hechizos a la unidad en la que esté el portador obtendrá una Disfunción mágica con cualquier resultado de dobles en su tirada de lanzamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Protegetripas de las Grandes Fauces" id="bae7-0ee9-c48a-1e25" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="ddf6-570c-1326-0456" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
            <infoLink name="Protegetripas" id="136c-4635-88ff-0f7d" hidden="false" targetId="0716-5750-5439-839a" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Protegetripas de las Grandes Fauces" id="b27c-b5eb-4af2-3a91" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. El portador causa Terror. Cada vez que el portador acabe con un enemigo en un Desafío, puede restaurar una de las heridas perdidas previamente durante la batalla. Si no había sufrido heridas, obtiene permanentemente +1 Herida en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tripa de toro" id="70c5-f746-ffa6-34c0" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Protegetripas" id="c8b0-7fc8-f4e7-99ed" hidden="false" targetId="0716-5750-5439-839a" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Tripa de toro" id="97ec-453e-1d71-776e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Protegetripas. El portador y la unidad en la que se encuentre duplican su Potencia de unidad en el turno en el que realizan exitosamente una carga. Además, todos los impactos por carga que cause el portador tendrán la regla especial Poder de penetración.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pellejo de colmillos de trueno" id="8e72-6371-76d2-5e11" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Aura de frio" id="a489-2322-f079-424d" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
            <infoLink name="Armadura ligera" id="f5fd-1707-0ee0-cc5d" hidden="false" targetId="44f2-32d5-23eb-62f5" type="profile"/>
            <infoLink name="Piel escamosa (5+)" id="706a-3f64-4570-27af" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pellejo de colmillos de trueno" id="f025-4e5f-ea7f-c9c9" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura ligera. Otorga a su portador las reglas especiales Piel escamosa (5+) y Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas ogras" id="ecaf-0b43-95ed-ed1b" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4290-6fc4-7efc-1f41" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Cuchillas de la matanza" id="d620-a915-7ea1-085d" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Mazas ogras emparejadas" id="7e25-f51f-8141-fe41" hidden="false" targetId="7ddc-d90f-0a3b-831f" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Cuchillas de la matanza" id="b927-2385-ac5e-6597" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Mazas ogras emparejadas. Triplica el valor de Iniciativa del portador en combate cuerpo a cuerpo. Los ataques con este arma se resuelven con la regla especial Ataques envenenados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes Mágicos ogros" id="48a3-0b1e-3f85-3b3d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="dd46-cd0c-45f1-7230" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pellejodragón" id="4cfe-3dcb-401a-8aea" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pellejodragón" id="debe-f3c0-7ded-fd83" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad pueden repetir todos los resultados de 1 en sus tiradas para impactar, herir y salvaciones en cualquier turno en el que realicen exitosamente una carga. Además, una vez por batalla, durante cada fase de magia el portador puede desatar un vendaval helado sobre una unidad enemiga en contacto peana con peana con este. La unidad sufre inmediatamente 1D6 impactos de Fuerza 2 sin tirada de salvación por armadura y verá su atributo de Iniciativa reducido a la mitad (redondeando hacia arriba) hasta el final del turno en curso. Esto no afecta a unidades con la regla especial Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de Trapos" id="1acf-8365-2a60-7618" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Sangre fría" id="a32f-0273-f0e1-664a" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de Trapos" id="1574-3aa4-c671-da8f" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Sangre fría.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tótem de los caníbales" id="12ab-eb4f-496c-cc53" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="4998-ac7c-8171-daf7" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink name="Ansia de sangre" id="b65c-a908-eb21-7c79" hidden="false" targetId="2a68-a009-1a7a-c667" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Tótem de los caníbales" id="ac63-dd78-f769-695f" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen las reglas especiales Ansia de sangre y Furia asesina y no la perderán aunque pierdan un combate (sin embargo, la perderán si pierden este estandarte).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de los Toros" id="1c93-e1ff-40bc-8528" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de los Toros" id="734f-e172-f344-c14e" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad podrán repetir sus tiradas para herir fallidas causadas por los Impactos por carga generados por su regla especial Arremetida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de las competiciones de las cuchipandas" id="5d79-8082-5c43-1ab0" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las competiciones de las cuchipandas" id="3882-c1ec-f3a9-97a0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Los impactos que obtienen un resultado natural de 6 en la tirada para herir del portador y su unidad en combate se resolverán con un penalizador de -2 adicional a la tirada de salvación por armadura del oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del Bocaenllamas" id="7e1c-b303-cdbb-e321" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="bcc6-ae66-e09a-7ba3" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Ataques solo flamígeros" id="8d09-5b2c-f0dc-7f49" hidden="false" targetId="5587-433b-16c0-79d1" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del Bocaenllamas" id="66bc-795f-c7a1-58bb" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Ataques flamígeros. Además, al inicio de cada fase de combate cuerpo a cuerpo, elige una unidad enemiga en contacto peana con peana con el portador: dicha unidad sufrirá 1D6 impactos de Fuerza 3 distribuidos como proyectiles con la regla especial Ataques solo flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes Mágicos ogros. Reliquias" id="5010-9584-a781-6736" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f3ad-54a5-3355-59c8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Fauces Rúnicas" id="f4a3-5e8f-8894-24fd" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="2dd9-3948-dd45-8233" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Resistencia mágica (3)" id="46a7-40c3-28b2-405e" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Fauces Rúnicas" id="5080-a1f7-fc79-027b" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Proporciona al portador y su unidad la regla especial Resistencia mágica (3). Además, cualquier hechizo de Potenciación del Saber de Panzamagia lanzado por un hechicero amigo a 24” o menos del portador afectará también al portador y a su unidad (ten en cuenta que se trata del mismo hechizo por lo que, si es dispersado,
dejará de afectar también a esta unidad).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos Hechizados ogros" id="a114-77d1-410a-3ba3" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ffe5-4fa3-5e93-b713" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estatuilla de Bramhir" id="8a4e-1901-b273-fb55" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estatuilla de Bramhir" id="8af8-8f52-202b-c173" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Proporciona a su portador una tirada de salvación especial de 4+ contra todas las heridas causadas por miniaturas del Caos, enanos del Caos o skaven (eso incluye las heridas causadas por hechizos o máquinas de guerra).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Puño glotón" id="2863-99c9-c985-e641" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Orgullo marcial" id="ed59-64c1-29e2-b531" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Puño glotón" id="5afd-fbb7-8df5-818b" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene un bonificador de +1 a su tirada de salvación por armadura y la regla especial Orgullo marcial.
Cuando esté luchando en un Desafío, el portador obtiene un ataque adicional por cada objeto mágico que porte el oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Marca del demonio" id="1ea7-b27e-58f5-5ddb" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="34a4-ae2c-c192-d4c4" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Marca del demonio" id="0786-6f61-4e7d-8527" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador causa Terror.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Corona de laurel" id="cc9f-eea0-4502-5e4c" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Corona de laurel" id="bec1-46d4-569a-65fa" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y su unidad podrán repetir sus chequeos fallidos de Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Barril de licor de lagarto del trueno" id="a8c0-dffc-454a-6dea" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="c194-9094-d68e-e14d" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
            <infoLink name="Inflamable" id="6e96-49a0-5e35-0a1c" hidden="false" targetId="93e4-15ce-63a5-ad92" type="rule"/>
            <infoLink name="Regeneración (6+)" id="7b86-361c-d096-2807" hidden="false" targetId="4aee-7485-a141-cd20" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Barril de licor de lagarto del trueno" id="7ad0-dacf-02c2-fc64" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y la unidad en la que se encuentre obtienen las reglas especiales Regeneración (6+), Inmune a psicología e Inflamable.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Trozo de hielo encantado" id="751f-b8a6-4932-fcd1" collective="false" hidden="false" import="true" type="upgrade">
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Aura de frio" id="5343-6146-329f-9f36" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Trozo de hielo encantado" id="5917-412d-7779-b66f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a su portador la regla especial Aura de frío.</characteristic>
              </characteristics>
