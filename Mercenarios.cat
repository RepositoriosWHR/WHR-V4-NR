      <rules>
        <rule name="Traicioneros" id="2cf1-a480-398e-f9ae" hidden="false">
          <description>Los Despojadores pueden mover y disparar con sus ballestas; además, pueden Disparar y huir como reacción a una carga, siempre que el enemigo que les cargue no sea Veloz.</description>
        </rule>
