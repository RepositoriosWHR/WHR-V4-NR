          <profiles>
            <profile name="Capitán veterano" id="4edd-570d-c3a7-18cc" hidden="false" typeId="b824-aacc-6637-fa81" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="f05e-207b-7f53-ab87">El personaje será Inmune a pánico. Además, el personaje cuenta como si fuese una unidad de Piqueros o Infantería ligera a la hora de incluir una unidad de Infantería pesada en tu ejército.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
