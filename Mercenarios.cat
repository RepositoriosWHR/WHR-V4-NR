          </costs>
          <profiles>
            <profile name="Piedra del retoñar " id="f561-5a0b-4ae3-764a" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo personajes con Potencia de unidad 4 o inferior. Un sólo uso. Cuando el atributo de heridas del portador se reduzca a 0, antes de retirar la miniatura del campo de batalla tira 1D6: si obtienes un resultado de 1, retira al portador como baja con normalidad; con un resultado de 2-5 la miniatura recuperará una herida y, con un resultado de 6, la miniatura recuperará todas sus heridas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Urdimbre de encantamientos " id="c95b-bdd5-428e-a28e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4ab1-bdbd-aece-a04c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7d30-e183-850e-3906" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Urdimbre de encantamientos " id="dae2-3672-8c55-18e1" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador una tirada de salvación especial de 4+ contra disparos y hechizos del tipo Proyectil mágico. Además, toda unidad que intente atacar a su portador en combate cuerpo a cuerpo tendrá que superar un chequeo de Liderazgo: si lo falla, tan sólo logrará impactar con resultados de 6 durante dicha fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Garra del dragón" id="c2d0-1805-5864-751f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9009-cef4-2144-6aa9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a416-9ef1-17b9-b0b1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune al fuego" id="521f-923c-94fe-1f1a" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Garra del dragón" id="47fe-4d16-65df-3c39" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador y la unidad en que se encuentre obtienen la regla especial Inmune a fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Obsequio de la damisela" id="9a85-c18f-95ea-7661" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a46b-a4a0-db68-72ca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8776-e790-7cd7-20db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Obsequio de la damisela" id="2704-a9c1-0eb7-6f09" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un solo uso. El portador puede repetir una tirada de 1D6: puede tratarse de una tirada para impactar, para herir, tirada de salvación por armadura o especial, o un chequeo de atributo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Incienso sagrado" id="4cb1-1c9c-4b7d-f66e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eacc-1842-5e7a-dac4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="652a-5279-456f-2ae5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
