      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte del sol de Chotek" id="e033-6114-cee6-c91d" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="fb9f-7452-1a30-e873" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ce81-55f6-7fec-c452" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
