    <selectionEntry name="Juramento" id="a47c-326d-9577-edab" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="28aa-35eb-24fe-8a3f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="0c00-b3ed-a0f3-174f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <rules>
        <rule name="Juramento" id="1d26-95a9-4590-8385" hidden="false">
          <description>No podrás incluir esta unidad en el mismo ejército que los orcos acorazados o la artillería Orca de Notlob o cualquier otra unidad de pielesverdes (incluyendo hobgoblins.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Fanáticos" id="9a3d-1888-a0e7-053e" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="0b8b-833c-b5ad-14cf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="2926-63af-b78e-dc72" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <rules>
        <rule name="Fanáticos" id="ca30-94b8-32ce-3bfe" hidden="false">
          <description>No pueden incluirse en un ejercito que incluya miniaturas con alguna de las marcas del Caos o las reglas especiales No muerto o Demonio.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Azote de herejes" id="63d4-73c8-a9e6-2806" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="4d7d-6ea0-0fbc-d42f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
        <constraint id="27a5-6fc4-5f32-560b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <rules>
        <rule name="Azote de herejes" id="7661-2389-dee8-8f26" hidden="false">
          <description>No podrán incluirse si el ejercito incluye también miniaturas con las reglas especiales No muerto o Demonio.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Buenos contactos" id="a96d-238c-e3f2-898a" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="b8a0-af01-ce25-5d99" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="beef-b644-f441-3338" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <rules>
        <rule name="Buenos contactos" id="6c79-71ba-04bc-6bc7" hidden="false">
          <description>Sólo Comandante mercenario. El ejército que incluya a un personaje con este Renombre podrá incluir un Regimiento de Renombre como opción de Unidad Básica (o un Regimiento de Renombre que cuente como Unidad Singular como si fuese Unidad Especial).</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Podridamente rico" id="2466-4ca4-6cb6-e257" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="bc45-edb3-a00b-66a2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="e72a-3f77-f5b1-f35d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <modifiers>
