          <profiles>
            <profile name="Incienso sagrado" id="59a4-82c7-1338-480f" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Los disparos efectuados contra el portador o su unidad tendrán un penalizador de -1 a su tirada para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos de la cámara del tesoro" id="8c24-5465-35cd-1d4c" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="8cb4-9a3c-ebfa-8d32" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="b874-0072-5b7c-c8be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Vaso hierático" id="aa1b-44d8-2fdb-30f2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fe35-6b82-705c-21a3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="df27-2ea7-389c-c352" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vaso hierático" id="ebee-ce9f-b02a-ac65" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El sacerdote puede utilizar el Vaso Hierático durante cualquiera de sus fases de magia, para lanzar uno de sus hechizos sin invertir ningún dado de energía. El hechizo será lanzado a su nivel básico de dificultad, y podrá ser dispersado normalmente. No es posible lanzar la versión potenciada de un hechizo con este objeto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La trenza de Vasilisa" id="190b-19c8-e68b-e279" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bc12-4166-f411-b044" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8aca-b03a-bf68-1e32" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="La trenza de Vasilisa" id="7e66-fe77-7847-662b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador realice un intento de dispersión, puede repetir todos los resultados naturales de 1 que obtenga en esa tirada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bola de cristal" id="cc95-542f-a4f2-8b91" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2920-4a97-c929-d4cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="286d-c24a-b8e1-51e9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bola de cristal" id="df21-d0e2-5340-1df8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia propia, el enemigo deberá revelar todos sus objetos mágicos, asesinos, fanáticos y otros elementos ocultos a 18” o menos del portador de la Bola de Cristal. El portador podrá sumar un +1 al valor de lanzamiento total de los hechizos del Saber de los Cielos que lance.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo del poder mágico" id="0a1d-3f1e-d9cb-3dbd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="05d0-7ad5-3ff3-2761" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5967-0936-7f3e-432c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo del poder mágico" id="62e7-9e82-3fc9-5e90" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede lanzar hasta un dado más de los permitidos normalmente por su nivel al lanzar un hechizo. Además, tendrá un bonificador de +1 a sus tiradas de Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Piedra adivinatoria" id="e240-fd02-7a8e-c7b1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6bd7-9586-5663-e9c4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b46a-d468-8937-011c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Piedra adivinatoria" id="c991-cf91-5797-31f8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Puede usarse para repetir todos los dados de una tirada de lanzamiento o dispersión que efectúe el hechicero.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Corazón de Ranu " id="90db-2fe2-b4c3-b618" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d4dd-3b8f-885e-546f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="10b1-a369-3393-32c1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Corazón de Ranu " id="7888-72c5-c17a-b45b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador podrá repetir las tiradas en la tabla de disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Poción sacra" id="4169-e0dd-70de-4dd5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5b74-fecc-ed9e-50e1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6d6f-56bd-ca9b-c99c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Poción sacra" id="ea25-be55-466f-7ab9" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Esta pócima puede beberse después de realizar una tirada de lanzamiento o dispersión de hechizo, permitiendo a quien la bebiese repetir uno de los dados de dicha tirada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro de la solidez" id="f7b6-58f3-3ff9-123b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b621-27c6-8448-7777" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="72f2-b5bf-85f5-3994" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro de la solidez" id="0a83-8afd-2a5d-2f7e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Puedes ignorar los efectos de la primera de las Disfunciones que sufra el portador durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vara de Calaingor" id="6912-5118-5975-8457" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7535-1554-d45f-4acd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="4735-2def-d71a-8b79" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vara de Calaingor" id="5680-fa66-9cda-ab6f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Una vez por fase de magia propia, tras lanzar un hechizo, el portador puede sumar 1D3 a la tirada de lanzamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gargantilla de Neferra" id="3fd7-3191-b6a2-3c41" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f638-175e-a714-6f70" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="28f4-a9d0-085c-95af" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gargantillas de Neferra" id="b1b4-e46c-5881-586b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo lanzadores de plegarias; puede elegirse como objeto mágico para estos pese a ser un 
Artefacto arcano. El portador puede repetir cualquiera de los dados al lanzar un cántico de guerra 
(puede repetir tanto el dado de Energía invertido como el nivel de energía o ambos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas de la cámara del tesoro. Arco" id="cf41-1576-2238-066a" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="da46-ebc2-38f6-069b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="ba35-7483-acc8-a24a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Arco del cazador" id="031a-ccd1-c53a-6bee" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b169-7d7a-4e92-b09e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bd2e-e2f4-55ac-9def" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arco largo" id="5316-44e1-bb1d-0c57" hidden="false" targetId="d3d4-59fe-a13d-65a3" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Arco del cazador" id="4d89-a7ef-1f21-d5fe" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco largo. Los disparos con este arco siempre impactan con un resultado de 2+, sin tener en cuenta la Habilidad de proyectiles ni los modificadores; además, sus impactos se resuelven con Fuerza 4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Arco de hueso Ungol" id="d51b-5452-9afe-1a80" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c6ea-87bf-550b-03b5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6c27-ce1b-6212-48a7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arco" id="70e3-cbf3-3770-efec" hidden="false" targetId="4ae0-7ed2-3e77-b13d" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Arco de hueso Ungol" id="8ecf-940d-9285-a728" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco. Tiene la regla especial Disparos múltiples (1D6). Los impactos causados por el Arco de hueso ungol se resuelven con Fuerza 4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Disparos múltiples (1D6)" id="2278-e648-99e8-14e7" hidden="false">
              <description>Un arma o miniatura con la regla especial Disparos múltiples efectúa el número de disparos indicado cada vez que dispara (esto incluye la reacción a la carga Aguantar y disparar), aplicando un penalizador adicional de -1 para impactar. No es necesario realizar disparos múltiples con un arma que disponga de esta regla especial: si lo deseas, puedes efectuar un único disparo, y no aplicar el penalizador de -1 para impactar por disparos múltiples. En caso de que la cantidad de disparos múltiples sea aleatoria, se determina el número de disparos cada vez que se dispara.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Arco del cazador paciente" id="6196-4fb9-dd8a-2f75" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
