            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte del sol de Chotek" id="f7b7-0489-9847-5118" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los disparos enemigos dirigidos contra el portador y la unidad en la que se encuentre este estandarte deberán aplicar un penalizador de -1 a sus tiradas para impactar. La unidad no podrá ser afectada por hechizos del Saber de las Sombras, ya fuesen lanzados por aliados o enemigos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte del jaguar" id="4bab-90fd-64b2-7d28" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="7975-2998-0ec7-6a98" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ee9d-cb4b-4b0f-fea1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Veloz" id="77c6-096c-d2d7-675c" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Estandarte del jaguar" id="c092-f6ae-f488-763a" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Otorga al portador y a la unidad que lo acompañe la regla especial Veloz y un bonificador de +1 a su atributo de movimiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estandarte de piel de skaven" id="91fc-066c-fca7-68be" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="6948-474a-a610-bff9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3046-2cb1-9618-8edb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Miedo" id="bfb1-42cd-bf88-0a59" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
            <infoLink name="Odio" id="de33-2b2d-23a0-a0b4" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Skavens)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Estandarte de piel de skaven" id="c3b0-d0fd-dacb-45e6" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Las miniaturas de la unidad obtienen la regla especial Odio (skavens) y causan Miedo a skavens. Sin embargo, los skavens obtendrán la regla especial Odio contra las miniaturas que formen parte de la unidad que lo porta.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tótem sagrado de Huanchi" id="d260-0944-5c26-5e9c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4e6c-62ef-c65f-5737" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bc47-df83-810a-bd9b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tótem sagrado de Huanchi" id="0329-07cf-de40-e626" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un solo uso. Objeto portahechizos. Nivel de energía 6. Contiene el hechizo Puente de sombras del Saber de las Sombras. Solamente podrá afectar al portador y su unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Hombres lagarto" id="e8fb-e6ad-01fb-0c15" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="1f00-2bda-3650-3efd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estatuilla del rencor" id="a1d8-a3aa-7830-90b5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dc73-c99e-477f-c4b5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3c6a-43ca-60e7-fd0d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estatuilla del rencor" id="4593-1d95-8381-c467" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos. Nivel de energía 4. Contiene un hechizo de Daño directo que toma como objetivo a una única miniatura enemiga a 12” o menos del portador, pudiéndose seleccionar incluso a un personaje en una unidad. El objetivo debe realizar inmediatamente un chequeo de Resistencia con 2D6. Si lo falla, perderá inmediatamente la mitad de las heridas que le queden, redondeando hacia arriba.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colgante reluciente de Chotek" id="189d-2c88-8066-8034" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a60e-964c-9308-8f4b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="80ce-bdc3-7712-1c43" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Colgante reluciente de Chotek" id="8407-42f3-efa9-6c51" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier fase de combate cuerpo a cuerpo. Todos los enemigos en contacto peana con peana con el portador verán su Iniciativa reducida a cero hasta el final de la fase de combate cuerpo a cuerpo en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pájaro de Chotek" id="e9c1-6630-2004-3570" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="76d1-6eda-c515-2fac" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8f03-a1a9-df2a-af63" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pájaro de Chotek" id="3739-8d96-e804-0fdc" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier turno de los hombres lagarto. Hasta el inicio del siguiente turno de los hombres lagarto, todas las miniaturas (amigas y enemigas) con la regla especial Volar o Flotar en el campo de batalla no podrán hacer uso de dichas reglas. Además, todas las unidades (amigas y enemigas) que disparen tendrán un penalizador de -1 en su tirada para impactar durante dicho turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Veneno de la ranita de luz" id="b347-b9ee-410a-20c9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d095-0771-fd94-9c25" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="65a4-e2a2-a99e-ff2e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques mágicos" id="2dca-d1a2-52e6-0789" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Ataques envenenados" id="5d01-cdd7-adfe-bb62" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Veneno de la ranita de luz" id="c712-fa1b-bd23-76c4" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene las reglas especiales Ataques envenenados y Ataques mágicos. Si ya disponía de la regla especial Ataques envenenados, estos surtirán efecto con un resultado de 5+ en lugar del 6+ habitual.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tambor de guerra de Xahutec" id="db69-5f99-f5fe-b7e0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5bff-9e6e-6df0-5dc8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4fc5-3187-506e-c3c5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tambor de guerra de Xahutec" id="70cc-353a-74fa-baec" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y la unidad en la que se encuentre superarán automáticamente todos los chequeos que deban realizar para marchar cuando tengan enemigos cerca. Adicionalmente, todas las unidades amigas que intenten reagruparse a 12” o menos del portador podrán sumar +1 a su atributo de Liderazgo para ese chequeo. El portador se considerará Músico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El cuerno de Kygor" id="9ba2-84ed-4ab3-720a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5824-d9c3-dfc2-281d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="a7db-a691-8a7a-5f1f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="0536-46f2-b44f-ff00" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="El cuerno de Kygor" id="fe1a-2986-7ab0-ae35" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al inicio de cualquiera de tus turnos. Cuando se activa, todas las Bestias, Bestias monstruosas, Monstruos y Enjambres amigas, así como todas las monturas amigas a 24” o menos del portador obtienen la regla especial Furia asesina hasta el final del turno de jugador en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Embrujo del guerrero jaguar" id="d9ea-0fed-dbb6-5ff2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3220-8871-4ddb-d65e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0237-e82b-812f-9cba" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Veloz" id="2078-959e-39eb-aa6a" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Embrujo del guerrero jaguar" id="7de2-b319-770b-7a96" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
