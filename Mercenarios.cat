              <profiles>
                <profile name="Pergamino maestro" id="e915-ec44-b2a3-a597" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Otorga a Marco y a la unidad en la que se encuentre la regla especial Vanguardia. Además, el pergamino permite al jugador que controla a Marco repetir la tirada para determinar que jugador comienza a jugar primero.</characteristic>
