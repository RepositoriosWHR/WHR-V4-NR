          </infoLinks>
          <profiles>
            <profile name="Sello de Sigmar" id="0766-1724-6772-49b4" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga al portador Resistencia mágica (1), que aumenta a Resistencia mágica (2) al tratar de dispersar un hechizo del Viento de Magia Oscura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gema de Merciw " id="ba79-b8de-02c1-90e6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="31cd-439f-cd94-6823" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="38a5-cceb-4e7d-7de7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
