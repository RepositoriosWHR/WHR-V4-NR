          </entryLinks>
          <profiles>
            <profile name="Corneta del pagador" id="9a71-a056-e3ef-1f4d" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo pagador. Al principio de la fase de movimientos, elige una unidad de infantería a 6&quot; o menos. Cuando esta unidad realiza un movimiento de reorganizarse, podrá realizarlo como si contase con Músico. Superará automáticamente el chqueo de Liderazgo y podrá mover, disparar y marchar en esa fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
