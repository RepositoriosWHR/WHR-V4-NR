      <rules>
        <rule name="Furia de los cruzados" id="d9b1-32a0-c7f7-517b" hidden="false">
          <description>Los caballeros de Origo tienen la regla Odio (¡todos los enemigos!) durante los turnos en los que haya realizado una carga exitosa.</description>
        </rule>
        <rule name="Campeona de la orden (sóla Donna Don Domingo)" id="750f-97ac-cae9-5e47" hidden="false">
          <description>Tiene la regla especial Orgullo marcial. Puede repetir sus tiradas fallidas para impactar en desafíos.</description>
        </rule>
        <rule name="Voto del caballero" id="e1e1-173e-b699-8286" hidden="false">
          <description>Tienen la regla especial Inmune a Miedo.</description>
        </rule>
      </rules>
