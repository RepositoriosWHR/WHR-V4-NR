            <profile name="Bandera de Verezzo" id="494a-8a0f-f753-4372" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo ballesteros. La unidad podrá repetir sus resultados de 1 en sus tiradas para impactar con sus ballestas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Mercenarios. Llave de la cámara del tesoro" id="01c2-bf16-75c2-2167" collective="false" hidden="false" import="true">
