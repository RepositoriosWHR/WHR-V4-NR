      <rules>
        <rule name="Solitario" id="833c-e789-ece6-9b7f" hidden="false">
          <description>Kaleb Daark no podrá unirse a unidades, no podrá utilizar el liderazgo de ninguna otra miniatura y no podrá beneficiarse de las reglas especiales Presencia inspiradora y ¡Ni un paso atrás! No puede ser el General del ejercito.</description>
        </rule>
        <rule name="Detestado por los siervos de los cuatro poderes ruinosos" id="0000-247a-1cf2-36be" hidden="false">
          <description>Todas las miniaturas del Caos obtendrán la regla especial Odio (Kaleb Daark).</description>
        </rule>
        <rule name="Elegido de Malal" id="a7e4-00f3-e664-857e" hidden="false">
          <description>Kaleb puede repetir las tiradas para impactar fallidas cuando combate contra miniaturas del Caos.</description>
        </rule>
      </rules>
