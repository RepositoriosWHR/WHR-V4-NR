        </selectionEntry>
        <selectionEntry name="Pócima gélida ungol" id="a550-a25d-23af-bcb2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d304-0a19-1f49-a7d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e596-739e-4711-ecf9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de aliento" id="762f-fed9-5ab8-34d8" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(F3, no permite salvación por armadura)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Pócima gélida ungol" id="ab14-157b-4713-c7f8" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puedes declarar que tomas la Pócima gélida ungol al inicio de cualquiera de tus fases de disparo. Durante esa fase, el portador obtiene un Arma de aliento de Fuerza 3 que no permite tirada de salvación por armadura. Esto se resuelve con Fuerza 2 contra miniaturas con la regla especial Aura de frío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cesto de la hechicería de Aldred" id="ff29-81ac-72a6-e6e4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="691a-6b29-baf2-0c1c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="78d2-919f-284f-3556" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cesto de la hechicería de Aldred" id="546d-0e81-ae18-ae81" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">En cualquier fase de magia en la que el portador se encuentre a 6” o menos de un hechicero enemigo puede robar un hechizo de este, determinado aleatoriamente, y almacenarlo en el cesto. Mientras el hechizo se encuentre almacenado en el cesto, el hechicero no podrá lanzarlo. Además, el cesto es un objeto portahechizos con nivel de energía 4, que puede lanzar el hechizo contenido en él aunque, si lo hace, el hechizo volverá al hechicero al que le fue robado. El cesto no puede contener más de un hechizo a la vez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espejo de Van Horstmann" id="b9d3-cca7-d971-f102" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4b9b-48a0-c3fc-710e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c9d7-9d6d-36a4-097b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Espejo de Van Horstmann" id="19c5-dba4-9fa0-5d70" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo funciona cuando el personaje se encuentra trabado en un Desafío. El portador puede intercambiar con su oponente sus atributos de Habilidad de armas, Fuerza, Resistencia, Iniciativa y Ataques hasta el final de la fase de combate cuerpo a cuerpo. Debe intercambiar todos esos atributos o no intercambiar ninguno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Broche de Elynett " id="e439-0398-ba6e-0870" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bc16-4307-61b9-0ea1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="812d-0e79-0ecf-c8c6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
