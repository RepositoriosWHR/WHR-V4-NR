        <constraint id="8a53-6991-7c12-9dc4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Llave de la cámara del tesoro" id="2e9c-3f42-a11d-378d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7762-41c0-a9c2-7393" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e65a-7600-4f78-9f0c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
