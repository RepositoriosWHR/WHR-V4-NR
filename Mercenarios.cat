            <profile name="Martillo del juicio" id="a21a-708a-d323-84b3" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Cualquier miniatura que sufra una herida de este arma deberá efectuar inmediatamente un chequeo de Liderazgo: si lo falla, sufrirá una herida automática sin tirada de salvación por armadura (que, a su vez, provocará otro chequeo de Liderago).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas de la cámara del tesoro. Lanza" id="fd02-4484-1e5f-e9e5" collective="false" hidden="false" import="true">
