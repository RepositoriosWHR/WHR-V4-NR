            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gema radiante de Hoeth" id="a0f5-21c4-e630-4d14" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos de nivel de energía 4. Al inicio de cada una de tus fases de magia elige uno de los ocho Saberes básicos de la magia y efectúa una tirada de 1D6, ese será el hechizo contenido en la gema durante ese turno (pudiendo elegir si se da el bis). Recuerda que no podrás elegir el hechizo identificativo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
