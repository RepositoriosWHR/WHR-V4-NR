    <selectionEntry name="[E] - Ghazak Khan, el terror venido de oriente" id="84f7-18f7-92c4-2559" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="10ab-4e3e-f5a4-fcd5" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
