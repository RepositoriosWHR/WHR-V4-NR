          <profiles>
            <profile name="Manto sombrío" id="948d-b604-7db1-7a50" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador podrá repetir las tiradas de salvación fallidas que obtuviese por la regla especial Esquiva. El portador no podrá ser elegido como objetivo por disparos provenientes de unidades situadas a 12” o mas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolsa del oro mágico" id="62e8-3519-9abe-34c4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d2d0-6e12-61f0-9cc6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e163-c89d-415b-d0b8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bolsa del oro mágico" id="d1e5-23e9-e2c2-fb34" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Pueden usarse para hacer que una unidad situada a 6” o menos del portador supere automáticamente un chequeo de liderazgo fallido.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolsa del oro maldito" id="b1e2-4269-b9f0-4d3b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a529-d94f-95be-a2e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4d6d-5807-4766-26c9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bolsa del oro maldito" id="4a1c-8d8b-692d-fcff" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede usar bolsa de oro maldito al inicio de un turno del oponente para obligar a una unidad enemiga a 8&quot; a declarar una carga contra el portador de la bolsa: la unidad seleccionada debe declarar carga contra el portador (o la unidad en la que se encuentre) obligatoriamente. No tiene ningún efecto contra miniaturas Inmunes a Psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino del contrato vinculante" id="d4eb-76ae-6ae6-549d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7c94-4fcf-1bbf-6085" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4835-f2a7-5342-6069" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
