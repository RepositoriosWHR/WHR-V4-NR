                <profile name="Gema de Lustria" id="0fc5-8a7b-51fe-5afb" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El Talisman de Lustria permite a Marco repetir las tiradas de salvación por armadura no superadas y le otorga una tirada de salvación por Esquiva (5+).</characteristic>
                  </characteristics>
                </profile>
