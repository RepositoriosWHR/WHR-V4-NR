        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Unidad principal" id="ff25-c09b-1d02-a497" collective="false" hidden="false" import="true" targetId="0331-b40d-f83a-aa61" type="selectionEntry"/>
