                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Todos los ataques en combate cuerpo a cuerpo dirigidos contra Lorenzo Lupo tendrán un penalizador de -1 en sus tiradas para impactar.</characteristic>
                  </characteristics>
