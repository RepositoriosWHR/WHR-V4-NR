    <selectionEntry name="[E] - El jeque Yadosh y los guardaespaldas de Mydas" id="8a18-9fac-85ec-2876" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Especiales" id="0a4b-125b-ed48-c953" hidden="false" primary="true" targetId="5370656369616c23232344415441232323"/>
      </categoryLinks>
      <constraints>
        <constraint id="fc3f-ada4-83ec-54da" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
