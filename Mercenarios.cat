              <profiles>
                <profile name="Jugo sagrado de cáctus" id="903a-671e-125b-90f6" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Marco puede beber el jugo al inicio de cualquiera de sus turnos. Recuperará una de las heridas que hubiese perdido anteriormente durante la batalla y obtendrá las reglas especiales Ataques mágicos y Resistencia mágica (1). Los efectos durarán un turno completo de juego.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pergamino maestro" id="5b63-1e64-8ac0-c4f1" collective="false" hidden="false" import="true" type="upgrade">
