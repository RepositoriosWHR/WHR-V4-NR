              <characteristics>
                <characteristic name="Reglas especiales" typeId="f05e-207b-7f53-ab87">Los ataques y disparos efectuados por el personaje (y por su montura) obtendrán la regla especial Ataques envenenados.</characteristic>
              </characteristics>
