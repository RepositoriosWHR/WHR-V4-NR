        <infoLink name="Inmune a la psicología" id="cbbb-32db-63f3-a487" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Mercenario" id="225e-89ce-99c8-66f0" hidden="false" targetId="f693-0c5c-49bd-91e7" type="rule"/>
