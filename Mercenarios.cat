              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y su unidad pueden repetir sus chequeos de psicología fallidos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Guantelete del desafío" id="28d4-987b-68fa-ae72" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7c98-6529-f8bf-fd69" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1ab7-f443-952b-9603" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
