      </constraints>
      <selectionEntries>
        <selectionEntry name="Diadema de poder" id="194c-c8c9-0741-d6c0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4b3d-4102-2413-52d8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f4c9-fbc2-d5f8-b936" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia a la magia (1)" id="17da-aa47-9d77-1031" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Diadema de poder" id="7a0b-9dd8-c91e-c6e1" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene la regla especial Resistencia mágica (1). Al final de cada fase de magia puedes guardar hasta dos de los dados no utilizados, que podrás utilizar en una fase de magia posterior (ya sea como dados de Energía o de Dispersión).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de la maldición de Tepok" id="0fae-956c-b250-f6e3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0f38-4871-8b3a-fad3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="054b-d891-78e3-e3b8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de la maldición de Tepok" id="a25a-db92-b130-b3ff" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Puede utilizarse cuando un hechicero enemigo sufra una disfunción mágica, obligándole a repetir la tirada que obtuvo en esa tabla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Larvas de Itxi" id="9ec3-c88d-8159-1a26" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ee1b-f0a9-6a26-926d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="dfd4-1ba2-4e43-9246" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Larvas de Itxi" id="9dc7-1fb2-98b3-35ad" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Puede utilizarse tras lanzar un hechizo (exitosamente o no), pero antes de que el oponente realice su intento de dispersión. Aumenta en +4 el valor de lanzamiento del hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Hombres lagarto" id="068a-0935-9667-10fe" collective="false" hidden="false" import="true">
