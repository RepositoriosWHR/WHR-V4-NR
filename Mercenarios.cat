      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="aae8-315b-1af2-0211" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Esquivar (4+)" id="2a61-aa02-79bd-3cdf" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink name="Ataques envenenados" id="1f6b-1ec5-bd46-787b" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink name="Exploradores" id="e8cd-e88a-3a3a-24fc" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
