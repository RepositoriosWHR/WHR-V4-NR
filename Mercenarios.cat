          <infoLinks>
            <infoLink name="Esquivar (5+)" id="9357-ad78-e24f-1a63" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
            <infoLink name="Orgullo marcial" id="9593-8f5e-1fe4-27c5" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Duelista" id="99ef-3ec6-4f8a-ddb0" hidden="false" typeId="b824-aacc-6637-fa81" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="f05e-207b-7f53-ab87">El guerrero no podrá equiparse con escudo o armaduras que no sean ligeras. Obtendrá las reglas especiales Esquivar (5+) y Orgullo marcial, y podrá repetir sus tiradas para impactar no superadas luchando en un desafío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Renombres. Equipado con pistola" id="e9c5-907a-a03a-da3f" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="7337-fd01-8799-b266" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="caa7-c797-6d6d-47d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Jugador sucio" id="54ec-5ad5-645f-2218" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1bbd-32e9-5d2d-a485" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Pistola" id="eca9-bc90-cf99-2620" hidden="false" targetId="9c4d-f670-7b68-06b1" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Jugador sucio" id="919d-71fe-b436-71c6" hidden="false" typeId="b824-aacc-6637-fa81" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="f05e-207b-7f53-ab87">El personaje equipado con pistola. Cuando el personaje sufre una herida en cuerpo a cuerpo, puede automáticamente realizar un ataque con su pistola (fuerza de la secuenta habitual) contra la miniatura o unidad que el causó la herida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas de la cámara del tesoro" id="123d-bec9-1fc9-fe84" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e9a0-0418-5b95-06d1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="6d96-1904-dd40-c70f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Armadura del escorpión" id="d0b9-1816-ba1f-d5b3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="46ac-8424-b111-4fa4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8fae-aff0-f53a-94ff" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura pesada" id="d7ba-5662-5acb-bfd8" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura del escorpión" id="4acf-ff16-3d9e-411c" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. El portador (o la unidad en la que se encuentre) sufren una herida menos como resultado de su regla especial Inestables al perder un combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escudo de Ptra" id="625b-705c-e953-7bce" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="243b-538a-7fc5-5b28" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7242-a280-1112-5b31" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Escudo" id="93d4-36dc-5ad7-e2fb" hidden="false" targetId="c028-354e-9169-7463" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Escudo de Ptra" id="4bb0-63e9-9752-c6b3" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Si el portador realiza una tirada de salvación por armadura exitosa en combate cuerpo a cuerpo, todas las miniaturas de cualquier unidad enemiga en contacto peana con peana con el personaje verán reducida su HA a 1 durante el resto de la fase de combate cuerpo a cuerpo en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pellejo de lagarto del trueno" id="050b-eecc-2997-dd3e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ada9-4dd0-e2b7-7c71" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6879-0cb6-dc26-848e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
