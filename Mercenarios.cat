            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="504b-f895-2779-4d48" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pergamino del contrato vinculante" id="fd71-13d5-93e8-e607" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todas las unidades amigas con la regla especial Mercenario obtienen la regla especial Inmune a la psicología mientras se encuentren a 12” o menos del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
