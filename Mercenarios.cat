            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Detestable" id="0191-cb46-8c0a-acb1" hidden="false" typeId="b824-aacc-6637-fa81" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="f05e-207b-7f53-ab87">El personaje ve reducido el radio de la regla Presencia inspiradora a 6”. Las unidades de su ejército no deberán chequear pánico si es retirado como baja. Ten en cuenta que el coste es negativo (es decir, hace al personaje más barato)</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estratega" id="886a-c5e3-0651-9e07" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="049d-d150-3dfa-b36a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estratega" id="03be-d168-1e32-0bd8" hidden="false" typeId="b824-aacc-6637-fa81" typeName="Renombre">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="f05e-207b-7f53-ab87">El personaje y la unidad en la que forma parte puede realizar un chequeo de Liderazgo cuando declara &quot;Aguantar&quot; una carga (no aguantar y disparar). Si supera el chequeo, podrá reorganizarse gratuitamente. No puede utilizar esta habilidad si está trabado en combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Renombres. Infantería" id="47dd-1438-fd16-25ef" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="0568-76c2-6080-b509" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="35c7-4602-3e3f-6451" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
