            <infoLink name="Inmune al fuego" id="dd16-20da-a113-a673" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Bendición solar" id="7965-7416-1807-c3e4" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga al portador una tirada de salvación especial de 5+ y la regla especial Inmune a fuego. El portador no podrá utilizar ni incluirse dentro de una unidad con la regla especial Exploradores.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colgante hipnótico" id="8390-35b8-208a-06de" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f5b0-1b68-b2d7-836f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6edd-6cc3-13ff-6471" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Miedo" id="52ef-aa16-e15c-1d58" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Colgante hipnótico" id="ae5a-8947-3324-3496" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador causa Miedo. Además, cualquier miniatura que realice uno o más ataques en combate cuerpo a cuerpo contra el portador deberá superar antes un chequeo de Liderazgo: si lo falla, perderá uno de sus ataques (hasta un mínimo de 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Hueste roja. Cresta roja" id="d4bf-2a81-e354-aac2" collective="false" hidden="false" import="true">
