              <characteristics>
                <characteristic name="Reglas especiales" typeId="776f-590a-f508-e275">Las miniaturas pertenecientes a este desove ignoran el penalizador de -1 para impactar con proyectiles por larga distancia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Marca sagrada de los ancestrales" id="8944-7376-a6c5-b51e" collective="false" hidden="false" import="true" type="upgrade">
