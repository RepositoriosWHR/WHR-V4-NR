              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Permite a quien lo empuña obtener un bonificador de +2 al valor total de lanzamiento de los hechizos del Saber de los Cielos que lanzase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
