                <entryLink name="Saber de los Cielos" id="facb-f1f2-2899-d7a5" collective="false" hidden="false" import="true" targetId="77a4-c5d2-08e5-4388" type="selectionEntry"/>
                <entryLink name="Saber de la Luz" id="5698-9873-d360-7375" collective="false" hidden="false" import="true" targetId="b0ef-3e63-c959-64d1" type="selectionEntry"/>
                <entryLink name="Alta magia" id="10f4-2adc-482f-83ea" collective="false" hidden="false" import="true" targetId="6a67-de12-5e4d-657a" type="selectionEntry"/>
