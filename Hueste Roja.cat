    <selectionEntryGroup name="Objetos hechizados. Hueste roja" id="4732-1b03-9185-c897" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5acd-0ac1-526e-0b3f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="422c-8d15-87b4-6dd8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Cabeza maldita" id="81a5-ac8b-3443-8ec4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b080-76f4-6a58-fdd3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5996-b613-bdbe-c0d0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cabeza maldita" id="890b-7fa1-e76b-2ab9" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Sólo eslizones. Puede utilizarse al comienzo de cualquier fase de magia propia. Selecciona un personaje o monstruo enemigo a 18” o menos del portador; hasta el comienzo de tu siguiente fase de magia, todos los impactos que sufra la miniatura seleccionada obtendrán la regla especial Heridas múltiples (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pájaro de Chotek" id="8a7d-f6c6-d9eb-5c42" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0694-dbfe-fb95-7786" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ed6e-3517-5db5-2933" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pájaro de Chotek" id="6f63-3939-4c49-fcfd" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier turno de los hombres lagarto. Hasta el inicio del siguiente turno de los hombres lagarto, todas las miniaturas (amigas y enemigas) con la regla especial Volar o Flotar en el campo de batalla no podrán hacer uso de dichas reglas. Además, todas las unidades (amigas y enemigas) que disparen tendrán un penalizador de -1 en su tirada para impactar durante dicho turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Colgante reluciente de Chotek" id="3d49-2f6e-c30c-2296" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8a67-2171-e0af-a0b5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="95c3-f0de-1c7d-162c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Colgante reluciente de Chotek" id="6bec-8e97-8359-9cc8" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier fase de combate cuerpo a cuerpo. Todos los enemigos en contacto peana con peana con el portador verán su Iniciativa reducida a cero hasta el final de la fase de combate cuerpo a cuerpo en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cuenco Sagrado de Vinatl" id="6c5e-67d1-3177-7518" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bd79-c36e-8524-6978" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b960-ce14-e344-1b35" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="0a6d-1e02-e246-11a5" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Cuenco Sagrado de Vinatl" id="fa9c-dff6-8a09-4171" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y cualquier unidad de Eslizones a la que se una obtendrán la regla especial Furia asesina (no afecta a los Kroxigores ni a las monturas).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tambor de guerra de Xahutec" id="429d-4a48-5bf8-920f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="37d9-4900-3760-82d9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dee7-95fb-2626-7888" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tambor de guerra de Xahutec" id="b819-9eb6-b593-7d07" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador y la unidad en la que se encuentre superarán automáticamente todos los chequeos que deban realizar para marchar cuando tengan enemigos cerca. Adicionalmente, todas las unidades amigas que intenten reagruparse a 12” o menos del portador podrán sumar +1 a su atributo de Liderazgo para ese chequeo. El portador se considerará Músico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Veneno de la ranita de luz" id="c67f-dc34-ed61-e167" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="70c3-a127-15f0-a81a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5ee4-dc5c-5e8b-74b0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="72cc-fd2c-6973-74d6" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink name="Ataques mágicos" id="7466-e7aa-9194-2013" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Veneno de la ranita de luz" id="e9c6-0e35-a9e4-d61c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador obtiene las reglas especiales Ataques envenenados y Ataques mágicos. Si ya disponía de la regla especial Ataques envenenados, estos surtirán efecto con un resultado de 5+ en lugar del 6+ habitual.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pendiente del Carnosaurio" id="37c3-ad77-87e3-a585" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a86e-6bc0-2941-d117" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ae84-217b-fac1-a6ea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pendiente del carnosaurio" id="b2c8-1440-de97-198f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Si el portador sufre una o más heridas, obtendrá la regla especial Furia Asesina, y no la perderá aunque pierda el combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Embrujo del guerrero jaguar" id="610c-f334-3d16-a3b2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b4b9-2afa-f94a-17ac" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7c14-68ed-1253-a816" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Veloz" id="9a09-f3d8-b01f-6afa" hidden="false" targetId="6d32-e54e-896e-0d9f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Embrujo del guerrero jaguar" id="02a3-2d4d-0e12-8dad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador pasa a tener Movimiento 9 y la regla especial Veloz.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Hueste roja. Cresta roja" id="7e2e-2c88-7a31-32cd" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ef12-28e1-c92e-c594" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="e79e-d5c5-b3c5-41ca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Amuleto de la premonición" id="54df-f5b9-7bb9-ee1b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="36a5-afba-10c1-0141" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5bdc-e39d-ad41-096d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de la premonición" id="f287-e474-9164-0548" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo Cresta roja. Al inicio de la batalla, tira 1D3: ése será el número de tiradas que el portador podrá repetir durante la partida. Esas tiradas pueden ser tiradas para impactar, tiradas para herir, tiradas de salvación (por armadura o especiales), chequeos de atributo o dados de energía o dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Reliquias. Hueste roja" id="53a1-f9ba-1326-1aa7" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="6255-64f5-4285-0f39" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="-1"/>
        <constraint id="ba92-ea56-b8e7-f96a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Manipulador de la fatalidad" id="7feb-dba7-4185-594c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3fed-18b0-5d53-bee2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="38e4-71ea-a137-9df8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="364b-0492-6c75-1bf7" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Manipulador de la fatalidad" id="6508-1b50-7f0a-2210" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia, tras la tirada para determinar los vientos de la magia y tiradas de canalización, puedes decidir aumentar o disminuir en uno la reserva de dados de ambos bandos para dicha fase. Además, siempre que un hechicero (amigo o enemigo) a 12” o menos del portador sufra una disfunción mágica, puedes aumentar o disminuir en 1 el resultado de la tirada en la tabla de disfunciones mágicas (cualquier resultado de la tirada en dicha tabla inferior a 2 se considera 2 y cualquier resultado superior a 12 se considera 12).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de Xapati" id="46b6-0703-466c-ca5a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dada-827c-788b-0789" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ce2d-2228-8a2b-434e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="e2de-b2d6-5fa8-1270" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Resistencia mágica (3)" id="086b-8e12-cada-027a" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Amuleto de Xapati" id="eb3d-b530-cc22-2352" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Proporciona a su portador la regla especial Resistencia mágica (3). Si un hechizo es dispersado utilizando los dados proporcionados por el amuleto, el hechicero que lo lanzó deberá obtener un resultado igual o inferior a su nivel de magia en 1D6 o sufrirá una herida sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cubo de oscuridad" id="92de-99d9-96f8-b3b3" collective="false" hidden="false" import="true" type="upgrade">
