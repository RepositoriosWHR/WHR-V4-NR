    <selectionEntry name="Oráculo jinete de troglodón" id="c0a6-c846-6318-ef40" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="a4a3-968f-422f-227f" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
        <constraint id="dd0c-285e-2c3c-596e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Piel escamosa (4+)" id="3776-880b-e8ba-4585" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink name="Monstruo" id="a94c-e90b-da9c-f554" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Sangre fría" id="9031-f12b-6161-c95b" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink name="Cruzar (Elementos acuáticos)" id="a968-26dc-0962-619a" hidden="false" targetId="3043-3cbd-459e-ab48" type="rule"/>
        <infoLink name="Ataques envenenados" id="bfae-7d7d-e864-f67f" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="dd0c-285e-2c3c-596e" type="set" value="3">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="dd0c-285e-2c3c-596e" type="set" value="4">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Escupir veneno" id="8b65-3836-5995-178a" hidden="false">
          <description>El troglodón puede disparar como una Catapulta con un alcance de 0-24”, Fuerza 3 y la regla especial Ataques Flamígeros. Los impactos de este disparo no permiten tirada de salvación por armadura. El impacto central se resolverá del mismo modo pero con Fuerza 5. Si obtienes un resultado de problemas, en lugar de tirar en la tabla, simplemente el disparo no tendrá efecto. El Troglodón puede escupir veneno si mueve, pero no si marcha.</description>
        </rule>
        <rule name="Oráculo eslizón" id="8ffe-69d7-0c3d-3dbd" hidden="false">
          <description>El Troglodón va montado por un Oráculo eslizón, que se considera un Oficial a todos los efectos. Su Potencia de unidad conjunta es de 6. El Oráculo eslizón puede ser usado por un Mago-sacerdote slann con la regla especial Telepatía como si fuese un chamán eslizón. Además, puede Canalizar dados de Energía y Dispersión. Adicionalmente, tiene la regla especial ¡Ni un paso atrás!, que afecta a todos los eslizones (de cualquier tipo) a 18” o menos del Oráculo jinete de troglodón.</description>
        </rule>
        <rule name="Rugido primitivo" id="2ce3-47b6-a0b9-b404" hidden="false">
          <description>Una vez por batalla, al inicio de uno de tus turnos, puedes declarar que el Troglodón ruge. Todos los eslizones (de cualquier tipo) a 18” o menos del Troglodón podrán repetir sus tiradas fallidas para impactar (tanto en combate cuerpo a cuerpo como con disparos) hasta el final de ese turno de jugador.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Troglodón" id="8b39-6567-24f8-41f5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6f36-404d-535e-3d84" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="069b-1fc1-20e5-24d6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Troglodón" id="b35c-c13e-a1c3-9171" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">7</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">3</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">4</characteristic>
                <characteristic name="F" typeId="5.323232344415441e+21">6</characteristic>
                <characteristic name="R" typeId="5.423232344415441e+21">5</characteristic>
                <characteristic name="H" typeId="5.723232344415441e+21">5</characteristic>
                <characteristic name="I" typeId="4.923232344415441e+21">3</characteristic>
                <characteristic name="A" typeId="4.123232344415441e+21">4</characteristic>
