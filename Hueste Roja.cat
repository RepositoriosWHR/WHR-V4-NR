        <infoLink name="Sacerdote" id="e7de-ef79-1489-34ef" hidden="false" targetId="1fc6-22eb-3dba-dae7" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="265e-93fb-6c26-3479" type="increment" value="1">
          <repeats>
            <repeat childId="7a96-9bb6-09be-5f93" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="1"/>
          </repeats>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia de Sacerdote de Sotek" id="3519-9005-e727-3cb6" hidden="false">
          <description>Puede tener Nivel de magia 1 (+40 puntos). Puede elegir sus hechizos del Saber de los Cielos, Luz, Bestias o Vida.</description>
        </rule>
        <rule name="La ofrenda a Sotek" id="4a4f-d5fc-53fe-d007" hidden="false">
          <description>El Sacerdote de Sotek obtendrá un bonificador de +1 al nivel de lanzamiento de su plegaria si la unidad que lo acompaña logró causar cuatro heridas en la fase de combate anterior al lanzamiento de la plegaria, o de +2 si logró causar ocho o más heridas. Además, si consiguió causar más de doce heridas en la anterior fase de combate, podrá lanzar una plegaria adicional.</description>
        </rule>
        <rule name="Plegarias de Sacerdote de Sotek" id="9927-744a-8d71-3a80" hidden="false">
          <description>Un Sacerdote de Sotek conoce todas las Plegarias de Sotek y puede lanzar una de ellas por fase de magia propia con nivel de energía 3.</description>
        </rule>
      </rules>
