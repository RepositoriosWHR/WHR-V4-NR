          </entryLinks>
          <profiles>
            <profile name="Corona de iluminación" id="7808-a75a-a270-03b8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo Gran oráculo eslizón Cresta roja. El portador conoce un hechizo adicional, obtiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos y podrá tomar sus hechizos de uno de los ocho saberes básicos o de Alta Magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="7cd1-3ce8-6a5b-0953" collective="false" hidden="false" import="true">
              <entryLinks>
                <entryLink name="Saber de la Vida" id="39b9-597c-f3d9-8e87" collective="false" hidden="false" import="true" targetId="db69-4431-08db-6b45" type="selectionEntry"/>
