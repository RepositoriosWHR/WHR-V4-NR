            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Almizcle soporífero" id="9ec1-ba28-e46c-2052" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Todas las miniaturas enemigas en contacto peana con peana con el personaje verán su Habilidad de armas e Iniciativa reducidas a la mitad (redondeando fracciones hacia arriba).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mirada de Slaanesh" id="63f8-0255-5cc4-2f5d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a712-5dc5-ea9b-d384" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="80b1-d460-1fa5-07b5" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
