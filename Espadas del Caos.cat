          </infoLinks>
          <rules>
            <rule name="Marca de Khorne. Haargroth el Carnicero" id="3cc1-a268-f04e-2066" hidden="false">
              <description>Haargroth porta la Marca de Khorne, que le otorga las reglas especiales Furia asesina y Resistencia mágica (2). No pierde su Furia asesina si es derrotado en combate.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Saga (Haargroth)" id="e301-8388-6a60-a446" collective="false" hidden="false" import="true" targetId="f2cc-6e35-b27f-fbe6" type="selectionEntry"/>
