            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de aliento" id="78de-96a5-ca20-2255" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(F3, sin salvación por armadura)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Vómito de corrupción" id="a514-7c9b-d8b7-522a" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene un Arma de aliento de Fuerza 3 que no permite tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vitalidad de Nurgle" id="de02-685c-6679-6f68" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="988a-222c-c7f6-a347" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="cb07-9e7d-815d-e91d" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Vitalidad de Nurgle" id="b1dd-7bc6-1887-2d83" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Al inicio de cada uno de tus turnos, el personaje recupera una de las heridas que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Carcasa decadente" id="9d62-984a-8624-2835" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3b3a-c85d-cd23-51ae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="53e8-4fb8-541a-3fca" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune al veneno" id="fa35-312c-8e4b-f941" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
            <infoLink name="Ataques envenenados" id="bba4-d7eb-f028-773f" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Carcasa decadente" id="b9b3-877e-77b3-977c" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene las reglas especiales Inmune a veneno y Ataques envenenados; los resultados de 5 natural al impactar se considerarán Ataques envenenados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Recompensas del Caos. Slaanesh" id="58ef-b091-fc9c-4b5d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="14b7-4805-b478-b0d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Rapidez de Slaanesh" id="8d74-5d34-7ab1-1869" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
