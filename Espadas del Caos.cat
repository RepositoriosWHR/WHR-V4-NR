  <rules>
    <rule name="El Caos no tolera la mediocridad" id="9c9f-0bd1-657c-f7ac" hidden="false">
      <description>Al finalizar la batalla, los Espadas del Caos obtienen un Punto de gloria menos de los que les corresponden (con un mínimo de 1), y el oponente recibe un Punto de Gloria adicional a los que les correspondan (con un máximo de 9).</description>
    </rule>
  </rules>
