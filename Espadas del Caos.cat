          <constraints>
            <constraint id="6057-6783-702d-cbf8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="aec8-c889-b55c-9322" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink name="Inmune al veneno" id="cd93-26f4-9115-1f7f" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Feytor el Corrupto" id="5410-215a-034f-7fc8" hidden="false">
              <description>Feytor porta la Marca de Nurgle, lo que le otorga las reglas especiales Ataques envenenados e Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Saga (Feytor)" id="b384-24e9-111e-f59d" collective="false" hidden="false" import="true" targetId="b293-2a53-c13c-dde7" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Ojo de los dioses" id="beb5-6ae9-88ec-ada0" hidden="false" targetId="0799-cc58-3276-4a94" type="rule"/>
        <infoLink name="Infantería" id="f1e2-e668-c03f-a3c0" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Orgullo marcial" id="3d97-f61d-4ee4-9803" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
        <infoLink name="La voluntad del caos" id="a256-0a04-1727-8df0" hidden="false" targetId="bd8d-6027-79e3-eab6" type="rule"/>
        <infoLink name="Inmune a la psicología" id="01cb-7768-c1ab-f1bd" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Tozudez" id="4915-c956-9dd2-8f28" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink name="Regeneración (5+)" id="eb7f-f563-e14b-d7ca" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
        <infoLink name="Miedo" id="f46d-f339-1bb7-f7a7" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Heraldo de la plaga" id="d553-8d87-b92e-7594" hidden="false">
          <description>Al inicio de cada fase de combate cuerpo a cuerpo (propia o del oponente), todas las unidades a 6” o menos de Feytor que no tengan la Marca de Nurgle o la regla especial Demonio (Nurgle) sufren 1D6 impactos de Fuerza 1 que no permiten tirada de salvación por armadura. Las bajas causadas por esto cuentan para el resultado del combate.</description>
        </rule>
      </rules>
