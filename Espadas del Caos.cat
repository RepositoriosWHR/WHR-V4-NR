          </constraints>
          <entryLinks>
            <entryLink name="Marca de Khorne. Personajes" id="0263-4a39-56b8-38fe" collective="false" hidden="false" import="true" targetId="eb2e-e161-ff39-cbf6" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Furia asesina" id="a0bc-d0fe-9759-0af1" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
                <infoLink name="Resistencia mágica (2)" id="149d-598a-7eca-dc59" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Khorne. Paladin de los Espadas del Caos" id="ccb6-76f1-3b8c-c230" hidden="false">
                  <description>Obtiene las reglas especiales Furia asesina y Resistencia mágica (2). Además, no perderá su Furia asesina aunque sea derrotado en combate.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="b019-59e6-29b7-e9cb" collective="false" hidden="false" import="true" targetId="b312-1e7c-fa30-c5e6" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="1488-f45a-2d9f-af28" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="acc8-c542-897d-8fc5" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Paladin de los Espadas del Caos" id="4d9d-cf08-d21b-c781" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 5+ (o +2 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Personajes" id="19bc-c8d1-2e64-f17e" collective="false" hidden="false" import="true" targetId="4d95-b7b0-28d0-e70a" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <rules>
                <rule name="Marca del Caos absoluto. Paladín de los espadas del Caos" id="bfe8-4dd7-b73d-3dc9" hidden="false">
                  <description>Al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="c5e5-7254-02a7-0169" collective="false" hidden="false" import="true" targetId="4c3b-ee1f-c149-ac33" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Indesmoralizable" id="56bd-59f5-063f-1701" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
                <infoLink name="Poder de penetración" id="9149-77e4-1c87-129b" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
                <infoLink name="Sangre fría" id="6ee0-6178-f670-fcc2" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="d282-2246-5b71-7df4" collective="false" hidden="false" import="true" targetId="7076-7792-e821-b83e" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques envenenados" id="4fe1-bec9-fd9c-4872" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink name="Inmune al veneno" id="a5b9-2d64-c53a-058a" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Paladin de los Espadas del Caos" id="0dd0-c83d-98e6-1b45" hidden="false">
                  <description>Obtiene las reglas especiales Ataques envenenados e Inmune a veneno.. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
