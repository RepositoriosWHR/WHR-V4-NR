        <selectionEntry name="Vientos del Caos" id="82fa-abf0-6016-0c9c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2e40-2c3b-2059-86bb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
