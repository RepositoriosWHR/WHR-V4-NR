            <infoLink name="Furia asesina" id="ef14-b4be-2d7e-a930" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Nunca la pierde)"/>
              </modifiers>
            </infoLink>
            <infoLink name="Resistencia mágica (2)" id="3fe7-504f-5097-504b" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
            <infoLink name="Ataques envenenados" id="49e8-6b1d-2e34-e219" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink name="Poder de penetración" id="d28a-b30a-9386-a3fa" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
            <infoLink name="Sangre fría" id="6ca1-d55c-c45f-836c" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
            <infoLink name="Indesmoralizable" id="b08f-a197-cd88-a230" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
            <infoLink name="Ataques flamígeros" id="047a-ac03-9657-6f8c" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Inmune al veneno" id="8511-b00b-2586-2fc0" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca del Caos. Kordel Shorgaar" id="9004-f677-eb98-77f3" hidden="false">
              <description>Kordel tiene las Marcas de Khorne, Slaanesh, Nurgle y Tzeentch, que le proporcionan las reglas especiales Resistencia mágica (2), Furia asesina (nunca pierde su Furia asesina), Indesmoralizable, Sangre fría, Poder de penetración, Ataques envenenados, Inmune a veneno y Ataques flamígeros; además, tiene un bonificador de +2 a su tirada de salvación especial, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas. Kordel puede unirse a cualquier unidad de Elegidos con cualquier Marca (pese a ser Indesmoralizable; si se une a una unidad que no tenga la Marca de Slaanesh, la unidad obtendrán la regla especial Indesmoralizables).</description>
            </rule>
          </rules>
        </selectionEntry>
