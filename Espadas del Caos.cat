                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El Ojo de Sheerian otorga a Archaón una tirada de salvación especial de 3+.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
