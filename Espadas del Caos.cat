              <profiles>
                <profile name="Marcado por el destino" id="3385-06fe-92e7-6e60" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Proporciona a Kordel una tirada de salvación especial de 6+. Además, al inicio de la batalla, tras el despliegue, tira 1D6+2: ese será el número de tiradas que podrá repetir Kordel a lo largo de la batalla: puede tratarse de tiradas para impactar, para herir, tiradas de salvación, tiradas de salvación especiales o chequeos de atributo (incluyendo de Liderazgo).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Estandarte del Fin de los Tiempos" id="3861-a6b1-841a-1cf8" collective="false" hidden="false" import="true" type="upgrade">
