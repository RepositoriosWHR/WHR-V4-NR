              </costs>
              <entryLinks>
                <entryLink name="Reliquia" id="de67-0ecb-93d6-f6f3" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
              </entryLinks>
              <infoLinks>
                <infoLink name="Armadura del caos" id="2751-42f8-723e-4512" hidden="false" targetId="625c-5ca6-f2f7-0060" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Armadura de Morkar" id="fa32-4278-9ac9-355a" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. No se podrá herir exitosamente a Archaón con un resultado de 1 o 2 bajo ninguna circunstancia, no importa la Fuerza del ataque. Incluso los efectos que causen heridas automáticamente deberán obtener un resultado de 3+ en 1D6 para herir exitosamente a Archaón (esto afecta al Martillo de Sigmar, pese a que normalmente no puede ser afectado por otros objetos mágicos).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Escudo" id="82e4-33d1-26e1-ef83" collective="false" hidden="false" import="true" type="upgrade">
