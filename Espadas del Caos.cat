              </costs>
              <infoLinks>
                <infoLink name="Furia asesina" id="55cc-bf2f-eb27-78a7" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Tripulantes)"/>
                  </modifiers>
                </infoLink>
                <infoLink name="Resistencia mágica (2)" id="63c3-c2db-620c-72cc" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Khorne. Altar de guerra de los Espadas del Caos" id="8a86-a7a3-d762-46d2" hidden="false">
                  <description>Obtiene las reglas especiales Furia asesina (sólo los tripulantes) y Resistencia mágica (1). Nunca perderá su Furia asesina.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="59f6-713c-d0e3-18f2" collective="false" hidden="false" import="true" targetId="0adb-14f6-3d62-89cf" type="selectionEntry">
              <constraints>
                <constraint id="1e39-056d-ecbf-7f67" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques envenenados" id="6fe0-92c6-daee-80d6" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink name="Inmune al veneno" id="22fc-b46b-858e-6861" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Altar de guerra de los Espadas del Caos" id="a91f-4cb5-871e-a687" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas. Además, obtienen las reglas especiales Ataques envenenados e Inmune a veneno.</description>
                </rule>
