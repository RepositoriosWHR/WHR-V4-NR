    <selectionEntry name="[E]  - Melekh el Transmutador, Elegido de Tzeentch" id="726c-57eb-4571-8351" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="183e-7ec5-8e06-caa4" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
