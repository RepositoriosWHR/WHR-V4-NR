      <entryLinks>
        <entryLink name="Marca de Tzeentch. Personajes" id="fbf1-219d-f4ce-e7b9" collective="false" hidden="false" import="true" targetId="b312-1e7c-fa30-c5e6" type="selectionEntry">
          <constraints>
            <constraint id="28f8-a38b-49bb-2d90" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="8ec9-24a7-9e2d-fe98" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Melekh el Tranmutador" id="5ac4-8a16-dc17-e664" hidden="false">
              <description>Melekh y el Disco volador de Tzeentch portan la Marca de Tzeentch, que les otorga la regla especial Ataques flamígeros, un bonificador de +2 a su tirada de salvación especial y un +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Saga (Melekh)" id="30ee-6097-622a-7abf" collective="false" hidden="false" import="true" targetId="1c01-ebd1-6687-a46c" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Ojo de los dioses" id="94e3-ede1-e958-69e5" hidden="false" targetId="0799-cc58-3276-4a94" type="rule"/>
        <infoLink name="Caballería" id="69ef-feb8-01c5-afb5" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
        <infoLink name="Orgullo marcial" id="71b7-5169-e223-9c9f" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
        <infoLink name="Señor del conocimiento" id="1ac6-3bf8-b876-2a22" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Tzeentch)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Inmune a la psicología" id="cb6c-c036-9ad5-74ce" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Tozudez" id="251c-1a19-6e8c-100c" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink name="Miedo" id="3865-645a-edf8-b87e" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Magia de Melekh el Transmutador" id="b31d-ea84-9971-01a1" hidden="false">
          <description>Melekh es un hechicero de nivel 4 que conoce todos los hechizos del Saber de Tzeentch.</description>
        </rule>
        <rule name="Hechicero guerrero" id="86d8-e51d-5cbc-6b3e" hidden="false">
          <description>Melekh puede lanzar hechizos con normalidad pese a llevar Escudo.</description>
        </rule>
        <rule name="Heraldo de la llamas" id="f9a0-1d9c-1faa-eaef" hidden="false">
          <description>Al inicio de cada fase de combate cuerpo a cuerpo, cada unidad enemiga en contacto con Melekh sufre 1D6+1 impactos de Fuerza 1D6+1 con las reglas especiales Ataques flamígeros y Poder de penetración. Las bajas causadas por este efecto cuentan para el resultado del combate.</description>
        </rule>
      </rules>
