          <profiles>
            <profile name="Hemónculo" id="1fab-7fb5-0428-a5f0" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo hechiceros. Una vez por fase de magia, tras haber lanzado los dados para lanzar un hechizo, el hechicero puede declarar que utiliza al hemónculo para aumentar el valor de su tirada de lanzamiento en +1D3. Si lo hace, sufrirá Estupidez durante su siguiente turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Visión del caos" id="91ba-c425-cdc0-1cb8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eebd-7536-e8c3-bcd8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="c26d-3ce3-8748-5ed0" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Visión del Caos" id="8b8a-78ec-e8bc-693b" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo hechiceros. El personaje obtiene un bonificador de +2 a todas sus tiradas de Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tumor inteligente" id="b337-e9b6-74f8-dc45" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f85d-aef7-68db-fd02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="22ed-b101-5d66-4d06" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
