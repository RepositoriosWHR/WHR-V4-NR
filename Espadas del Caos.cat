              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo hechiceros. El personaje puede repetir sus tiradas en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Maestro de la hechicería" id="21e9-88cd-1c0f-df39" collective="false" hidden="false" import="true" type="upgrade">
