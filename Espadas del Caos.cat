                  <modifiers>
                    <modifier field="name" type="append" value="(Solo jinetes)"/>
                  </modifiers>
                </infoLink>
                <infoLink name="Resistencia mágica (2)" id="95c5-872e-6ccd-736a" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Khorne. Elegidos del Khorne en Juggernaut" id="b71e-26a2-29a3-c9c8" hidden="false">
                  <description>Tanto los Elegidos de Khorne como los Juggernauts de Khorne portan la Marca de Khorne, por la que obtienen las reglas especiales Furia asesina (sólo los jinetes), Odio (¡todos los enemigos!, solo las monturas) y Resistencia mágica (2). Además, no perderán su Furia asesina aunque sean derrotados en combate.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
