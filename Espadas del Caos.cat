              <infoLinks>
                <infoLink name="Piel escamosa (6+)" id="02e5-88fd-75c0-67d5" hidden="false" targetId="1d04-d136-a7a6-eb68" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Altar de guerra de los Espadas del Caos" id="275f-bfa4-594f-575b" hidden="false">
                  <description>Obtiene la regla especial Piel escamosa (6+). Además, al inicio de la batalla, antes del despliegue, efectía una tirada en la tabla del Ojo de los dioses y aplica el resultado al Altar de la guerra del Caos durante la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="bf8a-5969-af25-ec46" collective="false" hidden="false" import="true" targetId="0cf1-1763-4dd8-caba" type="selectionEntry">
              <constraints>
                <constraint id="7ddd-1807-ed2d-32b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
