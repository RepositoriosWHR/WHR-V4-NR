              </entryLinks>
              <infoLinks>
                <infoLink name="Arma de mano" id="a16d-4083-5113-ca87" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Matareyes" id="696c-c0bd-192d-dde1" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados por Matarreyes no permiten tirada de salvación por armadura. Al inicio de cualquier fase de combate cuerpo a cuerpo, Archaón puede liberar el poder del demonio en el interior de la espada: a partir de entonces, duplica el número de Ataques que realiza, pero todos los resultados de 1 en sus tiradas para impactar se resolverán contra el propio Archaón o uno de sus Espadas del Caos (a tu elección).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura de Morkar" id="a492-c190-285b-a553" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f199-8833-d0b6-78f1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2e97-a998-5c75-0820" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
