          <entryLinks>
            <entryLink name="Marca del Caos absoluto. Unidades" id="8bc7-1a55-be82-d994" collective="false" hidden="false" import="true" targetId="24b7-05f6-36ce-099c" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ojo de los dioses" id="b1be-8983-4c83-fdaa" hidden="false" targetId="0799-cc58-3276-4a94" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Solo jinetes)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="6">
                  <repeats>
                    <repeat childId="b28f-acb1-3bc9-8804" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="4a60-7c1b-2d90-5206" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca del Caos absoluto. Elegidos del Caos en corcel demoníaco" id="9e0a-7a4e-9742-e91f" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (Solo jinetes) durante la batalla; considera los resultados de 2 como 3. Además, podrán repetir sus tiradas de Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="113d-ab4d-83b5-603e" collective="false" hidden="false" import="true" targetId="0cf1-1763-4dd8-caba" type="selectionEntry">
              <infoLinks>
                <infoLink name="Furia asesina" id="57ab-9a03-69fc-d733" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Solo jinetes)"/>
                  </modifiers>
                </infoLink>
                <infoLink name="Resistencia mágica (2)" id="5817-f6db-bc24-9f3a" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
                <infoLink name="Odio" id="fe45-9a3e-84f1-ae22" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Corcel demoníaco)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="7">
                  <repeats>
                    <repeat childId="b28f-acb1-3bc9-8804" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="4a60-7c1b-2d90-5206" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Khorne. Elegidos del Caos en corcel demoníaco" id="9f72-fc09-d043-8e4c" hidden="false">
                  <description>Obtienen las reglas especiales Furia asesina (sólo los jinetes), Odio (sólo las monturas) y Resistencia mágica (2). Además, no perderán su Furia asesina aunque sean derrotados en combate.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="2b4d-beca-0c8f-03b0" collective="false" hidden="false" import="true" targetId="0adb-14f6-3d62-89cf" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ataques envenenados" id="9441-5537-e253-0d62" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink name="Inmune al veneno" id="1064-d875-d3b6-3c66" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="7">
                  <repeats>
                    <repeat childId="b28f-acb1-3bc9-8804" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="4a60-7c1b-2d90-5206" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Nurgle. Elegidos del Caos en corcel demoníaco" id="6ff6-d794-6708-0e69" hidden="false">
                  <description>Obtienen las reglas especiales Ataques envenenados e Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="f233-842c-d3e9-9d88" collective="false" hidden="false" import="true" targetId="58e3-d5f0-974c-c37b" type="selectionEntry">
