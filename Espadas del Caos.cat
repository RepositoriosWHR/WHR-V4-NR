        <constraint id="b3a2-e5b0-5261-460a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7963-1f34-aefe-b518" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Ojo dorado de Tzeentch" id="2726-728b-43bf-2ca9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eae9-0549-2466-6bc4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7a4e-e041-1295-3e5d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ojo dorado de Tzeentch" id="ed26-488d-8975-bdf0" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la Marca de Tzeentch. Proporciona una tirada de salvación especial de 4+ contra proyectiles y hechizos del tipo Proyectil mágico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Espadas del Caos. Nurgle" id="49a8-be8e-264f-14f5" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ea9e-5360-001e-8c7d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="6bd3-7364-76ee-0ec2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Filacteria necrótica" id="1244-2d4c-f148-0873" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7fc0-d7db-285d-16d2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3dbe-7099-74ef-f747" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Filacteria necrótica" id="5caa-4209-d606-0726" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas con la Marca de Nurgle. El portador obtiene la regla especial Regeneración (5+). También es inmune a los efectos de los hechizos del Saber de Nurgle, el Saber de la Muerte y el Saber de Plaga Skaven: no puede ser herido o afectado de ningún modo por hechizos de esos saberes (aunque eso no significa que disperse el hechizo; simplemente no se verá afectado).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Espadas del Caos" id="249e-243d-98d5-7559" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="fe76-c589-f5bd-4cbb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="-1"/>
        <constraint id="3083-d69a-1ad3-422d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Cáliz del caos" id="6d70-23b9-d736-d684" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2e19-b8b0-ee38-d719" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4c8a-3bfc-6b94-a1a8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cáliz del caos" id="c763-04b3-add5-265d" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Puede utilizarse al inicio de cada fase de magia propia o del enemigo. Tira 1d6. Con un resultado de 1 el hechicero sufrirá 1D3 heridas automáticas sin posibilidad de salvación por armadura. Con un resultado de 2 a 5 el hechicero genera 1D3 dados de energía o dispersión adicionales para esa fase de magia. Con un resultado de 6 todos los magos enemigos en el campo de batalla tendrán que obtener un resultado igual o inferior a su nivel de magia o sufrirán una Disfunción mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La calavera de Kasteman" id="0ff4-24ea-5319-f7bd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3af3-fdcc-8a3b-10d1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a4b1-1ae8-e467-8546" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="La calavera de Kasteman" id="f3ed-4d77-0b69-6693" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Proporciona a su portador un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Familiar del caos" id="cf02-5dca-8ee5-fa07" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="713c-4730-d895-dbc5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1b7d-0710-5b3f-8912" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Familiar del caos" id="a824-60e8-9aee-26bd" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro cristalino del norte" id="973d-2bf3-d9fe-42a6" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1ed0-b5cc-e96c-1ecf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9a5c-cd85-bd37-1679" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro cristalino del norte" id="7176-48cf-abe0-3039" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al final de cada fase de magia el portador puede guardar hasta dos dados de magia no utilizados para usarlos en una fase posterior. Una vez por partida y agotando uno de los dados guardados, puedes declarar que los usas cuando el oponente lance exitosamente un hechizo pero antes de efectuar la tirada para dispersar. Dispersa automáticamente el hechizo. Ten en cuenta que no funciona contra hechizos lanzados con Fuerza irresistible. El cetro se quiebra parcialmente dejando guardar un solo dado a partir de la dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Grimorium Necronium" id="5f1e-900b-f507-adff" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c10c-ee70-d665-567e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0c8b-d1c0-e76c-e609" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Grimorium Necronium" id="1d97-ab9b-6125-392c" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador conoce un hechizo adicional. Además, una vez por batalla, el portador puede repetir una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Espadas del Caos. Slaanesh" id="827e-458b-bf41-00f6" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="1065-84cd-3483-04aa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="-1"/>
        <constraint id="2ed6-4b97-da3a-69e7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Cetro de la dominación de Slaanesh" id="6081-929e-6115-648a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2f06-8c79-88a3-aefd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="64ac-e189-deca-b61a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro de la dominación de Slaanesh" id="70e2-680f-744f-0050" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Slaanesh. Objeto portahechizos, Nivel de energía 6. Puede utilizarse en cada fase de magia propia contra una unidad enemiga no trabada en combate a 18” o menos del portador. Esta unidad deberá realizar un chequeo de Liderazgo tirando 3D6 y descartando el resultado menor. Si lo falla, no podrá cargar, marchar ni disparar durante su siguiente turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Espadas del Caos. Nurgle" id="4c97-44bf-4122-3a15" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="75c2-63eb-43b7-8d82" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="-1"/>
        <constraint id="17c3-ecc9-4d21-6314" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Relicario de putrefacción" id="e9b8-465c-a34e-9568" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="45a2-9722-8bef-c1c0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="db5e-e6e0-b5da-b877" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Relicario de putrefacción" id="48c4-bfe7-16a6-7018" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Nurgle. Al final de cada fase de magia, el portador puede decidir entre guardar un dado de energía o dispersión en el Relicario para utilizarlo en la siguiente fase de magia; o gastar un dado de su reserva de energía o dispersión para restablecer una de las heridas que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Espadas del Caos. Tzeentch" id="cd04-4e1b-c395-8616" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4166-800a-7a60-f2ef" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="-1"/>
        <constraint id="06a5-548b-2aa6-6fe8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Liber maleficus" id="af84-94f9-18c3-233d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e7e6-c466-0a1f-5266" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b78d-fe8c-1678-01ab" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="8432-91b5-1450-9ef5" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Tzeentch)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Liber maleficus" id="98fe-088f-2502-ca66" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Tzeentch. Otorga la regla especial Señor del conocimiento (Saber de Tzeentch).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espejo de plata de Tzeentch" id="caf8-eefe-a6d4-455b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4817-883e-c572-31dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b587-eb05-7ab4-9939" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Espejo de plata de Tzeentch" id="38b2-2ded-95f9-84f4" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Tzeentch. Al inicio de cada fase de magia propia, puedes elegir una unidad enemiga en el campo de batalla: el oponente deberá revelarte todos los objetos mágicos que haya en dicha unidad, así como todas las opciones ocultas que contenga (asesinos, fanáticos, etc); a partir de ese momento, dicha unidad pasa a considerarse Escrutada. Cada vez que el portador u otro hechicero amigo con la Marca de Tzeentch lance un hechizo contra una unidad enemiga que haya sido Escrutada durante la batalla, puede repetir todos los resultados de 1 que obtenga en sus dados de Energía.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Espadas del Caos" id="5016-76c9-9823-6a51" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e56e-3109-1861-ade9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="19d9-860f-deb7-d4f7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Amuleto de piedra de disformidad" id="019b-81f8-bcab-beb8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a127-6dc1-591b-ecf8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="175f-3ee4-a1da-2e89" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="1cfc-d660-7361-c892" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, un único dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Favor de los dioses" id="09dd-a8bd-03a5-c472" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b22f-181e-03b3-a533" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ad2a-0e5e-237a-d608" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Favor de los dioses" id="afde-a301-f94e-1255" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla del Ojo de los dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Yelmo de incontables ojos" id="b7ec-2d84-a405-0f8c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ad41-ea4e-4aa1-45df" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e21b-4618-686b-9b60" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Yelmo de incontables ojos" id="a3b1-87cc-4e11-8a6e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador verá su tirada de salvación por armadura incrementada en un +1. Además, aumenta su Iniciativa a 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Anillo de Morkar" id="c901-5932-fc89-96cd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4b91-8fd7-0759-bb76" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="03ff-10bf-6c3c-4da2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de aliento" id="98aa-389f-4aa0-f457" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(F3, sin salvación por armadura)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Anillo de Morkar" id="7e65-d41c-4485-e89f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Proporciona a su portador un Arma de aliento de F3 que no permite tirada de salvación por armadura y que tiene la regla especial Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Relicario de vigor oscuro" id="ee69-da20-e107-32c8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7a41-f953-4a8d-917f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d918-117a-dbc0-12ad" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Relicario de vigor oscuro" id="2f79-da3b-00fb-5dfd" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de cada uno de tus turnos elige una miniatura a 8” o menos del portador (que puede ser el propio portador): dicha miniatura recupera una herida que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Espadas del Caos. Khorne" id="978d-c374-fed2-1c83" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="ffe3-181b-1a54-b4c0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="61b0-c93e-41bb-ea38" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Corona de la ira" id="de88-440d-a272-831d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b074-7caa-ac25-917f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9ab4-db4c-4e42-7b97" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (3)" id="40ed-57d8-7c95-29e4" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Corona de la ira" id="ee77-b770-6456-a040" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Khorne. Proporciona a su portador Resistencia mágica (3). Además, si un hechizo es dispersado utilizando la Resistencia mágica que otorga este objeto, tira 1D6: si obtienes un resultado de 5+, el hechizo es destruido y no podrá utilizarse más durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Espadas del Caos. Nurgle" id="6aab-acb4-3159-ad92" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c9b7-77bc-8245-2f3b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="91e8-c85f-8669-db01" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Cráneos de muerte" id="77c7-bf01-0230-9d71" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="33ef-d69a-d7e3-0a4a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d04b-f01f-9c73-4e10" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cráneos de muerte" id="e8ca-66bb-927d-c04b" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Nurgle. El portador puede utilizar los cráneos en cada fase de disparo si no está trabado en combate, aunque no para aguantar y disparar. Coloca la plantilla redonda pequeña a 12” o menos del portador y tira los dados de artillería y dispersión como si estuvieses disparando una Catapulta aunque, si se dispersa, lo hará la mitad de la distancia indicada en el dado de artillería. Cualquier miniatura bajo la plantilla deberá efectuar un chequeo de Resistencia o sufrir una herida sin tirada de salvación por armadura. Si obtienes un resultado de Problemas, retira la plantilla sin causar ningún efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Espadas del Caos. Tzeentch" id="d29c-aee2-6b8d-a914" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="9876-80c2-c1d0-5891" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="de3e-ab05-3956-9df0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Prisma caleidoscópico" id="9c53-ba8b-c15b-e7b9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9a23-5152-54d5-dddd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="fb62-59a7-41fd-93d2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Prisma caleidoscópico" id="c05d-b61f-4552-4d7b" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Tzeentch. Un sólo uso. Puede utilizarse al final de cualquier fase de movimiento propia si el portador no ha movido esa fase (puede utilizarse aunque el portador esté trabado en combate cuerpo a cuerpo). Retira la miniatura del portador del campo de batalla y vuelve a colocarla inmediatamente a 24” o menos de donde se encontraba y a 1” o más de cualquier miniatura amiga o enemiga. Si una unidad enemiga queda destrabada a causa de esto, puede realizar inmediatamente un chequeo de Liderazgo para reorganizarse.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cofre de plata" id="9201-6174-285c-c2a8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="31a0-b018-ba6c-5ac6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7ed8-8300-668d-ac5c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cofre de plata" id="0f61-687a-356a-0f63" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Tzeentch. Objeto portahechizos, nivel de energía 1D3+1. Contiene un hechizo de Maldición que puede lanzarse sobre una unidad enemiga a 18” o menos del portador. Cada miniatura de la unidad objetivo sufre un impacto de F1 con la regla especial Ataques sólo flamígeros que no permite tirada de salvación por armadura</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Espadas del Caos. No Khorne ni Hechicero" id="92ae-5734-0705-d503" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c9aa-621c-601d-d9e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="c561-ae60-9537-06a8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Libro de los secretos del Caos" id="8e8b-2f28-6235-af50" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7592-e2dc-a657-60d0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="28e1-1cda-5195-ea2b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Libro de los secretos del caos" id="096b-83f3-1dcc-1713" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador pasa a considerarse hechicero de nivel 1 que puede utilizar el Saber de las Sombras, el Fuego o la Muerte. No puede ser utilizado por miniaturas con la Marca de Khorne o por personajes que ya tuviesen uno o más niveles de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
