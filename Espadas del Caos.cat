    <selectionEntryGroup name="Recompensas del Caos. Tzeentch" id="1b08-e9ef-a0e5-42eb" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="911d-9f31-0bbf-5c9f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Fortuna de Tzeentch" id="f1c6-85b4-93e6-fd25" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2c22-a877-27e1-a41e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="96af-1232-b315-160d" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Fortuna de Tzeentch" id="d3bf-78d3-9168-2e86" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Una vez por turno de jugador, el Paladín puede repetir una tirada de 1D6. Puede ser una tirada para impactar, herir, salvación (por armadura o especial) o un chequeo de atributo (excepto de Liderazgo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Voluntad de Tzeench" id="a952-0d20-d04e-1a65" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0e4d-d9dd-ec67-ec88" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="a6e0-a261-c456-788f" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Voluntad de Tzeench" id="2993-f44c-f416-daa1" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje genera un dado de Energía adicional en cada fase de magia propia, que puede ser utilizado por cualquier personaje con la Marca de Tzeentch.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ojo de Tzeentch" id="f522-fa2c-7069-7123" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f7e4-86c2-1608-71ff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="dc08-2927-9499-d8d1" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ojo de Tzeentch" id="da90-e2fd-1fa8-9a54" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje podrá repetir todas sus tiradas fallidas para impactar, tanto en combate cuerpo a cuerpo como con proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Aura mágica de Tzeentch" id="3a1c-39fa-2957-c3dd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2096-df11-f80b-2803" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="3f58-760c-9bb4-2bcd" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (1)" id="a144-4981-e547-6015" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Aura mágica de Tzeentch" id="f3c0-3a92-e545-2e5f" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo miniaturas con la Marca de Tzeentch. El personaje obtiene una tirada de salvación especial de 6+ y la regla especial Resistencia mágica (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sanguijuela arcana" id="6995-51d1-c9bc-f1ee" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8a42-dca8-f9c3-9add" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d0c0-5b83-1b3b-12dd" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sanguijuela arcana" id="fd75-c36d-6da0-631f" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Por cada herida causada en combate cuerpo a cuerpo por el personaje tira 1D6; con un resultado de 5+, podrás añadir un dado de Energía o Dispersión durante la próxima fase de magia (según corresponda).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Recompensas del Caos. Tzeentch. Hechiceros" id="feec-d782-12b5-9c1d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="87b4-f17f-8a66-7dcd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="true" type="max" value="-1"/>
