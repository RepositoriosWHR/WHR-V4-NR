          </constraints>
          <entryLinks>
            <entryLink name="Marca del Caos absoluto. Unidades" id="8661-ba8a-130a-dbe7" collective="false" hidden="false" import="true" targetId="24b7-05f6-36ce-099c" type="selectionEntry">
              <entryLinks>
                <entryLink name="Los Guerreros Kul" id="3998-5119-fe26-495e" collective="false" hidden="false" import="true" targetId="2798-70b4-9929-8cc7" type="selectionEntry"/>
              </entryLinks>
              <infoLinks>
                <infoLink name="Ojo de los dioses" id="adc4-a0d5-2d32-3b67" hidden="false" targetId="0799-cc58-3276-4a94" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="4">
                  <repeats>
                    <repeat childId="266c-f7b2-d0da-fd04" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="71da-f694-3a3b-9435" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca del Caos absoluto. Elegidos del Caos" id="de21-80be-1f06-80a4" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad durante la batalla; considera los resultados de 2 como 3. Además, podrán repetir sus tiradas de Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="b40b-bf49-e0d9-cbd1" collective="false" hidden="false" import="true" targetId="0cf1-1763-4dd8-caba" type="selectionEntry">
              <infoLinks>
                <infoLink name="Furia asesina" id="c256-b5c7-d4af-91fd" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
                <infoLink name="Resistencia mágica (2)" id="0ba4-501e-d04c-8024" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="5">
                  <repeats>
                    <repeat childId="266c-f7b2-d0da-fd04" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="71da-f694-3a3b-9435" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Khorne. Elegidos del Caos" id="0236-49e3-72da-c67d" hidden="false">
                  <description>Obtienen las reglas especiales Furia asesina y Resistencia mágica (2). Además, no perderán su Furia asesina aunque sean derrotados en combate.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="1213-92b6-3bad-c0fb" collective="false" hidden="false" import="true" targetId="0adb-14f6-3d62-89cf" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ataques envenenados" id="a89d-5bc6-f8b3-7e05" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink name="Inmune al veneno" id="747b-c7a9-32e0-6280" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="5">
                  <repeats>
                    <repeat childId="266c-f7b2-d0da-fd04" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="71da-f694-3a3b-9435" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Nurgle. Elegidos del Caos" id="1cef-450e-9d50-88dd" hidden="false">
                  <description>Obtienen las reglas especiales Ataques envenenados e Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="b10d-5d4a-59cd-d348" collective="false" hidden="false" import="true" targetId="58e3-d5f0-974c-c37b" type="selectionEntry">
              <infoLinks>
                <infoLink name="Indesmoralizable" id="9c9c-3e01-d5c0-a7db" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
                <infoLink name="Poder de penetración" id="4ceb-e007-85e3-98c1" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <modifiers>
