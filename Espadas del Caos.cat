          <profiles>
            <profile name="Maestro de la hechicería" id="7092-4522-ea82-e105" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">Sólo hechiceros. El personaje conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Espadas del Caos. Slaanesh" id="2d96-4585-6f30-a593" collective="false" hidden="false" import="true">
