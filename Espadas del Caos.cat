          <profiles>
            <profile name="Estandarte del Apocalipsis" id="eb52-4f50-f196-ac2f" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su undad causarán Terror.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pabellón del odio" id="a105-ecde-9c48-07a2" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="9d19-ee36-cb45-0d12" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7931-b916-2861-1da2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio (todos los enemigos)" id="f1d8-58af-1daa-04a2" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pabellón del odio" id="1ec0-5584-0cd1-6c67" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador (y la unidad en la que se encuentre) obtendrán la regla especial Odio (todos los enemigos). Los resultados de 1 para impactar (después de repetir) se resolverán para herir contra la propia unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tótem maldito" id="8a28-fff0-084e-f3c4" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="62b5-d36e-2a83-47b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dfac-5bc8-1d68-f5df" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tótem maldito" id="eff3-be3a-0fe9-9c16" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades enemigas a 8” o menos del estandarte tendrán un penalizdor de -1 a su Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pabellón demoníaco" id="ee50-3810-0cd4-0165" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="4fbe-92cb-905d-6f59" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b188-fae7-bcd6-4eb7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Aura demoníaca (5+)" id="9594-5e2f-3fee-25dd" hidden="false" targetId="e5ed-5149-3d72-6aa4" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pabellón demoníaco" id="599d-f09d-7030-7417" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Aura demoníaca (5+).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Icono de Acero Negro" id="1c00-fb06-a979-0204" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="da94-e8ee-0b15-9295" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f48a-0d85-355b-da7e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
