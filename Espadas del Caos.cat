          </infoLinks>
          <profiles>
            <profile name="Grandes cuernos" id="8028-6352-53de-8f83" hidden="false" typeId="c41e-b78a-d6e4-14ca" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="390b-454b-3cef-f653">El personaje obtiene la regla especial Impactos por carga (1). Si ya causaba Impactos por carga, estos aumentan en +1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cuerpo ardiente" id="9b18-e6b5-f221-431b" collective="false" hidden="false" import="true" type="upgrade">
