            <entryLink name="Marca de Tzeentch. Unidades" id="6551-0305-f9b3-7996" collective="false" hidden="false" import="true" targetId="c292-d70c-c3b7-396f" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="e4b7-97b1-82e1-316f" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="5">
                  <repeats>
