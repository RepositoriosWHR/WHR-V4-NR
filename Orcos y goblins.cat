      <rules>
        <rule name="Animosidad Kobolds de fuego" id="dd98-9d35-0519-8220" hidden="false">
          <description>Cuando lancen piedras a otra unidad como resultado de la animosidad usa el perfil de sus gargajos llameantes para resolver los impactos.</description>
        </rule>
        <rule name="Raroz Kobolds de fuego" id="630d-0e2c-e155-6458" hidden="false">
          <description>Ningún personaje puede unirse a una unidad de Kobolds de fuego, salvo un Gran jefe kobold.</description>
        </rule>
      </rules>
