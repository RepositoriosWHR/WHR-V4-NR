          <profiles>
            <profile name="Koraza vengativa" id="c441-fa36-0317-f0e6" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Cada vez que el portador salve con su tirada de salvación por armadura una herida causada en cuerpo a cuerpo, el que causó la herida recibe un impacto de Fuerza 4 sin salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
