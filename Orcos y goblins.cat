                  </infoLinks>
                  <profiles>
                    <profile name="Muerde-elfoz (El hacha de Grom)" id="898f-ec4d-6dc5-f3c3" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Los impactos causados por Muerde-elfoz tienen la regla especial Golpe letal y no permiten tirada de salvación por armadura. Además, si Grom está atacando a alguna miniatura de elfo, el Golpe letal surtirá efecto con un resultado de 5+ en lugar del habitual 6+.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
