      </modifiers>
      <rules>
        <rule name="Magia Wurrzag Ud Ura Zahubu, el gran profeta verde" id="8548-cc2c-820f-1d9a" hidden="false">
          <description>Wurrzag es un hechicero de nivel 4 que conoce todos los hechizos del Saber del Gran Waaagh!.</description>
        </rule>
        <rule name="El favorito de Morko" id="26e5-b40d-9976-2b45" hidden="false">
          <description>Wurrzag tiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos. Además, la potencia de sus Pinturas de guerra es tal que disfruta de una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (2).</description>
        </rule>
        <rule name="Mal sabor" id="1581-3d52-ffea-2e66" hidden="false">
          <description>Todas las Bestias, Bestias monstruosas, Enjambres y Monstruos tienen un penalizador de -1 en sus tiradas para impactar contra Wurrzag.</description>
        </rule>
      </rules>
      <selectionEntries>
