            <profile name="Eztandarte beztia de Nogg" id="dccc-2765-a63b-8b0c" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Todas las miniaturas de la unidad obtienen +1 Ataque durante el turno en el que se activa el estandarte.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Eztandarte burlón" id="b27c-a679-35ca-12c2" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
