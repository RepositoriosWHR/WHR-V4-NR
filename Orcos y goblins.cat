                  <infoLinks>
                    <infoLink name="Pinchagarrapatoz" id="f622-b9ed-bac4-80d8" hidden="false" targetId="2157-eba9-d088-dc16" type="profile"/>
                    <infoLink name="Ataques de rayos" id="b147-153c-4545-9589" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Pincho de Skarsnik" id="4958-dc4f-3870-a550" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Pinchagarrapatoz. Los impactos del Pincho de Skarsnik no permiten tirada de salvación por armadura. Además, es un objeto portahechizos de nivel de energía 1D6+1 que contiene un hechizo de Proyectil mágico que toma como objetivo a una unidad enemiga a 24” o menos de Skarsnik: la unidad sufre un impacto, más un impacto adicional por cada unidad de goblins con potencia de unidad 20+ a 12” o menos de Skarsnik, más un impacto por cada una de esas unidades que se encuentre trabada en combate cuerpo a cuerpo. Todos los impactos se resuelven con Fuerza 6 y la regla especial Ataques de rayos.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Armadura de laz barbaz" id="df73-7ce3-be59-240f" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="1526-8ac0-a24a-d7a6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                    <constraint id="7caf-6486-2764-2718" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                  </constraints>
