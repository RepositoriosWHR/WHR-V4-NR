            <profile name="Garrapato de atake" id="25c4-8f48-e546-1415" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo goblin nocturno. El personaje obtiene un ataque adicional, que se resolverá a su propia Iniciativa, con Habilidad de armas 4, Fuerza 5 y las reglas especiales Odio (Enanos) y Ataque rápido. Sin embargo, si se obtiene un resultado de 1 en la tirada para impactar, será el portador el que sufra un impacto de Fuerza 5.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
