            <profile name="Bákulo chorizador" id="8e76-6955-8466-c9c6" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Al inicio de cada fase de magia del oponente, puedes robar uno de sus dados de Energía y añadirlo a tu reserva de dados de Dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Kaldero de nieblaz" id="e5c1-5c61-4def-e824" collective="false" hidden="false" import="true" type="upgrade">
