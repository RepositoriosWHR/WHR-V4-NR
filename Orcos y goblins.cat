              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo orcos salvajes. La tirada de salvación especial de la unidad por las Pinturas de guerra aumenta a 5+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
