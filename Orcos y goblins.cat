              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Rebanadora. El portador puede repetir sus tiradas fallidas para impactar al atacar con este arma. Además, sus impactos se resuelven con +1 a la Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
