            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Katapulta lanzarredez" id="9a1b-bdf7-7a3d-3312" hidden="false">
          <description>La Katapulta lanzarredez dispara como una Catapulta con un alcance de 12-60”, aunque utiliza la plantilla redonda grande y tiene Fuerza 1 (Fuerza 3 el impacto central, sin la regla especial Heridas múltiples). Cualquier unidad impactada por la Katapulta lanzarredez verá sus atributos de Iniciativa y Movimiento reducidos a la mitad (redondeando hacia arriba) y perderá la regla especial Veloz hasta el inicio de la siguiente fase de disparo de los goblins.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Dotación" id="f2b7-fb86-5662-8759" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5ac0-d189-d577-3fff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6a10-1bd7-2895-bb64" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Goblin silvano (3)" id="b026-fa06-d602-5325" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
