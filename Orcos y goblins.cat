      <rules>
        <rule name="Lanzapiedroz orco" id="eda9-0d9e-1531-d889" hidden="false">
          <description>El Lanzapiedroz dispara como una Catapulta con un alcance de 12-60”, utiliza la plantilla redonda pequeña y sus impactos se resuelven con F4; el impacto central se resuelve con F8 y la regla especial Heridas múltiples (1D6).</description>
        </rule>
      </rules>
