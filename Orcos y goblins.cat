      <selectionEntryGroups>
        <selectionEntryGroup name="¡Konztructoz!" id="b4ff-21f2-8bcf-8ea9" collective="false" defaultSelectionEntryId="667a-1ee9-e079-e9bc" hidden="false" import="true">
          <constraints>
            <constraint id="223a-0b78-c7f8-4312" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="6fed-f3c9-cddc-29fc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <selectionEntries>
            <selectionEntry name="Ídolo de Gorko (o Morko)" id="667a-1ee9-e079-e9bc" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8a23-08cf-0146-7089" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Heridas múltiples (1D3)" id="bc54-49ee-01dd-84f2" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
                <infoLink name="Monstruo" id="90e7-1844-77eb-be6f" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
                <infoLink name="Piel escamosa (3+)" id="c0b0-2744-cc4d-569b" hidden="false" targetId="f3fe-4c6e-197e-832f" type="rule"/>
                <infoLink name="Tozudez" id="0c48-a6a1-458a-a113" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
                <infoLink name="Demonio" id="851c-87cc-6474-5d25" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Hecho de piedra" id="6410-546b-cf6a-fb0b" hidden="false">
                  <description>Si un Ídolo fuera a sufrir heridas múltiples, reduce el número de heridas sufridas a la mitad (redondeando hacia arriba).</description>
                </rule>
                <rule name="Arrojar rocas" id="6bd5-49ff-c80f-731d" hidden="false">
                  <description>Los Konztruktoz pueden arrojar rocas, lo cual se trata como una catapulta que puede disparar aunque el Konztrukto mueva (pero no si marcha) con un alcance de 0-24” que usa la plantilla redonda pequeña. Si obtienes un resultado de Problemas no tires en ninguna tabla: el Konztrukto sufre una herida sin tirada de salvación por armadura. Las rocas del Ídolo se resuelven con Fuerza 4 (Fuerza 8 el impacto central y la regla especial Heridas múltiples (1D6)).</description>
                </rule>
                <rule name="Dezmoronarze" id="6314-3f2d-c187-5f49" hidden="false">
