                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Mázkara zinieztra" id="b292-c7e7-e5cc-55c0" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">La máscara proporciona a Wurrzag un bonificador de +1 a su tirada de salvación por armadura y hace que cause Miedo. La máscara también confiere a Wurrzag un Arma de aliento de Fuerza 5.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Wizzbang, el garrapato alkalino" id="4971-a7d3-0a0e-e680" collective="false" hidden="false" import="true" type="upgrade">
