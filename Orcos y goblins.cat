        <modifier field="hidden" type="set" value="true">
          <conditionGroups>
            <conditionGroup type="and">
              <conditions>
                <condition childId="3cc2-7c2c-e226-e444" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
