                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Una vez por batalla, cuando Azhag sufra una Disfunción mágica, puedes hacer que el efecto de dicha disfunción lo sufra un hechicero enemigo a 18” o menos de Azhag.</characteristic>
                  </characteristics>
