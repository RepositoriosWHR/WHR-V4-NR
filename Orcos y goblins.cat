          </infoLinks>
          <profiles>
            <profile name="Pintura de guerra mágika" id="9b0a-681c-50d6-3109" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo goblin silvano. El portador no puede llevar Armadura ligera ni pesada. Otorga a su portador una tirada de salvación especial de 5+ y la regla especial Resistencia mágica (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
