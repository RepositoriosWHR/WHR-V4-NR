                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <selectionEntries>
                <selectionEntry name="Eztandarte zuertudo" id="9031-5264-dec7-5375" collective="false" hidden="false" import="true" type="upgrade">
