    <selectionEntry name="[Ex] - Gigante quebrantahuesos" id="5dc6-1966-d251-5181" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="7691-8d28-1743-c3dd" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
        <constraint id="1b81-d92a-d2d0-3771" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Monstruo" id="3274-1eae-5cc7-e5d1" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Cruzar (obstáculos)" id="bf2a-1f3a-e058-53af" hidden="false" targetId="5dfd-3f02-cece-1e02" type="rule"/>
        <infoLink name="Unidad legendaria" id="65af-9554-b0da-2f94" hidden="false" targetId="729e-2ed5-79eb-8288" type="rule"/>
        <infoLink name="Monstruosamente grande" id="81db-021b-195c-b0c2" hidden="false" targetId="38d4-1707-be50-7d0f" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
