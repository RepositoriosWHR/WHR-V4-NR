        <infoLink name="Tozudez" id="0cac-6f35-19b6-1371" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink name="Odio (todos los enemigos)" id="820f-e663-ed94-4d18" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
