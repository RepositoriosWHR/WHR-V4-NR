            <profile name="Eztandarte aráknido" id="7a77-d519-db45-dc9c" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo goblin silvano. Todos los goblins silvanos de la unidad (y sus monturas) obtienen la regla especial Ataques envenenados. Si ya tenían esa regla, estos surtirán efecto con un resultado de 5+ en lugar del habitual 6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
