            <constraint id="4b7a-3a11-5513-8c5f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Kaldero de nieblaz" id="142c-3c99-41bb-13b3" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 3. Se trata de un hechizo de Potenciación que toma como objetivo a una unidad amiga a 12” o menos del personaje y Permanece un turno. Por la duración del hechizo, otorga a la unidad la regla especial Veloz; todos los ataques de disparo y cuerpo a cuerpo contra la unidad tendrán un penalizador de -1 para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
