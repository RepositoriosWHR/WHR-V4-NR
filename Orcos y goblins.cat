              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. El personaje puede usarlo al inicio de cualquiera de sus fases de magia, tras la tirada de los Vientos de la Magia. Por cada unidad de orcos a 12” o menos del personaje que tenga al menos Potencia de unidad 10, el personaje añade un dado de Energía a su reserva de dados.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Familiar bazilón" id="12c7-258d-b19a-9f07" collective="false" hidden="false" import="true" type="upgrade">
