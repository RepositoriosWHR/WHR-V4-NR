      <rules>
        <rule name="Ez el jefe" id="ab4e-2bf6-d5ef-5eed" hidden="false">
          <description>La regla especial Presencia inspiradora de Gorbad tiene un alcance de 18” en lugar de las 12” habituales. Además, Gorbad tiene la regla ¡Ni un paso atrás!, que afecta a todas las unidades de Orcos y Goblins a 18” o menos de Gorbad.</description>
        </rule>
        <rule name="El jefe tiene un plan" id="e8ba-7a45-5605-a513" hidden="false">
          <description>Cada vez que una unidad de orcos a 18” o menos de Gorbad falle un chequeo de Animosidad, suma el número de Heridas que le queden a Gorbad a su tirada en la tabla de Animosidad (cualquier resultado superior a 6 se considera 6).</description>
        </rule>
        <rule name="Zeñor del gran waaagh" id="03e4-3ec7-71d2-c108" hidden="false">
          <description>Un ejército comandado por Gorbad puede incluir orcos 
grandotes (de cualquier tipo) como opción de Unidad básica.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="General del ejército" id="1eff-6761-18a6-6cd0" collective="false" hidden="false" import="true" type="upgrade">
