              <profiles>
                <profile name="Baztón de huezo" id="fe78-9a0d-86ff-edfc" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques realizados con este arma se resuelven con un bonificador +1 a la Fuerza. Cualquier miniatura enemiga que reciba una herida del bastón y no muera deberá realizar un chequeo de Resistencia; si lo falla, se convertirá en un pequeño garrapato y deberá ser retirada como baja.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
