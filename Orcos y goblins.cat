      <rules>
        <rule name="Pequeñoz abuzonez" id="4fbb-b902-52a1-3148" hidden="false">
          <description>Si en la mesa de juego no hay presente ningún orco (amigo o enemigo), los Goblins de las colinas fallarán sus chequeos de Animosidad con resultado de 1-2 en el dado.</description>
        </rule>
        <rule name="Raroz Goblins de las colinas" id="9fbb-3c64-0fe8-e26c" hidden="false">
          <description>Ningún personaje puede unirse a una unidad de Goblins de las colinas, salvo un Gran jefe de las colinas.</description>
        </rule>
      </rules>
