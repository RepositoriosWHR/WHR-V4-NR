            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Oddgit, el zabio de loz hongoz" id="7ba5-8f14-3f9a-f25c" hidden="false">
          <description>Oddgit es un hechicero de nivel 2 que siempre utiliza hechizos del saber del Pequeño Waaagh!</description>
        </rule>
        <rule name="Totalmente demente" id="14b3-7a48-e5bd-fed2" hidden="false">
          <description>Oddgit tiene la regla especial Inmune a psicología y cualquier unidad de goblins nocturnos a la que se una no tendrá que chequear Animosidad. Sin embargo, Oddgit está sujeto a la regla especial Estupidez.</description>
        </rule>
        <rule name="Habituado al Waaagh" id="2aa6-b3f1-c22a-c5a3" hidden="false">
          <description>Oddgit puede repetir los resultados de 1 que obtenga en sus dados de Zetaz mágikaz pero, si repite, cada dado de Zeta mágika tendrá problemas con un resultado de 1-2, en lugar del habitual 1. Oddgit puede consumir un máximo de seis Zetas mágikaz cada vez que lance un hechizo.</description>
        </rule>
      </rules>
