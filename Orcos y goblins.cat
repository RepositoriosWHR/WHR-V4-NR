                    <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
                  </costs>
                  <infoLinks>
                    <infoLink name="Armadura pesada" id="3f7e-33c1-73ee-0801" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
                    <infoLink name="Resistencia mágica (1)" id="69ac-0404-767d-6a95" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                  </infoLinks>
                  <profiles>
                    <profile name="Armadura de laz barbaz" id="c681-557d-da8e-5cbb" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Proporciona a Skarsnik una tirada de salvación por armadura de 3+ (en lugar del habitual 5+ por ser armadura pesada, con lo que totaliza una tirada de salvación por armadura de 1+), una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (1).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
