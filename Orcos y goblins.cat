                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Rebanadora. La unidad a la que esté unido el portador puede ignorar el primer fallo en un chequeo de Animosidad que sufra durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
