          <profiles>
            <profile name="Ketepincho de Hacka" id="829d-46af-82f9-2268" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Rebanadora a dos manos. Por cada herida causada con este arma, el portador puede realizar inmediatamente un Ataque adicional. Estos ataques adicionales no generan nuevos ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
