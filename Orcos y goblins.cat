              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Una vez por fase de magia propia, el personaje puede repetir todos los dados de una de sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
