              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo durante cualquier turno en el que realicen exitosamente una carga.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Reliquias. Orcos. Rebanadora" id="3d78-32d4-507c-b2c8" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="86a9-7f5e-cd7a-538f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="de52-a837-8272-b4bf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Morgor la mutiladora" id="5d1a-f8af-f13b-8fc8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7a23-de7b-2f6c-5414" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3e6a-56e9-8dfd-4fb3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="115"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="9b5b-379f-c4e3-17ac" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Ataque rápido" id="e493-526d-edf2-2a3c" hidden="false" targetId="0107-ab2b-9c74-dade" type="rule"/>
            <infoLink name="Rebanadora" id="0f86-b2ed-c78a-2332" hidden="false" targetId="05bc-9cd8-8906-b545" type="profile"/>
            <infoLink name="Requiere ambas manos" id="17f7-094b-3786-7d6e" hidden="false" targetId="41a9-6192-62dd-4867" type="rule"/>
            <infoLink name="Objeto legendario" id="a768-b02d-2cab-cef7" hidden="false" targetId="1eb5-f5b5-0dbe-0f2e" type="profile"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="4135-10d5-9676-0317" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Morgor la mutiladora" id="7877-9274-bae9-69ee" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Objeto legendario. Rebanadora. Requiere ambas manos. Al luchar con este arma el portador obtiene +1HA, +1F, +1R, +1I y +1A, además de la regla especial Ataque rápido. Los impactos causados con Morgor la mutiladora no permiten tirada de salvación por armadura. Por último, los resultados naturales de 6 en las tiradas para herir con este arma se resuelven con la regla especial Heridas múltiples (1D3). Especial: Si tu ejército está liderado por Gorbad Garra’ierro, no puedes incluir este objeto mágico (ya que lo porta Gorbad).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Zúper-rebanadora del Gran Waaaaagh!" id="ce70-caf7-8c47-fbef" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9215-450e-4b5f-461f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="01a4-7fad-8f19-58c1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="75"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="716a-9bae-cbb6-9d33" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Rebanadora" id="b702-159d-0a8f-0b2d" hidden="false" targetId="05bc-9cd8-8906-b545" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Zúper-rebanadora del gran waaaaagh!" id="cbb4-3487-6625-f82c" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Rebanadora. Al atacar con este arma el portador obtiene un bonificador de +1 a sus atributos de Fuerza y Ataques igual al modificador por filas de la unidad en la que esté incluido.</characteristic>
              </characteristics>
