            <cost name="pts" typeId="points" value="350"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (4+)" id="10b0-390a-1b0c-987d" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Grom el panzudo" id="bd70-5319-359c-84ef" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">4</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">5</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">4</characteristic>
                <characteristic name="F" typeId="5.323232344415441e+21">4</characteristic>
                <characteristic name="R" typeId="5.423232344415441e+21">5</characteristic>
                <characteristic name="H" typeId="5.723232344415441e+21">3</characteristic>
                <characteristic name="I" typeId="4.923232344415441e+21">4</characteristic>
                <characteristic name="A" typeId="4.123232344415441e+21">4</characteristic>
                <characteristic name="L" typeId="4c4423232344415441232323">9</characteristic>
                <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323">4</characteristic>
                <characteristic name="TSE" typeId="5.761726453617665e+35">5</characteristic>
                <characteristic name="Tipo" typeId="5.479706523232345e+27">Infantería</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Leyenda viviente" id="d5e5-acf8-98a3-c58a" hidden="false">
              <description>La regla especial Presencia inspiradora de Grom tiene un alcance de 18” en lugar de las 12” habituales.</description>
            </rule>
            <rule name="Kome orejotaz p´a dezayunar" id="c383-e9de-d5be-14bd" hidden="false">
              <description>Todos los goblins de tu ejército perderán su regla especial Miedo a loz orejotaz.</description>
            </rule>
            <rule name="El Waaagh de Grom" id="4d87-3b3c-d50b-ca5f" hidden="false">
              <description>Una vez por batalla, al inicio de cualquiera de tus turnos, puedes declarar que Grom va a gritar Waaaagh! Todas las unidades goblins que estén huyendo se reagruparán automáticamente (ten en cuenta que esto se realiza al inicio del turno, por lo que las unidades que se reagrupen podrán cargar ese turno). Todas las unidades con Animosidad del ejército fallarán automáticamente sus chequeos de animosidad, pero no tires en la tabla: se considera que todas obtienen un resultado de 6 (¡A por elloz!). Además, hasta el inicio de tu siguiente turno, todos los goblins del ejército obtendrán la regla especial Odio (¡todos los enemigos!).</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Equipo Grom el panzudo" id="6fe5-e549-a2d7-9f83" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
