          <profiles>
            <profile name="Eztandarte de Borko" id="0bd3-c728-fc2f-d7fc" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Un sólo uso. Si la unidad falla un chequeo de Animosidad, podrá activarse el estandarte para superar automáticamente el chequeo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Banderola de azalto" id="aa06-ef21-fa21-fe43" collective="false" hidden="false" import="true" page="0" type="upgrade">
