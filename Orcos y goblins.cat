      <rules>
        <rule name="Gorgut, kaudillo del Kolmillo Negro, y su chamán Skabnoze" id="7d54-bb72-7a77-e5c1" hidden="false">
          <description>Dos rebanadoras. Las heridas causadas por estas armas tienen la regla especial Heridas múltiples (1D3).</description>
        </rule>
        <rule name="Magia Skabnoze" id="5038-7765-cfe6-be2f" hidden="false">
          <description>Skabnoze es un hechicero de nivel 3 que siempre utiliza hechizos del Saber del Gran Waaaagh!</description>
        </rule>
        <rule name="Aztuto y traizionero (Gorgout)" id="5ee1-38d5-0bd3-4519" hidden="false">
          <description>Cualquier unidad de orcos a 12” o menos de Gorgut que falle un chequeo de Animosidad no debe tirar en la tabla: siempre se considera que obtienen un resultado de 6 (esto afecta a la propia unidad de Gorgut).</description>
        </rule>
        <rule name="Delirioz de grandeza (Skabnoze)" id="2e0e-9365-acaf-9eca" hidden="false">
          <description>Otorga una tirada de salvación especial de 5+ y la regla especial Resistencia mágica (1).</description>
        </rule>
        <rule name="Loz grandotez de Gorgut" id="0d3c-ce32-80fc-f20a" hidden="false">
          <description>La unidad de Orcos grandotes que debes incluir para incluir a Gorgut tendrán las reglas especiales Inmune a Miedo e Inmune a Pánico. Además de Gorgut, el único personaje que puede unirse a la unidad es Skabnoze.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="General del ejército" id="5bac-12f9-cae5-155e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
