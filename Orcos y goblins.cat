                  <profiles>
                    <profile name="Eztandarte zuertudo" id="9187-ab5d-6fb3-a977" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Proporciona una tirada de salvación especial de 5+ a Grom. Además, es un objeto portahechizos de nivel de energía 1D6+2. Contiene un hechizo de potenciación que afecta a todas las unidades amigas a 12” o menos del estandarte y Permanece un turno. Por la duración del conjuro, las unidades afectadas podrán repetir todos los resultados de 1 que obtengan en sus tiradas para impactar, herir y salvaciones por armadura.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
                <selectionEntry name="Arma de mano" id="86bf-3314-5757-691c" collective="false" hidden="false" import="true" type="upgrade">
