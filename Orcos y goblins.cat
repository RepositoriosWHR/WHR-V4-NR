          </costs>
          <profiles>
            <profile name="Eztandarte de piel de garrapato" id="e4aa-8c78-a732-fcab" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad puede repetir sus tiradas de carga fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Eztandarte de Borko" id="a519-e804-d4cd-d741" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
