                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Dos rebanadoras. Azhag puede repetir sus tiradas para impactar fallidas en combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
