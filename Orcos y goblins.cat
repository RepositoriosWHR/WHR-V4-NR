            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto verde de Morko" id="36ed-07ea-76bb-a594" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo hechiceros. Un sólo uso. Puedes utilizar el amuleto en lugar de realizar un intento de dispersión de hechizo con el portador. Tira 1D6: si obtienes un resultado de 3+, el hechizo será dispersado; sin embargo, si obtienes un resultado de 1-2, el hechizo no será dispersado y el portador sufrirá una herida sin tirada de salvación por armadura. Ten en cuenta que no puede utilizarse contra un hechizo lanzado con Fuerza irresistible ni contra un hechizo que Permanece en efecto y no fue lanzado ese turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
