                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Heridas múltiples (1D3)" id="95fd-4e3e-5468-9d19" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
                <infoLink name="Monstruo" id="23e2-9de4-0050-7275" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
                <infoLink name="Piel escamosa (2+)" id="3a86-ca74-214e-8d26" hidden="false" targetId="4c17-1353-fcdd-fe40" type="rule"/>
                <infoLink name="Tozudez" id="9d60-80ec-fa9c-19c5" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
