          </costs>
          <selectionEntries>
            <selectionEntry name="Bákulo murciélago" id="a098-ad17-fa16-7337" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="26b6-ade9-3946-a0ba" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="bc19-ed36-7f98-94b5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Bákulo murciélago" id="2ab0-122e-b095-a94a" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 1D6. Contiene un hechizo de Potenciación que puede lanzarse sobre una unidad amiga a 12” o menos de Skabnoze y Permanece un turno. Por la duración del conjuro, la unidad podrá repetir todas sus tiradas fallidas para impactar (tanto con disparos como en cuerpo a cuerpo).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
