              <profiles>
                <profile name="Bákulo zinieztro" id="09ab-90ab-c083-16e3" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos de nivel de energía 6. Contiene un hechizo de Proyectil mágico con un alcance de 24” que causa 1D3+1 impactos de Fuerza 5 con la regla especial Ataque de rayos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
