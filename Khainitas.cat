          </costs>
          <profiles>
            <profile name="Grito de Khaine" id="938b-6d19-6fef-8445" hidden="false" typeId="167b-a9e5-b3b4-f97e" typeName="Regalo de Khaine">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e33-fe4d-8468-4523">Puedes utilizar el Grito de Khaine al comienzo cada primera ronda de combate cuerpo a cuerpo en la que el portador participe. Las unidades enemigas en contacto peana con peana deberán realizar un chequeo de liderazgo con un penalizador igual a la diferencia del bonificador de filas a favor de la unidad del portador. La unidad que falle el chequeo sufrirá un penalizador de -1 a la HA y a la I durante esa fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Venenos" id="7160-4a90-f52e-81be" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Matahombres" id="d621-ea1b-ff82-a21d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6b40-1e5c-6f2a-0567" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="50cc-7b22-54f2-0a5c" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Matahombres" id="94fb-f044-5824-dfb5" hidden="false" typeId="acf8-956b-9215-e3ad" typeName="Veneno">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6ed6-6bfe-e7fa-9546">El portador obtiene la regla especial Ataques envenenados. Siempre hiere con un resultado de 2+ en sus tiradas para herir, sin importar la resistencia del objetivo. No afecta a miniaturas Inmunes a veneno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Veneno Negro" id="0458-8eb8-63cd-5265" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3b3e-9ee2-60e2-0f32" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="6b42-b0ac-97db-5708" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
            <infoLink name="Heridas múltiples (1D3)" id="9312-ba1b-9e7d-a00d" hidden="false" targetId="efc4-703c-5d20-0686" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Ataques envenenados)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Veneno Negro" id="3ffe-581b-f65b-839e" hidden="false" typeId="acf8-956b-9215-e3ad" typeName="Veneno">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6ed6-6bfe-e7fa-9546">El portador obtiene la regla especial Ataques envenenados. Los resultados de 6 en la tirada para impactar (es decir, los ataques que hieren de forma automática) tienen la regla especial Heridas múltiples (1D3). No afecta a miniaturas Inmunes a veneno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Loto de Naggarond" id="e335-068a-7857-a4a7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7221-1645-c1c5-77a4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="a89b-a226-dbc4-18e9" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Loto de Naggarond" id="a574-da74-1314-a56a" hidden="false" typeId="acf8-956b-9215-e3ad" typeName="Veneno">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6ed6-6bfe-e7fa-9546">El portador obtiene la regla especial Ataques envenenados. Los resultados naturales de 5 también se considerarán Ataques envenenados y herirán automáticamente. No afecta a miniaturas Inmunes a veneno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Aliento de Hidra" id="e059-d019-6577-7908" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2f2d-cee4-b856-723e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="ca03-ad08-e035-7f50" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Aliento de Hidra" id="a9ea-ba89-566d-0436" hidden="false" typeId="acf8-956b-9215-e3ad" typeName="Veneno">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6ed6-6bfe-e7fa-9546">El portador obtiene la regla especial Ataques envenenados. Los impactos que hieren automáticamente a causa de la regla especial Ataques envenenados aplicarán un penalizador de -2 a la tirada de salvación por armadura (adicionalmente a los penalizadores por la Fuerza del ataque u otras circunstancias). No afecta a miniaturas Inmunes a veneno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
