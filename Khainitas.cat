              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Señor de los verdugos" id="3926-7afb-e589-2c2e" hidden="false" typeId="b1c0-dfa2-401c-8ec1" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="4e6a-99f8-19e5-8fa7">Sólo Príncipe de Khaine o Capitán Khainita. El personaje obtiene la regla especial Golpe letal (en sus ataques en combate cuerpo a cuerpo). Sin embargo, tan sólo puede equiparse con un Arma a dos manos (mundana o mágica) y no puede elegir ninguna montura. Si se une a una unidad de Verdugos, tanto el personaje como los Verdugos no perderán su Furia asesina si son derrotados en combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
