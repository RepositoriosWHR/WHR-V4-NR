    <selectionEntry name="Avatar de Khaine" id="0209-4c36-d367-4ae0" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="627d-2018-9124-e524" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
