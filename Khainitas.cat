              <infoLinks>
                <infoLink name="Arma de mano" id="5877-56a9-fa15-2935" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Espada de la Muerte" id="b84f-61a6-8ac8-8f0e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques efectuados con esta espada se resolverán con F10.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Espada Defensora" id="5188-630c-25b1-00e5" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5846-91c0-60b3-a173" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="3246-2ace-be95-858f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Arma de mano" id="f9d5-9f21-d6de-54af" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Espada Defensora" id="f8f1-4a45-7e72-f14a" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al inicio de cada fase de Combate (tuya o del oponente), elige una miniatura enemiga en contacto con el portador de esta Espada, dicha miniatura verá reducido su atributo de ataques en 1 hasta el final de la fase.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Amuleto infernal" id="439b-8317-0717-9eed" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cc58-58f9-4d36-888e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2a2a-f52b-a0d2-b8d9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Resistencia mágica (3)" id="686d-f9ed-36d1-18aa" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Amuleto infernal" id="8432-c73b-4edb-a14f" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Confiere a Hellebron la regla especial Resistencia mágica (3). Si un hechizo enemigo es dispersado utilizando los dados de dispersión otorgados por este Talismán, el lanzador sufrirá una herida automática sin posibilidad de tirada de salvación por armadura. Si el hechizo dispersado había sido lanzado utilizando un Objeto portahechizos, dicho objeto será destruido y no podrá volver a utilizarse en toda la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Poción bruja" id="323a-f0a2-8206-93ba" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fece-625e-a7cf-b2fb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="b6c2-bb12-b2dc-beec" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Impactos múltiples (2)" id="fe3a-d9ef-daa3-bf27" hidden="false" targetId="70e6-5c37-39bf-ab8d" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Poción bruja" id="609d-72c7-e432-3fb2" hidden="false" typeId="167b-a9e5-b3b4-f97e" typeName="Regalo de Khaine">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="9e33-fe4d-8468-4523">Un solo uso. Puedes declarar que utilizas la Poción Bruja al inicio de cualquier fase de combate cuerpo a cuerpo. El portador obtiene la regla especial Impactos múltiples (2) hasta el final de esa fase de combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Runa de Khaine" id="2a09-eea8-fcda-dae9" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5c3e-758b-7634-16c8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="b221-b805-aa17-105b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Runa de Khaine" id="3875-3a97-cf67-d9b7" hidden="false" typeId="167b-a9e5-b3b4-f97e" typeName="Regalo de Khaine">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="9e33-fe4d-8468-4523">El portador obtiene 1D3 ataques adicionales durante la fase de combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Grito de Khaine" id="7591-7358-1361-f54b" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="a08b-ea97-7e87-1ad1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="4369-92f6-d953-bde2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Grito de Khaine" id="1728-600d-b771-0336" hidden="false" typeId="167b-a9e5-b3b4-f97e" typeName="Regalo de Khaine">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="9e33-fe4d-8468-4523">Puedes utilizar el Grito de Khaine al comienzo cada primera ronda de combate cuerpo a cuerpo en la que el portador participe. Las unidades enemigas en contacto peana con peana deberán realizar un chequeo de liderazgo con un penalizador igual a la diferencia del bonificador de filas a favor de la unidad del portador. La unidad que falle el chequeo sufrirá un penalizador de -1 a la HA y a la I durante esa fase de combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
