              <profiles>
                <profile name="El Primer Draich" id="bd75-2a0b-efad-a627" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. No aplica el penalizador habitual de reducir la iniciativa a la mitad (por la regla especial Lenta). Al comienzo de cada ronda de combate puedes decidir que tus ataques se resuelvan con la regla especial Golpe letal heroico y la regla especial Lenta.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
