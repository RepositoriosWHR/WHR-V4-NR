              <profiles>
                <profile name="Veneno Negro" id="4148-e4a7-9438-3d94" hidden="false" typeId="acf8-956b-9215-e3ad" typeName="Veneno">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6ed6-6bfe-e7fa-9546">El portador obtiene la regla especial Ataques envenenados. Los resultados de 6 en la tirada para impactar (es decir, los ataques que hieren de forma automática) tienen la regla especial Heridas múltiples (1D3). No afecta a miniaturas Inmunes a veneno.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
