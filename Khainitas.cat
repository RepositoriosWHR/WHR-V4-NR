            <profile name="Filos de muerte" id="d984-bbd1-e456-1580" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Proporcionan a su portador +1 Ataque (adicionalmente al ataque adicional por ser armas emparejadas), y sus impactos se resuelven con +1F.</characteristic>
