                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="9e33-fe4d-8468-4523">El personaje obtiene la regla especial Golpe letal en sus ataques en cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Mano de Khaine" id="6ee6-c2d1-8905-2141" collective="false" hidden="false" import="true" type="upgrade">
