            <infoLink name="Resistencia mágica (3)" id="b86d-507a-6b46-5c13" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Collar de Khaine" id="6dfe-3f25-0f6a-81fa" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador obtiene la regla especial Resistencia mágica (3): Además, todas las armas mágicas de los enemigos que ataquen al portador se considerarán armas mundanas de su mismo tipo al atacar al portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
