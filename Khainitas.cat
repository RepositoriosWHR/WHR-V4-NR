        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <rules>
        <rule name="Regente de Har Ganeth" id="c51c-153c-b7f9-b002" hidden="false">
          <description>Si Hellebron es el General del ejército, podrás incluir una unidad de Verdugos de Har Ganeth como Unidad básica en un ejército; a menos que sea una Gran batalla (3000 puntos o más), en cuyo caso podrás incluir hasta 2 unidades de Verdugos de Har Ganeth como Unidad básica; en el caso una Batalla gigantesca (5000 puntos o más), podrás incluir hasta 3 unidades de Verdugos de Har Ganeth como Unidad básica. Adicionalmente, una unidad de Verdugos de Har Ganeth puede aumentar en +1 sus atributos de Ataques y Habilidad de armas por +3 puntos por miniatura.</description>
        </rule>
      </rules>
    </selectionEntry>
