      <rules>
        <rule name="Crecimiento mutante" id="c28c-3483-a0b4-69a2" hidden="false">
          <description>Al final de cualquier fase en la que la hidra haya regenerado exitosamente dos o más heridas, tira 1D6: con un resultado de 4+, a la hidra le brotará una nueva cabeza, y obtendrá un modificador permanente de +1 a sus atributos de Heridas y Ataques.</description>
        </rule>
        <rule name="Aliento de Hidra" id="3d05-3663-5c1a-c5bf" hidden="false">
          <description>Suma +1 a la Fuerza del arma de aliento de la Hidra por cada dos 
cabezas nuevas que broten (debido a la regla Crecimiento mutante).</description>
        </rule>
      </rules>
