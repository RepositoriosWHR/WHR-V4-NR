          </entryLinks>
          <profiles>
            <profile name="Colgante de Khaeleth" id="ed62-eff6-60bd-9422" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador una tirada de salvación especial de 5+, la cual pasa a ser una tirada de salvación especial de 4+ contra los ataques de F5 y una tirada de salvación especial de 3+ contra los ataques de F6 o superior.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Collar de Khaine" id="3086-1b82-b4f9-cf57" collective="false" hidden="false" import="true" type="upgrade">
