    <selectionEntry name="[E] - Reina bruja Hellebron" id="84de-61b0-9c2f-0d16" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="6ae2-8876-6712-0cd7" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
