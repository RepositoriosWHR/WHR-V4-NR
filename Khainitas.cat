    <selectionEntry name="Regente de Har Ganeth" id="da1e-09c9-8c1e-b091" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="58e8-b0fd-5fab-a141" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
