                <infoLink name="Vanguardia" id="6331-1aba-ac92-eede" hidden="false" targetId="1bd0-0982-01a3-ed62" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Sombra solitaria" id="9f5c-6a5c-0cd0-f2fa" hidden="false" typeId="b1c0-dfa2-401c-8ec1" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="4e6a-99f8-19e5-8fa7">Korelei tiene las reglas especiales Esquivar (4+) y Veloz. Además, cualquier unidad que persiga a Korelei perderá la regla especial Veloz a efectos de dicha persecución. Adicionalmente, Korelei tiene Vanguardia, aunque su movimiento de Vanguardia debe ser siempre hacia el enemigo visible más cercano. Sin embargo, no puede unirse a unidades y no podrá ser la General del ejército. Esta senda es única y sólo Korelei la puede seguir.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
