            <profile name="Vara del brujo" id="737a-f6bd-bf20-e03a" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene un bonificador de +1 en sus tiradas de lanzamiento de hechizo; este bonificador se incrementa hasta +3 si está lanzando un hechizo de tipo Maldición. Además, el portador conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Las Siete llaves" id="f189-d16c-f299-95fb" collective="false" hidden="false" import="true" type="upgrade">
