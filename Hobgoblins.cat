    <selectionEntry name="[E] - Gran Hobgobla Ghazak Khan, unificador de las estepas" id="d977-fcf6-6e80-45a3" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="0c4f-c8fb-10bf-6d9b" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
