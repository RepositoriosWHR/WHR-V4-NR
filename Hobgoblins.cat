    <selectionEntry name="[E] - Gorduz el Traizionero, caudillo hobgoblin" id="e1bb-e722-53a4-17b0" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="65a0-433e-65f2-a4f0" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
