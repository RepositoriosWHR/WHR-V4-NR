          </infoLinks>
          <profiles>
            <profile name="Las Siete llaves" id="bc67-a5da-c09c-c0e8" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador podrá tomar sus hechizos del saber de Magia Oscura. Además, obtiene la regla especial Aura demoníaca 
(4+) y la clave demonios.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="32bc-03de-8c0d-4c6a" collective="false" hidden="false" import="true">
