              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga al portador Resistencia a la magia (3) contra hechizos del tipo Maldición y Daño directo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tatuajes demoníacos" id="3115-6fec-8224-7b5f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="389c-0174-29c9-6d34" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a878-f0bc-0dc0-e34e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
