        <entryLink name="Leyenda" id="298d-85ab-1f54-ecfc" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Caballería monstruosa" id="6d60-0777-5d98-1da1" hidden="false" targetId="a7be-2cd9-f3c6-b091" type="rule"/>
