              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador (y la unidad en la que se encuentre) obtienen Ataques envenenados. Si ya disponían de esta regla especial, sus Ataques envenenados herirán automáticamente también con resultados de 5 en sus tiradas para impactar, además de los resultados de 6 como es habitual.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
