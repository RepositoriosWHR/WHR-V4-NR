          </profiles>
        </selectionEntry>
        <selectionEntry name="Duelista consumado" id="70ff-5418-e0f9-1258" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0204-97c5-8e14-4df0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="0d7e-35fc-9898-501d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Duelista consumado" id="ad3d-07e7-a2fd-9299" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">El personaje obtiene un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo. Además, obtiene un bonificador de +1 adicional en sus tiradas para impactar en combate cuerpo a cuerpo siempre que se encuentre luchando en un desafío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Heraldo huidizo" id="14d8-9da4-a6fb-8a72" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="25de-c077-c8c6-d9b9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="87e3-9bb0-68e8-0ba0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Heraldo huidizo" id="0228-b464-d706-fae5" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Los estandartes de la unidad en la que se encuentre el personaje no podrán ser capturados a consecuencia de huir tras fallar un chequeo de desmoralización. Además, siempre que el personaje y su unidad se vean obligados a huir de un combate tras haber fallado un chequeo de desmoralización, tira 1D6: con un resultado de 4+, el enemigo no podrá perseguir al personaje y su unidad (tan solo podrá reformar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Arquero certero" id="4440-1c67-92e8-92f2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="febe-7fd3-7bf8-4413" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4ed5-b0b3-9644-44a1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Arquero certero" id="0091-62ff-e453-ece7" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">El personaje no aplicará el penalizador de -1 habitual por disparar a larga distancia ni por Aguantar y disparar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Adiestrador de perros" id="dccd-7500-0a43-7583" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e741-a78b-5893-909e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="7634-18d3-fb2e-4591" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Señor de las bestias" id="6a6f-35ae-5e49-7469" hidden="false" targetId="d9eb-5faf-54db-9b05" type="rule"/>
            <infoLink name="Caballería rápida" id="67ed-228b-610d-df06" hidden="false" targetId="0b7e-2a08-2b5a-51d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Adiestrador de perros" id="f196-e59a-5750-6bb0" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">El personaje obtiene M7, así como la regla especial Señor de las bestias (ver Sabuesos Hob) y sólo podrá unirse a unidades de Sabuesos Hob. El personaje y la unidad en la que sea desplegado al inicio de la partida obtienen la regla especial Caballería rápida. Además, todos los Grandes lobos y Huargos a 12” o menos del personaje podrán repetir los resultados de 1 en sus tiradas para impactar en combate cuerpo a cuerpo. Adicionalmente, dichas unidades podrán repetir sus chequeos de Pánico fallidos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Apuñalador preventivo" id="fe54-5333-7519-48b3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8bc1-79d7-ab8c-c016" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5607-55d9-1cf2-bf29" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Apuñalador preventivo" id="f618-7914-0ade-41a6" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Siempre que la unidad en la que se encuentre el personaje deba realizar una tirada en la tabla de Animosidad Hobgoblin, obtendrá de forma automática el resultado Asesinato sangriento (no tires en la tabla).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Reputaciones infames. Hechicero" id="b7c5-2ee0-42cc-5129" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Tejedor de vientos" id="98ba-4506-c8f3-4f9b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6b7e-8876-f670-251c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d724-cba1-a0e9-2620" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Tejedor de vientos" id="8be2-7b82-7cb6-2983" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Sólo personajes con la clave hechicero. El personaje obtiene un bonificador de +1 en sus tiradas para canalizar dados de energía y dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Arcanista de la ponzoña" id="6c34-769a-c95f-9ad0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3794-2635-ab43-dae3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d32e-2bac-4a5a-f97a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="1d60-2e33-46e3-8d16" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Arcanista de la ponzoña" id="43c6-665c-d1bc-9cc5" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Sólo personajes con la clave hechicero. El personaje y la unidad en la que sea desplegado al comienzo de la batalla obtienen la regla especial Ataques envenenados (este efecto no se aplica a otros personajes que hayan sido desplegados en la misma unidad).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Conocimientos corruptos" id="ff57-b379-3987-37a2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e9a9-03fb-b2fa-4724" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d40c-db0b-cd3b-f217" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Conocimientos corruptos" id="ba3e-d597-0cc9-9e8b" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Sólo personajes con la clave hechicero. El hechicero conocerá un hechizo adicional y podrá combinar sus hechizos de entre todos los saberes que puede conocer. Sin embargo, siempre que se vea obligado a realizar una tirada en la tabla de Disfunciones mágicas, deberá tirar 3D6 y descartar el dado que elija el oponente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Reputaciones infames. Asesino hobgoblin" id="2431-0dd5-82c1-93f8" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Apuñalador astuto" id="2fe6-c813-a349-1b9a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="49fd-f0d5-10ca-4cf3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="bcf5-7f01-81b6-0290" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Apuñalador astuto" id="eabb-89b1-ed29-8b3f" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Sólo Asesino hobgoblin. El personaje podrá repetir todas sus tiradas fallidas para impactar y para herir (tanto en combate cuerpo a cuerpo como con proyectiles) durante el turno en el que es revelado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Reputaciones infames. No infantería" id="df40-e27d-a3f7-d1dc" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Jinete estepario" id="90f4-44b0-1488-d94e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3084-e544-6ccd-bd13" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="e12e-7773-95b4-fd9f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Jinete estepario" id="403c-ff71-460b-daa2" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Sólo personajes con montura. El personaje y su unidad pueden sumar o restar 1D3” a todos sus movimientos de huida; puede realizar esta tirada tras conocer el resultado total del movimiento de huida.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cabalgador temerario" id="a0a9-ea8b-add4-82e8" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6788-6e96-ea4f-3efa" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d4cd-54af-f083-f26d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cabalgador temerario" id="b928-ebf9-fe3d-4651" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Sólo personajes con montura. El personaje y la unidad a la que esté unido con la regla especial Veloz podrán repetir todas sus tiradas fallidas para cargar, huir y perseguir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
