          <conditions>
            <condition childId="046a-1c36-705e-1c0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Grito de guerra de las estepas (Gran hobgobla)" id="3a2f-ded2-7398-2232" hidden="false">
          <description>Si Ghazak Khan (o la unidad en la que se encuentre) declaran una carga, la unidad que recibe la carga no podrá declarar ninguna reacción a la carga (salvo Mantener la posición).</description>
        </rule>
        <rule name="Es el lider (Gran hobgobla)" id="c934-d14b-4572-ff2b" hidden="false">
          <description>El Gran Hobgobla Ghazak Khan debe ser el general del ejército. Además, al inicio de la batalla obtendrá un bonificador de +1 a su Liderazgo. Este bonificador se pierde inmediatamente si el Gran Hobgobla Ghazak Khan huye a causa de un chequeo fallido de Terror o desmoralización.</description>
        </rule>
        <rule name="Gran señor de la horda oriental" id="680e-5886-2f9a-32f9" hidden="false">
          <description>Si Ghazak Khan es el general del ejército, puedes incluir hasta una unidad de Jinetes de lobo Veteranos como opción de Unidad básica, hasta una unidad de Hobyars como opción de Unidad especial y hasta una unidad de Jinetes de Huargos como opción de Unidad Especial.</description>
        </rule>
        <rule name="General del jagún" id="0e3b-fb93-d0e7-d27e" hidden="false">
          <description>El radio de Presencia inspiradora del Gran Hobgobla Ghazak Khan aumenta a 18”.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Gran Hobgobla Ghazak Khan" id="3cec-7914-de64-ff1b" collective="false" hidden="false" import="true" type="model">
