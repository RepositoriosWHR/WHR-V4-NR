    <selectionEntry name="[Ex] - Bestia del cieno" id="05a2-3515-2bb0-80cf" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="818a-ff1c-d8f7-e0e1" hidden="false" primary="false" targetId="6645-bf03-34e3-e081"/>
      </categoryLinks>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
