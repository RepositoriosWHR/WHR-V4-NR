    <selectionEntry name="[Ex] - Emisario oscuro" id="f775-28c4-95b0-255f" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="7523-c015-3582-6578" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="8fb0-c6ba-85a8-2027" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
