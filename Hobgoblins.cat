        <constraint id="0c43-fd44-d808-932c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Mano de mono" id="96dc-85f8-5fbd-88a4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a2fa-0bfb-3408-cfc8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a3f6-c286-1cff-6e93" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Mano de mono" id="7e16-3b92-9216-8010" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo cinco usos. El portador puede repetir una tirada de dado para impactar, herir, salvaciones de armadura, chequeos de atributo, lanzar o dispersar hechizos y canalizar dados de energía o dispersión. Sin embargo, el portador sufrirá un impacto de F4 que niega la tirada de salvación por armadura por cada resultado de 1 obtenido en la repetición.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Flauta quiebrahuesos" id="4b4c-6d34-9795-aacd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bea5-3675-ac1b-20dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="88cd-a8e6-42f1-0ae5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Flauta quiebrahuesos" id="27fb-0ffb-8cfb-0d7f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de Maldición que afecta a todas las unidades enemigas a 12” o menos del portador. Cada unidad afectada sufrirá inmediatamente 1D6 impactos de F3 que no permiten tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gorro del Khan" id="b37a-577b-c975-c412" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0849-e92c-3d9c-7925" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4aff-612e-8f2e-f3e3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="4259-b713-395a-5c19" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Gorro del Khan" id="aaf3-a0f4-7252-8829" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador es Inmune a la psicología. Además, cualquier unidad en la que se encuentre el personaje podrá repetir sus tiradas de Animosidad hobgoblin.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Dados trucados" id="2fa3-5dd7-cc8a-5147" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f515-1991-fb2d-88b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3eb9-9f42-9176-e403" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
