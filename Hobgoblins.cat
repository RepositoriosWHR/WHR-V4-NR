            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Dados trucados" id="758c-7f5d-229d-f4db" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse antes de realizar una tirada para impactar, herir, tirada de salvación (por armadura o especial) o chequeo de atributo (incluyendo de Liderazgo). Puedes decidir el resultado de un único dado de esa tirada en lugar de tirar el dado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
