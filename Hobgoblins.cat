      <selectionEntries>
        <selectionEntry name="Emblema de la traición" id="c2c5-eb84-67c0-a826" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="71c6-8ead-5f40-5051" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="fd14-955c-9b1e-eeee" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="176c-eea4-9e81-0c72" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Emblema de la traición" id="061d-3763-9d6c-35ad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo General del ejército. Proporciona a su portador una tirada de salvación especial de 4+ que no puede ser empleada contra heridas causadas por miniaturas con la regla especial Desprecio. Además, todas las unidades amigas dentro del radio de alcance de su Presencia inspiradora sumarán +1 en sus tiradas en la tabla de Animosidad Hobgoblin (los resultados superiores a 6 se considerarán 6). Sin embargo, los Orcos y Goblins (de cualquier tipo) pueden repetir sus tiradas fallidas para impactar contra el portador (tanto en proyectiles como en combate cuerpo a cuerpo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Reputaciones infames. General" id="460d-5c9f-1e33-21c7" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Carnicero sin escrúpulos" id="de1a-2819-e38c-be84" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="29ca-6c55-650d-8aea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4e0d-c6e1-6c4e-1e84" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Carnicero sin escrúpulos" id="b1b8-8606-f7e6-9fbd" hidden="false" typeId="b491-b22c-9054-ca3f" typeName="Reputación infame">
              <characteristics>
                <characteristic name="Reglas Especiales" typeId="894a-d606-b632-546e">Sólo General del ejército. El rango de la regla especial Presencia inspiradora del personaje aumenta en 3”. Sin embargo, al inicio de la batalla, tras el despliegue, tira 1D6 por todas tus unidades presentes en el campo de batalla. Con un resultado de 1, la unidad sufrirá una herida sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Reputaciones infames." id="6346-0494-9fae-02d0" collective="false" hidden="false" import="true">
