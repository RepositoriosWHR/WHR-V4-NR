          <conditions>
            <condition childId="7d42-b95c-8afa-0066" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Sádico" id="7170-3a9b-58ff-915c" hidden="false">
          <description>El carruaje de Ogloth puede tirar 2D6 y escoger el mayor de ellos para determinar el número de Impactos por carga que causa.</description>
        </rule>
        <rule name="Despojadores de las tierras Yermas" id="721f-35c3-8233-c909" hidden="false">
          <description>Si incluyes a Ogloth Khan debes incluir una unidad de Carruajes de guerra hobgoblin (los Despojadores de las Tierras Yermas) y convertir uno de ellos en Carro de mando. Ogloth deberá unirse a esa unidad, y no podrá abandonarla. El Carro de mando está equipado con la Banderola polvorienta</description>
        </rule>
      </rules>
