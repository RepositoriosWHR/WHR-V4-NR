              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">La unidad del portador podrá repetir sus tiradas fallidas para impactar y herir en combate cuerpo a cuerpo si están atacando a una unidad enemiga por el flanco o la retaguardia. Sin embargo, considerará todos sus resultados de 3 en la tabla de Animosidad hobgoblin como resultados de 1-2.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bandera de la muerte" id="d4b3-1965-2a96-4924" collective="false" hidden="false" import="true" page="0" type="upgrade">
