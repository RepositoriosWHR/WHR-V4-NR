    <selectionEntryGroup name="Objetos hechizados. Reliquias. Hobgoblins. General" id="a52a-9ec5-f560-c2a3" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="415d-8f21-aed7-bf82" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="3fa4-bc70-1fef-1b49" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
