            <profile name="Reputación de carnicero" id="515f-7c5c-a5e0-2b88" hidden="false" typeId="1811-12ee-8ca2-f9ec" typeName="Habilidad de matador">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">El personaje (y la unidad en la que se encuentre) causarán Miedo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fortuna" id="b6e7-ecc1-4e9e-3aa1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
