          <profiles>
            <profile name="Runa de la rapidez" id="4f7d-7872-4350-087c" hidden="false" typeId="d9f2-57ea-90f4-d594" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">El portador verá su iniciativa aumentada hasta 10 en combate cuerpo a cuerpo (su Iniciativa siempre será 10 y no podrá ser modificada por ningún efecto, además de por carga o las reglas especiales Ataque rápido ni Lenta).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
