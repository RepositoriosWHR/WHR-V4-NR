          </entryLinks>
          <profiles>
            <profile name="Runa magistral del desafío" id="9146-fe93-dbd7-8611" hidden="false" typeId="6196-246d-af80-3e34" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a2c8-eec3-abbb-4fe1">Si el portador lanza un Desafío, el oponente deberá aceptarlo obligatoriamente si le es posible.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
