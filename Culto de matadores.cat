        <infoLink name="¡Mira, Snorri! ¡Trolls!" id="6f74-fa3b-2724-2a69" hidden="false" targetId="f2e7-7352-8f96-bf16" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="cf4e-5953-5113-bdf1" type="set" value="3">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="cf4e-5953-5113-bdf1" type="set" value="4">
          <conditions>
            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Conociendo al enemigo" id="2aea-f7a3-dea9-8fc1" hidden="false">
          <description>Cuando la unidad se enfrente contra cualquier Gigante y éste tenga que tirar en la tabla, el jugador enano podrá forzar al oponente a repetir la tirada en la tabla de ataques especiales del gigante, pero si lo hace se quedará con el segundo resultado.</description>
        </rule>
        <rule name="Más dura será la caída" id="ad23-b272-1cd4-7e95" hidden="false">
          <description>Los Matagigantes y Matatitanes tienen un bonificador de +1 en sus tiradas para impactar contra miniaturas del tipo Carro, Bestia monstruosa, Caballería monstruosa y Monstruos (hasta un máximo de 3+). Adicionalmente, podrán repetir sus tiradas fallidas para impactar contra Monstruos. Sin embargo, tendrán un penalizador de -1 en sus tiradas para impactar contra miniaturas de tipo Enjambre.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Matagigantes" id="88f8-41f0-7b32-e420" collective="false" hidden="false" import="true" type="model">
          <constraints>
