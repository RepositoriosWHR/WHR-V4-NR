              <characteristics>
                <characteristic name="Reglas especiales" typeId="a2c8-eec3-abbb-4fe1">Al comienzo de cada turno enano, todas las unidades enemigas a 18” o menos del portador deberán revelar todas sus opciones ocultas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa de la suerte" id="068e-9285-bcb1-6aa4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
