        <infoLink name="Matadores" id="e9d1-15c6-1067-0f6d" hidden="false" targetId="e0b7-dce4-8ec0-c6fc" type="rule"/>
        <infoLink name="¡Mira, Snorri! ¡Trolls!" id="cf12-2835-feac-4fd4" hidden="false" targetId="f2e7-7352-8f96-bf16" type="rule"/>
        <infoLink name="Impactos por carga (1)" id="5bcf-b46f-1c59-dcd7" hidden="false" targetId="8de0-8a91-edee-076e" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Choque de escudos" id="37a7-ea67-c6b7-d0ea" hidden="false">
          <description>Los Rompescudos consideran el Escudo de Gromril como Arma de mano adicional además de como Escudo. Además, tienen la regla especial Impactos por carga (1).</description>
        </rule>
        <rule name="Muro de escudos" id="60a2-44bb-18c6-eaa3" hidden="false">
          <description>Siempre pueden reformar al final de cada combate, aunque pierdan el combate. Además, cada vez que una unidad de Rompescudos sufra Impactos por carga de un enemigo realizada hacia su frontal, la unidad que los causó sufrirá un impacto de F4 por cada miniatura en el frontal de los Escudos de guerra, el cual se resolverá con la regla especial Poder de penetración si los Escudos de la unidad llevan Púas.</description>
        </rule>
      </rules>
