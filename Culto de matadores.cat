              <profiles>
                <profile name="Hacha certera" id="de12-c2e1-42bc-f54f" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Hachas de matador. Tienen grabadas una Runa magistral del vuelo y una Runa de la agonía.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
                <selectionEntry name="Runas Hacha certera" id="23f6-f2b8-554d-7233" collective="false" hidden="false" import="true" type="upgrade">
