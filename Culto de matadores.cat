    <selectionEntry name="[E] - Matadores piratas de Drong" id="1a86-606d-6bfc-0f95" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="4a53-9a0b-0af4-5b05" hidden="false" primary="true" targetId="5370656369616c23232344415441232323"/>
      </categoryLinks>
