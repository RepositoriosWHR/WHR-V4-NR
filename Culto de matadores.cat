              <profiles>
                <profile name="Tatuajes del herrero" id="a6c9-6c98-c82f-bd59" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Los tatuajes tienen grabados la Runa magistral del equilibrio y una Runa rompehechizos. Además, los tatuajes proporcionan a Grunok la regla especial Resistencia mágica (3).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
