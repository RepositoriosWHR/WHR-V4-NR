              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">Todas las tiradas para herir contra el portador fallarán si se obtiene un resultado de 1, 2 ó 3 en la tirada; esto no afecta a ataques sin valor de Fuerza o que hieran automáticamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ímpetu de batalla" id="15c1-03ed-af99-e118" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="850a-7bca-d2c0-d0fd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e6fc-5cfe-264f-5440" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Ímpetu de batalla" id="b5c0-f3b6-40b7-0e53" hidden="false" typeId="1811-12ee-8ca2-f9ec" typeName="Habilidad de matador">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">Un solo uso. En la sub-fase de inicio del turno, el matador puede utilizar su ímpetu de batalla. Esto hace que él y la unidad en la que se encuentre pueda realizar un movimiento adicional (el cual puede utilizarse para mover o marchar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Grito de guerra" id="a203-f66f-1618-0c2e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d7eb-4a6c-2153-d0ee" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0fca-53f6-9074-6971" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
