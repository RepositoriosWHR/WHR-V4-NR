              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">El personaje obtiene un bonificador a su número de Ataques igual al número de filas de la unidad a la que se esté enfrentando (si hay varias, utiliza el mayor).</characteristic>
              </characteristics>
            </profile>
