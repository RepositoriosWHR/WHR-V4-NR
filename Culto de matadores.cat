            <profile name="Puntería certera" id="0403-c8e1-a5ec-d835" hidden="false" typeId="1811-12ee-8ca2-f9ec" typeName="Habilidad de matador">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">Sólo personajes equipados con Hachas arrojadizas o Skeggox. Los disparos del personaje tienen las reglas especiales Disparos múltiples (X), donde X es igual al número de Ataques del personaje. Además, sus impactos se resuelven con la regla especial Golpe 
letal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos rúnicos legendarios" id="4a7a-659a-3150-03c2" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Amuleto del trueno" id="12b7-bc10-6754-d0ea" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="728a-c933-a5d4-6952" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="560b-91de-9454-fe92" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto del trueno" id="4a8a-b49f-1bff-0b89" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puede utilizarse al inicio de cualquier turno del Culto de los Matadores. Todas las unidades enemigas que se encuentren volando o flotando sufren inmediatamente 1D6 impactos de F6 con la regla especial Ataque de rayos. Además, deberán aterrizar inmediatamente y no podrán hacer uso de las reglas especiales Volar y Flotar hasta elinicio del siguiente turno de los matadores.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Capa de piel de orco" id="8e59-b17a-83bf-d58c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7eb5-687e-df09-40a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4c7a-d7d5-726a-2beb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Terror" id="819f-3e1f-0a72-93d0" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Pielesverdes)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Capa de piel de orco" id="caa1-a08f-481c-07f8" hidden="false" typeId="2a98-4f64-4856-94ee" typeName="Objeto rúnico legendario">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a37-0ce6-77a0-688c">El portador causa Terror a unidades con la clave pielesverdes, y tendrán un penalizador de -1 en sus tiradas para impactar en combate cuerpo a cuerpo contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Barril de cerveza rúnico" id="c953-a565-ccff-9ebb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="be0d-8f60-3f1e-28c5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="eedc-696d-fba0-e39e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (4+)" id="7447-23b7-7668-45f7" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
            <infoLink name="Inflamable" id="703a-626c-57d4-e93b" hidden="false" targetId="93e4-15ce-63a5-ad92" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Barril de cerveza rúnico" id="0ea2-9586-fcaa-ed3c" hidden="false" typeId="2a98-4f64-4856-94ee" typeName="Objeto rúnico legendario">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a37-0ce6-77a0-688c">El portador obtiene las reglas especiales Regeneración (4+) e Inflamable, y le otorga Regeneración (6+) a la unidad que sea designado al comienzo de la batalla. Sin embargo, no podrá abandonar la unidad ni tener Ataques flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Runas de armas (Hachas de matador, armas de mano)" id="0b9d-0e1d-d14a-b679" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="6172-cbee-06d5-0ada" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
        <constraint id="4458-d972-3105-c414" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Runa de la furia" id="332f-d6e7-5475-ad57" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dfb1-a0e5-eca5-1a37" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="3"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Runa de la furia" id="3f4c-60b7-02e2-b3bb" hidden="false" typeId="d9f2-57ea-90f4-d594" typeName="Runa de armas">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">Al atacar con el arma, el personaje obtiene +1 Ataque (este bonificador se acumula con varias runas iguales).</characteristic>
              </characteristics>
            </profile>
