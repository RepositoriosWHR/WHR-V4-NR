    <selectionEntryGroup name="Habilidades de matador. Matadragones" id="2116-53ee-4687-a062" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Matador pirata" id="dd2d-e5c4-afe0-faa0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cabe-68e8-a2b0-723e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b9ea-3162-092b-e4fe" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ristra de pistolas enanas (disparo)" id="a8f3-7b40-51c7-ebcd" hidden="false" targetId="9708-e677-28db-5d99" type="profile"/>
            <infoLink name="Ristra de pistolas enanas (combate)" id="a841-f265-6f6b-3b11" hidden="false" targetId="afd7-3bee-51b1-665f" type="profile"/>
            <infoLink name="¡Mucha pólvora!" id="c5ad-42ca-13f5-9c55" hidden="false" targetId="7d5d-5d76-3b73-ca6f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Matador pirata" id="c074-4dff-8709-1b78" hidden="false" typeId="1811-12ee-8ca2-f9ec" typeName="Habilidad de matador">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">Solo Matadragones. El personaje sustituye sus hachas de matador por Ristras de pistolas, sólo podrá unirse a una unidad de Matadores piratas y obtendrá la regla especial ¡Mucha pólvora!. Además, tanto el personaje como cualquier unidad de matadores piratas a la que se unan podrán repetir sus resultados de 1 en sus tiradas para impactar, tanto disparando como en combate 
cuerpo a cuerpo. Adicionalmente, obtiene la opción de equiparse con una Pistola de Bucanero (+15 puntos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Pistola de bucanero" id="b3b2-e506-dcc8-e677" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3be4-59cd-7b1f-2f91" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="15"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Pistola de bucanero" id="8e99-c467-a553-6cf0" hidden="false" targetId="5a43-09da-517b-a720" type="profile"/>
                <infoLink name="Arma de aliento" id="18c6-6c8e-60b5-fb81" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(F4)"/>
                  </modifiers>
                </infoLink>
                <infoLink name="Poder de penetración" id="3aa1-95bd-bfef-9a66" hidden="false" targetId="29d3-6624-40c6-885f" type="rule">
                  <modifiers>
