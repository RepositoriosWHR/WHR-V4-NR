                        <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">Los ataques con el arma obtienen la regla especial Heridas múltiples (1D6).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la furia" id="b62f-498f-662c-c1eb" hidden="false" typeId="d9f2-57ea-90f4-d594" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">Al atacar con el arma, el personaje obtiene +1 Ataque (este bonificador se acumula con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la fuerza" id="535b-d8d2-5d0d-3a08" hidden="false" typeId="d9f2-57ea-90f4-d594" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">Los impactos con el arma se resuelven con un bonificador de +1 a la Fuerza (este bonificador se acumula con varias runas iguales).</characteristic>
