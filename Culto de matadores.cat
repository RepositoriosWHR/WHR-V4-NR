              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">El personaje y la unidad en la que sea desplegado al inicio de la batalla obtienen la regla especial Odio (todos los enemigos).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Piel de gromril" id="ae4a-31e5-9ce4-939f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="95c3-3dff-87fa-5d97" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5188-9d51-ee11-a049" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
