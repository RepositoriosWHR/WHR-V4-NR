          <infoLinks>
            <infoLink name="Furia asesina" id="b05b-0887-5e6d-6feb" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Grito de guerra" id="3425-44d7-d376-6357" hidden="false" typeId="1811-12ee-8ca2-f9ec" typeName="Habilidad de matador">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">Un solo uso. El jugador enano puede decidir en cualquier momento lanzar un grito de guerra. El personaje y la unidad obtienen la regla especial Furia asesina hasta que pierdan un combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Reflejos asombrosos" id="2ccf-d889-a2b6-306e" collective="false" hidden="false" import="true" type="upgrade">
