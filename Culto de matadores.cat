    <selectionEntry name="[E] - Malakai Makaisson y el cercenagoblins" id="ad31-bfa4-3f3f-ee9f" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="b3e5-900d-1126-2a77" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
