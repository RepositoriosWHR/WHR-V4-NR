              <characteristics>
                <characteristic name="Reglas especiales" typeId="a2c8-eec3-abbb-4fe1">Un solo uso. Una vez por batalla, otorga a su portador una tirada de salvación especial de 2+ contra una única herida que sufra.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
