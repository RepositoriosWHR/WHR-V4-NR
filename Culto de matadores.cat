      <rules>
        <rule name="Paladín de guerra" id="a72d-6f50-abf2-9aab" hidden="false">
          <description>Garagrim posee una tirada de salvación especial de 2+, que no puede utilizar en ninguna fase de combate cuerpo a cuerpo.</description>
        </rule>
        <rule name="Buscando la muerte" id="1c4d-7b80-2111-3c12" hidden="false">
          <description>Garagrim y cualquier unidad de Matadores a la que se una al comienzo de la batalla mejoran la regla ‘’¡Mira, Snorri, trolls!’’ a 2D6+3’’.</description>
        </rule>
      </rules>
