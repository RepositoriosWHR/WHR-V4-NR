      <selectionEntries>
        <selectionEntry name="Runa magistral del desaliento" id="817c-81f8-037a-41bc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3989-f1de-68fa-0834" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
