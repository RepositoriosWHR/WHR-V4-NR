                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">Los ataques con el arma tienen un bonificador de +1 para impactar en cuerpo a cuerpo (este bonificador se acumula con varias runas iguales).</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa magistral de la destrucción" id="5c90-3711-9e5a-e656" hidden="false" typeId="d9f2-57ea-90f4-d594" typeName="Runa de armas">
