          <entryLinks>
            <entryLink name="Reliquia" id="8c23-6798-1abc-ace5" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Objeto legendario" id="62b2-6c9d-38d6-7c8b" hidden="false" targetId="1eb5-f5b5-0dbe-0f2e" type="profile"/>
          </infoLinks>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="046a-1c36-705e-1c0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Cuerno rúnico de Karak Kadrin" id="e50e-ea50-ddd0-dd1a" hidden="false" typeId="2a98-4f64-4856-94ee" typeName="Objeto rúnico legendario">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="3a37-0ce6-77a0-688c">Solo general del ejército. Un solo uso. Puede utilizarse al inicio de cualquier fase de disparo del Culto de los Matadores. Todas las unidades de Infantería del ejército podrán realizar un movimiento adicional (movimiento, marcha o carga) fuera de la secuencia habitual de juego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
</catalogue>
