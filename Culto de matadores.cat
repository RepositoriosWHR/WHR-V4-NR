                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="a2c8-eec3-abbb-4fe1">Robas un dado de Energía al oponente al inicio de cada fase de magia enemiga, que añades a tu reserva de dados de Dispersión.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa rompehechizos" id="7bc5-f5c1-58fc-fef7" hidden="false" typeId="6196-246d-af80-3e34" typeName="Runa talismánica">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="a2c8-eec3-abbb-4fe1">Sólo Forjador rúnico. Un sólo uso. Dispersa un hechizo automáticamente.</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
