      <rules>
        <rule name="Ascetas" id="bd6a-c9ae-9993-a56d" hidden="false">
          <description>Ningún personaje podrá unirse a esta unidad.</description>
        </rule>
        <rule name="Trastornado" id="67b3-5e13-d93d-8228" hidden="false">
          <description>No se puede aplicar el efecto de la regla especial Parada contra los ataques de un Demente.</description>
        </rule>
        <rule name="El gozo de la sangre" id="5439-7701-2557-4ba2" hidden="false">
          <description>Cuando un Demente es retirado como baja durante una fase de combate, puede realizar todos sus ataques contra el enemigo o unidad que causó su última herida en lugar de sólo uno, como es habitual. Además, siempre que el atributo de Heridas de un demente sea reducido a 1 ó 0 durante una fase de combate, obtiene un bonificador de +2 a su atributo de Ataques.</description>
        </rule>
      </rules>
