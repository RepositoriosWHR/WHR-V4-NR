            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Afortunado" id="a77f-4e00-5b06-1d5c" hidden="false" typeId="1811-12ee-8ca2-f9ec" typeName="Habilidad de matador">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9e4c-129d-8439-093b">Una vez por turno de jugador, el personaje puede repetir una única tirada de dado que le concierna: puede tratarse de una tirada para impactar, para herir, una tirada de salvación o un chequeo de atributo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Furia de Grimnir" id="7992-ec32-3ec2-c539" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8ded-9063-4e55-5772" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="76dd-8557-ef8b-42dd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
