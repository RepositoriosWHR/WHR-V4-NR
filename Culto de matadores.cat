      <rules>
        <rule name="Forjador rúnico" id="9368-eb2a-cebe-b066" hidden="false">
          <description>Un Matachamanes genera un dado de dispersión adicional para el ejército del Culto de Matadores y puede canalizar dados de dispersión como si fuese un hechicero. Además, tiene la regla especial Resistencia mágica (2).</description>
        </rule>
      </rules>
