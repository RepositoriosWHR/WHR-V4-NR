                  <profiles>
                    <profile name="Runa magistral del vuelo" id="72ed-d66a-b9fb-31a0" hidden="false" typeId="d9f2-57ea-90f4-d594" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">El arma puede usarse como arma de disparo que retorna a la mano de su portador tras ser usada. Tiene un alcance de 10”, la Fuerza del usuario y las reglas especiales Ataques mágicos, Disparo rápido y Arrojadiza, así como las demás propiedades que confieran otras runas grabadas en el arma.</characteristic>
                      </characteristics>
                    </profile>
                    <profile name="Runa de la agonía" id="0886-9af5-41bc-04c5" hidden="false" typeId="d9f2-57ea-90f4-d594" typeName="Runa de armas">
                      <characteristics>
                        <characteristic name="Reglas especiales" typeId="6e6c-66a6-9d36-fb6d">Los ataques con el arma obtienen la regla especial Heridas múltiples (1D3).</characteristic>
                      </characteristics>
                    </profile>
                  </profiles>
                </selectionEntry>
              </selectionEntries>
            </selectionEntry>
