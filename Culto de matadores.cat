          <profiles>
            <profile name="Runa restauración" id="eb3d-cda7-d2b8-2d00" hidden="false" typeId="6196-246d-af80-3e34" typeName="Runa talismánica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a2c8-eec3-abbb-4fe1">Al inicio de cada uno de tus turnos, el portador puede restaurar una herida que hubiese sufrido previamente durante la batalla. Múltiples Runas de restauración son redundantes.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Runa del destino" id="b4f6-9317-8629-a6af" collective="false" hidden="false" import="true" type="upgrade">
