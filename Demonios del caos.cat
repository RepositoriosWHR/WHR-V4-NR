              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Los ataques del demonio en combate obtendrán un bonificador de +1 a la Fuerza. Por cada herida causada a una miniatura enemiga con este Arma demonio, la miniatura herida deberá superar un chequeo de Liderazgo o deberá ser retirada como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ladrón de esencia vital" id="f6dc-2d16-7da7-5e51" collective="false" hidden="false" import="true" type="upgrade">
