              <profiles>
                <profile name="Poder profécito" id="5b7e-38f1-80cb-f343" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Al inicio de la batalla, designa un personaje enemigo. Todos los ataques dirigidos contra él (proyectiles y cuerpo a cuerpo) podrán repetir las tiradas para impactar fallidas.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="La mano de los dioses" id="0bed-e668-9ba2-c6ee" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5750-c259-1ef0-d46e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2bae-ddf3-7e85-5189" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
