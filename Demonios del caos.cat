            <entryLink name="Demonio Slaanesh. Personajes" id="cf8a-7bf8-4dcf-4bc0" collective="false" hidden="false" import="true" targetId="8b7e-f537-0364-0b10" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <rules>
                <rule name="Almizcle Soporífero" id="99ea-eeb7-7f11-cf46" hidden="false">
                  <description>Las miniaturas enemigas en contacto con al menos una miniatura con esta regla verán sus atributos de M, HA e I reducidos en un punto. Las miniaturas con la regla especial Demonio, No muerto o que posean la marca de Slaanesh son inmunes a esta regla especial.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Demonio Tzeentch. Personajes" id="3d90-e89a-965f-c04f" collective="false" hidden="false" import="true" targetId="2996-ad86-662e-c40c" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <rules>
                <rule name="Descarga ígnea" id="9723-1fd2-6f95-5d0d" hidden="false">
                  <description>ataque de disparo con alcance 18”, Fuerza 4 y las reglas especiales Disparos múltiples 1D3, Ataques sólo flamígeros y Disparo rápido</description>
                </rule>
                <rule name="Demonio Tzeentch. Demonio mayor" id="617d-1190-9017-ec7b" hidden="false">
                  <description>Obtiene las reglas especiales Demonio (Tzeentch) y Descarga ígnea. Debe elegir al menos 1 nivel de magia.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
