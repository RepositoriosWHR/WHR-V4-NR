              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Al inicio de cada uno de tus turnos, el demonio recupera hasta 1D3 heridas que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bendición del padre de las plagas" id="f74f-9991-2f0e-bc89" collective="false" hidden="false" import="true" type="upgrade">
