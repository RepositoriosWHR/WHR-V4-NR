        <constraint id="4540-6df8-1507-12f8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte del fuego infernal" id="a484-2ea8-8b79-a1bb" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="7c77-2c51-b515-9722" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f251-b690-6257-c25d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte del Fuego Infernal" id="f691-ee8e-40f3-c267" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Al inicio de cada una de tus fases de magia, deberás utilizar el poder contenido en el estandarte. Haz una tirada de 1D6 en la tabla mostrada a continuación y selecciona el objetivo del hechizo utilizando al portador del estandarte como si fuera el lanzador del mismo. El hechizo será lanzado con el nivel básico de dificultad y podrá ser dispersado de la forma habitual. Si el hechizo disponía de una versión potenciada, haz una tirada de 1D6. Con un resultado de 5+, se lanzará la versión potenciada.
1. Fuego Ardiente de Tzeentch (Saber de Tzeentch)
2. Escudo de fuego (Saber de Tzeentch)
3. Espada Ígnea de Rhuin (Saber de Fuego)
4. Proyectiles Llameantes (Saber del Fuego)
5. Rayo de Transformación (Saber de Tzeentch)
6. Tormenta de Fuego de Tzeentch (Saber de Tzeentch)</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Iconos demoníacos menores. Infantería" id="5fe0-d977-5671-9b3d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="003e-91b3-4906-47b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
        <constraint id="4df3-b47f-289d-c91b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte de las legiones del Caos" id="be26-0c83-3c14-544b" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="eb62-cae5-3acb-6aa1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="aed5-fb4a-565b-6c80" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Estandarte de las legiones del Caos" id="8c9c-9963-5b0f-b1ab" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo unidades de Infantería. Al final de cada fase de disparo, magia y combate cuerpo a cuerpo, tira 1D6 por cada baja que haya sufrido la unidad en esa fase. Con cada resultado de 6, puedes volver a colocar uno de los demonios retirados como baja esa fase. Este efecto puede traer de vuelta a un oficial muerto, pero no a un personaje dentro de la unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Iconos demoníacos menores. Nurgle. Infantería" id="1bdf-cbae-9699-1725" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="d792-8f45-b468-9ac9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
        <constraint id="507b-a92a-fd2a-a27a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Campana de la condenación" id="4ddb-b8bc-47be-9e63" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="a0ff-d9a4-5b8f-412b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1e9a-efbf-1b87-84f4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Campana de la condenación" id="52cf-bdb0-3c2e-462c" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Solo Infantería. Por cada enemigo eliminado por el portador o la unidad en la que se encuentre debido a una herida causada por la regla Ataques de plaga, efectúa una tirada de 1D6. Con un resultado de 6, podrás incluir una miniatura adicional de Portador de plaga de Nurgle en la unidad en la que se encontrase. Resuelve este efecto tras realizar los ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Regalos mayores del Caos absoluto" id="272c-da7b-77ba-1975" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="3b2c-499b-12bb-35d7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="2"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Manto del Caos" id="e0bd-9402-51ab-2460" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1a85-33b3-f880-0006" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <rules>
            <rule name="Manto del Caos" id="c6e4-6907-6553-85a8" hidden="false">
              <description>Un sudario de energía pura del Caos cubre al demonio, distorsionando la misma realidad a su alrededor. Todos los impactos de Fuerza superior a 5 se considerarán de F5.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Señor de las Legiones Demoníacas" id="b561-6e70-4420-effc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6854-c160-c372-70af" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="71e8-8476-0441-17ab" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="75"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <rules>
            <rule name="Señor de las Legiones Demoníacas" id="f164-7bf7-3dd9-e98b" hidden="false">
              <description>Las miniaturas situadas a 12” o menos con la regla Especial Demonio se verán afectadas por la regla especial “¡Ni un paso atrás!”. Las miniaturas de Demonios dentro de ese radio podrán ignorar los efectos de la animosidad demoníaca. Solamente un príncipe Demonio del ejercito puede elegir este regalo Demoníaco.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
