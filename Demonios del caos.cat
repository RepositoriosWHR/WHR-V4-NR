              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Cada vez que el demonio causa una baja en combate cuerpo a cuerpo, tira 1D6: por cada resultado de 4+, el demonio puede restaurar una de las heridas que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fusta de la vejación" id="96e2-7e3b-70bb-717f" collective="false" hidden="false" import="true" type="upgrade">
