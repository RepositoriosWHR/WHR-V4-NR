                <profile name="Poder profécito" id="975c-7101-24fb-f7b9" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Al inicio de la batalla, designa un personaje enemigo. Todos los ataques dirigidos contra él (proyectiles y cuerpo a cuerpo) podrán repetir las tiradas para impactar fallidas.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="La mano de los dioses" id="1e83-73c5-04ef-dee5" collective="false" hidden="false" import="true" type="upgrade">
