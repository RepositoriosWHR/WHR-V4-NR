    <selectionEntry name="Carruaje flamígero de Tzeentch" id="8123-7de4-3830-8ec8" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Carro" id="f080-e8ef-4de9-1a4b" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink name="Flotar (11)" id="e219-dee0-2029-0374" hidden="false" targetId="29c1-6661-2b69-36e7" type="rule"/>
        <infoLink name="Demonio" id="012a-5dde-695c-1be4" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Tzeentch)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Inmune al fuego" id="036b-cb9a-e4a3-8ca1" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
        <infoLink name="Ataques flamígeros" id="d5d6-fba5-3aa3-cd72" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
        <infoLink name="Protección por montura (1)" id="1e97-bf9b-f384-449f" hidden="false" targetId="1f9d-b34a-3d89-add6" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Potencia de unidad 4" id="d31f-1de0-bc6b-e4df" hidden="false"/>
        <rule name="Ataque rasante" id="1803-639f-b540-0efa" hidden="false">
          <description>Si el Carruaje flamígero de Tzeentch se mueve durante la sub-fase Resto de movimientos por encima de una o más unidades enemigas no trabadas en combate, elige una de ellas. La unidad elegida sufrirá dos impactos de la Fuerza de los Aulladores de Tzeentch que tiran del carruaje.</description>
        </rule>
        <rule name="Descarga ígnea" id="59c6-22c7-1c8e-fb38" hidden="false">
          <description>Los Horrores azules de Tzeentch pueden proyectar llamas; se trata como un arma de disparo con alcance de 12”, Fuerza 3 y las reglas especiales Disparo rápido, Arrojadiza y Ataques sólo flamígeros.</description>
        </rule>
        <rule name="Nodo de poder demoníaco" id="d81b-ad5b-2f16-a886" hidden="false">
          <description>Si el Heraldo montado en el Carruaje posee en Foco Mayor o el Foco Menor de Tzeentch, aplicará sus efectos a todas las unidades de Demonios (Tzeentch) a 8” o menos de él.</description>
        </rule>
      </rules>
      <selectionEntries>
