              <profiles>
                <profile name="Omnipotencia" id="d099-2b0f-c36a-1658" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Amon&apos;Chakai tiene la regla especial Aura demoníaca (3+) y nunca podrá ser herido con un resultado mejor que 3+.
Incluso aquellos efectos que hieran automáticamente necesitarán un resultado de 3+ para herir a Amon&apos;Chakai.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
