              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">El demonio obtiene +1 Herida y -1 a su Iniciativa. Si es un Monstruo, obtendrá +2 Heridas en lugar de +1.</characteristic>
