              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Cada vez que el demonio vaya a lanzar o a dispersar un hechizo, genera un dado adicional (de Energía o Dispersión) para ese lanzamiento o dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
