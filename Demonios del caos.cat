              </entryLinks>
              <rules>
                <rule name="Marca del Tzeentch. Príncipe demonio" id="ba53-0505-ca7e-d543" hidden="false">
                  <description>Obtiene la regla especial Demonio (Tzeentch) y una tirada de salvación especial (5+, o +1 si ya disponía de ella). Además, tiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Nurgle. Personajes" id="5659-c8be-07a2-8ba2" collective="false" hidden="false" import="true" targetId="4a5d-d8ba-1090-2545" type="selectionEntry">
