          </entryLinks>
          <profiles>
            <profile name="Gran espada de plaga" id="52dc-5637-c2be-5a77" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Los ataques efectuados por el demonio en cuerpo a cuerpo herirán siempre con un resultado de 2+, sin importar la Resistencia. Por cada herida causada a un enemigo en cuerpo a cuerpo por el demonio, tira 1D6: con un resultado de 5+ (o 6+ si es un Objetivo grande) la miniatura herida deberá ser retirada como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rastro legamoso" id="8c18-8aaa-7b91-b166" collective="false" hidden="false" import="true" type="upgrade">
