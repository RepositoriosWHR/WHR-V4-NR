              </infoLinks>
              <rules>
                <rule name="Demonio caos absoluto. Demonio mayor" id="5f76-03b5-36d5-409b" hidden="false">
                  <description>Coraza infernal. Además, los ataques no mágicos contra el portador tendrán un penalizador de -1 a la Fuerza.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Demonio Khorne. Personajes" id="7d2c-2d2a-7d9a-c8ac" collective="false" hidden="false" import="true" targetId="4eab-e75d-09f2-60ae" type="selectionEntry">
