              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Los resultados de 1, 2 y 3 en las tiradas para herir contra el demonio siempre se consideran un fallo, independientemente de la Fuerza del ataque.</characteristic>
              </characteristics>
            </profile>
          </profiles>
