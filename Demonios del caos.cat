      <selectionEntryGroups>
        <selectionEntryGroup name="Monstruosidad disforme" id="6e72-4d17-085f-39cd" collective="false" hidden="false" import="true">
          <constraints>
            <constraint id="2953-10a3-f9e8-43b4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="d354-9ff2-e003-cad8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <rules>
            <rule name="Monstruosidad disforme" id="ca48-de60-2453-8278" hidden="false">
              <description>Cada Behemoth demoníaco debe elegir una de las siguientes opciones, al coste en puntos indicado. No puede haber dos Behemoths demoníacos con la misma opción en un mismo ejército:</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Descomunal" id="7d66-7c3b-e8a0-fec5" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5855-ad67-952f-7799" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="daf5-4443-d940-e5a2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="35"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Descomunal" id="4c26-f49c-089f-ead2" hidden="false">
                  <description>Obtiene +1 a Fuerza, Resistencia y Heridas, pero también -1 a Movimiento, Habilidad de armas, Ataques e Iniciativa.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Montaña de pozoña" id="8618-0382-430c-1aaf" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0e9e-6bcc-66fb-430e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="e72f-bcb6-ff52-5a08" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataque de plaga" id="5836-8a43-1283-64ec" hidden="false" targetId="9bfa-79ab-0333-e501" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Montaña de pozoña" id="e74f-3d01-47f5-4e75" hidden="false">
                  <description>Obtiene la regla especial Ataques de Plaga. Además, al principio de cada fase de combate, todas las miniaturas enemigas en contacto con el Behemoth demoníaco deberán realizar un chequeo de Resistencia, sufriendo una herida sin posibilidad de salvación por armadura si lo fallan.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Cuerpo ardiente" id="0d3b-7492-76cf-5cb9" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5f6b-8849-9b87-873b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="7daf-bcb9-752d-bb62" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="629e-e537-c91d-fdf0" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Inmune al fuego" id="9f4d-3954-0a1e-6f8f" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Cuerpo ardiente" id="9608-0710-f3f6-a768" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros e Inmune a fuego. Además, al principio de cada fase de combate, todas las miniaturas enemigas en contacto con el Behemoth demoníaco sufrirán un impacto de Fuerza 3 con la regla especial Ataques solo flamígeros.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Cuerpo eléctrico" id="6324-241f-4636-f18d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="89df-cf76-5176-1161" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="ab2f-994f-1f1c-8c8e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="40"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques de rayos" id="e818-5ce8-9d09-3e6b" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Cuerpo eléctrico" id="847f-119e-9738-54ae" hidden="false">
                  <description>Sus ataques en combate cuerpo a cuerpo tienen la regla especial Ataques de rayos y el Behemoth demoníaco no puede ser herido por Ataques de rayos. Al principio de cada fase de disparo, selecciona la unidad (amiga o enemiga) a 12” o menos del Behemoth demoníaco que tenga la mejor tirada de salvación por armadura: esa unidad sufrirá 1D6 impactos de Fuerza 5 con la regla especial Ataque de rayos.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Descarga disforme" id="826e-6b7b-cdf3-38ee" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="812e-0590-757b-1dc3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="37b3-7db0-c467-a1e9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="25"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Descarga disforme" id="1429-1cb8-459d-c294" hidden="false">
                  <description>Se trata de un ataque de disparo que puede utilizarse aunque el Behemoth demoníaco mueva (pero no si marcha) y se considera un efecto de Tormenta de proyectiles con un alcance de 18” que causa 2D6 impactos automáticos de Fuerza 4.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Cuerpo de diamante" id="a07c-0198-3a1f-fa8a" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3f87-b20c-8ab4-1ba9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="91e2-6041-b044-39f1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Piel escamosa (3+)" id="c297-f005-c7b3-083e" hidden="false" targetId="f3fe-4c6e-197e-832f" type="rule"/>
                <infoLink name="Inmune a Poder de penetración" id="724d-35f5-42ca-e5db" hidden="false" targetId="1cd7-e229-65a3-05a5" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Cuerpo de diamante" id="0c1d-6a86-e720-53b8" hidden="false">
                  <description>Obtiene la regla especial Piel escamosa (3+). Además, será inmune a los efectos de las reglas especiales Poder de penetración y Heridas múltiples.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Cuerpo helado" id="06a3-f276-bc7f-27b4" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="4387-dca2-d5e0-4270" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="db9e-6a0c-afee-0a69" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Aura de frio" id="6de3-65c3-b720-1314" hidden="false" targetId="a75b-8c16-3718-ea3c" type="rule"/>
                <infoLink name="Arma de aliento" id="e766-fa78-575a-8058" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(F2, sin salvación por armadura)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Cuerpo helado" id="1a10-25ef-378f-84b2" hidden="false">
                  <description>Obtiene la regla especial Aura de frío. Además, también obtiene un Arma de aliento de Fuerza 2 que no permite tirada de salvación por armadura.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Anatema mágico" id="a1af-2f7f-d104-e7b2" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="18d9-693c-c4cf-9ee8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="2056-ee9e-ed54-e0ed" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="30"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Resistencia mágica (3)" id="34bc-aa00-8062-504e" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Anatema mágico" id="75d5-b617-1dc2-dfd2" hidden="false">
                  <description>Obtiene la regla especial Resistencia mágica (3). Además, todos los impactos contra el Behemoth demoníaco que no sean Ataques mágicos tendrán un penalizador de -1 en sus tiradas para herir.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Cuerpo de sombras" id="31e1-d57a-8ecd-8bd9" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="78a9-8b01-59cf-3c64" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="b00a-a59d-9485-d6db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Cuerpo de sombras" id="efd9-2bf4-4303-9916" hidden="false">
                  <description>Todos los disparos que tomen como objetivo al Behemoth demoníaco tendrán un penalizador de -1 para impactar. En combate cuerpo a cuerpo los enemigos que ataquen al Behemoth demoníaco tendrán un penalizador de -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Golpe demoledor" id="58e7-bd0c-e457-9923" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="195a-4a11-fe99-fca9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="6849-b00f-65c8-5c0c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="35"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Golpe letal" id="2043-296a-914a-5379" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Golpe demoledor" id="496b-954b-d872-237f" hidden="false">
                  <description>Obtiene la regla especial Golpe letal heroico en sus ataques en combate cuerpo a cuerpo.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Aura de nergía impía" id="53ff-c673-1b1e-a452" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="cbcc-48c0-6e7f-c9b8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="57ec-b04e-0af5-bc0a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="45"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Aura de nergía impía" id="3c49-6328-51ae-6680" hidden="false">
                  <description>Obtiene una tirada de salvación especial de 4+.</description>
                </rule>
              </rules>
            </selectionEntry>
            <selectionEntry name="Ingravidez" id="989f-4d73-5466-84d6" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="8e27-4cb7-7c6c-be21" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="4120-4df7-383d-b05e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="50"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Flotar (8)" id="8a91-062d-5d64-822e" hidden="false" targetId="7465-4e8e-6ec8-2a0f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Ingravidez" id="3e67-e128-908a-4adf" hidden="false">
                  <description>Obtiene la regla especial Flotar (8). Además, durante la fase de movimiento en el paso de Restos de movimientos puedes seleccionar una unidad sobre la que haya sobrevolado y causarla 2D6 impactos que siempre hieren con un resultado de 4+ (sin importar su Resistencia) y no permiten tirada de salvación por armadura.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="[Ex] - Ka´Bandha, el guardián del trono de Khorne" id="15e5-6a56-3406-5467" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="4c11-81e6-3817-4c70" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
