      <rules>
        <rule name="Marcado por los dioses" id="5d6e-4d21-c3f7-7b9f" hidden="false">
          <description>Mordrek no puede unirse a unidades ni ser el General del ejército.</description>
        </rule>
        <rule name="Marca del caos absoluto" id="ed17-acd4-dd93-700d" hidden="false">
          <description>Permite repetir sus tiradas de salvación por armadura fallidas.</description>
        </rule>
      </rules>
      <selectionEntries>
