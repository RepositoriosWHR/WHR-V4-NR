              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">El Aura demoníaca del demonio podrá utilizarse incluso contra Ataques mágicos (convirtiéndose, efectivamente, en una tirada de salvación especial).</characteristic>
              </characteristics>
