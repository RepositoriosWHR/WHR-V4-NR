      <rules>
        <rule name="Cuerpo gomoso" id="5c2d-6042-ddef-edf3" hidden="false">
          <description>Todos los impactos contra los Sapos de plaga tendrán un 
penalizador de -1 en su tirada para herir.</description>
        </rule>
        <rule name="Lengua venenosa" id="89cd-97b4-cdc3-824f" hidden="false">
          <description>Se trata de un ataque a distancia que pueden efectuar los Sapos de plaga con un alcance de 10”, Fuerza 4 y la regla especial Disparo rápido.</description>
        </rule>
      </rules>
