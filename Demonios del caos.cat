    <selectionEntry name="[E] - Epidemius, archivista de Nurgle" id="71fb-f32c-0dfd-abb9" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="9cce-82f9-e5c9-0ea7" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
