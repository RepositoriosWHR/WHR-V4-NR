                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Amon&apos;Chakai tiene la regla especial Aura demoníaca (3+) y no puede ser herido con un resultado mejor que 3+. Incluso aquellos efectos que hieran automáticamente necesitarán un resultado de 3+ para herir a Amon&apos;Chakai.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
