              <profiles>
                <profile name="La mano de los dioses" id="4a51-3d3e-7282-046a" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Al inicio de la batalla, elige un personaje enemigo. El oponente deberá revelarte todos sus objetos mágicos. Adicionalmente, si el personaje era hechicero, elige uno de sus hechizos, que quedará destruido y no podrá utilizarse más en la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Omnipotencia" id="e8e9-8bca-76a3-5c5e" collective="false" hidden="false" import="true" type="upgrade">
