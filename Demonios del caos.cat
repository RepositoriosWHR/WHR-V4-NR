      <selectionEntries>
        <selectionEntry name="Putrefacción de Nurgle" id="8b02-9e32-40b7-e22a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1767-d33d-1829-a9ee" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="af6a-63a5-5a9e-32bf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Putrefacción de Nurgle" id="f626-cd9f-693d-b3b2" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Al inicio de cada fase de combate (propia y del oponente), todas las miniaturas enemigas en contacto con el demonio deberán realizar un chequeo de Resistencia: si lo fallan, sufrirán una herida que no podrá evitarse con tiradas de salvación por armadura. Si el portador es un Heraldo de Nurgle en una unidad de Portadores de Plaga de Nurgle, por cada baja causada por este regalo puedes restaurar inmediatamente una miniatura de tropa de su unidad que hubiera sido retirada previamente como baja. Las miniaturas con la Marca de Nurgle son inmunes a este efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vitalidad necrótica" id="2e4c-092b-92e3-71de" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ba44-2fe3-530c-4981" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dcfb-0e98-c0d2-0ec7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
