                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="La mano de los dioses" id="b0cf-c81e-dbd9-231d" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">Al inicio de la batalla, elige un personaje enemigo. El oponente deberá revelarte todos sus objetos mágicos. Adicionalmente, si el personaje era hechicero, elige uno de sus hechizos, que quedará destruido y no podrá utilizarse más en la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Omnipotencia" id="bf24-123d-b355-1b44" collective="false" hidden="false" import="true" type="upgrade">
