                  </modifiers>
                </infoLink>
                <infoLink name="Protección por montura (2)" id="ffe9-16f2-a49a-4fd4" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
                <infoLink name="Ataque de plaga" id="c767-ba5b-c1d5-5d78" hidden="false" targetId="9bfa-79ab-0333-e501" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Trono de la virulencia" id="f8be-439c-d036-51a4" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
                  <characteristics>
                    <characteristic name="M" typeId="4d23232344415441232323">4</characteristic>
                    <characteristic name="HA" typeId="5.753232323444154e+23">2</characteristic>
                    <characteristic name="HP" typeId="4.2532323234441546e+23">0</characteristic>
