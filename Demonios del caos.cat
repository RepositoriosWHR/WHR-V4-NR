              </entryLinks>
              <rules>
                <rule name="Marca del Nurgle. Príncipe demonio" id="f437-61fe-f90b-6552" hidden="false">
                  <description>Obtiene la regla especial Demonio (Nurgle). Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1HA.</description>
                </rule>
              </rules>
            </entryLink>
