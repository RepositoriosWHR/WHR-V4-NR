            <profile name="Foco de energía" id="27d0-eafc-7c23-28ab" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">El demonio obtiene un bonificador de +2 en sus tiradas para Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Llamas de Tzeench" id="ccf9-b3d6-3c09-e3bc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fb50-9de4-72aa-c393" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5b16-7f54-8d72-1821" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Disparos múltiples" id="d3bd-e386-4f49-18b4" hidden="false" targetId="fc7e-40e6-a7aa-4530" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(1D6+1)"/>
              </modifiers>
            </infoLink>
            <infoLink name="Disparo rápido" id="6780-6a2e-eb95-515f" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
            <infoLink name="Arrojadiza" id="0bc9-0ddf-eba1-1e92" hidden="false" targetId="f4e8-fb62-1495-6c04" type="rule"/>
            <infoLink name="Ataques flamígeros" id="4d9e-36d0-fc72-7b61" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Llamas de Tzeench" id="8e6b-7b96-a7e1-b1db" hidden="false" typeId="9aa0-a435-0f3a-053a" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="a0ac-d89f-70e8-096e">El demonio puede realizar un ataque a distancia de alcance 18”, Fuerza 5 y las reglas especiales Disparos múltiples (1D6+1), Disparo rápido, Arrojadiza y Ataques flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fortuna de Tzeentch" id="4993-5282-d40d-0003" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5d50-d9f4-6e51-4da6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="55c2-400e-9ba7-5edb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
