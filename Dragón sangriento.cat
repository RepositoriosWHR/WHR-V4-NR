      <rules>
        <rule name="La muerte alada" id="f46c-2c1a-de33-10a4" hidden="false">
          <description>Los chequeos de Miedo y Terror provocados por los Caballeros de la Muerte cuaando estos cargan o cuando reciben una carga se realizan tirando 3D6 y descartando el resultado menor.</description>
        </rule>
        <rule name="Élite vampírica" id="748f-7ec4-cc23-7967" hidden="false">
          <description>Ningún personaje puede unirse a una unidad de Caballeros de la muerte salvo que tenga el poder vampírico Caballero de la muerte.</description>
        </rule>
      </rules>
