          <profiles>
            <profile name="Estudios nigrománticos" id="f110-4542-03bc-9cf3" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El nivel de magia del vampiro aumenta en 1 (si no dispone de niveles de magia, obtiene 1 nivel de magia y puede escoger sus hechizos de los saberes de la Muerte o Nigromancia).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Hechicero consumado" id="153b-b7c2-480a-f965" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="85cc-2e6e-a901-aef6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b720-e969-789b-51d2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Hechicero consumado" id="0f67-ad5d-4c31-0575" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El personaje puede, una vez por fase de magia propia, lanzar la Danza Macabra de Vanhel como Objeto portahechizos (nivel de energía 1D3+1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Odio sin límites" id="6dde-52e9-38ec-50d6" collective="false" hidden="false" import="true" type="upgrade">
