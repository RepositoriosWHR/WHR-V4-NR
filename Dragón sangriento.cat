              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo personajes con la regla Orgullo marcial. En desafios, los adversarios que no tengan la regla Orgullo Marcial tendran un penalizador de -1 en sus tiradas para impactar y herir en combate cuerpo a cuerpo contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Clan dragón sangriento. Bardo no muerto" id="4481-3957-3faf-5b8c" collective="false" hidden="false" import="true">
      <constraints>
