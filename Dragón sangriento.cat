      <rules>
        <rule name="Magia Abhorash" id="77f1-239b-1890-74b9" hidden="false">
          <description>Aborash es un hechicero de nivel 2 que siempre conoce los hechizos Invocación de Nehek (hechizo identificativo) y Danza macabra de Vanhel del saber de Nigromancia. Genera su otro hechizo de la forma habitual.</description>
        </rule>
        <rule name="Señor del Clan" id="111f-4119-e446-cb45" hidden="false">
          <description>La Presencia inspiradora de Aborash tiene un alcance de 18”.</description>
        </rule>
      </rules>
