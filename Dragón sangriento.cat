          <infoLinks>
            <infoLink name="Armadura pesada" id="6118-6305-901f-5a56" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Coraza cadavérica" id="fcfb-f0a2-7d7f-3cd8" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. El portador es inmune al golpe letal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura de la noche" id="f27a-1920-cae8-b65d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b426-4fd2-b105-19ec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d7b3-afc8-8980-1940" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura pesada" id="4137-e047-6a62-6377" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura de la noche" id="8af0-f853-9fb4-f359" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Los disparos contra el portador tendrán un penalizador adicional de -2 para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura maldita" id="fb80-8309-c982-653e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8e68-2a79-d594-fd22" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b468-36f2-57fc-dc3d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura de placas" id="b536-203b-0d7a-afc5" hidden="false" targetId="1b9f-44b8-30ac-a6aa" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura maldita" id="0ad5-1cf8-7fea-154e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de placas (salvación por armadura de 4+). Proporciona al portador +1 Resistencia, pero reduce su I a 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Escudo de las tormentas" id="3912-e1a0-022b-2fd7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7805-0504-1843-55b6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2a86-3870-5dd8-2b44" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Escudo" id="f6f7-3971-29bc-086c" hidden="false" targetId="c028-354e-9169-7463" type="profile"/>
            <infoLink name="Ataques de rayos" id="1fc8-343e-55c3-60a0" hidden="false" targetId="8628-6531-ed1d-f985" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Escudo de las tormentas" id="a6cd-5eef-7321-74b2" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Cada vez que una miniatura falle una tirada para herir cuerpo a cuerpo contra el portador, esta recibirá un impacto que herirá igual a su tirada de salvación por armadura (por ejemplo, si tiene salvación por armadura de 4+ lo herirá con un 4+). Se trata de un ataque de rayos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Armadura de hierro negro" id="8b56-3e47-1f3b-e806" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="62dd-68db-9577-bf9e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ab34-edbc-f5da-4d94" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Armadura pesada" id="e02e-0e4c-7bdf-1eac" hidden="false" targetId="1ee5-2441-2c69-5965" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Armadura de hierro negro" id="7892-62b6-912d-195e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Proporciona a su portador una tirada de salvación por armadura de 1+ (que no puede mejorarse), y además permite a su portador repetir sus tiradas de salvación por armadura fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Clan dragón sangriento. Mayal" id="208a-87e0-fbd6-f0d4" collective="false" hidden="false" import="true">
      <constraints>
