          <profiles>
            <profile name="Romper la defensa" id="5c04-7bb1-8498-9d53" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene un modificador de +1 a todas sus tiradas para impactar en cuerpo a cuerpo. Esto se puede usar en conjunción con un Arma mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Orden del Dragón Sangriento" id="e076-c192-709e-c4fb" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3381-361e-5e8e-5bad" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a1d9-24df-8164-0078" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="55"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Tozudez" id="7d74-0c8e-af23-2583" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Orden del Dragón Sangriento" id="6e73-dc6e-65aa-2f2c" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene la regla especial Tozudez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fuerza demoledora" id="56f9-6e50-263e-5533" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2f12-681c-751e-3314" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dace-1371-9eba-8296" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Heridas múltiples (1D3)" id="1a67-36a8-98ee-3ddb" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Fuerza demoledora" id="c4a3-6bc2-d5f5-af1a" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene la regla especial Heridas múltiples (1D3) en sus ataques cuerpo a cuerpo. Esto se puede usar en conjunción con un Arma mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Furia de sangre" id="9803-1356-5d19-8d7c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1ca7-635c-c4d3-5582" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="df38-dbe2-7a5f-c77f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Furia de sangre" id="2f9a-12aa-0b49-8a9f" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">Por cada herida no salvada que el vampiro cause en combate cuerpo a cuerpo (antes de multiplicar si tuviera la regla especial Heridas múltiples), puede realizar inmediatamente un ataque extra. Estos ataques extra no generan nuevos Ataques ni pueden generarse más ataques de los que tiene el personaje.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armaduras mágicas. Clan dragón sangriento" id="701e-7293-f580-e3b7" collective="false" hidden="false" import="true">
      <constraints>
