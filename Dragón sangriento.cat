      <rules>
        <rule name="Magia Wallach Harkon" id="e3be-4885-cf7a-827b" hidden="false">
          <description>Wallach es un hechicero de nivel 2 que genera sus hechizos del Saber de Nigromancia.</description>
        </rule>
        <rule name="Estandarte de batalla" id="ca77-5873-6ac1-8f0d" hidden="false">
          <description>Wallach Harkon porta el Estandarte del Dragón Sangriento y debe ser el Portaestandarte de batalla del ejército. Si lo deseas, Wallach puede ser también el General del ejército.</description>
        </rule>
        <rule name="Furia sangrienta" id="3281-307e-51a2-994c" hidden="false">
          <description>Wallach y su unidad podrán repetir sus tiradas de carga fallidas.</description>
        </rule>
      </rules>
