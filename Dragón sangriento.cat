          <profiles>
            <profile name="Expiación inmortal" id="5b14-ccc1-2705-e871" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">Un ejército comandado por el personaje se tratará como un ejército de las Fuerzas del Orden (en lugar de las Fuerzas de la Destrucción, como es habitual para los ejércitos de los Condes Vampiro), y tener aliados en consecuencia (ver sección de alianzas al final de este libro). Además, el personaje tendrá un bonificador de +1 a su Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Clan dragón sangriento. Orgullo marcial" id="a276-2952-d854-dcc7" collective="false" hidden="false" import="true">
