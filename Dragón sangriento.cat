      <rules>
        <rule name="Magia El Duque Rojo" id="81e1-6c46-3ac3-9603" hidden="false">
          <description>El Duque Rojo es un hechicero de nivel 3 que siempre utiliza hechizos del Saber de Nigromancia.</description>
        </rule>
        <rule name="Azote de Bretonia" id="dde4-684e-3935-dbe2" hidden="false">
          <description>El Duque Rojo causa Terror a todas las miniaturas del ejército de Bretonia; además, todos los bretonianos obtienen la regla especial Odio (Duque Rojo).</description>
        </rule>
        <rule name="Especial: Azote de Aquitania." id="b6d8-66a3-8b5a-57b7" hidden="false">
          <description>Si el Duque Rojo es el General del ejército, puedes incluir en tu ejército al Señor Falk y los Caballeros del Grial Negro (ver el libro de ejército de los No Muertos).</description>
        </rule>
      </rules>
