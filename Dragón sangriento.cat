      <rules>
        <rule name="Estandarte de batalla" id="9d3b-3246-6879-4829" hidden="false">
          <description>Wallach Harkon porta el Estandarte del Dragón Sangriento y debe ser el Portaestandarte de batalla del ejército. Si lo deseas, Wallach puede ser también el General del ejército.</description>
        </rule>
        <rule name="Furia sangrienta" id="2a93-8170-d1c4-45fa" hidden="false">
          <description>Wallach y su unidad podrán repetir sus tiradas de carga fallidas.</description>
        </rule>
        <rule name="Elegido de Khorne" id="b07b-9b0e-5f6e-246f" hidden="false">
          <description>Walach ha sido bendecido por el Dios de la Sangre como un instrumento para seguir su voluntad. El alcance de la regla especial Voluntad de Khorne de Walach tiene un alcance de 18” en lugar de las 12” habituales.</description>
        </rule>
      </rules>
