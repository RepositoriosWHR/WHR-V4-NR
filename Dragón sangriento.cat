            <infoLink name="Furia asesina" id="7bec-93f5-e289-d353" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Yelmo de la furia inmortal" id="741f-f599-eff6-9d5e" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Sólo Vampiros. Yelmo. El portador se verá sujeto a la regla especial Furia asesina, y no la perderá aunque sea derrotado en combate cuerpo a cuerpo. Además, cualquier unidad de No muertos a la que se una el personaje obtendrá también la regla especial Furia asesina, y no la perderá aunque sea derrotada en combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
