        <constraint id="c8a6-856e-5a59-5c97" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Coraza cadavérica" id="a8a7-6863-4486-5665" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="79ed-062d-d1de-68f4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c4e6-6a36-229a-df79" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
