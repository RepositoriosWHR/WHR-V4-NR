            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio (todos los enemigos)" id="9940-be40-5312-036d" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Odio sin límites" id="939b-5e7a-68ce-9e28" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene la regla especial Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Golpe maestro" id="5209-a179-fe5e-693a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4147-f17d-e652-b041" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7dec-6454-eda3-165d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Golpe letal heróico" id="28df-bb9d-aaa6-24de" hidden="false" targetId="95ce-f21a-29e1-42a2" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Golpe maestro" id="3d17-14b2-6c3f-9a28" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro puede sustituir todos sus ataques en combate cuerpo a cuerpo por uno sólo con la regla Golpe letal heroico y que puede repetir sus tiradas fallidas para herir. Puede utilizarse en combinación con un arma mágica pero no se podrá realizar más de un ataque por ninguna razón si se usa el Golpe maestro.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espadachín consumado" id="073c-ece6-c717-ee12" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d718-ebc2-bdfe-deb3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e331-338e-6264-19df" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Espadachín consumado" id="927d-25b9-1b0f-b86b" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">Al inicio de cada fase de combate cuerpo a cuerpo, elige una miniatura en contacto peana con peana con el vampiro. Esa miniatura perderá un ataque esa fase (hasta un mínimo de 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La fuerza del acero" id="a72d-4a2e-7380-f678" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ab79-e583-93b1-30f7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="42ca-0db3-d012-ad92" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Carga devastadora" id="a5d5-7ee9-1bd1-16eb" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="La fuerza del acero" id="72e4-8f03-0445-8cdc" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene la regla especial Carga devastadora.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Honor o muerte" id="0403-b84d-9d08-ec72" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="df55-f03b-981d-d6cc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3de7-10d4-8648-b4cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Orgullo marcial" id="ec43-b570-d6d6-b312" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Honor o muerte" id="3ea0-081d-51c0-c9f1" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro puede repetir todas sus tiradas para impactar fallidas si lucha en un Desafío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Furia dracónica" id="4408-940b-68b9-5951" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a7d4-21ed-8237-bbac" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="eb91-4de8-992c-1cb3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Furia asesina" id="9a0c-64d4-8521-7702" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Furia dracónica" id="7478-60b9-4032-ba3c" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene la regla especial Furia asesina, y no la perderá aunque pierda un combate. Si está unido a una unidad con Furia asesina, esa unidad tampoco perderá su furia aunque pierda un combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Caballero de la muerte" id="c14f-dc41-e99a-cd0f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="dea0-5c1d-98c3-b47d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e030-7329-045c-a642" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Corcel sangriento" id="42c4-5de5-a3ee-51e0" collective="false" hidden="false" import="true" targetId="77fb-9ebd-22a5-6d3d" type="selectionEntry">
              <constraints>
                <constraint id="5e19-86da-f827-b642" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="7bd8-3287-2e59-2215" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
            </entryLink>
          </entryLinks>
          <profiles>
            <profile name="Caballero de la muerte" id="eb6b-1e0f-453c-794f" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene como montura un Corcel sangriento (incluido en el coste del poder) y obtiene la regla especial La muerte alada (ver Caballeros de la muerte). El vampiro puede unirse a una unidad de Caballeros de la muerte.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="La muerte alada" id="de84-8b27-1d5f-1590" hidden="false">
              <description>Los chequeos de Miedo y Terror provocados por los Caballeros de la Muerte cuaando estos cargan o cuando reciben una carga se realizan tirando 3D6 y descartando el resultado menor.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Magia bélica" id="77a6-f081-e6fb-ae1b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f3f4-be58-0d71-8ef2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6de1-3b78-8b1c-df4c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Magia bélica" id="3696-d56f-a8e2-6f34" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El personaje conoce la Danza macabra de Vanhel además de sus hechizos habituales. Además, cuando lance exitosamente la Danza Macabra sobre una unidad de No muertos trabada en combate puede elegir sustituir el efecto habitual (repetir las tiradas fallidas para impactar) por uno de los siguientes:
-La unidad gana Poder de penetración por la duración del conjuro
-La unidad puede repetir los resultados de 1 en sus tiradas para herir por la duración del conjuro
-Si la unidad tenía la regla especial Golpe letal, éste surtirá efecto con 5+ (en lugar de 6+ como es habitual) por la duración del conjuro
-La unidad gana Luchar con filas adicionales (1) por la duración del conjuro.
-La unidad obtiene un bonificador de +1 a su tirada de salvación por armadura por la duración del conjuro.
Ten en cuenta que aunque pueda tener efectos diferentes se sigue tratando del mismo hechizo, y no puede afectar más de una vez por turno a una misma unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampírircos menores. Caballería" id="7c8c-5621-ea68-98b6" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="8726-a699-c6ee-323b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="07ef-76ba-2f5f-3bd7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Caballero imperial" id="7aee-761a-b4e4-cd7d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="19d2-150f-790b-60ae" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8dea-cd7b-4ead-943e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Caballero imperial" id="3acc-8fd4-a49c-62b2" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">Sólo Señor de vampiros Dragón Sangriento y Conde Dragón Sangriento. Este poder tan sólo puede ser elegido por un vampiro montado en una bestia (es decir, que tenga el tipo de tropa Caballería) que se una a una unidad de Caballería tumularia o Caballeros del Dragón sangriento (y no podrá abandonar voluntariamente esa unidad) que no haya escogido la regla especial Formaciones de batalla de Bretonia. Puedes elegir una de las órdenes de caballería del Imperio (ver el libro de ejército del Imperio) y aplicarle sus reglas especiales tanto al personaje como a la unidad durante toda la batalla (si se trata de Tumularios, sus armas serán Armas funerarias del mismo tipo). Si este poder es elegido por un Señor de los Vampiros cuenta como si fuese un Maestre Templario a la hora de determinar los efectos de la orden de caballería.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Reiksguard" id="4f7c-8c7b-416d-fa9b" hidden="false">
              <description>Obtienen la regla especial Tozudez. Van equipados con Lanza de caballería funeraria y Escudo. El Señor de los Vampiros obtiene adicionalmente la regla especial ¡Ni un paso atrás!, que afecta a templariotodas las tropas amigas a 8” o menos de él.</description>
            </rule>
            <rule name="Caballeros del Lobo Blanco" id="2ccf-7e6a-1561-c812" hidden="false">
              <description>Obtienen la regla especial Aplastar al débil, que les permite repetir los resultados de 1 en sus tiradas para herir contra enemigos con Liderazgo 7 o inferior. Van equipados con Martillo del lobo blanco y Capa de lobo. El Señor de los Vampiros está equipado con Capa de lobo y tanto él como la unidad en la que se encuentren pueden repetir todas sus tiradas de 1 para herir (sin tener en cuenta el Liderazgo de sus enemigos).</description>
            </rule>
            <rule name="Caballeros del Corazón Llameante" id="310d-b133-1323-acfe" hidden="false">
              <description>Obtienen la regla especial Odio (pielesverdes); además, cuando cargan, pueden repetir la tirada de uno de sus dados de carga. Van equipados con Lanza de caballería funeraria y Escudo. El Señor de los Vampiros y su unidad pueden repetir todas sus tiradas fallidas para impactar contra pielesverdes.</description>
            </rule>
            <rule name="Caballeros Pantera" id="51a5-05d9-c352-a065" hidden="false">
              <description>Obtienen la regla especial Odio (Caos); además, debido a la gran calidad de sus armas de manufactura enana, obtienen la regla especial Poder de penetración en sus ataques en combate cuerpo a cuerpo.Van equipados con Lanza de caballería funeraria y Escudo. El Señor de los Vampiros y su unidad pueden repetir todas sus tiradas fallidas para impactar contra miniaturas del Caos.</description>
            </rule>
            <rule name="Caballeros del Sol Llameante" id="eba5-0e2f-236b-e6a1" hidden="false">
              <description>Obtienen la regla especial Odio (No muertos); además, debido a sus escudos bruñidos como espejos, los enemigos tendrán un penalizador de -1 para impactarles en combate cuerpo a cuerpo durante cualquier turno en el que carguen. Van equipados con Lanza de caballería funeraria y Escudo. El Señor de los vampiros y su unidad pueden repetir todas sus tiradas fallidas para impactar contra miniaturas con la regla especial No muertos.</description>
            </rule>
            <rule name="Caballeros de la Sangre de Sigmar" id="9de6-db40-0cc2-753d" hidden="false">
              <description>Obtienen las reglas especiales Ataques mágicos y Resistencia mágica (1). Van equipados con Lanza de caballería funeraria y Escudo. El Señor de los vampiros obtiene la regla especial Resistencia mágica (2).</description>
            </rule>
            <rule name="Caballeros del Sudario de Morr" id="d3b3-399a-8f36-5344" hidden="false">
              <description>Causan Miedo.Van equipados con Arma a dos manos funerarias (guadañas). El Señor de los Vampiros causa Terror.</description>
            </rule>
            <rule name="Caballeros del León Dorado" id="f255-56cc-0113-e5ba" hidden="false">
              <description>Obtienen una tirada de salvación especial de 5+ contra proyectiles y hechizos del tipo Proyectil mágico. Van equipados con Lanza de caballería funeraria y Escudo. El Señor de los Vampiros posee una tirada de salvación especial de 4+ contra proyectiles y hechizos del tipo Proyectil mágico, la cual otorga a la unidad en la que se encuentre.</description>
            </rule>
            <rule name="Caballeros Encarnados" id="d82c-adb1-820b-20b9" hidden="false">
              <description>Los Caballeros imperiales y Caballeros del círculo interior van equipados con Armas emparejadas. En combate cuerpo a cuerpo, ganan un bonificador de +1 a su tirada de salvación por armadura. El Maestre templario y la unidad en la que esté obtendrán la regla especial Golpe letal con su ataque otorgado por su Arma de mano adicional.</description>
            </rule>
            <rule name="Orden de la Guadaña Sagrada" id="8f84-3cd9-aa3a-cf6f" hidden="false">
              <description>Los Caballeros imperiales y Caballeros del círculo interior van equipados con Arma a dos manos. Obtienen las reglas especiales Odio (No muertos), Inmune a miedo y Resistencia mágica (2) contra hechizos de la Magia Oscura y Nigromancia. El Maestre templario y la unidad en la que esté podrán repetir las tiradas para herir de 1 contra miniaturas con la regla especial Vampiro.</description>
            </rule>
            <rule name="Orden del Oso Negro" id="809b-0668-a115-87d6" hidden="false">
              <description>Los Caballeros imperiales y Caballeros del círculo interior van equipados con Lanza de caballería, Arma de mano y Escudo. Obtienen las reglas especiales Odio (Orcos y Goblins) y Carga devastadora. El Maestre templario y la unidad en la que esté podrán usar el bonificador de +1 a su Fuerza de Carga devastadora el turno posterior a haber realizado una carga exitosa y durante los turnos en los cuales reciban una carga por el frontal.</description>
            </rule>
            <rule name="Órdenes menores" id="4109-7124-92cf-0c83" hidden="false">
              <description>No tienen reglas especiales propias.  pueden ir equipados con Lanza de caballería y Escudo, Arma a dos manos, Mayales o Mangual y Escudo.</description>
            </rule>
            <rule name="Caballeros del Toro" id="c16d-32af-cd95-9f88" hidden="false">
              <description>van equipados con Arma a dos manos. Las monturas obtienen la regla especial Impacto por carga (1, en una excepción a las reglas habituales, se suma a Caballería pesada) y en el turno que hayan cargado los jinetes podrán repetir los resultados de 1 en sus tiradas para impactar en combate cuerpo a cuerpo.</description>
            </rule>
            <rule name="Hijos de Manann" id="e24f-6208-61ca-52ce" hidden="false">
              <description>van equipados con Lanza y Escudo. Obtienen la regla especial Cruzar (Elementos acuáticos) e ignoran el penalizador al Movimiento por la Barda. Los ataques realizados con Lanza por los Hijos de Manann tienen la regla especial Impactos múltiples (2). Los Templarios a pie deben equiparse con Lanza y Escudo, y no podrán elegir otro equipo.</description>
            </rule>
            <rule name="Caballeros de la Luz Eterna" id="ea13-aac7-39de-3660" hidden="false">
              <description>van equipados con Lanza de caballería, Arma a dos manos y Escudo. Obtienen las reglas especiales Sangre fría y Odio (¡todos los enemigos!). En el turno que realizan una carga exitosa, contarán con la regla especial Poder de penetración y Ataques mágicos.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampírircos menor. No General vampiro" id="0ae6-ec19-16a8-7cb7" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="7ac0-d1e6-10fb-56c3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="6076-48e5-7e1c-a723" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Atormentado de la muerte" id="f4fb-e9ea-5570-3a94" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="889f-18a6-c928-bce0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ed3f-bb77-48e7-61fe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Esquivar (5+)" id="e4d9-99e5-8bec-2cc2" hidden="false" targetId="053b-3b96-b53b-6944" type="rule"/>
            <infoLink name="Indesmoralizable" id="09c4-a08f-346c-28da" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Atormentado de la muerte" id="f256-f85d-e10c-ef35" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El personaje obtiene las reglas especiales Indesmoralizable y Esquivar (5+), aunque no puede unirse a unidades, ni portar objetos mágicos, ni ser el General del ejército.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Poderes vampírircos Mayores" id="3a30-4722-f73d-ccb9" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Romper la defensa" id="dd0d-2d2f-fd1e-f136" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3f20-97de-004b-2b40" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="86b4-33c4-42e0-da1f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
