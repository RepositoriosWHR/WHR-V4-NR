    <selectionEntry name="Caballeros de la Luz Eterna (Dragón Sangriento)" id="33f1-bc26-9f9b-625a" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="ec89-63fa-2747-d190" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
