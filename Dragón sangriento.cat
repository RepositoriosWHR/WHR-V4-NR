            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="1920-5a7c-034e-6125" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Drenadora de sangre" id="9443-e636-38a0-c13e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos de la Drenadora de Sangre se resuelven con +1F. Por cada herida causada en cuerpo a cuerpo con esta espada, el portador podrá restablecer una de las heridas que hubiese sufrido con anterioridad durante la batalla. Esto sustituye a la regla habitual de recuperar heridas por la regla especial Vampiro.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
