              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto legendario. El portador (y la unidad en la que se encuentre) pasan a ser Indesmoralizables (esto sustituye su 
Inestabilidad).</characteristic>
