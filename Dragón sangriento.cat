      </infoLinks>
      <rules>
        <rule name="Magia Señor de vampiros Dragón Sangriento" id="37f3-bb6d-6d31-5bae" hidden="false">
          <description>Es un hechicero de nivel 1 que puede convertirse en hechicero de nivel 2 por +30 puntos. Puede elegir sus hechizos de uno (y solo uno) de los Saberes de la Muerte, las Sombras, Magia Oscura o Nigromancia.</description>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="4b66-6310-8c1f-4bb6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
      </rules>
