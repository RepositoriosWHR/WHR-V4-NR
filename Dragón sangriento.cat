              <profiles>
                <profile name="Espada negra de Aquitania" id="0162-3e5d-6e2f-a013" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques con este arma se resuelven con un bonificador de +2 a su Fuerza. Además, todos los resultados de 6 en las tiradas para herir con la espada tienen la regla especial Heridas múltiples (1D6).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
