      <rules>
        <rule name="Nube de moscas" id="3e03-6706-1267-3a4c" hidden="false">
          <description>Todos los disparos y los ataques cuerpo a cuerpo contra un personaje montado en un Dragón zombi anciano tendrán un penalizador de -1 a su tirada para impactar.</description>
        </rule>
        <rule name="Monstruosidad ancestral" id="ba55-382e-3c79-6291" hidden="false">
          <description>El alcance del Terror que causa un Dragón zombi anciano es de 12” en lugar de las 8” habituales.</description>
        </rule>
        <rule name="Bocanada putrefacta" id="2ace-9442-6398-b274" hidden="false">
          <description>El Dragón zombi anciano tiene un Arma de aliento de Fuerza 3 que no permite salvación por armadura.</description>
        </rule>
      </rules>
