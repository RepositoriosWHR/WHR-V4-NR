          <conditions>
            <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Caballeros Encarnados" id="e099-ae21-1c16-ac70" hidden="false">
          <description>Los Caballeros del Dragón Sangriento van equipados con Armas emparejadas funerarias. En combate cuerpo a cuerpo, ganan un bonificador de +1 a su tirada de salvación por armadura. El Señor de los Vampiros y la unidad en la que esté obtendrán la regla especial Golpe letal con su ataque otorgado por su Arma de mano adicional.</description>
        </rule>
      </rules>
      <selectionEntries>
