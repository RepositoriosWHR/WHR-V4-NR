    <selectionEntry name="Caballeros del Lobo Blanco (Dragón Sangriento)" id="f75a-709c-639a-214a" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="1f82-5dea-3aa2-2964" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
