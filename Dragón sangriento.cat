              </conditions>
            </modifier>
          </modifiers>
        </infoLink>
        <infoLink name="No muerto" id="88ff-fcc3-e25e-9a48" hidden="false" targetId="3d39-5d46-7335-225c" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(1)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <rules>
        <rule name="Melodía fúnebre" id="2cdc-c6ad-94c3-7638" hidden="false">
          <description>Se trata de un ataque de disparo con un alcance de 8” con la regla especial Disparo rápido que impacta automáticamente. Tira 2D6+2 y resta el Liderazgo del objetivo: esas son las heridas causadas sin tirada de salvación por armadura. El Bardo puede usar su Melodía fúnebre incluso si se encuentra en trabado en combate cuerpo a cuerpo, aunque sólo contra la unidad con la que se encuentra combatiendo y el impacto siempre afectará a la unidad enemiga.</description>
        </rule>
        <rule name="Melodía de combate" id="a685-ef45-2584-b1f0" hidden="false">
          <description>El Bardo puede lanzar el hechizo Danza Macabra de Vanhel como si fuese un objeto portahechizos de nivel de energía 2. Este se lanzará en su versión no potenciada, afectará sólo a la unidad a la que esté unido el Bardo y no podrá usar la Melodía revigorizante en el mismo turno en el que haya usado esta melodía.</description>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="4b66-6310-8c1f-4bb6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
        <rule name="Melodía revigorizante" id="68ee-3f2f-a53f-6a04" hidden="false">
          <description>El Bardo puede lanzar el hechizo Invocación de Nehek como si fuese un objeto portahechizos de nivel 2. Este se lanzará en su versión no potenciada, afectará sólo a la unidad a la que esté unido el Bardo y no podrá usar la Melodía de combate en el mismo turno en el que haya usado esta melodía.</description>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="4b66-6310-8c1f-4bb6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
      </rules>
