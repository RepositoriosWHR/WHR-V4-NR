          <infoLinks>
            <infoLink name="Arma de mano" id="e42f-581a-5cc3-4ab6" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espada de la maldición eterna" id="a52a-c3ba-41d6-1c4f" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Si el portador causa al menos una baja al atacar con esta arma podrá restaurar un dado de invocación a la unidad en la que esté el personaje como si se tratase del hechizo Invocación de Nehek del saber de la Nigromancia. El portador puede beneficiarse de este efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Matabrujas" id="0363-3caf-5b3a-5ec9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="46bb-7fab-15ae-8d87" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0b7b-8a88-9397-6141" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="53d1-f4f1-dcad-19bf" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Golpe letal" id="42ed-3543-2e9b-cb77" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Matabrujas" id="be39-c3ad-b52f-852c" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Sus impactos se resuelven con la regla especial Golpe letal. Si el portador elimina a un enemigo con niveles de magia en combate cuerpo a cuerpo, gana inmediatamente un nivel de magia adicional (hasta un máximo de 4). Genera inmediatamente el nuevo hechizo que proporciona dicho nivel.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Drenadora de sangre" id="234c-3894-0493-a6a0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="da97-f37f-bee2-b602" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="38f9-ea25-259a-0f47" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
