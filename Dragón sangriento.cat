            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bandera de la Torre sangrienta" id="790a-c37d-de83-055f" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Vampiros. Proporciona al portador (y a la unidad en la que se encuentre) una tirada de salvación especial de 4+ contra proyectiles mundanos y mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Clan dragón sangriento. Tumularios" id="f8b0-984d-7acf-7769" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="f583-0dbe-34cc-2a82" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="190a-6ede-8820-d68d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Estandarte de los túmulos" id="131e-0559-e336-48b9" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="7708-8238-ceb6-4117" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c22d-2257-2708-5d7a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
