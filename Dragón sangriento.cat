        <rule name="Magia Ilderkart" id="4a5b-22cf-8f90-b8db" hidden="false">
          <description>Ildekart es un hechicero de nivel 2 que puede elegir sus hechizos del saber de Nigromancia.</description>
        </rule>
        <rule name="Vitalidad sobrenatural" id="321d-ce2c-b75f-405c" hidden="false">
          <description>Ildekart recupera heridas gracias su regla especial Vampiro con un resultado de 4+, en lugar del habitual 5+. Además, posee la regla especial Regeneración (5+).</description>
        </rule>
      </rules>
