      </costs>
      <rules>
        <rule name="Caballeros del León Dorado" id="62a4-9de5-f537-c345" hidden="false">
          <description>Obtienen una tirada de salvación especial de 5+ contra proyectiles y hechizos del tipo Proyectil mágico. La Caballería Tumularia van equipados con Lanza de caballería funeraria y Escudo. El Señor de los Vampiros posee una tirada de salvación especial de 4+ contra proyectiles y hechizos del tipo Proyectil mágico, la cual otorga a la unidad en la que se encuentre.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Escudo" id="533d-471e-f107-e821" collective="false" hidden="false" import="true" type="upgrade">
