            <profile name="Espada del honor" id="3c47-3dfb-3730-f715" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo Vampiros. Arma de mano. Los impactos con este arma se resuelven con un bonificador de +1F. Si el portador está combatiendo con este arma en un desafío puede repetir todas sus tiradas para impactar y herir fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
