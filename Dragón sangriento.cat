            <profile name="Estandarte de los túmulos" id="b83e-1b8b-9c98-d388" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Tumularios y Caballería tumularia. Todas las miniaturas con la clave tumularios en la unidad obtienen un bonificador de +1 en sus tiradas para impactar en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bandera sangrienta" id="794e-f87b-93f4-bfd1" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="4b27-1ba8-c6c3-c235" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="af09-9fc7-fb80-cd6b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bandera sangrienta" id="731f-7f0b-30d0-9f1c" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Tumularios o Caballería tumularia. La regla especial Golpe letal de los tumularios de la unidad (concedida por sus Armas funerarias) tendrá efecto con un resultado de 5+ en la tirada para herir, en lugar del habitual 6+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
