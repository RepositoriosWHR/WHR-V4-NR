              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo vampiros. La unidad nunca perderá la regla especial Furia Asesina aunque sea derrotada en combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bandera de la Torre sangrienta" id="0450-64a6-96f4-8b91" collective="false" hidden="false" import="true" page="0" type="upgrade">
