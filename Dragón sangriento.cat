              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro y su unidad no verán su movimiento reducido por llevar Barda.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gran caballero de Kislev" id="9db1-74bb-b0d3-7414" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9453-e37f-12cb-9873" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5ecf-427a-81fe-ec27" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Apabullar" id="57ea-32a9-11b9-1b94" hidden="false" targetId="205f-210b-5422-1e61" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Gran caballero de Kislev" id="9f58-c1e7-6136-7636" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">Cualquier unidad que reciba una carga exitosa de un vampiro con esta regla especial debe superar un chequeo de Liderazgo o quedará Apabullada hasta el final del turno del jugador en curso. Esto no afecta a unidades Inmunes a la psicología. Además, el vampiro y su unidad podrán repetir las tiradas para determinar la distancia de carga. La unidad y el vampiro no podrán equiparse con armadura de placas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Matadragones" id="30cd-2e15-99a8-9668" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="13fe-fc74-e177-72f8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="87ba-70b8-cffd-412d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Golpe letal heróico" id="bc54-46f0-32aa-fc9c" hidden="false" targetId="95ce-f21a-29e1-42a2" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Matadragones" id="d7bd-4529-7476-2cbe" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El personaje obtiene la regla especial Golpe letal heroico contra miniaturas con la clave dragón. Esto puede usarse en conjunción con un arma mágica. Además, si elimina a un dragón  gracias a un Golpe letal heroico exitoso, restaura todas las heridas que hubiese sufrido durante la batalla, y obtiene una herida adicional en su perfil de atributos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Odio sin límites" id="bc3e-ea0b-7f77-b9d2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9715-921a-7c2b-590a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d932-1460-5272-d391" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio (todos los enemigos)" id="ebee-55c7-2cdd-411f" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Odio sin límites" id="9f2e-59d8-f863-ebfb" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro obtiene la regla especial Odio (¡todos los enemigos!).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Golpe maestro" id="8217-61e2-df69-34da" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aa52-77a8-5f79-0972" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8a75-5984-63b1-3983" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Golpe letal heróico" id="fec8-0bb5-b4b8-a306" hidden="false" targetId="95ce-f21a-29e1-42a2" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Golpe maestro" id="6ca1-ad83-2c3e-aae2" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">El vampiro puede sustituir todos sus ataques en combate cuerpo a cuerpo por uno sólo con la regla Golpe letal heroico y que puede repetir sus tiradas fallidas para herir. Puede utilizarse en combinación con un arma mágica pero no se podrá realizar más de un ataque por ninguna razón si se usa el Golpe maestro.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espadachín consumado" id="79fe-f83d-1bdd-5ff0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e76d-2213-f1fb-22a0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ffbb-f637-3fa4-eefc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Espadachín consumado" id="6085-a0b7-87e6-465f" hidden="false" typeId="f71e-06e9-0083-adc2" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="fe48-4f75-7c89-9325">Al inicio de cada fase de combate cuerpo a cuerpo, elige una miniatura en contacto peana con peana con el vampiro. Esa miniatura perderá un ataque esa fase (hasta un mínimo de 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La fuerza del acero" id="f162-87be-b3a8-0247" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4555-d2e6-5878-a623" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="019d-2f29-76e2-fd3e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Carga devastadora" id="df69-6048-4179-ff39" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
