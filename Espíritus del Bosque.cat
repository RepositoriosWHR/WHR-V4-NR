    <selectionEntryGroup name="Brotes ancestrales de Savia milenaria" id="f193-6ed4-85d1-3eaa" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Brote de la Raíz Serpenteante" id="7a38-7309-5a89-0428" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="876e-2c3a-2297-ccb9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="191f-89cc-a817-fae6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brote de la Raíz Serpenteante" id="e58c-7b7f-2b95-5504" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Un sólo uso. Puedes utilizarlo al final de cualquiera de tus fases de movimiento si el portador y su unidad se encuentran dentro de un Bosque, hay al menos otro Bosque en el campo de batalla y no se encuentran en contacto con una o más unidades enemigas. Retira la unidad del campo de batalla y colócala inmediatamente en el interior de otro Bosque del campo de batalla a tu elección: debes ser capaz de colocar la unidad completamente dentro del Bosque para hacer uso de este Brote Ancestral.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brote de Espina Sangrienta" id="a06a-f02c-f31e-6974" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="be0d-c9b5-ceff-347f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="053a-cca4-06ac-e352" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="50e1-d5c2-6a63-918a" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Brote de Espina Sangrienta" id="fc64-6ad6-3d21-6e20" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">La unidad gana la regla especial Ataques envenenados. Si una miniatura ya tiene esta regla especial, herirá automáticamente con resultados de 5+ para impactar en lugar de 6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brote de las Eras Olvidadas" id="2fd5-f50a-816a-e48f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a2e2-3a38-55a4-99d5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5e48-d8bc-fe83-bd3a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brote de las Eras Olvidadas" id="c5a2-a25a-ccac-381f" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Las unidades enemigas tendrán un penalizador de -1 para impactar en combate cuerpo a cuerpo contra el portador y su unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Raíz de Sangre de Savia" id="2367-cfd8-281d-0631" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4d99-5eb5-0d42-170d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="a19c-d328-0b49-18e2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Regeneración (5+)" id="1593-56e4-3a3f-613d" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Raíz de Sangre de Savia" id="24ad-9c3e-4c97-5fca" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">El portador y su unidad obtienen la regla especial Regeneración (5+) o aumenta en +1 si ya la tenían.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brote de la Primavera Eterna" id="e872-1349-36b4-ed7a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c625-ddf2-0304-546e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="36ad-4b45-7f38-f365" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brote de la Primavera Eterna" id="dfcc-beca-462b-e0c8" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Objeto portahechizos de nivel de energía 4. Contiene el hechizo Resurrección del Saber de la Vida en su versión no potenciada. Si la unidad objetivo del hechizo se encuentra en un Bosque (sigue las reglas de Elemento de área) el hechizo restaurará +1 herida adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Brotes ancestrales de Savia milenaria. Solo Espectro del bosque" id="ab34-c67c-bb10-37ec" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Brote del Roble Desgarrador" id="f459-4374-4bbe-4f5f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6189-2e90-7107-00e3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="f8d3-5d9d-0b50-40f2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Carga devastadora" id="6478-1421-873b-5059" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Brote del Roble Desgarrador" id="abd5-7feb-9767-c4a4" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Solo Espectro de los Árboles. El portador y cualquier miniatura en su unidad ganan la regla especial Carga Devastadora y podrán repetir los resultados 1 en sus tiradas para herir en combate cuerpo a cuerpo. Además, el Espectro de los Árboles puede repetir las tiradas para impactar y para herir cuando participe en un Desafío.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brote de Corteza de Hierro" id="a301-111f-8035-96f4" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="050e-dd42-0708-6b06" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="eb61-71c9-dc00-7345" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="65"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Piel escamosa (5+)" id="340f-7966-83f7-ce5c" hidden="false" targetId="b1c5-6add-797c-2d07" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Brote de Corteza de Hierro" id="2c8c-c165-9b90-80c9" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Solo Espectro de los Árboles. El portador y todas las miniaturas aliadas con la regla especial Espíritu del bosque situadas a 12” o menos del portador de este Brote Ancestral obtienen la regla especial Piel escamosa (5+) o +1 si
ya tenían esta regla especial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Rasgos, Duendes y Hadas de los Espectros" id="bb22-7686-0e1f-0986" collective="false" hidden="false" import="true">
      <constraints>
