    <selectionEntryGroup name="Brotes ancestrales de Savia joven" id="1bd4-6bc2-bddb-2fd0" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Brote del Árbol de los Susurros" id="8b38-8b4a-b46e-880c" collective="false" hidden="false" import="true" type="upgrade">
