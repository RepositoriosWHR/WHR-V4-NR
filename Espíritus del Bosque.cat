      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia de Andahu, el Sabio" id="cfbc-7636-5291-a845" hidden="false">
          <description>Adanhu es un hechicero de nivel de magia 4 que conoce todos los hechizos de los Saberes de la Vida y los hechizos Portento de Phar, Inspiración celestial y Segundo sello de Amul del Saber de los Cielos.</description>
        </rule>
        <rule name="Reverenciado" id="ecaa-5d96-b8fa-6fea" hidden="false">
          <description>Todas las miniaturas de tu ejército con la regla especial Espíritu del bosque situados a 12” o menos de Adanhu obtendrán la regla especial Tozudez.</description>
        </rule>
        <rule name="Extensión del Roble Eterno" id="fbc2-5f0e-474e-e485" hidden="false">
          <description>Todas las miniaturas de tu ejército con la regla especial Espíritu del bosque a 12” o menos de Adanhu obtendrán la regla especial Regeneración (5+ o +1 si ya disponían de la regla) y Resistencia mágica (1), que pasará a Resistencia mágica (3) contra hechizos del Viento de magia oscura.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="3064-6c86-c395-0adc" collective="false" hidden="false" import="true" type="upgrade">
