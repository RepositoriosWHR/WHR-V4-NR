          <infoLinks>
            <infoLink name="Furia asesina" id="a759-f6b4-cc06-1389" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Vástago del Roble Furioso" id="c013-c9af-bdb2-7d5c" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Las miniaturas de unidad que lo porten obtendrán la regla especial Furia asesina y si ya disponían de esta regla no perderán su Furia asesina aunque sea derrotada en combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vástago de Madera de Bruja" id="0ced-09d5-6dfe-3a25" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fdee-d467-3122-494e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="8f53-23de-2bd6-1284" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
