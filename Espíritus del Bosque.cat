              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Los ataques de proyectiles sin la regla especial Ataques mágicos tienen un penalizador de -1 en sus tiradas para herir contra las miniaturas de esta unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brote del Sauce Flexible" id="432d-d1d8-7ffe-8148" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6c73-dbce-0c5f-072b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="721a-ca89-c802-8971" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
