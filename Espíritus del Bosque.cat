          <profiles>
            <profile name="Brote del Sauce Flexible" id="db2e-1ee2-16f6-3a03" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">La unidad gana la Regla especial Espíritus astutos. Si ya tienen esta regla ganan la regla especial Veloz.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brote del Brezo Espinoso" id="6b7a-1249-cffc-b7cd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4a8b-f709-dc8c-dfcf" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="daf5-c2a8-1f47-5d91" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
