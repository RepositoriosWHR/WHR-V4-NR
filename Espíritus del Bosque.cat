              </entryLinks>
              <infoLinks>
                <infoLink name="Lanza (infantería)" id="9bfa-1777-2823-89e9" hidden="false" targetId="ea63-f860-d8f5-b7db" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Báculo del primero amanecer" id="8fdf-aa00-2743-ba47" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza. Adanhu obtiene un dado de energía adicional durante cada fase de magia y podrá repetir uno de los Dados de energía de cada una de las tiradas para lanzar o dispersar hechizos que efectúe. El poder de este arma es tal que no puede verse afectada o destruida por efectos que anulen o destruyan objetos mágicos</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Adanhu" id="c11d-1a0e-e3a9-bf3c" collective="false" hidden="false" import="true" type="model">
