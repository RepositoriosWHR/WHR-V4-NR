            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brote del Brezo Espinoso" id="2f8d-0a8a-456e-92dd" hidden="false" typeId="8b02-3ef3-2ac5-04a7" typeName="Brote ancestral">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="edd7-1c9a-1536-6195">Las unidades enemigas que declaren una carga contra esta unidad sufren un penalizador de 1D3” a su distancia de carga y se considera que cargan a través de Terreno Difícil.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vástago del Roble Furioso" id="a50b-fc08-ec76-3dfc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ac90-2564-8620-0bb0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="e707-87b7-fc5a-877b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
