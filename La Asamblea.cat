          <modifiers>
            <modifier field="name" type="append" value="(Zampamagia)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Cruzar (bosques)" id="27f5-13d3-15a0-a144" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
        <infoLink name="Esquivar (6+)" id="635c-c9b3-264c-c2c8" hidden="false" targetId="c905-72a4-c706-6a16" type="rule"/>
        <infoLink name="Odio" id="7db1-7e27-4644-d23a" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Goblins, solo gambo)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Gambo Hartstock" id="7535-9651-110e-0d94" hidden="false">
          <description>Gambo Hartstock es un hechicero de nivel de magia 4 que conoce todos los hechizos del Saber de Zampamagia.</description>
        </rule>
        <rule name="Batines de cocina" id="c7f6-3c5b-1fe2-282a" hidden="false">
          <description>La tirada de salvación por Esquivar de la unidad aumenta en +2 (para un total de 4+) contra disparos y hechizos del tipo Proyectil mágico.</description>
        </rule>
        <rule name="Sopero mayor" id="b3e5-c686-be59-0cf6" hidden="false">
          <description>Gambo tiene la regla especial Señor del conocimiento (Zampamagia). Además, conoce el hechizo Lamepucheros (ver más abajo). Adicionalmente, podrá repetir la tirada en uno de los dados de energía en una tirada de lanzamiento de hechizos cada fase de magia propia.</description>
        </rule>
        <rule name="Archienemigo de Gambo Hartstock" id="a8df-381f-8be3-caa5" hidden="false">
          <description>Si tu ejército incluye a Gambo Hartstock y el ejército enemigo incluye a Grom el Panzudo, obtendrás 100 puntos de victoria adicionales si lo eliminas.</description>
        </rule>
        <rule name="La Suprema" id="b90a-7703-5e78-4588" hidden="false">
          <description>Gambo Hartstock opera una Olla Caliente junto a Flabagon y Frito como dotación. La Olla Caliente dispone de todas las recetas de sopa: Sopa de asedio, Gran sopa de la abuela, Sopa clara, Sopa picante de Gambo Hartstock y Receta clásica (elige cuál vas a usar en cada disparo). Las demás Ollas Calientes del ejército podrán tener hasta una receta de la manera descrita en su entrada.</description>
        </rule>
        <rule name="Lamepucheros (Dificultad 6+)" id="2b64-ef19-8ac7-dc0d" hidden="false">
          <description>Se trata de un hechizo de potenciación que toma como objetivo al hechicero y su unidad y permanece un turno. Por la duración del conjuro, los disparos de la Olla caliente podrán repetir el dado de artillería y/o dispersión.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Gambo Hartstock" id="5040-0284-711c-c48d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b21c-b026-0ca9-81e3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
