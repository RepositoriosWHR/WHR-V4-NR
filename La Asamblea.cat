              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Aumenta en +1 la tirada de Esquivar del portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sal de la Asamblea" id="9e12-71a2-0fee-a49e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e39d-4d3c-b7a2-a022" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8ab4-6367-85d8-aae5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sal de la asamblea" id="010e-6f29-74a5-5c24" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Al comienzo de la batalla, tira 1D3. Ese será el número de repeticiones que el portador podrá realizar en sus tiradas de Esquivar fallidas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Insignia al valor" id="08c3-64be-daa4-cac1" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="804e-9fb9-9656-8820" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="260f-8e76-c298-5843" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
