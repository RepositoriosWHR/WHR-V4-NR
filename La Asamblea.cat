            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de la suerte" id="25e1-4d0a-ab5f-d39b" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador podrá repetir una tirada para impactar, herir, chequeo de atributo o salvación (de armadura o de Esquivar) una vez por turno de jugador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. La Asamblea. Hechiceros" id="99b6-325a-2a33-687b" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="535a-b337-be33-fd7b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="d855-4240-e63d-1d5c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Sombrero de prestidigitador" id="bb1b-5da4-9cf1-4e2c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d9e3-2719-5364-d5dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="15a5-f1b2-49f5-ad13" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (1)" id="057b-703c-7fd2-1488" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Sombrero de prestidigitador" id="b3f0-bcf5-ce00-804f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Hechicero Halfling y Gran Hechicero Halfling. El hechicero obtiene la regla especial Resistencia mágica (1). Además, obtendrá un bonificador de +1 en sus tiradas para dispersar hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cuadernillo de notas arcanas" id="0c2a-01a1-dd9c-2d7d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5e31-a120-c975-7412" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7fb4-23f8-20b7-2e86" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cuadernillo de notas arcanas" id="9cef-bb68-1af4-f5aa" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Hechicero Halfling y Gran Hechicero Halfling. Selecciona uno de los hechizos que conozca el hechicero al inicio de la batalla. Siempre que el portador intente lanzar ese hechizo, podrá repetir uno de los dados de la tirada de lanzamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. La Asamblea. Cocineros" id="47a2-045b-f132-8a79" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e101-998b-0c3e-10b2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7aec-2a5f-46e7-b71c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Libro culinario" id="df70-a05e-7d0f-eb82" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f899-d435-5165-0132" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a728-69a6-1c5f-c531" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Libro culinario" id="2b3f-3e48-e19b-d855" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Cocinero o Gran Cocinero. Solo tres usos. Puedes decidir usar el recetario después de realizar cualquier tirada de lanzamiento de hechizos para aumentar en +2 el valor de la tirada del lanzamiento del hechizo (lo cual puede convertir un fallo en un éxito).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Gorro de chef" id="8d0a-d83f-e205-eb6f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="71b0-f9af-2b11-d323" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8d0c-4db5-57bc-689c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Gorro de chef" id="cd5b-3700-8649-8cb1" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Cocinero y Gran Cocinero. El hechicero conoce un hechizo adicional, y obtendrá un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Reliquias. La Asamblea" id="f4b8-4ceb-3397-cb55" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="a2d4-c357-fb1f-0753" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="34ed-6b56-54f0-16c7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="El Libro de Sabios Consejos de Bimbo" id="4af4-49ba-e0e4-9393" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="78bd-d60b-10d3-d12e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d28f-f3c8-772d-6f48" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="aa18-2c90-a04d-81ad" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="El libro de sabios consejos de Bimbo" id="ab08-58d0-5ec5-ab1c" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador deberá ser desplegado junto a una unidad de Milicia, Arqueros, Honderos, Batidores, Patrulla Sylvana o Pequeños espaderos. Al comienzo de la batalla, tras el despliegue, deberán elegir uno de los siguientes beneficios (el cual conservarán durante toda la batalla): repetir las tiradas fallidas para Esquivar, repetir sus tiradas fallidas para impactar en combate cuerpo a cuerpo o repetir los resultados de 1 en sus tiradas para impactar con proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bellota mágica" id="81c1-3e17-173e-19bd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9141-e6d1-e26d-3fcd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9a2d-b555-a63c-47b3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="b022-f5ae-633b-7725" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Bellota mágica" id="24e0-636e-400f-104e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un solo uso. Puedes utilizarla al comienzo de cualquier fase de combate. Designa una única miniatura en contacto peana con peana con el portador. La miniatura que sea designada deberá realizar inmediatamente un chequeo de Iniciativa. Si lo falla, deberá ser retirada como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. La Asamblea" id="d482-2561-6c97-f279" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c4bd-ea9f-b9d1-fe2a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="031a-4977-db79-b719" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Empanada milagrosa" id="2625-53b3-16d3-1661" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a474-618b-4b94-3c1a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e4a6-2dd7-164d-385e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Empanada milagrosa" id="0647-f4b9-5d83-5bfe" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Al inicio de cualquier turno (tanto propio como del oponente) el personaje restablecerá hasta tres heridas que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sopa de la Yaya" id="5cec-e2fe-1e4a-c146" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0dc6-e9da-e879-c369" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="175d-09ac-ab61-4914" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sopa de la yaya" id="f6bf-3df2-0e99-a50a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo dos usos. El portador puede tomar la poción al inicio de cualquier fase de combate cuerpo a cuerpo, propia o del oponente. Al tomar la poción, el portador recupera inmediatamente una herida que hubiese perdido previamente durante la batalla, y hasta el final de dicha fase de combate, el portador obtendrá un bonificador de +1 a sus atributos de Fuerza y Ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. La Asamblea. No infantería" id="2a4a-4253-3a5e-b3e0" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4b98-9a05-6db8-68cf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="4b4e-020b-3c5b-ea6f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="El Cencerro de Samgaff" id="4992-7960-18f9-8291" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9769-1495-51b7-1034" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="98ea-52e1-efac-d76c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El cencerro de Samgaff" id="b142-26ad-0df6-2787" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Solo miniaturas con montura. El portador y su unidad podrán repetir cualquier chequeo de Liderazgo fallido que realicen (psicología -Miedo, Terror y Pánico-, desmoralización, reagruparse, reformarse y cualquier otro chequeo de Liderazgo). Adicionalmente, tendrá un bonificador de +1 a sus chequeos de reagrupamiento.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
