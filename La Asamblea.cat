            <profile name="Presea de pureza" id="4936-ab9b-bcbf-5dcc" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El personaje obtiene la regla especial Inmune a veneno y será inmune a los efectos de la regla Golpe letal (aunque los ataques le podrán causar heridas con normalidad). Además, al inicio de cada uno de tus turnos podrá recuperar una herida sufrida previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. La Asamblea" id="ca51-1bbc-08c4-fe65" collective="false" hidden="false" import="true">
      <constraints>
