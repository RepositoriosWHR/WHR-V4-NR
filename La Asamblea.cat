              <profiles>
                <profile name="Receta original" id="f1ff-d44f-3e75-5045" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">La Olla Caliente dispara como una catapulta (esta es la receta original), salvo que su alcance es 0”-24”. Utiliza la plantilla redonda pequeña, tiene F3 y niega la tirada de salvación por armadura. El impacto central tiene F6 y la regla especial Heridas múltiples (1D3).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
