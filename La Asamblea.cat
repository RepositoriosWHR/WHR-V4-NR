      <infoLinks>
        <infoLink name="Infantería" id="db96-77d4-7666-3dfe" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Esquivar (4+)" id="0e87-ebd6-74e1-c01d" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink name="Cruzar (bosques)" id="8723-219d-cf78-0b4e" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
