              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arco. Tiene la regla especial Disparos múltiples (X), donde X es el valor de Ataques del portador. Además, los disparos realizados con este arco obtienen un bonificador de +1 en sus tiradas para herir contra Monstruos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
