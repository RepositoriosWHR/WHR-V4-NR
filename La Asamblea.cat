          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="5c8c-e47e-ceaf-3147" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
              </conditions>
            </modifier>
          </modifiers>
          <rules>
            <rule name="Recetas" id="2052-8459-adef-0803" hidden="false">
              <description>Si tu ejército incluye al menos un Cocinero o Gran cocinero, cada Olla caliente de tu ejército puede elegir una de las siguientes recetas al coste indicado; la Olla podrá disparar con la receta original o con la receta
elegida (elige cada vez que vayas a disparar). Tu ejército no puede tener dos Ollas calientes con la misma receta especial.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Sopa de asedio" id="ab7f-bfb4-8090-0f61" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="eccd-0e95-8dcb-1d14" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="7af6-55ff-d320-4a93" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="5"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Sopa de asedio" id="ef46-09f6-f6ed-9aa3" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con Sopa de asedio dispara con Fuerza 1D6 (tira cada vez que dispares) en lugar de Fuerza 3; sigue negando la tirada de salvación por armadura. El impacto central no se ve afectado.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sopa picante de Gambo Harstock" id="5dcf-2c95-ad05-c1f2" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="3902-3989-ea57-60c0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="2f3a-fa43-97d9-a31b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="5"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Sopa picante de Gambo Harstock" id="eaf7-bf2f-d6df-a76e" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con esta receta dispara exactamente igual que la receta original, y las heridas que causa la plantilla no permiten tiradas de Regeneración. Cualquier unidad que sufra al menos una baja de la Sopa picante de Gambo Harstock deberá efectuar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sopa de la abuela" id="c8f4-d3eb-cd22-73d7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="482c-f08b-5818-fab1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="a1bd-b9ae-49ae-660b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="5"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Sopa de la abuela" id="070c-4fe3-a1d3-19c5" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con esta receta verá su alcance reducido a 0-18”, pero utiliza la plantilla redonda grande en lugar de la pequeña. Por lo demás, se trata exactamente igual que la receta original.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sopa clara" id="ff5c-6164-0060-7bb2" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="17a4-fd96-8853-41f3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
                <constraint id="cc30-e0b1-b9cc-a784" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="5"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Sopa clara" id="a55c-d2d3-bbaa-5351" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con esta receta dispara exactamente igual que la receta original, salvo que lo hace con Fuerza 2 y tiene un alcance de 6-30”. Por lo demás, se trata exactamente igual que la receta original.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
