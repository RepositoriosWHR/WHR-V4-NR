    <selectionEntryGroup name="Remoquetes. Aventurero halfling" id="7c6c-507a-ddee-4027" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5180-e848-846b-a2c1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="f214-5a84-4d68-95a3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="El Exorcista" id="776c-87f3-21cd-9cfd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="befe-1308-02a3-3f91" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0749-e3a0-bdd3-e47d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques mágicos" id="5ab5-8971-7a8d-d9e4" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Ataques flamígeros" id="1615-851b-beb5-6092" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Resistencia mágica (1)" id="e209-5743-0326-ed8b" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
            <infoLink name="Odio (todos los enemigos)" id="f269-6381-35a7-b2c1" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="El Exorcista" id="fa6c-5a72-b38a-20b9" hidden="false" typeId="7828-c6dc-75df-a355" typeName="Remoquete">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="710d-732d-70f9-5416">Solo Aventurero halfling. El personaje está equipado con una Pistola, Estaca (Arma de mano, Golpe letal contra miniaturas con la regla especial Vampiro), y obtiene las reglas especiales Ataques mágicos, Ataques flamígeros, Resistencia a la magia (1) y una tirada de salvación especial de 5+ más contra Ataques mágicos. Además, las miniaturas con la regla especial Vampiro tendrán un penalizador de -1 para impactar al personaje en combate cuerpo a cuerpo. Adicionalmente, él y la unidad a la que sea asignado al comienzo de la batalla tendrán la regla especial Odio (¡todos los enemigos!). Sin embargo, no podrá estar en la misma unidad que un personaje con niveles de magia ni equiparse con objetos mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntries>
            <selectionEntry name="Equipo" id="7c73-f208-42e3-4f4f" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="d11f-76aa-494b-7ba6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="18c5-9e77-a165-8b3d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Pistola (Disparo)" id="863c-e171-7dc2-f19a" hidden="false" targetId="9c4d-f670-7b68-06b1" type="profile"/>
                <infoLink name="Pistola (Combate)" id="d733-8ebf-0e0c-9e5c" hidden="false" targetId="85e6-12f1-81f5-f299" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Estaca" id="cb5a-8fd1-1964-aa08" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
                  <characteristics>
                    <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
                    <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
                    <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Arma de mano, Golpe letal contra miniaturas con la regla especial Vampiro)</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="El Cantamañanas" id="4068-9f04-35dc-b7c3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6a08-86af-4d54-fe91" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0871-79a5-db6a-add7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="El Cantamañanas" id="30a3-148b-b4c7-e3fc" hidden="false" typeId="7828-c6dc-75df-a355" typeName="Remoquete">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="710d-732d-70f9-5416">Solo Aventurero halfling. El personaje cuenta como Músico; solo podrá equiparse con Armadura ligera y tan solo podrá usar Honda y Arma de mano como opciones de armamento (tanto mágicas como mundanas). Al inicio de cada turno propio en el que el personaje no esté huyendo, el Cantamañanas puede entonar una canción. No puede repetir la misma canción dos veces consecutivas. El personaje y la unidad que lo acompañe recibirán sus beneficios hasta el inicio de su próximo turno o hasta que el personaje sea retirado como baja:
-La Canción del Nubarrón: El personaje y su unidad obtienen la regla especial Inmunes a Psicología, y podrá repetir sus chequeos de Liderazgo fallidos.
-La Saeta que Embrocheta: El personaje y su unidad obtienen la regla especial Disparo rápido. Adicionalmente, la unidad podrá utilizar sus armas de proyectiles aunque se reorganice ese turno.
-La Romanza de la Pitanza: El personaje y su unidad podrán repetir los resultados de 1 en sus tiradas para impactar (tanto con proyectiles como en cuerpo a cuerpo).
-El Cantar del Agachar: Todos los impactos que tengan un valor de Fuerza dirigidos contra el personaje o su unidad tendrán un penalizador de -1 en sus tiradas para herir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
