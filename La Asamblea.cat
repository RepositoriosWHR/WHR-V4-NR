        <infoLink name="Ataques mágicos" id="60ca-0494-ab1f-f0c7" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
        <infoLink name="Objetivo grande" id="dbd7-7cc1-0341-778e" hidden="false" targetId="71eb-6467-3a39-bdb6" type="rule"/>
        <infoLink name="Protección por montura (2)" id="28ba-9426-eb3e-00cd" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
      </infoLinks>
