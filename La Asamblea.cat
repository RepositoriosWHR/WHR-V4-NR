              <characteristics>
                <characteristic name="Reglas especiales" typeId="710d-732d-70f9-5416">El personaje obtiene un bonificador de +1 en sus tiradas para impactar en cuerpo a cuerpo y obtiene la regla especial Orgullo marcial.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
