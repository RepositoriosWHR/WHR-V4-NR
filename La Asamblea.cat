      <rules>
        <rule name="Magia Hechicero halfling" id="622a-5fb3-28f1-7fe4" hidden="false">
          <description>Nivel de magia 1. Puede aumentarse a 2 por +30 puntos. Debe elegir solo un saber de la magia de entre los siguientes: Fuego, Vida, Sombras, Cielos o Luz.</description>
        </rule>
      </rules>
