          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Marta Candela" id="93a6-49fd-d2c2-16dd" hidden="false">
          <description>Marta Candela es una hechicera de nivel de magia 4 que conoce todos los hechizos del Saber de las 
Sombras.</description>
        </rule>
        <rule name="Organización sinuosa" id="e488-97a0-08f7-b178" hidden="false">
          <description>Antes de empezar la batalla, tras el despliegue, puedes retirar del campo de batalla una única unidad de tu ejército y volver a situarla en cualquier otra parte de tu zona de despliegue.</description>
        </rule>
      </rules>
      <selectionEntries>
