                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con esta receta dispara exactamente igual que la receta original, salvo que lo hace con Fuerza 2 y tiene un alcance de 6-30”. Por lo demás, se trata exactamente igual que la receta original.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Receta original" id="b7c5-33d5-c655-e69f" collective="false" hidden="false" import="true" type="upgrade">
