            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <rules>
            <rule name="Recetas" id="c4d2-3b2b-9139-1bfb" hidden="false">
              <description>Si tu ejército incluye al menos un Cocinero o Gran cocinero, cada Olla caliente de tu ejército puede elegir una de las siguientes recetas al coste indicado; la Olla podrá disparar con la receta original o con la receta elegida (elige cada vez que vayas a disparar). Tu ejército no puede tener dos Ollas calientes con la misma receta especial.</description>
            </rule>
          </rules>
          <selectionEntries>
            <selectionEntry name="Sopa de asedio" id="da09-fec6-4ef3-edbc" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0016-0757-22d3-55e1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="c489-0c61-8aa5-4c7e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Sopa de asedio" id="7596-2661-ef2c-c0d7" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con Sopa de asedio dispara con Fuerza 1D6 (tira cada vez que dispares) en lugar de Fuerza 3; sigue negando la tirada de salvación por armadura. El impacto central no se ve afectado.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sopa de la abuela" id="b436-ab9c-6ce8-e7b0" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="6ee4-2fb8-416e-8c0c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="fc7f-b69d-5d31-a55c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Sopa de la abuela" id="9cee-03df-b1a0-3bbc" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con esta receta verá su alcance reducido a 0-18”, pero utiliza la plantilla redonda grande en lugar de la pequeña. Por lo demás, se trata exactamente igual que la receta original.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sopa picante de Gambo Harstock" id="6eff-d859-2326-6b54" collective="false" hidden="false" import="true" type="upgrade">
