            <profile name="Mondadientes rúnico" id="4099-bf9b-3658-d849" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Solo Gran Capitán Halfling. Las heridas causadas por este arma no permiten tirada de salvación por armadura y herirán siempre con un resultado de 4+ sin importar la resistencia del objetivo (a menos que su tirada para herir fuese mejor).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
