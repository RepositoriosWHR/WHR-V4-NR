            <profile name="El tracas" id="7a61-676a-0d9c-eee9" hidden="false" typeId="7828-c6dc-75df-a355" typeName="Remoquete">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="710d-732d-70f9-5416">Siempre que el personaje vaya a combatir en un desafío, al comienzo de cada ronda de combate, ambos personajes deberán realizar una tirada en 1D6 y sumar sus respectivos valores de Liderazgo. Si el personaje Halfling obtiene un resultado mayor que el de su oponente, le restará un ataque (hasta un mínimo de 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
