          <profiles>
            <profile name="Estandarte de las cabras de justa" id="34c1-02cb-5d12-704c" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Jinetes de Asalto. El portador y su unidad no perderán la regla especial Caballería rápida en el caso de tener la regla especial Caballería pesada debido a la regla Coraceros. Además, los Carneros de asalto de la unidad podrán repetir sus tiradas fallidas para herir durante los turnos en los que realicen una carga exitosa.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
