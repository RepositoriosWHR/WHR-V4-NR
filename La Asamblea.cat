            <constraint id="e571-bdb7-5728-f6c6" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Resistencia mágica (2)" id="24ab-962f-3649-2820" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
            <infoLink name="Esquivar (3+)" id="f3ed-e639-0cf7-9688" hidden="false" targetId="3510-e99d-a516-84bb" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Anillo de ocultación" id="70aa-b765-c378-ad0e" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Sólo miniaturas de infantería sin niveles de magia. Puedes activar el poder oculto del anillo al inicio de cualquiera de tus turnos y su efecto permanecerá hasta el inicio de tu siguiente turno. Mientras el poder del anillo esté activo, el personaje obtiene la regla especial Resistencia mágica (2), la regla especial Esquivar (3+) y las miniaturas que no tengan las claves no muertos o demonios sólo podrán impactar al portador en cuerpo a cuerpo con resultados naturales de 6+. Además, tampoco podrán seleccionarlo como objetivo de disparos o hechizos del tipo proyectil mágico. Adicionalmente, el portador podrá abandonar la unidad en la que se encuentre (e incluso destrabarse de un combate) durante la sub-fase de resto de movimientos propia sin que la unidad vea penalizada su capacidad de movimiento durante esa fase. Sin embargo, cada vez que el poder oculto del anillo sea activado, el portador deberá superar un chequeo de Liderazgo aplicando un penalizador de -1 por cada vez que haya sido usado previamente durante la batalla; no podrá beneficiarse del liderazgo de ningún otro personaje ni de la regla especial ¡Ni un paso atrás! para realizar ese chequeo. Si lo falla, sufrirá un impacto automático de F5 que niega todas las tiradas de salvación y Regeneración, tras lo cual deberá huir inmediatamente en dirección al borde de la mesa más cercano como si hubiese fallado un chequeo de Pánico (el personaje abandonará su unidad sin que ésta sufra ningún efecto adverso).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. La Asamblea. Jinetes de Asalto" id="da49-60c1-9fa0-f942" collective="false" hidden="false" import="true">
