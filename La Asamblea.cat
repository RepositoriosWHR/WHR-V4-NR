              <profiles>
                <profile name="Sopa picante de Gambo Harstock" id="3b28-96f9-fc72-51d1" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Una Olla caliente con esta receta dispara exactamente igual que la receta original, y las heridas que causa la plantilla no permiten tiradas de Regeneración. Cualquier unidad que sufra al menos una baja de la Sopa picante de Gambo Harstock deberá efectuar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Sopa clara" id="872e-db35-e1fc-7833" collective="false" hidden="false" import="true" type="upgrade">
