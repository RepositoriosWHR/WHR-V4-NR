            <profile name="El sereno" id="ec05-1b2b-e15f-b324" hidden="false" typeId="7828-c6dc-75df-a355" typeName="Remoquete">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="710d-732d-70f9-5416">Solo personajes sin niveles de magia. Los enemigos que ataquen en cuerpo a cuerpo al personaje deberán imponer un penalizador de -1 a la tirada para impactar. Sin embargo, el personaje obtiene la regla especial Estupidez.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
