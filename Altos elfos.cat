              <profiles>
                <profile name="Senda de Asuryan" id="fc7f-9f53-396e-2d39" hidden="false" typeId="a20d-ec9e-719a-2f03" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6569-81ae-e853-4fb3">Le proporciona la regla especial Resistencia mágica (3), y aumenta su tirada de salvación especial por la Bendición de Asuryan hasta 3+. Esta senda es única, y sólo Caradryan puede poseerla.</characteristic>
                  </characteristics>
