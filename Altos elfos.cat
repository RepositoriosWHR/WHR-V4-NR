                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza de caballería. Los ataques realizados con este arma se resuelven con un bonificador de +1 a la Fuerza y niegan la tirada de salvación por armadura.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
