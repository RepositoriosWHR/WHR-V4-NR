    <selectionEntry name="[E] - Korhil de Cracia, capitán de los leones blancos" id="222b-8f72-b458-d5a7" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="90b6-3f81-7735-93a6" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
        <categoryLink name="Personajes" id="3e36-e69c-04e9-3dd5" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
