              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Objeto legendario. El portador y su unidad son completamente inmunes a los efectos de cualquier hechizo. El hechizo no será dispersado, simplemente la unidad no se verá afectada por él.</characteristic>
              </characteristics>
