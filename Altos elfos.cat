                <profile name="Espada estelar" id="93a5-7e95-6032-b48c" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Filo de Caledor. Los ataques realizados con este arma se resuelven con la regla especial Ataques flamígeros y un bonificador de +1 en sus tiradas para impactar y herir.</characteristic>
                  </characteristics>
