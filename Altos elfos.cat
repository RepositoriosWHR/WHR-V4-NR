      <rules>
        <rule name="Bendición de Asuryan" id="3d3a-a104-ffe3-25e8" hidden="false">
          <description>Caradryan tiene una tirada de salvación especial de 4+. Sin embargo, no puede ser el General del ejército.</description>
        </rule>
        <rule name="Marcado por Asuryan" id="f2a6-1493-4520-e90a" hidden="false">
          <description>Si Caradryan muere abatido en combate cuerpo a cuerpo, la miniatura que le causó la última herida deberá superar un chequeo de Liderazgo; si lo falla, deberá retirarse inmediatamente como baja.</description>
        </rule>
      </rules>
