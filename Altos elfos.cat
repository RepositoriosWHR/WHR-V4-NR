    <selectionEntry name="[E] - Teclis y Cadaith" id="ef00-984a-f696-9280" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="3098-7f57-8c1f-ae60" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
