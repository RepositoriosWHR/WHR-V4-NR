                <infoLink name="Tozudez" id="abb1-3a28-5d9c-9990" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
                <infoLink name="Capa de león blanco de Cracia" id="a6b0-5cc9-3e51-50ee" hidden="false" targetId="56e6-a85d-f65e-f226" type="profile"/>
                <infoLink name="Cruzar (bosques)" id="0304-674f-7505-c122" hidden="false" targetId="9d01-387d-269d-5a44" type="rule"/>
                <infoLink name="Inmune al miedo" id="f16f-2ea1-299d-f656" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
                <infoLink name="Estilos de combate" id="7c05-013c-f2b7-dbb2" hidden="false" targetId="49f1-a11d-d4ff-e493" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Guardia del león" id="49fc-d601-cc06-22c0" hidden="false" typeId="a20d-ec9e-719a-2f03" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6569-81ae-e853-4fb3">El personaje está equipado con una Capa de león y obtiene las reglas especiales Cruzar (Bosques), Inmune a Miedo, Tozudez y, si no va montado, obtiene la regla especial Estilos de combate. Debe unirse a una unidad de Leones blancos de Cracia o montar un Carro de leones de Cracia (+100 puntos para Príncipe alto elfo y +115 puntos para Noble alto elfo).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="General del ejército" id="85bd-090c-22de-9544" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
