            <entryLink name="Reliquia" id="1608-0ef2-e75a-2a6e" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Fragmento del vórtice" id="36b9-1136-6df2-be47" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un solo uso. Puede utilizarse al inicio de una fase de magia del oponente, antes de tirar los Vientos de la magia. En vez de tirar dados para determinar los Vientos de la magia, se considera que todos los dados han obtenido un resultado de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Altos elfos" id="f7e9-4fdc-6988-bfac" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Cristal de los Annulii" id="b23b-310b-06a8-4304" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4f74-523f-c421-bd53" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9d5d-3c42-c500-4442" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cristal de los Annulii" id="0ce2-9306-491b-b285" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">En cada fase de magia enemiga, el portador puede reducir en uno los Dados de energía del oponente y aumentar en uno sus Dados de dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vara de plata" id="dc1d-5f91-c70c-da77" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="b9a0-3fbd-0c3c-4736" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="65b1-86e7-9aed-28cc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="3065-2f69-308d-9050" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Vara de plata" id="4f63-7ae8-7052-238a" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a su portador la regla especial Señor del conocimiento de uno de los ocho Saberes Básicos de la magia. Además, los hechizos del portador no puede ser olvidados ni destruidos por ningún efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo del árbol estelar" id="1ec4-7fba-76a2-976c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0fc5-a5ff-a165-993e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0bbb-34ce-a915-e892" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Báculo del árbol estelar" id="6100-a4d9-1aed-f5e1" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a su portador un +1 a sus tiradas de lanzamiento y dispersión de hechizos y podrá repetir sus tiradas para Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sello de Asuryan" id="68a5-e0fa-7f2b-f530" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f6c3-c696-1e8a-1dde" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ca6e-8058-a2c8-ea0b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Sello de Asuryan" id="ccc6-d281-e26c-1192" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Puedes declarar que lo usas cuando el oponente lance exitosamente un hechizo pero antes de efectuar la tirada para dispersar. Dispersa automáticamente el hechizo. Ten en cuenta que no funciona contra hechizos lanzados con Fuerza irresistible. Además, el lanzador del hechizo sufrirá 1D3 impactos de Fuerza 5 con la regla especial Ataques flamígeros.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro de la solidez" id="265b-1917-a630-5789" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a86f-c1be-2f8c-2410" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a0f4-94bc-59cf-ee71" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro de la solidez" id="3278-af91-0e29-4cb0" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. El portador puede ignorar los efectos de la primera de las Disfunciones mágicas que sufra durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Reliquias. Altos elfos" id="d1ca-f918-7cf4-9925" collective="false" hidden="false" import="true">
