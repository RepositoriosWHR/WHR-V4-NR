              <characteristics>
                <characteristic name="Reglas especiales" typeId="6569-81ae-e853-4fb3">Sólo Archimago. El personaje puede determinar sus hechizos del Saber del Hielo como si fuese uno más de sus saberes disponibles. Además, un Archimago alto elfo con esta senda puede montar un Ave de la tormenta por +350 puntos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Reliquias. Altos elfos" id="7a5c-6a84-35b7-d542" collective="false" hidden="false" import="true">
      <constraints>
