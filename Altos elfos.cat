                <infoLink name="Arma de mano" id="2578-595c-c014-9ae5" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
              </infoLinks>
              <profiles>
                <profile name="Espada de Teclis" id="d57c-2bf9-fd12-ca83" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos causados con este arma hieren automáticamente y no permiten efectuar tirada de salvación por armadura. Adicionalmente una vez por batalla, puede emplearse como un Arma de aliento de Fuerza 5 con las reglas especiales Ataque de rayos y Ataques mágicos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Báculo lunar de Lileath" id="1a2d-0474-9255-631c" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="283e-b3d8-7d09-6b5c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="3f91-3094-6ec3-41a5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Báculo lunar de Lileath" id="05f8-b311-3ea8-c463" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Teclis Canaliza automáticamente. Además, Teclis efectúa Fuerza irresistible en sus hechizos también con dos o más resultados naturales de 5, no solamente con 6.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corona de guerra de Saphery" id="7ca1-e490-0ad2-30f1" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="34d2-e0b4-5cac-8d1f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="5452-8624-bba9-c742" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Corona de guerra de Saphery" id="e81c-6e55-7f26-91ad" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que Teclis fuese a lanzar un hechizo, genera un Dado de energía adicional para dicho hechizo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pergamino de Hoeth" id="4daa-3638-84ca-8166" collective="false" hidden="false" import="true" type="upgrade">
