      <rules>
        <rule name="Ojo de halcón" id="46c9-4309-162d-a43f" hidden="false">
          <description>Eldril no aplica penalizador a su tirada para impactar con proyectiles por larga distancia.</description>
        </rule>
        <rule name="Los arqueros de Eldril" id="25cf-f280-6e25-5899" hidden="false">
          <description>La unidad de Arqueros altos elfos a la que se una Eldril podrá repetir sus resultados de 1 en sustiradas para impactar con proyectiles; este bonificador se aplica al propio Eldril y permanecerá incluso aunque Eldril sea retirado como baja.</description>
        </rule>
      </rules>
