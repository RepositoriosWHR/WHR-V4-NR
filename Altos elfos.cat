              <profiles>
                <profile name="Corona de guerra de Saphery" id="ccb1-26d9-4266-2a00" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que Teclis fuese a lanzar un hechizo, genera un Dado de energía adicional para dicho hechizo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pergamino de Hoeth" id="3790-ee4a-a0e4-7a7a" collective="false" hidden="false" import="true" type="upgrade">
