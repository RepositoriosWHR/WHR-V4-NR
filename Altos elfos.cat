    <selectionEntry name="[E] - Alith Anar, el rey sombrío" id="3a42-5506-2889-7a72" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="f9e8-97ed-3a6f-5ead" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="1816-d3d4-d8da-60e2" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
