      <entryLinks>
        <entryLink name="Saga (Eltharion)" id="cd3e-af32-ee2c-00ed" collective="false" hidden="false" import="true" targetId="6651-191d-5206-bc00" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Valor familiar" id="037b-560c-f0b9-6ec2" hidden="false" targetId="719c-3f6e-d4c1-3bc0" type="rule"/>
        <infoLink name="Destreza marcial" id="e9d9-0fb7-78ae-3e86" hidden="false" targetId="b8d3-d68e-42c6-1f84" type="rule"/>
        <infoLink name="Esquivar (4+)" id="5cbc-84c8-b993-06a2" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
