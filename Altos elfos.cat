              </infoLinks>
              <profiles>
                <profile name="Espada de plata cristalina" id="713e-1660-c49c-705a" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Espada de la Torre Blanca. Los impactos causados con este arma no permiten tirada de salvación por armadura. Además, Finreir puede guardar en la espada hasta dos dados de energía o dispersión no utilizados al final de cada fase de magia, que se añadirán a su reserva de Dados de magia al inicio de la siguiente fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
