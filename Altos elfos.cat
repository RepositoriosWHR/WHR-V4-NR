    <selectionEntry name="[E] - Eltharion el ciego, la espada blanca" id="0f29-b3a8-d3fd-0530" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="2ec5-723c-4ffe-8783" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
