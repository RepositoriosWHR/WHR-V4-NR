                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de dragón. Otorga a Imrik una tirada de salvación por armadura de 4+ y una tirada de salvación especial de 4+. Además, Imrik no puede ser herido por Armas de aliento.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
