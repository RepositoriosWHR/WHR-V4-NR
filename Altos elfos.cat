                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6569-81ae-e853-4fb3">El personaje obtiene un bonificador de +1 en sus intentos de dispersión</characteristic>
                  </characteristics>
                </profile>
              </profiles>
