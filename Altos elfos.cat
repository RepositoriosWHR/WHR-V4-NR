              <profiles>
                <profile name="Capa de estrellas" id="1114-cf9b-0dc7-63b2" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Todos los ataques, tanto en disparo como en combate, dirigidos contra Belannaer deberán aplicar un modificador de -2 a la Fuerza. Además, otorga la regla especial Resistencia mágica (2) contra el primer hechizo que afecte a Belannaer o su unidad.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Báculo de Cyeos" id="4b21-e263-7e4a-d053" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="63c0-b35e-d51f-8d9c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="1adf-2ad7-1719-fc97" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Báculo de Cyeos" id="1e38-3302-107f-df0b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a Belannaer un bonificador de +1 a todas sus tiradas de lanzamiento de hechizos.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="El libro del fenix" id="e2aa-c780-c1af-f3e7" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="0e0d-085d-8ffa-f1be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="a309-853c-0834-239f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="El libro del fenix" id="fb19-8dfc-221a-2a16" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de la batalla, Belannaer puede leer uno de los versos del libro. Selecciona uno de los tres versos y aplica sus efectos. El efecto durará hasta el final de la batalla o hasta que el libro sea destruido o anulado de algún modo.
- El Verso de la Vida: Otorga a Belannaer la regla especial Regeneración (5+).
- El Verso de la Llama Eterna: Belannaer Canaliza automáticamente.
- El Verso de la Destrucción: Belannaer aumenta en +1 su atributo de Ataques</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
