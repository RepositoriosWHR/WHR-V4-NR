      <infoLinks>
        <infoLink name="Infantería" id="f53a-72c7-5439-8fe5" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Valor Familiar" id="8648-62b5-4104-be41" hidden="false" targetId="719c-3f6e-d4c1-3bc0" type="rule"/>
