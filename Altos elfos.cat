                <infoLink name="Volar (10)" id="e82d-12ba-c56d-629c" hidden="false" targetId="be56-917b-a9d5-2c76" type="rule"/>
                <infoLink name="Ataques flamígeros" id="e44e-3efb-d0aa-500c" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="169e-755f-a47f-eae6" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink name="Inmune al fuego" id="d72a-570e-5303-8e5c" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
                <infoLink name="Inmune a la psicología" id="ef38-551e-e0a2-cc47" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink name="Resistencia mágica (3)" id="fdd1-f991-9672-4d14" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Ashtari" id="3ad8-94bc-3d51-71e1" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
                  <characteristics>
                    <characteristic name="M" typeId="4d23232344415441232323">4</characteristic>
                    <characteristic name="HA" typeId="5.753232323444154e+23">6</characteristic>
                    <characteristic name="HP" typeId="4.2532323234441546e+23">0</characteristic>
                    <characteristic name="F" typeId="5.323232344415441e+21">6</characteristic>
                    <characteristic name="R" typeId="5.423232344415441e+21">5</characteristic>
                    <characteristic name="H" typeId="5.723232344415441e+21">5</characteristic>
                    <characteristic name="I" typeId="4.923232344415441e+21">6</characteristic>
                    <characteristic name="A" typeId="4.123232344415441e+21">4+1</characteristic>
                    <characteristic name="L" typeId="4c4423232344415441232323">10</characteristic>
                    <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
                    <characteristic name="TSE" typeId="5.761726453617665e+35"/>
                    <characteristic name="Tipo" typeId="5.479706523232345e+27">Infantería</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Entidad llameante" id="7197-1ee1-6e24-b7b9" hidden="false">
                  <description>Al inicio de cada ronda de combate cuerpo a cuerpo, todas las miniaturas en contacto peana con peana con Ashtari sufren un impacto automático de Fuerza 4 con las reglas especiales Ataques mágicos y Ataques sólo flamígeros.</description>
                </rule>
                <rule name="Existencia imperecedera" id="c2a4-c851-a258-74b3" hidden="false">
                  <description>Ashtari tiene una salvación especial de 5+. La primera vez que Ashtari sea retirado como baja, tira 1D6 antes de retirar la miniatura del campo de batalla:
si obtienes un resultado de 1, retira a Caradryan como baja con normalidad; con un resultado de 2-5 la miniatura recupera 1D3 heridas y, con un resultado de 6, la miniatura recupera todas sus heridas.</description>
                </rule>
                <rule name="Estela de fuego" id="c2df-79fe-6cb7-22be" hidden="false">
                  <description>En cada una de tus fases de disparo, tira 1D6 por cada unidad enemiga a 12” o menos de Ashtari. Con un resultado de 4+, sufre 1D6 impactos de Fuerza 4 con la regla especial Ataques sólo flamígeros y Ataques mágicos.</description>
                </rule>
                <rule name="Picotazo ígneo" id="4730-0258-6ddb-e245" hidden="false">
                  <description>El ataque adicional de Ashtari se resuelve con un bonificador de +1 a la Fuerza y la regla especial Heridas múltiples (2).</description>
                </rule>
              </rules>
              <selectionEntries>
                <selectionEntry name="Equipo" id="6b1d-3836-6f77-4621" collective="false" hidden="false" import="true" type="upgrade">
                  <constraints>
                    <constraint id="0ea1-0f5b-8822-b0c2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
                    <constraint id="efac-3503-1191-4620" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
