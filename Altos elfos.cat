              </costs>
              <profiles>
                <profile name="Báculo lunar de Lileath" id="2121-393d-c842-39ef" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Teclis Canaliza automáticamente. Además, Teclis efectúa Fuerza irresistible en sus hechizos también con dos o más resultados naturales de 5, no solamente con 6.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corona de guerra de Saphery" id="b6cc-f929-7098-8e22" collective="false" hidden="false" import="true" type="upgrade">
