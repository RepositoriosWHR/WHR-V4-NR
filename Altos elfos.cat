        <rule name="Amplio impacto" id="407e-92e6-43ab-99d8" hidden="false">
          <description>Para calcular el número de impactos por carga que realiza la Cuadriga de combate, tira 2D6 y escoge el resultado más alto entre los dos (+1 si lleva cuchillas).</description>
        </rule>
