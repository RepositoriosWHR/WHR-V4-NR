            <profile name="Señor de los caballos" id="ab65-4b49-c9b3-ac12" hidden="false" typeId="a20d-ec9e-719a-2f03" typeName="Senda">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="6569-81ae-e853-4fb3">Sólo personaje montado en Corcel élfico o Carro de Tiranoc. El personaje obtiene la regla especial Caballería rápida. Su montura y su unidad obtienen +1 a su atributo de Movimiento; adicionalmente, si se une a una unidad de Jinetes de Ellyrion, estos no perderán la regla especial Caballería rápida si se equipan con Barda y Escudo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
