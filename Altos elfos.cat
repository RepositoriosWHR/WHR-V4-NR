        <infoLink name="Tozudez" id="62dc-3b29-d818-e804" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink name="Furia asesina" id="e903-113a-f288-95a1" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
        <infoLink name="Archienemigo" id="eab4-dd22-aae1-4802" hidden="false" targetId="837a-4a9a-7d71-e8fe" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Grom el Panzudo, Malekith)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Odio" id="2a35-39d9-0c20-0528" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Orcos y goblins, Elfos Oscuros)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="La oscuridad interior" id="05c5-92bc-eec6-b996" hidden="false">
          <description>Eltharion está sujeto a las reglas especiales Inmune a la psicología, Tozudez y Furia asesina. No perderá su Furia asesina aunque sea derrotado en combate cuerpo a cuerpo.</description>
        </rule>
        <rule name="Coreografía de combate" id="6cf1-11f1-fbe5-a1db" hidden="false">
          <description>Al inicio de cada ronda de combate cuerpo a cuerpo, Eltharion elige uno de los estilos de combate de la siguiente tabla y aplica el efecto durante esa ronda de combate. No puedes elegir el mismo estilo de combate dos rondas de combate cuerpo a cuerpo consecutivas.

Coreografía de combate Efecto:
-Rama del sauce Eltharion tan sólo podrá ser impactado con resultados naturales de 6. 
-Viento invernal Eltharion obtiene un bonificador de +1 en sus tiradas para impactar. 
-Picado del águila Eltharion obtiene un bonificador de +1 a su Fuerza.
-Tormenta de destrucción Eltharion obtiene un bonificador de +2 a sus Ataques.</description>
        </rule>
      </rules>
      <selectionEntries>
