    <profile name="Capa de león blanco de Cracia" id="56e6-a85d-f65e-f226" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Proporciona a su portador +2 a su tirada de salvación por armadura contra proyectiles y +1 a su tirada de salvación por armadura en cuerpo a cuerpo.</characteristic>
