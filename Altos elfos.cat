          </modifiers>
        </infoLink>
        <infoLink name="Valor familiar" id="dcc7-8321-8826-f13f" hidden="false" targetId="719c-3f6e-d4c1-3bc0" type="rule"/>
        <infoLink name="Destreza marcial" id="6269-d6c3-af64-29d0" hidden="false" targetId="b8d3-d68e-42c6-1f84" type="rule"/>
        <infoLink name="Inmune a la psicología" id="484c-2a10-2594-5a6a" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Estilos de combate" id="c62e-d02c-2d66-8bb5" hidden="false" targetId="49f1-a11d-d4ff-e493" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Guardaespaldas" id="0370-e2eb-5425-360f" hidden="false">
          <description>Al inicio de la batalla, tras el despliegue, puedes elegir que Korhil sea el guardaespaldas de un personaje incluido en su misma unidad. Mientras Korhil continúe con vida y en la misma unidad que el objetivo, no se podrán dirigir ataques en combate cuerpo a cuerpo contra el personaje designado ya que lo protege Korhil (excepto si ese personaje participa en un Desafío).</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Sendas" id="1e42-a178-6bdf-9b80" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="774a-958d-3375-3939" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
