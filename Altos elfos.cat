                <profile name="Señor de la espada" id="f26d-4b54-f795-91b7" hidden="false" typeId="a20d-ec9e-719a-2f03" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6569-81ae-e853-4fb3">El personaje está equipado con una Espada de la Torre Blanca (no puede elegir otras armas) y obtiene la regla especial Inmune a pánico y la regla especial Golpe letal en sus ataques cuerpo a cuerpo. El personaje no puede 
elegir ninguna montura.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <selectionEntries>
