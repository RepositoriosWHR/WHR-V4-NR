          </costs>
          <entryLinks>
            <entryLink name="Clave: Hechicero" id="ca8c-9009-0909-7add" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
            <entryLink name="Nivel 2" id="69c2-b98f-c59b-ef55" collective="false" hidden="false" import="true" targetId="9097-e430-ddd7-df03" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Diadema de Yvresse" id="e49c-f12a-b876-ad97" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador la clave hechicero y nivel de magia 2, el cual elige sus hechizos de entre los ocho Saberes Básicos de la magia y Alta magia, pudiendo mezclar diversos saberes al generar sus hechizos. Además, la diadema permite al portador lanzar hechizos con normalidad en el caso de llevar armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="0674-e75a-021e-0ca4" collective="false" hidden="false" import="true">
              <entryLinks>
                <entryLink name="Saber de la Vida" id="20fa-0114-aebe-c991" collective="false" hidden="false" import="true" targetId="db69-4431-08db-6b45" type="selectionEntry"/>
