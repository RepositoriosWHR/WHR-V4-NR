              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Libro de Hoeth" id="a57b-513f-19bd-66df" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto legendario. El portador tratará cualquier resultado de doble al lanzar un hechizo como Fuerza irresistible, xceptuando los resultados de doble 1 que serán una Disfunción mágica. Sólo los resultados de doble 6 causarán a la vez Fuerza irresistible y Disfunción mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Rubí crepuscular" id="559c-7cf2-1b9e-b5c7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9e9e-dfd1-5ed9-6b26" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2e9d-aaa2-c39f-78c4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="65"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="46b7-e371-dc78-eec4" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Rubí crepuscular" id="b621-336c-bff9-3087" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Otorga a su portador un bonificador a sus tiradas de lanzamiento de hechizos igual al turno de juego en curso (+1 en el primer turno de juego, +3 en el tercero...).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Fragmento del vórtice" id="ff6b-908e-6481-1d34" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="045a-33b8-785d-fb2d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c2f8-539d-9529-22ee" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
