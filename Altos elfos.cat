            <entryLink name="Reliquia" id="892b-1109-5d82-9d0f" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Objeto legendario" id="e13e-9653-2560-14b6" hidden="false" targetId="1eb5-f5b5-0dbe-0f2e" type="profile"/>
          </infoLinks>
          <modifiers>
            <modifier field="64bf-5ac4-a2da-525a" type="set" value="0">
