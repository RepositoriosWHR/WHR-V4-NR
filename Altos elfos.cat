        <infoLink name="Resistencia mágica (3)" id="d838-7ecc-f746-e290" hidden="false" targetId="c9ab-a12d-0ce9-430c" type="rule"/>
        <infoLink name="Inmune a la psicología" id="cfae-ab68-3d18-db3d" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
