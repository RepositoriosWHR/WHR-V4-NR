        <infoLink name="Ataques mágicos" id="3c15-2404-af90-d1a8" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
        <infoLink name="Miedo" id="8b80-af5a-31b6-5c7a" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink name="Etéreo" id="32ac-4832-fb75-51ac" hidden="false" targetId="34c4-9e60-1a62-eda5" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="6a0c-6ff9-1dcb-3f5b" type="set" value="1">
          <conditions>
            <condition childId="6f06-5374-c191-90e3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Espíritu de venganza" id="db3d-a352-8827-d4fd" hidden="false">
          <description>Alith Anar tiene las reglas especiales Ataques mágicos, causa Miedo y Etéreo.</description>
        </rule>
        <rule name="Partida de guerra de Nagarythe" id="7213-3369-0191-4399" hidden="false">
          <description>La unidad de Guerreros sombríos a la que se una Alith Anar obtiene las reglas especiales Etéreo, Odio (Caos) y causan Miedo mientras Alith Anar permanezca con vida.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Sendas" id="8174-a271-d010-674f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="bbcd-d9ac-be45-3861" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="5520-26ec-472e-dba8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <selectionEntries>
            <selectionEntry name="Guerrero de Nagarythe" id="a70e-97fa-0c86-a78e" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="fbda-8ed7-656f-c94f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="644c-a4ac-fbc5-9663" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Exploradores" id="a04e-5720-4e1b-668d" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
                <infoLink name="Disparo rápido" id="49ad-1f21-8522-f8af" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
                <infoLink name="Odio" id="bd6d-def5-ddb7-5605" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Elfos Oscuros)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Guerrero de Nagarythe" id="5580-c957-1080-dfea" hidden="false" typeId="a20d-ec9e-719a-2f03" typeName="Senda">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="6569-81ae-e853-4fb3">El personaje obtiene las reglas especiales Explorador, Disparo rápido y Puntería letal (ver Guerreros Sombríos). Cualquier unidad de Guerreros sombríos a la que se una obtiene la regla especial Disparo rápido. El personaje no podrá elegir ninguna montura.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Puntería letal" id="37a3-853c-a8b3-a3c0" hidden="false">
                  <description>Los resultados de 6 para herir con sus arcos no permiten tirada de salvación por armadura.</description>
                </rule>
