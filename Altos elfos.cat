          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="fbcc-1227-c35a-4fda" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Manto del señor de los saberes" id="81a9-d9cf-05eb-8cba" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Los hechizos enemigos que tomen como objetivo únicamente al portador o su unidad serán dispersados con un resultado de 2+ en 1D6 (aunque no es necesario gastar Dados de dispersión, se considera el intento de dispersión del hechizo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Reliquias. Altos elfos" id="32a7-92d0-3aed-2919" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Libro de Hoeth" id="578a-fd4a-ad32-965f" collective="false" hidden="false" import="true" type="upgrade">
