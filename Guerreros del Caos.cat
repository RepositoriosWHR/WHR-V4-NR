        <infoLink name="Inmune al pánico" id="8d4f-faf0-4b2b-af2a" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
        <infoLink name="Odio" id="dc3d-ad27-7750-add3" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Altos elfos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="526f-5703-dbaf-b4b2" type="set" value="1">
          <conditions>
            <condition childId="b07f-2e15-3936-d551" field="selections" includeChildForces="true" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Agravio ancestral" id="e0b7-6890-602b-7450" hidden="false">
          <description>Todos los Maestros de la espada de Hoeth y los Señores de los saberes (Altos elfos) obtienen la regla especial Odio (Aekold Helbrass).</description>
        </rule>
        <rule name="La Orden del Elíseo" id="52fa-7ead-132a-6e86" hidden="false">
          <description>La unidad de Guerreros del Caos de Tzeentch que acompaña a Aekold tiene un bonificador de +1 a sus atributos de Movimiento, Habilidad de Armas e Iniciativa. Además, mientras Aekold continúe con vida, los Guerreros del Caos obtendrán una tirada de salvación especial de 5+ gracias al Aliento de vida (que se incrementará a 4+ por la Marca de Tzeentch); la Orden del Elíseo también puede efectuar Parada luchando con sus Armas a dos manos. La Orden del Elíseo debe luchar con Armas a dos manos (no pueden elegir otras opciones de armamento ni tampoco Escudos), aunque estas no dispondrán de la regla especial Lenta. El coste total de cada Guerrero del Caos de la Orden del Elíseo es de 21 puntos (pueden incluir grupo de mando y estandarte mágico con normalidad).</description>
        </rule>
        <rule name="Destreza marcial" id="2b82-67ab-cc13-f620" hidden="false">
          <description>Aekold Helbrass puede efectuar Parada luchando con su Gran espada del viento.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Recompensas del caos" id="67f8-9b5e-e522-5529" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8c45-32ee-f9b9-8365" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
