                <infoLink name="Odio (todos los enemigos)" id="73de-f348-468c-444f" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink name="Furia asesina" id="2302-f2fc-d964-260d" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Khorne. Príncipe demonio" id="2fcb-c576-3789-dcf9" hidden="false">
                  <description>Obtiene las reglas especiales Furia asesina, Odio (¡todos los enemigos!) y Resistencia mágica (2). No pierde su Furia asesina si es derrotado en combate.</description>
                </rule>
              </rules>
