            <infoLink name="Inmune al veneno" id="52c2-e569-666b-fa2a" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Bloath Comegusanos" id="2cc7-5355-7823-8cc1" hidden="false">
              <description>Bloath porta la Marca de Nurgle, lo que le otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="La voluntad del Caos" id="2e03-89e8-9cea-44fa" hidden="false" targetId="5970-627c-206c-d759" type="rule"/>
