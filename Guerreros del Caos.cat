            <selectionEntry name="Pócimas pestilentes" id="922f-d019-3cb3-4f49" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dc59-8bc7-e976-307f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="3859-af53-1d5b-825e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Pócimas pestilentes" id="d3a8-bcf0-3aaf-8651" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Al inicio de cada una de tus fases de disparo, puedes elegir uno de los siguientes efectos y aplicarlo:
- Festus u otra miniatura en su unidad recupera una herida que hubiesen sufrido con anterioridad durante la batalla.
- Los Ataques envenenados de Festus y su unidad tendrán efecto con un resultado de 5+ (en lugar del habitual 6+) el inicio de tu siguiente fase de disparo.
- Festus puede realizar un disparo. Coloca la plantilla redonda pequeña a 12” o menos del portador y tira los dados de artillería y dispersión como si estuvieses disparando una Catapulta aunque, si se dispersa, lo hará la mitad de la distancia indicada en el dado de artillería. Cualquier miniatura bajo la plantilla (usa las reglas habituales para impactos parciales) sufrirán un impacto de Fuerza 3 que no permite tirada de salvación por armadura. Cualquier unidad que sufra al menos una baja de este ataque tendrá que efectuar inmediatamente un chequeo de Pánico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Familiar nurglete" id="3b0a-3a36-fd15-0e79" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="bcf8-b5a3-4653-d746" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="288c-6ff5-7fb7-9602" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Familiar nurglete" id="9ed3-a5ac-f398-309b" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Además de sus dos hechizos, Festus conoce siempre el hechizo La maldición del leproso (Saber de Nurgle).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
