                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje obtiene la regla especial Aura demoníaca (5+, o +1 a su Aura demoníaca si ya disponía de una) y se verá afectado por todos aquellos hechizos o efectos que afecten a miniaturas con la regla especial Demonio.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
