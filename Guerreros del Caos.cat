              <profiles>
                <profile name="Metabolismo mutante" id="0c07-96e6-093f-9c13" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje obtiene la regla especial Regeneración (5+), o +1 a su tirada de Regeneración si ya disponía de ella.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
