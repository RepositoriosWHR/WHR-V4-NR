    <selectionEntry name="[E] - Morbidex Dos Veces Nacido" id="447a-5aa2-b06c-00ef" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="7dad-dcb7-29b1-a76d" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
