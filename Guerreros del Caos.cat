      <rules>
        <rule name="Potencia de unidad 4" id="3dd0-0bbd-5e48-6276" hidden="false">
          <modifiers>
            <modifier field="name" type="set" value="Potencia de unidad 5">
              <conditions>
                <condition childId="9e58-fb97-f6ec-d945" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="dc77-5d3a-3a70-c735" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
        <rule name="Marca del Caos. Carruaje del Caos" id="3978-749b-2e42-8799" hidden="false">
          <description>El Carruaje del Caos debe portar la misma Marca que su jinete, al coste en puntos indicado:
-Marca del Caos absoluto (+5 puntos): La Protección por montura aumenta en +1.
-Marca de Khorne (+1 punto): Obtiene la regla especial Furia asesina (sólo el tripulante).
-Marca de Slaanesh (gratis): Sin efecto.
-Marca de Nurgle (gratis): Sin efecto.
-Marca de Tzeentch (+1 punto): Obtiene la regla especial Ataques flamígeros (sólo el tripulante).</description>
        </rule>
      </rules>
