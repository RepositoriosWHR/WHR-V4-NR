        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Festus, apotecario siniestro de Nurgle" id="a583-b1cf-f87a-649a" hidden="false">
          <description>Festus es un hechicero de nivel 2 que siempre utiliza el Saber de Nurgle.</description>
        </rule>
        <rule name="Doctor de Nurgle" id="8031-9664-2e6d-6993" hidden="false">
          <description>Festus tiene las reglas especiales Ataques envenenados y Regeneración (4+). Cualquier unidad a la que se una Festus obtendrá las reglas especiales Ataques envenenados y Regeneración (5+).</description>
        </rule>
      </rules>
