                <profile name="Libro arcano de Hoeth" id="c740-ae53-6612-184c" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Un sólo uso. Hirdra puede utilizar el libro durante cualquier fase de magia (propia o del oponente) siempre que Hirdra no haya perdido la concentración para generar inmediatamente 1D3 dados de Energía o Dispersión (según corresponda); dichos dados sólo podrán ser utilizados por Hirdra.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
