      <entryLinks>
        <entryLink name="Marca del Caos absoluto. Pesonajes" id="a4e2-8f8b-601c-c48b" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
          <constraints>
            <constraint id="eeb4-ab07-64d4-9164" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="9484-6786-bc01-26b8" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca del Caos absoluto. Wulfrik" id="714f-9db4-71c0-db16" hidden="false">
              <description>Wulfrik porta la Marca del Caos absoluto, que le otorga la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto a Wulfrik toda la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
