          <infoLinks>
            <infoLink name="Inmune al veneno" id="e57d-21ce-4e34-b33a" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Corona de la conquista eterna" id="a664-92ac-4e4b-95d6" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga a su portador una tirada de salvación especial de 4+ y la regla especial Inmune a veneno. También será inmune a los efectos de la regla especial Golpe letal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Reliquias. Guerreros del Caos. Nurgle" id="3115-9bcd-413a-ebc9" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="0503-10ea-dda5-749b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="21c2-6a6a-3cdf-28d2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Báculo de Nurgle" id="351d-6768-7a3a-4147" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d95e-a00c-6cb1-dc64" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2e20-32b3-eb5d-7ada" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="125"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="7329-30c0-0708-ac0c" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Báculo de Nurgle" id="cd9c-3163-07ac-01fe" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo miniaturas con la Marca de Nurgle. Objeto portahechizos, nivel de energía 7. Designa una única miniatura enemiga a 12” o menos del lanzador (puedes seleccionar un personaje dentro de una unidad). Esa miniatura deberá obtener un resultado igual o inferior a su atributo de Resistencia en 2D6 o se retirará como baja. Tira 1D6 cada vez que utilices el báculo exitosamente: con un resultado de 1 o 2, el poder del báculo se habrá agotado temporalmente y no podrá usarse más durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Artefactos arcanos. Guerreros del Caos" id="bcf0-32d4-e2eb-9a8a" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="350f-083d-48b0-5587" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="c5e0-d922-45f7-0255" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Familiar del caos" id="db55-1e81-d1c6-6a68" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="cef7-66fd-4a98-2091" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4e29-f18d-36f2-0951" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Familiar del caos" id="5c3f-0180-8494-6170" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cáliz del caos" id="fbc5-6d23-b9c0-bfd2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6450-526e-80bb-71a6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b9dd-2dfd-2076-95c8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="50"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cáliz del caos" id="0075-7f0a-1900-3dcf" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Puede utilizarse al inicio de cada fase de magia propia o del enemigo. Tira 1D6. Con un resultado de 1, el hechicero sufrirá 1D3 heridas automáticas sin posibilidad de salvación por armadura. Con un resultado de 2 a 5, el hechicero genera 1D3 dados de Energía o Dispersión adicionales para esa fase de magia. Con un resultado de 6, todos los magos enemigos en el campo de batalla tendrán que obtener un resultado igual o inferior a su nivel de magia o sufrirán una Disfunción mágica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La calavera de Kasteman" id="d6e1-626d-bf1b-e80a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2ccf-3da1-210d-5601" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="9681-4f92-93db-53f4" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="La calavera de Kasteman" id="7eff-7614-383e-1f80" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Proporciona a su portador un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Guerreros del Caos" id="e5c2-7b23-9998-606a" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4804-e83b-046a-19b6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="d2bd-ab75-8de0-7a47" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Yelmo de incontables ojos" id="29f1-43f7-ae54-ba5b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d615-e326-a5be-123c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6864-c773-3b77-5fb5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Yelmo de incontables ojos" id="90e8-0208-79e5-4199" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador verá su tirada de salvación por armadura incrementada en un +1. Además, aumenta su Iniciativa a 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Poción del caos" id="a47c-b764-c33c-a696" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ea28-7a27-969c-b43a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5d34-82ab-2ae6-f779" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Poción del caos" id="6440-aece-7378-a198" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje puede beberla al inicio de la batalla, tras el despliegue. Tira 1D6 en la siguiente tabla: 
D6 Poción del Caos
1 Engendro del Caos: El personaje se transforma en un Engendro del Caos con la Marca del Caos apropiada. Si tu ejército incluye una unidad de Engendros del Caos con la misma Marca del Caos, puedes unirlo a ella. 
2 Fuerza demencial: Obtiene +1 a su Fuerza y la regla especial Estupidez. 
3 Llamas del Caos: Obtiene la regla especial Ataques flamígeros y un Arma de aliento de Fuerza 4 con la regla especial Ataques sólo flamígeros. 
4 Metabolismo acelerado: Obtiene la regla especial Regeneración (4+). 
5 Furia homicida: Obtiene +1 a su Fuerza, Resistencia y Ataques. 
6 Poder del Caos: Suma +1 a todos sus atributos (excepto Movimiento y Liderazgo). Al inicio de cada uno de sus turnos, debe superar un chequeo de Resistencia o sufrirá 1 herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de piedra de disformidad" id="e8a9-3132-5de6-164d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fabb-99a3-d93c-abde" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="d5aa-7dfd-058c-f710" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="a9b8-0ade-a61c-3ab8" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, un único dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Favor de los dioses" id="ac58-59c8-8865-359f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="075f-ed37-2383-77c1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b931-2d66-8d72-fbf9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Favor de los dioses" id="fe91-3afd-efd9-d71e" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla del Ojo de los dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
