          </infoLinks>
          <rules>
            <rule name="Marca de Khorne. Haargroth el Carnicero" id="6098-9f2b-fa76-7d9d" hidden="false">
              <description>Haargroth porta la Marca de Khorne, que le otorga las reglas especiales Furia asesina y Resistencia mágica (2). No pierde su Furia asesina si es derrotado en combate.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="867f-3bc5-7994-c20b" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
