        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Marca de Nurgle. Personajes" id="6d4c-3ae1-483b-1ed8" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
          <constraints>
            <constraint id="8683-19d1-dff5-85f4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Inmune al veneno" id="9fb5-fdae-bdcb-36b0" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Morbidex" id="ec67-0a59-5f0d-7fd0" hidden="false">
              <description>Morbidex y el Gran gusano de plaga portan la Marca de Nurgle, lo que les otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="70fa-949d-c102-7bac" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="La voluntad del Caos" id="e2f6-0f9c-943e-0d46" hidden="false" targetId="5970-627c-206c-d759" type="rule"/>
        <infoLink name="El ojo de los dioses" id="5991-ceba-04d0-a1c9" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
        <infoLink name="Presencia inspiradora" id="1433-9868-11e6-b4e1" hidden="false" targetId="b950-0689-6573-779c" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Sólo a Nurgletes)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Infestado de nurgletes" id="c24a-f7bc-2dac-20fb" hidden="false">
          <description>Además de sus ataques normales en combate cuerpo a cuerpo, Morbidex realiza 2D6 ataques adicionales que se resuelven con HA3, F3, I3 y las reglas especiales Ataques envenenados y Ataques mágicos.</description>
        </rule>
        <rule name="La hueste chillona" id="f0dd-08b1-a93f-af96" hidden="false">
          <description>Si tu ejército incluye a Morbidex, debes incluir una unidad de Seguidores nurgletes. Morbidex posee la regla especial Presencia inspiradora, que sólo afecta a la unidad de Seguidores nurgletes a 18”o menos de él.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Recompensas del Caos" id="4771-0aa7-7eb5-62be" collective="false" hidden="false" import="true" type="upgrade">
