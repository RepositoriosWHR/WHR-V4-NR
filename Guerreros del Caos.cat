      <categoryLinks>
        <categoryLink name="New CategoryLink" id="f2c6-f740-b991-95e5" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="f7fc-eda1-f865-0cba" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="34b6-1966-f62f-b511" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
