            <profile name="Alfiler del éxtasis" id="67b4-8b12-6164-97f6" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la Marca de Slaanesh. Arma de mano. Los impactos con este arma no permiten tiradas de salvación por armadura. Si causa una herida a una unidad enemiga, la unidad quedará Apabullada ese turno y tendrá un penalizador de -1 en sus tiradas para impactar durante esa fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
