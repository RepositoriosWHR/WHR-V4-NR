              </costs>
              <rules>
                <rule name="Marca de Nurgle. Bruto despedazador" id="0070-68c2-eb1c-a4b1" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="9c82-ebfe-2e96-d74f" collective="false" hidden="false" import="true" targetId="01e5-81a4-0637-f7b1" type="selectionEntry">
