        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Marca de Nurgle. Personajes" id="cd21-b3cd-02e6-9788" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
          <constraints>
            <constraint id="305b-254b-11ba-336e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Inmune al veneno" id="77a6-452f-d39a-104e" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Valnir el Segador" id="1523-96c9-c23a-f678" hidden="false">
              <description>Valnir porta la Marca de Nurgle, lo que le otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad 
de armas.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="El Ojo de los Dioses" id="8b65-6f7f-e1bb-a754" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
        <infoLink name="Infantería" id="90dd-ed36-114c-63be" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Tozudez" id="4685-fe40-0c48-d110" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink name="Odio (todos los enemigos)" id="7a99-727b-d04a-a9ca" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Que no sean Demonio o No muerto)"/>
          </modifiers>
        </infoLink>
        <infoLink name="No muerto" id="ac62-0190-b9d4-318a" hidden="false" targetId="3d39-5d46-7335-225c" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="48a7-2ccd-3a2b-2260" type="set" value="1">
          <conditions>
            <condition childId="e79a-f7e3-aa0a-9fe8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="El segador de Nurgle" id="1b26-e053-8fa5-770f" hidden="false">
          <description>Valnir tiene la regla especial No muerto, aunque puede unirse a una unidad de Soldados del Caos (aunque no sean No muertos). Mientras queden Soldados del Caos en la unidad, Valnir podrá huir como si no tuviese la regla especial No muerto; tan sólo aplicará la Inestabilidad si se queda combatiendo en solitario, tras la muerte de sus Soldados del Caos. Además, tiene la regla especial Odio a  todos los enemigos que no tengan la regla especial Demonio o No muerto.</description>
        </rule>
        <rule name="La tribu del cuervo" id="40be-91e7-c069-2c48" hidden="false">
          <description>La unidad de Soldados del Caos a la que se una Valnir obtendrá las reglas especiales Inmune a psicología y Odio a todos los enemigos que no tengan la regla especial Demonio o No muerto.</description>
        </rule>
        <rule name="Viento de pestilencia" id="8a2a-01c7-f8eb-efb9" hidden="false">
          <description>Para representar esto, al inicio de batalla puede designarse una unidad enemiga; habrá sido infectada por la pestilencia de Valnir. Tira 1D6: 
1D6	Viento de pestilencia
1-3	La Plaga Roja.La unidad sufre 1D6 impactos de Fuerza 2 sin tirada de salvación. 
4-5	Fiebre Cerebral.  La unidad obtiene la regla especial Estupidez. La unidad queda sujeta a Estupidez.
6	Peste Negra.Todos los miembros de la unidad tienen - 1 al impactar en combate cuerpo a cuerpo y con proyectiles.</description>
        </rule>
      </rules>
