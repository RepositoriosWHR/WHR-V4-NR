            <entryLink name="Marca de Tzeentch. Personajes" id="f577-0e2e-e21f-7628" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="6017-1b47-7e6f-62cd" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Inmune al fuego" id="e059-c240-9b1e-c6c8" hidden="false" targetId="c50e-4c88-061d-12b9" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Príncipe demonio" id="859d-2edc-cbf3-cd40" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros e Inmune a fuego y una tirada de salvación especial de 5+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="d1b4-4eca-e697-ff3f" collective="false" hidden="false" import="true" targetId="7a16-b72a-0527-51a1" type="selectionEntry">
