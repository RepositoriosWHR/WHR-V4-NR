              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje genera un dado de Energía adicional en cada fase de magia propia, que puede ser utilizado por cualquier personaje con la Marca de Tzeentch.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Ojo de Tzeentch" id="20ac-bd38-c873-f955" collective="false" hidden="false" import="true" type="upgrade">
