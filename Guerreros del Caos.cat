    <selectionEntry name="[E] - Valnir el Segador, castigo de Nurgle" id="6e8e-8008-1375-2c76" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="c5fd-e26f-1a12-8738" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
