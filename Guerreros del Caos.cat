        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="046a-1c36-705e-1c0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="b0cb-0f64-7246-ded7" type="increment" value="1">
          <conditions>
            <condition childId="08b3-e997-6282-1873" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Tchar´zanek" id="77d3-e235-bf7b-9ea6" hidden="false">
          <description>Tchar’zanek es un hechicero de nivel 4 que siempre utiliza hechizos del Saber de Tzeentch.</description>
        </rule>
        <rule name="Marcado por la grandeza" id="f5bb-bd87-7bec-31ba" hidden="false">
          <description>Tchar’zanek tiene la regla especial Tozudez y puede repetir sus tiradas en la tabla del Ojo de los dioses. Además, puede repetir los resultados de 1 en sus tiradas de salvación especial.</description>
        </rule>
        <rule name="La Hueste del Cuervo" id="10f5-81e6-02e6-0bec" hidden="false">
          <description>Tchar’zanek, puedes incluir una unidad de Elegidos del Caos con la Marca de Tzeentch como opción de Unidad 
Especial. Tchar’zanek debe unirse a esa unidad.</description>
        </rule>
      </rules>
