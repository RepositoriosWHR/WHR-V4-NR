      <rules>
        <rule name="Marca del elegido" id="abd8-feb4-bafc-54fa" hidden="false">
          <description>La Marca del Elegido cuenta como las Marcas de los cuatro Dioses del Caos y otorga a Archaón los siguientes beneficios: Furia asesina, Resistencia mágica (2), Inmune a psicología, Sangre fría, -1 a ser impactado en disparo, -1 HA a todos los enemigos en contacto, Ataques flamígeros, Ataques mágicos y una tirada de salvación especial de 5+ o +2 si ya disponía de una.</description>
        </rule>
        <rule name="Los Espadas del Caos" id="428b-1a3a-7ed4-3efc" hidden="false">
          <description>La unidad de los Espadas del Caos debe llevar las cuatro Marcas de los Dioses del Caos y obtienen la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
      </rules>
      <selectionEntries>
