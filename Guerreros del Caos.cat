              <infoLinks>
                <infoLink name="Ataques envenenados" id="bc92-6f0c-2aff-2946" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Príncipe demonio" id="aa42-a559-2e95-7ee1" hidden="false">
                  <description>Obtiene la regla especial Ataques envenenados. Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1HA.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="e305-1703-9bf6-f3e7" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
