    <selectionEntry name="[E] - Wulfrik el Errante, trotamundos eterno" id="9f12-d621-a665-4541" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="bb05-acf5-2067-c44c" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
