      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="0d91-27a3-a4c2-7182" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
