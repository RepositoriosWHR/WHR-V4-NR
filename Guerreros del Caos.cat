          </entryLinks>
          <infoLinks>
            <infoLink name="Arma de mano" id="7802-bffe-eacc-7a13" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Arma demonio" id="eac2-a288-cb98-192e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al atacar con este arma, el portador obtiene 1D6 Ataques adicionales (tira cada vez que vayas a atacar); además, sus impactos se resuelven con +1D3 a su Fuerza (tira cada vez que vayas a atacar). Cada resultado de 1 para impactar con este arma deberá resolverse para herir contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Padre de las espadas" id="1450-2f03-77f0-fac7" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="49c1-6f9f-8378-d056" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e3a1-f687-fbbd-c9cd" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="1564-e38e-1de9-879b" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Arma de mano" id="717c-7721-8a8a-f376" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Ataques mágicos" id="6698-d774-5b5e-e9d4" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Padre de las espadas" id="8bba-2bd8-a03b-fce9" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al luchar con este arma, todos los resultados de 1 en las tiradas para impactar en combate cuerpo a cuerpo con este arma se consideran resultados naturales de 6 y todos los enemigos que ataquen en combate cuerpo a cuerpo al portador consideran todos los resultados de 6 en sus tiradas para impactar como resultados .naturales de 1 (a no ser que la miniatura atacante solo pueda impactar con resultados de 6; en ese caso no se considerarán resultados de 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
