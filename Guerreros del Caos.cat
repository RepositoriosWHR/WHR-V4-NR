                <infoLink name="Ataques flamígeros" id="2084-e8d3-36fa-0ce5" hidden="false" targetId="6985-722e-1ce4-b838" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Sólo tripulantes)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Unidades" id="449f-f799-5a1a-a343" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros (sólo los tripulantes) y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Unidades" id="a075-b02b-d0fd-fe34" collective="false" hidden="false" import="true" targetId="bc49-6882-c66c-bc26" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="57fa-15ce-4b32-457a" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Carruaje del Caos" id="935b-80ac-0f2e-eafb" hidden="false">
                  <description>Obtiene la regla especial Inmune a psicología. Además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado al carro toda la batalla (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="eefe-b873-03f1-8488" collective="false" hidden="false" import="true" targetId="011d-ecac-f652-9fd9" type="selectionEntry">
