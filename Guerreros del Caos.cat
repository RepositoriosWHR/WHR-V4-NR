          <entryLinks>
            <entryLink name="Marca del caos absoluto. Unidades" id="08d0-7c63-bde4-a02e" collective="false" hidden="false" import="true" targetId="bc49-6882-c66c-bc26" type="selectionEntry">
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="8503-0536-a295-06e1" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="2">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca del caos absoluto. Caballeros del Caos" id="8cc9-a6bf-6c57-d24d" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Unidades" id="15a9-e5cc-4134-8194" collective="false" hidden="false" import="true" targetId="96fb-d019-8c83-aea3" type="selectionEntry">
              <infoLinks>
