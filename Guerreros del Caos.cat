                <infoLink name="Disparos múltiples (1D6)" id="8428-83d5-d3b1-5957" hidden="false" targetId="477b-5ffd-646c-e546" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Arma de proyectiles)"/>
                  </modifiers>
