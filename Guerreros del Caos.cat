            <profile name="Don del cambio" id="9a7d-87ce-a0f1-fc89" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Sólo hechiceros. Un sólo uso. Puede utilizarse durante cualquier fase de magia propia para lanzar un hechizo (incluso uno potenciado) sin invertir dados de Energía. El hechizo será lanzado con Fuerza irresistible; tras resolver el hechizo, el hechicero debe realizar una tirada en la tabla de Disfunciones mágicas, aunque tirará con 1D6+6 en lugar del habitual 2D6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
