                <infoLink name="Miedo" id="9d2e-167f-3d3f-e115" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Señor de las bestias del Caos" id="d61d-c23d-4c55-50c4" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarlos con proyectiles, los enemigos en contacto peana con peana tendrán -1HA. Además, causará Miedo.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="b916-f25e-2dfd-0680" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="1b1a-a516-8342-267f" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
                <infoLink name="Ataques mágicos" id="9023-9e48-1944-c623" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Señor de las bestias del Caos" id="fd71-6437-2e55-179f" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="449b-e06b-99ff-85f0" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="703f-712b-43ae-fd25" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Señor de las bestias del Caos" id="1614-c45b-8193-4960" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Personajes" id="585e-0527-bbbf-b394" collective="false" hidden="false" import="true" targetId="7a16-b72a-0527-51a1" type="selectionEntry">
