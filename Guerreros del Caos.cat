                <profile name="Astucia de Tzeentch" id="0f35-eca7-b681-358a" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Si Van Horstmann es el General de tu ejército, tras el despliegue, puedes redesplegar una de tus unidades en cualquier parte de tu zona de despliegue.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Destino de Tzeentch" id="35cc-1f70-5099-daad" collective="false" hidden="false" import="true" type="upgrade">
