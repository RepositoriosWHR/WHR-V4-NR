              <infoLinks>
                <infoLink name="Leyenda" id="f2e7-7f57-98ab-057a" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
                <infoLink name="Monstruosamente grande" id="1a59-8853-5216-9109" hidden="false" targetId="38d4-1707-be50-7d0f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Bruto colosal" id="5b0d-c9b4-147d-555a" hidden="false">
                  <description>Uno de los Brutos despedazadores de tu ejército puede convertirse en Bruto colosal (+100 puntos), obteniendo +1F, +1R, +2H, +1A y -2I, su tamaño de peana cambia a 100x150mm y obtiene las reglas especiales Leyenda y Monstruosamente grande.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="[E] - El Glottkin; los hermanos Glott: Otto, Ethrac y Ghurk" id="3abb-7020-2408-d266" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="1016-89fc-5265-eeb0" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="1d71-ed45-cbbb-55e3" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="0ca5-f528-24d3-8817" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Marca de Nurgle. Personajes" id="34fe-67e0-dfd5-1d1f" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
          <constraints>
            <constraint id="a246-9ed3-c483-e785" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Inmune al veneno" id="746c-c2bb-36eb-1426" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Glottkin" id="32b2-a668-b120-fe7e" hidden="false">
              <description>El Glottkin en su conjunto porta la Marca de Nurgle, lo que le otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Leyenda" id="9126-c345-0c42-9bc4" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Monstruo" id="ef13-8d77-ce84-1807" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Leyenda" id="59bc-f086-00db-1578" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink name="El ojo de los dioses" id="e659-421c-253d-1dad" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(las tiradas en la tabla afectan a los tres hermanos; considera los resultados de 2 como 3)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Regeneración (4+)" id="c045-76e3-5b37-a3ea" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
        <infoLink name="Ataques envenenados" id="685f-27ba-a4ed-8de9" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink name="Impactos por carga" id="bdd5-d4a7-aa68-d9fd" hidden="false" targetId="a89f-5611-61e4-f924" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(2D6 y elige el resultado mayor)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Piel escamosa (4+)" id="933d-6f94-e3ea-0a22" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
        <infoLink name="Monstruosamente grande" id="57cc-ab00-8ce0-9d22" hidden="false" targetId="38d4-1707-be50-7d0f" type="rule"/>
        <infoLink name="Inmune a la psicología" id="59c6-422b-d8f8-1bb2" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Arma de aliento" id="8db6-e680-5fe1-6d5b" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(F3, Ataques mágicos, sin salvación por armadura)(Ghurk)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="046a-1c36-705e-1c0e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Ethrac" id="f6c1-6b9b-5b3f-03b1" hidden="false">
          <description>Ethrac es un hechicero de nivel 4 que siempre utiliza hechizos del Saber de Nurgle.</description>
        </rule>
        <rule name="Los hermanos Glott" id="dd0b-0cc6-04f3-3fd2" hidden="false">
          <description>Todos los impactos deberán resolverse contra la Habilidad de Armas y Resistencia de Ghurk. Todos los chequeos de atributo se realizarán utilizando el perfil de Ghurk. Cada uno de los tres hermanos atacará utilizando su propio perfil de atributos.</description>
        </rule>
        <rule name="Torrente de pestilencia" id="f251-5ec6-8e86-544f" hidden="false">
          <description>Ghurk posee un Arma de aliento de Fuerza 3 con la regla especial Ataques mágicos que no permite tirada de salvación por armadura.</description>
        </rule>
        <rule name="Alimentarse" id="4695-9002-9c5f-65cf" hidden="false">
          <description>El ataque adicional de Ghurk (indicado en su perfil de atributos) se resuelve con Fuerza 10 y la regla especial Heridas múltiples (1D6). Por cada baja causada por este ataque, el Glottkin puede restaurar una de las heridas sufridas con anterioridad en la batalla.</description>
        </rule>
        <rule name="Icono de Nurgle" id="5176-0eb8-3081-22ca" hidden="false">
          <description>El Glottkin y todas las unidades amigas a 18” o menos de él con la Marca de Nurgle o la regla especial Demonio (Nurgle) obtienen la regla especial Tozudez.</description>
        </rule>
      </rules>
