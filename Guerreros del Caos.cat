              <infoLinks>
                <infoLink name="Arma a dos manos" id="1c05-f72c-5e31-e5db" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
                <infoLink name="Heridas múltiples (1D3)" id="0bb5-9582-8c4b-1124" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Guadaña de la plaga de la pus sangrienta" id="d6fa-bcfd-48fe-167d" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Sus ataques se resuelven con la regla especial Heridas múltiples (1D3). Cuando una miniatura muera a causa de ataques en combate cuerpo a cuerpo hechos con este arma, antes de retirarla como baja todas las miniaturas en contacto  peana con peana con ella que no tengan la Marca de Nurgle o tenga la regla especial Demonio o No muerto deberán superar un chequeo de Resistencia y, si lo fallan, sufrirán una herida sin tirada de salvación por armadura. Estas heridas no generan nuevos chequeos de Resistencia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Armadura del caos" id="8e19-9fea-1e14-85c8" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dc5e-451b-4da7-c9cf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
