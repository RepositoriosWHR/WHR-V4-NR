      </categoryLinks>
      <constraints>
        <constraint id="48a7-2ccd-3a2b-2260" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
      </constraints>
