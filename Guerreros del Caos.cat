              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje obtiene un Arma de aliento de Fuerza 3 que no permite tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Vitalidad de Nurgle" id="94a4-7ce2-b985-6de4" collective="false" hidden="false" import="true" type="upgrade">
