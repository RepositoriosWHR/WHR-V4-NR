    <selectionEntry name="[E] - Vilitch el Maldito, el gemelo deforme" id="3349-65f7-658a-0a0e" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="1797-9f35-1607-8be7" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
