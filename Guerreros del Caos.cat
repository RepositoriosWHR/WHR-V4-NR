                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Sólo Paladín del Caos o Señor del Caos. Sustituye el efecto de la Marca del Caos del personaje por la Marca del Caos de los Elegidos equivalente. El personaje tan sólo puede unirse a unidades de Elegidos del Caos (ya sean a pie o montados, de cualquier tipo si su Marca del Caos se lo permite).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Esencia demoníaca" id="c69a-f3da-554d-f84b" collective="false" hidden="false" import="true" type="upgrade">
