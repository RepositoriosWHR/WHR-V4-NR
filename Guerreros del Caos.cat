            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="9234-8643-45f1-7747" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Mortaja ulcerosa" id="2398-3123-7a39-d6f9" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con la Marca de Nurgle. El portador y su unidad obtendrán la regla especial Ataques envenenados, que tendrán éxito con 5+ en lugar del habitual 6+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Guerreros del Caos. Khorne" id="f108-f024-ee39-9e01" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="cf32-2017-131f-293b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
        <constraint id="5477-ec21-2d91-f18a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Pabellón de la ira" id="8fe9-e8b2-4f3e-3393" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="9cd5-01a6-bbf8-c67e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="e697-ea32-d251-13a8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Pabellón de la ira" id="20c1-b757-7954-0bb5" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con la Marca de Khorne. El portador y su unidad no perderán la regla especial Furia asesina como resultado de perder un combate cuerpo a cuerpo. Todos los hechiceros en contacto con el portador o su unidad tirarán 1D6 adicional cada vez que sufran una Disfunción mágica y tú eliges qué dado descartan.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Guerreros del Caos. Slaanesh" id="5af7-91d9-c1ff-b4d1" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="2853-ba14-4ae1-962c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="a82e-971a-4e6d-7368" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Colgante de Slaanesh" id="6105-037b-82e2-dabe" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0bd8-3bf6-93f9-5776" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="918b-aa9b-0245-9168" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Colgante de Slaanesh" id="cf9a-28bb-5696-ee6f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Slaanesh. Por cada herida que sufra el portador, su atributo de Ataques aumenta en un punto (hasta un máximo de 10).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cadenas de Slaanesh" id="b09d-bf1a-a58a-c07b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3f8e-c244-f09a-690f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="30b1-c711-1ba9-a50d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cadenas de Slaanesh" id="d0d4-e223-0eba-6f62" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Slaanesh. En combate cuerpo a cuerpo, el portador realiza 1D6 ataques adicionales que se resuelven con Iniciativa 10, utilizando los valores de Habilidad de Armas y Fuerza del portador (no se beneficiarán del efecto de ningún arma mundana o mágica del portador, aunque sí de las Recompensas del Caos que pudiera tener).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Guerreros del Caos. Nurgle" id="50f6-8b3f-6b9a-9c44" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="2d79-9b15-2df3-5b25" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="2e34-1101-77b8-f336" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Cráneos de muerte" id="b144-447e-34b9-5252" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ac3f-154f-d0c0-837a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="14e9-1524-69d8-2fa1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cráneos de muerte" id="dcbc-083f-d324-89f0" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Nurgle. El portador puede utilizar los cráneos en cada fase de disparo si no está trabado en combate, aunque no para aguantar y disparar. Coloca la plantilla redonda pequeña a 12” o menos del portador y tira los dados de artillería y dispersión como si estuvieses disparando una Catapulta aunque, si se dispersa, lo hará la mitad de la distancia indicada en el dado de artillería. Cualquier miniatura bajo la plantilla deberá efectuar un chequeo de Resistencia o sufrir una herida sin tirada de salvación por armadura. Si obtienes un resultado de Problemas, retira la plantilla sin causar ningún efecto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Guerreros del Caos. No Khorne ni hechiceros" id="4cae-bff8-ca3f-5fdb" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="8609-8fe0-193f-dbc8" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="7c38-0d0a-abc7-c1ec" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Libro de los secretos del caos" id="96e5-e8eb-565f-f034" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ca7f-2179-23c9-9f61" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="540d-3729-5ac9-62a3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Libro de los secretos del caos" id="0fe8-8847-6e70-ad90" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador pasa a considerarse hechicero de nivel 1 que puede utilizar el Saber de las Sombras, el Fuego o la Muerte. No puede ser utilizado por miniaturas con la Marca de Khorne o por personajes que ya tuviesen uno o más niveles de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="fe95-3a97-86b7-733d" collective="false" hidden="false" import="true">
              <entryLinks>
