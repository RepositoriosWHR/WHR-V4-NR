    <selectionEntry name="[E] - Skarr Irasangrienta" id="ede7-dd0f-3c86-32f3" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="b8a6-46da-b945-01f4" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
