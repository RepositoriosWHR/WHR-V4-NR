            <profile name="Fortuna de Tzeentch" id="1eb6-0008-8f9c-c8a3" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Una vez por turno de jugador, el Paladín puede repetir una tirada de 1D6. Puede ser una tirada para impactar, herir, salvación (por armadura o especial) o un chequeo de atributo (excepto de Liderazgo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
