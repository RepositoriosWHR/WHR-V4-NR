      <entryLinks>
        <entryLink name="Marca de Nurgle. Personajes" id="774d-1541-6c54-a38c" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
          <constraints>
            <constraint id="eb2f-474b-8a2e-0daa" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ataques envenenados" id="0454-8628-3026-a7e3" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Frud el Errante" id="6c3a-3c6c-8d4f-4d6b" hidden="false">
              <description>Frud porta la Marca de Nurgle, por la que obtiene la regla especial Ataques envenenados y los enemigos reciben un penalizador de -1 para impactarle tanto en disparo como en combate.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Indesmoralizable" id="dbb9-d375-89e1-3a08" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink name="Infantería monstruosa" id="9caa-cd00-9e66-2b39" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink name="Miedo" id="8279-fde4-c573-9124" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink name="Movimiento aleatorio (3D6)" id="c117-981f-4e23-c3da" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="f5ba-6c54-05dd-a778" type="set" value="1">
          <conditions>
            <condition childId="e13b-fe02-1cd3-df16" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Pastor de engendros" id="ed95-1c1c-8c66-7d81" hidden="false">
          <description>Mientras Frud permanezca con la unidad, su unidad de Engendros del Caos podrá tirar 1D6 adicional para su Movimiento aleatorio (es decir, moverán al mismo ritmo que Frud) y los Engendros del Caos obtendrán la regla especial Odio (¡todos los enemigos!).</description>
        </rule>
      </rules>
