            <entryLink name="Marca de Tzeentch. Personajes" id="2bb6-ae4c-bbcf-fc90" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="c0a9-a337-ccb6-63d7" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Gran hechicero del Caos" id="7891-a10a-ea3c-d80d" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial (6+, o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="30ca-4d2a-e6e8-bf14" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="4bd4-4b62-d60e-ed03" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Gran hechicero del Caos" id="34b1-8a79-ac8a-8373" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Personajes" id="2383-c902-5b4b-65a3" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="6b21-f42d-eede-6d03" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Gran hechicero del Caos" id="6a69-92a3-bdcb-ee20" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
