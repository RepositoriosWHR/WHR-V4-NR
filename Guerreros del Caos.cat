            <entryLink name="Marca de Nurgle. Personajes" id="307c-afe0-ade7-0302" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="e849-d817-021f-5a8c" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Señor del Caos" id="0f64-b19d-03d8-d143" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="acab-de08-b8a2-5d4f" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="7ac0-b17e-0fcd-c705" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Señor del Caos" id="6a07-722d-f4cc-a232" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
