        <selectionEntryGroup name="Marca del Caos" id="27c6-6135-0dd0-fb82" collective="false" defaultSelectionEntryId="035e-6b1f-cc7a-b3fb" hidden="false" import="true">
          <constraints>
            <constraint id="2f32-6e64-a94c-d1a9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="46c2-51b6-fa40-26f2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <entryLinks>
            <entryLink name="Marca de Tzeentch. Unidades" id="7358-76fa-ca89-e4a0" collective="false" hidden="false" import="true" targetId="96fb-d019-8c83-aea3" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="34ed-2aaa-3e9e-7f95" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="7">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Tzeentch. Elegidos del Caos en corcel demoníaco" id="2d78-e70d-d8e7-cc73" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 5+ (o +2 si ya disponían de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Unidades" id="f226-7991-01db-28fd" collective="false" hidden="false" import="true" targetId="bc49-6882-c66c-bc26" type="selectionEntry">
              <modifiers>
                <modifier field="points" type="increment" value="6">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca del Caos absoluto. Elegidos del Caos en corcel demoníaco" id="8279-819d-f16b-e576" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad durante la batalla; considera los resultados de 2 como 3. Además, podrán repetir sus tiradas de Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="9ae2-4945-3131-cd70" collective="false" hidden="false" import="true" targetId="f223-1aa7-0d30-eabd" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ataques envenenados" id="bc27-4af6-4718-225e" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink name="Inmune al veneno" id="19da-3d78-0952-d8b0" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="7">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Nurgle. Elegidos del Caos en corcel demoníaco" id="2a9a-ea88-2b22-5fe0" hidden="false">
                  <description>Obtienen las reglas especiales Ataques envenenados e Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="9143-ed27-0de3-0af4" collective="false" hidden="false" import="true" targetId="011d-ecac-f652-9fd9" type="selectionEntry">
              <infoLinks>
                <infoLink name="Indesmoralizable" id="ff1d-8215-e430-db32" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
                <infoLink name="Poder de penetración" id="d48d-6f6e-e164-b255" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="7">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="035e-6b1f-cc7a-b3fb" collective="false" hidden="false" import="true" targetId="01e5-81a4-0637-f7b1" type="selectionEntry">
              <infoLinks>
                <infoLink name="Furia asesina" id="ddd3-0907-8f4c-4910" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Sólo los jinetes)"/>
                  </modifiers>
                </infoLink>
                <infoLink name="Odio" id="9c5a-8f91-f464-28cf" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Sólo las monturas)"/>
                  </modifiers>
                </infoLink>
                <infoLink name="Resistencia mágica (2)" id="7376-d71d-534d-9e36" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="7">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Khorne. Elegidos del Caos en corcel demoníaco" id="82b6-81a9-4af8-bc33" hidden="false">
                  <description>Obtienen las reglas especiales Furia asesina (sólo los jinetes), Odio (sólo las monturas) y Resistencia mágica (2). Además, no perderán su Furia asesina aunque sean derrotados en combate.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
