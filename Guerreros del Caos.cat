          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Tamurkhan" id="119e-e9eb-35c0-0d5d" hidden="false">
              <description>Tamurkhan y Bubelobos portan la Marca de Nurgle, lo que les otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Saga (Tamurkhan)" id="1438-0e2e-7071-b96a" collective="false" hidden="false" import="true" targetId="404d-63db-5060-eeb4" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
