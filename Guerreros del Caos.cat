                <profile name="Mirada de Khrone" id="7912-93a4-da4e-92af" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Mientras Valkia esté en el campo de batalla, puedes repetir todas las tiradas en la tabla del Ojo de los dioses para personajes y unidades con la Marca de Khorne. Además, Valkia tiene la regla especial ¡Ni un paso atrás!, pero sólo para las unidades con la Marca de Khorne</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
