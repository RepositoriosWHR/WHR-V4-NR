                <infoLink name="Inmune a la psicología" id="1099-44f4-ec1f-2c05" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del caos absoluto. Guerreros del Caos" id="8524-37bc-5ec8-b067" hidden="false">
                  <description>Obtienen la regla especial Inmune a psicología; además, al inicio de la batalla efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad (considera los resultados de 2 como 3).</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
      </selectionEntryGroups>
