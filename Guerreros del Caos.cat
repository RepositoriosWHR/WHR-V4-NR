              </modifiers>
              <rules>
                <rule name="Marca de Nurgle. Malditos del Caos" id="4ec1-6663-ab3a-7664" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de Armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Unidades" id="3f39-61c7-f4f1-9f93" collective="false" hidden="false" import="true" targetId="bc49-6882-c66c-bc26" type="selectionEntry">
