      <entryLinks>
        <entryLink name="Marca de Tzeentch. Personajes" id="7704-a688-3203-c72e" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
          <constraints>
            <constraint id="b424-c981-babe-09dd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <rules>
            <rule name="Marca de Tzeentch. Egrimm van Horstmann" id="6c10-8673-a9e8-e93c" hidden="false">
              <description>Egrimm van Horstman y Baudross portan la Marca de Tzeentch, que les otorga la regla especial Ataques flamígeros, un bonificador de +1 a su tirada de salvación especial y un +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="La voluntad del Caos" id="f811-a0ad-7ac6-7b10" hidden="false" targetId="5970-627c-206c-d759" type="rule"/>
        <infoLink name="El ojo de los dioses" id="6ecc-1aa3-9043-5cfe" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
        <infoLink name="Inmune al miedo" id="a649-96c1-0724-c1e1" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
        <infoLink name="Sangre fría" id="668a-09bb-6c7d-649e" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink name="Señor del conocimiento" id="6fad-57da-d28a-e883" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Tzeentch y Luz)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Egrimm Van Horstmann" id="26c0-a3b1-56e6-9396" hidden="false">
          <description>Egrimm van Horstmann es un hechicero de nivel 4 que conoce todos los hechizos de los Saberes de Tzeentch y de la Luz.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Recompensas del Caos" id="7a03-4ca8-1588-beff" collective="false" hidden="false" import="true" type="upgrade">
