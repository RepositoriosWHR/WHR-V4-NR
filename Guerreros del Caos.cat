              </infoLinks>
              <profiles>
                <profile name="Armadura de la condenación" id="e0e8-0291-efb2-7b8c" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. Las tiradas para impactar exitosas contra el portador deberán repetirse. Además, Harry podrá repetir sus tiradas de salvación por armadura fallidas.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Escudo de perdición" id="5fb0-44f3-2b0b-d922" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="9c87-60b7-1349-a846" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
