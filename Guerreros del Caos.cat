        <entryLink name="Marca de Nurgle. Personajes" id="5d30-a6a4-a349-3ebe" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
          <constraints>
            <constraint id="7587-2311-d536-b93d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Inmune al veneno" id="0d2b-5b5d-6e96-6269" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Festus" id="dd3e-ad8b-2e6e-cdf4" hidden="false">
              <description>Festus porta la Marca de Nurgle, lo que le otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Saga (Festus)" id="8f90-1eb5-4869-70c8" collective="false" hidden="false" import="true" targetId="cbb0-0f3b-e03d-5212" type="selectionEntry"/>
      </entryLinks>
