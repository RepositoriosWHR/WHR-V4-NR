              <rules>
                <rule name="Marca de Tzeentch. Malditos del Caos" id="29c6-cde4-f875-1aca" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="67ee-c547-d90b-983a" collective="false" hidden="false" import="true" targetId="f223-1aa7-0d30-eabd" type="selectionEntry">
