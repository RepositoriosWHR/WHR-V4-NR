              <rules>
                <rule name="Marca de Nurgle. Trolls biliosos" id="217a-da42-369f-d53e" hidden="false">
                  <description>Otorga la regla especial Inmune a veneno, los enemigos tengan un penalizador de -1 para impactarles con proyectiles y los enemigos en contacto peana con peana tengan -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
