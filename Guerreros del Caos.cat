      <rules>
        <rule name="Señor de las bestias y mortales" id="fcd9-b70b-35b2-720e" hidden="false">
          <description>La hueste de Bloath puede elegir Unidades Basicas tanto de la lista de Guerreros del Caos como de la lista de Bestias del Caos y puede mezclarlas si lo desea.</description>
        </rule>
      </rules>
