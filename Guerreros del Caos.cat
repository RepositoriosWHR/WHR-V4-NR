                <profile name="Aliento de vida" id="ec71-3d5f-a83c-220b" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Proporciona a Aekold Helbrass una tirada de salvación especial de 4+ (que, combinada con su Marca de Tzeentch,se convierte en 3+). Al inicio de cada turno propio, Aekold recupera una herida que hubiese sufrido con anterioridad durante la batalla.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
