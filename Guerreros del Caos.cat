            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Visión del Caos" id="a224-fc32-5499-04c7" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Sólo hechiceros. El personaje obtiene un bonificador de +2 a todas sus tiradas de Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Tumor inteligente" id="3d4b-4737-4ce0-cc0b" collective="false" hidden="false" import="true" type="upgrade">
