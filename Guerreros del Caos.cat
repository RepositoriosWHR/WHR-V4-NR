      <entryLinks>
        <entryLink name="Marca de Tzeentch. Personajes" id="fd3b-695f-2f1e-1553" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
          <constraints>
            <constraint id="33b5-ef96-a56d-2d16" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="bd1a-b3de-6556-0465" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Ataques mágicos" id="25f1-4089-faf0-3aa7" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Aekold Helbrass" id="80ab-6325-abb3-ae6d" hidden="false">
              <description>Aekold porta la Marca de Tzeentch, que le otorga las reglas especiales Ataques flamígeros y Ataques mágicos y un bonificador de +1 a su tirada de salvación especial.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Saga (Aekold Helbrass)" id="9b30-e13e-7db3-9276" collective="false" hidden="false" import="true" targetId="0131-b70b-4b75-25ae" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="La voluntad del Caos" id="2dbe-ff94-1b1d-7128" hidden="false" targetId="5970-627c-206c-d759" type="rule"/>
        <infoLink name="El ojo de los dioses" id="db25-5fc7-86de-3147" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
