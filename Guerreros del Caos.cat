              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Sólo General del ejército. Aumenta en 6” el radio de su Presencia inspiradora; además, todas las unidades amigas dentro de su radio de Presencia inspiradora obtendrán la regla especial Inmune a psicología (eso incluye al propio personaje).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
