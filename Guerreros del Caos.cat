    <selectionEntry name="[E] - Bloab, engendro de la podredumbre" id="d19c-87a3-3ca5-3a74" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="8576-91cc-81fc-9d34" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
