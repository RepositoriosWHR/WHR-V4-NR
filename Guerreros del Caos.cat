        <entryLink name="Marca de Tzeentch. Personajes" id="d9b5-f163-ac6c-25fc" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
          <constraints>
            <constraint id="a0b9-5ed9-3700-bc24" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="ddec-ce06-f7a2-f099" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Tchar´zanek" id="6f9d-2fe6-740c-3ef3" hidden="false">
              <description>Tchar’zanek porta la Marca de Tzeentch de los Elegidos del Caos, que le otorga la regla especial Ataques flamígeros, un bonificador de +2 a su tirada de salvación especial y un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Leyenda" id="b138-dca9-dba7-9060" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="9570-45e1-fcd8-b0a5" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Leyenda" id="686b-cbdd-bdb2-9ca8" hidden="false" targetId="d331-afa2-533e-c273" type="rule"/>
        <infoLink name="El Ojo de los Dioses" id="e4bc-bfdb-442e-99e3" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
        <infoLink name="Inmune a la psicología" id="27c0-ca47-8cc9-1842" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Tozudez" id="aaf1-4d16-bd60-1336" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
