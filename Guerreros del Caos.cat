          <entryLinks>
            <entryLink name="Marca de Nurgle. Personajes" id="ac9f-b17f-fecc-a403" collective="false" hidden="false" import="true" targetId="964b-8236-6668-ab84" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Miedo" id="7132-7473-c464-9992" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Hechicero del Caos" id="66c0-72e1-241d-8433" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Personajes" id="72ff-9d35-44b2-34a7" collective="false" hidden="false" import="true" targetId="d333-8c87-9c04-4d3b" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="3589-9ded-e0a8-3131" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink name="Sangre fría" id="b1eb-597c-859a-6739" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
                <infoLink name="Poder de penetración" id="ee16-db84-f043-66c9" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="0837-eed9-a444-ab79" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="15"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques flamígeros" id="fd2a-446f-7e0e-4d7d" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Hechicero del Caos" id="7196-4eac-ced6-baae" hidden="false">
                  <description>Obtiene la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella). Además, tiene un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="012b-87fe-afa9-4204" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Inmune a la psicología" id="011d-9f3a-099b-9186" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca del Caos absoluto. Hechicero del Caos" id="eccb-8c3b-5377-c7ed" hidden="false">
                  <description>Obtiene la regla especial Inmune a la psicología. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto al personaje toda la batalla (considera los resultados de 2 como 3) y podrá repetir las tiradas en la tabla del Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
