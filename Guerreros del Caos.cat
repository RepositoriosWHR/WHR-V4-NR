                <infoLink name="Miedo" id="b61d-1836-a22d-ad70" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Nurgle. Paladín del Caos" id="44ae-3899-d729-ce74" hidden="false">
                  <description>Causa Miedo. Además, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Tzeentch. Personajes" id="1eb4-0951-4b83-6873" collective="false" hidden="false" import="true" targetId="0227-474e-a38a-e11c" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="10"/>
              </costs>
              <infoLinks>
                <infoLink name="Ataques mágicos" id="2c91-5a12-98e3-3f5a" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink name="Ataques flamígeros" id="99ac-a521-fe6d-ebb9" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Paladín del Caos" id="2687-c06c-9c25-471f" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Pesonajes" id="4f94-b5e0-efd1-6a92" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
