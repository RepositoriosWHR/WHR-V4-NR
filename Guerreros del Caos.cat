            <infoLink name="Ataques mágicos" id="fa98-1a71-2b69-75ae" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="El estandarte maldito" id="7c4e-bda0-11fd-e0f9" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con la Marca de Tzeentch. El portador y su unidad obtendrán una tirada de salvación especial de 5+ contra proyectiles y ataques con la regla especial Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Guerreros del Caos. Slaanesh" id="637f-ddeb-4e85-79c5" collective="false" hidden="false" import="true">
