          </constraints>
          <entryLinks>
            <entryLink name="Marca de Tzeentch. Unidades" id="2c03-f079-c5a6-660f" collective="false" hidden="false" import="true" targetId="96fb-d019-8c83-aea3" type="selectionEntry">
              <modifiers>
                <modifier field="points" type="increment" value="5">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Tzeentch. Elegidos del Caos" id="7d2c-c146-4ceb-6098" hidden="false">
                  <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 5+ (o +2 si ya disponían de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Unidades" id="131f-2c73-fbb0-34b4" collective="false" hidden="false" import="true" targetId="bc49-6882-c66c-bc26" type="selectionEntry">
              <modifiers>
                <modifier field="points" type="increment" value="4">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca del Caos absoluto. Elegidos del Caos" id="3a51-d751-f3f9-ae55" hidden="false">
                  <description>Al inicio de la batalla, antes del despliegue, efectúa una tirada en la tabla del Ojo de los dioses y aplica el resultado a toda la unidad durante la batalla; considera los resultados de 2 como 3. Además, podrán repetir sus tiradas de Ojo de los dioses.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Nurgle. Unidades" id="793f-1554-bc93-29ab" collective="false" hidden="false" import="true" targetId="f223-1aa7-0d30-eabd" type="selectionEntry">
              <infoLinks>
                <infoLink name="Ataques envenenados" id="b1b8-117e-9d61-748a" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
                <infoLink name="Inmune al veneno" id="91ca-e8a0-67be-1abb" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="points" type="increment" value="5">
                  <repeats>
                    <repeat childId="model" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" repeats="1" roundUp="false" scope="parent" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <rules>
                <rule name="Marca de Nurgle. Elegidos del Caos" id="fb56-5671-fc02-5c89" hidden="false">
                  <description>Obtienen las reglas especiales Ataques envenenados e Inmune a veneno. Los enemigos tienen un penalizador de -1 para impactarles con proyectiles. Los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="2a85-2d9d-ee6c-6e62" collective="false" hidden="false" import="true" targetId="011d-ecac-f652-9fd9" type="selectionEntry">
