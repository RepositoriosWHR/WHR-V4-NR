    <selectionEntry name="[E] - Sayl el Infiel, vidente de los yermos del Caos" id="d10d-6587-5540-2b57" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="4a2e-d2b6-93bb-3718" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="7733-6a35-c62e-ba27" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="3d14-98eb-9ac1-02ea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Marca del Caos absoluto. Pesonajes" id="57b9-3625-ebc8-43b6" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
          <constraints>
            <constraint id="78ba-ea79-987b-7a02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="0d4e-dcc7-8891-4e87" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca del Caos absoluto. Sayl el Infiel" id="6a3b-4139-393b-a912" hidden="false">
              <description>Sayl porta la Marca del Caos absoluto, que le otorga la regla especial Inmune a psicología y podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto a Sayl toda la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="ddaa-534a-bad2-65bc" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="El Ojo de los Dioses" id="b5ed-ca3c-0f6f-170d" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
        <infoLink name="La voluntad del Caos" id="1df4-a6fd-8c6b-77ec" hidden="false" targetId="5970-627c-206c-d759" type="rule"/>
        <infoLink name="Miedo" id="7b13-78a6-9fef-9aa9" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Sayl el Infiel" id="be0a-66ed-5a2f-078c" hidden="false">
          <description>Sayl es un hechicero de nivel 3 que puede elegir sus hechizos de entre los Saberes de los Cielos, las Sombras y Magia Oscura y puede elegir sus hechizos de dos o más de los saberes listados.. Además, conoce el hechizo La niebla del traidor</description>
        </rule>
        <rule name="Visión mutante" id="215f-efd5-3e41-deaf" hidden="false">
          <description>Sayl puede repetir todos los chequeos de atributo que falle (salvo Liderazgo) y tendrá un bonificador de +2 a todas sus tiradas de 
Canalizar.</description>
        </rule>
        <rule name="Hechizo único: La Niebla del traidor (Dificultad 6+)" id="74a3-b1e6-df16-30ef" hidden="false">
          <description>Se trata de un hechizo de Potenciación que Sayl puede lanzar sobre sí mismo. Si se lanza con éxito, Sayl puede hacer inmediatamente un movimiento con la regla especial Volar (10) como si se encontrase en la sub-fase de Resto de movimientos (no podrá utilizar este movimiento para realizar una carga, pero sí para retirarse de un combate).</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Equipo" id="4d23-daec-aa52-ebf9" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="616d-d5e4-e172-ace2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
