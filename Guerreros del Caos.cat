            <profile name="Hechicería del Caos" id="8978-c47d-aaf6-abe0" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="00d0-0537-29c1-7886" collective="false" hidden="false" import="true">
              <entryLinks>
                <entryLink name="Saber de Tzeentch" id="c266-a059-f146-fd2f" collective="false" hidden="false" import="true" targetId="b20e-2adb-6db4-44be" type="selectionEntry"/>
