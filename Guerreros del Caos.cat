      </modifiers>
      <rules>
        <rule name="Magia Hirdra Netshycih, hechicero de Tzeentch" id="960e-1423-7322-1d69" hidden="false">
          <description>Hirdra es un hechicero de nivel 2. Sin embargo, no elige sus hechizos con normalidad.</description>
        </rule>
        <rule name="Visión bruja" id="0c76-7216-d2c4-2dda" hidden="false">
          <description>Hirdra tiene un bonificador de +2 en todas sus tiradas para Canalizar.</description>
        </rule>
        <rule name="Señor del conocimiento del Elíseo" id="b318-68fb-13c5-7d50" hidden="false">
          <description>Hirdra no elige sus hechizos con normalidad: en lugar de eso, siempre conoce los siguientes hechizos: Fuego ardiente de Tzeentch (Saber de Tzeentch), Oscura mano de destrucción (Magia Oscura), Miasma mística de Melkoth (Saber de las Sombras), Sorber el espíritu (Saber de la Muerte), Portento de Phar (Saber de los Cielos) y Bola de fuego (Saber del Fuego).</description>
        </rule>
      </rules>
