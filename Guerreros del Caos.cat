    <selectionEntry name="[B] - Ungors" id="53d8-43e6-573c-3e9a" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="7df0-4312-ed34-2e0e" hidden="false" primary="true" targetId="436f726523232344415441232323"/>
      </categoryLinks>
