              <characteristics>
                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Por cada herida causada en combate cuerpo a cuerpo por el personaje tira 1D6; con un resultado de 5+, podrás añadir un dado de Energía o Dispersión durante la próxima fase de magia (según corresponda).</characteristic>
              </characteristics>
            </profile>
          </profiles>
