      <entryLinks>
        <entryLink name="Marca de Tzeentch. Unidades" id="0fd3-888e-4541-84f2" collective="false" hidden="false" import="true" targetId="96fb-d019-8c83-aea3" type="selectionEntry">
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="7fbe-b7c7-d5de-761e" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Guerreros del Caos" id="9486-682d-a03a-9944" hidden="false">
              <description>Obtienen la regla especial Ataques flamígeros y una tirada de salvación especial de 6+ (o +1 si ya disponían de ella).</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="0913-459d-29db-131a" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Inmune al miedo" id="0104-2b7d-2642-4d17" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
        <infoLink name="La voluntad del caos" id="d318-a91e-1398-5591" hidden="false" targetId="5970-627c-206c-d759" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="df6f-6c6d-a97e-f4fa" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="0"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="La Orden del Elíseo" id="5ab4-81ce-0a14-bd57" hidden="false">
          <description>La unidad de Guerreros del Caos de Tzeentch que acompaña a Aekold tiene un bonificador de +1 a sus atributos de Movimiento, Habilidad de Armas e Iniciativa. Además, mientras Aekold continúe con vida, los Guerreros del Caos obtendrán una tirada de salvación especial de 5+ gracias al Aliento de vida (que se incrementará a 4+ por la Marca de Tzeentch); la Orden del Elíseo también puede efectuar Parada luchando con sus Armas a dos manos. La Orden del Elíseo debe luchar con Armas a dos manos (no pueden elegir otras opciones de armamento ni tampoco Escudos), aunque estas no dispondrán de la regla especial Lenta. El coste total de cada Guerrero del Caos de la Orden del Elíseo es de 21 puntos (pueden incluir grupo de mando y estandarte mágico con normalidad).</description>
        </rule>
      </rules>
