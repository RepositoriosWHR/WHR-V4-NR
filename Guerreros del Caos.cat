            <entryLink name="Marca de Nurgle. Unidades" id="3cb0-e225-5158-922a" collective="false" hidden="false" import="true" targetId="f223-1aa7-0d30-eabd" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="30"/>
              </costs>
              <rules>
                <rule name="Marca de Nurgle. Engendro monstruoso" id="fd58-a5be-217b-8598" hidden="false">
                  <description>Los enemigos tienen un penalizador de -1 para impactarle con proyectiles y en combate cuerpo a cuerpo.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca del Caos absoluto. Unidades" id="455d-3e12-aa48-096d" collective="false" hidden="false" import="true" targetId="bc49-6882-c66c-bc26" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="20"/>
              </costs>
              <rules>
                <rule name="Marca del Caos absoluto. Engendro monstruoso" id="78a2-b332-6cfb-3c80" hidden="false">
                  <description>Al inicio de la batalla, realiza una tirada adicional en la tabla de Mutaciones del Engendro monstruoso y aplica el resultado durante toda la batalla (repite los resultados duplicados).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="5b2c-f380-f09a-7e2e" collective="false" hidden="false" import="true" targetId="011d-ecac-f652-9fd9" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <infoLinks>
                <infoLink name="Poder de penetración" id="2a72-57bd-e709-9b59" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Slaanesh. Engendro monstruoso" id="168d-b4eb-bc0e-6042" hidden="false">
                  <description>Obtiene la regla especial Poder de penetración; además, cada vez que vayas a mover el Engendro monstruoso, puedes repetir la tirada de uno de sus dados de Movimiento aleatorio.</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Khorne. Unidades" id="0187-fe62-9628-59ef" collective="false" hidden="false" import="true" targetId="01e5-81a4-0637-f7b1" type="selectionEntry">
              <costs>
                <cost name="pts" typeId="points" value="25"/>
              </costs>
              <infoLinks>
                <infoLink name="Resistencia mágica (1)" id="3cb7-cf23-f630-9ac7" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
                <infoLink name="Odio (todos los enemigos)" id="4d6c-dc9e-35e1-c6b8" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
                <infoLink name="Ataques aleatorios" id="81f5-0ec1-1695-3bd5" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(2D6+4)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <rules>
                <rule name="Marca de Khorne. Engendro monstruoso" id="ab49-10db-1d5c-813e" hidden="false">
                  <description>Obtiene las reglas especiales Odio (¡todos los enemigos!) y Resistencia mágica (1) y sus Ataques aleatorios pasan a ser 2D6+4.</description>
                </rule>
              </rules>
            </entryLink>
          </entryLinks>
        </selectionEntryGroup>
        <selectionEntryGroup name="Opciones" id="2d9e-3947-9548-a5fe" collective="false" hidden="false" import="true">
          <selectionEntries>
            <selectionEntry name="Segunda tirada tabla de mutaciones" id="2150-1d1d-f7f4-4b02" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="14cd-a8a8-94b6-5803" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <rules>
                <rule name="Segunda tirada tabla de mutaciones" id="4b94-2e5e-e197-1b93" hidden="false">
                  <description>Puedes pagar una segunda tirada en la tabla de mutaciones del Engendro monstruoso por +20 puntos.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Príncipe demonio" id="603f-9503-af47-f74d" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="34a5-ef5a-0ccf-4d82" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
