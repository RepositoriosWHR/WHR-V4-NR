                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Destino de Tzeentch" id="6fe7-ed9a-8bf3-3498" hidden="false" typeId="454f-9dda-874e-99b2" typeName="Recompensa del caos">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">Sólo hechiceros. El personaje puede repetir sus tiradas en la tabla de Disfunciones mágicas.</characteristic>
