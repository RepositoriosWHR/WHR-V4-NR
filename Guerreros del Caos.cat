              </costs>
              <infoLinks>
                <infoLink name="Ataques mágicos" id="918b-5134-80f3-f083" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
                <infoLink name="Ataques flamígeros" id="518f-ea8b-ba37-268f" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Señor del Caos" id="c5cc-507b-0752-68d2" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
