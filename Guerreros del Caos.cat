          </constraints>
          <infoLinks>
            <infoLink name="Ataques flamígeros" id="f753-1307-dc17-a0f3" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Tzeentch. Personajes" id="7bd4-ce2b-3979-ff08" hidden="false">
              <description>Galrauch porta la Marca de Tzeentch, que le otorga la regla especial Ataques flamígeros, una mejora de su tirada de salvación especial (ver Dragón demonio) y un bonificador de +1 a sus tiradas de lanzamiento de hechizos.</description>
            </rule>
          </rules>
        </entryLink>
        <entryLink name="Leyenda" id="3093-0634-87ed-62d9" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
