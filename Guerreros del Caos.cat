              </infoLinks>
              <rules>
                <rule name="Marca de Tzeentch. Bruto despedazador" id="6fd9-b224-c783-6481" hidden="false">
                  <description>Obtiene las reglas especiales Ataques flamígeros y Ataques mágicos y una tirada de salvación especial de 6+ (o +1 si ya disponía de ella).</description>
                </rule>
              </rules>
            </entryLink>
            <entryLink name="Marca de Slaanesh. Unidades" id="eea6-cfaf-f09e-4687" collective="false" hidden="false" import="true" targetId="011d-ecac-f652-9fd9" type="selectionEntry">
