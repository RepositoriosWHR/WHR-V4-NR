        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Marca de Khorne. Personajes" id="c621-84b8-1c8a-3f4d" collective="false" hidden="false" import="true" targetId="7a16-b72a-0527-51a1" type="selectionEntry">
          <constraints>
            <constraint id="0ff8-29e7-865f-836b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Furia asesina" id="16d9-97c5-8821-933f" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
            <infoLink name="Resistencia mágica (2)" id="4402-4801-63b5-5f73" hidden="false" targetId="9718-2e66-193f-7dd6" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Khorne. Skarr Irasangrienta" id="a2ef-3518-048a-8bc7" hidden="false">
              <description>Skarr porta la Marca de Khorne, que le otorga las reglas especiales  Furia Asesina y Resistencia mágica (2). No perderá su Furia asesina aunque sea derrotado en combate.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="El ojo de los dioses" id="4bf0-302b-cf0a-4dcb" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
        <infoLink name="Infantería monstruosa" id="e0d7-c021-febf-c94d" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
        <infoLink name="Inmune a la psicología" id="7fd2-a53c-0018-2412" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Impactos por carga (1D3)" id="c48e-483b-8841-0d39" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
        <infoLink name="Aura demoníaca (4+)" id="45e4-e5f3-7a98-4c48" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Favor de Khorne" id="625b-9307-3d58-622e" hidden="false">
          <description>Skarr puede utilizar su tirada de Aura demoníaca contra Ataques mágicos.</description>
        </rule>
        <rule name="Nacido de la sangre" id="b1d8-821a-8140-9382" hidden="false">
          <description>Una vez por batalla, si Skarr ha sido retirado como baja, coloca un marcador en el lugar que ocupaba la miniatura. Al final de esa fase, devuelve la miniatura al juego con el número de heridas inicial y la regla especial Furia asesina encarada en cualquier dirección a una distancia de 6” o menos del marcador. Si Skarr se coloca en contacto peana con peana con una unidad enemiga, se considerará que ha realizado una carga. El enemigo no obtendrá Puntos de Victoria por acabar con Skarr la primera vez que ha sido retirado.</description>
        </rule>
      </rules>
