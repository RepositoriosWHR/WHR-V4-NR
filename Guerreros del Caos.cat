                <infoLink name="Ataques solo flamígeros" id="404a-d192-1fda-fe46" hidden="false" targetId="5587-433b-16c0-79d1" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Arma de proyectiles)"/>
                  </modifiers>
