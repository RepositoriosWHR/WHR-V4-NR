                <characteristic name="Reglas especiales" typeId="c061-8049-b24d-6e12">El personaje obtiene un ataque adicional que se resolverá con su Fuerza básica y las reglas especiales Ataques envenenados y Heridas múltiples (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
