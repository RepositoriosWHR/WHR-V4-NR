          <constraints>
            <constraint id="53e4-9cda-dfd5-91b4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <infoLinks>
            <infoLink name="Inmune al veneno" id="492e-6239-8b7d-ae2d" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Nurgle. Feytor el Corrupto" id="790a-6717-aad0-6add" hidden="false">
              <description>Feytor porta la Marca de Nurgle, lo que le otorga la regla especial Inmune a veneno, los enemigos tienen un penalizador de -1 para impactarle con proyectiles y los enemigos en contacto peana con peana tendrán -1 a su Habilidad de armas.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Infantería" id="d530-5520-d64a-bc48" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="La voluntad del Caos" id="4a0f-0524-daa3-67e3" hidden="false" targetId="5970-627c-206c-d759" type="rule"/>
        <infoLink name="El ojo de los dioses" id="d185-9270-eb02-5015" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Heraldo de la plaga" id="e770-b941-f0a5-5e30" hidden="false">
          <description>Al inicio de cada fase de combate cuerpo a cuerpo (propia o del oponente), todas las unidades a 6” o menos de Feytor que no tengan la Marca de Nurgle o la regla especial Demonio (Nurgle) sufren 1D6 impactos de Fuerza 1 que no permiten tirada de salvación por armadura. Las bajas causadas por esto cuentan para el resultado del combate.</description>
        </rule>
      </rules>
