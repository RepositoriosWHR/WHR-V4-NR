            <profile name="Gran gusano de plaga" id="9b0e-2512-d85e-e9cf" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
              <characteristics>
                <characteristic name="M" typeId="4d23232344415441232323">6</characteristic>
                <characteristic name="HA" typeId="5.753232323444154e+23">3</characteristic>
                <characteristic name="HP" typeId="4.2532323234441546e+23">4</characteristic>
                <characteristic name="F" typeId="5.323232344415441e+21">6</characteristic>
