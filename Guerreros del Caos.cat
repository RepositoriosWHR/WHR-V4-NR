        <selectionEntryGroup name="Marca del Caos" id="2cc3-85ce-574a-d9ba" collective="false" defaultSelectionEntryId="ac9f-b17f-fecc-a403" hidden="false" import="true">
          <constraints>
            <constraint id="e780-05ce-a6ef-18b7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
