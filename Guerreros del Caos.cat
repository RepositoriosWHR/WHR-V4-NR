    <selectionEntry name="[E] - Harald Hammerstorm &quot;Harry el Martillo&quot;" id="cd90-2573-aef2-7e81" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="2159-2df4-994f-ed8a" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="5ab4-73b3-8f94-e8c5" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
        <constraint id="9b3c-59f1-f931-c768" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <entryLinks>
        <entryLink name="Marca del Caos absoluto. Pesonajes" id="6201-d896-4d7c-a3f2" collective="false" hidden="false" import="true" targetId="0a61-f281-bb4c-8846" type="selectionEntry">
          <constraints>
            <constraint id="5c2a-150f-9d88-0dc9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <rules>
            <rule name="Marca de Khorne. Harry" id="d444-05f3-6a28-4952" hidden="false">
              <description>Harry porta la Marca del Caos Absoluto, lo que hace que podrá repetir las tiradas en la tabla del Ojo de los dioses. Además, al inicio de la batalla, efectúa una tirada en la tabla de Ojo de los dioses y aplica el efecto a Harry toda la batalla (considera los resultados de 2 como 3).</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="El Ojo de los Dioses" id="72b2-d853-7c94-8ea7" hidden="false" targetId="3084-fb3a-ca09-5a55" type="rule"/>
        <infoLink name="Infantería" id="645b-98ab-2b03-a884" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Odio" id="5036-b863-5df4-9bab" hidden="false" targetId="a187-f92e-2178-84ff" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(No muertos)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="9b3c-59f1-f931-c768" type="set" value="1">
          <conditions>
            <condition childId="301b-f442-2dd6-4089" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Azote de los muertos vivientes" id="e756-2201-21bc-1b0f" hidden="false">
          <description>Harry tiene la regla especial Odio (No muertos), la cual confiere también a su unidad. Además, cualquier unidad de No muertos que desee cargar contra Harry deberá superar primero un chequeo de Liderazgo; si lo falla, no podrá declarar ninguna carga ese turno.</description>
        </rule>
        <rule name="Los guerreros de Harry" id="d4df-fe8c-9928-fe72" hidden="false">
          <description>La unidad de Guerreros del Caos a la que se una Harry el Martillo no tiene máximo de unidad; es decir, puedes incluir los Guerreros del Caos que desees en la unidad, no estás limitado al máximo habitual de 30.</description>
        </rule>
      </rules>
      <selectionEntries>
