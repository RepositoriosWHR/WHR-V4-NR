              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador y la unidad en que se encuentre obtiene la regla especial Inmune a Fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Obsequio de la damisela" id="1a17-2dd5-4b54-8c7a" collective="false" hidden="false" import="true" type="upgrade">
