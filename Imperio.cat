              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura de Gromril (tirada de salvación por armadura de 4+ e inmunidad a la regla especial Poder de penetración). Otorga a su portador una tirada de salvación por armadura de 1+.</characteristic>
              </characteristics>
