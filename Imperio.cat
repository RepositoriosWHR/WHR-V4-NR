        <infoLink name="Indesmoralizable" id="cb76-45d5-08bf-32ca" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="2aa1-6c22-087e-2e77" type="set" value="2">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
