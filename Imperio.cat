            <profile name="Liber Daemonica" id="e5bf-2173-71af-043e" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Todas las miniaturas que estén a 12” o menos del portador del Liber Daemonica que posean la regla especial Demonio sufren un -1 a su Liderazgo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Elixir de la tenacidad" id="e100-7bbc-a01c-af80" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="9441-697c-c8ed-80a4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8423-a3f6-2d8b-b654" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <modifiers>
            <modifier field="hidden" type="set" value="true">
              <conditions>
                <condition childId="a7c9-be80-08a2-aff3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
              </conditions>
            </modifier>
          </modifiers>
          <profiles>
            <profile name="Elixhir de la tenacidad" id="57e0-d1cc-10a9-65f6" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Un solo uso. El elixir puede beberse en cualquier momento (tanto en tu turno como en el turno rival). El portador obtendrá las reglas especiales Tozudez y ¡Ni un paso atrás! hasta el final del turno de jugador en curso. Tras beberse el elixir, tira 1D6 para ver qué le sucede al portador:

1 El portador sufre una herida sin tirada de salvación de ningún tipo.
2  El portador sufre una herida y podrá usar sus tiradas de salvación.
3-4 El portador tendrá un penalizador de -1 para impactar durante la siguiente fase de combate cuerpo a cuerpo.
5-6 El portador tendrá un penalizador permanente de -1 a su Habilidad de armas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Herramientas del cazador de brujas. Sólo pistola, ristra de pistolas o pistola de repetición" id="a2ba-d498-e918-05c5" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="af9c-7023-effe-bbfc" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="4a84-a14c-4fab-ae6e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
