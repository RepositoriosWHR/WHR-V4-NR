      <rules>
        <rule name="Tropa de Ostland" id="1f1f-9927-618c-d82c" hidden="false">
          <description>Valmir Von Raukov obtiene un bonificador extraordinario de +1 al resultado de los combates en los que participe. Puedes elegir una unidad de Espadachines, Lanceros, Alabarderos, Arqueros, Ballesteros o Grandes espaderos y convertirlos en Tropas de Ostland, lo que les permite repetir sus chequeos de desmoralización fallidos.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Tiradores de Hochland" id="f9e7-6913-1781-38b9" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="6271-4252-8d81-8790" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
