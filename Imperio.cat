            <profile name="Escudo de la gorgona" id="5b8c-61f0-0023-a453" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Escudo. Los enemigos en contacto peana con peana con el portador realizarán un ataque menos en combate cuerpo a cuerpo (con un mínimo de 1 ataque).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
