                <profile name="Deflagración alquímica" id="bcec-dcba-55f3-4c3e" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Un sólo uso. Puede usarse durante una de tus fases de movimiento. Selecciona una unidad enemiga sobre la que se moviese el portador durante su movimiento: Balthasar dejará caer el vial, que causará 1D6 impactos automáticos de Fuerza 5 con las reglas especiales Ataques mágicos y Ataques sólo flamígeros que negarán la tirada de salvación por armadura.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Báculo de Volans" id="0c80-285e-411d-c4ab" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="323b-c4b7-b756-fb29" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="8223-c45b-d718-a8be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
