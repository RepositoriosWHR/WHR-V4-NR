            <profile name="Martillo de acero bendito" id="5de7-621a-0e1f-8930" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo Sacerdote guerrero de Sigmar o Archilector de Sigmar. Arma de mano. Los impactos con este arma se resolverán con un bonificador de +1 a la Fuerza. Además, suma 1D3 al valor de lanzamiento de todas las Plegarias de Sigmar que utilice su portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
