              </costs>
              <infoLinks>
                <infoLink name="Resistencia mágica (1)" id="e4d1-d284-934d-7231" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Amuleto de oro marino" id="a112-41c3-7f94-2111" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Balthasar y cualquier unidad amiga situada a 6” o menos del portador obtendrán la regla especial Resistencia mágica (1).</characteristic>
                  </characteristics>
                </profile>
