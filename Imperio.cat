          <profiles>
            <profile name="Urdimbre de encantamientos " id="0724-94ee-a959-1c81" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Esta piedra proporciona a su portador una tirada de salvación especial de 4+ contra ataques a distancia. Además, toda miniatura que intente atacar a su portador en combate cuerpo a cuerpo tendrá que superar un chequeo de liderazgo; si lo falla, tan sólo logrará impactar con resultados de 6 durante dicha fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Garra del dragón" id="c652-5c6b-1803-293a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a386-d328-59f1-65d7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8efa-9aeb-0ada-a966" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
