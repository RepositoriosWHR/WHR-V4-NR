          <infoLinks>
            <infoLink name="Inmune al veneno" id="7541-6965-9802-5a19" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
            <infoLink name="Arma de mano" id="abf5-c693-6fa8-34ef" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Requiere ambas manos" id="9f8c-f57d-1e09-1c1f" hidden="false" targetId="41a9-6192-62dd-4867" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Matasierpes" id="9552-132e-1d12-7922" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Requiere ambas manos. Los impactos con este arma se resolverán con un bonificador de +1 a la Fuerza. Los impactos de esta arma siempre herirán con un resultado de 4+ salvo que la Fuerza del ataque permita herir con un resultado menor. Cualquier miniatura herida por esta arma no podrá beneficiase de su salvación por Piel escamosa ni Protección por montura para salvar dicha herida. Por último, el portador obtiene la regla especial Inmune a veneno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
