    <selectionEntry name="Tropa de Ostland" id="e210-1374-fd75-5f29" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="0c5e-5ce3-a6c1-23fb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
