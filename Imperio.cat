    <selectionEntry name="[Ex] - Sacerdotisa de Shallya" id="8480-900f-8315-65dd" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="b639-6be9-c0e1-2bdd" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
