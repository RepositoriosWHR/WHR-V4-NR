        <infoLink name="Inmune a la psicología" id="bb8c-8bf7-aa7d-5244" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
        <infoLink name="Odio (todos los enemigos)" id="b5fd-e6f6-5b59-0cdd" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Incitar al odio" id="7fec-c8a2-9988-26a7" hidden="false">
          <description>Si se incluye en una unidad, esta ganará la regla especial Odio (¡todos los enemigos!) mientras Zarah permanezca con vida. Esto no afecta a otros personajes. No puede incluirse a Zarah en una unidad en la que también haya un hechicero, ni a una unidad de Enanos imperiales, Halflings imperiales ni Ogros imperiales.</description>
        </rule>
        <rule name="La cazadora de vampiros" id="c85d-bc1b-cfb2-d58e" hidden="false">
          <description>Zarah puede repetir las tiradas para impactar que realice contra miniaturas con la regla especial Vampiro. Además, posee la regla especial Esquivar (4+).</description>
        </rule>
      </rules>
      <selectionEntries>
