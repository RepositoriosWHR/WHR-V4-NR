              <profiles>
                <profile name="Orden de los caballeros de la furia de Taal" id="e7f9-4240-7879-f6d9" hidden="false" typeId="208e-cf58-eefc-06d2" typeName="Orden de caballería">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="51e0-e3ae-aafd-aac4">Obtienen las reglas especiales Cruzar (bosques) y Odio (Bestias del Caos), poseen una tirada de salvación especial de 6+ debido a sus talismanes protectores, y sustituyen sus lanzas de caballería por alabardas.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Odio (Bestias del caos)" id="4ce8-5773-021a-c6a6" hidden="false">
                  <description>Una miniatura que Odie podrá repetir los resultados de 1 obtenidos en sus tiradas para impactar en combate cuerpo a cuerpo contra aquellos a quienes odie.</description>
                </rule>
              </rules>
            </selectionEntry>
