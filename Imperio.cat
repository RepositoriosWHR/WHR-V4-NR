      <rules>
        <rule name="Rivalidad (Marius Leitdorf)" id="4b03-d950-8627-6b7b" hidden="false">
          <description>No puede incluirse a Kurt en el mismo ejercito que incluya a Marius Leitdorf y viceversa, a menos que el General sea Karl Franz.</description>
        </rule>
        <rule name="Disciplina ferrea" id="6330-5aac-ff50-f0f5" hidden="false">
          <description>Si Kurt está unido a una unidad de Caballeros del círculo interior de la Reiksguard, todas las miniaturas de la unidad obtendrán la regla especial Indesmoralizables.</description>
        </rule>
        <rule name="Juramento de lealtad (Reiksguard)" id="9f79-27de-1311-589a" hidden="false">
          <description>Kurt Helborg se considera un Maestre templario de la Orden de caballería de la Reiksguard.</description>
        </rule>
      </rules>
