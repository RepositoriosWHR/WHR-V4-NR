              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Ballesta. Sus disparos se resuelven con Fuerza 5 y tienen las reglas especiales Ataques mágicos, Disparo rápido y Francotirador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
