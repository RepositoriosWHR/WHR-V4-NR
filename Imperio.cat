    <selectionEntry name="[E] - Ar-Ulric Emil Valgeir" id="968a-523a-10e4-8f80" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Comandantes" id="cd28-53d8-8ef1-8ac7" hidden="false" primary="true" targetId="4c6f72647323232344415441232323"/>
        <categoryLink name="Personajes" id="d455-c226-dca6-9ed8" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
      <constraints>
