            <profile name="Estandarte del matademonios" id="7949-f1f7-fa19-6bc3" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo Órdenes de caballería. La unidad causará Miedo durante cualquier turno que declarase una carga. Además, podrá sumar +1D3” a la primera carga que realice durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
