          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Cazador de monstruos" id="5ebf-7b7b-3ef5-74f5" hidden="false">
          <description>Markus, y la unidad de Cazadores a la que se una podrá repetir las tiradas para herir fallidas (tanto en combate como con armas de disparo) contra miniaturas enemigas del Tipo Monstruo. Además, Markus y su unidad son inmunes al Terror causado por monstruos.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Tierra de cazadores" id="224a-9307-74e8-63d3" collective="false" hidden="false" import="true" type="upgrade">
