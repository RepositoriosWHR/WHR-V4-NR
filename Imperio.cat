      <rules>
        <rule name="Magia Marta Candela, gran hechicera de la orden gris de Altdorf" id="b2c9-edf3-f4dc-3009" hidden="false">
          <description>Marta Candela es una hechicera de nivel de magia 4 que conoce todos los hechizos del Saber de las Sombras.</description>
        </rule>
        <rule name="Organización sinuosa" id="892a-da9a-d361-3489" hidden="false">
          <description>Antes de empezar la batalla, tras el despliegue, puedes retirar del campo de batalla una única unidad de tu ejército y volver a situarla en cualquier otra parte de tu zona de despliegue.</description>
        </rule>
      </rules>
