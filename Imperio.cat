          <profiles>
            <profile name="Armadura de oro élfico" id="b875-494e-0399-be47" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura dragón (otorga a su portador una tirada de salvación por armadura de 5+, una tirada de salvación especial de 6+ y la regla especial Inmune a fuego). Por cada impacto exitoso en combate cuerpo a cuerpo, el oponente que causó el impacto deberá realizar un chequeo de Fuerza: si lo falla, el ataque se considerará fallido y no deberá tirarse para herir.</characteristic>
              </characteristics>
            </profile>
            <profile name="Armadura de dragón" id="7599-2c48-bfeb-f089" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
              <characteristics>
                <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">5+</characteristic>
                <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ofrece una Tirada de Salvación Especial de 6+.  Su portador obtiene la regla especial Inmune a fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
