          <profiles>
            <profile name="Pabellón de la disciplina estatal" id="6834-bff4-c17d-c766" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Solo unidades con la regla especial Destacamentos. Duplica la Potencia de unidad que porte este estandarte. Además, los Destacamentos a 6” o menos de esta Unidad principal también se beneficiarán de él.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
