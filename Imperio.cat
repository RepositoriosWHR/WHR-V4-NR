    <selectionEntry name="[Ex] - Gran brasero de Aqshy" id="7fee-2af2-4f55-9262" collective="false" hidden="false" import="true" type="unit">
      <constraints>
        <constraint id="b878-bfc4-0228-095c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
