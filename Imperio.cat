          </modifiers>
          <profiles>
            <profile name="Poción sanadora" id="7b7d-4a4f-d912-dbd1" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Un solo uso. Puede utilizarse al inicio de cualquiera de tus turnos. El portador recupera una herida que hubiese sufrido con anterioridad durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Liber lumínica" id="40e2-4221-8b22-ea73" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c77d-68c4-24c4-5dbe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8941-dc38-c6aa-d849" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
