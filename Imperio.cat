                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Los impactos que sufra Zarah tendrán un penalizador de -1 a su valor de Fuerza; esto no tiene efecto en impactos que hieran automáticamente o no tengan un valor de Fuerza.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
