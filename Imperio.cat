            <profile name="Duelista" id="5ef4-a7ba-e13d-1d21" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El personaje obtiene +1 a su Habilidad de armas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Imperio. Con regla destacamentos" id="c2c6-e4a0-070f-95f7" collective="false" hidden="false" import="true">
