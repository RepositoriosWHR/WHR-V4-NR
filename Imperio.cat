    <selectionEntry name="Juramentados de Ulric" id="54c7-57c2-2fc7-b734" collective="false" hidden="false" import="true" type="upgrade">
      <constraints>
        <constraint id="f2e9-129d-e32a-164c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
