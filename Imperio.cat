    <selectionEntry name="Huracanum celestial" id="1285-e755-5574-b94c" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Unidades Singulares" id="0a6a-93e9-9c05-c13e" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
