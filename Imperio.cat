      <rules>
        <rule name="Magia Gregor Martak" id="75c7-9876-f0af-c566" hidden="false">
          <description>Gregor es un hechicero de nivel 4 que conoce todos los hechizos del Saber de las Bestias.</description>
        </rule>
        <rule name="Patriarca del colegio ámbar" id="8224-0984-1676-c6f7" hidden="false">
          <description>Gregor tiene la regla especial Señor del Conocimiento (Bestias). Además, tiene un bonificador de +1 para lanzar hechizos de dicho saber. Por último, Gregor tiene un bonificador de +2 a sus tiradas de Canalización.</description>
        </rule>
      </rules>
