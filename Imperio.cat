            <profile name="Obsequio de la damisela" id="03f5-b815-2dcb-669b" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Un solo uso. El portador puede repetir una tirada de 1D6: puede tratarse de una tirada para impactar, para herir, tirada de salvación por armadura o especial, o un chequeo de atributo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
