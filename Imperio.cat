                <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Los ataques y disparos realizados contra el portador tienen un penalizador de -1 para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
