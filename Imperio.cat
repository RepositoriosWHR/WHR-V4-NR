              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador podrá repetir los resultados de 1 natural en las tiradas de salvación por armadura que efectúe.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Taslimanes mágicos de la cámara del tesoro" id="7321-50b8-4d90-6f93" collective="false" hidden="false" import="true">
