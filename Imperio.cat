              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al inicio de la batalla elige una miniatura de personaje enemiga. Todos los ataques efectuados usando esta espada que tenga como objetivo al personaje elegido se resolverán con +2 a la Fuerza y la regla especial Heridas Múltiples (1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
