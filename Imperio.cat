              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Los disparos efectuados contra el portador o la unidad en la que se encuentre tendrán un penalizador de -1 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
