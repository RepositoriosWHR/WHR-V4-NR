      <rules>
        <rule name="Atuendo de camuflaje" id="d43a-c942-d3bc-45d5" hidden="false">
          <description>Los disparos contra Raidocks sufrirán un penalizador de -1 a su tirada para impactar. Adicionalmente, su tirada de salvación por Esquivar mejorará en un punto contra disparos.</description>
        </rule>
        <rule name="Lealtad (La Asamblea)" id="6a04-aa86-d49f-928d" hidden="false">
          <description>Puede utilizar las reglas especiales Presencia Inspiradora y “¡Ni un paso atrás!” si se incluye en alguno de los ejércitos indicados.</description>
        </rule>
      </rules>
