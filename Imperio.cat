              </infoLinks>
            </selectionEntry>
            <selectionEntry name="Cetro de la imolación" id="407a-80e3-ff18-57ee" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f2b2-7f8e-b4ca-4450" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="cfad-1b33-9060-4ba6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Cetro de la imolación" id="bcb0-0346-9e84-702e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sienna puede lanzar el hechizo Tormenta de fuego si para su lanzamiento destina al menos 3 dados  de Energía adicionales de los obtenidos por la  regla especial Temperamento ardiente. Sienna  puede superar el límite de dados de Energía máximo impuesto por su nivel de magia al lanzar este hechizo.</characteristic>
                  </characteristics>
                </profile>
