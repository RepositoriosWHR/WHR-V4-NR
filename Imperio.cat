      <rules>
        <rule name="Lider del imperio" id="b6e1-239b-6fd7-22b3" hidden="false">
          <description>El radio de la regla especial Presencia inspiradora de Karl Franz aumenta hasta 24”; no aumenta más si va montado en un Objetivo grande.</description>
        </rule>
        <rule name="Príncipe de Reikland" id="8744-bbdc-6e9f-09d0" hidden="false">
          <description>Puedes elegir una unidad de Espadachines, Lanceros, Alabarderos, Arqueros, Ballesteros, Fusileros o Grandes espaderos y convertirlos en Tropas de Reikland: el Oficial de la unidad obtiene un bonificador de +1HA, +1 HP, +1F y +1I.</description>
        </rule>
      </rules>
