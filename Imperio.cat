    <selectionEntry name="[E] - Genieve Sandrine de Pointe du Lac Diedonné" id="06a0-4908-af37-8e8c" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Héroes" id="bdb4-58f2-2066-33ec" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
        <categoryLink name="Personajes" id="dbbe-a91f-88a4-7d59" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
      </categoryLinks>
