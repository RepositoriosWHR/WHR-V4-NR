        <constraint id="7b2d-29e9-b52c-62b3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Manto sombrío" id="846b-6842-73bd-22e0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c380-1b1e-ff09-d127" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="2a29-37f1-45b2-a13c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Manto sombrío" id="f8bb-52dc-a1b7-27b4" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador podrá repetir las tiradas de salvación fallidas que obtuviese por la regla especial Esquiva. El portador no podrá ser elegido como objetivo por disparos provenientes de unidades situadas a 12” o mas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolsa del oro mágico" id="088d-c973-07fc-3ebf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="62c9-e5fc-3a47-e20e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0064-f47e-6fe6-b269" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bolsa del oro mágico" id="3d8d-75d0-72e1-1890" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Pueden usarse para hacer que una unidad situada a 6” o menos del portador supere automáticamente un chequeo de liderazgo fallido.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bolsa del oro maldito" id="ffa8-26a1-c2ee-8455" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6a7f-991d-8f45-0b17" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="bc69-13d1-dc61-958e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Bolsa del oro maldito" id="0bb8-37f7-bdcd-eb23" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede usar bolsa de oro maldito al inicio de un turno del oponente para obligar a una unidad enemiga a 8&quot; a declarar una carga contra el portador de la bolsa: la unidad seleccionada debe declarar carga contra el portador (o la unidad en la que se encuentre) obligatoriamente. No tiene ningún efecto contra miniaturas Inmunes a Psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pergamino del contrato vinculante" id="063a-5090-6db2-a65d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eff8-d301-2f21-8d34" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="356c-8568-343d-df0f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune a la psicología" id="2c80-6fa3-ae8e-1d6e" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pergamino del contrato vinculante" id="508a-6efc-51f1-0364" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Todas las unidades amigas mercenarias a 12&quot; o menos del protador serán Inmunes a la psicología.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Objetos hechizados. Mercenarios. Llave de la cámara del tesoro" id="aaee-ad12-b0aa-76fd" collective="false" hidden="false" import="true">
      <constraints>
