      </modifiers>
      <rules>
        <rule name="Rencoroso" id="c90e-b6df-b3f1-1a7c" hidden="false">
          <description>Si Theodoric es el General del ejército no podrás elegir hechiceros que conozcan el Saber del Metal. No podrás incluir a Theodoric en el mismo ejército en el que se incluya también a Balthasar Gelt, salvo que el ejército lo comande el mismo Karl Franz.</description>
        </rule>
      </rules>
    </selectionEntry>
