            <modifier field="name" type="append" value="(Saber de la vida)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Resistencia mágica (1)" id="9a84-ecfe-70d5-a7ea" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
        <infoLink name="Inmune al veneno" id="9e7a-4158-abe6-7f8f" hidden="false" targetId="0338-1cb0-0dc1-2892" type="rule"/>
        <infoLink name="Regeneración (6+)" id="e944-961c-a175-7c77" hidden="false" targetId="4aee-7485-a141-cd20" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Doctor Drexler" id="60e3-af92-ba45-fe71" hidden="false">
          <description>Drexler es un hechicero de nivel 2. Siempre elige sus hechizos del Saber de la Vida.</description>
        </rule>
        <rule name="El mejor médico de Nuln" id="b396-2a60-0c68-8300" hidden="false">
          <description>Drexler y cualquier unidad a la que se una obtienen las reglas especiales Resistencia mágica (1), Inmune a veneno y Regeneración (6+).</description>
        </rule>
        <rule name="Enemigo del caos" id="c46d-9117-02c6-6462" hidden="false">
          <description>Drexler puede repetir todos sus chequeos de Miedo fallidos. Además, obtiene un bonificador de +1 en sus tiradas de dispersión de hechizos contra hechizos de los Saberes del Viento de Magia Oscura; esto aumenta a +2 contra hechizos del Saber de Nurgle y hechizos del Saber de Plaga Skaven.</description>
        </rule>
      </rules>
