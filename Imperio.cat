        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Disparo rápido, Poder de penetración, Disparos múltiples (3)</characteristic>
      </characteristics>
    </profile>
    <profile name="Ristra de pistolas de repetición (Disparo)" id="9c48-727e-b3f8-a7dd" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
