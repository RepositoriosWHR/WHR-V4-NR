        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <rules>
        <rule name="Tropa de Middenland" id="f96b-5208-047a-5387" hidden="false">
          <description>Puedes elegir una unidad de Espadachines, Lanceros, Alabarderos, Arqueros, Ballesteros o Grandes espaderos y convertirlos en Tropas de Middenland, lo que les permite repetir sus tiradas para herir de 1 contra enemigos con su mismo Liderazgo o menor.</description>
        </rule>
      </rules>
    </selectionEntry>
    <selectionEntry name="Tropa de Averland" id="cf5e-65c7-00c9-cdd2" collective="false" hidden="false" import="true" type="upgrade">
