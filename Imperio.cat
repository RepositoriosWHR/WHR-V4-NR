          <profiles>
            <profile name="Bastón de bruja" id="338b-975f-631a-e70e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Genera en cada fase de magia propia 1D3 dados de Energía adicionales que sólo puede utilizar el portador.
Cualquier resultado de 1 en cualquiera de los dados proporcionados causará al usuario una herida sin tirada de salvación por armadura. Estos dados no pueden ser guardados en ningún otro objeto mágico.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
