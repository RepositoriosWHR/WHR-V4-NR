            <infoLink name="Arma a dos manos" id="e4fb-d0d3-958d-00e5" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Hacha de la destrucción" id="24b5-c099-e10f-3c1a" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Las heridas causadas por este arma no permiten tirada de salvación por armadura. Además, contra miniaturas de los ejércitos de las Fuerzas del Orden sus impactos se resuelven con la regla especial Heridas múltiples 
(1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
