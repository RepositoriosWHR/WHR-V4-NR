              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con la Marca de Slaanesh. Si el portador y su unidad obtienen un resultado de dobles al efectuar un chequeo de desmoralización, se considerará que ha obtenido un resultado de doble uno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="[GC] - Objetos hechizados. Guerreros del Caos" id="6e24-77e2-ebc6-977d" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c96e-8c7b-ea0c-b5e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="cd37-3df8-01ad-e084" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Yelmo de incontables ojos" id="9ee2-254e-87fe-4679" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e398-ee02-d234-efed" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="39cb-4cfc-8960-f440" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Yelmo de incontables ojos" id="4a46-fabe-1bcd-254a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador verá su tirada de salvación por armadura incrementada en un +1. Además, aumenta su Iniciativa a 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Poción del caos" id="c17b-a9da-d190-c8df" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="aa37-68b2-d046-8432" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="ec35-638b-ba9f-526b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Poción del caos" id="4e98-76a3-aed3-c89f" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje puede beberla al inicio de la batalla, tras el despliegue. Tira 1D6 en la siguiente tabla: 
D6 Poción del Caos
1 Engendro del Caos: El personaje se transforma en un Engendro del Caos con la Marca del Caos apropiada. Si tu ejército incluye una unidad de Engendros del Caos con la misma Marca del Caos, puedes unirlo a ella. 
2 Fuerza demencial: Obtiene +1 a su Fuerza y la regla especial Estupidez. 
3 Llamas del Caos: Obtiene la regla especial Ataques flamígeros y un Arma de aliento de Fuerza 4 con la regla especial Ataques sólo flamígeros. 
4 Metabolismo acelerado: Obtiene la regla especial Regeneración (4+). 
5 Furia homicida: Obtiene +1 a su Fuerza, Resistencia y Ataques. 
6 Poder del Caos: Suma +1 a todos sus atributos (excepto Movimiento y Liderazgo). Al inicio de cada uno de sus turnos, debe superar un chequeo de Resistencia o sufrirá 1 herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de piedra de disformidad" id="6542-68b8-d46b-c082" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7b61-4ab3-d1a8-f780" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="7b40-399f-cbdf-2542" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="45a2-52dd-b04b-59b8" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, un único dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Favor de los dioses" id="083d-d7e0-9c9b-2317" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3536-64d5-4c17-8f21" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="734a-6d15-679b-c379" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Favor de los dioses" id="89a1-6e74-b89d-ce48" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla del Ojo de los dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="[GC] - Objetos hechizados. Guerreros del Caos. No Khorne ni hechiceros" id="219d-131d-49ab-ce1b" collective="false" hidden="false" import="true">
      <constraints>
