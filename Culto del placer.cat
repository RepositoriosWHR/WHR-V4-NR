              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. Los oponentes deberán repetir todas las tiradas para impactar superadas contra el portador en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
