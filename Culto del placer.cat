      </constraints>
      <selectionEntries>
        <selectionEntry id="53e0-a6e9-fff2-afeb" name="Estandarte del éxtasis" page="0" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="b5f0-5cd9-521c-deba" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="344f-5d8a-c9f0-e9fb" type="max"/>
          </constraints>
          <profiles>
            <profile id="7800-058b-f9c5-c679" name="Estandarte del éxtasis" page="0" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Sólo miniaturas con la Marca de Slaanesh. Si el portador y su unidad obtienen un resultado de dobles al efectuar un chequeo de desmoralización, se considerará que ha obtenido un resultado de doble uno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="6e24-77e2-ebc6-977d" name="[GC] - Objetos hechizados. Guerreros del Caos" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c96e-8c7b-ea0c-b5e5" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cd37-3df8-01ad-e084" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="9ee2-254e-87fe-4679" name="Yelmo de incontables ojos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e398-ee02-d234-efed" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="39cb-4cfc-8960-f440" type="max"/>
          </constraints>
          <profiles>
            <profile id="4a46-fabe-1bcd-254a" name="Yelmo de incontables ojos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador verá su tirada de salvación por armadura incrementada en un +1. Además, aumenta su Iniciativa a 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="c17b-a9da-d190-c8df" name="Poción del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="aa37-68b2-d046-8432" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="ec35-638b-ba9f-526b" type="max"/>
          </constraints>
          <profiles>
            <profile id="4e98-76a3-aed3-c89f" name="Poción del caos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje puede beberla al inicio de la batalla, tras el despliegue. Tira 1D6 en la siguiente tabla: 
D6 Poción del Caos
1 Engendro del Caos: El personaje se transforma en un Engendro del Caos con la Marca del Caos apropiada. Si tu ejército incluye una unidad de Engendros del Caos con la misma Marca del Caos, puedes unirlo a ella. 
2 Fuerza demencial: Obtiene +1 a su Fuerza y la regla especial Estupidez. 
3 Llamas del Caos: Obtiene la regla especial Ataques flamígeros y un Arma de aliento de Fuerza 4 con la regla especial Ataques sólo flamígeros. 
4 Metabolismo acelerado: Obtiene la regla especial Regeneración (4+). 
5 Furia homicida: Obtiene +1 a su Fuerza, Resistencia y Ataques. 
6 Poder del Caos: Suma +1 a todos sus atributos (excepto Movimiento y Liderazgo). Al inicio de cada uno de sus turnos, debe superar un chequeo de Resistencia o sufrirá 1 herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="6542-68b8-d46b-c082" name="Amuleto de piedra de disformidad" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7b61-4ab3-d1a8-f780" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7b40-399f-cbdf-2542" type="max"/>
          </constraints>
          <profiles>
            <profile id="45a2-52dd-b04b-59b8" name="Amuleto de piedra de disformidad" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, Canalizar, un único dado de Energía o Dispersión o una tirada en la tabla de Disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="083d-d7e0-9c9b-2317" name="Favor de los dioses" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3536-64d5-4c17-8f21" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="734a-6d15-679b-c379" type="max"/>
          </constraints>
          <profiles>
            <profile id="89a1-6e74-b89d-ce48" name="Favor de los dioses" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla del Ojo de los dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="5.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="219d-131d-49ab-ce1b" name="[GC] - Objetos hechizados. Guerreros del Caos. No Khorne ni hechiceros" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="9660-b53d-f5d8-750e" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ab7e-ea25-54cd-bb1e" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="4cef-38ac-1e65-c54e" name="Libro de los secretos del caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="af72-51d4-5fbd-463b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b539-c841-402d-0838" type="max"/>
          </constraints>
          <profiles>
            <profile id="2c82-ac2f-b753-bc1a" name="Libro de los secretos del caos" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador pasa a considerarse hechicero de nivel 1 que puede utilizar el Saber de las Sombras, el Fuego o la Muerte. No puede ser utilizado por miniaturas con la Marca de Khorne o por personajes que ya tuviesen uno o más niveles de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup id="4b7c-5519-0be2-cf44" name="Los saberes de la magia" hidden="false" collective="false" import="true">
              <entryLinks>
                <entryLink id="0f8b-5647-9a36-8b33" name="Saber de Sombras" hidden="false" collective="false" import="true" targetId="18bb-6c37-1cfe-8766" type="selectionEntry"/>
                <entryLink id="bbe3-d942-9530-25d7" name="Saber de la Muerte" hidden="false" collective="false" import="true" targetId="64a6-d9e9-3822-4168" type="selectionEntry"/>
                <entryLink id="4351-40ec-93b5-01f4" name="Saber del Fuego" hidden="false" collective="false" import="true" targetId="bff8-8e34-eb37-f67a" type="selectionEntry"/>
              </entryLinks>
            </selectionEntryGroup>
          </selectionEntryGroups>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="c746-c393-d245-5a14" name="[GC] - Objetos hechizados. Guerreros del Caos. Slaanesh" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="e286-8a12-dd6e-5626" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d35a-47d7-9ed1-0f80" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="55c3-8253-6992-5ca2" name="Colgante de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="67d7-c397-244b-fc6c" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b960-3df3-cf80-51db" type="max"/>
          </constraints>
          <profiles>
            <profile id="6e8c-869b-e577-e46b" name="Colgante de Slaanesh" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Slaanesh. Por cada herida que sufra el portador, su atributo de Ataques aumenta en un punto (hasta un máximo de 10).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="3267-74e6-485d-1c9d" name="Cadenas de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="0d52-e934-dbce-0313" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="9b65-b05f-5b3f-0369" type="max"/>
