            <profile id="fb7e-923b-699f-6589" name="Látigo flagelador de almas" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Los ataques del demonio en combate obtendrán un bonificador de +1 a la Fuerza. Por cada herida causada a una miniatura enemiga con este Arma demonio, la miniatura herida deberá superar un chequeo de Liderazgo o deberá ser retirada como baja. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="512f-628e-09af-3063" name="Arma demonio" hidden="false" collective="false" import="true" targetId="5250-fd95-da34-9955" type="selectionEntry"/>
