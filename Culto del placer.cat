              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene un ataque adicional que se resolverá con su Fuerza básica y las reglas especiales Ataques envenenados y Heridas múltiples (2).</characteristic>
              </characteristics>
