          <selectionEntries>
            <selectionEntry id="5f47-6fc8-b3b6-5934" name="Desgarracorazones y la Espada Oscura" hidden="false" collective="false" import="true" type="upgrade">
              <constraints>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ae72-2c2b-e9cc-d4e5" type="max"/>
                <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="704f-b118-7e2e-6d0b" type="min"/>
              </constraints>
              <profiles>
                <profile id="2fa0-9b75-5328-e4b7" name="Desgarracorazones y la Espada Oscura" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los impactos realizados con esta arma tienen la regla especial Golpe letal y se resuelven con un bonificador de +2 a la Fuerza en el turno en el que Morathi cargue. Además, un monstruo o personaje que sufra una o más heridas no salvadas por parte de Desgarracorazones y la Espada Oscura reduce sus atributos de Ataques, Fuerza y Resistencia en 1 punto (hasta un mínimo de 1) por cada herida no salvada. Estos penalizadores se aplican al final de la ronda de combate cuerpo a cuerpo en la que se sufrieron las heridas, y duran el resto de la partida.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <infoLinks>
                <infoLink id="7b6f-fd0c-1652-079d" name="Arma emparejadas" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink id="a6e6-3636-bf39-7afd" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
              </infoLinks>
              <entryLinks>
                <entryLink id="e79f-f5e0-7f0b-99b9" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
              </entryLinks>
