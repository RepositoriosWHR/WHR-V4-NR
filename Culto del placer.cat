              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene un ataque adicional que siempre se realizará con su Fuerza básica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mirada disforme" id="eff5-6f60-0037-e59b" collective="false" hidden="false" import="true" type="upgrade">
