          <profiles>
            <profile id="2922-fa5c-202a-d7f0" name="Corona de la Arrogancia Sublime" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Yelmo. Otorga un bonificador adicional de +1 a la tirada de salvación por armadura. Además, en la fase de combate cuerpo a cuerpo, el portador suma +1 a la resolución del combate de su unidad si durante un desafío el rival no consigue infligirle al menos una herida no salvada.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
