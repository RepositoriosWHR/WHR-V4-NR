            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Odio (todos los enemigos)" id="8383-9563-b0ce-ac31" hidden="false" targetId="69e8-bae0-e71a-64f6" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Pabellón del odio" id="65de-c2b4-9fc5-6de8" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtendrán la regla especial Odio (¡todos los enemigos!). Los resultados de 1 para impactar (después de repetir) se resolverán para herir contra la propia unidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pabellón demoníaco" id="9252-2f5f-1da6-6a47" collective="false" hidden="false" import="true" page="0" type="upgrade">
