              <rules>
                <rule id="f167-9328-3300-7de4" name="Carro desollador" hidden="false">
                  <description>Un Carro desollador de Slaanesh causa 2D6+1 impactos por carga (incluye las Cuchillas), sustituye una de las Diablillas de Slaanesh por una Súcubo de Slaanesh y el tamaño de peana pasa a ser 100x50mm pero pierde la regla especial Demencia</description>
                </rule>
              </rules>
              <costs>
                <cost name="pts" typeId="points" value="20.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
