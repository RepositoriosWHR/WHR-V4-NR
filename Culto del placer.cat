              <rules>
                <rule id="4d0f-fea9-d436-374e" name="Montañas de carne" hidden="false">
                  <description>Los Trolls del Caos causan Miedo y tienen las reglas especiales Inmune a psicología, Objetivo grande y Regeneración (5+). Sin embargo, el Altar de guerra del Caos pierde la regla especial Veloz por ser Carro.</description>
                </rule>
              </rules>
              <infoLinks>
                <infoLink id="51da-23c2-4939-3289" name="Miedo" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
                <infoLink id="5313-767c-31f9-3b9b" name="Inmune a la psicología" hidden="false" targetId="73ad-8cdb-f1ad-010f" type="rule"/>
                <infoLink id="0133-5e34-22da-de19" name="Objetivo grande" hidden="false" targetId="71eb-6467-3a39-bdb6" type="rule"/>
                <infoLink id="45ca-82a5-5141-f777" name="Regeneración (5+)" hidden="false" targetId="515b-514f-7ee3-6cc3" type="rule"/>
              </infoLinks>
              <costs>
                <cost name="pts" typeId="points" value="60.0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
              </costs>
            </selectionEntry>
          </selectionEntries>
