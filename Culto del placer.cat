    <selectionEntry name="Corcel de Slaanesh" id="cb81-1b53-5bb7-63b4" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Ataques envenenados" id="acd3-b54b-1071-171f" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
        <infoLink name="Bestia" id="d346-db63-3feb-dea1" hidden="false" targetId="0300-ed31-06b9-0c49" type="rule"/>
        <infoLink name="Caballería" id="c5ab-61e4-a55c-79aa" hidden="false" targetId="276f-0034-6534-f691" type="rule"/>
        <infoLink name="Caballería rápida" id="daf2-e603-745d-6e0b" hidden="false" targetId="0b7e-2a08-2b5a-51d7" type="rule"/>
        <infoLink name="Demonio (Slaanesh)" id="64f9-b422-2720-9ede" hidden="false" targetId="cd63-154e-e6ab-32f9" type="rule"/>
        <infoLink name="Montura demoníaca" id="9471-aa61-4258-d815" hidden="false" targetId="718b-7ec3-2391-1ef8" type="rule"/>
      </infoLinks>
      <profiles>
        <profile name="Corcel de Slaanesh" id="25a7-7c91-bf9b-8c59" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
          <characteristics>
            <characteristic name="M" typeId="4d23232344415441232323">10</characteristic>
            <characteristic name="HA" typeId="5.753232323444154e+23">3</characteristic>
            <characteristic name="HP" typeId="4.2532323234441546e+23">0</characteristic>
            <characteristic name="F" typeId="5.323232344415441e+21">4</characteristic>
            <characteristic name="R" typeId="5.423232344415441e+21">3</characteristic>
            <characteristic name="H" typeId="5.723232344415441e+21">1</characteristic>
