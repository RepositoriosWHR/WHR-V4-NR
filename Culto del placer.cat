            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e788-50e2-e738-9f00" type="max"/>
          </constraints>
          <profiles>
            <profile id="bb9d-d475-32bd-dce0" name="Espada de la llama infernal" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques realizados con la Espada del fuego infernal se resuelven con la regla especial Ataques flamígeros y niegan la tirada de salvación por armadura del oponente.</characteristic>
              </characteristics>
