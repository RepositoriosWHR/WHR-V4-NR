          </infoLinks>
          <profiles>
            <profile name="Armadura Ungida" id="8888-0983-1df2-b758" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. Proporciona a su portador un bonificador de +1 a su tirada de salvación por armadura, y una tirada de salvación especial de 4+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Culto del placer. Arma a dos manos" id="52d7-31b7-332f-6584" collective="false" hidden="false" import="true">
