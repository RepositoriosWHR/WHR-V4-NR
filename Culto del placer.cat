            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="e0cc-e459-b0bc-fb74" type="max"/>
          </constraints>
          <profiles>
            <profile id="8d3e-bd33-9cbf-06ca" name="Martillo rúnica del Caos" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al luchar con este arma el portador obtiene +1 a su Habilidad de Armas y +1 Ataque. Los impactos con este arma se resuelven con +1 a su Fuerza.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="669f-08f8-0eca-8789" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="df11-5f5b-1e32-9ccb" name="Espada gelida de las estepas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="885c-d3ec-070e-77d7" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2816-b0a6-2791-0a64" type="max"/>
          </constraints>
          <profiles>
            <profile id="b881-a63b-1a44-9a11" name="Espada gelida de las estepas" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques realizados con la Espada gélida de las estepas se resuelven con +1 Fuerza. Además, proporciona a su portador las reglas especiales Aura de frío e Inmune a fuego.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="75b5-2618-130c-25a6" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
