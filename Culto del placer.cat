        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="[K] - Armas mágicas. Kurgan. Armas emparejadas" id="182e-9344-de39-6d4d" collective="false" hidden="false" import="true">
