          <infoLinks>
            <infoLink name="Ataques mágicos" id="1692-6d7a-92e7-9747" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink name="Francotirador" id="712b-20b3-6991-3abd" hidden="false" targetId="8fa0-a4f6-e454-dbfe" type="rule"/>
            <infoLink name="Disparo rápido" id="ad84-7c2f-20d1-ef4e" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Mirada disforme" id="1504-4875-6df1-4346" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene un ataque de disparo que tiene un alcance de 12”, puede dispararse aunque el personaje marche y se resuelve con Fuerza 4 y las reglas especiales Francotirador, Disparo rápido y Ataques mágicos. La Mirada disforme puede utilizarse incluso si el personaje está trabado en combate cuerpo a cuerpo, aunque en este caso sólo podrá utilizarse contra una unidad trabada con el personaje. Se recuerda que no se puede usar el mismo turno en el que se ha cargado.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Garras afiladas" id="d003-35a3-1b1c-54bd" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8a44-8ae6-1976-9b38" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="b6d9-55c9-84bb-6f59" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Poder de penetración" id="4215-1df5-be1a-7ebd" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Garras afiladas" id="72be-a513-621b-d56d" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene +1 a su Fuerza y la regla especial Poder de penetración en sus ataques en combate cuerpo a cuerpo; las garras cuentan como Armas emparejadas (lo que le proporciona también +1 Ataque) pero el personaje no puede llevar armas ni escudos de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Sentidos amplificados" id="b255-8eb7-3cde-6e8c" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="61ce-29d0-97e4-70c7" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="e4fd-d576-73dc-510c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
