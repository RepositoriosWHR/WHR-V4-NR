          <profiles>
            <profile name="Espada funeraria del caos" id="2382-5228-0f3e-cc56" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma bruja. Sólo hechiceros. Por cada herida causada en combate cuerpo a cuerpo por el portador con este arma, en la siguiente fase de magia puedes añadir un dado adicional de Energía o Dispersión (según corresponda).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="[GC] - Armas mágicas. Guerreros del Caos. Slaanesh. Arma de mano" id="0a60-3ed5-ff5a-a24b" collective="false" hidden="false" import="true">
