    <selectionEntry id="d88f-5ff0-8815-a2c2" name="[H][K] - Gran licántropo" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="3bf2-4b4a-714c-37e6" value="1.0">
          <conditions>
