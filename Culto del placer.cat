          <rules>
            <rule id="5a14-8955-74bb-fea3" name="Foco mortal de Slaanesh" hidden="false">
              <description>Los demonios pueden repetir los resultados de 1 en sus tiradas para impactar en combate cuerpo a cuerpo.</description>
