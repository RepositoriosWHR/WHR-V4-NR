        <selectionEntry id="cf09-3489-773c-5b72" name="Venablo siniestro" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="764c-e7ea-7142-9678" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b103-9f4e-34d4-0d19" type="max"/>
          </constraints>
          <profiles>
            <profile id="e919-6e0f-b90a-2f6a" name="Venablo siniestro" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza. Los impactos causados por el Venablo se resuelven con la regla especial Golpe letal. Además, el venablo puede utilizarse para disparar como si fuese una jabalina con las reglas especiales Ataques mágicos y Golpe letal (el venablo vuelve a la mano del portador tras cada disparo).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="9bb3-fb5a-5df9-809e" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
            <infoLink id="65e6-992e-dfc8-c46c" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
            <infoLink id="5b3c-ae5b-1dd7-c075" name="Jabalina" hidden="false" targetId="a629-6d4b-3e74-7ff7" type="profile"/>
            <infoLink id="6d7d-1468-9187-c81b" name="Lanza (infantería)" hidden="false" targetId="ea63-f860-d8f5-b7db" type="profile"/>
            <infoLink id="6c67-994e-52c6-2d37" name="Lanza (caballería)" hidden="false" targetId="e9f6-2800-5d9c-a7c4" type="profile"/>
          </infoLinks>
