            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b4ba-88c7-4430-ddd8" type="max"/>
          </constraints>
          <profiles>
            <profile id="94c6-5fca-c984-805a" name="Alfiler del éxtasis" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Sólo miniaturas con la Marca de Slaanesh. Arma de mano. Los impactos con este arma no permiten tiradas de salvación por armadura. Si causa una herida a una unidad enemiga, la unidad quedará Apabullada ese turno y tendrá un penalizador de -1 en sus tiradas para impactar durante esa fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a1a7-b579-2c17-586b" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
