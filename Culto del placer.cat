              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. Puede utilizarse al comienzo de cualquier fase de combate cuerpo a cuerpo. Hasta el final de la fase, el portador obtiene 1D6 Ataques adicionales.</characteristic>
              </characteristics>
