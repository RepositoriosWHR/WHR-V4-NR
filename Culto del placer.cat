            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="dec0-3616-990c-7fab" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5504-6d4f-d0b1-d8d5" type="max"/>
          </constraints>
          <profiles>
            <profile id="dac4-3d4f-0d50-a9cc" name="Apéndice adicional" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene un ataque adicional que siempre se realizará con su Fuerza básica.</characteristic>
              </characteristics>
            </profile>
          </profiles>
