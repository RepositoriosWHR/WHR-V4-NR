            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="57a0-6afb-bb8a-0b2e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="56ba-4102-bf67-eb5a" type="max"/>
          </constraints>
          <profiles>
            <profile id="5f3d-e920-f7bf-9fbe" name="Garras afiladas" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene +1 a su Fuerza y la regla especial Poder de penetración en sus ataques en combate cuerpo a cuerpo; las garras cuentan como Armas emparejadas (lo que le proporciona también +1 Ataque) pero el personaje no puede llevar armas ni escudos de ningún tipo.</characteristic>
              </characteristics>
            </profile>
