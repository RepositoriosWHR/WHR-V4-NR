            <profile name="Colgante de Slaanesh" id="ed29-8e21-e737-3b87" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Sólo miniaturas con la Marca de Slaanesh. Por cada herida que sufra el portador, su atributo de ataques aumenta permanentemente en un punto (hasta un máximo de 10).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
