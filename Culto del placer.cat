            <entryLink name="Clave: Hechicero" id="d93e-e1f1-0b9f-f0d9" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Hechicería del Caos" id="0f49-4c22-1cea-6044" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="e3c2-53f7-bb52-87ac" collective="false" hidden="false" import="true">
              <entryLinks>
                <entryLink name="Saber de Tzeentch" id="c1bb-256a-3c19-66bd" collective="false" hidden="false" import="true" targetId="b20e-2adb-6db4-44be" type="selectionEntry"/>
