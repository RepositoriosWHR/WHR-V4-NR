              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">Sólo hechiceros. El personaje obtiene un bonificador de +2 a todas sus tiradas de Canalizar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
