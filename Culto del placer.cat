              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene la regla especial Resistencia mágica (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
