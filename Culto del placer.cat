              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene la regla especial Impactos por carga (1D3). Si ya causaba Impactos por carga, estos aumentan en +1D3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
