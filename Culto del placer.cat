    <selectionEntryGroup name="[K] - Recompensas del caos. Slaanesh" id="d6c8-a68e-1b9b-61e9" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Rapidez de Slaanesh" id="1679-379a-8440-6f1d" collective="false" hidden="false" import="true" type="upgrade">
