            <infoLink name="Ataques flamígeros" id="3911-481c-6220-35f1" hidden="false" targetId="6985-722e-1ce4-b838" type="rule"/>
            <infoLink name="Regeneración (4+)" id="9ed8-e081-eb94-4dff" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
            <infoLink name="Arma de aliento" id="78a1-b385-de6f-6ba1" hidden="false" targetId="3438-0c27-972c-d418" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(F4, Ataques flamígeros)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Poción del Caos" id="1fc4-b49a-14a9-d587" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El personaje puede beberla al inicio de la batalla, tras el despliegue. Tira 1D6 en la siguiente tabla: 
D6 Poción del Caos
1 Engendro del Caos: El personaje se transforma en un engendro del Caos con la marca apropiada. Si tu ejército incluye una unidad de engendros con la misma marca, puedes unirlo a ella.
2 Fuerza demencial: obtiene +1 F y Estupidez.
3 Llamas del Caos: Ataques flamígeros y Arma de aliento (F4, Ataques flamígeros)
4 Metabolismo acelerado: Regeneración (4+).
5 Furia homicida: el portador obtiene +1 F, R y A.
6 Poder del Caos: El portador suma +1 a todos sus atributos (excepto M y L). Al inicio de cada uno de sus turnos debe superar un chequeo de Resistencia o sufrirá 1 herida sin tirada de salvación de ningún tipo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Brazaletes de la brutalidad" id="5f19-54e7-e7c6-970b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c18d-0f7d-689b-b3d0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="c1ff-a91d-b6fd-2066" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Brazaletes de la brutalidad" id="6e58-8d08-4a67-2d76" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Objeto portahechizos, nivel de energía 1D6. Contiene un hechizo de potenciación que puede lanzarse sobre una unidad amiga a 12” o menos del portador, y permanece un turno. Por la duración del conjuro, la unidad tendrá un bonificador de +1F</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Amuleto de piedra de disformidad" id="ea22-86b4-62c1-f304" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e2c3-28f0-b21c-460a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="8afd-4322-7cb2-4323" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Amuleto de piedra de disformidad" id="77cd-c07a-693c-6d92" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Un sólo uso. El portador puede repetir una tirada para impactar, herir, salvaciones, chequeos de atributo, canalizar, un único dado de energía o dispersión, o una tirada en la tabla de disfunciones mágicas.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Favor de los Dioses" id="d24f-3107-0944-1c96" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0f4d-53a5-a690-66e4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="86c0-df38-9395-ec5f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Favor de los Dioses" id="0aef-b2a2-920a-7c37" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador puede repetir las tiradas (suyas y de su unidad) en la tabla de El Ojo de los Dioses.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="[K] - Objetos hechizados. Kurgan. Caudillo o Señor de la guerra" id="d19f-82b8-97f8-487e" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="58a0-2d5a-915d-fb85" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
