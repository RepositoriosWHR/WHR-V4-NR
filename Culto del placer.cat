        <selectionEntry id="b450-73d3-f05d-9046" name="Espada de la condenación" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2e3b-1dcd-bca4-4d4a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="82dc-fcf8-d0f5-8299" type="max"/>
