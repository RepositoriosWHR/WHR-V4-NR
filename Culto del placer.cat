                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Este Ettin maldito tiene un ataque adicional que se resuelve con un bonificador de +2 a la Fuerza y la regla especial Heridas múltiples (1D6).</characteristic>
                  </characteristics>
                </profile>
