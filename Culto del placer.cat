    <selectionEntry name="[H][GC][Ex] - Dragón fuegobrujo" id="0849-bed7-bceb-64b8" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Huestes de Apoyo" id="5ab8-013d-6bf9-793a" hidden="false" primary="false" targetId="8243-422f-87a4-f048"/>
