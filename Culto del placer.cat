      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="0dd0-82eb-b0ac-b388" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="7dd9-c18e-b063-b7a6" name="Foco mortal de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
