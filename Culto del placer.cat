      <constraints>
        <constraint field="selections" scope="parent" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c3be-caff-1b9e-a39c" type="max"/>
      </constraints>
      <rules>
        <rule id="e386-1678-c441-507c" name="Señor de las bestias" hidden="false">
          <description>Un Señor de las bestias se considera oficial, aunque puede colocarse en la segunda fila, y desde allí realizar todos sus ataques en combate. Mientras continúe con vida, los Mastines obtienen Luchar con filas adicionales (1) durante el turno en el que realizan exitosamente una carga (o durante el siguiente turno si arrasaron y se trabaron en combate).</description>
        </rule>
        <rule id="a191-2cf1-e7ee-432c" name="Aullido de guerra" hidden="false">
          <description>Una vez por batalla, al inicio de cualquiera de tus turnos, un Señor de de las Bestias puede usar su Aullido de guerra. Hasta el final de ese turno de jugador, todos los mastines de su unidad obtienen la regla especial Carga devastadora.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="f278-8d4f-c0cd-4c37" name="La voluntad del Caos" hidden="false" targetId="e8e8-a54b-dacf-2e7e" type="rule"/>
        <infoLink id="6749-2355-63b6-6f59" name="Bestia" hidden="false" targetId="0300-ed31-06b9-0c49" type="rule"/>
        <infoLink id="c27e-b9b5-b943-87a9" name="Caballería rápida" hidden="false" targetId="0b7e-2a08-2b5a-51d7" type="rule"/>
