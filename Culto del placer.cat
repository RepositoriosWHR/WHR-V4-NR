            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4cb6-7fc6-2a84-4eea" name="Estandarte de seda demoníaca" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d720-82a2-00bf-4fed" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4987-1cfa-83e6-8eb5" type="max"/>
          </constraints>
          <profiles>
            <profile id="5489-8e3b-e43f-e065" name="Estandarte de seda demoníaca" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Otorga al portador y su unidad la regla especial Aura demoníaca (6+) Si ya disponían de Aura demoníaca, en lugar de eso otorga al portador y su unidad una tirada de salvación especial de 6+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="09b7-fcde-07ca-a3a4" name="Aura demoníaca (6+)" hidden="false" targetId="0f99-ca63-39fd-c419" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="20.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="996c-02be-1cc7-f365" name="Manto de cuchillas laceradoras" page="" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e40a-b9e5-b565-e6e1" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="b4c6-eb17-bbeb-6f94" type="max"/>
          </constraints>
          <profiles>
            <profile id="e4d1-6b18-f529-f6b6" name="Manto de cuchillas laceradoras" page="" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas en contacto peana con peana con el portador de este estandarte o su unidad sufrirán al inicio de cada ronda de combate un impacto de Fuerza 1 que niega la tirada de salvación por armadura. Las heridas causadas por este efecto cuentan para calcular el resultado del combate.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="01ac-cd3e-dcfe-f466" name="Aura demoníaca (6+)" hidden="false" targetId="0f99-ca63-39fd-c419" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
