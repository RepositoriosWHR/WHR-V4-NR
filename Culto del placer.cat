            <profile id="70fe-c610-78d4-0982" name="Astas descomunales" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje obtiene la regla especial Impactos por carga (1D3). Si ya causaba Impactos por carga, estos aumentan en +1D3.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="26a0-526f-faeb-9eae" name="Impactos por carga (1D3)" hidden="false" targetId="97de-652c-df54-f43b" type="rule"/>
