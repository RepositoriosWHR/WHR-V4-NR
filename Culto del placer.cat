    <selectionEntry id="27db-006e-65f1-2827" name="[H][GC] - Engendro monstruoso del Caos" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4d62-7d4f-64d5-1782" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" id="cc3e-0e3b-97cb-34b1" type="max"/>
      </constraints>
      <rules>
        <rule id="3139-2398-1662-ce4b" name="Vástago del caos" hidden="false">
          <description>Determina al inicio de la batalla (antes del despliegue) los atributos de HA, F, R, H e I del Engendro monstruoso del Caos. Además, tira una vez en la siguiente tabla para determinar los efectos adicionales de las mutaciones del Engendro monstruoso del Caos:
1D6 Vástago del Caos
1 Ataques envenenados
2 Piel escamosa (4+)
3 Arma de aliento de Fuerza 1D6 
4 Resistencia mágica (3)
5 Golpe letal
6 Regeneración (4+)</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="ceb3-f1fe-fd87-cb2f" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink id="e1f7-dd46-66be-3a7a" name="Aura demoníaca (5+)" hidden="false" targetId="e5ed-5149-3d72-6aa4" type="rule"/>
        <infoLink id="6c31-d1cb-caf2-df97" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="2ddc-8d3e-d1b9-c56a" name="Movimiento aleatorio (3D6)" hidden="false" targetId="a87e-08dc-36ec-ff50" type="rule"/>
        <infoLink id="2153-e556-8cf8-ee3b" name="Ataques aleatorios" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(2D6+2)"/>
          </modifiers>
        </infoLink>
      </infoLinks>
      <categoryLinks>
