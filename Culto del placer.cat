            <modifier field="name" type="append" value="(Marca de Khorne, Demonio (Khorne) o Khainitas)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Ataques mágicos" id="3826-94ff-b790-7444" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
        <infoLink name="Ataques envenenados" id="2f3a-22a3-4788-ac12" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
