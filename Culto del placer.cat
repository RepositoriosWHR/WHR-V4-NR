    <selectionEntryGroup name="[GC] - Recompensas del Caos menores. No hechicero/Khorne" id="52db-e0f1-d261-5b6d" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Hechicería del Caos" id="dea0-bd8e-40c6-d08e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7f36-f924-cd1d-d54b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="c524-b1dd-025d-1104" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
