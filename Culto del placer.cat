        <infoLink name="La voluntad del Caos" id="19a7-c665-81ee-9055" hidden="false" targetId="e8e8-a54b-dacf-2e7e" type="rule"/>
        <infoLink name="Ojo de los dioses" id="8c3e-4251-3cfd-fcb8" hidden="false" targetId="904a-b5e9-77cb-e22a" type="rule"/>
        <infoLink name="Miedo" id="d078-2c52-e433-e7d9" hidden="false" targetId="e1b7-26dc-52c2-c3a7" type="rule"/>
        <infoLink name="Furia asesina" id="960e-983a-4f90-e92b" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
