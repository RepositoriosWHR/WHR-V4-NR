              <profiles>
                <profile name="Armadura perdida de Hotek" id="4f2d-2721-383b-ad7d" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del caos. La armadura perdida de Hotek otorga una tirada de Salvación por armadura de 3+. Todas las tiradas exitosas para herir contra Netrak deberán repetirse.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Corona del Ungido" id="5081-9b55-a078-bb56" collective="false" hidden="false" import="true" type="upgrade">
