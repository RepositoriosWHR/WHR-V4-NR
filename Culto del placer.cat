          <profiles>
            <profile name="Arma demonio" id="1a7e-f392-db1b-89aa" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al atacar con este arma, el portador obtiene 1D6 Ataques adicionales (tira cada vez que vayas a atacar); además, sus impactos se resuelven con +1D3 a su Fuerza (tira cada vez que vayas a atacar). Cada resultado de 1 para impactar con este arma deberá resolverse para herir contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Padre de las espadas" id="06cc-0b2a-0c85-5ea0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2ad8-1adf-2096-0f64" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="141e-df06-2762-7fad" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="a7f7-9c57-de80-f379" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Ataques mágicos" id="524d-c3c3-7ba6-c284" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Padre de las espadas" id="4b94-0993-98bd-8d7a" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al luchar con este arma, todos los resultados de 1 en las tiradas para impactar en combate cuerpo a cuerpo con este arma se consideran resultados naturales de 6 y todos los enemigos que ataquen en combate cuerpo a cuerpo al portador consideran todos los resultados de 6 en sus tiradas para impactar como resultados naturales de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="[GC] - Armas mágicas. Reliquias. Guerreros del Caos. Slaanesh. Arma de mano" id="4cfc-35a8-d466-88c3" collective="false" hidden="false" import="true">
