          </infoLinks>
          <profiles>
            <profile name="Espada de la condenación" id="635e-a171-60ca-3fca" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al atacar con este arma, el portador puede repetir sus tiradas para herir en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espada rúnica del caos" id="d8cc-20e8-0aeb-d95f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="29b5-4757-e9b7-678f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3a17-26e5-dea5-9d3e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
