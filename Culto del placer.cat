          <profiles>
            <profile name="Libro de los secretos del caos" id="2c82-ac2f-b753-bc1a" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">El portador pasa a considerarse hechicero de nivel 1 que puede utilizar el Saber de las Sombras, el Fuego o la Muerte. No puede ser utilizado por miniaturas con la Marca de Khorne o por personajes que ya tuviesen uno o más niveles de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="4b7c-5519-0be2-cf44" collective="false" hidden="false" import="true">
              <entryLinks>
                <entryLink name="Saber de Sombras" id="0f8b-5647-9a36-8b33" collective="false" hidden="false" import="true" targetId="18bb-6c37-1cfe-8766" type="selectionEntry"/>
                <entryLink name="Saber de la Muerte" id="bbe3-d942-9530-25d7" collective="false" hidden="false" import="true" targetId="64a6-d9e9-3822-4168" type="selectionEntry"/>
                <entryLink name="Saber del Fuego" id="4351-40ec-93b5-01f4" collective="false" hidden="false" import="true" targetId="bff8-8e34-eb37-f67a" type="selectionEntry"/>
              </entryLinks>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="[GC] - Objetos hechizados. Guerreros del Caos. Slaanesh" id="c746-c393-d245-5a14" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="e286-8a12-dd6e-5626" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="d35a-47d7-9ed1-0f80" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Colgante de Slaanesh" id="55c3-8253-6992-5ca2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="67d7-c397-244b-fc6c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b960-3df3-cf80-51db" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
