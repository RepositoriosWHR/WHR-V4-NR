            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Talismán de Morathi" id="7337-6481-ed88-a788" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador podrá utilizar su tirada de salvación por Aura demoníaca contra Ataques mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
