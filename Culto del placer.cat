      <selectionEntries>
        <selectionEntry id="747d-ae75-6714-7443" name="Mandoble de Energía Negra" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="82a0-446a-f2e3-a7ca" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="2104-2c49-f5b4-529a" type="max"/>
          </constraints>
          <profiles>
            <profile id="c721-9b12-dae8-6908" name="Mandoble de Energía Negra" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. El Mandoble de Energía Negra no tiene la regla especial Lenta de las demás armas a dos manos; además, sus impactos tienen la regla especial Golpe letal.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e20d-c636-d2f8-7e16" name="Golpe letal" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
