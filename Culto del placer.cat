      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="b18f-bc79-b4c4-2bcc" type="min"/>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6e87-c4f5-f689-0958" type="max"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="248f-8093-b032-4358" name="Vara de Kharaidon" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="206c-beb6-aa42-b4f5" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5799-3ea2-8379-4a2f" type="max"/>
          </constraints>
          <profiles>
            <profile id="5ef5-d3a9-9e6d-3d21" name="Vara de Kharaidon" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Una vez en cada una de tus fases de magia, el portador puede realizar un chequeo de Resistencia: si lo supera, podrá lanzar uno de sus hechizos sin invertir dados de energía (el hechizo será lanzado a su dificultad básica; no puedes lanzar un hechizo potenciado con la Vara). Sin embargo, si falla el chequeo, perderá la concentración y sufrirá una herida sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="78b4-06c9-65a9-b1aa" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="60.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="0360-ae20-f848-a302" name="Artefactos arcanos. Culto del placer" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8c6e-35bf-c3f4-f233" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="6a8e-2147-7340-7124" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="ece3-f5ae-c61d-2d13" name="Daga del sacrificio" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="00b6-27d9-8f0c-ade4" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a8b1-43c4-0abb-bf72" type="max"/>
          </constraints>
          <profiles>
            <profile id="322c-2a98-354d-c737" name="Daga del sacrificio" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede utilizarla tras haber realizado la tirada de lanzamiento de cualquier hechizo. Podrá sacrificar a una de las miniaturas de su unidad para tirar un Dado de energía adicional en ese hechizo. La miniatura sacrificada deberá retirarse inmediatamente como baja de forma irremediable. Esto deberá realizarse antes de que tenga lugar cualquier posible intento de dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="fdb9-a3aa-715e-e200" name="Familiar del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="58f4-6b01-e35f-0862" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4a21-eaf4-6f13-9848" type="max"/>
          </constraints>
          <profiles>
            <profile id="1a4f-616e-7a8e-b468" name="Familiar del Caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d8a9-259e-3fbf-29ed" name="Cetro de la dominación de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7ec6-4258-c76e-826a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a4f2-494a-eb8c-38d2" type="max"/>
          </constraints>
          <profiles>
            <profile id="5384-2f68-653a-bced" name="Cetro de la dominación de Slaanesh" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, Nivel de energía 6. Puede utilizarse en cada fase de magia propia contra una unidad enemiga no trabada en combate a 18” o menos del portador. Esta unidad deberá realizar un chequeo de Liderazgo tirando 3D6 y descartando el resultado menor. Si lo falla, no podrá cargar, marchar ni disparar durante su siguiente turno. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="45ce-3d5c-883d-4331" name="Esferas del placer oriental" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1301-d1df-dd63-fb3b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a119-c96a-d564-bfcb" type="max"/>
          </constraints>
          <profiles>
            <profile id="c827-f892-4390-17ad" name="Esferas del placer oriental" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede tomar uno de sus Dados de magia no utilizado y guardarlo. Durante cualquier fase de magia posterior, el hechicero puede extraerlo y usarlo. Siempre que el portador utilice un dado guardado en las esferas para lanzar un hechizo, obtiene un bonificador de +2 para lanzar ese hechizo. Comienza la partida con un dado guardado en su interior.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="30f1-aa06-99e9-888c" name="Armas mágicas. Reliquias. Culto del placer. Arma de mano" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="3d17-ecf6-3598-2321" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="99f7-4f36-78cd-37a6" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="ee86-43bf-4c25-e5b2" name="Alfiler del éxtasis" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="4702-272d-5d29-725e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="91ed-170d-0163-5880" type="max"/>
          </constraints>
          <profiles>
            <profile id="a5eb-8a2f-ee85-bd81" name="Alfiler del éxtasis" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos con este arma no permiten tiradas de salvación por armadura. Si causa una herida a una unidad enemiga, la unidad quedará Apabullada ese turno y tendrá un penalizador de -1 en sus tiradas para impactar durante esa fase de combate cuerpo a cuerpo. </characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bd54-fc57-b19a-048f" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <entryLinks>
            <entryLink id="1bb1-5b73-8493-8590" name="Reliquia" hidden="false" collective="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="60.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="1f1c-0cde-0f46-2eb7" name="Armas mágicas. Culto del placer. Lanza de caballería" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="d499-5ef3-4dc2-fdff" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="4789-a3a6-ecf1-bdca" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="2fd9-cfd8-4a9c-7259" name="Lanza de la agonía extática" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="f51d-f98e-366b-68bd" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3720-ea74-18f5-7fcc" type="max"/>
          </constraints>
          <profiles>
            <profile id="7148-efa7-1c3d-0204" name="Lanza de la agonía extática" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza de caballería. El portador repite las tiradas para impactar fallidas si su Iniciativa es superior a la de su oponente. Además, si inflige una o más heridas no salvadas en combate, el objetivo sufrirá un penalizador de -1 a su Resistencia hasta el final de la partida (mínimo Resistencia 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="14a5-094f-1b76-c9fa" name="Lanza de caballería" hidden="false" targetId="63b9-4a42-e114-14f5" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="1046-c984-b1d9-dfe3" name="Armas mágicas. Culto del placer. Arma de mano" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="5a68-a37b-a07b-70ca" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="c308-2b8e-96ba-f948" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="72a7-a553-21f2-f1ce" name="Fusta del escozor" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="8831-72aa-95e0-fd3b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="4aaa-8f0d-83a7-ddf0" type="max"/>
          </constraints>
          <profiles>
            <profile id="4dea-3c13-54a0-cec4" name="Fusta del escozor" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques realizados con esta arma se resuelven con un bonificador de +1 en sus tiradas para impactar y la regla especial Poder de penetración. Además, si el portador ya posee la regla especial Poder de penetración, impondrá un penalizador adicional de -1 a las tiradas de salvación por armadura del enemigo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="8170-748e-aa4e-eb8c" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="cbc7-7ef2-3772-d5c4" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="e41a-259e-d23f-5d35" name="Espada del Odio" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="897c-d49d-6f78-1730" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="671d-7bb7-1f91-07ae" type="max"/>
          </constraints>
          <profiles>
            <profile id="5e8e-f521-aafe-7c59" name="Espada del Odio" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos de la Espada del Odio hieren automáticamente con resultados de 5 o 6 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="e5c9-9e7a-3ab3-6f36" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="97ab-b080-8365-87bf" name="Látigo de tormento" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="d193-c47c-c2c2-998e" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="a681-d496-fd59-1c2d" type="max"/>
          </constraints>
          <profiles>
            <profile id="f24f-9bdf-0270-d43d" name="Látigo de tormento" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El portador siempre herirá con un resultado de 4+, sin importar la Resistencia del objetivo, a menos que su tirada para herir fuese mejor que 4+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="12e2-d8b3-9dbe-fd1a" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="cb94-7b3e-9f16-710b" name="Armas mágicas. Culto del placer. Alabarda" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="7556-6804-12fc-1fed" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="8071-86e6-ab08-1f5d" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="4a62-2417-1aea-72db" name="Alabarda drenadora " hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2d53-cbf4-4418-7331" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="15f3-cbfe-3d59-7387" type="max"/>
          </constraints>
          <profiles>
            <profile id="61ea-8043-43ca-4073" name="Alabarda drenadora" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Alabarda. Las heridas causadas por esta arma imponen un penalizador de -1 a las tiradas de salvación por armadura (adicional a otros penalizadores). Al final de cada ronda de combate cuerpo a cuerpo en la que el personaje haya causado una o más heridas con este arma, puede recuperar una herida que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="bb0a-4918-95c0-c1b3" name="Alabarda" hidden="false" targetId="8dd0-8d9d-2436-cbf1" type="profile"/>
            <infoLink id="4ebb-16dc-97a3-bb22" name="Poder de penetración" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
