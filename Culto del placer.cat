              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura del Caos. Proporciona a su portador una tirada de salvación especial de 4+ y la regla especial Resistencia mágica (1, o aumenta la Resistencia mágica en 1 si ya disponía de ella, hasta un máximo de 3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
