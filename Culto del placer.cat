            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="0f50-dd07-d527-9320" type="max"/>
          </constraints>
          <profiles>
            <profile id="fcd5-d50c-3f6f-ba4c" name="Hachas del campeón" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Proporcionan a su portador un bonificador de +1 a su Iniciativa en combate cuerpo a cuerpo. Si está combatiendo en un desafío, el portador puede repetir sus tiradas para impactar y herir en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
