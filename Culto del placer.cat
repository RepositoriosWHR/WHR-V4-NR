                    <characteristic name="L" typeId="4c4423232344415441232323">8</characteristic>
                    <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323"/>
                    <characteristic name="TSE" typeId="5.761726453617665e+35"/>
                    <characteristic name="Tipo" typeId="5.479706523232345e+27"/>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Súcubu" id="4b8f-001e-6154-06d9" hidden="false">
                  <description>La Súcubo aumenta en 1 la Potencia de unidad del Trono del Príncipe Negro, y sus ataques se resuelven con las reglas especiales Ataques mágicos, Poder de penetración y Golpe letal.</description>
                </rule>
              </rules>
            </selectionEntry>
          </selectionEntries>
        </selectionEntryGroup>
      </selectionEntryGroups>
    </selectionEntry>
    <selectionEntry name="Engendros monstruoso del Caos" id="2cff-b900-21d9-6d22" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="New CategoryLink" id="5eef-e03f-ed5c-67e9" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
