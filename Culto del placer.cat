          </constraints>
          <profiles>
            <profile id="0f49-4c22-1cea-6044" name="Hechicería del Caos" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup id="e3c2-53f7-bb52-87ac" name="Los saberes de la magia" hidden="false" collective="false" import="true">
              <entryLinks>
                <entryLink id="c1bb-256a-3c19-66bd" name="Saber de Tzeentch" hidden="false" collective="false" import="true" targetId="b20e-2adb-6db4-44be" type="selectionEntry"/>
                <entryLink id="9516-04cf-1e80-fdcc" name="Saber de Slaanesh" hidden="false" collective="false" import="true" targetId="6f45-b771-55d8-cc14" type="selectionEntry"/>
