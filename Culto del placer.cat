    <selectionEntryGroup name="[K] - Recompensas del Caos menores. No hechicero/Khorne" id="30bc-d700-4939-b5f4" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Hechicería del Caos" id="44c9-c637-6cf9-9d13" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6634-0b1a-85f8-cc30" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
            <constraint id="3bd4-df05-4ac2-f626" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Clave: Hechicero" id="1d7c-c996-9e94-81ce" collective="false" hidden="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Hechicería del Caos" id="0b08-2b67-923c-cdc8" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="aed2-ec27-78df-9ba8" collective="false" hidden="false" import="true">
              <entryLinks>
                <entryLink name="Saber de Tzeentch" id="251d-929d-16f8-de20" collective="false" hidden="false" import="true" targetId="b20e-2adb-6db4-44be" type="selectionEntry"/>
                <entryLink name="Saber de Slaanesh" id="f575-2690-f933-d089" collective="false" hidden="false" import="true" targetId="6f45-b771-55d8-cc14" type="selectionEntry"/>
                <entryLink name="Saber de la Muerte" id="b6c6-0821-cb90-9467" collective="false" hidden="false" import="true" targetId="64a6-d9e9-3822-4168" type="selectionEntry"/>
                <entryLink name="Saber de Nurgle" id="58ee-ffcc-f730-88af" collective="false" hidden="false" import="true" targetId="3352-4875-5820-8bbe" type="selectionEntry"/>
                <entryLink name="Magia Oscura" id="18da-5596-b128-0619" collective="false" hidden="false" import="true" targetId="7a1e-b29e-9f4b-44a5" type="selectionEntry"/>
                <entryLink name="Saber del Fuego" id="20a1-a23d-4840-8296" collective="false" hidden="false" import="true" targetId="bff8-8e34-eb37-f67a" type="selectionEntry"/>
              </entryLinks>
            </selectionEntryGroup>
          </selectionEntryGroups>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
