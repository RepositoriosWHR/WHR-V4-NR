    <selectionEntryGroup id="30bc-d700-4939-b5f4" name="[K] - Recompensas del Caos menores. No hechicero/Khorne" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="44c9-c637-6cf9-9d13" name="Hechicería del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6634-0b1a-85f8-cc30" type="max"/>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3bd4-df05-4ac2-f626" type="max"/>
          </constraints>
          <profiles>
            <profile id="0b08-2b67-923c-cdc8" name="Hechicería del Caos" hidden="false" typeId="4a21-6ede-290c-54cb" typeName="Recompensa del Caos">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">No puede ser elegida por personajes con nivel de magia o con la Marca de Khorne. El personaje obtiene la clave hechicero y pasa a ser un hechicero de nivel 1 que puede elegir sus hechizos de entre los Saberes del Fuego, la Muerte, Magia Oscura o el Saber de su Dios del Caos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup id="aed2-ec27-78df-9ba8" name="Los saberes de la magia" hidden="false" collective="false" import="true">
              <entryLinks>
                <entryLink id="251d-929d-16f8-de20" name="Saber de Tzeentch" hidden="false" collective="false" import="true" targetId="b20e-2adb-6db4-44be" type="selectionEntry"/>
                <entryLink id="f575-2690-f933-d089" name="Saber de Slaanesh" hidden="false" collective="false" import="true" targetId="6f45-b771-55d8-cc14" type="selectionEntry"/>
                <entryLink id="b6c6-0821-cb90-9467" name="Saber de la Muerte" hidden="false" collective="false" import="true" targetId="64a6-d9e9-3822-4168" type="selectionEntry"/>
                <entryLink id="58ee-ffcc-f730-88af" name="Saber de Nurgle" hidden="false" collective="false" import="true" targetId="3352-4875-5820-8bbe" type="selectionEntry"/>
                <entryLink id="18da-5596-b128-0619" name="Magia Oscura" hidden="false" collective="false" import="true" targetId="7a1e-b29e-9f4b-44a5" type="selectionEntry"/>
                <entryLink id="20a1-a23d-4840-8296" name="Saber del Fuego" hidden="false" collective="false" import="true" targetId="bff8-8e34-eb37-f67a" type="selectionEntry"/>
              </entryLinks>
            </selectionEntryGroup>
          </selectionEntryGroups>
          <entryLinks>
            <entryLink id="1d7c-c996-9e94-81ce" name="Clave: Hechicero" hidden="false" collective="false" import="true" targetId="614d-bf3c-8921-4b1d" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
