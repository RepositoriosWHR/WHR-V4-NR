      <constraints>
        <constraint id="8c6e-35bf-c3f4-f233" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="6a8e-2147-7340-7124" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Daga del sacrificio" id="ece3-f5ae-c61d-2d13" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="00b6-27d9-8f0c-ade4" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a8b1-43c4-0abb-bf72" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Daga del sacrificio" id="322c-2a98-354d-c737" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede utilizarla tras haber realizado la tirada de lanzamiento de cualquier hechizo. Podrá sacrificar a una de las miniaturas de su unidad para tirar un Dado de energía adicional en ese hechizo. La miniatura sacrificada deberá retirarse inmediatamente como baja de forma irremediable. Esto deberá realizarse antes de que tenga lugar cualquier posible intento de dispersión.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Familiar del Caos" id="fdb9-a3aa-715e-e200" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="58f4-6b01-e35f-0862" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4a21-eaf4-6f13-9848" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Familiar del Caos" id="1a4f-616e-7a8e-b468" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Cetro de la dominación de Slaanesh" id="d8a9-259e-3fbf-29ed" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7ec6-4258-c76e-826a" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a4f2-494a-eb8c-38d2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="45"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Cetro de la dominación de Slaanesh" id="5384-2f68-653a-bced" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, Nivel de energía 6. Puede utilizarse en cada fase de magia propia contra una unidad enemiga no trabada en combate a 18” o menos del portador. Esta unidad deberá realizar un chequeo de Liderazgo tirando 3D6 y descartando el resultado menor. Si lo falla, no podrá cargar, marchar ni disparar durante su siguiente turno.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Esferas del placer oriental" id="45ce-3d5c-883d-4331" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1301-d1df-dd63-fb3b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a119-c96a-d564-bfcb" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Esferas del placer oriental" id="c827-f892-4390-17ad" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador puede tomar uno de sus Dados de magia no utilizado y guardarlo. Durante cualquier fase de magia posterior, el hechicero puede extraerlo y usarlo. Siempre que el portador utilice un dado guardado en las esferas para lanzar un hechizo, obtiene un bonificador de +2 para lanzar ese hechizo. Comienza la partida con un dado guardado en su interior.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Reliquias. Culto del placer. Arma de mano" id="30f1-aa06-99e9-888c" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="3d17-ecf6-3598-2321" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="99f7-4f36-78cd-37a6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Alfiler del éxtasis" id="ee86-43bf-4c25-e5b2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4702-272d-5d29-725e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="91ed-170d-0163-5880" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="1bb1-5b73-8493-8590" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Arma de mano" id="bd54-fc57-b19a-048f" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Alfiler del éxtasis" id="a5eb-8a2f-ee85-bd81" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos con este arma no permiten tiradas de salvación por armadura. Si causa una herida a una unidad enemiga, la unidad quedará Apabullada ese turno y tendrá un penalizador de -1 en sus tiradas para impactar durante esa fase de combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Culto del placer. Lanza de caballería" id="1f1c-0cde-0f46-2eb7" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="d499-5ef3-4dc2-fdff" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="4789-a3a6-ecf1-bdca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Lanza de la agonía extática" id="2fd9-cfd8-4a9c-7259" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f51d-f98e-366b-68bd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3720-ea74-18f5-7fcc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Lanza de caballería" id="14a5-094f-1b76-c9fa" hidden="false" targetId="63b9-4a42-e114-14f5" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Lanza de la agonía extática" id="7148-efa7-1c3d-0204" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Lanza de caballería. El portador repite las tiradas para impactar fallidas si su Iniciativa es superior a la de su oponente. Además, si inflige una o más heridas no salvadas en combate, el objetivo sufrirá un penalizador de -1 a su Resistencia hasta el final de la partida (mínimo Resistencia 1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Culto del placer. Arma de mano" id="1046-c984-b1d9-dfe3" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="5a68-a37b-a07b-70ca" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="c308-2b8e-96ba-f948" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Fusta del escozor" id="72a7-a553-21f2-f1ce" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="8831-72aa-95e0-fd3b" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="4aaa-8f0d-83a7-ddf0" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="8170-748e-aa4e-eb8c" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink name="Poder de penetración" id="cbc7-7ef2-3772-d5c4" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Fusta del escozor" id="4dea-3c13-54a0-cec4" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques realizados con esta arma se resuelven con un bonificador de +1 en sus tiradas para impactar y la regla especial Poder de penetración. Además, si el portador ya posee la regla especial Poder de penetración, impondrá un penalizador adicional de -1 a las tiradas de salvación por armadura del enemigo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Espada del Odio" id="e41a-259e-d23f-5d35" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="897c-d49d-6f78-1730" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="671d-7bb7-1f91-07ae" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="e5c9-9e7a-3ab3-6f36" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espada del Odio" id="5e8e-f521-aafe-7c59" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los impactos de la Espada del Odio hieren automáticamente con resultados de 5 o 6 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Látigo de tormento" id="97ab-b080-8365-87bf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d193-c47c-c2c2-998e" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a681-d496-fd59-1c2d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Arma de mano" id="12e2-d8b3-9dbe-fd1a" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Látigo de tormento" id="f24f-9bdf-0270-d43d" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El portador siempre herirá con un resultado de 4+, sin importar la Resistencia del objetivo, a menos que su tirada para herir fuese mejor que 4+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Armas mágicas. Culto del placer. Alabarda" id="cb94-7b3e-9f16-710b" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="7556-6804-12fc-1fed" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
        <constraint id="8071-86e6-ab08-1f5d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="-1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Alabarda drenadora " id="4a62-2417-1aea-72db" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2d53-cbf4-4418-7331" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="15f3-cbfe-3d59-7387" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
