            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="239d-f285-c80f-f8a1" name="Piel de hierro" hidden="false" collective="false" import="true" type="upgrade">
