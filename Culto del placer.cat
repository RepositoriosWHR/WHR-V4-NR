        <selectionEntry id="924e-5c03-e7f1-83cd" name="Arma demonio" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="a570-e33d-9afc-1c3d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="6830-2179-a86c-f326" type="max"/>
          </constraints>
          <profiles>
            <profile id="1a7e-f392-db1b-89aa" name="Arma demonio" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al atacar con este arma, el portador obtiene 1D6 Ataques adicionales (tira cada vez que vayas a atacar); además, sus impactos se resuelven con +1D3 a su Fuerza (tira cada vez que vayas a atacar). Cada resultado de 1 para impactar con este arma deberá resolverse para herir contra el portador.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="0c4d-7ce3-5d3e-4618" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="75.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="06cc-0b2a-0c85-5ea0" name="Padre de las espadas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="2ad8-1adf-2096-0f64" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="141e-df06-2762-7fad" type="max"/>
          </constraints>
          <profiles>
            <profile id="4b94-0993-98bd-8d7a" name="Padre de las espadas" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al luchar con este arma, todos los resultados de 1 en las tiradas para impactar en combate cuerpo a cuerpo con este arma se consideran resultados naturales de 6 y todos los enemigos que ataquen en combate cuerpo a cuerpo al portador consideran todos los resultados de 6 en sus tiradas para impactar como resultados naturales de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="a7f7-9c57-de80-f379" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
            <infoLink id="524d-c3c3-7ba6-c284" name="Ataques mágicos" hidden="false" targetId="7cc5-d3fc-a37a-3d4a" type="rule"/>
