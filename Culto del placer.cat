            <profile id="8834-2a71-b0e4-2bf8" name="Mandoble berserker" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Cada vez que el portador ataque en combate cuerpo a cuerpo, puede efectuar 1D6 ataques adicionales (tira cada vez que el portador vaya a atacar).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="78f7-532b-a65c-8e93" name="Arma a dos manos" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="65.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="d270-9713-c554-dfeb" name="Hacha de la destrucción" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="7fac-918e-1573-131a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="c188-657e-b51b-46b7" type="max"/>
          </constraints>
          <profiles>
            <profile id="24b5-c099-e10f-3c1a" name="Hacha de la destrucción" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma a dos manos. Las heridas causadas por este arma no permiten tirada de salvación por armadura. Además, contra miniaturas de los ejércitos de las Fuerzas del Orden sus impactos se resuelven con la regla especial Heridas múltiples 
(1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="2815-b3bb-b7d4-d959" name="Heridas múltiples (1D3)" hidden="false" targetId="efc4-703c-5d20-0686" type="rule"/>
            <infoLink id="e4fb-d0d3-958d-00e5" name="Arma a dos manos" hidden="false" targetId="b737-28ed-1002-5531" type="profile"/>
