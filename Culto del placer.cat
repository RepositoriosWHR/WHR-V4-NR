        <infoLink id="cc3b-61b1-1204-24c0" name="Resistencia mágica (1)" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
        <infoLink id="cb5c-f3f7-0b6a-0f33" name="Sangre fría" hidden="false" targetId="fae6-f2eb-1a70-1084" type="rule"/>
        <infoLink id="f47f-b8cf-1706-503c" name="Esquivar (4+)" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink id="42f3-4e75-abad-49c2" name="Heridas múltiples (2)" hidden="false" targetId="be26-0d4a-0493-6c52" type="rule">
          <modifiers>
            <modifier type="append" field="name" value="(Excepto contra Demonio o No muerto)"/>
          </modifiers>
        </infoLink>
