            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="31b2-62b2-c575-6c88" type="max"/>
          </constraints>
          <profiles>
            <profile id="340f-b965-bfc6-e13a" name="Elixir de la Agonía Bendita" hidden="false" typeId="2cee-fb80-f7af-6efc" typeName="Talismán mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">Otorga una Tirada de salvación especial de 5+. Cada vez que el portador supere una tirada de salvación especial en combate cuerpo a cuerpo, la miniatura atacante sufre inmediatamente un impacto de Fuerza 3 con Poder de penetración (-1) debido al latigazo de energía sensorial liberado.</characteristic>
