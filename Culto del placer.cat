    <selectionEntry id="c123-12b8-87d7-cc63" name="[H][GC] - Príncipe demonio" hidden="false" collective="false" import="true" type="unit">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="limit::points" scope="roster" value="3000.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="true" childId="any" type="lessThan"/>
          </conditions>
        </modifier>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="4d62-7d4f-64d5-1782" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule id="fe2e-a79b-e0e8-d736" name="Magia Príncipe demonio" hidden="false">
          <description>Si no porta la Marca de Khorne, puede elegir una de las siguientes opciones:
-Convertirse en hechicero de nivel 1: +40 puntos. 
-Convertirse en hechicero de nivel 2: +70 puntos. 
-Convertirse en hechicero de nivel 3: +105 puntos. 
-Convertirse en hechicero de nivel 4: +160 puntos.
Puede elegir sus hechizos de entre los Saberes de la Muerte, de los Cielos, del Fuego, de las Sombras, de Magia Oscura y/o del Saber de su Dios del Caos y puede elegir sus hechizos de dos o más de los saberes listados.</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="c022-75d9-534c-58fe" name="Monstruo" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink id="8d1a-63ac-a83f-8e78" name="Demonio" hidden="false" targetId="fc5c-7e1e-498d-ffb4" type="rule"/>
        <infoLink id="62e9-c06b-8838-61cb" name="Tozudez" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
        <infoLink id="90e5-aa69-b67d-a213" name="Aura demoníaca (4+)" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule"/>
      </infoLinks>
