          <profiles>
            <profile name="Arnés del dolor" id="eabb-6114-3015-eb68" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Armadura pesada. Todos los ataques dirigidos contra el portador en combate cuerpo a cuerpo obtienen un penalizador de -1 a su Fuerza. Siempre que el portador realice una tirada de salvación exitosa contra heridas causadas en la fase de combate, causará un impacto de Fuerza 4 con la regla especial Poder de penetración sobre la miniatura que realizó el ataque.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Corona de la Arrogancia Sublime" id="258a-9aea-825d-1845" collective="false" hidden="false" import="true" type="upgrade">
