              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades enemigas a 8” o menos del estandarte tendrán un penalizdor de -1 a su Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pabellón del odio" id="b813-0aa7-62b1-4b01" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="8109-7684-2595-4c56" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="dfd2-8c00-402c-2b34" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
