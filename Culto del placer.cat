    <selectionEntryGroup id="52db-e0f1-d261-5b6d" name="[GC] - Recompensas del Caos menores. No hechicero/Khorne" hidden="false" collective="false" import="true">
      <selectionEntries>
        <selectionEntry id="dea0-bd8e-40c6-d08e" name="Hechicería del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="7f36-f924-cd1d-d54b" type="max"/>
