              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">Solo hechiceros. El personaje conoce un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
