        <entryLink name="Marca de Slaanesh" id="1588-ea1d-8921-3ae7" collective="false" hidden="false" import="true" targetId="eae0-8851-1a50-1bd5" type="selectionEntry">
          <infoLinks>
            <infoLink name="Poder de penetración" id="913c-d83f-4d09-6cbf" hidden="false" targetId="29d3-6624-40c6-885f" type="rule"/>
          </infoLinks>
          <rules>
            <rule name="Marca de Slaanesh" id="f4f4-e86e-7fca-2d01" hidden="false">
              <description>El Engendro monstruoso del Caos porta la Marca de Slaanesh, que le otorga la regla especial Poder de penetración; además, cada vez que vayas a mover el Engendro monstruoso, puedes repetir la tirada de uno de sus dados de Movimiento aleatorio.</description>
            </rule>
          </rules>
        </entryLink>
      </entryLinks>
      <infoLinks>
        <infoLink name="Hostigadores" id="fce9-37bd-74fb-29fa" hidden="false" targetId="999c-d422-6c91-46dd" type="rule"/>
        <infoLink name="Indesmoralizable" id="896b-267c-a181-4de5" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
        <infoLink name="Monstruo" id="5dc4-34d7-bff6-73f8" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
