  <rules>
    <rule id="4abc-16d5-6765-64f1" name="La mirada de Slaanesh" hidden="false">
      <modifiers>
        <modifier type="set" field="hidden" value="true">
          <conditions>
            <condition field="selections" scope="roster" value="0.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" childId="770f-d9bd-2469-0cff" type="equalTo"/>
          </conditions>
        </modifier>
      </modifiers>
      <description>Todas las miniaturas del ejército tirarán 3D6 descartando los dos resultados menores (las unidades Veloces tirarán 3D6 descartando el resultado menor) en sus tiradas de carga, persecución, huida y arrasamiento.</description>
    </rule>
