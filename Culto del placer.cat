    <selectionEntry id="2ad9-23b5-65eb-bb46" name="[GC] - Carruaje del Caos" hidden="false" collective="false" import="true" type="upgrade">
      <rules>
        <rule id="d517-6dc5-4d3f-6c7c" name="Potencia de unidad 4" hidden="false">
          <modifiers>
            <modifier type="set" field="name" value="Potencia de unidad 5">
              <conditions>
                <condition field="selections" scope="2ad9-23b5-65eb-bb46" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" childId="6a57-08d5-9038-2de5" type="equalTo"/>
              </conditions>
            </modifier>
          </modifiers>
        </rule>
        <rule id="1ffd-b26a-9d62-dd77" name="Marca del Caos. Carruaje del Caos" hidden="false">
          <description>El Carruaje del Caos debe portar la misma Marca que su jinete, al coste en puntos indicado:
-Marca del Caos absoluto (+5 puntos): La Protección por montura aumenta en +1.
-Marca de Khorne (+1 punto): Obtiene la regla especial Furia asesina (sólo el tripulante).
-Marca de Slaanesh (gratis): Sin efecto.
-Marca de Nurgle (gratis): Sin efecto.
-Marca de Tzeentch (+1 punto): Obtiene la regla especial Ataques flamígeros (sólo el tripulante).</description>
        </rule>
      </rules>
      <infoLinks>
        <infoLink id="a4db-7deb-a056-8791" name="Carro" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink id="1f85-0e24-f95f-86eb" name="La voluntad del Caos" hidden="false" targetId="e8e8-a54b-dacf-2e7e" type="rule"/>
