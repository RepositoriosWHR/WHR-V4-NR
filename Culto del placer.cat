            <profile id="635e-a171-60ca-3fca" name="Espada de la condenación" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Al atacar con este arma, el portador puede repetir sus tiradas para herir en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="09c1-5ed9-71a0-fe22" name="Arma de mano" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
