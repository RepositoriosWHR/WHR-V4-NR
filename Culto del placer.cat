              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">El personaje duplica su atributo de Iniciativa, hasta un máximo de 10.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mirada de Slaanesh" id="2ab3-83a6-519e-6299" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="03b3-c2c7-474a-4afc" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4b4f-9f19-8046-730e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
