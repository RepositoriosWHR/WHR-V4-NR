            <profile id="a276-1f32-b91d-5bf7" name="Celeridad de Slaanesh" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">El demonio aumenta su Iniciativa hasta 10 y puede repetir sus tiradas para impactar fallidas en combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="8de4-d027-f178-4172" name="Almizcle soporífero" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="517d-d5a3-1c5b-a3d5" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="61e8-9a2e-1d2f-7f1c" type="max"/>
          </constraints>
          <profiles>
            <profile id="db12-c949-63ee-6006" name="Almizcle soporífero" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Las miniaturas enemigas en contacto con el demonio verán sus atributos de Habilidad de Armas e Iniciativa reducidos en un punto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="15.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="45ea-1e4d-ca03-c737" name="Canto de sirena" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="68a8-e6ca-2c54-1f35" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="6ce6-ccc7-d7ea-85d9" type="max"/>
          </constraints>
          <profiles>
            <profile id="4b4e-276f-c7e1-e797" name="Canto de sirena" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Las miniaturas enemigas situadas a 6” o menos del demonio no podrán beneficiarse del efecto de la regla especial Presencia inspiradora.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="bdd3-2fef-6e49-f60b" name="Indiferecia sádica" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="6218-c9ca-6225-7a93" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="0359-6325-eb85-3ceb" type="max"/>
          </constraints>
          <profiles>
            <profile id="a8c6-ef5e-5f78-f3e0" name="Indiferencia sádica" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">El demonio y cualquier unidad a la que se una obtienen la regla especial Indesmoralizables. Esto sustituye su regla habitual de Inestabilidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <infoLinks>
            <infoLink id="589c-5e69-712c-7663" name="Indesmoralizable" hidden="false" targetId="4362-3d7f-a24a-3309" type="rule"/>
          </infoLinks>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="fbd8-c2be-afa5-151e" name="Pinzas descomunales" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="504d-b791-00c8-cb10" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="e16b-7edd-f6da-e626" type="max"/>
          </constraints>
          <profiles>
            <profile id="f99a-c395-cdae-324e" name="Pinzas descomunales" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">El demonio obtiene un bonificador de +1 a su Fuerza en sus ataques en combate cuerpo a cuerpo y un bonificador de +1 en sus tiradas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="50.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="f07f-4d90-e45f-51b6" name="Visiones lascivas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="14a5-3370-e063-3685" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="428a-f86d-cab3-0d27" type="max"/>
          </constraints>
          <profiles>
            <profile id="7e9f-6183-6859-ed35" name="Visiones lascivas" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Al inicio de cada fase de combate, elige una miniatura dentro de un radio de 6” del demonio. La miniatura deberá superar un chequeo de Liderazgo tirando 3D6 y descartando el resultado menor o verá sus atributos de Habilidad de Armas, Ataques e Iniciativa a la mitad hasta el final de esa fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="3582-d493-9116-694d" name="Brazos adicionales" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="1baf-858b-2122-575a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="a6ad-2709-629b-a1bc" type="max"/>
          </constraints>
          <profiles>
            <profile id="4b3f-ee87-006d-8a13" name="Brazos adicionales" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">El demonio obtiene +2 Ataques.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="35.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="b8f1-7cb0-134d-df03" name="[DC] - Regalos demoníacos menores de Slaanesh. Heraldo de Slaanesh" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="415e-3327-fa55-52c6" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2b6c-1602-0fff-67a9" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="7640-029f-09d7-8517" name="Gran foco de Slaanesh" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="3f92-9420-d1d2-6aed" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="bb27-e0f4-d38c-c465" type="max"/>
          </constraints>
          <profiles>
            <profile id="3018-89df-3a8e-67a1" name="Gran foco de Slaanesh" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Sólo Heraldos de Slaanesh. Si el Heraldo dispone de un Foco demoníaco, su efecto se aplicará a todas las unidades con la regla especial Demonio (Slaanesh) a 12” o menos del Heraldo de Slaanesh.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup id="5222-0f47-9034-25b3" name="[DC] - Regalos demoníacos mayores de Slaanesh" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="cd42-0d2a-20ab-0146" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="2061-94d5-4da3-ae6e" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="1cd7-7667-a67c-e159" name="Látigo flagelador de almas" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e47b-67b8-9f71-c984" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="045d-23b7-df47-be3a" type="max"/>
          </constraints>
          <profiles>
            <profile id="5f8c-68cc-4ca7-b8f8" name="Látigo flagelador de almas" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Los ataques del demonio en combate obtendrán un bonificador de +1 a la Fuerza. Por cada herida causada a una miniatura enemiga con este Arma demonio, la miniatura herida deberá superar un chequeo de Liderazgo o deberá ser retirada como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="9514-90c2-b1c3-868c" name="[DC] - Arma demonio" hidden="false" collective="false" import="true" targetId="0ef6-e93f-b036-d622" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="45.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="871f-2d0c-1367-094a" name="Ladrón de esencia vital" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e9aa-c1ab-1773-252d" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="7b49-004f-cde9-555c" type="max"/>
          </constraints>
          <profiles>
            <profile id="1d1e-b227-6405-48af" name="Ladrón de esencia vital" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Cada vez que el demonio causa una baja en combate cuerpo a cuerpo, tira 1D6: por cada resultado de 4+, el demonio puede restaurar una de las heridas que hubiese sufrido previamente durante la batalla.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="25ca-5200-41a6-bbad" name="Fusta de la vejación" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="68a1-879a-9bf7-912a" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="false" includeChildSelections="true" includeChildForces="false" id="c4c0-a93e-f3ed-92c8" type="max"/>
          </constraints>
          <profiles>
            <profile id="111f-df39-58eb-66f2" name="Fusta de la vejación" hidden="false" typeId="29a5-f327-998c-299d" typeName="Regalo demoníaco">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="9340-4cc0-f29c-206f">Los ataques del demonio en combate negarán las tiradas de salvación por armadura del enemigo. Además, los impactos que obtengan un 6 natural en la tirada para herir obtendrán la regla especial Heridas Múltiples (1D3).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <entryLinks>
            <entryLink id="b197-cef5-b78a-fe16" name="[DC] - Arma demonio" hidden="false" collective="false" import="true" targetId="0ef6-e93f-b036-d622" type="selectionEntry"/>
          </entryLinks>
          <costs>
            <cost name="pts" typeId="points" value="40.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
  </sharedSelectionEntryGroups>
  <sharedRules>
    <rule id="e5aa-68a1-bd85-74d0" name="Destreza marcial" hidden="false">
      <description>Las miniaturas de Infantería con esta regla especial equipadas con Lanza mejoran su regla especial Luchar con filas adicionales en +1. Además, pueden realizar Parada con las siguientes combinaciones de armas: Arma de mano y Escudo, Lanza y Escudo, Armas emparejadas y Alabarda.</description>
    </rule>
    <rule id="54ab-9e52-1a7a-8fb2" name="Odio (Altos elfos)" hidden="false">
      <description>Los Elfos Oscuros tienen la regla especial Odio (altos elfos). Una miniatura con esta regla especial podrá repetir los resultados de 1 obtenidos en sus tiradas para impactar en combate cuerpo a cuerpo contra aquellos a quienes odie.</description>
    </rule>
    <rule id="8a9a-5206-fa93-f929" name="Animosidad demoníaca" hidden="false">
      <description>Aunque los Poderes Ruinosos pueden aliarse y trabajar juntos en determinados proyectos, las amargas rivalidades entre los Dioses del Caos y la propia naturaleza de la Disformidad aseguran que los planes de estas alianzas puedan romperse con facilidad. Los Dioses rivales son los siguientes: Khorne es rival de Slaanesh, y viceversa; Nurgle es rival de Tzeetnch, y viceversa.
Al incio de cada fase de movimiento propia deberás comprobar si hay demonios del Dios del Caos rival a 6&quot; o menos de cada una de tus unidades de demonios que no se encuentre trabada en combate (no importa si los demonios rivales pertenecen a tu ejército o al del enemigo). SI lo hay, deberás tirar 1D6 en la siguiente tabla por cada unidad de demonios que tengas cerca a sus rivales:
1D6	Tabla de animosidad demoníaca
1-2	Demonios de ambas unidades se lanzan unos contra otros. La unidad 	sufre 1D3 heridas
3-4	Los demonios se encuentra incómodos por la presencia de sus rivales, y se dedican a gritar amenazas y pronunciar juramento en la lengua oscura del Caos. El demonio o unidad de demonios no podrán realizar ninguna acción hasta el inicio de tu siguiente turno, salvo combatir cuerpo a cuerpo si son atacados. 
5-6	Los demonios toleran la presencia de sus rivales y pueden luchar de manera normal.
Los Grandes Demonios y Príncipes Demonio y unidadesque incluyan un Herlado suman un +1 al resultado de esta tabla.</description>
    </rule>
    <rule id="8172-bf14-3c2a-4c6f" name="Gran demonio" hidden="false">
      <description>La regla funciona exactamente igual que la regla especial Demonio, salvo que la tirada de salvación por Aura demoníaca se incrementa a 4+.</description>
    </rule>
    <rule id="718b-7ec3-2391-1ef8" name="Montura demoníaca" hidden="false">
      <description>Una miniatura montada sobre una montura con esta regla especial no es un Demonio, aunque se considera demonio a efectos de ser afectado por reglas especiales, objetos mágicos y hechizos. La miniatura causa Miedo y la montura tiene Ataques mágicos.</description>
    </rule>
    <rule id="cd63-154e-e6ab-32f9" name="Demonio (Slaanesh)" hidden="false">
      <description>Varias miniaturas del ejército, tienen la regla especial Demonio. Esto implica las siguientes reglas especiales: Causan miedo, son Inestables, Inmunes a la psicología, Inmunes a veneno y tienen Ataques mágicos (tanto en combate cuerpo a cuerpo como en sus ataques a distancia). Además, los demonios son seres hechos de magia pura, por lo que son muy resistentes a las armas mundanas. Para representar esto, todos los demonios tienen la regla especial Aura demoníaca, que confiere una tirada de salvación especial de 5+, la cual se verá anulada por ataques mágicos. Por último, poseen la regla especial Poder de Penetración. Un personaje con la marca de Slaanesh tan sólo puede unirse a regimientos con la marca de Slaanesh, y viceversa.</description>
    </rule>
    <rule id="00b8-b236-9b8f-0607" name="Gran Demonio (Slaanesh)" hidden="false">
      <description>Algunas miniaturas poseen esta regla especial; se trata de los demonios más poderosos. La regla funciona exactamente igual que la regla especial Demonio (Slaanesh), salvo que la tirada de salvación por Aura demoníaca se incrementa a 4+.</description>
    </rule>
    <rule id="31a4-d777-494d-ffe7" name="Almizcle soporífero" hidden="false">
      <description>Las miniaturas enemigas en contacto peana con peana con una o más unidades con esta regla especial verán su HA e I reducidas en un punto mientras permanezcan en contacto. Esto no afecta a miniaturas con la Marca de Slaanesh o miniaturas con la regla especial Demonio o No Muerto.</description>
    </rule>
    <rule id="904a-b5e9-77cb-e22a" name="Ojo de los dioses" hidden="false">
      <description>Los personajes con esta regla especial y la clave Paladín del Caos tienen la regla especial Orgullo marcial. Los oficiales con esta regla especial también tienen la regla especial Orgullo marcial. Si una miniatura con esta regla especial mata a un personaje enemigo (pero no un oficial) en un Desafío o a un Objetivo grande (ya sea en combate, magia, etc) deberá tirar 2D6 en la tabla del Ojo de los dioses y aplicar inmediatamente el resultado (los efectos, a menos que se especifique, permanecen el resto de la batalla. Los resultados repetidos se consideran resultados de 3. Algunos oficiales también tienen la regla especial “Ojo de los dioses”, en cuyo caso también podrán tirar en la tabla del Ojo de los dioses si eliminan en Desafío a un oficial o personaje enemigo o si acaban con un Objetivo grande.

2D6 Ojo de los dioses

2  Engendro del Caos: El personaje se transforma en un Engendro del Caos (con la Marca de Khorne, ver el libro de ejército de los Guerreros del Caos). Retira al personaje y coloca al Engendro del Caos en su lugar (sácalo de su unidad si fuera necesario). 
3 El ojo está cerrado: No se obtiene ninguna recompensa.
4 Reflejos sobrehumanos: El personaje obtiene +1 a su atributo de Iniciativa.
5 Aura del Caos: El personaje obtiene la regla especial Resistencia mágica (1) o +1 a su Resistencia mágica si ya disponía de ella, hasta un
máximo de 3.
6 Músculos de acero: El personaje obtiene +1 a su atributo de Fuerza.
7 Poder del Caos: Los Dioses del Caos recompensan a su siervo con la capacidad de hacer mayores matanzas. El personaje obtiene +1 a su atributo de Ataques.
8 Vigor impío: El personaje obtiene +1 a su atributo de Resistencia.
9 Vitalidad sobrenatural: Las heridas que sufre el Paladín se cierran a una velocidad sobrecogedora. El personaje obtiene la regla especial regeneración (5+) o +1 a su Regeneración si ya disponía de ella.
10 Marcado para la gloria: El personaje puede repetir los resultados de 1 en sus tiradas para impactar y salvaciones por armadura.
11 Poder de la disformidad: El personaje obtiene +1 a sus atributos de Fuerza y Resistencia.
12 Recompensa de la demonicidad: El paladín obtiene las reglas especiales Tozudez y Aura demoníaca (4+).</description>
    </rule>
    <rule id="9584-013a-2081-a68f" name="La mirada de Slaanesh" hidden="false">
      <description>El General del ejército debe ser una Matriarca del Placer o Gran Matriarca del Placer, siempre y cuando no esté comandado por Netrak o Morathi. La Matriarca del Placer o Gran Matriarca del Placer que sea la general del ejército obtiene un bonificador de +1 a su atributo de Liderazgo. Además, mientras la General del ejército siga con vida, todas las miniaturas del ejército tirarán 3D6 descartando los dos resultados menores (las unidades Veloces tirarán 3D6 descartando el resultado menor) en sus tiradas de carga, persecución, huida y arrasamiento. Este bonificador se pierde inmediatamente si el general del ejército muere, huye por cualquier motivo o rechaza un desafío. Además, al final de la fase en la que el General del ejército sea retirado como baja, tira 3D6 por cada unidad del ejército con la regla especial Demonio (salvo los personajes individuales): la unidad sufrirá una herida automática sin tirada de salvación de ningún tipo (ni siquiera Esquiva ni Regeneración) por cada punto que la tirada supere su Liderazgo. Las unidades podrán utilizar el Liderazgo de un personaje unido a ellas y también se podrá utilizar el valor de Liderazgo de una miniatura amiga con Presencia inspiradora (como si fuese un chequeo, aunque no lo sea).</description>
    </rule>
    <rule id="e869-dab8-565f-27d5" name="Aura de fascinación" hidden="false">
      <description>Las unidades enemigas en contacto con una o más unidades con esta regla especial obtendrán un penalizador de -1 a su Liderazgo.</description>
    </rule>
    <rule id="26ec-131f-15d8-81ce" name="Ladinas" hidden="false">
      <description>Las unidades con esta regla especial pueden declarar Huir a pesar de tener la regla especial Inmune a psicología, reagruparán automáticamente y podrán actuar normalmente en la sub-fase de Resto de movimientos de ese turno.</description>
    </rule>
    <rule id="d84c-a83d-2a6c-cf5b" name="Jinetes infernales" hidden="false">
      <description>Puede declarar Huir como reacción a una carga (reagrupándose inmediatamente tras recorrer la distancia de huida).</description>
    </rule>
    <rule id="e8e8-a54b-dacf-2e7e" name="La voluntad del Caos" hidden="false">
      <description>Las unidades con esta regla especial pueden repetir los chequeos de Pánico fallidos.</description>
    </rule>
    <rule id="847e-5da3-9efe-9412" name="Jinetes expertos" hidden="false">
      <description>Las unidades con esta regla especial pueden repetir sus tiradas de persecución.</description>
    </rule>
    <rule id="9042-2c59-9929-6d53" name="Cábala  de guerreros" hidden="false">
      <description>Ningún personaje puede unirse a una unidad con esta regla especial salvo que posea la Recompensa del Caos Elegido del Caos. El Paladín elegido tiene la regla especial Ojo de los dioses. Si muere, selecciona un Elegido de la unidad, que ganará la regla especial Ojo de los dioses y pasará a considerarse el oficial (ten en cuenta que no gana +1 Ataque).</description>
    </rule>
    <rule id="6a25-a327-28e3-65bf" name="Foco mortal" hidden="false">
      <description>Un Demonio mayor puede elegir un único Foco mortal (el mismo del Dios al que esté encomendado) al coste en puntos indicado. Un Foco mortal funciona del mismo modo que un Foco demoníaco normal, afectando a todos los demonios en la misma unidad que el Demonio mayor (incluyendo al propio Demonio mayor). Además, al inicio de cada uno de tus turnos, selecciona una unidad amiga de demonios a 12” o menos del Demonio mayor y que tengan la misma lealtad a un Dios del Caos que este: hasta el inicio de tu siguiente turno, dicha unidad también se beneficiará del efecto del Foco mortal.</description>
    </rule>
    <rule id="3f88-ed14-17a2-e734" name="[DC] - Gran demonio" hidden="false">
      <description>Esta regla especial funciona exactamente igual que la regla especial Demonio, con las siguientes salvedades: una miniatura con esta regla especial tiene la regla especial Presencia inspiradora, que afecta a las unidades con su misma Marca del Caos. Además, su tirada de salvación por Aura demoníaca se incrementa a 4+. Ten en cuenta que la regla especial Gran demonio también tiene una lealtad, indicada entre paréntesis (ver la regla especial Siervos de los dioses).</description>
    </rule>
    <rule id="c133-0030-29b2-0630" name="Vientos de la magia desatados" hidden="false">
      <description>Si en una batalla hay presentes uno o más Grandes demonios exaltados, se deberán tirar un mínimo de 3D6 para determinar los Vientos de la magia, siendo el total en dados de Energía y el resultado mayor más el menor en dados de dispersión para el oponente. Además, las tiradas de salvación por Aura demoníaca de todos los Demonios a 18” o menos de un Gran demonio exaltado (incluyendo al propio Gran demonio exaltado) podrán efectuarse contra Ataques mágicos.</description>
    </rule>
    <rule id="65b9-3302-ccee-1605" name="Gran demonio exaltado" hidden="false">
      <description>Una miniatura con esta regla especial tiene la regla especial Presencia inspiradora, que afecta a las unidades con su misma Marca del Caos a 24”. Además, su tirada de salvación por Aura demoníaca se incrementa a 4+. Ten en cuenta que la regla especial Gran demonio exaltado también tiene una lealtad, indicada entre paréntesis (ver la regla especial Siervos de los dioses).</description>
    </rule>
  </sharedRules>
  <sharedProfiles>
    <profile id="2dbf-745e-fcf8-0385" name="Armadura del Caos" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">4+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Se trata de una armadura que proporciona una tirada de salvación por armadura de 4+. Un hechicero puede llevar una Armadura del caos y seguir lanzando hechizos.</characteristic>
      </characteristics>
    </profile>
    <profile id="da3d-d3bd-e623-7cac" name="Escudo de gladiador" hidden="false" typeId="41726d6f757223232344415441232323" typeName="Armadura">
      <characteristics>
        <characteristic name="Salvación" typeId="536176696e67205468726f77206d6f64696669657223232344415441232323">6+</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Se trata como un escudo a todos los efectos, y además cuenta como un arma de mano adicional, proporcionando +1 ataque.</characteristic>
      </characteristics>
    </profile>
    <profile id="ba34-d143-275a-7251" name="Arma bruja" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Arma de mano: Un Arma bruja se considera un Arma de mano en todos los aspectos (y puede realizarse Parada con ella si se dispone también de Escudo).</characteristic>
      </characteristics>
    </profile>
    <profile id="1d6b-cc8f-facd-636b" name="Flauta de sirena" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Las unidades enemigas no podrán reaccionar a una carga con Aguantar y disparar o Disparar y huir si son cargados por una unidad con una Flauta de sirena.</characteristic>
      </characteristics>
    </profile>
    <profile id="fe5d-3d4a-9043-cae0" name="Azotes infernales" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Se consideran Arma de mano a todos los efectos, y sus impactos tienen la regla especial Poder de penetración. Además, al inicio de cada ronda de combate, una unidad equipada con azotes infernales puede elegir entre luchar de forma ofensiva o luchar de forma defensiva: si luchan de forma ofensiva, obtienen un bonificador de +1 a sus tiradas para impactar. Si luchan de forma defensiva, el enemigo tendrá un penalizador de -1 a sus tiradas para impactar a los jinetes infernales.</characteristic>
      </characteristics>
    </profile>
    <profile id="3f8e-5666-55d9-b295" name="Armas brujas emparejadas" hidden="false" typeId="576561706f6e23232344415441232323" typeName="Arma">
      <characteristics>
        <characteristic name="Rango" typeId="52616e676523232344415441232323">Combate</characteristic>
        <characteristic name="Fuerza" typeId="537472656e67746823232344415441232323">Usuario+1</characteristic>
        <characteristic name="Reglas especiales" typeId="5370656369616c2052756c657323232344415441232323">Ataques mágicos, Requiere ambas manos, +1 Ataque.</characteristic>
      </characteristics>
    </profile>
    <profile id="5050-03a8-9ddb-0a15" name="Flauta de sirena" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
      <characteristics>
        <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Las unidades enemigas no podrán reaccionar a una carga con Aguantar y disparar o Disparar y huir si son cargados por una unidad con una Flauta de sirena.</characteristic>
      </characteristics>
    </profile>
  </sharedProfiles>
