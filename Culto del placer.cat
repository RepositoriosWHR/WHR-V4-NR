                <characteristic name="Reglas especiales" typeId="bb94-e12a-aef4-ebc0">El portador es inmune al efecto de la regla especial Golpe letal. Además, todas las tiradas de herir contra el recibirán un penalizador de -1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Corona de hierro negro" id="ad72-31e6-4b27-1de5" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c4b9-c17b-cad9-cca2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="f6b9-cb9b-4d45-f63b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
