              <characteristics>
                <characteristic name="Reglas especiales" typeId="ac18-bd08-5794-1799">Sólo miniaturas de infantería. La miniatura gana la regla especial volar. La miniatura no puede unirse a ninguna unidad ni elegir ninguna montura.</characteristic>
              </characteristics>
