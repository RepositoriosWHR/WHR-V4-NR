              </entryLinks>
              <infoLinks>
                <infoLink name="Arma emparejadas" id="7b6f-fd0c-1652-079d" hidden="false" targetId="45d0-c304-d4fd-5b8f" type="profile"/>
                <infoLink name="Golpe letal" id="a6e6-3636-bf39-7afd" hidden="false" targetId="9f1c-d301-bd0e-af81" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Desgarracorazones y la Espada Oscura" id="2fa0-9b75-5328-e4b7" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Los impactos realizados con esta arma tienen la regla especial Golpe letal y se resuelven con un bonificador de +2 a la Fuerza en el turno en el que Morathi cargue. Además, un monstruo o personaje que sufra una o más heridas no salvadas por parte de Desgarracorazones y la Espada Oscura reduce sus atributos de Ataques, Fuerza y Resistencia en 1 punto (hasta un mínimo de 1) por cada herida no salvada. Estos penalizadores se aplican al final de la ronda de combate cuerpo a cuerpo en la que se sufrieron las heridas, y duran el resto de la partida.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Pergaminos del Templo Oscuro de Ghrond" id="389e-6785-9bd7-abdc" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="5a0e-6cad-1306-7e0c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="ec83-0757-a213-8bbf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Pergaminos del Templo Oscuro de Ghrond" id="4169-6917-5e70-cc85" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo dos usos. Puedes utilizar los pergaminos durante tu fase de magia para lanzar un hechizo sin invertir dados de energía (el hechizo será lanzado con su dificultad básica y podrá ser dispersado como es habitual; no puede lanzarse un hechizo potenciado con el pergamino) o durante la fase de magia del oponente para dispersar automáticamente un hechizo lanzado por el oponente, cuando el oponente lance exitosamente un hechizo pero antes de efectuar la tirada para dispersar (ten en cuenta que no funciona contra hechizos lanzados con Fuerza Irresistible).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
