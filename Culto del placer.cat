    </selectionEntryGroup>
    <selectionEntryGroup id="39be-0896-4380-7f54" name="[K] - Artefactos arcanos. Kurgan" hidden="false" collective="false" import="true">
      <constraints>
        <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ec0b-e595-a766-bf9d" type="max"/>
        <constraint field="selections" scope="parent" value="-1.0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" id="ed6e-0d3c-463f-4f5e" type="min"/>
      </constraints>
      <selectionEntries>
        <selectionEntry id="bfef-02b6-f54f-a2a3" name="Familiar del Caos" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="eca7-78e9-e5b6-90a9" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="794d-9920-c4a8-7c06" type="max"/>
          </constraints>
          <profiles>
            <profile id="55a4-60a9-a799-4065" name="Familiar del Caos" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El personaje genera un dado adicional de Energía o Dispersión en cada fase de magia. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="4566-09e4-a0df-c91d" name="Cetro de la gran bestia del norte" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="e82a-a25a-22f9-862f" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="261c-d0a9-4695-ebb5" type="max"/>
          </constraints>
          <profiles>
            <profile id="8f28-0f6d-de64-5184" name="Cetro de la gran bestia del norte" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene el hechizo Forma salvaje de Wyssan, del Saber de las Bestias.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="25.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="a229-8792-4b95-297e" name="Vara demoníaca" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="9b87-5126-cae8-d181" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="5e0f-5ff4-84f0-ad9b" type="max"/>
          </constraints>
          <profiles>
            <profile id="6ecf-3d4e-e089-9773" name="Vara demoníaca" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador conoce un hechizo adicional; además, le proporciona un bonificador de +1 en sus tiradas de lanzamiento de hechizos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <costs>
            <cost name="pts" typeId="points" value="30.0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0.0"/>
          </costs>
        </selectionEntry>
        <selectionEntry id="648b-fc73-44d1-9b89" name="Orbe de piedra divina" hidden="false" collective="false" import="true" type="upgrade">
          <constraints>
            <constraint field="selections" scope="parent" value="1.0" percentValue="false" shared="false" includeChildSelections="false" includeChildForces="false" id="c682-7795-bcca-fc0b" type="max"/>
            <constraint field="selections" scope="roster" value="1.0" percentValue="false" shared="true" includeChildSelections="true" includeChildForces="false" id="3b7e-d264-69d6-3dbe" type="max"/>
          </constraints>
          <profiles>
            <profile id="534d-c916-c840-ce38" name="Orbe de piedra divina" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Cada vez que el portador vaya a lanzar un hechizo, puede elegir generar un dado de energía adicional (usa un dado de color diferente) y tirarlo junto a los dados que desee para lanzar ese hechizo (debe gastar por lo menos un dado). Sin embargo, si en el dado adicional obtiene un resultado de 1, el portador sufre una herida automática sin tirada de salvación por armadura.</characteristic>
              </characteristics>
            </profile>
          </profiles>
