            <profile name="Eztandarte aráknido" id="869b-85e8-af02-4fda" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todos los goblins silvanos de la unidad (y sus monturas) obtienen la regla especial Ataques envenenados. Si ya tenían esa regla, estos surtirán efecto con un resultado de 5+ en lugar del habitual 6.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Banderola de loz kolmilloz" id="230b-cd2b-8559-e27f" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="7fca-7673-a6f9-5412" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6d68-78d5-4050-79c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
