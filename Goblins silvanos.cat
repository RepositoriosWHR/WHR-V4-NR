        <categoryLink name="Unidades Singulares" id="41e0-4b34-cdf5-ae39" hidden="false" primary="true" targetId="5.261726523232345e+27"/>
      </categoryLinks>
      <constraints>
        <constraint id="9f33-f223-32fb-a65f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Monstruo" id="50c5-45bb-d70b-d0aa" hidden="false" targetId="0518-1c98-54e1-371d" type="rule"/>
        <infoLink name="Cruzar (obstáculos)" id="ff5f-7fad-1456-f3cc" hidden="false" targetId="5dfd-3f02-cece-1e02" type="rule"/>
      </infoLinks>
      <modifiers>
        <modifier field="9f33-f223-32fb-a65f" type="increment" value="1">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
