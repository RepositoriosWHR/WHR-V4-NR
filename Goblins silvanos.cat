            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Zendero de la Gran Araña" id="a892-42e3-0d26-3cdc" hidden="false" typeId="cff3-8c5a-f6b1-332b" typeName="Zendero">
              <characteristics>
                <characteristic name="Regla especial" typeId="8fcb-d2b4-a02d-6041">Sólo chamán o gran chamán montado en Aracnarock. Una vez por fase de magia el chamán puede repetir la tirada de uno de sus dados de energía al lanzar un hechizo, o uno de sus dados de dispersión al dispersar un hechizo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="New SelectionEntry" id="8c8a-d1cf-91c7-9bb0" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="ceb7-6693-c9a8-93c1" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="981f-4ce6-94dd-bd84" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
