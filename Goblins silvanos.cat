            <infoLink name="Terror" id="2f9f-93bb-91ef-a31f" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Zendero Zagrado" id="c68c-d89d-f60f-7293" hidden="false" typeId="cff3-8c5a-f6b1-332b" typeName="Zendero">
              <characteristics>
                <characteristic name="Regla especial" typeId="8fcb-d2b4-a02d-6041">Sólo Kaudillo o Gran jefe montado en Araña gigantesca. El personaje sólo puede unirse a unidades de Guerreroz Zagradoz. El personaje y su unidad causarán Terror.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Zenderoz. Kaudillo o Gran jefe. Sin montura" id="1238-387e-08a4-a579" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="4c30-63e9-202c-8ae8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Zendero de la ezpezura" id="85ea-3f3b-b6cf-dd5f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7dfa-e94c-1858-a730" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4a26-ebdb-66b9-2693" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="35"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune al pánico" id="7cd8-c082-ebae-c999" hidden="false" targetId="06f4-bd6a-c34d-baed" type="rule"/>
            <infoLink name="Exploradores" id="d922-66c6-1d80-735b" hidden="false" targetId="462e-27b4-5c07-747d" type="rule"/>
            <infoLink name="Disparo rápido" id="c6fd-8115-b321-8dbd" hidden="false" targetId="e198-cb4f-6dfc-1dcc" type="rule"/>
            <infoLink name="Francotirador" id="df3c-b4f1-6e81-d5e8" hidden="false" targetId="8fa0-a4f6-e454-dbfe" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Zendero de la ezpezura" id="0ecf-d460-a256-fdbf" hidden="false" typeId="cff3-8c5a-f6b1-332b" typeName="Zendero">
              <characteristics>
                <characteristic name="Regla especial" typeId="8fcb-d2b4-a02d-6041">Sólo Kaudillo o Gran jefe. El personaje no puede elegir ninguna montura, y sólo puede unirse a unidades de Ezploradorez. El personaje obtiene un bonificador de +1 a su atributo de Habilidad de Proyectiles y las reglas especiales Inmune a pánico, Explorador, Disparo rápido y Francotirador, así como la regla especial Okultoz (ver Ezploradorez).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Okultoz" id="9b9c-555b-38ea-f9ef" hidden="false">
              <description>Todos los disparos contra los exploradorez deben resolverse con un penalizdor de -1 en sus tiradas para impactar. Además, los ezploradorez tienen la regla especial Esquivar (5+), que se incrementa a 4+ si la unidad se encuentra mayoritariamente dentro de un bosque.</description>
            </rule>
          </rules>
        </selectionEntry>
        <selectionEntry name="Zendero del Danzante" id="797f-b23c-fcbf-2826" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="0843-4b28-2e16-286b" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="4339-69c0-5c94-6f3c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="30"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Esquivar (4+)" id="1b99-839c-776f-ef1d" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Zendero del Danzante" id="49f9-436f-61be-1792" hidden="false" typeId="cff3-8c5a-f6b1-332b" typeName="Zendero">
              <characteristics>
                <characteristic name="Regla especial" typeId="8fcb-d2b4-a02d-6041">Sólo Kaudillo o Gran jefe. El personaje no puede elegir ninguna montura, no puede equiparse con armas de proyectiles (y pierde el Arco corto) y sólo puede unirse a unidades de Danzantez del Árbol de la Telaraña. El personaje obtiene un bonificador de +1 a sus atributos de Movimiento, Habilidad de Armas y Ataques, así como las reglas especiales Esquivar (4+) y Danzaz de guerra de la Araña (ver Danzantez del Árbol de la Telaraña).</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <rules>
            <rule name="Danzaz de guerra de la Araña" id="1718-7f33-233d-b326" hidden="false">
              <description>Al inicio de cada fase de combate cuerpo a cuerpo, debes elegir una de las Danzaz listadas a continuación para la unidad. No pueden usar la misma danza en dos fases de combate consecutivas. Los efectos de las Danzaz durarán hasta el inicio de la siguiente Fase de Combate. 

-Bailezito irritante: Las tiradas de salvación por Esquivar de la unidad aumentan en +1 (máximo 3+).

-Danza de laz pìkaduraz: Los ataques envenenados de la unidad surtirán efecto con resultados de 5+.

-Kuchilladaz por todaz partez: La unidad podrán repetir las tiradas para impactar fallidas en combate cuerpo a cuerpo.

-Korrer y ezkonderze: En combate, los ataques enemigos contra las miniaturas de esta unidad solamente impactarán obteniendo un resultado natural de 6. Las miniaturas de la unidad verán reducido su número de ataques a 1 y obtendrán la regla especial Impasibles hasta el final del turno.</description>
            </rule>
          </rules>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Zenderoz. Kaudillo o Gran jefe" id="37ef-e813-a328-c14c" collective="false" hidden="false" import="true">
