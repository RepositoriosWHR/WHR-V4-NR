            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
        </selectionEntry>
        <selectionEntry name="Zendero del Kulto" id="8fc6-8526-5915-f19e" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2168-b030-54a9-0c17" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="9304-8578-47d2-6fca" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Inmune al miedo" id="bafb-d940-cb1d-acfe" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Zendero del Kulto" id="4517-0f89-7767-43cb" hidden="false" typeId="cff3-8c5a-f6b1-332b" typeName="Zendero">
              <characteristics>
                <characteristic name="Regla especial" typeId="8fcb-d2b4-a02d-6041">Sólo Chamán o Gran chamán. El personaje no puede elegir ninguna montura y sólo podrá unirse a unidades del Kulto de la Araña. El personaje obtiene la regla especial Inmune a Miedo, y conocerá un hechizo adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Zendero del Bozke Zinieztro" id="b8c6-c7db-b53f-69ee" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="6b42-a093-891e-efed" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="a7f1-2884-af81-9c6f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Zendero del Bozke Zinieztro" id="190c-30a0-c6c5-3c45" hidden="false" typeId="cff3-8c5a-f6b1-332b" typeName="Zendero">
              <characteristics>
                <characteristic name="Regla especial" typeId="8fcb-d2b4-a02d-6041">Sólo chamán o gran chamán. El hechicero puede tirar un dado adicional para Canalizar si se encuentra a 12” o menos de un bosque. Además, al inicio de cada uno de sus turnos, puede elegir un elemento de escenografía en el campo de batalla que no sea un Edificio: hasta el inicio de tu siguiente turno, dicho elemento de escenografía se considera Terreno peligroso para todas las unidades que no tengan la clave GOBLINS SILVANOS.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Zenderoz. Kaudillo o Gran jefe. Araña gigantesca" id="c299-cf6b-bdc6-dd8e" collective="false" hidden="false" import="true">
      <constraints>
        <constraint id="c05f-f868-d4b9-172f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
      </constraints>
      <selectionEntries>
        <selectionEntry name="Zendero Zagrado" id="7f53-958e-7e78-2ea2" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c9bf-b206-e869-3e7c" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="b301-d132-4676-e1ea" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
