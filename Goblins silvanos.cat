              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad obtienen la regla especial Disparos múltiples (2).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Eztandarte burlón" id="a11b-106c-b1e3-7461" collective="false" hidden="false" import="true" page="0" type="upgrade">
