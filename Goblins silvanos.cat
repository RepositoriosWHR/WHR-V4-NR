      <selectionEntries>
        <selectionEntry name="Zendero de la Gran Araña" id="4026-b313-19b8-1049" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2145-a9c5-e74a-cd33" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="8427-936f-5b8b-96b5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
