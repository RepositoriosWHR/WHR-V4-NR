      <selectionEntries>
        <selectionEntry name="Bandera del Pozo Negro" id="c922-2e6a-0b92-21f0" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="8fdc-8c35-f61c-99e9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="5ffe-1bd4-9e39-0489" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="75"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="0e15-9260-3692-18c2" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <profiles>
            <profile name="Bandera del Pozo Negro" id="d19e-7d6a-45d9-69c8" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades amigas a 12” o menos del portador verán aumentada su tirada de salvación especial en +1 (máximo de 3+); si no disponían de tirada de salvación especial, obtendrán una tirada de salvación especial de 6+.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Estandartes mágicos. Goblins silvanos" id="0b22-be1e-eadc-70e4" collective="false" hidden="false" import="true">
