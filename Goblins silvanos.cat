            <profile name="Eztandarte del ojo maliziozo" id="310b-ef1b-1adc-9016" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las miniaturas de la unidad obtienen un bonificador de +1 en sus tiradas para impactar con proyectiles.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Banderola del cháman" id="0e0a-1f26-639c-6e19" collective="false" hidden="false" import="true" page="0" type="upgrade">
          <constraints>
            <constraint id="043f-2ec3-4c6f-a064" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="6cb3-a229-0421-89f2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="15"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Banderola del cháman" id="7818-1152-2b8d-f21e" hidden="false" page="0" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Al inicio de cada fase de magia tira 1D6, sumando 1 al resultado por cada otra unidad con la clave orcos o goblins a 12” del portador del estandarte con potencia de unidad de 10 o superior y que no esté huyendo: si el resultado final es de 5 ó superior, el estandarte genera un dado de energía o dispersión para esa fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
    <selectionEntryGroup name="Talismanes mágicos. Goblins silvanos. Chamanes" id="f1f1-f3b4-83c2-a5c4" collective="false" hidden="false" import="true">
