            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <selectionEntries>
            <selectionEntry name="Horror inmortal" id="ba78-8cbc-a41d-dd1f" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="88ad-fb5e-03ef-e878" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="4c40-1b13-d642-34cd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Horror inmortal" id="6d76-b526-b7d4-88b3" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Si el vampiro acaba con un personaje u oficial enemigo en un desafío, podrá restaurar inmediatamente una herida que hubiese sufrido previamente durante la batalla, y la unidad en la que estuviese incluido dicho oficial o personaje quedará Apabullada hasta el final de la fase de combate en curso.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Aura negra de majestuosidad" id="7f7d-9d9a-6f0c-219d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="f9dd-9c6a-acea-53be" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="d5fd-0fa8-7d20-20d3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Aura negra de majestuosidad" id="6c11-2ce6-929e-ffea" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Todas las miniaturas a 6” o menos del vampiro tendrán un penalizador de -1 a su atributo de Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
        <selectionEntry name="Mundvard El Cruel" id="cc08-9f1f-beda-5974" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
