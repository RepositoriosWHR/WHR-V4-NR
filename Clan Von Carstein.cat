          <profiles>
            <profile name="Encarnación de la muerte" id="edce-2fd3-2b53-a78a" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Si hay uno o más vampiros con este poder en un combate, suma +1 al resultado del combate del bando del Von Carstein). Ten en cuenta que todos los Von Carstein poseen este poder, y no cuenta para el número máximo de Poderes Vampíricos que pueden adquirir.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Señor de las legiones" id="e1ef-59e8-a12a-4bdf" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a1b1-1405-e64a-ef02" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="5"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Señor de las legiones" id="d3fa-f684-3974-c71b" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El personaje puede, con los hechizos Iinvocación de Nehek y Animar muertos, aumentar el número de las unidades de Leva sylvana, Milicia sylvana y Leva de tiradores por encima de su tamaño inicial (sigue estando limitado por su máximo de unidad).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Señor de la no muerte" id="a594-f71b-3c7a-012f" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="963c-3d40-86d8-4b32" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Señor de la no muerte" id="0264-b3bd-f5ed-b752" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de leva sylvana, milicia sylvana y leva de tiradores suma +1 por dado de invocación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Invocar a las criaturas de la noche" id="47de-2b84-2fd9-312d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="d57d-57ac-d05f-21f9" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Invocar a las criaturas de la noche" id="ac85-a88d-3e92-b052" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de murciélagos vampiro, lobos siniestros (o lobos espectrales) y vargheist, suma +1 por dado de invocación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Honor o muerte" id="3a8b-d6f8-6af7-6ede" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="520e-6df8-f9fe-fb6d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <infoLinks>
            <infoLink name="Orgullo marcial" id="88ec-3ff6-41c3-7632" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Honor o muerte" id="f2e4-9cb4-42f3-7a1e" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El vampiro obtiene la regla especial Orgullo marcial. Puede repetir todas sus tiradas para impactar no superadas en los desafíos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Horror inmortal" id="fa7b-3708-2693-4067" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="f7e8-6f24-ab35-a1a0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="20"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Horror inmortal" id="55d4-76c1-30ab-ac23" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Si el vampiro acaba con un personaje u oficial enemigo en un desafío, podrá restaurar inmediatamente una herida que hubiese sufrido previamente durante la batalla, y la unidad en la que estuviese incluido dicho oficial o personaje quedará Apabullada hasta el final de la fase de combate en curso.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Férrea voluntad" id="2356-1c4e-dfca-a657" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="a7a5-7cc7-74aa-c3bb" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Férrea voluntad" id="76fd-bc9b-e64d-744a" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Todas las miniaturas no muertas amigas a 12&quot; o menos del vampiro sufren una herida menos como resultado de perder un combate cuerpo a cuerpo.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Mirada hipnótica" id="8813-5a0e-fffb-137a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4150-eae4-1161-475d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="25"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Mirada hipnótica" id="2aae-18f4-bb0b-49b1" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Los enemigos tendrán un penalizador de -1 en sus tiradas para impactar en combate cuerpo a cuerpo contra el vampiro. No afecta a miniaturas con la regla especial No muerto o Demonio.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
