            <profile name="Espada del Castellano" id="d19a-3578-b5e7-609c" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano funeraria. Los ataques con este arma se resuelven con un modificador de +1 a la Habilidad de Armas e Iniciativa, y la regla especial Poder de penetración. Además, se considera que el portador se encuentra siempre dentro del radio de la Presencia inspiradora del general del ejército.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
