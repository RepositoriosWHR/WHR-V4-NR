                  <conditions>
                    <condition childId="ced4-7e78-5989-92d3" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="atLeast" value="1"/>
                    <condition childId="4089-06f9-f813-6878" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="atLeast" value="1"/>
