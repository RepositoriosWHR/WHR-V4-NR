          <profiles>
            <profile name="Cetro de mando" id="ce99-cb47-cac9-89e0" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Se trata de un objeto portahechizos con nivel de energía 1D3 que contiene el hechizo Animar muertos (en su versión no potenciada), del Saber de Nigromancia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
