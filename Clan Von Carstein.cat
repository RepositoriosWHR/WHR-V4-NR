    <selectionEntry name="Nigromante" id="3206-c57a-9000-ecf4" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="94de-e883-01de-ec94" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
