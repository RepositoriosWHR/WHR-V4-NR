          <profiles>
            <profile name="Aura de majestad infernal" id="3cbd-f4d1-6f44-a3bf" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El alcance de la regla especial Presencia inspiradora del vampiro es de 18” en lugar de las 12” habituales (o 24” si va montado en un Objetivo grande).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
