                <profile name="Filo de energía oscura" id="927c-9f8d-228f-5254" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Proporciona a Mannfred +1F en combate cuerpo a cuerpo. Cada vez que Mannfred elimine a una miniatura enemiga en combate cuerpo a cuerpo con el Filo de energía oscura, obtiene un dado de energía adicional en su siguiente fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
