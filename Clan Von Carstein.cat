            <profile name="Relicario de Vashanesh" id="fd05-9732-6b31-a196" hidden="false" typeId="5d17-3511-0c13-e904" typeName="Objeto hechizado">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="0ef8-5055-c22e-455a">Una vez por batalla, al inicio de la fase de disparo o de combate cuerpo a cuerpo, el portador puede desatar el poder del relicario: hasta el final de dicha fase, el portador y su unidad podrán repetir sus tiradas fallidas para herir cuyo resultado sea de 1.</characteristic>
              </characteristics>
            </profile>
          </profiles>
