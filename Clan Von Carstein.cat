              <profiles>
                <profile name="Espada del lobo" id="dc24-e681-a87a-7ad0" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Los ataques con este arma se resuelven con un bonificador de +1 a la Fuerza. Por cada herida causada por este arma, Rutger puede añadir un dado adicional de Energía o Dispersión (según corresponda) en la siguiente fase de magia.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
