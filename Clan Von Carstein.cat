      <profiles>
        <profile name="Caballero imperial" id="4315-d15c-500a-6809" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
          <characteristics>
            <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Este poder tan sólo puede ser elegido por un vampiro sin montura o montado en una bestia (es decir, que tenga el tipo de tropa Caballería) que se una a una unidad de Tumularios o Caballeros tumularios respectivamente (y no podrá abandonar voluntariamente esa unidad). Tanto el personaje como la unidad a la que se una sustituyen sus armaduras pesadas por Armaduras de placas.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
    <selectionEntry name="Carro de cadáveres" id="5abc-a748-8f2f-1181" collective="false" hidden="false" import="true" type="upgrade">
      <costs>
        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="No Muerto (1)" id="fc51-b0e9-1991-578d" hidden="false" targetId="467a-3f64-3c89-09ba" type="rule"/>
        <infoLink name="Terror" id="15e7-4a79-2d9f-7de5" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Carro" id="76d1-1c4d-aff4-c77a" hidden="false" targetId="c761-ad12-6530-fab7" type="rule"/>
        <infoLink name="Regeneración (4+)" id="b58f-9c23-942b-3327" hidden="false" targetId="6605-7689-3444-dccd" type="rule"/>
        <infoLink name="Ataques aleatorios" id="f9c0-a02f-20f6-ceda" hidden="false" targetId="f4cc-528c-a54e-8e28" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(2D6)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Ataques envenenados" id="cd7d-cc73-a16e-8091" hidden="false" targetId="9867-a512-772e-f61c" type="rule">
          <modifiers>
            <modifier field="name" type="append" value="(Horda de zombis)"/>
          </modifiers>
        </infoLink>
        <infoLink name="Protección por montura (1)" id="8e1a-474e-fc59-fe77" hidden="false" targetId="1f9d-b34a-3d89-add6" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Potencia de unidad 4" id="8531-a034-1250-f394" hidden="false"/>
        <rule name="Horda de zombis" id="e8bb-ecfc-86ab-70f1" hidden="false">
          <description>La Horda de zombis tiene las reglas especiales Ataques aleatorios (2D6) y Ataques envenenados; gracias a los zombis, el Carro de cadáveres puede marchar pese a ser un carro; sin embargo, no tiene la regla especial Veloz.</description>
        </rule>
        <rule name="Miasma de descomposición" id="e2d7-157d-33ae-e58d" hidden="false">
          <description>Todos los ataques cuerpo a cuerpo yde proyectiles que se dirijan contra un personaje montado en Carro de cadáveres tendrán un penalizador de -1 para impactar.</description>
        </rule>
        <rule name="Foco de poder nigromántico" id="2e6f-d813-4bb9-7d8e" hidden="false">
          <description>Todas las unidades amigas con la regla especial No muerto a 12” o menos de un Carro de cadáveres obtienen la regla especial Regeneración (6+ o +1 a su Regeneración si ya disponían de ella) y podrán marchar como si se encontrasen a 12” o menos del General del ejército.</description>
        </rule>
      </rules>
      <selectionEntries>
