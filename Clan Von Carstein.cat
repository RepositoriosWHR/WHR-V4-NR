        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Lady Ariete Von Carstein" id="22ef-df7a-68ca-34d8" hidden="false">
          <description>Ariette es un hechicera de nivel 1 que puede generar su hechizo del saber de la Muerte o Nigromancia.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Poderes vampíricos" id="e060-90ff-7edd-2017" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="5c40-20ba-c2a9-2cce" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
            <constraint id="be29-e234-8a0c-7cc0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="0"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <selectionEntries>
            <selectionEntry name="Forma lupina" id="bee2-69dd-7192-7b87" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="867e-f35a-a654-94b0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
                <constraint id="1071-6d2f-6d06-cf4d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Piel escamosa (4+)" id="b710-06f1-e4ab-94e3" hidden="false" targetId="478f-4519-03d3-5004" type="rule"/>
                <infoLink name="No Muerto (1)" id="3844-dcea-7530-63fa" hidden="false" targetId="467a-3f64-3c89-09ba" type="rule"/>
                <infoLink name="Vampiro" id="63b4-5326-0ab5-9b51" hidden="false" targetId="5b50-ef78-5aa5-ef12" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Forma lupina" id="f19a-d7a7-14fb-7c6b" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Al inicio de cada uno de tus turnos, Ariette puede cambiar a Forma lupina; si se encuentra en Forma lupina, puede cambiar a forma humanoide. En Forma lupina, su tipo de tropa cambia a Bestia (personaje, 25x50mm); en forma de lobo, Ariette tiene las reglas especiales No muerto (1), Vampiro y Piel escamosa (4+). Aunque conserva sus poderes vampíricos, no dispondrá de sus elementos de equipo ni objetos mágicos (aunque sí podrá utilizar su nivel de magia y hechizo). Si se encontraba dentro de una unidad o trabada en combate cuerpo a cuerpo, coloca el Lobo en cualquier punto de tu elección, a como máximo 6” de donde se encontraba Ariette, y a más de 1” de cualquier otra miniatura (si no puedes, retira al Lobo como baja). Al cambiar de forma, Ariette recupera todas las heridas que hubiese sufrido previamente durante la batalla. Si Ariette es retirada como baja estando en forma humanoide, se transformará inmediatamente en su forma de lobo, aunque no podrá cambiar más a su forma humanoide durante la batalla. Ten en cuenta que Ariette no otorga puntos de victoria si es eliminada en forma humanoide y se transforma.</characteristic>
                  </characteristics>
                </profile>
                <profile name="Forma lupina" id="ce4e-2f07-0886-4d40" hidden="false" typeId="4d6f64656c23232344415441232323" typeName="Modelo">
                  <characteristics>
                    <characteristic name="M" typeId="4d23232344415441232323">10</characteristic>
                    <characteristic name="HA" typeId="5.753232323444154e+23">6</characteristic>
                    <characteristic name="HP" typeId="4.2532323234441546e+23">0</characteristic>
                    <characteristic name="F" typeId="5.323232344415441e+21">5</characteristic>
                    <characteristic name="R" typeId="5.423232344415441e+21">5</characteristic>
                    <characteristic name="H" typeId="5.723232344415441e+21">3</characteristic>
                    <characteristic name="I" typeId="4.923232344415441e+21">7</characteristic>
                    <characteristic name="A" typeId="4.123232344415441e+21">4</characteristic>
                    <characteristic name="L" typeId="4c4423232344415441232323">8</characteristic>
                    <characteristic name="TSA" typeId="41726d6f75725361766523232344415441232323">4</characteristic>
                    <characteristic name="TSE" typeId="5.761726453617665e+35"/>
                    <characteristic name="Tipo" typeId="5.479706523232345e+27">Bestia</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Invocar a las criaturas de la noche" id="d6cb-0ff7-2803-79e1" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="1acc-61f3-7522-b361" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="c999-2e14-5039-9c5f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Invocar a las criaturas de la noche" id="2aa4-0c1a-22bd-3739" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Murciélagos vampiro, Lobos siniestros (o Lobos espectrales) o Vargheist, suma +1 por dado de invocación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
