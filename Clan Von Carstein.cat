              <profiles>
                <profile name="Señor de las legiones" id="4c3b-6dfd-095b-9585" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El personaje puede, con los hechizos Iinvocación de Nehek y Animar muertos, aumentar el número de las unidades de Leva sylvana y Leva de tiradores por encima de su tamaño inicial (sigue estando limitado por su máximo de unidad).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Señor de la no muerte" id="99ba-79f1-4b9b-8fbc" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2fd9-40d3-82db-7cf0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="c464-53e3-ef02-b349" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Señor de la no muerte" id="9085-7325-60ce-07f2" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Leva sylvana, Leva de tiradores o Milicia sylvana suma +1 por dado de invocación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Invocar a las criaturas de la noche" id="4e4c-a9c4-f44c-282e" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="eb25-7d18-a33d-05e6" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="22a5-9f9a-733a-4391" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Invocar a las criaturas de la noche" id="4ee0-31fd-6c31-45e5" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Murciélagos vampiro, Lobos siniestros (o Lobos espectrales) o Vargheist, suma +1 por dado de invocación.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Honor o muerte" id="6830-8d51-b5fa-ef60" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ebd1-cc3e-bc6e-6998" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="26a3-b105-48c2-a7c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
