        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Conde Rutger Von Bleistift" id="d048-bab3-79c7-4b77" hidden="false">
          <description>Rutger es un hechicero de nivel 3. Puede elegir sus hechizos de los Saberes de la Muerte, las Sombras, el Fuego, Magia Oscura y/o Nigromancia y puede mezclar diferentes saberes a la hora de elegir sus hechizos.</description>
        </rule>
        <rule name="Contemplación fascinante" id="0f6f-7cad-a6b1-165f" hidden="false">
          <description>Todos los enemigos que ataquen a Rutger en combate cuerpo a cuerpo deberán aplicar un penalizador de -1 en sus tiradas para impactar; además, todos los enemigos que ataquen en combate cuerpo a cuerpo a Rutger realizarán un Ataque menos (con un mínimo de 1 Ataque por miniatura).</description>
        </rule>
      </rules>
