          </costs>
          <profiles>
            <profile name="Señor de las legiones" id="0b3d-69a7-6afd-c942" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El personaje puede, con los hechizos Iinvocación de Nehek y Animar muertos, aumentar el número de las unidades de Leva sylvana y Leva de tiradores por encima de su tamaño inicial (sigue estando limitado por su máximo de unidad).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Señor de la no muerte" id="99f6-9aef-7f86-a40a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="eeb9-2d01-6234-5a9d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="a5bf-2b67-1ce1-9dd2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Señor de la no muerte" id="f935-72c9-fc1f-730f" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Leva sylvana, Leva de tiradores o Milicia sylvana suma +1 por dado de invocación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Invocar a las criaturas de la noche" id="6358-5685-ec60-1943" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1648-88c0-52ef-44d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="108d-e9af-cfc3-8a6d" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="10"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Invocar a las criaturas de la noche" id="00fc-368e-73b8-784b" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cada vez que el vampiro utilice los hechizos Invocación de Nehek o Animar muertos sobre unidades de Murciélagos vampiro, Lobos siniestros (o Lobos espectrales) o Vargheist, suma +1 por dado de invocación.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Honor o muerte" id="ca24-d22a-65b1-aefe" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="c0ea-e7a7-2866-bc8c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="277f-5c9e-1136-10b1" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
