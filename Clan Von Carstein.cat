            <infoLink name="Resistencia mágica (1)" id="5a2b-9cb6-caf1-e958" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="El Yelmo de Lord Ankhat" id="ff8b-9c3c-54fd-8c76" hidden="false" typeId="219b-aed3-c65c-d46d" typeName="Armadura mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="e0ed-7366-4856-8f3d">Yelmo. Sólo miniaturas de Infantería o Caballería. Proporciona a su portador un bonificador de +2 a su atributo de Heridas, así como una tirada de salvación especial de 5+ y la regla especial Resistencia mágica (1). El poder de esta reliquia es tal que no puede verse afectada, destruida  o anulada por efectos que anulen, destruyan o afecten a objetos mágicos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
