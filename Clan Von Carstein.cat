        <rule name="Monstruosidad ancestral" id="76cd-da9d-74c8-1b44" hidden="false">
          <description>El alcance del Terror que causa un Dragón Zombi Anciano es de 12” en lugar de las 8” habituales.</description>
        </rule>
        <rule name="Bocanada putrefacta" id="e714-c44b-f1a2-b717" hidden="false">
