            <profile name="El Ojo de Khemri" id="e2bb-9d97-a8cd-d407" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Sólo Vampiros. El Ojo proporciona a su portador un nivel de magia adicional (hasta un máximo de 4). Además, el portador y la unidad en la que se incluya obtienen la regla especial Indesmoralizables.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
