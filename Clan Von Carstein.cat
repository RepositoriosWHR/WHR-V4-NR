            <profile name="Taslimán negro" id="384c-016e-c7b8-56bb" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Permite a su portador guardar un dado de energía o dispersión al final de cualquier fase de magia para transformarlo en un dado del tipo que corresponda en la siguiente fase de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Báculo del cráneo" id="0d45-69c5-ee38-ca78" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
