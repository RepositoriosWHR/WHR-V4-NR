          <profiles>
            <profile name="Familar necrótico" id="14d0-2808-0e88-545e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El familiar necrótico permite repetir las tiradas de los dados de invocación de los hechizos Invocación de Nehek y Animar muertos que lance el portador. Aunque puedes representarlo con una pequeña miniatura de familiar, no puede ser atacado, y deberá retirarse si su dueño se retira como baja.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
