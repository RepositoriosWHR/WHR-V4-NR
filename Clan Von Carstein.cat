            <entryLink name="Reliquia" id="d709-c27a-05bc-dfc9" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Arma de mano" id="90f8-6942-ea4d-15d2" hidden="false" targetId="891d-c74a-2555-793e" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="Espada maldita de Sylvania" id="626d-c2d2-8c65-977d" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Sus impactos se resuelven con un bonificador de +1 Fuerza y niega la tirada de salvación por armadura. Por cada herida causada con la espada en combate cuerpo a cuerpo a un enemigo, el portador puede restaurar inmediatamente una herida que hubiese sufrido previamente durante la batalla o generar un dado de energíao dispersión adicional en la próxima fase de magia. Tan sólo el portador podrá utilizar esos dados de energía adicionales.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="La cimitarra de Khaled Al-Muntasir" id="9207-d240-8c97-c112" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4924-ef97-cb22-4672" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="def4-22fe-2f8c-421a" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
