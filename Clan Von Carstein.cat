          <profiles>
            <profile name="La cimitarra de Khaled Al-Muntasir" id="aff6-5b81-6803-efc3" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. El portador luchará con +1 Ataque e Iniciativa 10 en combate cuerpo a cuerpo, y sus impactos se resolverán con un bonificador de +1 Fuerza. Además, podrá repetir sus tiradas fallidas para impactar.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
