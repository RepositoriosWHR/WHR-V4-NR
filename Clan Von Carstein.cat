                <profile name="Garra vampíricas" id="e3e3-4038-5c56-bc4b" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Al inicio de cada ronda de combate, Ulrika puede decidir atacar con su Colmillo de lobo y su Daga de plata o atacar con sus garras. Si ataca con sus garras obtiene un bonificador de +2 a su atributo de Ataques, +1 a su atributo de Fuerza y +2 a su atributo de Iniciativa.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
