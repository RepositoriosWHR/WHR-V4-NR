              <characteristics>
                <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Arma de mano. Sus impactos se resuelven con la regla especial Poder de penetración. Si el portador mata a un 
oponente en un desafío, obtiene inmediatamente un bonificador extraordinario de +1D3 al resultado del combate para esa ronda.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Bastón de poder" id="be80-7112-b7d0-5bcc" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="7a96-75b2-7f3a-c900" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="b954-309b-5414-c89e" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
