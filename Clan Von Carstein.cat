    <selectionEntryGroup name="Poderes vampíricos Von Carstein. Poderes mayores" id="0f88-9196-b401-1acd" collective="false" hidden="false" import="true">
      <selectionEntries>
        <selectionEntry name="Aura negra de majestuosidad" id="e108-c5ff-c697-af8a" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="2a50-587e-d239-f7f2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="724b-6b61-e974-3626" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Aura negra de majestuosidad" id="a479-4a91-017f-7b4a" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Todas las miniaturas a 6” o menos del vampiro tendrán un penalizador de -1 a su atributo de Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Despertar la tempestad" id="65b5-3748-970b-7e82" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="e52b-1348-395c-f8a2" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1f6b-7c2c-ef07-f921" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="40"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <profiles>
            <profile name="Despertar la tempestad" id="3045-046f-f1e1-c445" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Al inicio de tu fase de movimiento, si el personaje no está trabado en combate cuerpo a cuerpo, el vampiro puede invocar una tormenta. La tormenta tiene un radio de 12&quot; centrada en el vampiro. Cualquier unidad que dispare hacia, desde o a través el interior de la tormenta sufrirá un penalizador de -2 para impactar; los efectos de Tormenta de proyectiles que disparen hacia, desde o a través reducirán sus impactos a la mitad; las catapultas o efectos que se dispersen de forma similar se dispersarán el doble dentro de la tormenta; los cañones sólo podrán disparar hacia, desde y a través si antes obtienen un resultado de 4+ en 1D6; las armas de aliento o efectos que usen la plantilla de lágrima solamente causarán impactos parciales a las miniaturas en el interior de la tormenta (en combate actuarán normalmente) y no se puede hacer uso de las reglas especiales Volar o Flotar hacia, a través y desde el interior. Si el vampiro se traba en combate o muere, la tormenta cesará inmediatamente.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Pureza de sangre" id="2fe3-569b-f6e7-eb77" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="1bfb-8d35-dda4-d01c" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="3226-82ea-ae0f-9ea7" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
          <costs>
