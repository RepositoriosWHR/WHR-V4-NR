                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <entryLinks>
                <entryLink name="Leyenda" id="9d79-f5fd-ad93-1d51" collective="false" hidden="false" import="true" targetId="8f04-2596-2103-99ce" type="selectionEntry"/>
              </entryLinks>
              <infoLinks>
                <infoLink name="Tozudez" id="649a-3f03-107f-4835" hidden="false" targetId="eeaa-5e56-bdf4-3ddb" type="rule"/>
              </infoLinks>
              <profiles>
                <profile name="Señor de Drakenhof" id="9201-b520-4458-3867" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El personaje y todas las unidades amigas dentro de su radio de Presencia inspiradora serán Tozudos. Además, el personaje obtiene la regla especial Legendario.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Nobleza antigua de Sylvania" id="88f4-62d6-239d-7d7d" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="47bc-ea24-830d-1c73" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="99e0-9c93-df65-f318" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Nobleza antigua de Sylvania" id="0357-1368-77f6-b920" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Tu ejército puede incluir hasta 2 unidades del libro de ejército del Imperio de entre las siguientes: Espadachines, Lanceros, Alabarderos, Arqueros, Ballesteros, Compañías libres, Fusileros. Contarán como opciones de Unidad básica. Obtienen las reglas especiales ¡Están vivos! e Inmunes a Miedo, y elegirán sus estandartes mágicos del Reglamento o de este libro de ejército.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
          </selectionEntries>
        </selectionEntry>
