              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El vampiro aumenta en 1 sus niveles de magia, hasta un máximo de 4.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Estirpe del Conde" id="3d0b-7ca4-3d4a-970a" collective="false" hidden="false" import="true" type="upgrade">
