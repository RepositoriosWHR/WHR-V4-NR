        <infoLink name="Vampiro" id="e9f7-03a9-1a38-87d6" hidden="false" targetId="5b50-ef78-5aa5-ef12" type="rule"/>
        <infoLink name="Infantería" id="868c-64a9-a032-4998" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
