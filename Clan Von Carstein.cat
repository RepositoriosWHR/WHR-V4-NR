          <infoLinks>
            <infoLink name="Orgullo marcial" id="1e52-a02a-58d1-44de" hidden="false" targetId="2707-4d2a-ddbd-e301" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Honor o muerte" id="7585-676a-5b8c-841e" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El vampiro obtiene la regla especial Orgullo marcial. Puede repetir todas sus tiradas para impactar no superadas en los Desafíos.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Horror inmortal" id="96ea-002b-113c-ce42" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="4a11-9ea2-c955-8315" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="0dc8-7d1b-8b4a-cc56" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="roster" shared="false" type="max" value="1"/>
          </constraints>
