                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Sólo Infantería. El vampiro obtiene la regla especial Volar (10).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
