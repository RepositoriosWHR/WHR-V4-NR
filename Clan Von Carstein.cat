      <modifiers>
        <modifier field="hidden" type="set" value="true">
          <conditions>
            <condition childId="e01b-aa63-8a17-da7d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Magia Mundvard El Cruel" id="c816-371e-9c96-2ce3" hidden="false">
          <description>Es un hechicero de nivel 1 que elige sus hechizo de entre los saberes de Nigromancia o las Sombras.</description>
        </rule>
        <rule name="Despligue oculto Mundvard El Cruel" id="860f-318f-28ed-1169" hidden="false">
          <description>Mundvard no puede ser el general del ejército. Mundvard puede elegir no desplegar junto con el resto del ejército: Puede empezar la partida oculto en una unidad (que no sea destacamento) de entre las siguientes: Leva sylvana, Leva de Tiradores, Milicia sylvana, Tumularios o Grandes espaderos tumularios. Anota en la lista de ejército en qué unidad va oculto. Si la unidad es eliminada antes de revelar a Mundvard, éste se retirará como baja con el resto de la unidad. No hay ningún otro modo de herir o matar a Mundvard antes de que éste sea revelado. Mundvard puede ser revelado al comienzo de cualquier turno propio o al principio de cualquier fase de combate: el jugador Von Carstein declara que su unidad tiene a Mundvard y lo coloca en la fila frontal de la unidad, como si fuese un personaje que se acaba de unir a la unidad.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Poderes vampíricos" id="db24-6645-8f3f-671b" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="06c8-f0f6-d408-24d0" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
