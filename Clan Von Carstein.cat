          <infoLinks>
            <infoLink name="Volar (8)" id="0f3b-c1b6-7930-49af" hidden="false" targetId="4976-4d2f-fd36-1a17" type="rule"/>
            <infoLink name="Terror" id="6200-0cd9-1559-7354" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
            <infoLink name="Infantería monstruosa" id="98a4-a204-443f-141f" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Transformación bestial" id="0870-074c-2c03-1b66" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Cambia el tipo del personaje a Infantería monstruosa, y su peana a 40x40mm. El personaje no puede elegir Monturas, Armas mágicas o Armaduras mágicas, y pierde todo su equipo mundano (armas y armaduras) salvo el Arma de mano. El vampiro obtiene un bonificador de +1 a su Fuerza, Resistencia, Heridas y Ataques, y obtiene las reglas especiales Volar (8) y causa Terror.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
    </selectionEntryGroup>
