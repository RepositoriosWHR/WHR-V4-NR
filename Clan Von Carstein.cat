                <profile name="Férrea voluntad" id="7fbf-6b8c-774c-5aad" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Todas las miniaturas no muertas amigas a 12&quot; o menos del vampiro sufren una herida menos como resultado de perder un combate cuerpo a cuerpo.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Señor de la no muerte" id="7d12-c6a2-9e5c-caab" collective="false" hidden="false" import="true" type="upgrade">
