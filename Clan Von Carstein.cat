            <profile name="Bandera del Conde" id="0554-3d92-fbc0-44fe" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador, su unidad y los destacamentos de su unidad a 6” o menos de ésta obtienen la regla especial Sangre fría; además, sufrirán una herida menos de las que les correspondiesen si pierden un combate y fallan su chequeo de Inestabilidad.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
