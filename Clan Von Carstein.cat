        <infoLink name="No Muerto (1)" id="a473-e1df-5232-13c9" hidden="false" targetId="467a-3f64-3c89-09ba" type="rule"/>
        <infoLink name="Terror" id="3cd0-90ad-136b-a11e" hidden="false" targetId="ca57-1f1f-8bc0-d9ab" type="rule"/>
        <infoLink name="Flotar (10)" id="05ed-ab7e-363b-15bb" hidden="false" targetId="ab20-210e-1aec-5a72" type="rule"/>
        <infoLink name="Resistencia mágica (1)" id="3366-30f1-0919-b193" hidden="false" targetId="eae7-760e-1a1e-47d7" type="rule"/>
        <infoLink name="Protección por montura (2)" id="e3d2-965c-b5ad-635a" hidden="false" targetId="e265-bb6c-2315-231a" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Potencia de unidad 6" id="0afc-375d-ea03-c993" hidden="false"/>
        <rule name="Velo de sombras" id="a5ef-e8d6-76fb-f45f" hidden="false">
          <description>Tanto el Carruaje de las sombras como su tripulante vampiro tienen una tirada de salvación especial de 4+ y Resistencia mágica (1).</description>
        </rule>
        <rule name="Aura de corrupción" id="31c2-d699-9125-fb56" hidden="false">
          <description>Todas las unidades enemigas a 8” o menos del Carruaje de las Sombras tendrá un penalizador de -1 a su Liderazgo (no afecta a No muertos o Demonios). Además, todos los hechiceros que intenten lanzar un hechizo de los Saberes de la Vida, la Luz o Alta magia a 18” o menos del Carruaje verá incrementada la dificultad para lanzar el hechizo en +2.</description>
        </rule>
        <rule name="Despertar a los muertos" id="3078-e44a-d75c-b8eb" hidden="false">
          <description>Al inicio de cada una de tus fases de magia propias, el Carruaje puede lanzar, como un objeto portahechizos, el hechizo Invocación de Sylvania (funciona exactamente igual que la Invocación de Nehek en su versión potenciada, pero se trata de un hechizo diferente), con un nivel de energía de 2D6. Además, debido al poder oscuro del Carruaje de las Sombras,
el radio de alcance de este hechizo es de 18”, en lugar de las 12” habituales.</description>
        </rule>
        <rule name="Horda de espíritus" id="a6e9-728f-a471-47aa" hidden="false">
          <description>Horda de espíritus tienen las reglas especiales Ataques mágicos y Ataques aleatorios (2D6+2).</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Carruaje de las sombras" id="620a-121e-0d17-9afe" collective="false" hidden="false" import="true" type="upgrade">
