      <infoLinks>
        <infoLink name="Infantería" id="54f6-9fb5-65ea-87a4" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule">
          <modifiers>
            <modifier field="hidden" type="set" value="true">
