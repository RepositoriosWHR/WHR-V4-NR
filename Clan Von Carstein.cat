                <infoLink name="Poder de penetración" id="fbd2-a167-2733-466e" hidden="false" targetId="29d3-6624-40c6-885f" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Espada Colmillo de Lobo)"/>
                  </modifiers>
                </infoLink>
                <infoLink name="Carga devastadora" id="2de8-f41a-2981-b737" hidden="false" targetId="dbe6-c910-7f37-aeac" type="rule">
                  <modifiers>
                    <modifier field="hidden" type="set" value="true">
                      <conditions>
                        <condition childId="e323-21d9-c891-c57d" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="0919-736a-e1ca-51e4" shared="true" type="equalTo" value="0"/>
                      </conditions>
                    </modifier>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Espada Colmillo de Lobo y Daga de Plata" id="e220-1478-07e7-be00" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Armas emparejadas. Ulrika debe dividir sus ataques entre ambas armas, realizando al menos 1 ataque con cada una de ellas. Los ataques realizados por la Espada Colmillo de Lobo tienen un bonificador de +1 para impactar en combate cuerpo a cuerpo y la regla especial Poder de penetración. Además, las heridas causadas con esta espada recuperarán heridas por la regla Vampiro con un resultado de 4+ en vez de 5+ habitual. Los ataques realizados por la Daga de Plata tienen un bonificador de +1 en sus tiradas para herir contra miniaturas con la regla especial No muerto o Demonio. Si Ulrika lucha a pie puede efectuar Parada al luchar con estas armas; si lucha montada obtiene la regla especial Carga devastadora al luchar con estas armas.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
