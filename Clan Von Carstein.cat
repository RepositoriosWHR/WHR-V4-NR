      <rules>
        <rule name="Magia Vlad Von Carstein" id="1a5e-2c00-f124-c052" hidden="false">
          <description>Vlad es un hechicero de nivel 3 que puede elegir sus hechizos del saber de la Muerte y/o Nigromancia.</description>
        </rule>
        <rule name="Amor inmortal (Vlad)" id="5959-2f5b-413b-884b" hidden="false">
          <description>Si Vlad muere, Isabella obtendrá las reglas especiales Furia asesina e Indesmoralizable; si Isabella muere, Vlad obtendrá las reglas especiales Furia asesina e Indesmoralizable.</description>
        </rule>
        <rule name="Señor de los Von Carstein" id="21bf-a448-e431-482e" hidden="false">
          <description>La regla especial Presencia inspiradora de Vlad tiene un alcance de 18” en lugar de las 12” habituales.</description>
        </rule>
      </rules>
