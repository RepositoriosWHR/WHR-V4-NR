                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Aura demoníaca (3+)" id="7d56-87e6-a6b3-35cb" hidden="false" targetId="df2b-0ff4-bf34-28b8" type="rule"/>
                <infoLink name="Aura demoníaca (4+)" id="65be-eb9e-e7e1-b36b" hidden="false" targetId="79f2-17bc-18d1-75e3" type="rule">
                  <modifiers>
                    <modifier field="name" type="append" value="(Potencia unidad 5+)"/>
                  </modifiers>
                </infoLink>
              </infoLinks>
              <profiles>
                <profile name="Estirpe de Sylvania" id="3eea-b5d1-909d-e8cc" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">El vampiro obtiene la regla especial Aura demoníaca (3+); si el personaje tiene Potencia de unidad de 5 o superior, en lugar de eso otorga Aura demoníaca (4+).</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Aura negra de majestuosidad" id="4f2d-0222-60be-4e36" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="ca77-959d-4aba-19e5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="95e3-7b89-f611-09c8" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Aura negra de majestuosidad" id="b37e-e5a5-4510-8e0e" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Todas las miniaturas a 6” o menos del vampiro tendrán un penalizador de -1 a su atributo de Liderazgo. Esto no afecta a miniaturas con la regla especial Demonio o No muerto.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Despertar la tempestad" id="9a8c-b91b-6bb3-ca5a" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="dbe7-1e8f-bacd-6dcd" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="3800-815c-e7bb-e39f" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="min" value="1"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="0"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <profiles>
                <profile name="Despertar la tempestad" id="70f6-7f97-4e62-a721" hidden="false" typeId="e483-859c-97c8-fa19" typeName="Poder vampírico">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="86cf-6257-bcc7-d4f6">Al inicio de tu fase de movimiento, si Vlad no está trabado en combate cuerpo a cuerpo, puede invocar una tormenta. La tormenta tiene un radio de 12&quot; centrada en Vlad. Cualquier unidad que dispare hacia, desde o a través el interior de la tormenta sufrirá un penalizador de -2 para impactar; los efectos de Tormenta de proyectiles que disparen hacia, desde o a través reducirán sus impactos a la mitad; las catapultas o efectos que se dispersen de forma similar se dispersarán el doble dentro de la tormenta; los cañones sólo podrán disparar hacia, desde y a través si antes obtienen un resultado de 4+ en 1D6 y no se puede 
hacer uso de las reglas especiales Volar o Flotar hacia, a través y desde el interior. Si Vlad se traba en combate o muere, la 
tormenta cesará inmediatamente.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Señor de Drakenhof" id="07d1-ac5e-f6da-b341" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="2402-7d73-74c6-0302" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
                <constraint id="ffc6-021a-1a3b-ef62" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="false" type="min" value="1"/>
              </constraints>
              <costs>
