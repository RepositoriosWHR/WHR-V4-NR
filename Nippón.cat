          <profiles>
            <profile name="Libro oculto de Tsien-Tsin" id="d6d5-7362-4f54-b00e" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador genera un dado de energía adicional en sus fases de magia y puede elegir hechizos del Saber de Tzeentch. No obstante, si en los vientos de la magia del turno propio se obtiene un resultado de dobles, esa fase de magia el libro no generará el dado de energía adicional.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Libro de los ancestros" id="5238-9a3a-3d25-bfb3" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="fc0a-8f3a-aa71-b1fe" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1e9d-d30d-c774-2ec9" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
          <costs>
            <cost name="pts" typeId="points" value="60"/>
            <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
          </costs>
          <entryLinks>
            <entryLink name="Reliquia" id="c734-84c6-b454-414d" collective="false" hidden="false" import="true" targetId="a485-24d0-42b1-23c7" type="selectionEntry"/>
          </entryLinks>
          <infoLinks>
            <infoLink name="Señor del conocimiento" id="d91a-b6f3-dccf-1f18" hidden="false" targetId="38ca-408d-dbc3-4847" type="rule">
              <modifiers>
                <modifier field="name" type="append" value="(Uno de los 8 saberes básicos)"/>
              </modifiers>
            </infoLink>
          </infoLinks>
          <profiles>
            <profile name="Libro de los ancestros" id="ec07-9934-b767-3f58" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">El portador obtiene la regla especial Señor del Conocimiento (de uno de los 8 saberes básicos de la magia) y además generará un dado de energía o de dispersión en cada fase.</characteristic>
              </characteristics>
            </profile>
          </profiles>
          <selectionEntryGroups>
            <selectionEntryGroup name="Los saberes de la magia" id="4123-a070-491c-17b4" collective="false" hidden="false" import="true">
              <constraints>
                <constraint id="0de0-ea53-d33b-c3c5" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
              </constraints>
              <entryLinks>
