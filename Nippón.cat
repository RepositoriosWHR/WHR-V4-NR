      </modifiers>
      <rules>
        <rule name="Don del Sol Divino" id="381d-c02e-6b0c-eca3" hidden="false">
          <description>Las Miko tienen una tirada de salvación especial de 6+ que se ve incrementada a 4+ contra Ataques mágicos.</description>
        </rule>
        <rule name="Hermandad sarada" id="f543-5843-e993-1052" hidden="false">
          <description>Ningún personaje puede unirse a una unidad de Miko.</description>
        </rule>
        <rule name="Flechas espirituales" id="8e84-f164-8076-91a2" hidden="false">
          <description>Los disparos realizados por las Miko no sufren penalizador por mover ni por disparar a distancia larga, y cuentan con la regla especial Poder de penetración. Adicionalmente, pueden repetir los resultados de 1 en sus tiradas para herir contra miniaturas con las reglas especiales Demonio o No muerto.</description>
        </rule>
      </rules>
