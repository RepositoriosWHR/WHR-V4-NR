                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Katana. Yoshimune puede repetir las tiradas fallidas para herir. Los ataques cuerpo a cuerpo dirigidos a Yoshimune tienen un penalizador -1 a impactar.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
