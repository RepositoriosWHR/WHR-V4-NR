            <characteristic name="Tipo" typeId="5.479706523232345e+27">Bestia monstruosa</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule name="Nacido de la tormenta" id="7969-0932-a415-cd4a" hidden="false">
          <description>Los Ki-rin tienen la regla especial Impactos por carga (1, el Impacto por carga se resuelve con la regla especial Ataque de rayos). Los ataques en combate cuerpo a cuerpo de los Ki-rin se resuelven con la regla especial Ataque de rayos. Además, El jinete posee una tirada de salvación especial de 5+, que se incrementa a 3+ contra Ataques de rayos.</description>
        </rule>
      </rules>
    </selectionEntry>
