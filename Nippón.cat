            <condition childId="3673-aaa8-d1d9-e6c2" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
        <modifier field="71eb-e0ca-7d4f-99f9" type="set" value="2">
          <conditions>
            <condition childId="170b-06ad-215f-f891" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="equalTo" value="1"/>
          </conditions>
        </modifier>
      </modifiers>
      <rules>
        <rule name="Ser divino y protector" id="adb6-ea3d-bc6b-1ffb" hidden="false">
          <description>Su tirada de salvación por Aura demoníaca (debido a su regla especial Yokai) se verá incrementada a 4+ y podrá utilizarla incluso contra Ataques mágicos. Además, las unidades amigas a 6” o menos del Kitsune obtienen una tirada de salvación especial de 6+ o mejoran en un punto dicha tirada si la tuviesen (hasta un máximo de 4+); el efecto de varios Kitsunes no es acumulativo.</description>
        </rule>
        <rule name="Fuegos fautos" id="5041-c40e-b7dd-c5ae" hidden="false">
          <description>En cada fase de disparo propia el Kitsune puede seleccionar una unidad enemiga a 18” o menos de él: dicha unidad sufrirá 1D6 impactos de F4 con reglas especiales Ataques sólo flamígeros y Ataques mágicos. Si el Kitsune está trabado en combate tan sólo podrá elegir a una unidad enemiga trabada con él en combate.</description>
        </rule>
        <rule name="Cambiaformas" id="30e4-da1a-9ca1-2077" hidden="false">
          <description>No se podrá designar como objetivo de los disparos a un Kitsune a no ser que sea la unidad enemiga más cercana a la unidad que dispara.</description>
        </rule>
      </rules>
      <selectionEntries>
        <selectionEntry name="Kitsune" id="0417-ff83-9428-4e73" collective="false" hidden="false" import="true" type="model">
          <constraints>
            <constraint id="1772-0886-c702-071f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="1"/>
