            <selectionEntry name="Bruto Oni" id="da9d-f4e2-26a8-2799" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="65b1-736f-bf81-3eb5" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="50"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Furia asesina" id="3014-5c21-99c0-f8e3" hidden="false" targetId="145c-6914-de8b-e9cc" type="rule"/>
                <infoLink name="Infantería monstruosa" id="5a81-de0f-2fa9-0d25" hidden="false" targetId="4958-70de-0b69-9825" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="65b1-736f-bf81-3eb5" type="increment" value="1">
                  <repeats>
                    <repeat childId="1eba-aef2-2756-3f71" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Bruto Oni" id="abf5-54f5-2efa-eaab" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El Bushi-Oni deberá utilizar una peana de 40x40mm y cambia su tipo de tropa a Infantería Monstruosa. Deberá unirse a una unidad de Oni y no podrá abandonarla. Está equipado con arma a dos manos. Incrementa su atributo de Heridas y Ataques en 2 y en 1 los de Fuerza y Resistencia. Gana las reglas especiales Furia Asesina y Arremetida. Cuenta como un portaestandarte.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Arremetida" id="1b8b-7be7-4ce2-2874" hidden="false">
                  <description>Si una unidad con esta regla especial obtiene algún resultado de 5 ó de 6 en su tirada de carga, cada uno de sus componentes obtendrá hasta el final del turno la regla especial Impactos por carga (1).</description>
                </rule>
              </rules>
