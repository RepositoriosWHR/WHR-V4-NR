        <cost name="pts" typeId="points" value="0"/>
        <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
      </costs>
      <infoLinks>
        <infoLink name="Infantería" id="c1e3-7e7d-ea77-eaef" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Samurai" id="3114-cb2f-90f5-0bc8" hidden="false" targetId="3127-2ebd-247a-303f" type="rule"/>
        <infoLink name="Inmune al miedo" id="6bbd-8b22-e7e5-ca88" hidden="false" targetId="9dea-6e2e-9d06-f5f7" type="rule"/>
        <infoLink name="Esquivar (4+)" id="ca40-0bf4-2ca1-e2b7" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink name="Hostigadores" id="eb58-c8b8-98d0-e4a7" hidden="false" targetId="999c-d422-6c91-46dd" type="rule"/>
      </infoLinks>
      <rules>
        <rule name="Técnicas de combate" id="96e6-fb56-98a7-c046" hidden="false">
          <description>Al inicio de cada fase de combate cuerpo a cuerpo puede elegir una de las técnicas de combate que durará hasta el final de la fase de combate cuerpo a cuerpo. No puede elegir la misma técnica de combate en dos fases de combate cuerpo a cuerpo consecutivas. Si está unido a una unidad de Ronins debe elegir la misma técnica que el resto de su unidad.
- La ira del cielo: El Shujinkou Ronin obtiene la regla especial Golpe letal.
- Fluir como el agua: El Shujinkou Ronin obtiene un bonificador de +1 a las tiradas de Esquivar (hasta un máximo de 3+).
- Viento afilado: El Shujinkou Ronin obtiene un bonificador de +1 Ataque.</description>
        </rule>
        <rule name="Líder ronin" id="c6cf-a18c-871b-e056" hidden="false">
          <description>Un Shujinkou Ronin sólo puede unirse a unidades de Ronin. Además, no puede ser el general del ejército.</description>
        </rule>
        <rule name="Espadachín consumado" id="8652-e910-9ba9-fcc6" hidden="false">
          <description>Al inicio de cada ronda de combate el Shujinkou Ronin puede elegir el modo de combate de su Katana (en lugar de permanecer en el mismo modo todo el combate, como es habitual). La unidad de Ronins en la que sea desplegado al comienzo de la batalla adquieren esta habilidad.</description>
        </rule>
      </rules>
