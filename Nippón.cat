        <infoLink name="Infantería" id="2c6c-11f4-ac19-3c86" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
        <infoLink name="Esquivar (4+)" id="793d-516c-3d41-abda" hidden="false" targetId="89b2-357c-6f88-920c" type="rule"/>
        <infoLink name="Ataques envenenados" id="479e-38a1-85d7-9ec1" hidden="false" targetId="9867-a512-772e-f61c" type="rule"/>
