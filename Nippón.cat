            <infoLink name="Katana (con Wakizashi)" id="15ee-a5ec-7de8-398f" hidden="false" targetId="9390-af2d-4208-9d2a" type="profile"/>
          </infoLinks>
          <profiles>
            <profile name="El corazón de la espada" id="99f9-17e5-c801-3bd7" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">El portador y su unidad podrán aplicar los dos modos simultáneos de la Katana, es decir, obtendrá +1F, +1A y +1I al usar esta arma, independientemente de cómo use la katana.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
      </selectionEntries>
