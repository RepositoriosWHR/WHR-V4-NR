    <selectionEntry name="Yamabushi-Vinto" id="1542-9ee6-1017-767e" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="c09e-5285-8659-e8dd" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
        <categoryLink name="New CategoryLink" id="d8be-938e-ae19-26e4" hidden="false" primary="true" targetId="4865726f657323232344415441232323"/>
      </categoryLinks>
