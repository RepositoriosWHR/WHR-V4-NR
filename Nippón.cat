          </costs>
          <infoLinks>
            <infoLink name="Esquivar (6+)" id="0cc0-c495-37aa-56fd" hidden="false" targetId="c905-72a4-c706-6a16" type="rule"/>
          </infoLinks>
          <profiles>
            <profile name="Orbe de sombras" id="2306-5951-afaa-7a7f" hidden="false" typeId="e4ac-4b4d-a272-410e" typeName="Artefacto arcano">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Objeto portahechizos, nivel de energía 3. Contiene un hechizo de Potenciación que afecta a una unidad amiga a 12’’. La unidad obtendrá la regla Esquivar (6+). Si ya disponía de dicha regla, mejorará su regla de Esquiva en un punto.</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="Broche de vacío" id="86dc-7c24-b29f-af3d" collective="false" hidden="false" import="true" type="upgrade">
          <constraints>
            <constraint id="3392-b549-bbc7-eaaf" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="false" type="max" value="1"/>
            <constraint id="1b01-c9e3-1eab-a162" field="selections" includeChildForces="false" includeChildSelections="true" percentValue="false" scope="roster" shared="true" type="max" value="1"/>
          </constraints>
