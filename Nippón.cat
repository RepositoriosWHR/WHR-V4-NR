      <rules>
        <rule name="Magia Onmyji" id="0b36-5637-0559-8739" hidden="false">
          <description>Es un hechicero de nivel de magia 1. Puede aumentarse a nivel 2 por +30 puntos. Puede elegir sus hechizos de uno (y sólo uno) de entre los siguientes saberes: Fuego, Luz, Cielos, Bestias o Vida.</description>
        </rule>
      </rules>
