    <selectionEntry name="Shujinkou ronin" id="8cb2-42ca-a9ec-9bd1" collective="false" hidden="false" import="true" type="unit">
      <categoryLinks>
        <categoryLink name="Personajes" id="1588-e6ff-22fc-d992" hidden="false" primary="false" targetId="e839-bd6b-7e36-e758"/>
