              <profiles>
                <profile name="Akumaharai" id="9b06-99c2-28ca-c819" hidden="false" typeId="ce18-64ea-b98c-dc9d" typeName="Arma mágica">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="28f4-dde2-505a-99d6">Alabarda. Proporciona +1 Ataque (ya incluido en su perfil). Los ataques realizados con este arma se resuelven con la regla especial Poder de penetración. Adicionalmente, cuando lance el Sutra del destierro utilizará la plantilla redonda grande.</characteristic>
