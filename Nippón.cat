          <profiles>
            <profile name="Estandarte del emperador" id="b90e-514e-24b5-8cbd" hidden="false" typeId="5441-5d99-9a3f-dce8" typeName="Estandarte mágico">
              <characteristics>
                <characteristic name="Reglas especiales" typeId="eb3c-0420-d3ad-ee60">Todas las unidades aliadas a 12” o menos del portador obtienen una tirada de salvación especial 6+ y resistencia 
a la magia (1).</characteristic>
              </characteristics>
            </profile>
          </profiles>
        </selectionEntry>
        <selectionEntry name="El corazón de la espada" id="3618-2533-9b43-43b1" collective="false" hidden="false" import="true" type="upgrade">
