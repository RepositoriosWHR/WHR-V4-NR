              <characteristics>
                <characteristic name="Reglas especiales" typeId="2cab-b0ef-2a60-b01b">Solo Maestros ninjas. El portador debe elegir sus hechizos del saber de la Muerte y conocerá un hechizo adicional a su nivel de magia.</characteristic>
              </characteristics>
            </profile>
          </profiles>
