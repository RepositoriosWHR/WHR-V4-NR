      <rules>
        <rule name="Solitario" id="d056-5bab-a66a-d1a7" hidden="false">
          <description>Hahen sólo puede unirse a unidades de Ninjas.</description>
        </rule>
        <rule name="No líder" id="a4e9-29ee-8d12-1b6a" hidden="false">
          <description>Hahen no puede ser el general del ejército.</description>
        </rule>
        <rule name="Agulidad sobrehumana" id="1b57-d8c4-422b-f1b1" hidden="false">
          <description>Hahen puede repetir los resultados de 1 en sus tiradas de Esquivar.</description>
        </rule>
        <rule name="Veneno secetro" id="0434-968e-a5bc-f4b3" hidden="false">
          <description>Todos los ataques cuerpo a cuerpo y con proyectiles que realice Hahen tendrán la regla especial Ataques envenenados, además, este veneno sobrepasa la inmunidad a veneno que otorgan las reglas especiales Demonio y No muerto.</description>
        </rule>
        <rule name="Veneno negro" id="56a9-f869-9b69-47a9" hidden="false">
          <description>Un solo uso. Las heridas causadas por el veneno negro tienen la regla especial Heridas múltiples (1D3). Puede usarse conjuntamente con el Veneno secreto.</description>
        </rule>
      </rules>
