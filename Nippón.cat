              <modifiers>
                <modifier field="e19b-2c6c-f994-e4a6" type="increment" value="1">
                  <repeats>
                    <repeat childId="eb96-62ce-d737-1019" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Pastor Yokai" id="a8bd-cd2e-febd-a1a6" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">Cambia la peana a 40x40mm y su tipo de tropa a Enjambre. Deberá unirse a una unidad de Yokais menores y no podrá abandonarla. Incrementa sus atributo de H en dos. En combate cuerpo a cuerpo obtendrá 1D6 ataques adicionales de HA3 F2 y la regla especial Ataques envenenados. Los Yokais menores a los que se una podrán repetir las tiradas para impactar y herir de 1. Cuenta como músico.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
            </selectionEntry>
            <selectionEntry name="Líder de los Tengu" id="3d02-3978-b130-e6eb" collective="false" hidden="false" import="true" type="upgrade">
              <constraints>
                <constraint id="7aa5-e129-6e08-43d3" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" scope="parent" shared="true" type="max" value="0"/>
              </constraints>
              <costs>
                <cost name="pts" typeId="points" value="20"/>
                <cost name="pts de Asedio" typeId="7deb-c7e6-415b-8067" value="0"/>
              </costs>
              <infoLinks>
                <infoLink name="Infantería" id="8249-60bf-9c82-05ce" hidden="false" targetId="5b75-bd6b-d17a-6b7d" type="rule"/>
                <infoLink name="Volar (10)" id="d90c-713c-f406-e95a" hidden="false" targetId="be56-917b-a9d5-2c76" type="rule"/>
              </infoLinks>
              <modifiers>
                <modifier field="7aa5-e129-6e08-43d3" type="increment" value="1">
                  <repeats>
                    <repeat childId="901e-ab8c-83da-f04f" field="selections" includeChildForces="false" includeChildSelections="false" percentValue="false" repeats="1" roundUp="false" scope="roster" shared="true" value="1"/>
                  </repeats>
                </modifier>
              </modifiers>
              <profiles>
                <profile name="Líder de los Tengu" id="64eb-ccf1-0a71-9541" hidden="false" typeId="322d-2622-d325-8e5a" typeName="Objeto">
                  <characteristics>
                    <characteristic name="Reglas especiales" typeId="7e0d-4aa5-85cf-f713">El Bushi-Oni está equipado con Katana y tiene las reglas especiales Volar y Uno con el viento. Deberá unirse a una unidad de Tengu y no podrá abandonarla. Además, él y la unidad de Tengu a la que se una podrán repetir las tiradas para cargar y perseguir.</characteristic>
                  </characteristics>
                </profile>
              </profiles>
              <rules>
                <rule name="Uno con el viento" id="9995-a80b-892b-b8f5" hidden="false">
                  <description>La unidad de Tengu podrá declarar huir como reacción a una carga pese a ser Inmunes a psicología; se reagruparán automáticamente al final de su movimiento de huida.</description>
                </rule>
              </rules>
