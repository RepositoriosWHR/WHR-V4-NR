      <rules>
        <rule name="Shogun" id="eeb8-6fa3-cb4c-ebd9" hidden="false">
          <description>La regla Presencia inspiradora de Kamakura (por ser el general del ejército) tendrá un alcance de 18”. Si monta en un Dragón Nippón el alcance será de 24”. Además, un ejército liderado por Kamakura Kenji podrá incluir hasta dos unidades de Guardia de honor en lugar de sólo una.</description>
        </rule>
        <rule name="Ídolo del honor" id="78e3-277b-2301-9bd4" hidden="false">
          <description>Al luchar en desafíos Kamakura puede repetir las tiradas para impactar fallidas y los resultados de 1 en sus tiradas para herir.</description>
        </rule>
        <rule name="Protección del sol divino" id="76e2-0a1c-7119-396c" hidden="false">
          <description>Kenji tiene una tirada de salvación especial de 4+.</description>
        </rule>
      </rules>
      <selectionEntries>
